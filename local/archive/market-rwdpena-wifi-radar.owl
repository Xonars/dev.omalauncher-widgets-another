widget "wifi radar" {
  page: 3
  order: 5
  size: 3x3
  minSize: 2x2
  meta {
    owl: 7
    description: "Live Wi-Fi radar showing surrounding wireless nodes and networks by signal and latency. Tap for full radar and device list"
    version: "1.0"
    license: "MIT"
    category: "system"
  }

  requires { pacman: ["iproute2", "iputils", "perl", "iw", "gawk"] }

  state filter = "online"

  source scan = cmd("""
    perl -MIO::Socket::INET -MTime::HiRes=time -e '
      use strict;
      use warnings;

      sub jstr {
        my ($s) = @_;
        $s //= "";
        $s =~ s/\\/\\\\/g;
        $s =~ s/"/\\"/g;
        $s =~ s/[\x00-\x1f]//g;
        return "\"$s\"";
      }

      sub ip2int { unpack("N", inet_aton($_[0])) }
      sub int2ip { inet_ntoa(pack("N", $_[0])) }

      my $routes = `ip -4 route show table all 2>/dev/null`;
      my ($dev) = ($routes =~ /\bdev\s+(wlan\S+|wl\S+)/);
      $dev //= "wlan0";

      # 1. Try 802.11 BSS scan if permitted by kernel/privileges
      my $iw = `iw dev $dev scan 2>/dev/null`;
      if ($iw && $iw =~ /^BSS /m) {
        my @aps;
        my $cur;
        for my $line (split /\n/, $iw) {
          if ($line =~ /^BSS ([0-9a-f:]{17})/i) {
            push @aps, $cur if $cur && $cur->{ssid};
            $cur = { bssid => $1, ssid => "", dbm => -80, freq => 2412 };
          } elsif ($cur && $line =~ /^\s*SSID:\s*(.+)$/) {
            $cur->{ssid} = $1;
          } elsif ($cur && $line =~ /^\s*signal:\s*([-\d.]+)\s*dBm/) {
            $cur->{dbm} = $1 + 0;
          } elsif ($cur && $line =~ /^\s*freq:\s*(\d+)/) {
            $cur->{freq} = $1 + 0;
          }
        }
        push @aps, $cur if $cur && $cur->{ssid};
        if (@aps) {
          @aps = sort { $b->{dbm} <=> $a->{dbm} } @aps;
          my @j;
          for my $i (0..$#aps) {
            my $a = $aps[$i];
            my $dist = 0.15 + (( -30 - ($a->{dbm} < -95 ? -95 : $a->{dbm} > -30 ? -30 : $a->{dbm}) ) / 65.0) * 0.78;
            my $ang = int(($i * 137.508 + 20) % 360);
            my $rad = $ang * 3.14159265 / 180.0;
            my $band = $a->{freq} >= 5000 ? "5G" : "2.4G";
            push @j, sprintf(
              "{\"id\":%s,\"ip\":%s,\"name\":%s,\"kind\":%s,\"online\":true,\"rtt\":%d,\"dist\":%.3f,\"angle\":%d,\"x\":%.3f,\"y\":%.3f}",
              jstr($a->{bssid}), jstr($band . " · " . $a->{bssid}), jstr($a->{ssid}), jstr("ap"),
              int($a->{dbm}), $dist, $ang, sin($rad)*$dist, cos($rad)*$dist
            );
          }
          printf "{\"ok\":true,\"mode\":\"ssid\",\"selfIp\":%s,\"selfName\":\"802.11\",\"gwIp\":\"\",\"gwName\":\"%d networks\",\"nodes\":[%s]}\n", jstr($dev), scalar(@aps), join(",", @j);
          exit 0;
        }
      }

      # 2. Active Wi-Fi radar on the wireless subnet (works without root on Android)
      my $ip_out = `ip -4 -br addr show $dev 2>/dev/null`;
      my ($self_ip, $cidr) = ($ip_out =~ /(\d+\.\d+\.\d+\.\d+)\/(\d+)/);
      if (!$self_ip && $routes =~ /(\d+\.\d+\.\d+\.\d+)\/(\d+)\s+dev\s+\Q$dev\E\b.*?\bsrc\s+(\d+\.\d+\.\d+\.\d+)/) {
        ($self_ip, $cidr) = ($3, $2);
      }
      if (!$self_ip) {
        print "{\"ok\":false,\"err\":\"Wi-Fi off\",\"nodes\":[]}\n";
        exit 0;
      }
      $cidr //= 24;

      my ($gw) = ($routes =~ /default\s+via\s+(\d+\.\d+\.\d+\.\d+)\s+dev\s+\Q$dev\E\b/);
      ($gw) = ($routes =~ /default\s+via\s+(\d+\.\d+\.\d+\.\d+)/) if !$gw;

      my $self_int = ip2int($self_ip);
      my $eff_cidr = ($cidr < 24 || $cidr > 30) ? 24 : $cidr;
      my $span = 1 << (32 - $eff_cidr);
      my $net_int = $self_int - ($self_int % $span);
      my $bcast_int = $net_int + $span - 1;

      if (!$gw) {
        for my $cand (int2ip($net_int + 1), int2ip($bcast_int - 1)) {
          if (system("ping -c 1 -W 1 $cand >/dev/null 2>&1") == 0) { $gw = $cand; last; }
        }
        $gw //= int2ip($net_int + 1);
      }

      my @scan_ips = ($gw, grep { $_ ne $gw } map { int2ip($_) } ($net_int + 1 .. $bcast_int - 1));

      my %raw;
      my $sock = IO::Socket::INET->new(PeerAddr => $gw, PeerPort => 53, Proto => "udp");
      if ($sock) {
        for my $idx (0..$#scan_ips) {
          my $qid = $idx + 1;
          my $ip = $scan_ips[$idx];
          my $q = pack("nnnnnn", $qid, 0x0100, 1, 0, 0, 0);
          for my $lbl (reverse(split(/\./, $ip)), "in-addr", "arpa") {
            $q .= pack("C", length($lbl)) . $lbl;
          }
          $q .= pack("Cnn", 0, 12, 1);
          $sock->send($q);
          select(undef, undef, undef, 0.002) if $qid % 32 == 0;
        }
        my $deadline = time() + 0.45;
        while (time() < $deadline) {
          vec(my $rin = "", fileno($sock), 1) = 1;
          my $left = $deadline - time();
          last if $left <= 0 || !select($rin, undef, undef, $left);
          $sock->recv(my $resp, 512);
          next unless defined $resp && length($resp) >= 12;
          my ($qid, $flags, $qd, $an) = unpack("nnnn", $resp);
          next unless $an > 0 && $qid >= 1 && $qid <= scalar(@scan_ips);
          my $ip = $scan_ips[$qid - 1];
          my $id = ip2int($ip) & 255;
          my @labels = ($resp =~ /([A-Za-z0-9_-]{2,})/g);
          @labels = grep { $_ !~ /^(in-addr|arpa|\d+)$/i } @labels;
          if (@labels) {
            my $name = $labels[0];
            my $domain = $labels[1] // "";
            next if $name =~ /^(NULL|Home|local|lan)$/i;
            $raw{$id} = { id => $id, ip => $ip, name => $name, domain => $domain };
          }
        }
      }
      my $gw_id = ip2int($gw) & 255;
      my $self_id = ip2int($self_ip) & 255;
      $raw{$gw_id} //= { id => $gw_id, ip => $gw, name => "Router", domain => "" };

      my @ids = sort { $a <=> $b } keys %raw;
      my $cmd = join(" ", map {
        my $ip = $raw{$_}{ip};
        "(ping -c 1 -W 1 $ip 2>/dev/null | awk \"/time=/ {gsub(/.*time=/, \\\"\\\"); gsub(/ .*/, \\\"\\\"); print $_, \\\$0}\") &"
      } @ids) . " wait";
      my $ping_out = `$cmd`;
      for my $line (split /\n/, $ping_out) {
        if ($line =~ /^(\d+)\s+([\d.]+)/) {
          $raw{$1}{rtt} = $2 + 0;
        }
      }

      my %by_name;
      for my $id (@ids) {
        my $h = $raw{$id};
        my $k = lc($h->{name});
        if (exists $by_name{$k}) {
          if (defined $h->{rtt} && !defined $by_name{$k}{rtt}) {
            delete $raw{$by_name{$k}{id}};
            $by_name{$k} = $h;
          } elsif (!defined $h->{rtt}) {
            delete $raw{$id};
          }
        } else {
          $by_name{$k} = $h;
        }
      }

      my $self_name = $raw{$self_id} ? $raw{$self_id}{name} : "Phone";
      my $gw_name = $raw{$gw_id} ? ($raw{$gw_id}{name} . ($raw{$gw_id}{domain} ? ".$raw{$gw_id}{domain}" : "")) : $gw;
      delete $raw{$self_id};

      # Evenly space online nodes around the 360° circle (sorted by ID so positions stay stable)
      my @on_ids = sort { $a <=> $b } grep { defined $raw{$_}{rtt} } keys %raw;
      my @off_ids = sort { $a <=> $b } grep { !defined $raw{$_}{rtt} } keys %raw;
      my %angle_of;
      my $on_cnt = scalar(@on_ids) || 1;
      for my $i (0..$#on_ids) {
        $angle_of{$on_ids[$i]} = int((35 + $i * (360.0 / $on_cnt)) % 360);
      }
      my $off_cnt = scalar(@off_ids) || 1;
      for my $i (0..$#off_ids) {
        $angle_of{$off_ids[$i]} = int((15 + $i * (360.0 / $off_cnt)) % 360);
      }

      my @nodes = sort {
        (defined $b->{rtt} <=> defined $a->{rtt})
        || ((defined $a->{rtt} ? $a->{rtt} : 9999) <=> (defined $b->{rtt} ? $b->{rtt} : 9999))
        || ($a->{id} <=> $b->{id})
      } values %raw;

      my @json_nodes;
      for my $n (@nodes) {
        my $online = defined $n->{rtt} ? 1 : 0;
        my $rtt = $n->{rtt} // -1;
        my $dist;
        if (!$online) {
          $dist = 0.88 + (($n->{id} % 6) * 0.012);
        } elsif ($rtt <= 5) {
          $dist = 0.20 + ($rtt / 5.0) * 0.14;
        } elsif ($rtt <= 25) {
          $dist = 0.38 + (($rtt - 5.0) / 20.0) * 0.25;
        } else {
          my $capped = $rtt > 150 ? 150 : $rtt;
          $dist = 0.66 + (($capped - 25.0) / 125.0) * 0.18;
        }
        my $angle = $angle_of{$n->{id}} // 0;
        my $rad = $angle * 3.14159265 / 180.0;
        my $x = sprintf("%.3f", sin($rad) * $dist);
        my $y = sprintf("%.3f", cos($rad) * $dist);

        my $kind = "iot";
        my $nm = $n->{name};
        if ($n->{ip} eq $gw || $nm =~ /(^router|^gateway|^gw\b|fritz|openwrt|opnsense|pfsense|mikrotik|ubnt|unifi|edgeos)/i) { $kind = "router"; }
        elsif ($nm =~ /(^ap\b|[-_]ap\d*$|access[-_]?point|repeater|extender|mesh|deco|eero|orbi)/i) { $kind = "ap"; }
        elsif ($nm =~ /(phone|android|iphone|ipad|tablet|pixel|galaxy|mobile)/i) { $kind = "phone"; }
        elsif ($nm =~ /(\btv\b|[-_]tv|chromecast|roku|firetv|appletv|bravia|webos|tizen|shield|kodi|media)/i) { $kind = "tv"; }
        elsif ($nm =~ /(desktop|laptop|macbook|imac|macmini|thinkpad|workstation|\bpc\b|server|\bnas\b|synology|raspberry|linux|ubuntu|arch|debian|fedora)/i) { $kind = "pc"; }

        push @json_nodes, sprintf(
          "{\"id\":%d,\"ip\":%s,\"name\":%s,\"kind\":%s,\"online\":%s,\"rtt\":%s,\"dist\":%.3f,\"angle\":%d,\"x\":%s,\"y\":%s}",
          $n->{id}, jstr($n->{ip}), jstr($nm), jstr($kind),
          ($online ? "true" : "false"), ($online ? sprintf("%.1f", $rtt) : "null"),
          $dist, $angle, $x, $y
        );
      }

      printf "{\"ok\":true,\"mode\":\"lan\",\"selfIp\":%s,\"selfName\":%s,\"gwIp\":%s,\"gwName\":%s,\"nodes\":[%s]}\n",
        jstr($self_ip), jstr($self_name), jstr($gw), jstr($gw_name), join(",", @json_nodes);
    '
  """) every 5m timeout 15s json

  let allNodes = scan.nodes ?? []
  let onlineNodes = allNodes.filter(n => n.online)
  let shownNodes = filter == "all" ? allNodes : onlineNodes
  let nearest = first(onlineNodes)
  let problem = scan == null ? "scanning wifi…" : !scan.ok ? (scan.err ?? "no wifi") : null

  onTap: screen()

  component BlipIcon(online, rtt, kind) {
    Canvas {
      size: 20
      let c = !online ? muted : kind == "router" || kind == "ap" ? cyan : rtt < 8 ? green : rtt < 35 ? yellow : orange
      circle(10, 10, 8, fill: alpha(c, 0.18), stroke: alpha(c, 0.55), width: 1)
      circle(10, 10, 3.8, fill: c)
    }
  }

  component Radar(list, labels = false, sweep = false) {
    Canvas {
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2 - 3
      let dot = max(r / 24, 3.5)

      // Radar background & range rings
      circle(cx, cy, r, fill: alpha(surface, 0.45), stroke: border, width: 1.2)
      circle(cx, cy, r * 0.66, stroke: alpha(muted, 0.28), width: 1)
      circle(cx, cy, r * 0.33, stroke: alpha(muted, 0.28), width: 1)

      // Crosshairs
      line(cx - r, cy, cx + r, cy, stroke: alpha(muted, 0.2), width: 1)
      line(cx, cy - r, cx, cy + r, stroke: alpha(muted, 0.2), width: 1)

      // Rotating radar sweep beam (only on full screen to avoid per-frame tile redraws)
      if sweep {
        rotate(time * 90 % 360, cx, cy) {
          arc(cx, cy, r, -42, 42, fill: alpha(green, 0.14))
          arc(cx, cy, r, -16, 16, fill: alpha(green, 0.10))
          line(cx, cy, cx, cy - r, stroke: alpha(green, 0.75), width: 1.5)
        }
      }

      if labels {
        text("5ms", cx + 4, cy + r * 0.33 - 6, size: 8, color: muted)
        text("25ms", cx + 4, cy + r * 0.66 - 6, size: 8, color: muted)
        text("WIFI", cx, cy - r + 10, size: 9, align: center, color: muted)
      }

      // Draw each Wi-Fi node / AP blip
      for n in list {
        let px = cx + n.x * r
        let py = cy - n.y * r
        let c = !n.online ? alpha(muted, 0.55) : n.kind == "router" || n.kind == "ap" ? cyan : n.rtt < 8 ? green : n.rtt < 35 ? yellow : orange

        if n.online {
          circle(px, py, dot * 2.1, fill: alpha(c, 0.20))
        }
        circle(px, py, n.online ? dot : dot * 0.75, fill: c)

        if labels && (n.online || filter == "all") {
          text(sub(n.name, 0, 10), px, py + dot + 8, size: 8.5, align: center, color: n.online ? foreground : muted)
        }
      }

      // Center node (this phone)
      circle(cx, cy, 4.5, fill: alpha(accent, 0.3))
      circle(cx, cy, 2.8, fill: accent)
    }
  }

  Column {
    gap: 4
    Row {
      align: center
      Text { text: "wifi radar"; style: muted; weight: 1; maxLines: 1 }
      Text {
        text: problem == null ? "${len(onlineNodes)}/${len(allNodes)}" : ""
        style: small
        color: green
        width: 44
        align: end
      }
    }
    Box {
      weight: 1
      fill: width
      Radar { list: shownNodes; labels: cols >= 4 && rows >= 4; fill: true }
      if problem != null {
        Text { text: problem; style: small; color: muted; align: center }
      }
    }
    if rows >= 3 {
      Text {
        text: problem != null ? "" : nearest == null ? (scan.gwName ?? "no active nodes") : "${nearest.name} · ${nearest.rtt} ms"
        style: small
        maxLines: 1
      }
    }
  }

  screen {
    title: "wifi radar"
    Column {
      scroll: true
      gap: 10

      Row {
        gap: 8
        align: center
        Button {
          text: "online (${len(onlineNodes)})"
          color: filter == "online" ? green : muted
          onTap: { filter = "online"; haptic() }
        }
        Button {
          text: "all (${len(allNodes)})"
          color: filter == "all" ? cyan : muted
          onTap: { filter = "all"; haptic() }
        }
        Spacer { weight: 1 }
        Button {
          text: "↻ scan"
          color: accent
          onTap: { haptic(); refresh() }
        }
      }

      Radar {
        list: shownNodes
        labels: true
        sweep: true
        height: min(screenWidth - 32, screenHeight * 0.50)
        fill: width
      }

      Text {
        text: problem ?? "${scan.gwName} (${scan.gwIp}) · self ${scan.selfIp}"
        style: small
        color: muted
        maxLines: 1
      }

      Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }

      for n in shownNodes key n.id {
        Row {
          gap: 10
          align: center
          padding: [4, 4]
          onTap: { copy(n.ip); haptic(); notify("Wi-Fi Radar", "Copied IP: ${n.ip} (${n.name})") }
          BlipIcon { online: n.online; rtt: n.rtt ?? 999; kind: n.kind }
          Column {
            gap: 0
            weight: 1
            Text { text: n.name; font: mono; bold: true; color: n.online ? foreground : muted; maxLines: 1 }
            Text { text: "${n.ip} · ${n.kind == "router" ? "wifi router" : n.kind == "ap" ? "access point" : n.kind == "tv" ? "tv / media" : n.kind == "phone" ? "phone / tablet" : n.kind == "pc" ? "computer" : "smart / iot"}"; style: small; color: muted; maxLines: 1 }
          }
          Text {
            text: n.online ? "${n.rtt} ms" : "offline"
            font: mono
            style: small
            color: !n.online ? muted : n.rtt < 8 ? green : n.rtt < 35 ? yellow : orange
            width: 68
            align: end
          }
        }
      }
    }
  }
}
