widget "Будильник" {
  page: 1
  order: 6
  meta {
    owl: 8
    description: "Ближайший будильник и время до звонка. Нажмите, чтобы открыть часы."
    version: "1.1"
    license: "MIT"
    category: "time"
  }
  requires { pacman: [] }
  size: 3x3
  minSize: 3x3
  padding: 16

  source alarm = android.alarm
  source apps = android.apps every 1m
  source now = clock every 1s
  let clockApps = (apps ?? []).filter(a => a.profile == null && (contains(lower(a.package), "deskclock") || contains(lower(a.package), "clockpackage") || contains(lower(a.package), "alarmclock") || lower(a.name) == "часы" || lower(a.name) == "clock" || lower(a.name) == "будильник"))
  let clockApp = alarm.app ?? first(clockApps).key
  let remaining = max(0, ceil((alarm.time - now) / 60))
  let hours = floor(remaining / 60)
  let minutes = remaining % 60

  onTap: {
    androidApp(clockApp)
    launcher(clockApp == null ? "drawer" : null)
  }

  Column {
    fill: true
    gap: 6
    Text { text: "БУДИЛЬНИК"; style: label; color: accent }
    Spacer { weight: 1 }
    Text {
      text: alarm.set ? fmtTime(alarm.time, "HH:mm") : "—:—"
      fontSize: 42
      bold: true
      color: alarm.set ? foreground : muted
    }
    Text {
      text: alarm.set ? fmtTime(alarm.time, "EEE, d MMM") : "Не установлен"
      style: body
    }
    Text {
      text: alarm.set ? (remaining < 1 ? "Скоро зазвонит" : hours > 0 ? "Через ${hours} ч ${minutes} мин" : "Через ${minutes} мин") : "Нажмите, чтобы настроить"
      style: small
      color: muted
      maxLines: 2
    }
    Spacer { weight: 1 }
  }
}
