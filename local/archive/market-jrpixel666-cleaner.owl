widget "cleaner" {
  page: 3
  order: 4
  size: 3x3
  minSize: 3x2

  meta { owl: 8; description: "Finds caches, old packages and leftovers that are safe to delete, and frees the space with a tap, daily or weekly."; version: "1.1"; license: "MIT"; category: "system" }

  requires { pacman: ["pacman-contrib", "util-linux", "findutils", "coreutils", "gawk"] }

  // One script, two modes: `scan` prints {disk, items: {id: bytes}, orphans}, `clean <id|safe>`
  // starts a cleaner in the background (`work`, detached with setsid so no timeout can cut it
  // off) that reports what it's on in ~/.cache/cleaner/status.json. A lock keeps one at a time. Only throwaway data is touched: package
  // caches (pacman keeps the newest version of what's installed), download caches that tools
  // fill again on demand, files in /tmp and /var/tmp untouched for 7 days (minus sockets and
  // the launcher's, tmux's and proot's own), rotated logs, crash dumps and the trash.
  // Never: ~/.cache as a whole (widgets keep state there), configs, or packages.
  let script = """
    H=$HOME
    D=$H/.cache/cleaner
    SAFE="pkg-old uv npm pip yay go thumbs trash tmp logs core"
    AUTO="pkg-old uv npm pip yay go thumbs tmp logs core"   # a scheduled clean leaves the trash alone
    avail() { df -B1 --output=avail / | tail -1 | tr -d ' '; }
    status() { printf '{"target":"%s","running":"%s","started":%s,"freed":%s,"at":%s}' "$1" "$2" "$3" "$4" "$5" > "$D/status.tmp" && mv "$D/status.tmp" "$D/status.json"; }
    sz() { du -sbc "$@" 2>/dev/null | tail -1 | cut -f1; }
    szlist() { while IFS= read -r f; do du -sb "$f" 2>/dev/null; done | awk '{ t += $1 } END { print t + 0 }'; }
    tmpold() {
      find /tmp /var/tmp -mindepth 1 -maxdepth 1 -mtime +7 ! -type s ! -name '.bun-*' ! -name '.guest-shell-err-*' ! -name 'tmux-*' ! -name 'claude-*' ! -name 'proot-*' ! -name '.X*' ! -name '.ICE*' ! -name 'hsperfdata_*' ! -name 'omalauncher*' ! -name 'owl-*' ! -name 'pulse*' ! -name 'systemd-*' ! -name 'ssh-*' 2>/dev/null | while IFS= read -r f; do
        # a directory's own time doesn't change with files deeper in, so one still in use can look old
        [ -z "$(find "$f" -mtime -8 -print -quit; find "$f" -type s -print -quit)" ] && echo "$f"
      done
      # what a Linux session (proot) leaves behind once its process is gone
      for f in /tmp/proot-*; do [ -e "$f" ] && ! kill -0 "$(basename "$f" | awk -F- '{ print $2 }')" 2>/dev/null && echo "$f"; done
      for f in /tmp/.guest-shell-err-*; do [ -e "$f" ] && ! kill -0 "$(basename "$f" | awk -F- '{ print $NF }')" 2>/dev/null && echo "$f"; done
    }
    oldlogs() { find /var/log -type f -name '*.old' -o -type f -name '*.gz' -o -type f -name '*.xz' -o -type f -name '*.zst' -o -type f -name '*.[0-9]' 2>/dev/null; }
    pkgold() { { paccache -dk1; paccache -duk0; } 2>/dev/null | awk '/disk space saved/ { n = $(NF-1); u = $NF; gsub(/[()]/, "", n); m = 1; if (u ~ /^K/) m = 1024; if (u ~ /^M/) m = 1048576; if (u ~ /^G/) m = 1073741824; t += n * m } END { printf "%d", t }'; }
    size() {
      case $1 in
        pkg-old) pkgold;;
        pkg-all) sz /var/cache/pacman/pkg;;
        uv) sz "$H/.cache/uv";;
        npm) sz "$H/.npm/_cacache" "$H/.npm/_logs";;
        pip) sz "$H/.cache/pip";;
        yay) sz "$H/.cache/yay";;
        go) sz "$H/.cache/go-build";;
        thumbs) sz "$H/.cache/thumbnails";;
        trash) sz "$H/.local/share/Trash";;
        tmp) tmpold | szlist;;
        logs) oldlogs | szlist;;
        core) sz /var/lib/systemd/coredump;;
      esac
    }
    clean() {
      case $1 in
        pkg-old) paccache -rqk1; paccache -rquk0;;
        pkg-all) paccache -rqk0; rm -rf /var/cache/pacman/pkg/download-*;;
        uv) timeout 300 uv cache clean || rm -rf "$H/.cache/uv";;
        npm) rm -rf "$H/.npm/_cacache" "$H/.npm/_logs";;
        pip) rm -rf "$H/.cache/pip";;
        yay) rm -rf "$H/.cache/yay";;
        go) rm -rf "$H/.cache/go-build";;
        thumbs) rm -rf "$H/.cache/thumbnails";;
        trash) find "$H/.local/share/Trash" -mindepth 1 -delete;;
        tmp) tmpold | while IFS= read -r f; do rm -rf -- "$f"; done;;
        logs) oldlogs | while IFS= read -r f; do rm -f -- "$f"; done;;
        core) find /var/lib/systemd/coredump -mindepth 1 -delete;;
      esac >/dev/null 2>&1
    }
    case $1 in
      scan)
        df -B1 --output=size,used,avail / | awk 'NR == 2 { q = sprintf("%c", 34); printf "{%sdisk%s:{%ssize%s:%s,%sused%s:%s,%savail%s:%s},%sitems%s:{", q, q, q, q, $1, q, q, $2, q, q, $3, q, q }'
        sep=; for i in $SAFE pkg-all; do printf '%s"%s":%s' "$sep" "$i" "$(size "$i")"; sep=,; done
        printf '},"orphans":['
        pacman -Qdtq 2>/dev/null | awk '{ q = sprintf("%c", 34); printf "%s%s%s%s", (NR > 1 ? "," : ""), q, $1, q }'
        echo ']}';;
      start)
        mkdir -p "$D"
        if flock -n "$D/lock" true; then
          status "$2" "$2" "$(date +%s)" 0 0
          setsid -f bash -c "$BASH_EXECUTION_STRING" cleaner work "$2" >/dev/null 2>&1 </dev/null
        fi
        date +%s%N;;
      work)
        exec 9>"$D/lock"; flock -n 9 || exit 0
        case $2 in safe) ids=$SAFE;; auto) ids=$AUTO;; *) ids=$2;; esac
        t0=$(date +%s); a0=$(avail)
        for i in $ids; do status "$2" "$i" "$t0" 0 0; clean "$i"; done
        f=$(( $(avail) - a0 )); [ "$f" -lt 0 ] && f=0
        status "$2" "" "$t0" "$f" "$(date +%s)";;
    esac
  """

  let defs = [
    {id: "pkg-old", name: "old packages", desc: "pacman cache: older versions and removed packages"},
    {id: "uv", name: "uv cache", desc: "Python packages uv downloaded; fetched again when needed"},
    {id: "npm", name: "npm cache", desc: "~/.npm downloads and logs; fetched again when needed"},
    {id: "pip", name: "pip cache", desc: "Python wheels pip downloaded"},
    {id: "yay", name: "AUR builds", desc: "yay's cloned sources and built packages"},
    {id: "go", name: "Go build cache", desc: "compiled objects; rebuilt when needed"},
    {id: "thumbs", name: "thumbnails", desc: "image previews; drawn again when needed"},
    {id: "trash", name: "trash", desc: "files moved to the trash"},
    {id: "tmp", name: "old temp files", desc: "/tmp and /var/tmp files untouched for a week, and what closed Linux sessions left"},
    {id: "logs", name: "rotated logs", desc: "old compressed logs in /var/log"},
    {id: "core", name: "crash dumps", desc: "systemd core dumps"}
  ]

  source now = clock every 1m
  source scan = cmd("bash -c ${sh(script)} cleaner scan") every 30m json timeout 90s
  source st = file("~/.cache/cleaner/status.json") json
  state pending = ""    // tapped, until the cleaner has written its status
  state starting = null
  state freq = "off" persist   // off, daily or weekly: runs "clean all" but the trash
  state nextAt = 0 persist

  let items = scan.items ?? {}
  let disk = scan.disk
  let usedPct = disk ? disk.used / disk.size * 100 : null
  let safeTotal = scan ? sum(defs.map(d => num(items[d.id], 0))) : null
  let dirty = defs.filter(d => num(items[d.id], 0) > 0)
  let tidy = defs.filter(d => num(items[d.id], 0) == 0)
  let orphans = scan.orphans ?? []
  // a status still "running" after an hour is from a cleaner that was killed
  let live = st.running != null && st.running != "" && now != null && now - st.started < 3600
  let busy = pending != "" ? pending : live ? st.running : ""
  let busyName = busy == "safe" || busy == "auto" ? "all" : busy == "pkg-all" ? "package cache" : (defs.find(d => d.id == busy).name ?? busy)

  on starting { pending = "" }
  // the time the last clean finished; null while one runs, so it changes when one ends
  let doneAt = live || pending != "" ? null : st.at
  on doneAt { notify("cleaner", "freed ${fmtBytes(st.freed)}"); refresh() }
  let interval = freq == "weekly" ? 7 * 86400 : 86400
  // schedule one when there's none, or bring one set for a longer interval closer
  when freq != "off" && now != null && (nextAt == 0 || nextAt > now + interval) { nextAt = now + interval }
  at nextAt {
    // a time missed while the launcher was off runs once at start, then moves on from now
    nextAt = freq == "off" ? 0 : max(nextAt, now ?? 0) + interval
    // only set while freq isn't off; a clean already running holds the lock, so this one is skipped
    pending = "auto"; starting = run("bash -c ${sh(script)} cleaner start auto")
  }

  onTap: screen()

  Column {
    gap: 4
    fill: true
    Row {
      align: center
      Text { text: "cleaner"; style: muted; weight: 1 }
      Text { text: usedPct == null ? "" : "${round(usedPct)}%"; style: small; width: 40; align: end; color: usedPct > 85 ? red : muted }
    }
    Text { text: safeTotal == null ? "scanning…" : fmtBytes(safeTotal); style: title; color: safeTotal > 100000000 ? yellow : green; maxLines: 1 }
    Text { text: busy != "" ? "cleaning ${busyName}…" : safeTotal == null ? "" : safeTotal > 0 ? "safe to free" : "all clean"; style: small; color: busy != "" ? accent : muted; maxLines: 1 }
    Progress { value: usedPct; color: usedPct > 85 ? red : accent; animate value: spring() }
    Text { text: disk ? "${fmtBytes(disk.avail)} free of ${fmtBytes(disk.size)}" : "…"; style: small; color: muted; maxLines: 1 }
    Column {
      gap: 0
      weight: 1
      clip: true
      padding: [0, 4, 0, 0]
      if rows >= 3 {
        for d in dirty.sortBy(d => -items[d.id]).take(3) key d.id {
          Row {
            Text { text: d.name; style: small; weight: 1; maxLines: 1 }
            Text { text: fmtBytes(items[d.id]); style: small; color: muted; width: 48; align: end }
          }
        }
      }
    }
    if busy == "" && safeTotal > 0 {
      Button { text: "clean all"; color: green; onTap: { pending = "safe"; starting = run("bash -c ${sh(script)} cleaner start safe") } }
    } else {
      Button { text: busy != "" ? "cleaning…" : "clean all"; color: muted; onTap: screen() }
    }
  }

  screen {
    title: "cleaner"
    Column {
      scroll: true
      gap: 10
      padding: [4, 4]

      Column {
        gap: 4
        Row {
          align: bottom
          Text { text: disk ? fmtBytes(disk.avail) : "…"; style: huge; width: 110 }
          Text { text: disk ? "free of ${fmtBytes(disk.size)}" : ""; style: muted; weight: 1 }
        }
        Progress { value: usedPct; color: usedPct > 85 ? red : accent; animate value: spring() }
        Text {
          text: busy != "" ? "cleaning ${busyName}…" : st.at > 0 ? "last clean freed ${fmtBytes(st.freed)}, ${now - st.at < 60 ? "just now" : fmtDuration(now - st.at) + " ago"}" : "not cleaned yet"
          style: small; color: muted
        }
      }

      Row {
        align: center
        Column {
          gap: 0
          weight: 1
          Text { text: safeTotal == null ? "scanning…" : "${fmtBytes(safeTotal)} safe to free"; style: title; color: safeTotal > 0 ? yellow : green }
          Text { text: "nothing here is needed; tools fetch it again if they want it"; style: small; color: muted }
        }
        if busy == "" && safeTotal > 0 {
          Button { text: "clean all"; color: green; width: 110; onTap: { pending = "safe"; starting = run("bash -c ${sh(script)} cleaner start safe") } }
        } else {
          Button { text: busy == "safe" || busy == "auto" ? "cleaning…" : "clean all"; color: muted; width: 110 }
        }
      }

      for d in dirty key d.id {
        Row {
          align: center
          padding: [10, 8]
          border: 1
          borderColor: border
          Column {
            gap: 0
            weight: 1
            Text { text: d.name; bold: true }
            Text { text: d.desc; style: small; color: muted; maxLines: 2 }
          }
          Text { text: fmtBytes(items[d.id]); width: 64; align: end; color: yellow }
          if busy == "" {
            Button { text: "clean"; width: 72; color: accent; onTap: { pending = d.id; starting = run("bash -c ${sh(script)} cleaner start ${sh(d.id)}") } }
          } else {
            Button { text: busy == d.id ? "…" : "clean"; width: 72; color: muted }
          }
        }
      }
      if len(tidy) > 0 {
        Text { text: "already clean: ${join(tidy.map(d => d.name), ", ")}"; style: small; color: muted }
      }

      Text { text: "deeper"; style: label; color: muted }
      Row {
        align: center
        padding: [10, 8]
        border: 1
        borderColor: border
        Column {
          gap: 0
          weight: 1
          Text { text: "whole package cache"; bold: true }
          Text { text: "also the current versions; pacman downloads them again to reinstall or downgrade"; style: small; color: muted; maxLines: 3 }
        }
        Text { text: fmtBytes(items["pkg-all"]); width: 64; align: end; color: orange }
        if busy == "" && items["pkg-all"] > 0 {
          Button { text: "clean"; width: 72; color: orange; onTap: { pending = "pkg-all"; starting = run("bash -c ${sh(script)} cleaner start pkg-all") } }
        } else {
          Button { text: busy == "pkg-all" ? "…" : "clean"; width: 72; color: muted }
        }
      }
      Row {
        align: center
        padding: [10, 8]
        border: 1
        borderColor: border
        Column {
          gap: 0
          weight: 1
          Text { text: "unused packages (${len(orphans)})"; bold: true }
          Text { text: len(orphans) > 0 ? join(orphans, ", ") : "none: every dependency is still needed"; style: small; color: muted; maxLines: 3 }
        }
        if len(orphans) > 0 {
          Button { text: "review"; width: 92; color: orange; onTap: terminal("pacman -Rns $(pacman -Qdtq); echo; read -rp 'press enter to close'", "unused packages") }
        } else {
          Button { text: "review"; width: 92; color: muted }
        }
      }

      Row {
        align: center
        Column {
          gap: 0
          weight: 1
          Text { text: "automatic clean"; bold: true }
          Text {
            text: freq == "off" ? "tap to clean all but the trash daily or weekly" : nextAt > 0 ? "${freq}, next ${fmtTime(nextAt, "EEE d MMM HH:mm")}" : freq
            style: small; color: muted
          }
        }
        Button {
          text: freq; width: 92
          color: freq == "off" ? muted : green
          onTap: {
            // off → daily → weekly → off; both read freq as it was before the tap
            nextAt = freq == "off" ? now + 86400 : freq == "daily" ? now + 7 * 86400 : 0
            freq = freq == "off" ? "daily" : freq == "daily" ? "weekly" : "off"
          }
        }
      }
      Button { text: "rescan"; onTap: refresh() }
    }
  }
}
