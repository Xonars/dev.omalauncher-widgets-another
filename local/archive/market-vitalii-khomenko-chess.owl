      const sEp0 = ep; h1 ^= zS1; h2 ^= zS2; if (ep >= 0) { h1 ^= zE1[ep & 7]; h2 ^= zE2[ep & 7]; } ep = -1; side ^= 1; sp++; sH1[sp] = h1; sH2[sp] = h2; sHalf[sp] = half; half++;
      const v = -search(depth - 3, -beta, -beta + 1, ply + 1, false);
      sp--; half--; side ^= 1; ep = sEp0; h1 ^= zS1; h2 ^= zS2; if (ep >= 0) { h1 ^= zE1[ep & 7]; h2 ^= zE2[ep & 7]; }
      if (aborted) return 0; if (v >= beta) return beta;
    }
  }
  const n = gen(ply, false); orderMoves(ply, n, ttMove);
  let best = -INF, bestM = 0, legal = 0; const a0 = alpha;
  for (let i = 0; i < n; i++) {
    const m = pick(ply, i, n);
    make(m);
    if (attacked(kingSq[side ^ 1], side)) { unmake(m); continue; }
    legal++;
    const quiet = !(m >> 15 & 3) && !((m >> 12) & 7);
    let v;
    if (legal === 1) v = -search(depth - 1, -beta, -alpha, ply + 1, true);
    else {
      let red = 0; if (quiet && depth >= 3 && legal > 4 && !chk) red = 1;
      v = -search(depth - 1 - red, -alpha - 1, -alpha, ply + 1, true);
      if (v > alpha && !aborted) v = -search(depth - 1, -beta, -alpha, ply + 1, true);
    }
    unmake(m);
    if (aborted) return 0;
    if (v > best) { best = v; bestM = m; if (v > alpha) { alpha = v; if (v >= beta) { if (quiet) { if (killers[ply * 2] !== m) { killers[ply * 2 + 1] = killers[ply * 2]; killers[ply * 2] = m; } history[side * 4096 + (m & 63) * 64 + ((m >> 6) & 63)] += depth * depth; } break; } } }
  }
  if (!legal) return chk ? -MATE + ply : 0;
  let s = best; if (s > MATE - 200) s += ply; else if (s < -MATE + 200) s -= ply;
  ttK1[idx] = h1; ttK2[idx] = h2; ttM[idx] = bestM; ttS[idx] = s; ttD[idx] = depth; ttF[idx] = best >= beta ? 1 : best <= a0 ? 2 : 0;
  return best;
}

// Levels: depth cap, time cap (ms), root noise (centipawns)
const LEVELS = [
  { name: 'beginner', depth: 1, ms: 300, noise: 220 },
  { name: 'easy', depth: 2, ms: 500, noise: 110 },
  { name: 'casual', depth: 3, ms: 800, noise: 45 },
  { name: 'club', depth: 7, ms: 800, noise: 0 },
  { name: 'strong', depth: 11, ms: 2500, noise: 0 },
  { name: 'master', depth: 18, ms: 6000, noise: 0 }
];
function think(level, msOverride) {
  const L = LEVELS[level - 1], moves = legalMoves();
  lastScore = 0; if (!moves.length) return 0; if (moves.length === 1) return moves[0];
  const ms = msOverride || L.ms; deadline = Date.now() + ms; aborted = false; nodes = 0;
  if (L.noise) {
    // weak levels: score every root move at a shallow depth and blur the scores
    let best = moves[0], bs = -Infinity; deadline = Date.now() + 4000;
    for (const m of moves) {
      make(m); let v = -search(L.depth - 1, -INF, INF, 1, true); unmake(m);
      v += (Math.random() * 2 - 1) * L.noise; if (v > bs) { bs = v; best = m; }
    }
    lastScore = Math.round(bs);
    return best;
  }
  killers.fill(0); history.fill(0);
  let best = moves[0];
  for (let d = 1; d <= L.depth; d++) {
    let bm = 0, bv = -INF, alpha = -INF; const done = aborted;
    // root move ordering: previous best first
    moves.sort((a, b) => (b === best) - (a === best));
    for (const m of moves) {
      make(m);
      let v = bm ? -search(d - 1, -alpha - 1, -alpha, 1, true) : -search(d - 1, -INF, -alpha, 1, true);
      if (bm && v > alpha && !aborted) v = -search(d - 1, -INF, -alpha, 1, true);
      unmake(m);
      if (aborted) break;
      if (v > bv) { bv = v; bm = m; if (v > alpha) alpha = v; }
    }
    if (aborted) break;
    best = bm; lastScore = bv; if (bv > MATE - 100) break;
    if (Date.now() > deadline - ms * 0.45 && d >= 4) break;
  }
  return best;
}

/* ================= game: history, SAN, results, persistence ================= */
const fs = require('fs'), os = require('os'), path = require('path');
const SAVE_FILE = path.join(os.homedir(), '.local', 'state', 'owl-chess', 'game.json');
const CLOCKS = [{ name: 'Off', base: 0, inc: 0 }, { name: '3 min', base: 180, inc: 0 }, { name: '5 min', base: 300, inc: 0 }, { name: '10 min', base: 600, inc: 0 }, { name: '10+5', base: 600, inc: 5 }, { name: '15+10', base: 900, inc: 10 }];
const G = { hist: [], keys: [], level: 3, playerWhite: true, flip: false, result: null, clock: 0, nextClock: 0, left: [0, 0], mode: 0, nextMode: 0, autoFlip: false, paused: false, startFen: START_FEN };
const PIECE_LETTER = ['', '', 'N', 'B', 'R', 'Q', 'K'];
const mvFrom = m => m & 63, mvTo = m => (m >> 6) & 63, mvPromo = m => (m >> 12) & 7;
const uciOf = m => sqName(mvFrom(m)) + sqName(mvTo(m)) + (mvPromo(m) ? '  nbrq'[mvPromo(m)] : '');
const keyNow = () => h1 + ':' + h2;

function toSAN(m, legal) {
  const f = mvFrom(m), t = mvTo(m), fl = m >> 15, pc = bd[f] & 7;
  let s;
  if (fl & 4) s = t > f ? 'O-O' : 'O-O-O';
  else {
    const cap = (fl & 3) !== 0;
    if (pc === 1) s = (cap ? 'abcdefgh'[f & 7] + 'x' : '') + sqName(t) + (mvPromo(m) ? '=' + 'NBRQ'[mvPromo(m) - 2] : '');
    else {
      let dis = '';
      const others = legal.filter(o => o !== m && mvTo(o) === t && (bd[mvFrom(o)] & 7) === pc);
      if (others.length) {
        const sameFile = others.some(o => (mvFrom(o) & 7) === (f & 7)), sameRank = others.some(o => (mvFrom(o) >> 3) === (f >> 3));
        if (!sameFile) dis = 'abcdefgh'[f & 7]; else if (!sameRank) dis = String((f >> 3) + 1); else dis = sqName(f);
      }
      s = PIECE_LETTER[pc] + dis + (cap ? 'x' : '') + sqName(t);
    }
  }
  make(m);
  const chk = inCheck(); let any = false;
  if (chk) { const n = gen(1, false); for (let i = 0; i < n; i++) { const q = MOVES[1][i]; make(q); const ok = !attacked(kingSq[side ^ 1], side); unmake(q); if (ok) { any = true; break; } } }
  unmake(m);
  return s + (chk ? (any ? '+' : '#') : '');
}
function insufficient() {
  const minors = [];
  for (let s = 0; s < 64; s++) {
    const t = bd[s] & 7; if (!t || t === 6) continue;
    if (t === 1 || t === 4 || t === 5) return false;
    minors.push({ t, c: ((s & 7) + (s >> 3)) & 1 });
  }
  if (minors.length <= 1) return true;
  return minors.every(x => x.t === 3 && x.c === minors[0].c);
}
function gameResult() {
  if (G.result) return G.result;
  const moves = legalMoves();
  if (!moves.length) return inCheck() ? { over: true, win: side ? 0 : 1, text: (side ? 'White' : 'Black') + ' wins by checkmate', short: (side ? 'White' : 'Black') + ' wins · mate' } : { over: true, win: -1, text: 'Draw by stalemate', short: 'Draw · stalemate' };
  if (half >= 100) return { over: true, win: -1, text: 'Draw by the 50-move rule', short: 'Draw · 50 moves' };
  const k = keyNow(); let n = 0; for (const x of G.keys) if (x === k) n++;
  if (n >= 3) return { over: true, win: -1, text: 'Draw by repetition', short: 'Draw · repetition' };
  if (insufficient()) return { over: true, win: -1, text: 'Draw: not enough material', short: 'Draw · material' };
  return { over: false };
}
function playMove(m) {
  const legal = legalMoves(), san = toSAN(m, legal);
  const fl = m >> 15, cap = (fl & 2) ? (PW | (side ^ 1) << 3) : bd[mvTo(m)];
  make(m);
  G.hist.push({ m, san, cap, by: side ^ 1 }); G.keys.push(keyNow());
}
function undoOne() { const e = G.hist.pop(); if (!e) return false; unmake(e.m); G.keys.pop(); return true; }
function resetClock() { const c = CLOCKS[G.clock]; G.left = [c.base * 1000, c.base * 1000]; }
function newGame() { setFen(START_FEN); G.startFen = START_FEN; G.hist = []; G.keys = [keyNow()]; G.result = null; G.clock = G.nextClock; G.mode = G.nextMode; G.paused = false; U.offer = -1; resetClock(); }
function findMove(from, to, promo) {
  return legalMoves().filter(m => mvFrom(m) === from && mvTo(m) === to && (promo === undefined || mvPromo(m) === promo));
}
function save() {
  try {
    fs.mkdirSync(path.dirname(SAVE_FILE), { recursive: true });
    fs.writeFileSync(SAVE_FILE, JSON.stringify({ v: 2, level: G.level, playerWhite: G.playerWhite, flip: G.flip, clock: G.clock, next: G.nextClock, mode: G.mode, nextMode: G.nextMode, autoFlip: G.autoFlip, paused: G.paused, left: G.left, result: G.result, moves: G.hist.map(h => uciOf(h.m)) }));
  } catch (e) { /* best effort */ }
}
function load() {
  newGame();
  try {
    const d = JSON.parse(fs.readFileSync(SAVE_FILE, 'utf8'));
    if (d.level >= 1 && d.level <= LEVELS.length) G.level = d.level;
    G.playerWhite = d.playerWhite !== false; G.flip = !!d.flip; if (d.clock >= 0 && d.clock < CLOCKS.length) G.clock = d.clock;
    G.nextClock = d.next >= 0 && d.next < CLOCKS.length ? d.next : G.clock; resetClock();
    for (const u of d.moves || []) {
      const from = u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, to = u.charCodeAt(2) - 97 + (+u[3] - 1) * 8, pr = u[4] ? '  nbrq'.indexOf(u[4]) : undefined;
      const c = findMove(from, to, pr); if (!c.length) throw new Error('bad move'); playMove(c[0]);
    }
    if (!G.hist.length) { G.clock = G.nextClock; resetClock(); }
    if (Array.isArray(d.left) && d.left.length === 2 && CLOCKS[G.clock].base) G.left = d.left.map(x => Math.max(0, +x || 0));
    G.result = d.result && d.result.over ? d.result : null;
    G.mode = d.mode === 1 ? 1 : 0; G.nextMode = d.nextMode === 1 || d.nextMode === 0 ? d.nextMode : G.mode; if (!G.hist.length) G.mode = G.nextMode;
    G.autoFlip = !!d.autoFlip; G.paused = !!d.paused && !G.result;
  } catch (e) { newGame(); }
}
function bookMove() {
  const opts = { '': ['e2e4', 'd2d4', 'g1f3', 'c2c4'], e2e4: ['e7e5', 'c7c5', 'e7e6', 'c7c6'], d2d4: ['d7d5', 'g8f6', 'e7e6'], g1f3: ['d7d5', 'g8f6', 'c7c5'], c2c4: ['e7e5', 'g8f6', 'c7c5'] };
  if (G.hist.length > 1 || G.level < 3) return 0;
  const list = opts[G.hist.length ? uciOf(G.hist[0].m) : '']; if (!list) return 0;
  const u = list[Math.floor(Math.random() * list.length)];
  const c = findMove(u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, u.charCodeAt(2) - 97 + (+u[3] - 1) * 8);
  return c.length ? c[0] : 0;
}

const { Worker, isMainThread, parentPort } = require('worker_threads');
const U = { vs: 0, offer: -1, sel: -1, targets: [], cursor: 12, kb: false, last: null, hint: null, thinking: false, promo: null, msg: '', msgUntil: 0, arm: '', armUntil: 0, typed: '', res: { over: false }, hits: [], view: 'menu', anim: null, busy: false, needClear: true, token: 0, clkLast: Date.now() };
// mode 0: you against the computer; mode 1: two people on one phone (the side to move is the human, there is no engine)
const viewBlack = () => (G.mode ? (G.autoFlip && U.vs === 1) !== G.flip : G.playerWhite === G.flip);
const humanSide = () => (G.mode ? side : (G.playerWhite ? 0 : 1));
const engineSide = () => (G.mode ? -1 : (G.playerWhite ? 1 : 0));
function toast(t, ms) { U.msg = t; U.msgUntil = Date.now() + (ms || 3000); setTimeout(render, (ms || 3000) + 30); }

function statusLine() {
  if (Date.now() < U.msgUntil) return { t: U.msg, c: C.yellow };
  if (U.res.over) {
    const t = U.res.short || U.res.text;
    return { t, c: U.res.win === -1 ? C.yellow : (G.mode || U.res.win === humanSide() ? C.acc : C.red) };
  }
  if (G.paused) return { t: 'Paused', c: C.yellow };
  if (U.thinking) return { t: 'Thinking…', c: C.blue };
  if (U.promo) return { t: 'Promote to…', c: C.yellow };
  if (G.mode) { const w = side ? 'Black' : 'White'; return { t: inCheck() ? w + ' in check!' : w + ' to move', c: inCheck() ? C.red : C.acc }; }
  if (side === humanSide()) return { t: inCheck() ? 'Check! Your move' : 'Your move', c: inCheck() ? C.red : C.acc };
  return { t: 'Opponent…', c: C.muted };
}

let worker = null; const pendingJobs = new Map(); let jobSeq = 0;
function onWorkerMsg(r) { const cb = pendingJobs.get(r.id); if (cb) { pendingJobs.delete(r.id); cb(r); } }
function thinkAsync(level, ms, cb) {
  const id = ++jobSeq; pendingJobs.set(id, cb);
  try {
    if (!worker) { worker = new Worker(__filename); worker.on('message', onWorkerMsg); worker.on('error', () => { worker = null; }); }
    worker.postMessage({ id, fen: G.startFen, moves: G.hist.map(h => uciOf(h.m)), level, ms });
  } catch (e) { pendingJobs.delete(id); const m = think(level, ms); setImmediate(() => cb({ move: m ? uciOf(m) : '', score: lastScore })); }
}
function cancelThink() { U.token++; U.thinking = false; pendingJobs.clear(); if (worker) { worker.terminate(); worker = null; } }
const moveFromUci = u => { const c = findMove(u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, u.charCodeAt(2) - 97 + (+u[3] - 1) * 8, u[4] ? '  nbrq'.indexOf(u[4]) : undefined); return c.length ? c[0] : 0; };
function workerLoop() {
  parentPort.on('message', q => {
    setFen(q.fen || START_FEN);
    for (const u of q.moves) { const m = moveFromUci(u); if (!m) break; make(m); }
    const m = think(q.level, q.ms);
    parentPort.postMessage({ id: q.id, move: m ? uciOf(m) : '', score: lastScore });
  });
}
const engineMs = () => { let ms = LEVELS[G.level - 1].ms; if (CLOCKS[G.clock].base) ms = Math.min(ms, Math.max(250, G.left[engineSide()] / 25)); return ms; };
function afterMove(m) {
  { const by = G.hist.length ? G.hist[G.hist.length - 1].by : 0; if (CLOCKS[G.clock].base) G.left[by] += CLOCKS[G.clock].inc * 1000; U.clkLast = Date.now(); }
  U.last = { from: mvFrom(m), to: mvTo(m) }; U.sel = -1; U.targets = []; U.hint = null; U.promo = null; U.arm = '';
  U.res = gameResult(); save();
}
function maybeEngine() {
  U.res = gameResult();
  if (G.paused || U.res.over || side !== engineSide() || U.thinking || U.busy) { render(); return; }
  U.thinking = true; const tok = ++U.token; render(); const t0 = Date.now();
  const finish = uci => setTimeout(() => {
    if (tok !== U.token || !U.thinking) return; U.thinking = false;
    const m = uci ? moveFromUci(uci) : 0;
    if (!m) { U.res = gameResult(); render(); return; }
    playMove(m); afterMove(m); animate(m, () => { U.res = gameResult(); render(); });
  }, Math.max(0, 600 - (Date.now() - t0)));
  const book = bookMove(); if (book) return finish(uciOf(book));
  thinkAsync(G.level, engineMs(), r => { if (tok === U.token) finish(r.move); });
}
function humanMove(m) { playMove(m); afterMove(m); animate(m, () => maybeEngine()); }
function trySelect(sq) {
  if (G.paused || U.thinking || U.busy || U.res.over || U.promo || side !== humanSide()) return;
  const pc = bd[sq];
  if (U.sel >= 0 && U.targets.includes(sq)) {
    const c = findMove(U.sel, sq);
    if (c.length > 1) { U.promo = { from: U.sel, to: sq }; render(); return; }
    if (c.length === 1) { humanMove(c[0]); return; }
  }
  if (pc && (pc >> 3) === side) { U.sel = sq; U.targets = legalMoves().filter(m => mvFrom(m) === sq).map(mvTo); }
  else { U.sel = -1; U.targets = []; }
  render();
}
function doPromo(t) { if (!U.promo) return; const c = findMove(U.promo.from, U.promo.to, t); if (c.length) humanMove(c[0]); }
function confirmed(kind) {
  if (U.res.over) return true; // a game in progress (even an empty one) needs a second tap
  if (U.arm === kind && Date.now() < U.armUntil) return true;
  U.arm = kind; U.armUntil = Date.now() + 4000; if (U.view === 'game') toast('Tap ' + (kind === 'new' ? 'New' : 'Side') + ' again to confirm', 4000); else setTimeout(render, 4050);
  render(); return false;
}
function renderBar() { render(); }
function clockTick() {
  const now = Date.now(), dt = now - U.clkLast; U.clkLast = now;
  if (!CLOCKS[G.clock].base || U.view !== 'game' || U.res.over || !G.hist.length || G.paused) return;
  G.left[side] -= dt;
  if (G.left[side] <= 0) {
    G.left[side] = 0; cancelThink();
    G.result = { over: true, win: side ^ 1, text: 'Out of time', short: 'Time · ' + (side ? 'White' : 'Black') + ' wins', time: true }; U.res = G.result; save(); render(); return;
  }
  if (!U.thinking || true) renderBar();
}
function resetBoard() { U.msgUntil = 0; U.last = null; U.sel = -1; U.targets = []; U.hint = null; U.promo = null; U.arm = ''; U.view = 'game'; save(); }
function act(a) {
  if (typeof a === 'object') { doPromo(a.promo); return; }
  if (a === 'menu') { U.view = 'menu'; return render(); }
  if (a === 'moves') { U.view = 'moves'; return render(); }
  if (a === 'close') { U.view = U.view === 'moves' ? 'menu' : 'game'; return render(); }
  const okBusy = ['lvm', 'lvp', 'flip', 'glyphs'], okThinking = okBusy.concat(['new', 'side', 'undo', 'resign', 'clock', 'pause', 'mode', 'autoflip']);
  if (U.busy && !okBusy.includes(a)) return;
  if (U.thinking && !okThinking.includes(a)) return;
  if (G.paused && ['undo', 'hint', 'resign', 'draw'].includes(a)) return; // paused: the board and the clocks are locked
  switch (a) {
    case 'new': if (!confirmed('new')) return; cancelThink(); newGame(); resetBoard(); maybeEngine(); return;
    case 'side': if (G.mode || !confirmed('side')) return; cancelThink(); G.playerWhite = !G.playerWhite; G.flip = false; newGame(); resetBoard(); maybeEngine(); return;
    case 'undo': {
      if (!G.hist.length) return;
      if (G.result && G.result.time) { toast('The game is over', 2000); return; }
      cancelThink(); G.result = null; U.offer = -1; undoOne(); if (G.hist.length && side === engineSide()) undoOne();
      const l = G.hist[G.hist.length - 1]; U.last = l ? { from: mvFrom(l.m), to: mvTo(l.m) } : null;
      U.sel = -1; U.targets = []; U.hint = null; U.promo = null; save(); U.res = gameResult(); maybeEngine(); return;
    }
    case 'hint': {
      if (G.mode) { toast('No hints in 2-player games', 2500); return render(); }
      if (U.res.over || side !== humanSide()) return;
      U.thinking = true; const tok = ++U.token; toast('Looking for a move…', 5000); render();
      thinkAsync(5, 1200, r => { if (tok !== U.token) return; U.thinking = false; U.msgUntil = 0; const m = r.move ? moveFromUci(r.move) : 0; if (m) U.hint = { from: mvFrom(m), to: mvTo(m) }; render(); });
      return;
    }
    case 'resign': {
      if (U.res.over) return;
      if (!(U.arm === 'resign' && Date.now() < U.armUntil)) { U.arm = 'resign'; U.armUntil = Date.now() + 4000; setTimeout(render, 4050); return render(); }
      cancelThink(); G.result = G.mode ? { over: true, win: side ^ 1, text: (side ? 'Black' : 'White') + ' resigned', short: (side ? 'Black' : 'White') + ' resigned' } : { over: true, win: engineSide(), text: 'You resigned', short: 'You resigned' }; U.res = G.result; U.arm = ''; U.view = 'game'; save(); break;
    }
    case 'draw': {
      if (G.mode) { // two people: one offers, the other accepts with its own tap (the offer lapses with the next move)
        if (U.res.over || G.hist.length < 2) { toast(U.res.over ? 'Not now' : 'Too early for a draw', 2000); U.view = 'game'; return render(); }
        U.view = 'game';
        if (U.offer !== G.hist.length) { U.offer = G.hist.length; toast('Draw offered: accept it in the Menu', 6000); return render(); }
        G.result = { over: true, win: -1, text: 'Draw agreed', short: 'Draw agreed' }; U.res = G.result; U.offer = -1; save(); toast('Draw agreed', 3000); return render();
      }
      if (U.res.over || side !== humanSide() || U.thinking) { toast('Not now', 1800); U.view = 'game'; return render(); }
      if (G.hist.length < 8) { toast('Too early for a draw', 2500); U.view = 'game'; return render(); }
      U.view = 'game'; U.thinking = true; const tok = ++U.token; toast('Opponent is thinking…', 4000); render();
      thinkAsync(5, 700, r => {
        if (tok !== U.token) return; U.thinking = false;
        if (-r.score <= 75) { G.result = { over: true, win: -1, text: 'Draw agreed', short: 'Draw agreed' }; U.res = G.result; save(); toast('Draw agreed', 3000); }
        else toast('Draw declined', 3000);
        render();
      });
      return;
    }
    case 'clock': G.nextClock = (G.nextClock + 1) % CLOCKS.length; if (!G.hist.length) { G.clock = G.nextClock; resetClock(); } else toast('Clock applies to the next game', 2500); save(); break;
    case 'flip': G.flip = !G.flip; save(); break;
    case 'autoflip': G.autoFlip = !G.autoFlip; save(); break;
    case 'mode':
      G.nextMode = G.nextMode ? 0 : 1;
      if (!G.hist.length) { cancelThink(); G.mode = G.nextMode; U.arm = ''; resetBoard(); maybeEngine(); return; }
      toast('Mode applies to the next game', 2500); save(); break;
    case 'pause':
      if (U.res.over) return;
      if (!G.paused) { cancelThink(); G.paused = true; U.sel = -1; U.targets = []; U.hint = null; U.promo = null; U.arm = ''; U.view = 'game'; save(); render(); return; }
      G.paused = false; U.clkLast = Date.now(); U.view = 'game'; save(); render(); maybeEngine(); return;
    case 'glyphs': ascii = !ascii; break;
    case 'lvm': G.level = Math.max(1, G.level - 1); save(); break;
    case 'lvp': G.level = Math.min(LEVELS.length, G.level + 1); save(); break;
  }
  render();
}


const fmtClock = ms => { const t=Math.max(0,Math.ceil(ms/1000)); return Math.floor(t/60)+':'+String(t%60).padStart(2,'0'); };
function render() {
  U.vs=side;
  const vb=viewBlack();
  const squares=Array.from({length:64},(_,i)=> { const r=i>>3,c=i&7,sq=(vb?r:7-r)*8+(vb?7-c:c); return {sq,pc:bd[sq],r,c}; });
  const state={squares,selected:U.sel,targets:U.targets,last:U.last,hint:U.hint,
    check:inCheck()?kingSq[side]:-1,status:statusLine().t,paused:G.paused,thinking:U.thinking,
    promo:!!U.promo,view:U.view,arm:Date.now()<U.armUntil?U.arm:'',
    level:G.level,levelName:LEVELS[G.level-1].name,mode:G.mode,nextMode:G.nextMode,
    playerWhite:G.playerWhite,autoFlip:G.autoFlip,clock:CLOCKS[G.nextClock].name,
    clocks:CLOCKS[G.clock].base?'White '+fmtClock(G.left[0])+'  ·  Black '+fmtClock(G.left[1]):'',
    moves:G.hist.map((h,i)=>(i%2===0? (Math.floor(i/2)+1)+'. ':'')+h.san).join(' ')};
  process.stdout.write(JSON.stringify(state)+'\n');
}
function animate(m,done) { render(); if(done) done(); }
const C={}; let ascii=false;
if (!isMainThread) workerLoop();
else {
  load(); U.res=gameResult();
  const last=G.hist.at(-1); if(last) U.last={from:mvFrom(last.m),to:mvTo(last.m)};
  // Append-only requests preserve quick consecutive taps; old requests are never replayed.
  const requests=path.join(os.homedir(),'.cache/owl-chess/touch-requests');
  fs.closeSync(fs.openSync(requests,'a',0o600));
  let offset=fs.statSync(requests).size, partial='';
  fs.watchFile(requests,{interval:100},()=>{
    const end=fs.statSync(requests).size; if(end<=offset)return;
    const fd=fs.openSync(requests,'r'), buf=Buffer.alloc(end-offset);
    fs.readSync(fd,buf,0,buf.length,offset);fs.closeSync(fd);offset=end;
    const rows=(partial+buf.toString()).split('\n');partial=rows.pop();
    for(const row of rows) { try {
      const q=JSON.parse(row);
      if(q.kind==='square' && Number.isInteger(q.value) && q.value>=0 && q.value<64 && U.view==='game') trySelect(q.value);
      else if(q.kind==='promo' && [2,3,4,5].includes(q.value)) doPromo(q.value);
      else if(q.kind==='action' && ['menu','moves','close','new','side','undo','hint','resign','draw','clock','flip','autoflip','mode','pause','lvm','lvp'].includes(q.value)) act(q.value);
    } catch(e) { /* ignore malformed requests */ } }
  });
  setInterval(clockTick,500);
  process.on('SIGTERM',()=>{save();cancelThink();process.exit(0);});
  process.on('SIGINT',()=>{save();cancelThink();process.exit(0);});
  render();maybeEngine();
}

CHESS_JS_EOF
exec node ~/.cache/owl-chess/touch.js
""") json

  asset white1 = base64""
  asset white2 = base64""
  asset white3 = base64""
  asset white4 = base64""
  asset white5 = base64""
  asset white6 = base64""
  asset black1 = base64""
  asset black2 = base64""
  asset black3 = base64""
  asset black4 = base64""
  asset black5 = base64""
  asset black6 = base64""
  let pieceImages = [white1, white2, white3, white4, white5, white6, black1, black2, black3, black4, black5, black6]

  component Action(label, action, grow = 0) {
    Button {
      text: label
      weight: grow
      fill: width
      height: 34
      onTap: run("node -e 'require(\"fs\").appendFileSync(require(\"os\").homedir()+\"/.cache/owl-chess/touch-requests\",JSON.stringify({kind:\"action\",value:process.argv[1]})+\"\\n\")' ${sh(action)}")
    }
  }
  let edge = max(80, min(tileWidth - 8, tileHeight - 110))
  Column { gap: 3; fill: true; align: center
    Text { text: game.status ?? "Loading chess…"; fontSize: 14; align: center; maxLines: 1; color: game.thinking ? blue : foreground }
    if game.view == "menu" {
      Column { fill: width; weight: 1; scroll: true; gap: 5
        Text { text: "Level ${game.level} · ${game.levelName}"; align: center }
        Row { fill: width
          Action { grow: 1; label: "− Level"; action: "lvm" }
          Action { grow: 1; label: "+ Level"; action: "lvp" }
        }
        Action { label: game.nextMode == 1 ? "Mode: 2 players" : "Mode: computer"; action: "mode" }
        Action { label: "Clock: ${game.clock}"; action: "clock" }
        Action { label: game.arm == "side" ? "Confirm side switch" : game.playerWhite ? "You: White · switch" : "You: Black · switch"; action: "side" }
        Action { label: game.autoFlip ? "Auto flip: on" : "Auto flip: off"; action: "autoflip" }
        Row { fill: width
          Action { grow: 1; label: "Moves"; action: "moves" }
          Action { grow: 1; label: "Flip board"; action: "flip" }
        }
        Row { fill: width
          Action { grow: 1; label: game.arm == "resign" ? "Confirm resign" : "Resign"; action: "resign" }
          Action { grow: 1; label: "Draw"; action: "draw" }
        }
      }
      Row { fill: width
        Action { grow: 1; label: game.arm == "new" ? "Confirm new game" : "New game"; action: "new" }
        Action { grow: 1; label: "Back"; action: "close" }
      }
    } else if game.view == "moves" {
      Column { weight: 1; fill: width; scroll: true
        Text { text: game.moves == "" ? "No moves yet" : game.moves; maxLines: 100; fontSize: 16 }
      }
      Action { label: "Back"; action: "close" }
    } else {
      Canvas {
        width: edge; height: edge
        let cell = width / 8
        for s in game.squares {
          let px = s.c * cell
          let py = s.r * cell
          let light = (s.r + s.c) % 2 == 0
          rect(px, py, cell, cell, fill: light ? #c9bea5 : #708676)
          if s.sq == game.last.from || s.sq == game.last.to { rect(px, py, cell, cell, fill: alpha(yellow, 0.35)) }
          if s.sq == game.hint.from || s.sq == game.hint.to { rect(px, py, cell, cell, fill: alpha(blue, 0.55)) }
          if s.sq == game.check { rect(px, py, cell, cell, fill: alpha(red, 0.7)) }
          if s.sq == game.selected { rect(px + 1, py + 1, cell - 2, cell - 2, stroke: #f4d35e, width: 3) }
          if s.pc > 0 {
            let white = s.pc < 8
            image(pieceImages[(white ? 0 : 6) + s.pc % 8 - 1], px + cell * 0.06, py + cell * 0.06, cell * 0.88, cell * 0.88)
          }
          if any(game.targets, t => t == s.sq) {
            if s.pc > 0 { circle(px + cell / 2, py + cell / 2, cell * 0.42, stroke: #f4d35e, width: 3) }
            else { circle(px + cell / 2, py + cell / 2, cell * 0.12, fill: #f4d35e) }
          }
          if s.c == 0 { text("${floor(s.sq / 8) + 1}", px + 3, py + 6, size: 8, color: light ? #263b31 : #fff4d7) }
          if s.r == 7 { text(sub("abcdefgh", s.sq % 8, s.sq % 8 + 1), px + cell - 5, py + cell - 5, size: 8, color: light ? #263b31 : #fff4d7) }
        }
        if game.paused {
          rect(0, 0, width, height, fill: alpha(#000000, 0.6))
          text("PAUSED", width / 2, height / 2, size: 24, align: center, color: #fff4d7)
        }
        onTap: {
          let index = clamp(floor(y / (edge / 8)), 0, 7) * 8 + clamp(floor(x / (edge / 8)), 0, 7)
          run("node -e 'require(\"fs\").appendFileSync(require(\"os\").homedir()+\"/.cache/owl-chess/touch-requests\",JSON.stringify({kind:\"square\",value:Number(process.argv[1])})+\"\\n\")' ${int(game.squares[index].sq)}")
        }
      }
      if game.promo {
        Row { fill: width; gap: 3
          for p in [{n: "Queen", v: 5}, {n: "Rook", v: 4}, {n: "Bishop", v: 3}, {n: "Knight", v: 2}] {
            Button { text: p.n; weight: 1
              onTap: run("node -e 'require(\"fs\").appendFileSync(require(\"os\").homedir()+\"/.cache/owl-chess/touch-requests\",JSON.stringify({kind:\"promo\",value:Number(process.argv[1])})+\"\\n\")' ${int(p.v)}")
            }
          }
        }
      } else {
        Text { text: game.clocks != "" ? game.clocks : "Level ${game.level} · ${game.mode == 1 ? '2 players' : game.levelName}"; fontSize: 12; align: center; maxLines: 1 }
      }
      Row { fill: width; gap: 3
        Action { grow: 1; label: "Undo"; action: "undo" }
        Action { grow: 1; label: "Hint"; action: "hint" }
        Action { grow: 1; label: game.paused ? "Resume" : "Pause"; action: "pause" }
        Action { grow: 1; label: "Menu"; action: "menu" }
      }
    }
  }
}
