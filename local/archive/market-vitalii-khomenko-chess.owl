const KEG = [-50, -40, -30, -20, -20, -30, -40, -50, -30, -20, -10, 0, 0, -10, -20, -30, -30, -10, 20, 30, 30, 20, -10, -30, -30, -10, 30, 40, 40, 30, -10, -30, -30, -10, 30, 40, 40, 30, -10, -30, -30, -10, 20, 30, 30, 20, -10, -30, -30, -30, 0, 0, 0, 0, -30, -30, -50, -30, -30, -30, -30, -30, -30, -50];
// tables are written top-down from white's view (rank 8 first); index for a white piece on sq is (sq ^ 56), black uses sq itself.
const PHASE = [0, 0, 1, 1, 2, 4, 0];
function evaluate() {
  let sc = 0, kmg = 0, keg = 0, ph = 0, bw = 0, bb = 0;
  for (let s = 0; s < 64; s++) {
    const p = bd[s]; if (!p) continue; const t = p & 7;
    if (p & 8) {
      if (t === 6) { kmg -= T[6][s]; keg -= KEG[s]; } else { sc -= VAL[t] + T[t][s]; ph += PHASE[t]; if (t === 3) bb++; }
    } else {
      const i = s ^ 56;
