}

// ---- make / unmake
const sCap = new Int8Array(1024), sCas = new Uint8Array(1024), sEp = new Int8Array(1024), sHalf = new Int16Array(1024), sH1 = new Int32Array(1024), sH2 = new Int32Array(1024);
let sp = 0;
function make(m) {
  const f = m & 63, t = (m >> 6) & 63, pr = (m >> 12) & 7, fl = m >> 15, pc = bd[f];
  let cap = bd[t]; sp++;
  sH1[sp] = h1; sH2[sp] = h2; sCas[sp] = castle; sEp[sp] = ep; sHalf[sp] = half;
  h1 ^= zC1[castle]; h2 ^= zC2[castle]; if (ep >= 0) { h1 ^= zE1[ep & 7]; h2 ^= zE2[ep & 7]; }
  bd[f] = 0; h1 ^= zP1[pc * 64 + f]; h2 ^= zP2[pc * 64 + f];
  if (cap) { h1 ^= zP1[cap * 64 + t]; h2 ^= zP2[cap * 64 + t]; }
  const np = pr ? (pr | side << 3) : pc;
  bd[t] = np; h1 ^= zP1[np * 64 + t]; h2 ^= zP2[np * 64 + t];
  half = (cap || (pc & 7) === 1) ? 0 : half + 1; ep = -1;
  if (fl & 2) { const cs = side ? t + 8 : t - 8; cap = bd[cs]; h1 ^= zP1[cap * 64 + cs]; h2 ^= zP2[cap * 64 + cs]; bd[cs] = 0; }
  else if (fl & 8) ep = (f + t) >> 1;
  else if (fl & 4) {
    const rf = t === 6 ? 7 : t === 2 ? 0 : t === 62 ? 63 : 56, rt = t === 6 ? 5 : t === 2 ? 3 : t === 62 ? 61 : 59, rp = bd[rf];
    bd[rf] = 0; bd[rt] = rp; h1 ^= zP1[rp * 64 + rf] ^ zP1[rp * 64 + rt]; h2 ^= zP2[rp * 64 + rf] ^ zP2[rp * 64 + rt];
  }
  sCap[sp] = cap;
  castle &= cMask[f] & cMask[t];
  if ((pc & 7) === 6) kingSq[side] = t;
  h1 ^= zC1[castle]; h2 ^= zC2[castle]; if (ep >= 0) { h1 ^= zE1[ep & 7]; h2 ^= zE2[ep & 7]; }
  if (side) full++;
  side ^= 1; h1 ^= zS1; h2 ^= zS2;
}
function unmake(m) {
  const f = m & 63, t = (m >> 6) & 63, pr = (m >> 12) & 7, fl = m >> 15;
  side ^= 1; if (side) full--;
  const cap = sCap[sp]; const pc = pr ? (PW | side << 3) : bd[t];
  bd[f] = pc;
  if (fl & 2) { bd[t] = 0; bd[side ? t + 8 : t - 8] = cap; } else bd[t] = fl & 1 ? cap : 0;
  if (fl & 4) {
    const rf = t === 6 ? 7 : t === 2 ? 0 : t === 62 ? 63 : 56, rt = t === 6 ? 5 : t === 2 ? 3 : t === 62 ? 61 : 59;
    bd[rf] = bd[rt]; bd[rt] = 0;
  }
  if ((pc & 7) === 6) kingSq[side] = f;
  castle = sCas[sp]; ep = sEp[sp]; half = sHalf[sp]; h1 = sH1[sp]; h2 = sH2[sp]; sp--;
}

function legalMoves() {
  const n = gen(0, false), res = [];
  for (let i = 0; i < n; i++) { const m = MOVES[0][i]; make(m); const ok = !attacked(kingSq[side ^ 1], side); unmake(m); if (ok) res.push(m); }
  return res;
}
function perft(d, ply) {
  if (d === 0) return 1; const n = gen(ply, false); let c = 0;
  for (let i = 0; i < n; i++) { const m = MOVES[ply][i]; make(m); if (!attacked(kingSq[side ^ 1], side)) c += d === 1 ? 1 : perft(d - 1, ply + 1); unmake(m); }
  return c;
}

// ---- evaluation (simplified evaluation function, tapered king)
const VAL = [0, 100, 320, 330, 500, 900, 0];
const T = {
  1: [0, 0, 0, 0, 0, 0, 0, 0, 50, 50, 50, 50, 50, 50, 50, 50, 10, 10, 20, 30, 30, 20, 10, 10, 5, 5, 10, 25, 25, 10, 5, 5, 0, 0, 0, 20, 20, 0, 0, 0, 5, -5, -10, 0, 0, -10, -5, 5, 5, 10, 10, -20, -20, 10, 10, 5, 0, 0, 0, 0, 0, 0, 0, 0],
  2: [-50, -40, -30, -30, -30, -30, -40, -50, -40, -20, 0, 0, 0, 0, -20, -40, -30, 0, 10, 15, 15, 10, 0, -30, -30, 5, 15, 20, 20, 15, 5, -30, -30, 0, 15, 20, 20, 15, 0, -30, -30, 5, 10, 15, 15, 10, 5, -30, -40, -20, 0, 5, 5, 0, -20, -40, -50, -40, -30, -30, -30, -30, -40, -50],
  3: [-20, -10, -10, -10, -10, -10, -10, -20, -10, 0, 0, 0, 0, 0, 0, -10, -10, 0, 5, 10, 10, 5, 0, -10, -10, 5, 5, 10, 10, 5, 5, -10, -10, 0, 10, 10, 10, 10, 0, -10, -10, 10, 10, 10, 10, 10, 10, -10, -10, 5, 0, 0, 0, 0, 5, -10, -20, -10, -10, -10, -10, -10, -10, -20],
  4: [0, 0, 0, 0, 0, 0, 0, 0, 5, 10, 10, 10, 10, 10, 10, 5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, -5, 0, 0, 0, 0, 0, 0, -5, 0, 0, 0, 5, 5, 0, 0, 0],
  5: [-20, -10, -10, -5, -5, -10, -10, -20, -10, 0, 0, 0, 0, 0, 0, -10, -10, 0, 5, 5, 5, 5, 0, -10, -5, 0, 5, 5, 5, 5, 0, -5, 0, 0, 5, 5, 5, 5, 0, -5, -10, 5, 5, 5, 5, 5, 0, -10, -10, 0, 5, 0, 0, 0, 0, -10, -20, -10, -10, -5, -5, -10, -10, -20],
  6: [-30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30, -30, -40, -40, -50, -50, -40, -40, -30, -20, -30, -30, -40, -40, -30, -30, -20, -10, -20, -20, -20, -20, -20, -20, -10, 20, 20, 0, 0, 0, 0, 20, 20, 20, 30, 10, 0, 0, 10, 30, 20]
