ddllbbrrrA","..ilrlllldddddotoooootojjdddllllruB","..suulllllldddvwooooovvjjdlllluuuuB","...sulllllllvwooooooooovxllllluuuB","....sullllllvvyyyyoyyyovxlllluuuB",".....sulllllvvvyvvvvvyxxxllluuuB","......sullllldvvvvxxxxxdllluuuB",".......sullldggzggxddddddluuuB","........suulggzbzddddbdddduuB",".........sulgbbbbbdbbbbbdduB",".........cdgbbbbbbbbbbbbbjjk",".........cdgdbbbbbdbbbbbdljk",".........cdddddbdddddblddljk",".........cdddldlddbddddddjjk",".........cdddldlbmmbbdddjjjk","..........cddddbmbbbbrjljjk","..........cddddbbbqbbrjljjk","...........cdddbbbbbrrjjjk","..........CChjjdbbrrrjjjCCC",".........CoooojjjjrjjjjooooC","........CooooooooojoooooooooD",".........CoooooooDkCoooooooD","..........DDCoDDD...DDCoDDD",".............D.........D"]],"h":35,"ox":18,"oy":1,"pal":{"A":"#2e222a","B":"#141235","C":"#13112e","D":"#120f2a","E":"#29376f","F":"#48372d","a":"#614b2b","b":"#e2b232","c":"#1c275f","d":"#2c52bc","e":"#171a44","f":"#3c4063","g":"#8094c7","h":"#1a1e50","i":"#151b4b","j":"#273c94","k":"#16163c","l":"#1b3488","m":"#eecd74","n":"#3c2d28","o":"#141a3a","p":"#14143a","q":"#946a14","r":"#9f7c39","s":"#161743","t":"#ffe84a","u":"#1c2872","v":"#4f7ee6","w":"#95aee0","x":"#3e59b0","y":"#ffffff","z":"#d9e0f3"},"s":0.65,"w":37}},"fx":[{"angle":[-90,32,2.4],"color":"#8fd8ff","cycle":9,"from":["dino",20,18],"len":0.9,"on":[1.5,3.2],"type":"beam","width":3,"zones":[1]},{"a":["dino",20,18],"b":["hero",17,14],"color":"#8fd8ff","color2":"#ffe14a","cycle":9,"on":[1.5,3.2],"type":"clash","width":3,"zones":[3]},{"at":["hero",11,16],"color":"#ffe14a","cycle":9,"on":[3.2,4.4],"r":14,"type":"sparks","zones":[3]},{"a":["hero",19,5],"b":["duck",18,14],"color":"#ffe14a","cycle":1.6,"on":[0,0.5],"type":"link","width":2,"zones":[4]},{"a":["heli1",0,3],"b":["kong",18,14],"color":"#ffe14a","cycle":1.2,"on":[0,0.35],"type":"link","width":1,"zones":[2]},{"a":["heli2",0,3],"b":["kong",18,18],"color":"#ffe14a","cycle":1.2,"on":[0.6,0.95],"type":"link","width":1,"zones":[2]},{"at":["kong",18,11],"color":"#ffe14a","cycle":3,"on":[2,3],"r":22,"type":"sparks","zones":[2]}]},"body":"// name: KAIJU TOKYO 特攝片場\n// mascot: ufo\n// tag: ufopump\n// thumb: 3\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nvoid palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac) {\nif (z < 0.5)      { bg = hx(0x4a2a6a); c0 = hx(0xc0486a); c1 = hx(0xf08a4a); c2 = hx(0xffd87a); ac = hx(0xff3a2a); }\nelse if (z < 1.5) { bg = hx(0x0a0a2a); c0 = hx(0x1a2a6a); c1 = hx(0x3a5ab0); c2 = hx(0xa8d8ff); ac = hx(0xff2a3a); }\nelse if (z < 2.5) { bg = hx(0x2a6ac8); c0 = hx(0x5a9ae8); c1 = hx(0x9accf4); c2 = hx(0xf0faff); ac = hx(0xffb82a); }\nelse if (z < 3.5) { bg = hx(0x7a1430); c0 = hx(0xd8403a); c1 = hx(0xff8a3a); c2 = hx(0xfff0a0); ac = hx(0x3af0c0); }\nelse              { bg = hx(0x05041a); c0 = hx(0x2a1a6a); c1 = hx(0x6a3ac0); c2 = hx(0xff8ad0); ac = hx(0x5ff0ff); }\n}\nfloat4 tower(float x, float slot, float minW, float maxW, float seed) {\nfloat id = floor(x / slot);\nfloat w = floor(minW + hash1(id * 3.1 + seed) * (maxW - minW + 1.0));\nfloat x0 = floor(hash1(id * 7.7 + seed) * (slot - w));\nfloat lx = x - id * slot - x0;\nreturn float4(lx >= 0.0 && lx < w ? 1.0 : 0.0, lx, w, id);\n}\nhalf4 main(float2 p) {\nfloat s = PX();\nfloat2 c = floor(p / s);\nfloat2 G = floor(size / s);\nfloat t = time * max(speed, 0.0);\nhalf3 bg; half3 c0; half3 c1; half3 c2; half3 ac;\npalette(zone, bg, c0, c1, c2, ac);\nhalf3 ink = hx(0x120c26);\nfloat v = c.y / G.y;\nfloat2 q = floor(c / 4.0);\nhalf3 col;\nif (zone > 3.5) {\ncol = mix(bg, c0, band(v * 0.8, q, 5.0));\n} else if (zone > 2.5) {\nfloat2 o = float2(G.x * 0.5, G.y * 0.95);\nfloat ang = atan(c.x - o.x, o.y - c.y);\nfloat ray = step(0.5, fract(ang * 3.0 + t * 0.05));\ncol = ramp(bg, c0, c1, band(v * 0.9, q, 5.0));\nif (ray > 0.5) col = mix(col, c1, 0.35);\n} else {\ncol = ramp(bg, c0, c1, band(clamp(v * 1.15, 0.0, 1.0), q, 5.0));\n}\nif (zone < 0.5) {\nfloat2 so = float2(G.x * 0.7, G.y * 0.5);\nfloat2 d = c - so;\nif (dot(d, d) < 26.0 * 26.0 && mod(c.y - so.y + 40.0, 6.0) < 4.0 - max(0.0, d.y) / 9.0) col = mix(c2, hx(0xffffff), 0.25);\n}\nif (zone > 0.5 && zone < 1.5 || zone > 3.5) {\nfloat2 sc = floor(c / 7.0);\nfloat2 sp = sc * 7.0 + floor(float2(hash2(sc), hash2(sc + 1.7)) * 6.0);\nif (all(equal(c, sp)) && hash2(sc + 3.1) < 0.45 && v < 0.6) col = mix(col, c2, 0.5 + 0.5 * sin(t * 1.3 + hash2(sc) * 9.0));\n}\nif (zone > 1.5 && zone < 2.5) {\nfloat cx = mod(c.x + t * 3.0, G.x + 60.0) - 30.0;\nfloat2 cl = float2(cx - G.x * 0.3, c.y - G.y * 0.16);\nif (dot(cl * float2(0.18, 0.45), cl * float2(0.18, 0.45)) < 4.0 && cl.y < 3.0) col = cl.y > 1.0 ? mix(c1, c2, 0.5) : c2;\n}\nif (zone > 0.5 && zone < 1.5) {\nfor (int i = 0; i < 2; i++) {\nfloat fi = float(i);\nfloat2 base = float2(G.x * (0.25 + 0.5 * fi), G.y + 2.0);\nfloat ang = sin(t * (0.35 + 0.1 * fi) + fi * 2.4) * 0.55;\nfloat2 dir = float2(sin(ang), -cos(ang));\nfloat2 rel = c - base;\nfloat along = dot(rel, dir);\nfloat perp = abs(rel.x * dir.y - rel.y * dir.x);\nif (along > 0.0 && perp < 1.5 + along * 0.07 && dith(0.5 * (1.0 - along / G.y), c)) col = mix(col, c2, 0.3);\n}\n}\nfloat ground = G.y - floor(G.y * 0.08);\nfloat tx = G.x * 0.22;\nfloat th = G.y * 0.42;\nfloat ty = c.y - (ground - th);\nif (ty > 0.0) {\nfloat half_ = 3.0 + ty * 0.13;\nfloat dx = abs(c.x - tx);\nif (dx < half_) {\nbool edge = dx > half_ - 1.6 || mod(ty + floor(dx), 5.0) < 1.0 || mod(ty - floor(dx), 5.0) < 1.0;\nif (edge) col = mod(floor(ty / 14.0), 2.0) == 0.0 ? hx(0xe8482a) : hx(0xf4ece0);\nif (abs(ty - th * 0.38) < 1.5 || abs(ty - th * 0.62) < 1.0) col = hx(0xe8482a);\n}\nif (ty < 0.0 + 3.0 && dx < 0.6) col = hx(0xf4ece0);\n}\nif (c.y < ground - th + 1.0 && c.y > ground - th - 6.0 && abs(c.x - tx) < 0.6) col = hx(0xc0c8d0);\nif (abs(c.y - (ground - th - 6.0)) < 1.0 && abs(c.x - tx) < 1.0 && sin(t * 2.5) > 0.0) col = hx(0xff3a2a);\nfloat4 f = tower(c.x, 13.0, 6.0, 11.0, 5.0);\nfloat fh = G.y * (0.22 + hash1(f.w * 1.9) * 0.18);\nif (f.x > 0.0 && c.y > ground - fh) {\ncol = mix(ink, c0, zone > 1.5 && zone < 2.5 ? 0.45 : 0.22);\nif (mod(f.y, 3.0) == 1.0 && mod(c.y, 4.0) == 1.0 && hash3(float3(f.w, f.y, floor(c.y / 4.0))) < (zone > 1.5 && zone < 2.5 ? 0.06 : 0.25)) col = mix(c1, c2, 0.6);\n}\nfloat rail = ground - floor(G.y * 0.16);\nif (abs(c.y - rail) < 0.6) col = mix(ink, c0, 0.4);\nif (c.y > rail && c.y < ground && mod(c.x, 34.0) < 2.0) col = mix(ink, c0, 0.35);\nfloat trainX = mod(t * 18.0, G.x + 120.0) - 100.0;\nfloat lx = c.x - trainX;\nif (lx > 0.0 && lx < 96.0 && c.y > rail - 7.0 && c.y < rail) {\ncol = mod(lx, 24.0) < 1.0 ? ink : mix(mix(c1, c2, 0.5), hx(0x9ad84a), 0.45);\nif (c.y > rail - 5.0 && c.y < rail - 2.0 && mod(lx, 6.0) > 1.0 && mod(lx, 24.0) > 2.0) col = zone > 0.5 && zone < 1.5 ? hx(0xffe8a0) : mix(c2, hx(0xffffff), 0.4);\n}\nfloat4 m = tower(c.x + 9.0, 30.0, 14.0, 22.0, 2.0);\nfloat mh = G.y * (0.12 + hash1(m.w * 2.3) * 0.16);\nif (m.x > 0.0 && c.y > ground - mh) {\nfloat my = c.y - (ground - mh);\ncol = mix(ink, c0, zone > 1.5 && zone < 2.5 ? 0.85 : 0.62);\nif (m.y < 1.0) col = mix(c0, c1, 0.6);\nif (my < 1.0) col = mix(c0, c2, 0.4);\nif (mod(m.y, 3.0) != 0.0 && mod(my, 5.0) > 1.0 && mod(my, 5.0) < 4.0 && m.y > 1.0 && m.y < m.z - 1.0) {\nfloat h = hash3(float3(m.w, floor(m.y / 3.0), floor(my / 5.0)));\nif (h < 0.3) col = zone > 1.5 && zone < 2.5 ? mix(c0, c2, 0.5) : mix(c1, c2, 0.7);\n}\nif (hash1(m.w + 0.4) < 0.5 && my > 4.0 && my < 10.0 && m.y > 2.0 && m.y < m.z - 2.0) {\nbool alarm = zone > 0.5 && zone < 1.5;\ncol = alarm && sin(t * 3.1) < 0.0 ? mix(ink, ac, 0.4) : ac;\nif (mod(m.y + my, 3.0) == 0.0) col = mix(col, hx(0xffffff), 0.5);\n}\nif (zone > 0.5 && zone < 1.5 && hash1(m.w + 0.8) < 0.5) {\nfloat2 hole = float2(m.z * 0.5, mh * 0.35);\nfloat2 hd = float2(m.y, my) - hole;\nfloat r2 = dot(hd * float2(1.0, 1.3), hd * float2(1.0, 1.3));\nif (r2 < 16.0) col = ink;\nfloat fl = hash3(float3(m.w, floor(t * 6.0), floor(m.y / 2.0)));\nif (r2 < 30.0 && r2 > 9.0 && hd.y < 1.0 && fl < 0.6) col = fl < 0.25 ? hx(0xffe14a) : hx(0xff7a1a);\n}\n}\nif (zone > 0.5 && zone < 1.5) {\nfloat2 sc = floor(float2(c.x, c.y + t * 5.0) / float2(5.0, 6.0));\nif (hash2(sc) < 0.12 && v > 0.45 && v < 0.85 && dith(0.4, c)) col = mix(col, hx(0x6a6070), 0.5);\n}\nif (zone > 0.5 && zone < 1.5) {\nfor (int i = 0; i < 2; i++) {\nfloat fi = float(i);\nfloat jx = mod(t * (22.0 + 8.0 * fi) + fi * 90.0, G.x + 60.0) - 30.0;\nfloat jy = floor(G.y * (0.18 + 0.12 * fi));\nfloat2 r = c - float2(floor(jx), jy);\nif (r.y >= 0.0 && r.y < 3.0 && r.x > -8.0 && r.x < 3.0 && !(r.y == 0.0 && r.x > -6.0) && !(r.y == 2.0 && r.x > -2.0)) col = mix(c2, hx(0xffffff), 0.3);\nif (r.y == 1.0 && r.x == 2.0) col = ac;\nif (abs(c.x - floor(jx - 3.0)) < 0.6 && c.y < jy) col = mix(col, hx(0xd0d0d0), 0.35);\n}\n}\nfloat edgeW = floor(max(8.0, G.x * 0.07));\nfloat nlx = c.x < edgeW ? edgeW - 1.0 - c.x : c.x > G.x - edgeW - 1.0 ? c.x - (G.x - edgeW) : -1.0;\nif (nlx >= 0.0 && c.y > G.y * 0.3) {\ncol = mix(ink, c0, 0.18);\nif (nlx == 0.0) col = mix(ink, c1, 0.35);\nif (nlx > 1.0 && mod(nlx, 3.0) == 0.0 && mod(c.y, 6.0) == 2.0 && hash2(float2(nlx, floor(c.y / 6.0))) < 0.3) col = mix(c1, c2, 0.5);\n}\nif (c.y >= ground) {\ncol = mix(ink, c0, 0.25);\nif (c.y == ground) col = mix(ink, c1, 0.5);\nif (mod(c.x + floor(c.y) * 2.0, 12.0) < 1.0) col = mix(ink, c0, 0.4);\n}\nreturn half4(col, 1.0);\n}\n","en":"KAIJU TOKYO","id":"60-kaiju","kind":"preset","mascot":"ufo","name":"KAIJU TOKYO 特攝片場","pal":[{"ac":"#ff3a2a","bg":"#4a2a6a","c0":"#c0486a","c1":"#f08a4a","c2":"#ffd87a","fg":"#ffd87a","ink":"#4a2a6a","lite":"#ffd87a"},{"ac":"#ff2a3a","bg":"#0a0a2a","c0":"#1a2a6a","c1":"#3a5ab0","c2":"#a8d8ff","fg":"#a8d8ff","ink":"#0a0a2a","lite":"#a8d8ff"},{"ac":"#ffb82a","bg":"#2a6ac8","c0":"#5a9ae8","c1":"#9accf4","c2":"#f0faff","fg":"#f0faff","ink":"#0e2546","lite":"#f0faff"},{"ac":"#3af0c0","bg":"#7a1430","c0":"#d8403a","c1":"#ff8a3a","c2":"#fff0a0","fg":"#fff0a0","ink":"#7a1430","lite":"#fff0a0"},{"ac":"#5ff0ff","bg":"#05041a","c0":"#2a1a6a","c1":"#6a3ac0","c2":"#ff8ad0","fg":"#5ff0ff","ink":"#05041a","lite":"#5ff0ff"}],"prompt":null,"tag":"ufopump","thumb":null,"tile":null,"zh":"特攝片場","zone":3}]}""")
  source installed = file("~/.cache/pixbg/store-version")
  source setupState = file("~/.cache/pixbg/setup-state")
  let ready = installed == "1.1-120feeb1e70a" && len(bundle.scenes ?? []) >= 5
  source exp = file("~/.cache/pixbg/export.json") json
  source st = file("~/.cache/pixbg/status.json") json
  source walls = file("~/.cache/pixbg/walls.json") json
  // 兩個 agent CLI 裝了沒、登入了沒（pixbg agents 寫的）
  source agents = file("~/.cache/pixbg/agents.json") json
  source now = clock every 1s
  // 只用來算螢幕密度，讓角色的格子和 shader 的像素格一樣大
  source sys = android.system every 30m
  state sel = "05-ramen" persist
  state langCode = "" persist
  state zone = 2 persist
  state speed = 1 persist
  state wish = "" persist
  state sound = false persist
  state showClock = false persist
  state pet = true persist
  state tileClean = false persist
  // 主畫面的磚：預設放場景縮圖（不耗電），使用者可在設定裡改成一直播動畫
  state tileLive = false persist
  state langWish = "" persist
  state panel = true persist
  state hiddenAt = 0
  state langOpen = false persist
  state poke = 0
  // 在磚上點按鈕或吉祥物的時間：之後幾秒磚上播動畫
  state liveAt = 0
  // 打開全螢幕頁的時間：當作捲動區的 key，每次打開都從頭開始（目前場景的卡片在底部），不停在上次捲到的地方。
  // 這幾個介面狀態都要 persist：pixbg 拍圖時會重新載入小工具，不 persist 的會被重設，畫面就自己跳
  state openedAt = 0 persist
  // 點了「▼ 更多」的時間：比這次打開晚才展開，所以每次打開都回到第一層
  state moreAt = 0 persist
  let more = moreAt > 0 && moreAt >= openedAt
  state copiedAt = 0
  // 刪除要按兩次：第一次記下要刪哪個場景、什麼時候按的，10 秒內在確認框按「確認刪除」才真的刪
  state delId = ""
  state delAt = 0
  // 場景名下的小字「管理這個場景」點開才有編輯、刪除；editOpen 是正在寫修改要求的場景
  state manageId = "" persist
  state editOpen = "" persist
  state editWish = "" persist

  // 目前的場景。設為桌布時 export.json 指定要畫哪一個、隱藏介面。
  // 只認 2 分鐘內寫的：pixbg 萬一在匯出中途被殺，介面也不會一直藏著
  let list = ready ? bundle.scenes : tripBuiltin.scenes
  let exporting = exp.on == true && exp.tile != true && (exp.t ?? 0) > now - 120
  // 拍磚的靜態圖（pixbg tile）時只動磚：照磚的大小播 shader、藏起磚上的介面，全螢幕頁照常
  let tileShot = exp.on == true && exp.tile == true && (exp.t ?? 0) > now - 120
  let curIdx = max(0, list.map(x => x.id).indexOf(exporting && exp.id != null ? exp.id : sel))
  let cur = list[curIdx] ?? {}
  // 拍磚的靜態圖時只有磚畫被拍的場景：目前的場景（全螢幕頁、選擇）不跟著換，連按 ▶ 時畫面才不會被拉回去
  let tileCur = tileShot && exp.id != null ? (list.find(x => x.id == exp.id) ?? cur) : cur
  let total = len(list)
  let nextId = total > 0 ? list[(curIdx + 1) % total].id : sel
  let prevId = total > 0 ? list[(curIdx + total - 1) % total].id : sel
  // 預設與量測用的 shader 也要宣告 zone 與 speed：傳進不存在的 uniform 會在原生層出錯
  let blank = "uniform float zone; uniform float speed; uniform float cellpx; half4 main(float2 p) { return half4(0.0, 0.0, 0.0, 1.0); }"
  let probe = "uniform float zone; uniform float speed; uniform float cellpx; half4 main(float2 p) { return half4(1.0, 0.0, 1.0, 1.0); }"
  let code = exporting && exp.probe == true ? probe : cur.code ?? (cur.body != null ? tripBuiltin.header + cur.body : blank)
  // 卡片縮圖要用每個場景代表性的那一幕：匯出時 export.json 可以指定配色組
  let zn = exporting && exp.zone != null ? exp.zone : zone
  // 啟動器只要畫面上有 Shader 就每一格都重畫（耗電），所以磚平常放靜態縮圖，不放 Shader。
  // 使用者選了「磚上播動畫」，或剛在磚上點過（5 秒內），才放 Shader。全螢幕頁照常播。
  // 沒縮圖時磚上畫配色色帶，角色和吉祥物跟著每秒的時鐘走；速度 0 時停住。
  let tileAnim = tileLive || now - liveAt < 5 || tileShot
  let tileT = speed > 0 ? now % 3600 : 0

  // 語言：ui.json 裝著所有語言包（~/.local/share/pixbg/lang/*.json）
  let lc = langCode != "" ? langCode : ui.code ?? "en"
  let LP = !ready ? tripBuiltin.lang : get(ui.packs ?? {}, lc, null) ?? get(ui.packs ?? {}, "en", null) ?? tripBuiltin.lang
  let T = LP.T ?? {}
  let latin = (LP.names ?? "zh") == "en"
  // 場景名只顯示一種語言（pixbg 把「VOID SPACE 虛空」拆成 en／zh）
  let nm = latin ? (cur.en ?? cur.name ?? "Trip View") : (cur.zh ?? cur.name ?? "Trip View")
  // 星期自己算（Sakamoto 公式），名稱用語言包的，不跟手機語系走
  let ymd = words(fmtTime(now, "yyyy M d"))
  let yy = num(ymd[1]) < 3 ? num(ymd[0]) - 1 : num(ymd[0])
  let wd = (yy + floor(yy / 4) - floor(yy / 100) + floor(yy / 400) + [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4][num(ymd[1]) - 1] + num(ymd[2])) % 7
  let dateShort = "${ymd[1]}/${ymd[2]} ${(LP.wd ?? [])[wd] ?? ""}"

  // 場景目前這組配色：時鐘、吉祥物、按鈕都用它，和背景是同一套顏色
  let P = cur.pal[zn] ?? {bg: "#101018", c0: "#2a2a40", c1: "#6a6a90", c2: "#e8e8ff", ac: "#ffd84a", ink: "#101018", lite: "#e8e8ff", fg: "#e8e8ff"}
  let mascot = cur.mascot ?? "ufo"

  // 進度：pixbg 給目前進度 p，以及 eta 秒內要推到的 to（等 agent 時只知道大概要多久）
  // 生成時 pixbg 每幾秒更新 beat：超過 45 秒沒更新就是行程死了，別一直顯示忙碌
  // 生成和編輯場景都是交給 agent 的工作，進度、心跳、取消都一樣
  let agentJob = st.job == "gen" || st.job == "edit"
  let alive = agentJob ? (st.beat ?? st.t) > now - 45 : st.t > now - 900
  let busy = st.state == "working" && alive
  let stalled = st.state == "working" && agentJob && !alive && st.t > now - 3600
  let pct = busy ? clamp(st.p + (st.to - st.p) * min(1, (now - st.since) / max(st.eta, 1)), 0, 1) : 0
  let elapsed = max(0, now - (st.started ?? now))
  let jobName = st.job == "wall" ? T.setWall : st.job == "edit" ? T.editingScene : T.aiGen
  let fresh = st.t > now - 12
  let doneMsg = fresh && st.state == "done" ? "✓ ${st.msg}" : fresh && st.state == "error" ? "✕ ${st.msg}" : ""
  // 目前選的 agent 的狀態；不能用時給使用者一行可以複製到終端的指令
  let agentId = ui.agent ?? "claude"
  let agentInfo = (agents.list ?? []).find(x => x.id == agentId) ?? {}
  let jobErr = agentJob && st.state == "error" && st.t > now - 1800
  let genErr = jobErr && st.job == "gen"
  let editingCur = busy && st.job == "edit" && st.edit == cur.id
  let editErrCur = jobErr && st.job == "edit" && st.edit == cur.id
  let fixCmd = jobErr && (st.fix ?? "") != "" ? st.fix : agentInfo.ok == false ? (agentInfo.fix ?? "") : ""
  // 開全螢幕頁時，agent 狀態超過 10 分鐘就重查（背景跑，一兩秒）
  let probeStale = now - (agents.t ?? 0) > 600
  // 刪除確認框：只在 10 秒內、還是同一個場景時出現
  let delAsking = delId == cur.id && now - delAt < 10
  let reacting = now - poke < 3

  // 一個像素格（shader 的 PX）有多少 dp：手機像素 ÷ 密度
  let dens = (sys.display.width ?? 1080) / max(screenWidth ?? 411.43, 1)
  let W = tileWidth ?? 360
  let H = tileHeight ?? 360
  let tiny = cols <= 2 || rows <= 1
  let big = cols >= 4 && rows >= 4
  let pad = tiny ? 8 : 12
  let clockPx = clamp(floor(min((cols >= 4 && rows <= 3 ? W * 0.42 : W * 0.62) / 19, H * (tiny ? 0.3 : 0.32) / 7)), 2, 10)
  let mascotPx = clamp(floor(min(W, H) / (tiny || rows <= 2 ? 30 : 46)), 2, 5)
  let tileCell = max(2, floor(W * dens / 216)) / dens
  // 全螢幕頁滿版（照 AlienGo 的 bleed，見 70-aliengo.owl 的 Scene）：背景在繪製時放大 k 倍、位移到螢幕中心，蓋住啟動器的標題列與外框。
  // 放大前每格 fullCell / k 個像素，放大後剛好整數 fullCell 個，和真正的全螢幕一樣對齊。匯出（桌布、縮圖）時不放大。
  let sb = ui.screen
  let bleed = sb != null && !exporting
  let bw = sb != null ? sb.box[2] - sb.box[0] : 1
  let bh = sb != null ? sb.box[3] - sb.box[1] : 1
  let bk = bleed ? max(sb.size[0] / bw, sb.size[1] / bh) + 0.004 : 1
  let fullCell = sb != null ? max(2, floor(sb.size[0] / 216)) : 2
  let bleedCell = bleed ? fullCell / bk : 0
  let bleedOff = bleed ? [(sb.size[0] / 2 - (sb.box[0] + sb.box[2]) / 2) / dens, (sb.size[1] / 2 - (sb.box[1] + sb.box[3]) / 2) / dens] : [0, 0]
  let screenCell = bleed ? bleedCell / dens : max(2, floor((screenWidth ?? 411.43) * dens / 216)) / dens

  // 「自定義語言」：給使用者的 agent 的提示詞
  let langTarget = trim(langWish) == "" ? "<the language you want>" : trim(langWish)
  let langPromptA = """Add an interface language to Trip View (its tool is pixbg), a home-screen widget of omalauncher (an Android launcher whose widgets are OWL files; docs: ~/.config/omalauncher/widgets/README.md).

Language to add: """
  let langPromptB = """

How its languages work:
- Language packs are ~/.local/share/pixbg/lang/<code>.json. en.json is the base English pack; copy it to add any language, including Traditional Chinese (zh). Each pack has:
  - "name": the language's own name, shown on its button
  - "names": "en" or "zh". Built-in scene names are bilingual ("VOID SPACE 虛空"); this picks the half to show: "zh" for languages written in Chinese characters, otherwise "en".
  - "wd": 7 short weekday names, Sunday first
  - "T": the widget's labels
  - "msg": progress messages the pixbg tool writes
- pixbg lang <code> switches to a pack and lists strings it is missing; pixbg langs lists the packs; pixbg preview asks the phone to redraw the widget and prints the full-screen PNG.

Steps:
1. Pick a BCP-47 code (ja, ko, es, pt-BR …), written <code> below.
2. Copy en.json to <code>.json and translate every value of "name", "wd", "T" and "msg". Keep the keys, every {placeholder}, and symbols such as ◀ ▶ ✦ ● ＋ ✓. Keep labels short: buttons are narrow (about 8 CJK or 14 Latin characters; "gen" and "zone" about 4).
3. Run pixbg lang <code>, then pixbg preview, and open the PNG it prints. Check that no text is cut off and shorten translations where it is.
4. Change nothing else (not the widget file, the scenes or the tool): Trip View picks the pack up by itself and lists it under Language.
"""
  // 三引號字串不代入 ${}，所以語言名稱用串接放進去
  let langPrompt = langPromptA + langTarget + "\n\n" + langPromptB

  // 3×5 像素字型
  let FONT = {
    "0": ["aaa", "a.a", "a.a", "a.a", "aaa"], "1": [".a.", "aa.", ".a.", ".a.", "aaa"],
    "2": ["aaa", "..a", "aaa", "a..", "aaa"], "3": ["aaa", "..a", ".aa", "..a", "aaa"],
    "4": ["a.a", "a.a", "aaa", "..a", "..a"], "5": ["aaa", "a..", "aaa", "..a", "aaa"],
    "6": ["aaa", "a..", "aaa", "a.a", "aaa"], "7": ["aaa", "..a", ".a.", ".a.", ".a."],
    "8": ["aaa", "a.a", "aaa", "a.a", "aaa"], "9": ["aaa", "a.a", "aaa", "..a", "aaa"],
    ":": [".", "a", ".", "a", "."]
  }
  let hhmm = fmtTime(now, "HH:mm")
  let clockArt = range(5).map(r => join(range(len(hhmm)).map(i => get(FONT, sub(hhmm, i, i + 1), FONT["0"])[r]), "."))

  // 吉祥物：每個場景一隻，字母是顏色角色（a 亮色 c 主色 x 對比色 w 白 k 暗 m 金屬 y 黃 r 紅 d 閃燈 g 呼吸光）
  let MASCOTS = {
    ufo: [".....aaa.....", "....awwaa....", "...aaaaaaa...", ".mmmmmmmmmmm.", "mmdmmdmmdmmdm", ".kmmmmmmmmmk.", "...k.....k..."],
    car: ["....aaaaa.....", "...aawaaaa....", ".xxxxxxxxxxxx.", "wxxxxxxxxxxxxr", ".kkxxxxxxxxkk.", "..dd......dd.."],
    star: [".....y.....", "....yyy....", "yyyyyyyyyyy", ".yykyyykyy.", "..yyyrryy..", "..yyy.yyy..", ".yy.....yy."],
    firefly: [".w.....w.", "..w...w..", "...ccc...", "..cwcwc..", "..ccccc..", "..ggggg..", "...ggg..."],
    sentinel: ["...ccccc...", "..ccccccc..", ".cckkrkkcc.", ".ccccccccc.", "..c.c.c.c..", ".c.c.c.c.c.", "c.c.c.c.c.."]
  }

  component PixelClock(px = 6) {
    Canvas {
      width: 19 * px
      height: 7 * px
      // 亮色字、墨色外框（pixbg 從場景配色算出來），淺色深色場景都看得清楚
      for o in [[0, 1], [2, 1], [1, 0], [1, 2], [2, 2]] {
        sprite(clockArt, o[0] * px, o[1] * px, px, palette: {a: P.ink ?? P.bg})
      }
      sprite(clockArt, px, px, px, palette: {a: P.lite ?? P.c2})
    }
  }

  // live：全螢幕頁每格動；主畫面的磚只在被點後的幾秒讀 time，其餘時間跟著每秒的時鐘走
  component Mascot(px = 4, live = false) {
    Canvas {
      width: 16 * px
      height: 12 * px
      onTap: { poke = now; liveAt = now; haptic(); run(sound ? (mascot == "ufo" ? "paplay ~/.cache/pixbg/sfx/beam.wav" : "paplay ~/.cache/pixbg/sfx/boing.wav") : "true") }
      let tm = live || reacting ? time : now
      let blink = sin(tm * 4) > 0
      let hop = reacting ? abs(sin(tm * 9)) * 3 * px : 0
      let bob = round(sin(tm * 2) * px * 0.8)
      let x0 = 2 * px
      let y0 = 2 * px + bob - hop
      // 被點到：UFO 放出牽引光束，其他的跳一跳、冒星星
      if reacting && mascot == "ufo" {
        path([[x0 + 4 * px, y0 + 6 * px], [x0 + 9 * px, y0 + 6 * px], [x0 + 12 * px, 12 * px], [x0 + px, 12 * px]], closed: true, fill: alpha(P.c2, 0.35))
      }
      sprite(MASCOTS[mascot] ?? MASCOTS.ufo, x0, y0, px, palette: {
        a: P.c2, c: P.c1, x: P.ac, w: "#ffffff", k: "#151520", m: "#c9cde0", y: "#ffe46a", r: "#ff3a4a",
        d: blink ? P.ac : P.c0, g: mix(P.ac, P.c2, sin(tm * 1.5) * 0.5 + 0.5)
      })
      if reacting {
        for i in range(5) {
          let a = tm * 3 + i * 1.256
          let r = 5 * px + sin(tm * 5 + i) * px
          rect(x0 + 6 * px + sin(a) * r, y0 + 3 * px - cos(a) * r * 0.6, px, px, fill: i % 2 == 0 ? P.ac : "#ffffff")
        }
      }
    }
  }

  component Chip(label, tint = foreground, lines = 1) {
    Text { text: label; color: tint; font: mono; style: small; maxLines: lines; padding: [8, 4]; background: alpha(background, 0.8) }
  }

  component ProgressPanel(compact = false) {
    Column {
      fill: width
      gap: 5
      padding: compact ? [8, 6] : [10, 8]
      background: alpha(background, 0.85)
      if compact {
        Text { text: "${jobName} ${round(pct * 100)}% · ${st.msg}"; style: small; color: P.ac; maxLines: 1 }
      } else {
        Row {
          gap: 6
          Text { text: "${jobName} · ${round(pct * 100)}%"; style: small; bold: true; color: P.ac; weight: 1; maxLines: 1 }
          Text { text: fmtDuration(elapsed); style: small; color: muted; width: 64; align: end }
        }
      }
      Progress { value: pct * 100; color: P.ac; fill: width; height: compact ? 5 : 8 }
      if !compact { Text { text: st.msg; style: small; color: foreground; maxLines: 2 } }
    }
  }

  // ---------------------------------------------------------------- 像素 UI（照 AlienGo 的做法）
  // 按鈕畫在 Canvas 裡：兩階切角、深色外框、亮的上緣、2 單位的厚邊；選中時用場景的對比色發光，
  // shine 時掃過一道光（只有它讀 time）。組件不能在使用處掛 onTap，所以每顆都包在有 onTap 的 Box 裡。
  let ink = "#06080c"
  let slab = "#263043"
  let glass = alpha("#0c111a", 0.86)
  let soft = "#b4bed2"
  let good = "#7dff8a"
  let cardEdge = alpha(P.ac, 0.35)     // 卡片的邊框（目前場景的卡片元件也要用，所以放在元件前面）
  component PixelBtn(label, tone = "#5ef0ff", on = false, dim = false, h = 56, size = 15, shine = false, pad = 12) {
    Box {
      height: h
      fill: width
      align: center
      Canvas {
        fill: true
        let u = 3
        let m = 2 * u
        let x = m
        let y = m
        let w = width - 2 * m
        let bh = height - 2 * m
        let face = on ? tone : dim ? "#141a25" : slab
        let top = on ? mix(tone, "#ffffff", 0.4) : dim ? "#19202c" : "#3a4864"
        let lip = on ? mix(tone, "#000000", 0.55) : "#0a0e15"
        if on && !dim {
          rect(u, 0, width - 2 * u, height, fill: alpha(tone, 0.10))
          rect(0, u, width, height - 2 * u, fill: alpha(tone, 0.10))
          rect(2 * u, u, width - 4 * u, height - 2 * u, fill: alpha(tone, 0.16))
        }
        rect(x + 2 * u, y, w - 4 * u, bh, fill: ink)
        rect(x + u, y + u, w - 2 * u, bh - 2 * u, fill: ink)
        rect(x, y + 2 * u, w, bh - 4 * u, fill: ink)
        rect(x + 2 * u, y + u, w - 4 * u, bh - 2 * u, fill: lip)
        rect(x + u, y + 2 * u, w - 2 * u, bh - 4 * u, fill: lip)
        rect(x + 2 * u, y + u, w - 4 * u, bh - 4 * u, fill: linear(0, y, 0, y + bh - 3 * u, [top, face]))
        rect(x + u, y + 2 * u, w - 2 * u, bh - 6 * u, fill: linear(0, y, 0, y + bh - 3 * u, [top, face]))
        rect(x + 2 * u, y + u, w - 4 * u, u, fill: alpha("#ffffff", on ? 0.55 : dim ? 0.04 : 0.16))
        rect(x + 2 * u, y + 2 * u, u, u, fill: alpha("#ffffff", on ? 0.6 : 0.2))
        if !on && !dim { rect(x + 3 * u, y + bh - 3 * u, w - 6 * u, u, fill: alpha(tone, 0.6)) }
        if shine {
          let f = (time * 0.7) % 1.4
          clip(x + u, y + u, w - 2 * u, bh - 4 * u) {
            let sx = x - 40 + f * (w + 80)
            path([[sx, y], [sx + 18, y], [sx + 6, y + bh], [sx - 12, y + bh]], closed: true, fill: alpha("#ffffff", 0.35))
          }
        }
      }
      Text { text: label; align: center; font: mono; bold: true; fontSize: size; maxLines: 2; padding: [pad, 0]; offset: [0, -2]
        color: on ? "#071016" : dim ? "#5d687c" : "#eef3fa" }
    }
  }
  // HUD 卡片標題：實心的標籤，接一條細線
  component HudHead(tag, tone = "#5ef0ff", meta = "", w = 0) {
    Row {
      gap: 8
      align: center
      Text { text: tag; font: mono; bold: true; style: small; color: "#071016"; background: tone; padding: [8, 2]; width: w > 0 ? w : len(tag) * (latin ? 10 : 15) + 22 }
      Spacer { weight: 1; height: 2; background: alpha(tone, 0.35) }
      if meta != "" { Text { text: meta; font: mono; style: small; color: soft; width: 150; align: end; maxLines: 1 } }
    }
  }
  // 分段的量表，像遊戲的血條
  component PixelMeter(value, tone = "#5ef0ff", segs = 16, slot = "#1a2130") {
    Canvas {
      height: 12
      fill: width
      let gap = 3
      let sw = (width - gap * (segs - 1)) / segs
      let lit = round(clamp(value, 0, 1) * segs)
      for k in range(segs) {
        rect(k * (sw + gap), 0, sw, height, fill: k < lit ? tone : slot)
        if k < lit { rect(k * (sw + gap), 0, sw, 3, fill: alpha("#ffffff", 0.35)) }
      }
    }
  }
  // 配色色票：上半是天空（bg→c2），下半是對比色；選中的有亮框
  component Swatch(z, on) {
    Canvas {
      fill: true
      let u = 3
      rect(0, 0, width, height, fill: on ? z.ac : ink)
      rect(u, u, width - 2 * u, height - 2 * u, fill: ink)
      let iw = width - 4 * u
      let ih = height - 4 * u
      for k, i in [z.bg, z.c0, z.c1, z.c2] {
        rect(2 * u + i * iw / 4, 2 * u, iw / 4 + 0.5, ih * 0.62, fill: k)
      }
      rect(2 * u, 2 * u + ih * 0.62, iw, ih * 0.38, fill: z.ac)
    }
  }
  // ---------------------------------------------------------------- 角色層
  // 場景附的 <場景>.actors.json：美術（sprite 字母圖）＋ 每一幕（配色組）的演出。位置是畫面比例：
  // x 是角色中線、y 是腳底，[基準, 振幅, 頻率, 相位]。座標都對齊 shader 的像素格。
  // live：全螢幕頁、或磚上在播動畫時用 time 每格動；磚上沒縮圖時用 tileT，每秒走一次
  // sc、z：畫別的場景、別的配色（場景卡片的縮圖一次畫好幾個）；沒給就是目前的
  component Actors(cw = 2, live = false, sc = null, z = null) {
    Canvas {
      fill: true
      let A = (sc ?? cur).actors ?? {}
      let az = z ?? zn
      let art = A.art ?? {}
      let tt = (live ? time : tileT) * max(speed, 0)
      let live = (A.acts ?? []).filter(a => (a.zones ?? [az]).indexOf(az) >= 0 && get(art, a.toy, null) != null)
      let s1 = live.map(a => {a: a, g: get(art, a.toy, {}), cp: cw * (get(art, a.toy, {}).cell ?? 1)})
      let s2 = s1.map(o => {
        id: o.a.id, g: o.g, cp: o.cp, wire: o.a.wire == true, sink: o.a.sink ?? 0,
        cx: width * (o.a.x[0] + o.a.x[1] * sin(tt * o.a.x[2] + o.a.x[3])),
        by: height * (o.a.y[0] + o.a.y[1] * sin(tt * o.a.y[2] + o.a.y[3])),
        up: (o.a.hop != null ? abs(sin(tt * o.a.hop[1])) * o.a.hop[0] : 0) - (o.a.dip != null && tt % o.a.dip[0] > o.a.dip[1] && tt % o.a.dip[0] < o.a.dip[2] ? sin((tt % o.a.dip[0] - o.a.dip[1]) / (o.a.dip[2] - o.a.dip[1]) * 3.1416) * o.a.dip[3] : 0),
        fr: o.a.keys != null ? last(o.a.keys.filter(k => k[0] <= tt % o.a.cycle))[1] : o.a.seq[floor(tt * (o.a.fps ?? 0)) % len(o.a.seq)]
      })
      let P2 = s2.map(o => {
        id: o.id, g: o.g, cp: o.cp, wire: o.wire, fr: o.fr,
        x0: round(o.cx / o.cp - o.g.ox) * o.cp,
        y0: round(o.by / o.cp - (o.g.h - o.sink) - o.up) * o.cp
      })
      for o in P2 {
        // 片場感：飛的東西頭上都吊著一條鋼絲
        if o.wire { line(o.x0 + o.g.ox * o.cp, 0, o.x0 + o.g.ox * o.cp, o.y0, stroke: alpha("#e8e8f0", 0.4), width: 1) }
        sprite(o.g.frames[o.fr] ?? o.g.frames[0], o.x0, o.y0, o.cp, palette: o.g.pal)
      }
      for f in (A.fx ?? []).filter(f => (f.zones ?? [az]).indexOf(az) >= 0) {
        let ph = f.cycle != null ? tt % f.cycle : 0
        let ref = f.from ?? f.a ?? f.at
        let pa = P2.find(o => o.id == ref[0])
        if (f.on == null || ph >= f.on[0] && ph < f.on[1]) && pa != null {
          let u = f.on != null ? (ph - f.on[0]) / (f.on[1] - f.on[0]) : 0
          let ax = pa.x0 + ref[1] * pa.cp
          let ay = pa.y0 + ref[2] * pa.cp
          let w = (f.width ?? 2) * cw
          if f.type == "beam" {
            // 往天上掃的光線：外層彩色、芯是白的
            let ang = rad(f.angle[0] + f.angle[1] * sin((ph - f.on[0]) * f.angle[2]))
            let ex = ax + cos(ang) * height * f.len
            let ey = ay + sin(ang) * height * f.len
            line(ax, ay, ex, ey, stroke: f.color, width: w * 2)
            line(ax, ay, ex, ey, stroke: "#ffffff", width: w * 0.7)
            circle(ax, ay, w * 1.6, fill: f.color)
          }
          if f.type == "puffs" {
            // 揚沙、排氣：一串小方塊往後飄、變大、變淡
            for i in range(f.n ?? 4) {
              let pu = (tt / f.life + i / (f.n ?? 4)) % 1
              let sz = cw * (f.size ?? 1) * (1 + pu * 1.5)
              layer(1 - pu) { rect(round((ax + pu * f.life * f.dx * width) / cw) * cw, round((ay + pu * f.life * f.dy * height) / cw) * cw, sz, sz, fill: f.color) }
            }
          }
          if f.type == "glow" {
            // 一圈光暈，隨著時間微微脹縮
            layer((f.alpha ?? 0.4) * (0.85 + 0.15 * sin(tt * 3))) { circle(ax, ay, (f.r ?? 6) * cw * (0.95 + 0.05 * sin(tt * 5)), fill: f.color) }
          }
          if f.type == "cone" {
            // 往前打的光束：一個朝右張開的扇形
            let ln = width * f.len
            layer(f.alpha ?? 0.25) { path([[ax, ay], [ax + ln, ay - ln * f.spread], [ax + ln, ay + ln * f.spread]], closed: true, fill: f.color) }
          }
          if f.type == "sparks" {
            for i in range(5) {
              let a = i * 1.26 + tt * 2
              rect(round((ax + cos(a) * f.r * cw) / cw) * cw, round((ay + sin(a) * f.r * cw * 0.8) / cw) * cw, cw * 2, cw * 2, fill: i % 2 == 0 ? f.color : "#ffffff")
            }
          }
          if f.type == "link" || f.type == "clash" {
            let pb = P2.find(o => o.id == f.b[0])
            if pb != null {
              let bx = pb.x0 + f.b[1] * pb.cp
              let by = pb.y0 + f.b[2] * pb.cp
              if f.type == "link" {
                // 光彈：一小段沿著 a→b 飛過去
                line(lerp(ax, bx, u), lerp(ay, by, u), lerp(ax, bx, min(1, u + 0.12)), lerp(ay, by, min(1, u + 0.12)), stroke: f.color, width: w)
              } else {
                // 對轟：兩道光線在中間頂著，交會點來回推擠，最後被 b 推回 a
                let m = clamp(0.5 + 0.2 * sin(tt * 2.6) - 0.3 * clamp((u - 0.7) / 0.3, 0, 1), 0.1, 0.9)
                let mx = lerp(bx, ax, m)
                let my = lerp(by, ay, m)
                line(ax, ay, mx, my, stroke: f.color, width: w * 2)
                line(bx, by, mx, my, stroke: f.color2 ?? f.color, width: w * 1.6)
                line(ax, ay, mx, my, stroke: "#ffffff", width: w * 0.6)
                circle(mx, my, w * (2.2 + floor(tt * 6) % 2), fill: "#ffffff")
              }
            }
          }
        }
      }
    }
  }

  // 場景卡片：縮圖（pixbg thumbs 請手機畫的）、標籤、名稱條；選中的外框發光並標「遊玩中」
  // 目前場景的卡片：場景名、吉祥物、◀ 隱藏介面 ▶、展開更多
  component HudCard() {
    Column {
      fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
      HudHead { tag: "TRIP VIEW"; w: 104; tone: P.ac; meta: "${T.scene} ${curIdx + 1}/${total}" }
      Row {
        align: center
        gap: 8
        Column {
          weight: 1
          gap: 6
          Text { text: nm; style: title; bold: true; color: "#eef3fa"; maxLines: 2 }
          if showClock {
            PixelClock { px: 7 }
            Text { text: "${ymd[0]}/${dateShort}"; style: small; color: soft }
          }
        }
        if pet { Mascot { px: 7; live: true } }
      }
      Row {
        gap: 8
        Box { weight: 1; onTap: { sel = prevId; run(sound ? "paplay ~/.cache/pixbg/sfx/prev.wav" : "true"); run((list.find(x => x.id == prevId) ?? {}).tile == null ? "~/.local/bin/pixbg tile ${sh(prevId)}" : "true") }; PixelBtn { label: "◀"; tone: P.ac } }
        // 一打開就點得到：只看場景（設桌布前先看清楚整個畫面）
        Box { weight: 1; onTap: { panel = false; hiddenAt = now; run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true") }; PixelBtn { label: T.hide; tone: P.ac } }
        Box { weight: 1; onTap: { sel = nextId; run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true"); run((list.find(x => x.id == nextId) ?? {}).tile == null ? "~/.local/bin/pixbg tile ${sh(nextId)}" : "true") }; PixelBtn { label: "▶"; tone: P.ac } }
      }
      // 管理只對 Agent 場景：平常只有一行小字，點開才有「編輯」「刪除」，刪除還要再確認一次
      if cur.kind == "ai" {
        if editingCur {
          PixelMeter { value: pct; tone: P.ac }
          Row {
            Text { text: st.msg; style: small; color: "#eef3fa"; weight: 1; maxLines: 2 }
            Text { text: fmtDuration(elapsed); font: mono; style: small; color: soft; width: 70; align: end }
          }
          Box { fill: width; onTap: run("~/.local/bin/pixbg cancel"); PixelBtn { label: T.cancel; tone: "#ff6a6a"; h: 40; size: 12 } }
        } else if delAsking {
          Column {
            fill: width; gap: 8; padding: [12, 10]; background: "#1a0a0e"; border: 2; radius: 0; borderColor: "#ff6a6a"
            Text { text: replace(T.delAsk ?? "{n}", "{n}", nm); bold: true; color: "#ffb4b4"; maxLines: 2 }
            Text { text: T.delWarn; style: small; color: soft; maxLines: 3 }
            Row {
              gap: 8
              Box { weight: 1; onTap: { delId = "" }; PixelBtn { label: T.keep; tone: P.ac; h: 46; size: 13 } }
              Box { weight: 1; onTap: { delId = ""; manageId = ""; run(sound ? "paplay ~/.cache/pixbg/sfx/error.wav" : "true"); run("~/.local/bin/pixbg del ${sh(cur.id)}") }; PixelBtn { label: T.delYes; on: true; tone: "#ff6a6a"; h: 46; size: 13 } }
            }
          }
        } else if editOpen == cur.id {
          Column {
            fill: width; gap: 8; padding: [12, 10]; background: "#0a0e15"; border: 2; radius: 0; borderColor: alpha(P.ac, 0.7)
            Text { text: replace(T.editAsk ?? "{n}", "{n}", nm); bold: true; color: "#eef3fa"; maxLines: 2 }
            if cur.prompt != null { Text { text: replace(T.thisScene ?? "{p}", "{p}", cur.prompt); style: small; color: soft; maxLines: 2 } }
            Input { fill: width; height: 52; padding: [12, 0]; background: "#05070b"; border: 2; radius: 0; borderColor: alpha(P.ac, 0.6); placeholder: T.editHint; text: editWish; onChange: editWish = value; onSubmit: { editWish = value; run(trim(value) == "" || busy ? "true" : "~/.local/bin/pixbg edit ${sh(cur.id)} ${sh(trim(value))}"); editOpen = trim(value) == "" || busy ? editOpen : "" } }
            Text { text: T.editNote; style: small; color: soft; maxLines: 3 }
            Row {
              gap: 8
              Box { weight: 1; onTap: { editOpen = "" }; PixelBtn { label: T.cancel; tone: P.ac; h: 46; size: 13 } }
              Box { weight: 1; onTap: { run(trim(editWish) == "" || busy ? "true" : "~/.local/bin/pixbg edit ${sh(cur.id)} ${sh(trim(editWish))}"); editOpen = trim(editWish) == "" || busy ? editOpen : "" }; PixelBtn { label: T.editGo; on: trim(editWish) != "" && !busy; dim: busy; tone: P.ac; h: 46; size: 13 } }
            }
          }
        } else if manageId == cur.id {
          Row {
            gap: 8
            Box { weight: 1; onTap: { editOpen = cur.id; editWish = "" }; PixelBtn { label: T.editScene; dim: busy; tone: P.ac; h: 46; size: 13 } }
            Box { weight: 1; onTap: { delId = cur.id; delAt = now; haptic() }; PixelBtn { label: T.delScene; tone: "#ff6a6a"; h: 46; size: 13 } }
          }
          Text { text: T.collapse; style: small; color: soft; align: center; fill: width; padding: [0, 4]; onTap: { manageId = "" } }
        } else {
          Text { text: T.manage; style: small; color: soft; padding: [0, 4]; onTap: { manageId = cur.id } }
        }
        if editErrCur && !busy {
          Row {
            gap: 8
            Text { text: stalled ? T.stalled : "✕ ${st.msg}"; style: small; color: "#ff6a6a"; weight: 1; maxLines: 3 }
            Box { width: 120; onTap: run("~/.local/bin/pixbg edit ${sh(cur.id)} ${sh(st.wish ?? "")}"); PixelBtn { label: T.retryGen; tone: P.ac; h: 40; size: 12; pad: 4 } }
          }
        }
        if fresh && st.job == "edit" && st.state == "done" && st.edit == cur.id { Text { text: "✓ ${st.msg}"; style: small; color: good; maxLines: 2 } }
      }
      // 下面還有東西：Agent、桌布、設定。點了才展開（新使用者不用猜要往下滑），展開後點 ▲ 收回
      Box { fill: width; onTap: { moreAt = more ? 0 : now; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; Text { text: more ? "▲" : T.scrollHint; style: small; color: soft; align: center; fill: width; maxLines: 1; padding: [6, 0] } }
    }
  }

  component SceneCard(x, on) {
    Column {
      gap: 0
      border: 3
      radius: 0
      borderColor: on ? P.ac : ink
      background: ink
      Box {
        height: 112
        fill: width
        clip: true
        if x.thumb != null {
          Image { src: x.thumb; fill: true; fit: cover }
        } else {
          // 還沒有縮圖：用場景的配色畫幾條色帶
          Canvas {
            fill: true
            let zp = (x.pal ?? [])[0] ?? {}
            for k, i in [zp.bg ?? ink, zp.c0 ?? slab, zp.c1 ?? slab, zp.c2 ?? soft] {
              rect(0, i * height / 4, width, height / 4 + 1, fill: k)
            }
          }
          Text { text: T.noThumb ?? ""; style: small; color: soft; align: center; padding: [0, 44] }
        }
        Column {
          fill: true
          padding: 6
          if x.kind == "ai" {
            Row {
              Text { text: T.tag_ai ?? "Agent"; font: mono; style: small; bold: true; color: "#071016"; background: "#ff7ad9"; padding: [6, 1]; width: len(T.tag_ai ?? "Agent") * (match(T.tag_ai ?? "Agent", "^[ -~]+$") != null ? 9.5 : 14) + 14 }
              Spacer { weight: 1 }
            }
          }
          Spacer { weight: 1 }
          if on { Row { Text { text: T.playing; font: mono; style: small; bold: true; color: "#071016"; background: P.ac; padding: [6, 1]; width: len(T.playing ?? "") * (match(T.playing ?? "", "^[ -~]+$") != null ? 9.5 : 14) + 16 }  Spacer { weight: 1 } } }
        }
      }
      Text { text: "${x.kind == "ai" ? "✦ " : ""}${latin ? (x.en ?? x.name) : (x.zh ?? x.name)}"; font: mono; bold: true; style: small; maxLines: 1; padding: [8, 6]; fill: width; color: on ? "#071016" : "#eef3fa"; background: on ? P.ac : slab }
    }
  }


  // The first tap installs the local tools in the background (about 2 s, nothing in the way);
  // a failed install is retried on the next tap.
  on liveAt { run(ready || setupState == "installing" ? "true" : """set -eu
umask 077
mkdir -p "$HOME/.cache/pixbg"
exec >>"$HOME/.cache/pixbg/setup.log" 2>&1
python - <<'TRIP_VIEW_SETUP'
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 WeeboWIZ
'''Install the reviewed text payload without downloading code or replacing user scenes.'''
import datetime
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import uuid


def builtin_files(home, version):
    '''The five scenes, the shader header and the English pack, which the widget carries for use before
    setup (`let tripBuiltin`). Read from the installed widget file of this version and returned as files.'''
    quotes = '"' * 3          # spelled out: three quotes in a row would end the OWL string carrying this program
    start = '  let tripBuiltin = parseJson(' + quotes
    for owl in sorted((home / '.config/omalauncher/widgets').glob('*.owl')):
        text = owl.read_text(errors='replace')
        if start in text and 'installed == "' + version + '"' in text:
            data = json.loads(text.split(start, 1)[1].split(quotes + ')', 1)[0])
            break
    else:
        raise RuntimeError('The Trip View widget file was not found in ~/.config/omalauncher/widgets.')
    app = '.local/share/pixbg/'
    files = {app + 'header.agsl': data['header'],
             app + 'lang/en.json': json.dumps(data['lang'], ensure_ascii=False, indent=2) + '\n'}
    for scene in data['scenes']:
        if not re.fullmatch(r'[0-9a-z-]+', scene['id']):
            raise RuntimeError('Unexpected scene id: ' + scene['id'])
        files[app + 'scenes/' + scene['id'] + '.agsl'] = scene['body']
        if scene.get('actors') is not None:
            files[app + 'scenes/' + scene['id'] + '.actors.json'] = json.dumps(scene['actors'], ensure_ascii=False, separators=(',', ':'))
    return files


def install_files(files, version):
    home = Path.home()
    cache = home / '.cache/pixbg'
    cache.mkdir(parents=True, exist_ok=True)
    with (cache / 'setup.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('Setup is already running.')
            return
        state = cache / 'setup-state'
        state.write_text('installing')
        backup = cache / 'install-backups' / datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
        try:
            files = dict(files, **builtin_files(home, version))
            # Do not follow developer checkouts or other redirected installation paths.
            targets = [home / name for name in files]
            targets += [home / '.local/bin' / name for name in ('pixbg', 'tripview')]
            for target in targets:
                for parent in target.parents:
                    if parent == home:
                        break
                    if parent.is_symlink():
                        raise RuntimeError('Setup found a linked directory: ' + str(parent) + '. Use your existing checkout to update it.')
            for relative, text in files.items():
                target = home / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                if target.exists() or target.is_symlink():
                    saved = backup / relative
                    saved.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(target, saved, follow_symlinks=False)
                temporary = target.with_name(target.name + '.' + uuid.uuid4().hex + '.install-tmp')
                try:
                    temporary.write_text(text, encoding='utf-8')
                    temporary.chmod(0o700 if target.name == 'pixbg.py' else 0o600)
                    temporary.replace(target)
                finally:
                    temporary.unlink(missing_ok=True)
            tool = home / '.local/share/pixbg/pixbg.py'
            for name in ('pixbg', 'tripview'):
                target = home / '.local/bin' / name
                target.parent.mkdir(parents=True, exist_ok=True)
                if target.exists() or target.is_symlink():
                    saved = backup / '.local/bin' / name
                    saved.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(target, saved, follow_symlinks=False)
                temp = target.with_name(name + '.' + uuid.uuid4().hex + '.install-tmp')
                temp.symlink_to(tool)
                temp.replace(target)
            # English is the only bundled language. Never remove custom language packs.
            language = cache / 'lang'
            if not language.exists():
                language.write_text('en')
            subprocess.run([sys.executable, str(tool), 'bundle'], check=True, timeout=120)
            bundle = json.loads((cache / 'bundle.json').read_text())
            expected = {Path(p).stem for p in files if p.endswith('.agsl') and '/scenes/' in p}
            actual = {scene['id'] for scene in bundle['scenes']}
            if not expected <= actual:
                raise RuntimeError('Some built-in animations failed validation. Check setup.log.')
            (cache / 'store-version').write_text(version)
            state.write_text('done')
            print('Trip View is ready. Existing animations, languages and settings were preserved.')
            # The home tile's still (Neon Ramen for a new install), taken in the background. Taking it also
            # reloads the widget, so the tile leaves the setup screen even if the launcher missed the state file.
            if not os.environ.get('TRIP_VIEW_NO_BACKGROUND'):   # set by the tests, which have no launcher
                subprocess.run([sys.executable, str(tool), 'tile', '--cards'], check=False, timeout=30)
                # Which agent CLIs are installed and signed in, for the generator card.
                subprocess.Popen([sys.executable, str(tool), 'agents'], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        except Exception:
            state.write_text('failed')
            raise

install_files({'.local/share/pixbg/pixbg.py': '#!/usr/bin/env python3\n# SPDX-License-Identifier: MIT\n# Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nimport json, os, queue, re, shutil, signal, subprocess, sys, tempfile, threading, time, glob\nsys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))\nimport agslcheck\nimport sfx\nHOME = os.path.expanduser("~")\nDATA = os.path.join(HOME, ".local/share/pixbg")\nSCENES = os.path.join(DATA, "scenes")\nCACHE = os.path.join(HOME, ".cache/pixbg")\nBUNDLE = os.path.join(CACHE, "bundle.json")     \nEXPORT = os.path.join(CACHE, "export.json")     \nSEL = os.path.join(CACHE, "sel")                \nCHECKED = os.path.join(CACHE, "checked.json")   \nLANGS = os.path.join(DATA, "lang")\nUI = os.path.join(CACHE, "ui.json")\nSTATUS = os.path.join(CACHE, "status.json")\nAGENTS = os.path.join(CACHE, "agents.json")     \nMODELS = os.path.join(CACHE, "agent-models.json")   \nCONFIG = os.path.join(HOME, ".config/pixbg/config.json")\nWIDGETS = os.path.join(HOME, ".config/omalauncher/widgets")\nSTYLE = os.path.join(HOME, ".config/omalauncher/style/style.toml")\nBOX = os.path.join(CACHE, "screen-box.json")\nGALLERY = os.path.join(HOME, "Pictures/pixbg")  \nTHUMBS = os.path.join(CACHE, "thumbs")\nHISTORY = os.path.join(CACHE, "scene-history")      \nSCENE_THUMBS = os.path.join(CACHE, "scene-thumbs")   \nTILE_THUMBS = os.path.join(CACHE, "tile-thumbs")     \nTILE_WANT = os.path.join(CACHE, "tile-want")         \nWALLS = os.path.join(CACHE, "walls.json")\nBLANK = "half4 main(float2 p) { return half4(0.0, 0.0, 0.0, 1.0); }"\ndef write_json(path, obj):\n os.makedirs(os.path.dirname(path), exist_ok=True)\n tmp = f"{path}.{os.getpid()}.tmp"     \n with open(tmp, "w") as f:\n  json.dump(obj, f, ensure_ascii=False)\n os.replace(tmp, path)\ndef read_json(path, default):\n try:\n  with open(path) as f:\n   return json.load(f)\n except Exception:\n  return default\n_job = {}\nLANG = os.path.join(CACHE, "lang")\ndef lang():\n try:\n  code = open(LANG).read().strip()\n except OSError:\n  code = "zh" if os.path.exists(os.path.join(LANGS, "zh.json")) else "en"\n return code if os.path.exists(os.path.join(LANGS, code + ".json")) else "en"\ndef pack(code):\n out = {"name": code, "names": "en", "wd": [], "T": {}, "msg": {}}\n for c in ("zh", "en", code):\n  d = read_json(os.path.join(LANGS, c + ".json"), {})\n  for k in ("name", "names", "wd", "ideas"):\n   if d.get(k):\n    out[k] = d[k]\n  for k in ("T", "msg"):\n   out[k].update({a: b for a, b in (d.get(k) or {}).items() if isinstance(b, str) and b})\n return out\ndef M(key, **kw):\n tmpl = pack(lang())["msg"].get(key, key)\n try:\n  return tmpl.format(**kw)\n except (KeyError, IndexError, ValueError):\n  return tmpl\ndef langs():\n return [{"code": os.path.basename(f)[:-5], "name": read_json(f, {}).get("name") or os.path.basename(f)[:-5]}\n   for f in sorted(glob.glob(os.path.join(LANGS, "*.json")))]\ndef build_ui(code=None):\n code = code or lang()\n packs = {x["code"]: {k: v for k, v in pack(x["code"]).items() if k != "msg"} for x in langs()}\n box = read_json(BOX, {})\n write_json(UI, {"code": code, "packs": packs, "langs": langs(), "screen": box if box.get("box") else None, "agent": config()["agent"]})\ndef split_name(name):\n m = re.match(r"^\\s*([A-Za-z0-9][A-Za-z0-9 .\'&!?:+\\-]*?)\\s*([^\\x00-\\x7f].*)?$", name or "")\n en = (m.group(1) if m else "").strip()\n zh = ((m.group(2) or "") if m else name or "").strip()\n return en or zh or name, zh or en or name\ndef status(state, msg="", p=None, to=None, eta=None, **extra):\n if state == "working" and not _job.get("started"):\n  _job["started"] = int(time.time())\n _last.clear()\n _last.update({"state": state, "msg": msg, "t": int(time.time()), "job": _job.get("job"),\n    "started": _job.get("started"), "p": p, "to": to if to is not None else p,\n    "eta": eta or 1, "since": int(time.time()), "pid": _job.get("pid", os.getpid()),\n    "beat": int(time.time()), **extra})\n write_json(STATUS, _last)\n_last = {}\ndef beat():\n if _last.get("state") == "working" and time.time() - _last.get("beat", 0) >= 3:\n  _last["beat"] = int(time.time())\n  write_json(STATUS, _last)\ndef header():\n with open(os.path.join(DATA, "header.agsl")) as f:\n  return f.read()\ndef meta(src, key):\n m = re.search(r"^//\\s*%s:\\s*(.+)$" % key, src, re.M)\n return m.group(1).strip() if m else None\nMASCOTS = ("ufo", "car", "star", "firefly", "sentinel")\ndef palettes(src):\n m = re.search(r"void\\s+palette\\s*\\(.*?\\)\\s*\\{(.*?)\\n\\}", src, re.S)\n out = []\n for name, hexv in re.findall(r"\\b(bg|c0|c1|c2|ac)\\s*=\\s*hx\\(\\s*0x([0-9a-fA-F]{6})\\s*\\)", m.group(1) if m else ""):\n  if name == "bg" or not out:\n   out.append({})\n  out[-1][name] = "#" + hexv.lower()\n out = [z for z in out if len(z) == 5]\n for z in out:\n  lum = lambda h: (0.2126 * int(h[1:3], 16) + 0.7152 * int(h[3:5], 16) + 0.0722 * int(h[5:7], 16)) / 255\n  ink = min(z.values(), key=lum)\n  if lum(ink) > 0.25:\n   ink = "#" + "".join(f"{int(int(ink[i:i + 2], 16) * 0.35):02x}" for i in (1, 3, 5))\n  lite = max(z.values(), key=lum)\n  z.update(ink=ink, lite=lite, fg=ink if lum(z["bg"]) > 0.5 else lite)\n return (out * 5)[:5] if out else []\ndef scenes():\n out = []\n for path in sorted(glob.glob(os.path.join(SCENES, "*.agsl"))):\n  sid = os.path.basename(path)[:-5]\n  with open(path) as f:\n   src = f.read()\n  out.append({"id": sid, "name": meta(src, "name") or sid, "prompt": meta(src, "prompt"),\n     "kind": "ai" if sid.startswith("ai-") else "preset", "path": path})\n return out\ndef current_id():\n try:\n  return open(SEL).read().strip() or None\n except OSError:\n  return None\ndef checked(body):\n import hashlib\n key = hashlib.sha256((header() + body).encode()).hexdigest()\n memo = read_json(CHECKED, {})\n if key in memo:\n  return []\n errs, c = agslcheck.check(header(), body)\n if not errs:\n  memo[key] = round(c)\n  write_json(CHECKED, memo)\n return errs\ndef entry(sc, body):\n mascot = meta(body, "mascot")\n en, zh = split_name(sc["name"])\n return {"id": sc["id"], "name": sc["name"], "en": en, "zh": zh, "kind": sc["kind"], "prompt": sc["prompt"],\n   "pal": palettes(body), "mascot": mascot if mascot in MASCOTS else "ufo", "code": header() + body,\n   "actors": read_json(sc["path"][:-5] + ".actors.json", None),\n   "tag": meta(body, "tag") or ("ai" if sc["kind"] == "ai" else "ufopump"),\n   "thumb": thumb_path(sc["id"]) if os.path.exists(thumb_path(sc["id"])) else None,\n   "tile": tile_path(sc["id"]) if os.path.exists(tile_path(sc["id"])) else None,\n   "zone": int(meta(body, "thumb")) if (meta(body, "thumb") or "").isdigit() else None}\ndef thumb_path(sid):\n return os.path.join(SCENE_THUMBS, sid + ".png")\ndef make_thumbs(ids=None, force=False):\n from PIL import Image\n os.makedirs(SCENE_THUMBS, exist_ok=True)\n box = read_json(BOX, {}).get("box")\n if not box:\n  sys.exit("pixbg: 先「設為桌布」一次，量出全螢幕畫面的範圍")\n packed = [x["id"] for x in read_json(BUNDLE, {}).get("scenes", [])]   \n todo = [sid for sid in packed if (ids is None or sid in ids) and (force or not os.path.exists(thumb_path(sid)))]\n if not todo:\n  return\n lock = render_lock()\n try:\n  for n in range(0, len(todo), 6):\n   batch = todo[n:n + 6]\n   write_json(EXPORT, {"on": True, "cards": batch, "t": int(time.time())})\n   im = Image.open(render()).convert("RGB").crop(tuple(box))\n   gw = im.size[0] / 2\n   gh = gw * 259 / 360\n   for i, sid in enumerate(batch):\n    x, y = i % 2 * gw, i // 2 * gh\n    im.crop((round(x), round(y), round(x + gw), round(y + gh))).save(thumb_path(sid))\n    print("縮圖：", sid, flush=True)\n finally:\n  write_json(EXPORT, {"on": False})\n  lock.close()\n build_bundle()\ndef tile_path(sid):\n return os.path.join(TILE_THUMBS, sid + ".png")\ndef render_lock():\n import fcntl\n f = open(os.path.join(CACHE, "render.lock"), "w")\n fcntl.flock(f, fcntl.LOCK_EX)\n return f\ndef measure_box():\n from PIL import Image\n write_json(EXPORT, {"on": True, "probe": True, "t": int(time.time())})\n im = Image.open(render()).convert("RGB")\n W, H = im.size\n px = im.load()\n ys = [y for y in range(0, H, 2) if px[W // 2, y] == (255, 0, 255)]\n xs = [x for x in range(0, W, 2) if px[x, H // 2] == (255, 0, 255)]\n if not xs or not ys:\n  raise RuntimeError("量不到畫面範圍")\n box = (min(xs), min(ys), max(xs) + 1, max(ys) + 1)\n write_json(BOX, {"box": box, "size": [W, H]})\n return box\ndef make_tiles(ids=None, missing=False):\n os.makedirs(TILE_THUMBS, exist_ok=True)\n lock = render_lock()\n took = False\n try:\n  if not read_json(BOX, {}).get("box"):\n   took = True\n   try:\n    measure_box()\n   except Exception as e:\n    print("量不到全螢幕範圍：", e, flush=True)\n  for sc in scenes():\n   if ids is not None and sc["id"] not in ids or missing and os.path.exists(tile_path(sc["id"])):\n    continue\n   took = True\n   write_json(EXPORT, {"on": True, "tile": True, "id": sc["id"], "t": int(time.time())})\n   shot = render("preview")\n   tmp = tile_path(sc["id"]) + ".tmp"\n   shutil.copyfile(shot, tmp)\n   os.replace(tmp, tile_path(sc["id"]))\n   print("磚：", sc["id"], flush=True)\n finally:\n  if took:\n   write_json(EXPORT, {"on": False})\n   build_bundle()\n   reload_widget()\n  lock.close()\ndef tile_worker(cards=False):\n time.sleep(1.0)\n try:\n  sid = open(TILE_WANT).read().strip()\n except OSError:\n  sid = None\n if sid and not os.path.exists(tile_path(sid)) and any(sc["id"] == sid for sc in scenes()):\n  make_tiles([sid], missing=True)   \n if cards and read_json(BOX, {}).get("box"):\n  make_thumbs()\n  reload_widget()\ndef reload_widget():\n try:\n  f = widget_file()\n except SystemExit:\n  return\n with open(f) as fh:\n  text = fh.read()\n with open(f, "w") as fh:\n  fh.write(re.sub(r"\\n// pixbg-frame: \\d+\\n?$", "\\n", text).rstrip("\\n") + f"\\n// pixbg-frame: {int(time.time() * 1000)}\\n")\ndef build_bundle():\n out, bad = [], []\n for sc in scenes():\n  body = open(sc["path"]).read()\n  errs = checked(body)\n  if errs:\n   bad.append((sc, errs))\n  else:\n   out.append(entry(sc, body))\n write_json(BUNDLE, {"scenes": out, "t": int(time.time())})\n build_ui()\n return out, bad\ndef notify_sel(sid):\n with open(SEL, "w") as f:\n  f.write(sid)\n try:\n  subprocess.run(["owl-send", widget_file(), "set", "sel", json.dumps(sid)], capture_output=True, timeout=10)\n except Exception:\n  pass\ndef use(sid):\n all_ = scenes()\n sc = next((s for s in all_ if s["id"] == sid), None)\n if sc is None and sid.isdigit() and 0 < int(sid) <= len(all_):\n  sc = all_[int(sid) - 1]\n if sc is None:\n  sys.exit(f"pixbg: 找不到場景 {sid}")\n errs = checked(open(sc["path"]).read())\n if errs:\n  status("error", M("notPassed", name=sc["name"]) + errs[0][:120])\n  sys.exit("pixbg: " + "\\n".join(errs))\n if not any(x["id"] == sc["id"] for x in read_json(BUNDLE, {}).get("scenes", [])):\n  build_bundle()\n notify_sel(sc["id"])\n return sc\ndef step(d):\n ids = [x["id"] for x in read_json(BUNDLE, {}).get("scenes", [])] or [x["id"] for x in build_bundle()[0]]\n cur = current_id()\n i = ids.index(cur) if cur in ids else -1\n use(ids[(i + d) % len(ids)])\ndef widget_file():\n hits = sorted(glob.glob(os.path.join(WIDGETS, "*trip-view*.owl"))) or sorted(glob.glob(os.path.join(WIDGETS, "*pixel-bg*.owl")))\n if not hits:\n  sys.exit("pixbg: 找不到 Trip View 小工具檔（~/.config/omalauncher/widgets/30-trip-view.owl）")\n return hits[0]\ndef render(which="screen"):\n f = widget_file()\n with open(f) as fh:\n  text = fh.read()\n text = re.sub(r"\\n// pixbg-frame: \\d+\\n?$", "\\n", text).rstrip("\\n") + f"\\n// pixbg-frame: {int(time.time() * 1000)}\\n"\n with open(f, "w") as fh:\n  fh.write(text)\n r = subprocess.run(["owl-check", f], capture_output=True, text=True, timeout=120)\n m = re.search(which + r": (\\S+\\.png)", r.stdout)\n if not m:\n  raise RuntimeError("啟動器沒有畫出預覽：" + (r.stdout + r.stderr).strip()[-200:])\n return m.group(1)\ndef config():\n agent = "claude"\n try:\n  agent = open(os.path.join(HOME, ".config/omalauncher/agent")).read().strip() or agent\n except OSError:\n  pass\n cfg = {"agent": agent if agent in ("claude", "codex") else "claude"}\n cfg.update(read_json(CONFIG, {}))\n if cfg.get("agent") not in ("codex", "claude"):\n  cfg = {"agent": "claude", "model": ""}\n cfg.setdefault("model", "")\n return cfg\nPROMPT = \x22\x22\x22你是像素藝術家兼 shader 工程師。為 Android 啟動器 omalauncher 寫一個「像素動畫背景」場景，\n用 AGSL（Android 的 SkSL 片段著色器，語法近似 GLSL ES）。\n\n{task}\n\n規則（和 UFOPUMP 遊戲背景同一套像素語言）：\n1. 下面這段標頭會自動加在你的程式前面，不要重寫它，直接用裡面的 PX、hash*、band、dith、hx、ramp、segd、zone、speed、size、time：\n```agsl\n{header}\n```\n2. 先算 `float s = PX(); float2 c = floor(p / s); float2 G = floor(size / s); float t = time * max(speed, 0.0);`\n   之後所有繪圖都在整數格座標 c 上做（邏輯寬約 216 格，y 向下）。不用抗鋸齒、不用平滑漸層：漸層一律用 band() 量化成 4–6 階並抖色。\n3. 一定要寫 `void palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac)`，\n   依 zone（0..4）給五組配色：底色 bg、暗中亮三段色 c0 c1 c2、一個對比色 ac。五組要有明顯差異但同一個主題。\n4. 至少三層：天空／遠景、中景、前景或粒子；至少兩種動效（飄移、閃爍、往上捲動的視差、粒子、偶發事件等）。\n   任何一點的明暗交替每秒 3 次以內。畫面要直式手機（約 9:20）和方形小卡都好看，主體別只擠在一角。\n5. AGSL 限制：沒有貼圖、沒有陣列；沒有 while；for 只能寫成 `for (int i = 0; i < 常數; i++)` 且次數 ≤ 16；\n   全用 float（整數字面值寫成 1.0）；不可宣告全域可變變數；`%` 改用 mod()。\n6. 效能是硬性規定：整個手機螢幕每秒要算 60 次，太重會讓 GPU 逾時、整個啟動器被系統重啟。\n   每個像素的運算量（sin／cos／length／sqrt 約 1，pow 2，hash 約 0.6，迴圈裡的乘上次數）要在 {budget} 以內，\n   參考範例約 {example_cost}。粒子、星星、雨滴用「格子分桶」（每格算一個 hash 決定有沒有東西），不要用迴圈逐一檢查；\n   迴圈只留給少數大物件，而且先用距離或範圍判斷，不在附近就跳過。\n7. 第一行寫 `// name: <場景短名，英文大寫＋中文，例如 NEON RAIN 霓虹雨>`，第二行寫 `// prompt: {wish_line}`，\n   第三行寫 `// mascot: <ufo|car|star|firefly|sentinel 選一個最搭的>`（小工具上會有這隻像素吉祥物陪著場景）。\n   palette() 裡的顏色一律寫成 `hx(0xRRGGBB)`，時鐘和吉祥物會沿用同一套顏色。\n8. 只輸出一個 ```agsl 程式碼區塊，裡面是完整的場景（palette、輔助函式、`half4 main(float2 p)`），區塊外不要有任何文字。不要用工具、不要讀寫檔案。\n\n{example_title}：\n```agsl\n{example}\n```\n\x22\x22\x22\nGEN_TASK = "使用者的一句話：「{wish}」"\nEDIT_TASK = \x22\x22\x22這次是修改一個已經做好的場景，不是從頭畫。使用者當初的一句話：「{orig}」\n現在使用者想這樣改：「{change}」\n以最後附的「目前的場景」為基礎，只改使用者要求的部分，其他的構圖、動效、配色、名稱和吉祥物都保持原樣。\x22\x22\x22\nFIX = \x22\x22\x22剛才的程式沒有通過檢查（還沒送上手機），問題是：\n{err}\n\n請修正後重新輸出完整的 ```agsl 程式碼區塊（同樣的規則，區塊外不要有文字）。原本的程式：\n```agsl\n{code}\n```\n\x22\x22\x22\nNAMES = {"claude": "Claude", "codex": "Codex"}\nLOGIN = {"claude": "claude auth login", "codex": "codex login"}\nINSTALL = {"claude": "npm i -g @anthropic-ai/claude-code", "codex": "npm i -g @openai/codex"}\nSTALL = 240     \nAGENT_CWD = os.path.join(tempfile.gettempdir(), "pixbg-agent")\nclass AgentError(RuntimeError):\n def __init__(self, msg, fix="", kind=""):\n  super().__init__(msg)\n  self.fix, self.kind = fix, kind     \ndef find_cli(name):\n hit = shutil.which(name)\n if hit:\n  return hit\n for d in ("~/.local/bin", "~/.local/share/mise/shims", f"~/.local/share/mise/installs/{name}/latest/bin",\n   f"~/.local/share/mise/installs/{name}/latest", "~/.npm-global/bin", "~/.bun/bin", "/usr/local/bin"):\n  path = os.path.join(os.path.expanduser(d), name)\n  if os.path.isfile(path) and os.access(path, os.X_OK):\n   return path\n return None\ndef cli_env(exe):\n env = dict(os.environ)\n env["PATH"] = os.path.dirname(exe) + os.pathsep + env.get("PATH", "/usr/bin:/bin")\n return env\ndef probe(agent):\n out = {"id": agent, "name": NAMES[agent], "ok": False, "state": "missing", "version": "", "fix": INSTALL[agent]}\n exe = find_cli(agent)\n if not exe:\n  return out\n env = cli_env(exe)\n try:\n  v = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=15, env=env)\n  m = re.search(r"\\d+\\.\\d+\\.\\d+", v.stdout)\n  out["version"] = m.group(0) if m else ""\n  if agent == "claude":\n   r = subprocess.run([exe, "auth", "status"], capture_output=True, text=True, timeout=15, env=env)\n   try:\n    ok = json.loads(r.stdout).get("loggedIn") is True\n   except ValueError:\n    ok = False\n   ok = ok or bool(os.environ.get("ANTHROPIC_API_KEY"))\n  else:\n   r = subprocess.run([exe, "login", "status"], capture_output=True, text=True, timeout=15, env=env)\n   said = (r.stdout + r.stderr).lower()\n   ok = r.returncode == 0 and "logged in" in said and "not logged" not in said\n except (OSError, subprocess.TimeoutExpired):\n  out.update(state="error", fix="")\n  return out\n out.update(ok=ok, state="ready" if ok else "login", fix="" if ok else LOGIN[agent])\n model = agent_model(agent)\n out["model"] = model_label(model, agent) if model else ""\n return out\ndef probe_all():\n res = {}\n ts = [threading.Thread(target=lambda a=a: res.__setitem__(a, probe(a))) for a in NAMES]\n for t in ts:\n  t.start()\n for t in ts:\n  t.join()\n data = {"t": int(time.time()), "list": [res[a] for a in NAMES]}\n write_json(AGENTS, data)\n return data\ndef ready_agent(cfg):\n info = {a["id"]: a for a in probe_all()["list"]}\n a = info[cfg["agent"]]\n if a["ok"]:\n  return cfg, ""\n other = info["codex" if cfg["agent"] == "claude" else "claude"]\n if other["ok"]:\n  saved = read_json(CONFIG, {})\n  saved.update(agent=other["id"], model="")\n  write_json(CONFIG, saved)\n  build_ui()\n  return {"agent": other["id"], "model": ""}, M("switched", a=a["name"], b=other["name"])\n if a["state"] == "missing":\n  raise AgentError(M("missingAgent", agent=a["name"]), a["fix"])\n if a["state"] == "login":\n  raise AgentError(M("needLogin", agent=a["name"]), a["fix"])\n raise AgentError(M("agentFailed", agent=a["name"]))\ndef explain(agent, raw):\n low, name = raw.lower(), NAMES[agent]\n if re.search(r"not (logged|signed) in|please (log|sign) ?in|authenticat|unauthori[sz]ed|\\b401\\b|invalid api key|oauth|token (has )?expired", low):\n  return AgentError(M("needLogin", agent=name), LOGIN[agent], "login")\n if re.search(r"rate.?limit|usage limit|\\b429\\b|quota|overloaded|\\b529\\b", low):\n  when = re.search(r"try again (?:at|in) ([^.,\\n]+)", raw, re.I)\n  return AgentError(M("busyAgent", agent=name, when=M("tryAt", t=when.group(1).strip()) if when else ""), kind="busy")\n if re.search(r"enotfound|econnre|getaddrinfo|network|dns|socket hang up|connection (refused|reset)", low):\n  return AgentError(M("offline", agent=name))\n lines = [x for x in raw.strip().splitlines() if x.strip()]\n return AgentError(M("agentFailed", agent=name) + (lines[-1][:160] if lines else ""))\ndef ask_agent(prompt, cfg, on=lambda kind, **kw: None):\n agent, model = cfg["agent"], cfg.get("model")\n exe = find_cli(agent)\n if exe is None:\n  raise AgentError(M("missingAgent", agent=NAMES[agent]), INSTALL[agent])\n if agent == "codex":\n  cmd = [exe, "exec", "--json", "--skip-git-repo-check", "--ephemeral", "-s", "read-only"] + (["-m", model] if model else []) + ["-"]\n else:\n  cmd = [exe, "-p", "--output-format", "stream-json", "--verbose", "--include-partial-messages",\n   "--tools", "", "--no-session-persistence"] + (["--model", model] if model else [])\n os.makedirs(AGENT_CWD, exist_ok=True)\n proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,\n       text=True, cwd=AGENT_CWD, env=cli_env(exe), process_group=0)\n _agent["proc"] = proc\n lines, err = queue.Queue(), []\n def pump():\n  for line in proc.stdout:\n   lines.put(line)\n  lines.put(None)\n threading.Thread(target=pump, daemon=True).start()\n threading.Thread(target=lambda: err.extend(proc.stderr), daemon=True).start()\n proc.stdin.write(prompt)\n proc.stdin.close()\n text, final, fail, last = "", None, "", time.time()\n while True:\n  try:\n   line = lines.get(timeout=2)\n  except queue.Empty:\n   if time.time() - last > STALL:\n    kill_agent()\n    raise AgentError(M("stalled", agent=NAMES[agent], s=STALL))\n   on("tick")\n   continue\n  if line is None:\n   break\n  last = time.time()\n  try:\n   e = json.loads(line)\n  except ValueError:\n   continue\n  t = e.get("type")\n  if agent == "claude":\n   if t == "system" and e.get("subtype") == "init":\n    if e.get("model"):\n     write_json(MODELS, {**read_json(MODELS, {}), agent: e["model"]})\n    on("connected", model=e.get("model"))\n   elif t == "stream_event":\n    d = (e.get("event") or {}).get("delta") or {}\n    if d.get("type") == "text_delta":\n     text += d.get("text", "")\n     on("writing", text=text)\n    elif d.get("type") == "thinking_delta":\n     on("thinking")\n   elif t == "result":\n    final = e.get("result") or ""\n    if e.get("is_error"):\n     fail = final or str(e.get("subtype"))\n  else:\n   it = e.get("item") or {}\n   if t == "thread.started":\n    on("connected")\n   elif t == "item.completed" and it.get("type") == "agent_message":\n    final = it.get("text", "")\n    on("writing", text=final)\n   elif t in ("item.started", "item.completed"):\n    on("thinking")\n   elif t in ("turn.failed", "error"):\n    fail = (e.get("error") or {}).get("message") or e.get("message") or t\n   else:\n    on("tick")\n proc.wait()\n out = final if final else text\n if (fail and agent == "claude") or not out.strip():\n  raise explain(agent, fail + "\\n" + "".join(err[-20:]))\n m = re.findall(r"```(?:agsl|glsl|sksl|c|cpp)?\\s*\\n(.*?)```", out, re.S)\n code = max(m, key=len) if m else out\n if "main" not in code:\n  raise AgentError(M("noShader", agent=NAMES[agent]))\n return code.strip() + "\\n"\n_agent = {}\ndef kill_agent(*_):\n proc = _agent.pop("proc", None)\n if proc and proc.poll() is None:\n  try:\n   os.killpg(proc.pid, signal.SIGKILL)\n  except OSError:\n   pass\ndef model_label(model, agent):\n model = re.sub(r"\\[.*\\]$", "", model or "")\n m = re.match(r"claude-([a-z]+)-(\\d+)-(\\d+)", model)\n if m:\n  return f"{m.group(1).capitalize()} {m.group(2)}.{m.group(3)}"\n if model in ("opus", "sonnet", "haiku", "fable"):\n  return model.capitalize()\n if model and agent == "codex":\n  for x in read_json(os.path.join(HOME, ".codex/models_cache.json"), {}).get("models", []):\n   if x.get("slug") == model and x.get("display_name"):\n    return x["display_name"]\n return model or NAMES[agent]\ndef agent_model(agent):\n cfg = read_json(CONFIG, {})\n if cfg.get("agent") == agent and cfg.get("model"):\n  return cfg["model"]\n if agent == "codex":\n  try:\n   m = re.search(r\'^model\\s*=\\s*"([^"]+)"\', open(os.path.join(HOME, ".codex/config.toml")).read(), re.M)\n   if m:\n    return m.group(1)\n  except OSError:\n   pass\n else:\n  set_ = os.environ.get("ANTHROPIC_MODEL") or read_json(os.path.join(HOME, ".claude/settings.json"), {}).get("model")\n  if set_:\n   return set_\n return read_json(MODELS, {}).get(agent, "")\ndef gen(wish, edit=None):\n _job["job"] = "edit" if edit else "gen"\n extra = {"edit": edit} if edit else {}\n signal.signal(signal.SIGTERM, lambda *_: (kill_agent(), os._exit(143)))\n status("working", M("connecting", agent=NAMES[config()["agent"]]), p=0.02, to=0.05, eta=8, wish=wish, **extra)\n try:\n  cfg, note = ready_agent(config())\n except AgentError as e:\n  status("error", str(e)[:300], wish=wish, fix=e.fix, **extra)\n  sys.exit(1)\n agent = cfg["agent"]\n who = model_label(cfg.get("model") or agent_model(agent), agent)\n times = read_json(os.path.join(CACHE, "gen-times.json"), {})\n times = {"claude": times} if isinstance(times, list) else times\n mine = times.get(agent) or []\n eta = sorted(mine)[len(mine) // 2] if mine else (210 if agent == "claude" else 150)\n with open(os.path.join(SCENES, "10-void.agsl")) as f:\n  example = f.read()\n hdr = header()\n _, example_cost = agslcheck.check(hdr, example)\n if edit:\n  with open(os.path.join(SCENES, edit + ".agsl")) as f:\n   base = f.read()\n  orig = meta(base, "prompt") or meta(base, "name") or edit\n  prompt = PROMPT.format(task=EDIT_TASK.format(orig=orig, change=wish), wish_line=orig.replace("\\n", " "),\n       header=hdr.replace("// ── 場景 ──\\n", ""), example_title="目前的場景（要修改的就是它）",\n       example=base, budget=agslcheck.BUDGET, example_cost=round(example_cost))\n  expect = len(base) * 1.1    \n  sid = edit\n else:\n  prompt = PROMPT.format(task=GEN_TASK.format(wish=wish), wish_line=wish.replace("\\n", " "), header=hdr.replace("// ── 場景 ──\\n", ""),\n       example_title="參考範例（內建的 VOID SPACE）", example=example, budget=agslcheck.BUDGET,\n       example_cost=round(example_cost))\n  expect = len(example) * 1.9     \n  sid = time.strftime("ai-%Y%m%d-%H%M%S")\n t0 = time.time()\n def reporter(lo, hi, retry=""):\n  st = {"phase": "", "at": 0}\n  lead = (note + " · " if note and not retry else "") + retry\n  def on(kind, text="", model=None):\n   nonlocal who\n   now = time.time()\n   if kind == "connected" and st["phase"] == "":\n    who = model_label(model, agent) if model else who\n    st["phase"] = "thinking"\n    status("working", lead + M("thinking", who=who, wish=wish), p=lo + 0.04, to=lo + (hi - lo) * 0.6, eta=eta * 0.8, wish=wish, agent=agent, **extra)\n   elif kind == "thinking" and st["phase"] == "" :\n    on("connected")\n   elif kind == "writing" and (st["phase"] != "writing" or now - st["at"] > 1):\n    st.update(phase="writing", at=now)\n    f = min(1.0, len(text) / expect)\n    parts = re.findall(r"^\\s*(?:half[34]|float[234]?|void)\\s+(\\w+)\\s*\\(", text, re.M)\n    where = (parts[-1] + "()") if parts else ""\n    p = lo + (hi - lo) * (0.6 + 0.4 * f)\n    status("working", lead + M("writing", who=who, n=text.count("\\n") + 1, part=where), p=p, to=min(hi, p + 0.03), eta=4, wish=wish, agent=agent, **extra)\n   else:\n    beat()\n  return on\n try:\n  code, errs = "", []\n  for attempt in range(3):\n   lo = [0.05, 0.45, 0.65][attempt]\n   retry = M("retry", n=attempt) + errs[0].splitlines()[0][:50] + " · " if attempt else ""\n   status("working", (note + " · " if note and not attempt else "") + retry + M("handoffTo", who=who),\n    p=lo, to=lo + 0.04, eta=10, wish=wish, agent=agent, **extra)\n   try:\n    code = ask_agent(prompt if attempt == 0 else FIX.format(err="\\n".join(errs), code=code), cfg, reporter(lo, 0.86, retry))\n   except AgentError as e:\n    other = "codex" if agent == "claude" else "claude"\n    if e.kind not in ("login", "busy") or note.startswith("↪") or not probe(other)["ok"]:\n     raise\n    note = "↪ " + M("switched", a=NAMES[agent], b=NAMES[other])\n    cfg, agent, mine = {"agent": other, "model": ""}, other, times.get(other) or []\n    who = model_label(agent_model(other), other)\n    status("working", note, p=lo, to=lo + 0.04, eta=10, wish=wish, agent=agent, **extra)\n    try:\n     code = ask_agent(prompt if attempt == 0 else FIX.format(err="\\n".join(errs), code=code), cfg, reporter(lo, 0.86, retry))\n    except AgentError as e2:\n     raise AgentError(f"{e} {e2}", e.fix or e2.fix)     \n   if not re.search(r"^//\\s*name:", code, re.M):\n    code = f"// name: {(meta(base, \'name\') if edit else \'\') or wish[:16]}\\n" + code\n   if not re.search(r"^//\\s*prompt:", code, re.M):\n    code = code.replace("\\n", f"\\n// prompt: {wish}\\n", 1)\n   status("working", M("checking"), p=0.88, to=0.92, eta=5, wish=wish, agent=agent, **extra)\n   errs, c = agslcheck.check(hdr, code)\n   print(f"[{time.strftime(\'%T\')}] {agent} 第 {attempt + 1} 次：{time.time() - t0:.0f}s，運算量 {c:.0f}，{errs or \'ok\'}", flush=True)\n   if not errs:\n    if edit:\n     os.makedirs(HISTORY, exist_ok=True)\n     shutil.copyfile(os.path.join(SCENES, sid + ".agsl"), os.path.join(HISTORY, f"{sid}-{time.strftime(\'%Y%m%d-%H%M%S\')}.agsl"))\n     code = re.sub(r"^//\\s*(prompt|edit|name):.*\\n", "", code, flags=re.M)\n     if meta(base, "mascot"):\n      code = re.sub(r"^//\\s*mascot:.*\\n", "", code, flags=re.M)\n      code = f"// mascot: {meta(base, \'mascot\')}\\n" + code\n     code = f"// name: {meta(base, \'name\') or sid}\\n" + code     \n     notes = "".join(f"// edit: {x}\\n" for x in re.findall(r"^//\\s*edit:\\s*(.+)$", base, re.M) + [wish.replace("\\n", " ")])\n     code = re.sub(r"^(//\\s*name:.*\\n)", lambda m: m.group(1) + f"// prompt: {orig}\\n" + notes, code, count=1, flags=re.M)\n    with open(os.path.join(SCENES, sid + ".agsl"), "w") as f:\n     f.write(code)\n    build_bundle()\n    notify_sel(sid)\n    status("working", M("thumbing"), p=0.95, to=0.99, eta=8, wish=wish, agent=agent, **extra)\n    try:\n     make_thumbs([sid], force=bool(edit))\n     make_tiles([sid])\n    except BaseException:\n     pass\n    times[agent] = (mine + [int(time.time() - t0)])[-9:]\n    write_json(os.path.join(CACHE, "gen-times.json"), times)\n    status("done", M("edited" if edit else "done", name=split_name(meta(code, "name"))[pack(lang())["names"] != "en"], secs=fmt_secs(time.time() - t0)), p=1, wish=wish, id=sid, agent=agent, **extra)\n    return\n  raise AgentError(M("failed3") + errs[0].splitlines()[0][:160])\n except AgentError as e:\n  status("error", str(e)[:300], wish=wish, fix=e.fix, agent=agent, **extra)\n  sys.exit(1)\n except Exception as e:\n  status("error", str(e)[:300], wish=wish, agent=agent, **extra)\n  sys.exit(1)\ndef gen_running(jobs=("gen", "edit")):\n st = read_json(STATUS, {})\n pid = st.get("pid")\n if st.get("state") != "working" or st.get("job") not in jobs or not pid:\n  return None\n try:\n  os.kill(pid, 0)\n except OSError:\n  return None\n return pid\ndef fmt_secs(x):\n x = int(x)\n return M("mins", m=x // 60, s=x % 60) if x >= 60 else M("secs", s=x)\ndef style_top(text):\n m = re.search(r"^[ \\t]*\\[", text, re.M)\n return (text[:m.start()], text[m.start():]) if m else (text, "")\ndef theme_name():\n try:\n  m = re.search(r\'^[ \\t]*theme[ \\t]*=[ \\t]*"([^"]+)"\', style_top(open(STYLE).read())[0], re.M)\n  return m.group(1) if m else None\n except OSError:\n  return None\ndef set_background(name):\n with open(STYLE) as f:\n  top, rest = style_top(f.read())\n line = f\'background = "{name}"\'\n if re.search(r"^[ \\t]*background[ \\t]*=", top, re.M):\n  top = re.sub(r"^[ \\t]*background[ \\t]*=.*$", lambda _: line, top, count=1, flags=re.M)\n elif re.search(r"^[ \\t]*theme[ \\t]*=.*$", top, re.M):\n  top = re.sub(r"^([ \\t]*theme[ \\t]*=.*)$", lambda m: m.group(1) + "\\n" + line, top, count=1, flags=re.M)\n else:\n  top = (top.rstrip("\\n") + "\\n" if top.strip() else "") + line + "\\n" + ("\\n" if rest else "")\n with open(STYLE, "w") as f:\n  f.write(top + rest)\ndef wall_files():\n os.makedirs(GALLERY, exist_ok=True)\n files = [f for f in os.listdir(GALLERY) if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")) and not f.startswith(".")]\n return sorted(files, key=lambda f: os.path.getmtime(os.path.join(GALLERY, f)), reverse=True)\ndef active_wall():\n try:\n  m = re.search(r\'^[ \\t]*background[ \\t]*=[ \\t]*"pixbg-([^"]+)"\', style_top(open(STYLE).read())[0], re.M)\n  return m.group(1) if m and os.path.exists(os.path.join(GALLERY, m.group(1))) else None\n except OSError:\n  return None\ndef list_walls():\n from PIL import Image\n os.makedirs(THUMBS, exist_ok=True)\n active = active_wall()\n out = []\n for f in wall_files():\n  src = os.path.join(GALLERY, f)\n  thumb = os.path.join(THUMBS, os.path.splitext(f)[0] + ".png")\n  if not os.path.exists(thumb) or os.path.getmtime(thumb) < os.path.getmtime(src):\n   try:\n    im = Image.open(src).convert("RGB")\n    im.thumbnail((216, 480), Image.NEAREST)\n    im.save(thumb)\n   except Exception:\n    continue\n  m = re.match(r"(\\d{8})-(\\d{6})-(.+)\\.\\w+$", f)\n  label = f"{m.group(1)[4:6]}/{m.group(1)[6:]} {m.group(2)[:2]}:{m.group(2)[2:4]}" if m else os.path.splitext(f)[0][:14]\n  out.append({"file": f, "thumb": thumb, "label": label, "active": f == active})\n write_json(WALLS, out)\n return out\ndef apply_wall(name):\n theme = theme_name()\n if not theme:\n  sys.exit("pixbg: style.toml 沒有 theme")\n src = os.path.join(GALLERY, name)\n if not os.path.exists(src):\n  sys.exit(f"pixbg: 相簿裡沒有 {name}")\n folder = os.path.join(HOME, ".config/omarchy/backgrounds", theme)\n os.makedirs(folder, exist_ok=True)\n for old in glob.glob(os.path.join(folder, "pixbg-*")):\n  os.remove(old)\n shutil.copyfile(src, os.path.join(folder, "pixbg-" + name))\n set_background("pixbg-" + name)\n list_walls()\ndef migrate_walls():\n for old in glob.glob(os.path.join(HOME, ".config/omarchy/backgrounds/*/pixbg-*.png")):\n  base = os.path.basename(old)[len("pixbg-"):]\n  m = re.match(r"(.+)-(\\d{9,})\\.png$", base)\n  if m:  \n   name = time.strftime("%Y%m%d-%H%M%S-", time.localtime(int(m.group(2)))) + m.group(1) + ".png"\n   os.makedirs(GALLERY, exist_ok=True)\n   if not os.path.exists(os.path.join(GALLERY, name)):\n    shutil.copyfile(old, os.path.join(GALLERY, name))\n    os.utime(os.path.join(GALLERY, name), (int(m.group(2)), int(m.group(2))))\n   if re.search(r\'^[ \\t]*background[ \\t]*=[ \\t]*"%s"\' % re.escape(os.path.basename(old)), style_top(open(STYLE).read())[0], re.M):\n    apply_wall(name)\ndef wall(sid=None):\n _job["job"] = "wall"\n sid = sid or current_id() or (read_json(BUNDLE, {}).get("scenes") or [{}])[0].get("id")\n for bad, why in ((not sid, "還沒有選場景"), (not theme_name(), "style.toml 沒有 theme")):\n  if bad:\n   status("error", M("wallFail") + why)\n   sys.exit("pixbg: " + why)\n status("working", M("wallPrep"), p=0.05)\n lock = render_lock()\n try:\n  from PIL import Image\n  box = read_json(BOX, {}).get("box")\n  if not box:\n   status("working", M("wallMeasure"), p=0.1, to=0.4, eta=8)\n   box = measure_box()\n  box = tuple(box)\n  write_json(EXPORT, {"on": True, "id": sid, "t": int(time.time())})\n  status("working", M("wallDraw"), p=0.45, to=0.85, eta=7)\n  shot = render()\n  status("working", M("wallCrop"), p=0.9)\n  W, H = Image.open(shot).size\n  im = Image.open(shot).convert("RGB").crop(box).resize((W, H), Image.NEAREST)\n  os.makedirs(GALLERY, exist_ok=True)\n  name = time.strftime("%Y%m%d-%H%M%S-") + sid + ".png"\n  im.save(os.path.join(GALLERY, name))\n  apply_wall(name)\n  status("done", M("wallDone"), p=1)\n except Exception as e:\n  status("error", (M("wallFail") + str(e))[:300])\n  raise\n finally:\n  write_json(EXPORT, {"on": False})\n  lock.close()\n  reload_widget()\ndef main(argv):\n os.makedirs(CACHE, exist_ok=True)\n sfx.ensure(os.path.join(CACHE, "sfx"))\n if not os.path.exists(UI):\n  build_ui()\n cmd = argv[0] if argv else "list"\n if cmd == "list":\n  cur = current_id()\n  for i, s in enumerate(scenes(), 1):\n   print(f"{\'*\' if s[\'id\'] == cur else \' \'} {i:2} {s[\'id\']:24} {s[\'name\']}")\n elif cmd == "use":\n  use(argv[1])\n elif cmd in ("next", "prev"):\n  step(1 if cmd == "next" else -1)\n elif cmd == "bundle":\n  ok, bad = build_bundle()\n  build_ui()\n  print(f"{len(ok)} 個場景打包好" + "".join(f"\\n  ✗ {sc[\'id\']}: {errs[0].splitlines()[0]}" for sc, errs in bad))\n elif cmd in ("gen", "edit"):\n  args = [a for a in argv[1:] if a != "--fg"]\n  edit = None\n  if cmd == "edit":\n   edit = args.pop(0) if args else ""\n   if not edit.startswith("ai-") or not os.path.exists(os.path.join(SCENES, edit + ".agsl")):\n    sys.exit("pixbg: 只能編輯 AI 生成的場景")\n  wish = " ".join(args).strip()\n  if not wish:\n   sys.exit("pixbg gen <一句話> | pixbg edit <id> <想怎麼改>")\n  if "--fg" in argv or os.environ.get("PIXBG_FG"):\n   gen(wish, edit)\n  elif gen_running():\n   print(M("already"))\n  else:\n   log = open(os.path.join(CACHE, "gen.log"), "a")\n   child = subprocess.Popen([sys.executable, os.path.abspath(__file__), cmd, "--fg"] + ([edit] if edit else []) + [wish],\n         stdout=log, stderr=log, start_new_session=True)\n   _job.update(job=cmd, started=int(time.time()), pid=child.pid)\n   status("working", M("handoff"), p=0.02, to=0.04, eta=5, wish=wish, **({"edit": edit} if edit else {}))\n elif cmd == "cancel":\n  pid = gen_running()\n  if pid:\n   try:\n    os.killpg(pid, signal.SIGTERM)\n   except OSError:\n    os.kill(pid, signal.SIGTERM)\n   time.sleep(0.3)\n   st = read_json(STATUS, {})\n   _job.update(job=st.get("job"), started=st.get("started"))\n   status("error", M("cancelled"), wish=st.get("wish", ""), **({"edit": st["edit"]} if st.get("edit") else {}))\n  print("cancelled" if pid else "nothing running")\n elif cmd == "agents":\n  for a in probe_all()["list"]:\n   print(f"{\'✓\' if a[\'ok\'] else \'✗\'} {a[\'id\']:7} {a.get(\'model\') or \'-\':14} CLI {a[\'version\'] or \'-\':10} {a[\'state\']}" + (f"   → {a[\'fix\']}" if a["fix"] else ""))\n elif cmd == "del":\n  sid = argv[1] if len(argv) > 1 else current_id()\n  if not sid or not sid.startswith("ai-") or not os.path.exists(os.path.join(SCENES, sid + ".agsl")):\n   sys.exit("pixbg: 只能刪 AI 生成的場景")\n  sc = next((x for x in scenes() if x["id"] == sid), {"name": sid})\n  ids = [x["id"] for x in read_json(BUNDLE, {}).get("scenes", [])]\n  before = ids[ids.index(sid) - 1] if sid in ids and ids.index(sid) > 0 else (ids[0] if ids else None)\n  os.remove(os.path.join(SCENES, sid + ".agsl"))\n  for old in (thumb_path(sid), tile_path(sid)):\n   if os.path.exists(old):\n    os.remove(old)\n  build_bundle()\n  if before and before != sid and current_id() == sid:\n   notify_sel(before)\n  _job["job"] = "del"\n  status("done", M("deleted", name=split_name(sc["name"])[pack(lang())["names"] != "en"]), p=1)\n elif cmd == "wall":\n  args = [a for a in argv[1:] if a != "--fg"]\n  if "--fg" in argv or os.environ.get("PIXBG_FG"):\n   wall(args[0] if args else None)\n  elif gen_running(("wall",)):\n   print(M("wallPrep"))\n  else:\n   log = open(os.path.join(CACHE, "wall.log"), "a")\n   child = subprocess.Popen([sys.executable, os.path.abspath(__file__), "wall", "--fg"] + args[:1],\n         stdout=log, stderr=log, start_new_session=True)\n   _job.update(job="wall", started=int(time.time()), pid=child.pid)\n   status("working", M("wallPrep"), p=0.02)\n elif cmd == "tile":\n  args = [a for a in argv[1:] if not a.startswith("--")]\n  if "--fg" in argv:\n   tile_worker(cards="--cards" in argv)\n  else:\n   sid = args[0] if args else (current_id() or (read_json(BUNDLE, {}).get("scenes") or [{}])[0].get("id"))\n   if sid:\n    with open(TILE_WANT, "w") as f:\n     f.write(sid)\n    subprocess.Popen([sys.executable, os.path.abspath(__file__), "tile", "--fg"] + (["--cards"] if "--cards" in argv else []),\n        stdout=open(os.path.join(CACHE, "tile.log"), "a"), stderr=subprocess.STDOUT,\n        stdin=subprocess.DEVNULL, start_new_session=True)\n elif cmd == "tiles":\n  make_tiles([a for a in argv[1:] if not a.startswith("--")] or None)\n elif cmd == "lang":\n  code = (argv[1] if len(argv) > 1 else "zh").strip()\n  path = os.path.join(LANGS, code + ".json")\n  try:\n   d = json.load(open(path))\n  except FileNotFoundError:\n   sys.exit(f"pixbg: 沒有語言包 {path}")\n  except ValueError as e:\n   sys.exit(f"pixbg: {path} 不是合法的 JSON：{e}")\n  missing = [k for k in pack("en")["T"] if k not in (d.get("T") or {})] + [k for k in pack("en")["msg"] if k not in (d.get("msg") or {})]\n  with open(LANG, "w") as f:\n   f.write(code)\n  build_ui(code)\n  try:\n   subprocess.run(["owl-send", widget_file(), "set", "langCode", json.dumps(code)], capture_output=True, timeout=10)\n  except Exception:\n   pass\n  print(f"語言：{d.get(\'name\') or code}" + (f"（缺 {len(missing)} 個字串，暫用英文：{\', \'.join(missing[:12])}）" if missing else ""))\n elif cmd == "langs":\n  cur = lang()\n  for x in langs():\n   print(("* " if x["code"] == cur else "  ") + f"{x[\'code\']:8} {x[\'name\']}")\n elif cmd == "preview":\n  print(render())\n elif cmd == "thumbs":\n  ids = [a for a in argv[1:] if not a.startswith("--")] or None\n  make_thumbs(ids, force="--all" in argv)\n elif cmd == "walls":\n  migrate_walls()\n  for w in list_walls():\n   print(("* " if w["active"] else "  ") + w["file"])\n elif cmd == "setwall":\n  apply_wall(argv[1])\n  status("done", M("wallSwitched"), p=1)\n elif cmd == "rmwall":\n  name = os.path.basename(argv[1])\n  if name == active_wall():\n   sys.exit("pixbg: 這張正在用，先換一張再刪")\n  os.remove(os.path.join(GALLERY, name))\n  list_walls()\n elif cmd == "agent":\n  if len(argv) < 2 or argv[1] not in ("codex", "claude"):\n   sys.exit("Usage: pixbg agent <codex|claude> [model]")\n  cfg = read_json(CONFIG, {})\n  cfg["agent"] = argv[1]\n  cfg["model"] = argv[2] if len(argv) > 2 else ""\n  write_json(CONFIG, cfg)\n  build_ui()\n  a = probe_all()["list"][list(NAMES).index(argv[1])]\n  print(cfg, a["state"] + (f"  → {a[\'fix\']}" if a["fix"] else ""))\n elif cmd == "check":\n  ids = argv[1:] or [s["id"] for s in scenes()]\n  bad = 0\n  for sc in scenes():\n   if sc["id"] in ids:\n    errs, c = agslcheck.check(header(), open(sc["path"]).read())\n    bad += bool(errs)\n    print(f"{\'✗\' if errs else \'✓\'} {sc[\'id\']:24} 運算量 {c:5.0f}/{agslcheck.BUDGET}  " + ("; ".join(e.splitlines()[0] for e in errs)))\n  sys.exit(1 if bad else 0)\n else:\n  print(__doc__)\nif __name__ == "__main__":\n main(sys.argv[1:])\n', '.local/share/pixbg/agslcheck.py': '# SPDX-License-Identifier: MIT\n# Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nimport os, re, subprocess, tempfile\nBUDGET = 130\nMAX_LOOP = 16\nMAX_SRC = 20000\nCOST = {"sin": 1, "cos": 1, "tan": 2, "asin": 2, "acos": 2, "atan": 2, "pow": 2, "exp": 1.5, "log": 1.5,\n  "sqrt": 1, "inversesqrt": 1, "length": 1, "distance": 1, "normalize": 1.5, "smoothstep": 0.5,\n  "fract": 0.2, "floor": 0.1, "mod": 0.3, "mix": 0.2, "dot": 0.2, "clamp": 0.1, "abs": 0.05, "step": 0.1}\nPRELUDE = \x22\x22\x22#version 450\n#define half float\n#define half2 vec2\n#define half3 vec3\n#define half4 vec4\n#define float2 vec2\n#define float3 vec3\n#define float4 vec4\n#define int2 ivec2\n#define int3 ivec3\n#define int4 ivec4\n#define bool2 bvec2\n#define bool3 bvec3\n#define bool4 bvec4\n#define float2x2 mat2\n#define float3x3 mat3\n#define float4x4 mat4\n#define half2x2 mat2\n#define half3x3 mat3\nuniform vec2 size;\nuniform float time;\nlayout(location = 0) out vec4 pixbg_out;\n\x22\x22\x22\ndef _block(src, i):\n j = i\n while j < len(src) and src[j] in " \\t\\r\\n":\n  j += 1\n if j < len(src) and src[j] == "{":\n  depth = 0\n  for k in range(j, len(src)):\n   if src[k] == "{":\n    depth += 1\n   elif src[k] == "}":\n    depth -= 1\n    if depth == 0:\n     return j, k + 1\n  return j, len(src)\n k = src.find(";", j)\n return j, (k + 1 if k >= 0 else len(src))\ndef _strip_comments(src):\n src = re.sub(r"/\\*.*?\\*/", " ", src, flags=re.S)\n return re.sub(r"//[^\\n]*", "", src)\ndef functions(src):\n out = {}\n for m in re.finditer(r"\\b(?:void|float|half|bool|int|float[234]|half[234]|int[234]|bool[234])\\s+(\\w+)\\s*\\([^)]*\\)\\s*\\{", src):\n  a, b = _block(src, m.end() - 1)\n  out[m.group(1)] = src[a:b]\n return out\ndef cost(body, fns, memo, depth=0):\n if depth > 8:\n  return 0\n total = 0.0\n rest = body\n while True:\n  m = re.search(r"\\bfor\\s*\\(\\s*int\\s+\\w+\\s*=\\s*(-?\\d+)\\s*;\\s*\\w+\\s*(<|<=)\\s*(\\d+)", rest)\n  if not m:\n   break\n  close = rest.find(")", m.end())\n  a, b = _block(rest, close + 1)\n  n = int(m.group(3)) - int(m.group(1)) + (1 if m.group(2) == "<=" else 0)\n  total += max(n, 1) * cost(rest[a:b], fns, memo, depth + 1)\n  rest = rest[:m.start()] + rest[b:]\n for name in re.findall(r"\\b(\\w+)\\s*\\(", rest):\n  if name in COST:\n   total += COST[name]\n  elif name in fns:\n   if name not in memo:\n    memo[name] = 0  \n    memo[name] = cost(fns[name], fns, memo, depth + 1)\n   total += memo[name]\n return total\ndef rules(body):\n errs = []\n if len(body) > MAX_SRC:\n  errs.append(f"程式太長（{len(body)} 字元，上限 {MAX_SRC}）")\n if re.search(r"\\b(while|do)\\b", body):\n  errs.append("不能用 while／do 迴圈，只能用常數次數的 for")\n for m in re.finditer(r"\\bfor\\s*\\(([^)]*)\\)", body):\n  hdr = m.group(1)\n  lm = re.match(r"\\s*int\\s+(\\w+)\\s*=\\s*(-?\\d+)\\s*;\\s*(\\w+)\\s*(<|<=)\\s*(\\d+)\\s*;\\s*(\\w+)\\s*(\\+\\+|\\+=\\s*1)\\s*$", hdr)\n  if not lm:\n   errs.append(f"for 迴圈要寫成 for (int i = 0; i < 常數; i++)：for ({hdr.strip()})")\n  elif int(lm.group(5)) - int(lm.group(2)) > MAX_LOOP:\n   errs.append(f"迴圈次數 {int(lm.group(5)) - int(lm.group(2))} 超過上限 {MAX_LOOP}")\n if re.search(r"\\b(texture|sampler\\w*|shader\\s+\\w+|eval)\\b", body):\n  errs.append("不能用貼圖或子 shader")\n if re.search(r"\\w\\s*\\[\\s*\\d*\\s*\\]\\s*(=|;)", body) or re.search(r"\\b\\w+\\s*\\[\\s*\\]", body):\n  errs.append("不能用陣列")\n if not re.search(r"\\bhalf4\\s+main\\s*\\(\\s*float2\\s+\\w+\\s*\\)", body):\n  errs.append("要有 half4 main(float2 p)")\n return errs\ndef glsl(full, body_off=0):\n code = re.sub(r"\\bhalf4\\s+main\\s*\\(", "vec4 pixbg_main(", full)\n code = PRELUDE + code + "\\nvoid main() { pixbg_out = pixbg_main(gl_FragCoord.xy); }\\n"\n with tempfile.NamedTemporaryFile("w", suffix=".frag", delete=False) as f:\n  f.write(code)\n  path = f.name\n try:\n  r = subprocess.run(["glslangValidator", path], capture_output=True, text=True, timeout=30)\n finally:\n  os.unlink(path)\n if r.returncode == 0:\n  return None\n off = PRELUDE.count("\\n") + body_off\n lines = []\n for l in (r.stdout + r.stderr).splitlines():\n  m = re.match(r"ERROR: [^:]*:(\\d+): (.*)", l)\n  if m:\n   lines.append(f"第 {int(m.group(1)) - off} 行：{m.group(2)}")\n return "\\n".join(lines[:8]) or (r.stdout + r.stderr)[-600:]\ndef check(header, body):\n src = _strip_comments(body)\n errs = rules(src)\n err = glsl(header + body, header.count("\\n"))\n if err:\n  errs.append("編譯錯誤：\\n" + err)\n full = _strip_comments(header + body)\n fns = functions(full)\n c = cost(fns.get("main", ""), fns, {})\n if c > BUDGET:\n  errs.append(f"每像素運算量約 {c:.0f}，超過預算 {BUDGET}：減少迴圈次數、每格的 hash／sin 呼叫，或在迴圈前先用距離判斷提早跳過")\n return errs, c\n', '.local/share/pixbg/sfx.py': '# SPDX-License-Identifier: MIT\n# Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nimport math, os, struct, wave\nRATE = 22050\nVOLUME = 0.28  \ndef tone(f0, ms, wave_="square", f1=None, decay=4.0, vib=0.0):\n n = int(RATE * ms / 1000)\n f1 = f1 or f0\n out, ph, low = [], 0.0, 0.0\n for i in range(n):\n  t = i / n\n  f = f0 * (f1 / f0) ** t * (1 + vib * math.sin(2 * math.pi * 12 * i / RATE))\n  ph = (ph + f / RATE) % 1.0\n  x = 2 * math.pi * ph\n  if wave_ == "tri":\n   v = 4 * abs(ph - 0.5) - 1\n  elif wave_ == "noise":\n   v = math.sin(x * 37.1 + math.sin(i * 0.37) * 9) * 0.6\n  else:\n   v = (math.sin(x) + math.sin(3 * x) / 4 + math.sin(5 * x) / 10) * 0.85\n  env = min(1.0, i / 60) * min(1.0, (n - i) / 200) * math.exp(-decay * t)\n  low += 0.45 * (v * env - low)\n  out.append(low)\n return out\ndef seq(*parts):\n out = []\n for p in parts:\n  out += p\n return out\ndef mix(a, b, gb=0.5):\n n = max(len(a), len(b))\n return [(a[i] if i < len(a) else 0) + gb * (b[i] if i < len(b) else 0) for i in range(n)]\ndef notes(fs, ms, **kw):\n return seq(*[tone(f, ms, **kw) for f in fs])\nSOUNDS = {\n "tap": lambda: tone(660, 50, f1=990, decay=5),\n "next": lambda: notes([523, 784], 55, decay=4),\n "prev": lambda: notes([784, 523], 55, decay=4),\n "zone": lambda: notes([1047, 1319, 1568], 45, wave_="tri", decay=3),\n "speed": lambda: tone(330, 120, f1=880, wave_="tri", decay=2),\n "hide": lambda: tone(880, 90, f1=440, wave_="tri", decay=3),\n "boing": lambda: tone(392, 180, f1=880, wave_="tri", decay=2.5, vib=0.03),\n "beam": lambda: mix(tone(220, 420, f1=1320, wave_="tri", decay=1.5, vib=0.06), tone(1200, 300, wave_="noise", decay=4), 0.15),\n "wall": lambda: seq(tone(1400, 25, wave_="noise", decay=6), tone(900, 30, wave_="noise", decay=6), notes([784, 1047], 70, decay=3)),\n "gen": lambda: mix(tone(262, 600, f1=1047, decay=1.5, vib=0.04), seq([0.0] * int(RATE * 0.45), notes([1568, 2093], 60, wave_="tri")), 0.5),\n "done": lambda: seq(notes([523, 659, 784], 70, decay=3), tone(1047, 260, decay=2, vib=0.02)),\n "error": lambda: notes([330, 247], 120, wave_="tri", decay=2),\n}\ndef write(path, samples):\n peak = max(1e-6, max(abs(x) for x in samples))\n with wave.open(path, "wb") as w:\n  w.setnchannels(1)\n  w.setsampwidth(2)\n  w.setframerate(RATE)\n  w.writeframes(b"".join(struct.pack("<h", int(32767 * VOLUME * x / peak)) for x in samples))\ndef ensure(folder):\n os.makedirs(folder, exist_ok=True)\n for name, make in SOUNDS.items():\n  path = os.path.join(folder, name + ".wav")\n  if not os.path.exists(path):\n   write(path, make())\n', '.local/share/pixbg/LICENSE': 'MIT License\n\nCopyright (c) 2026 WeeboWIZ\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the "Software"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n'}, '1.1-120feeb1e70a')
TRIP_VIEW_SETUP""") }
  onTap: { liveAt = now; openedAt = now; panel = true; screen(); run(probeStale ? "~/.local/bin/pixbg agents" : "true") }

  Box {
    fill: true
    if tileAnim {
      Shader { fill: true; fallback: background; uniforms: { zone: zn, speed: speed, cellpx: 0 }; code: tileShot ? tileCur.code ?? code : code }
      if tileCur.actors != null { Actors { cw: tileCell; live: true; sc: tileCur } }
    } else if (cur.tile ?? cur.thumb ?? (cur.id == "05-ramen" ? tripCover : null)) != null {
      // 靜態圖裡已經有角色，不再疊一層。cur.tile 是照磚的大小拍的，構圖和播動畫時一樣
      Image { src: cur.tile ?? cur.thumb ?? tripCover; fill: true; fit: cover }
    } else {
      Canvas {
        fill: true
        for k, i in [P.bg, P.c0, P.c1, P.c2] { rect(0, i * height / 4, width, height / 4 + 1, fill: k) }
      }
      if cur.actors != null { Actors { cw: tileCell } }
    }
    if !tileShot {
    if tileClean { Column { fill: true; onTap: { tileClean = false; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") } } }
    Column {
      fill: true
      padding: pad
      gap: 6
      Row {
        gap: 6
        align: top
        if showClock {
          Column {
            weight: 1
            gap: 2
            PixelClock { px: clockPx }
            if rows >= 2 && !tiny { Text { text: dateShort; style: small; bold: true; color: P.fg ?? P.c2; padding: [clockPx, 0] } }
          }
        } else {
          Spacer { weight: 1 }
        }
        if !tiny && pet { Mascot { px: mascotPx; live: tileLive } }
      }
      Spacer { weight: 1 }
      if tiny && pet {
        Row { Spacer { weight: 1 }  Mascot { px: mascotPx; live: tileLive } }
      }
      if busy && !tileClean {
        ProgressPanel { compact: !big }
      } else if !tileClean {
        if doneMsg != "" && !tiny { Chip { label: doneMsg; tint: st.state == "error" ? red : green; lines: 2 } }
        if doneMsg == "" && !tiny && rows >= 3 {
          Row {
            Chip { label: nm; tint: P.ac; width: min(W - pad * 2, len(nm) * (latin ? 9 : 15) + 22) }
            Spacer { weight: 1 }
          }
        }
      }
      if big && !tileClean {
        Row {
          gap: 2
          Box { weight: 1; onTap: { liveAt = now; sel = prevId; run(sound ? "paplay ~/.cache/pixbg/sfx/prev.wav" : "true"); run((list.find(x => x.id == prevId) ?? {}).tile == null ? "~/.local/bin/pixbg tile ${sh(prevId)}" : "true") }; PixelBtn { label: "◀"; tone: P.ac; h: 46; size: 13; pad: 2 } }
          Box { weight: 1; onTap: { liveAt = now; sel = nextId; run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true"); run((list.find(x => x.id == nextId) ?? {}).tile == null ? "~/.local/bin/pixbg tile ${sh(nextId)}" : "true") }; PixelBtn { label: "▶"; tone: P.ac; h: 46; size: 13; pad: 2 } }
          Box { weight: 1; onTap: { liveAt = now; zone = (zone + 1) % 5; run(sound ? "paplay ~/.cache/pixbg/sfx/zone.wav" : "true") }; PixelBtn { label: "${T.zone} ${zone + 1}"; tone: P.ac; h: 46; size: 12; pad: 2 } }
          Box { weight: 1; onTap: { tileClean = true; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true") }; PixelBtn { label: T.tileHide; tone: P.ac; h: 46; size: 12; pad: 2 } }
          Box { weight: 1; onTap: { liveAt = now; openedAt = now; panel = true; screen(); run(probeStale ? "~/.local/bin/pixbg agents" : "true") }; PixelBtn { label: T.gen; tone: P.ac; on: true; h: 46; size: 12; pad: 2 } }
        }
      }
    }
    }
  }

  screen {
    title: ""
    Box {
      fill: true
      if exporting && exp.cards != null {
        // pixbg thumbs：一次畫出最多 6 個場景（2×3 格，各用自己的縮圖配色），切成場景卡片的縮圖，不用一個一個拍。
        // 每格就是卡片的比例（360:259），場景照卡片的形狀排版，主角不會被裁掉
        Column {
          fill: width
          for r in range(3) {
            Row {
              height: (screenWidth ?? 400) / 2 * 259 / 360
              fill: width
              for i in range(2) {
                let x = list.find(s => s.id == (exp.cards[r * 2 + i] ?? ""))
                Box {
                  weight: 1
                  fill: height
                  if x != null {
                    Shader { fill: true; fallback: background; uniforms: { zone: x.zone ?? zn, speed: speed, cellpx: 0 }; code: x.code }
                    if x.actors != null { Actors { cw: screenCell / 2; live: true; sc: x; z: x.zone ?? zn } }
                  }
                }
              }
            }
          }
        }
      } else {
      Shader { fill: true; fallback: background; uniforms: { zone: zn, speed: speed, cellpx: bleedCell }; code: code; scale: bk; offset: bleedOff }
      if cur.actors != null { Actors { cw: screenCell; live: true; scale: bk; offset: bleedOff } }
      }
      if panel && !exporting {
        if !more {
          // 一打開：場景＋底部目前場景的卡片。卡片放在填滿頁面的欄底部，不用 screenHeight 算位置（它不一定跟著頁面大小更新）
          Column {
            fill: true
            padding: [16, 64, 16, 6]
            if !ready {
              Text { text: setupState == "failed" ? "Couldn't install the local tools (see ~/.cache/pixbg/setup.log). Close and reopen this page to try again." : "Getting the local tools ready for the agent, wallpapers and previews…"; style: small; color: setupState == "failed" ? "#ff6a6a" : soft; maxLines: 3; padding: [16, 0] }
            }
            Spacer { weight: 1 }   // 場景在這裡露出來
            HudCard {}
          }
        } else {
        for k in [openedAt] key k {
        Column {
          fill: true
          scroll: true
          gap: 14
          padding: [16, 64, 16, 6]

          HudCard {}

          // ---------------------------------------------- Agent 生成動畫（醒目的大卡片）
          Column {
            fill: width; gap: 10; padding: [16, 14]; background: alpha("#0c111a", 0.92); border: 3; radius: 0
            borderColor: busy && st.job == "gen" ? mix(P.ac, "#ffffff", 0.5 + 0.5 * sin(now * 2)) : P.ac
            Text { text: T.aiTitle; style: title; bold: true; color: P.ac }
            Text { text: T.aiDesc; style: small; color: soft; maxLines: 3 }
            Row {
              gap: 8
              for a in [["codex", "Codex"], ["claude", "Claude"]] {
                let ai = (agents.list ?? []).find(x => x.id == a[0]) ?? {}
                let tag = ai.state == "ready" ? T.agentReady : ai.state == "login" ? T.agentLogin : ai.state == "missing" ? T.agentMissing : T.agentUnknown
                Column {
                  weight: 1; gap: 4
                  onTap: { run(busy ? "true" : "~/.local/bin/pixbg agent ${sh(a[0])}") }
                  PixelBtn { label: a[1]; on: agentId == a[0]; dim: busy || ai.ok == false; tone: P.ac; h: 44; size: 14 }
                  // 就緒時顯示模型名（CLI 自己的設定，或上次生成時回報的）；不知道就寫「預設模型」
                  Text { text: ai.ok ? "● ${ai.model != null && ai.model != "" ? ai.model : T.defaultModel}" : tag; font: mono; style: small; color: ai.ok ? good : ai.state == null ? soft : "#ffb04a"; align: center; fill: width; maxLines: 1 }
                }
              }
            }
            if fixCmd != "" {
              Column {
                fill: width; gap: 6; padding: [10, 8]; background: "#0a0e15"; border: 1; radius: 0; borderColor: alpha("#ffb04a", 0.6)
                Text { text: T.runThis; style: small; color: soft; maxLines: 2 }
                Row {
                  gap: 8
                  Text { text: "$ ${fixCmd}"; font: mono; style: small; color: "#ffd84a"; weight: 1; maxLines: 2 }
                  Box { width: 92; onTap: { copy(fixCmd); copiedAt = now; haptic() }; PixelBtn { label: now - copiedAt < 3 ? T.copied : T.copyCmd; tone: "#ffb04a"; h: 38; size: 12; pad: 4 } }
                }
                Box { fill: width; onTap: run("~/.local/bin/pixbg agents"); PixelBtn { label: T.recheck; tone: "#ffb04a"; h: 38; size: 12 } }
              }
            } else {
              Text { text: T.agentHelp; style: small; color: soft; maxLines: 3 }
            }

            Input { fill: width; height: 52; padding: [12, 0]; background: "#0a0e15"; border: 2; radius: 0; borderColor: alpha(P.ac, 0.7); placeholder: T.hint; text: wish; onChange: wish = value; onSubmit: { wish = value; run(sound && !busy ? "paplay ~/.cache/pixbg/sfx/gen.wav" : "true"); run(trim(value) == "" || busy ? "true" : "~/.local/bin/pixbg gen ${sh(trim(value))}") } }
            Text { text: T.ideas; font: mono; style: small; color: soft }
            Flow {
              gap: 6
              for idea in LP.ideas ?? [] {
                Text { text: idea; style: small; color: "#eef3fa"; background: slab; padding: [10, 6]; border: 1; radius: 0; borderColor: alpha(P.ac, 0.4); maxLines: 1; width: min((screenWidth ?? 400) - 64, len(idea) * (match(idea, "^[ -~]+$") != null ? 7.5 : 13.5) + 24); onTap: { wish = idea; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") } }
              }
            }
            Box {
              fill: width
              onTap: { run(sound && trim(wish) != "" && !busy ? "paplay ~/.cache/pixbg/sfx/gen.wav" : "true"); run(trim(wish) == "" || busy ? "true" : "~/.local/bin/pixbg gen ${sh(trim(wish))}") }
              PixelBtn { label: busy && st.job == "gen" ? "${T.generating} ${round(pct * 100)}%" : T.genNew; on: !busy; dim: busy; shine: trim(wish) != "" && !busy; tone: P.ac; h: 64; size: 17 }
            }
            if busy && st.job == "gen" {
              PixelMeter { value: pct; tone: P.ac }
              Row {
                Text { text: st.msg; style: small; color: "#eef3fa"; weight: 1; maxLines: 2 }
                Text { text: fmtDuration(elapsed); font: mono; style: small; color: soft; width: 70; align: end }
              }
              Box { fill: width; onTap: run("~/.local/bin/pixbg cancel"); PixelBtn { label: T.cancel; tone: "#ff6a6a"; h: 40; size: 12 } }
            }
            if (stalled && st.job == "gen") || (genErr && fixCmd == "") {
              Row {
                gap: 8
                Text { text: stalled ? T.stalled : "✕ ${st.msg}"; style: small; color: "#ff6a6a"; weight: 1; maxLines: 3 }
                Box { width: 120; onTap: { wish = st.wish ?? wish; run("~/.local/bin/pixbg gen ${sh(st.wish ?? trim(wish))}") }; PixelBtn { label: T.retryGen; tone: P.ac; h: 40; size: 12; pad: 4 } }
              }
            } else if (genErr || (jobErr && st.job == "edit")) && fixCmd != "" {
              Text { text: "✕ ${st.msg}"; style: small; color: "#ff6a6a"; maxLines: 3 }
            }
            if !busy && !genErr && !stalled && st.job == "gen" && doneMsg != "" { Text { text: doneMsg; style: small; color: st.state == "error" ? "#ff6a6a" : good; maxLines: 3 } }
            if cur.kind == "ai" && cur.prompt != null { Text { text: replace(T.thisScene ?? "{p}", "{p}", cur.prompt); style: small; color: soft; maxLines: 2 } }
          }

          // ---------------------------------------------- 場景卡片
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.scenes; tone: P.ac; meta: "${T.builtin} ${len(list.filter(x => x.kind != "ai"))} · Agent ${len(list.filter(x => x.kind == "ai"))}" }
            Grid {
              columns: 2
              gap: 8
              for x in list key x.id {
                Box { onTap: { sel = x.id; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/next.wav" : "true"); run(x.tile == null ? "~/.local/bin/pixbg tile ${sh(x.id)}" : "true") }; SceneCard { x: x; on: x.id == cur.id } }
              }
            }
          }

          // ---------------------------------------------- 配色與速度
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.zone; tone: P.ac; meta: replace(T.setN ?? "{n}", "{n}", "${zone + 1}") }
            Row {
              gap: 8
              height: 54
              for z, i in cur.pal ?? [] {
                Box { weight: 1; fill: height; onTap: { zone = i; run(sound ? "paplay ~/.cache/pixbg/sfx/zone.wav" : "true") }; Swatch { z: z; on: zone == i } }
              }
            }
            HudHead { tag: T.speed; tone: P.ac; meta: speed < 0.75 ? T.drift : speed > 1.5 ? T.boost : T.normal }
            Row {
              gap: 6
              for o in [[0.5, T.slow], [1, T.mid], [2, T.fast]] {
                Box { weight: 1; onTap: { speed = o[0]; run(sound ? "paplay ~/.cache/pixbg/sfx/speed.wav" : "true") }; PixelBtn { label: o[1]; on: speed == o[0]; tone: P.ac; h: 50; size: 14 } }
              }
            }
          }

          // ---------------------------------------------- 桌布與相簿
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.wall; tone: good; meta: "~/Pictures/pixbg" }
            Box {
              fill: width
              onTap: { run(sound && !busy ? "paplay ~/.cache/pixbg/sfx/wall.wav" : "true"); run(busy ? "true" : "~/.local/bin/pixbg wall ${sh(cur.id ?? sel)}") }
              PixelBtn { label: busy && st.job == "wall" ? "${T.applying}… ${round(pct * 100)}%" : T.freeze; on: !busy; dim: busy; shine: !busy; tone: good; h: 60; size: 16 }
            }
            if busy && st.job == "wall" {
              PixelMeter { value: pct; tone: good }
              Text { text: st.msg; style: small; color: "#eef3fa" }
            }
            if len(walls ?? []) > 0 {
              Text { text: replace(T.albumN ?? "{n}", "{n}", "${len(walls)}"); style: small; color: soft }
              Grid {
                columns: 4
                gap: 6
                for w in (walls ?? []).take(12) key w.file {
                  Column {
                    gap: 2
                    onTap: { run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true"); run("~/.local/bin/pixbg setwall ${sh(w.file)}") }
                    Image { src: w.thumb; height: 130; fill: width; fit: cover; border: 3; radius: 0; borderColor: w.active ? good : ink }
                    Text { text: w.active ? T.inUse : w.label; font: mono; style: small; color: w.active ? good : soft; align: center; maxLines: 1 }
                  }
                }
              }
            }
          }

          // ---------------------------------------------- 開關（兩欄，字才放得下）
          Grid {
            columns: 2
            gap: 6
            Box { onTap: { showClock = !showClock; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: showClock ? T.clockOn : T.clockOff; on: showClock; tone: P.ac; h: 54; size: 15 } }
            Box { onTap: { sound = !sound; run(!sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: sound ? T.sfxOn : T.sfxOff; on: sound; tone: P.ac; h: 54; size: 15 } }
            Box { onTap: { pet = !pet; haptic(); run(sound ? (mascot == "ufo" ? "paplay ~/.cache/pixbg/sfx/beam.wav" : "paplay ~/.cache/pixbg/sfx/boing.wav") : "true") }; PixelBtn { label: pet ? T.petOn : T.petOff; on: pet; tone: P.ac; h: 54; size: 15 } }
          }
          // 主畫面的磚：靜態縮圖（預設，省電）或一直播動畫
          Box { fill: width; onTap: { tileLive = !tileLive; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: tileLive ? T.tileLiveOn : T.tileLiveOff; on: tileLive; tone: P.ac; h: 54; size: 15 } }
          Text { text: tileLive ? T.tileLiveOnHelp : T.tileLiveOffHelp; style: small; color: soft; maxLines: 3; padding: [4, 0] }

          // ---------------------------------------------- 語言（最下面）
          Column {
            fill: width; gap: 10; padding: [14, 12]; background: glass; border: 2; radius: 0; borderColor: cardEdge
            HudHead { tag: T.language; tone: P.ac; meta: LP.name ?? "" }
            Grid {
              columns: 3
              gap: 6
              for l in ui.langs ?? [] key l.code {
                Box { onTap: { langCode = l.code; langOpen = false; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true"); run("~/.local/bin/pixbg lang ${sh(l.code)}") }; PixelBtn { label: l.name; on: l.code == lc && !langOpen; tone: P.ac; h: 50; size: 13; pad: 4 } }
              }
              Box { onTap: { langOpen = !langOpen; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }; PixelBtn { label: T.custom; on: langOpen; tone: "#ffd84a"; h: 50; size: 13; pad: 4 } }
            }
            if langOpen {
              Text { text: T.customHelp; style: small; color: soft; maxLines: 3 }
              Input { fill: width; height: 46; padding: [10, 0]; background: "#0a0e15"; border: 2; radius: 0; borderColor: alpha("#ffd84a", 0.5); placeholder: T.customHint; text: langWish; onChange: langWish = value }
              Text { text: langPrompt; font: mono; style: small; color: "#cfd8e6"; maxLines: 7; padding: [10, 8]; background: "#0a0e15"; fill: width }
              Row {
                gap: 6
                Box { weight: 2; onTap: { copy(langPrompt); copiedAt = now; haptic(); run(sound ? "paplay ~/.cache/pixbg/sfx/done.wav" : "true") }; PixelBtn { label: now - copiedAt < 3 ? T.copied : T.copyPrompt; on: true; shine: now - copiedAt >= 3; tone: "#ffd84a"; h: 54; size: 14 } }
                Box { weight: 1; onTap: share(langPrompt); PixelBtn { label: T.share; tone: "#ffd84a"; h: 54; size: 14 } }
              }
            }
          }
          Spacer { height: 40 }
        }
        }
        }
        // 滿版的背景蓋住了啟動器的 ✕，自己放一顆像素關閉鈕在右上角
        Row {
          fill: width
          padding: 0
          Spacer { weight: 1 }
          Box { width: 60; height: 52; onTap: { run(sound ? "paplay ~/.cache/pixbg/sfx/hide.wav" : "true"); close() }; PixelBtn { label: "✕"; tone: "#ff6a6a"; h: 52; size: 20; pad: 0 } }
        }
      } else {
        if !exporting {
          // 隱藏介面時只剩場景（連 ✕ 也收起）：點畫面任何地方叫回介面；剛隱藏的幾秒底部有提示；返回鍵照樣能關
          Column {
            fill: true
            onTap: { panel = true; run(sound ? "paplay ~/.cache/pixbg/sfx/tap.wav" : "true") }
            Spacer { weight: 1 }
            if now - hiddenAt < 5 {
              Row { Spacer { weight: 1 }  Text { text: T.tapToShow; style: small; color: "#eef3fa"; background: alpha("#0c111a", 0.8); padding: [12, 6]; width: len(T.tapToShow ?? "") * (latin ? 7.5 : 14) + 28 }  Spacer { weight: 1 } }
              Spacer { height: 48 }
            }
          }
        }
      }
    }
  }
}
// pixbg-frame: 1792322951330
