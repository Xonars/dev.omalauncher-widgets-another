widget "TRIP VIEW" {
  meta { owl: 7; description: "Animated pixel scene templates for your home screen. Describe a mood in one sentence and your agent generates an animated scene, which you can also set as your wallpaper."; version: "1.1"; license: "MIT"; category: "fun" }
  size: 4x2
  minSize: 2x2
  padding: 0
  requires { pacman: ["python", "python-pillow", "glslang", "libpulse", "bash", "coreutils"] }

  // ~/.local/bin/pixbg 把通過本機檢查（編譯、AGSL 規則、GPU 運算量）的場景打包進 bundle.json。
  // 切換場景、語言都只改這裡的狀態，不跑程式，按下去馬上換；生成、刪除、設為桌布才交給 pixbg，
  // 它做完用 owl-send 設定 sel／langCode。
  source bundle = file("~/.cache/pixbg/bundle.json") json
  source ui = file("~/.cache/pixbg/ui.json") json
  asset tripCover = base64""
  let tripBuiltin = parseJson("""{"header":"// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\n// ── pixbg 共用標頭（由 pixbg 自動加在每個場景前面）──\n// size（像素）與 time（秒）由啟動器提供。\nuniform float zone;   // 配色組 0..4\nuniform float speed;  // 動畫速度倍率，1 為正常\nuniform float cellpx; // 全螢幕頁滿版時由小工具給：放大後剛好是整數像素的格子大小；0 表示自己算\n// 一個「像素格」在螢幕上的大小：邏輯寬約 216 格，取整數倍，邊緣不會糊\nfloat PX() { return cellpx > 0.0 ? cellpx : max(2.0, floor(size.x / 216.0)); }\n// 不用 sin 的雜湊（Dave Hoskins）：比 sin 版便宜，在手機 GPU 上也不會因精度出現條紋\nfloat hash1(float n) { n = fract(n * 0.1031); n *= n + 33.33; n *= n + n; return fract(n); }\nfloat hash2(float2 p) { float3 q = fract(float3(p.xyx) * 0.1031); q += dot(q, q.yzx + 33.33); return fract((q.x + q.y) * q.z); }\nfloat hash3(float3 p) { p = fract(p * 0.1031); p += dot(p, p.zyx + 31.32); return fract((p.x + p.y) * p.z); }\n// 2×2 Bayer 抖色（和 UFOPUMP 同一套順序）\nfloat bayer2(float2 c) {\n  float i = mod(c.x, 2.0) + 2.0 * mod(c.y, 2.0);\n  return i < 0.5 ? 0.0 : i < 1.5 ? 0.5 : i < 2.5 ? 0.75 : 0.25;\n}\n// 0..1 量化成 n 個色階，交界抖色\nfloat band(float q, float2 c, float n) { return clamp(floor(q * n + bayer2(c)), 0.0, n - 1.0) / (n - 1.0); }\n// 抖色的透明度：a 越大，格子越密\nbool dith(float a, float2 c) { return a > bayer2(c) + 0.125; }\nhalf3 hx(float v) { return half3(floor(v / 65536.0), mod(floor(v / 256.0), 256.0), mod(v, 256.0)) / 255.0; }\nhalf3 ramp(half3 a, half3 b, half3 c, float q) { return q < 0.5 ? mix(a, b, q * 2.0) : mix(b, c, q * 2.0 - 1.0); }\n// 線段距離（畫逐格的線）\nfloat segd(float2 p, float2 a, float2 b) {\n  float2 pa = p - a, ba = b - a;\n  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);\n  return length(pa - ba * h);\n}\n// ── 場景 ──\n","lang":{"T":{"agent":"Agent","agentHelp":"Under each button is the model that CLI will use, from its own settings. Claude reports progress line by line; Codex reports steps.","agentLogin":"○ Sign in","agentMissing":"○ Not installed","agentReady":"● Ready","agentUnknown":"… Checking","aiDesc":"Enter your city, or the weather and your mood.\nLet your Agent turn this moment into pixel animation.","aiGen":"Agent animation","aiTitle":"✦ Agent · New animation","albumN":"Album: tap one to use it ({n} pics)","applying":"Applying","boost":"boosted","builtin":"Built-in","cancel":"✕ Cancel","clockOff":"Clock off","clockOn":"Clock on","collapse":"Close","copied":"✓ Copied","copyCmd":"Copy","copyPrompt":"Copy prompt","custom":"＋ Custom","customHelp":"Copy this prompt to your agent (Claude Code, Codex…). It makes a language pack, which then shows up above.","customHint":"Language to add, e.g. 日本語","defaultModel":"Default model","delAsk":"Delete “{n}”?","delScene":"✕ Delete scene","delWarn":"Only this agent-made scene and its preview are removed; built-in scenes and the wallpaper album stay. This can't be undone.","delYes":"Delete","drift":"drifting","editAsk":"How should “{n}” change?","editGo":"✦ Apply change","editHint":"e.g. heavier rain, add a moon","editNote":"The agent changes only what you ask, and it goes in only after the local check passes. The old version is kept.","editScene":"✎ Edit scene","editingScene":"Agent edit","fast":"Fast","freeze":"Freeze this moment as wallpaper","gen":"✦ New","genNew":"✦ Agent · New animation","generating":"Agent generating…","hide":"Hide UI","hint":"e.g. Taipei, rainy, feeling calm","ideas":"Try an idea","inUse":"● In use","keep":"Keep","language":"Language","manage":"⋯ Manage this scene","mid":"Normal","next":"Next ▶","noThumb":"Making preview","normal":"normal","oneLine":"one sentence, one scene","petOff":"Pet off","petOn":"Pet on","playing":"▶ Playing","prev":"◀ Prev","recheck":"↻ Check again","retryGen":"↻ Try again","runThis":"Run this in your terminal, then tap Check again:","scene":"Scene","scenes":"Scenes","scrollHint":"▼ More","setN":"Set {n}","setWall":"Set wallpaper","sfxOff":"Sound off","sfxOn":"Sound on","share":"Share","slow":"Slow","speed":"Speed","stalled":"Generation seems to have stopped (the agent isn't responding).","tag_ai":"Agent","tag_original":"Original","tag_travel":"Travel","tag_ufopump":"UFOPUMP","tapToShow":"Tap anywhere to show the controls","thisScene":"This scene: “{p}”","tileHide":"Hide","tileLiveOff":"Home tile: still","tileLiveOffHelp":"The home screen shows the scene's preview and plays for a few seconds after you tap it. Saves battery.","tileLiveOn":"Home tile: animated","tileLiveOnHelp":"The home screen animates all the time. Uses more battery.","wall":"Wallpaper","zone":"Palette"},"ideas":["Glowing fairies in a moonlit forest","Spaceport beneath Saturn’s rings","Glaciers and whales under auroras","Steam airship over desert ruins"],"msg":{"agentFailed":"{agent} failed: ","already":"Already generating","busyAgent":"{agent} is out of quota or busy{when}. Try the other agent.","cancelled":"Cancelled","checking":"Checking locally (compile, GPU cost)…","connecting":"Checking {agent}…","deleted":"Deleted “{name}”","done":"Done: {name} ({secs})","edited":"Edited: {name} ({secs})","failed3":"Failed the check three times: ","handoff":"Handing it to the agent…","handoffTo":"Handing it to {who}…","mins":"{m}m {s}s","missingAgent":"{agent} isn't installed.","needLogin":"{agent} isn't signed in.","noShader":"{agent} didn't return a shader. Try again.","notPassed":"{name} failed the check, not applied: ","offline":"Can't reach {agent}. Check the network.","retry":"Attempt {n} failed the check, asking the agent to fix: ","secs":"{s}s","stalled":"{agent} didn't respond for {s}s, stopped.","switched":"{a} isn't available, using {b}","thinking":"{who} is planning: {wish}","thumbing":"Making the scene card preview…","tryAt":", try again at {t}","wallCrop":"Cropping and saving the wallpaper…","wallDone":"Wallpaper set, and saved to ~/Pictures/pixbg","wallDraw":"Asking the phone to draw the full screen…","wallFail":"Wallpaper failed: ","wallMeasure":"First time: measuring the full-screen frame…","wallPrep":"Getting ready to freeze the frame…","wallSwitched":"Wallpaper switched","writing":"{who} is writing line {n} {part}"},"name":"English","names":"en","wd":["Sun","Mon","Tue","Wed","Thu","Fri","Sat"]},"scenes":[{"actors":null,"body":"// name: NEON RAMEN 霓虹拉麵\n// mascot: car\n// tag: original\n// thumb: 2\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nvoid palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac) {\nif (z < 0.5)      { bg = hx(0x070a24); c0 = hx(0x1a1f4a); c1 = hx(0x3a5fb0); c2 = hx(0xff4fa8); ac = hx(0xff3a2a); }\nelse if (z < 1.5) { bg = hx(0x140726); c0 = hx(0x34145a); c1 = hx(0x7a3cc8); c2 = hx(0x5ff0ff); ac = hx(0xff5a8a); }\nelse if (z < 2.5) { bg = hx(0x03161a); c0 = hx(0x0c3a3e); c1 = hx(0x1f8f86); c2 = hx(0xb6ff5a); ac = hx(0xff8a2a); }\nelse if (z < 3.5) { bg = hx(0x1e0610); c0 = hx(0x4a0f22); c1 = hx(0xa0304a); c2 = hx(0xffd84a); ac = hx(0x5ff0ff); }\nelse              { bg = hx(0x040208); c0 = hx(0x16122a); c1 = hx(0x3c3a6a); c2 = hx(0x00e0ff); ac = hx(0xff2fd0); }\n}\nbool glyph(float2 g, float w, float h, float seed) {\nif (g.x < 0.0 || g.y < 0.0 || g.x > w || g.y > h) return false;\nfloat mx = floor(w * 0.5);\nfloat my = floor(h * 0.5);\nif (abs(g.y) < 0.5 && hash1(seed + 1.0) < 0.7) return true;\nif (abs(g.y - my) < 0.5 && hash1(seed + 2.0) < 0.6) return true;\nif (abs(g.y - h) < 0.5 && hash1(seed + 3.0) < 0.7) return true;\nif (abs(g.x) < 0.5 && hash1(seed + 4.0) < 0.5) return true;\nif (abs(g.x - mx) < 0.5 && hash1(seed + 5.0) < 0.8) return true;\nif (abs(g.x - w) < 0.5 && hash1(seed + 6.0) < 0.5) return true;\nreturn false;\n}\nfloat vsign(float2 c, float2 o, float n, float seed) {\nfloat2 l = c - o;\nfloat h = n * 11.0 + 2.0;\nif (l.x < 0.0 || l.x > 8.0 || l.y < 0.0 || l.y > h) return 0.0;\nif (l.x < 0.5 || l.x > 7.5 || l.y < 0.5 || l.y > h - 0.5) return 3.0;\nfloat gi = floor((l.y - 2.0) / 11.0);\nfloat2 g = float2(l.x - 2.0, l.y - 2.0 - gi * 11.0);\nreturn glyph(g, 4.0, 8.0, seed + gi * 17.0) ? 2.0 : 1.0;\n}\nfloat rain(float2 c, float t, float v, float density, float len, float seed) {\nfloat x = c.x + floor(c.y * 0.25);\nif (hash2(float2(x, seed)) > density) return 0.0;\nfloat P = 60.0 + floor(hash2(float2(x, seed + 1.0)) * 80.0);\nfloat ph = mod(c.y - t * v + hash2(float2(x, seed + 2.0)) * P, P);\nreturn ph < len ? (ph + 1.0) / len : 0.0;\n}\nhalf4 stallGlow(float2 m, float W, float glitch, float sw, half3 c2, half3 ac, half3 warm) {\nif (abs(m.x) <= 34.0 && m.y >= -92.0 && m.y <= -74.0) return half4(c2 * (glitch > 0.5 ? 0.6 : 1.0), 1.0);\nfloat side = m.x < 0.0 ? -1.0 : 1.0;\nfloat2 le = (m - float2(side * 67.0 + sw, -50.0)) / float2(5.5, 7.5);\nif (dot(le, le) < 1.0) return half4(ac, 1.0);\nif (abs(m.x) < W - 1.0 && m.y >= -66.0 && m.y < -50.0) return half4((mod(floor((m.x + W - 2.0) / 22.0), 2.0) < 1.0 ? half3(0.541, 0.235, 1.0) : half3(0.243, 0.878, 0.478)) * 0.8, 0.6);\nif (abs(m.x) < W - 1.0 && m.y >= -50.0 && m.y < -26.0) return half4(warm, 0.85);\nreturn half4(0.0);\n}\nhalf4 main(float2 p) {\nfloat s = PX();\nfloat2 c = floor(p / s);\nfloat2 G = floor(size / s);\nfloat t = time * max(speed, 0.0);\nhalf3 bg; half3 c0; half3 c1; half3 c2; half3 ac;\npalette(zone, bg, c0, c1, c2, ac);\nhalf3 warm = hx(0xffc46a);\nhalf3 white = half3(1.0);\nfloat gy = floor(G.y * 0.78);\nfloat cx = floor(G.x * 0.5);\nfloat W = 57.0;\nfloat2 d = c - float2(cx, gy);\nfloat fp = floor(t / 5.0);\nfloat fu = t - fp * 5.0;\nfloat glitch = (hash1(fp + 11.0) < 0.55 && fu > 2.0 && fu < 2.35) ? 1.0 : 0.0;\nfloat sw = floor(sin(t * 1.1) * 1.5 + 0.5);\nfloat sy = clamp(c.y / gy, 0.0, 1.0);\nhalf3 col = ramp(bg, mix(bg, c0, 0.7), mix(c0, c1, 0.45), band(sy * sy, c, 5.0));\nfloat lp = floor(t / 11.0);\nfloat lu = t - lp * 11.0;\nfloat flash = hash1(lp + 70.0) < 0.6 && (abs(lu - 4.0) < 0.06 || abs(lu - 4.35) < 0.05) ? 1.0 : 0.0;\nif (flash > 0.5 && c.y < gy * 0.7) col = mix(col, mix(c1, white, 0.5), 0.45 * (1.0 - c.y / (gy * 0.7)));\nif (c.y < gy * 0.6) {\nfloat2 q = floor(c / 4.0);\nfloat cl = sin(q.x * 0.19 + t * 0.12 + sin(q.y * 0.45 + t * 0.05) * 1.6) + sin(q.x * 0.07 - t * 0.08 + q.y * 0.33);\nfloat ca = (cl - 0.6) * 0.5 * (1.0 - c.y / (gy * 0.6));\nif (dith(ca, c)) col = mix(col, flash > 0.5 ? mix(c1, white, 0.6) : mix(c0, c1, 0.3), 0.55);\n}\nfloat tx = floor(G.x * 0.68);\nfloat ty = floor(gy * 0.2);\nhalf3 farc = mix(c0, c1, 0.15);\nfloat tw = 1.0 + (c.y - ty) * 0.035;\nif (c.y > ty && abs(c.x - tx) <= tw) col = farc;\nif (c.y > ty - 10.0 && c.y <= ty && abs(c.x - tx) < 0.5) col = farc;\nfloat deck = floor(ty + (gy - ty) * 0.22);\nif (abs(c.y - deck) < 1.5 && abs(c.x - tx) <= 6.0) col = abs(c.y - deck) < 0.5 && mod(c.x, 2.0) < 1.0 ? mix(c1, c2, 0.3) : farc;\nif (abs(c.x - tx) < 0.5 && abs(c.y - (ty - 10.0)) < 0.5 && sin(t * 3.14) > 0.3) col = ac;\nfloat wu = c.x / G.x * 2.0 - 1.0;\nfloat w1 = floor(gy * 0.24 + 9.0 * (1.0 - wu * wu));\nfloat w2 = floor(gy * 0.29 + 6.0 * (1.0 - wu * wu) + wu * 5.0);\nif (abs(c.y - w1) < 0.5 || abs(c.y - w2) < 0.5) col = col * 0.5;\nif (abs(c.y - w1 - 1.0) < 0.5 && abs(c.x - floor(mod(t * 9.0, G.x + 60.0) - 30.0)) < 0.5) col = c2;\nif (abs(c.y - w2 - 1.0) < 0.5 && abs(c.x - floor(G.x + 30.0 - mod(t * 7.0, G.x + 60.0))) < 0.5) col = c2;\nfloat fb = floor(c.x / 10.0);\nfloat fh = gy - floor(gy * (0.22 + 0.3 * hash1(fb * 1.7 + 3.0)));\nif (c.y >= fh) {\ncol = farc;\nfloat fl = c.x - fb * 10.0;\nif (fl > 0.5 && fl < 8.5 && mod(c.x, 3.0) < 1.0 && abs(mod(c.y - fh, 4.0) - 2.0) < 0.5 && hash2(c * 0.71 + 3.0) < 0.14) col = mix(col, c1, 0.7);\n}\nfloat vb = floor((c.x + 4.0) / 6.0);\nif (c.y >= gy - floor(gy * (0.12 + 0.12 * hash1(vb * 2.3))) && c.y < fh) col = mix(col, farc, 0.5);\nfloat ry = floor(gy * 0.66);\nif (abs(c.y - ry) < 0.6) col = mix(farc, bg, 0.3);\nif (c.y > ry && mod(c.x, 30.0) < 1.5) col = mix(farc, bg, 0.3);\nfloat trx = G.x + 40.0 - mod(t * 16.0, G.x + 160.0);\nfloat tl = c.x - trx;\nif (tl > 0.0 && tl < 84.0 && c.y >= ry - 5.0 && c.y < ry) {\ncol = mod(tl, 21.0) < 1.0 ? bg : mix(c0, c1, 0.5);\nif (c.y >= ry - 4.0 && c.y < ry - 2.0 && mod(tl, 21.0) > 2.0 && mod(tl, 4.0) < 2.5) col = warm;\nif (tl < 2.0 && c.y == ry - 3.0) col = white;\n}\nfloat fr = rain(c, t, 85.0, 0.16, 5.0, 3.0);\nif (fr > 0.0) col = mix(col, c1, 0.1 + 0.35 * fr);\nfloat nx = c.x + 7.0;\nfloat nb = floor(nx / 26.0);\nfloat bl = nx - nb * 26.0;\nfloat nh = gy - floor(gy * (0.1 + 0.38 * hash1(nb * 3.1 + 9.0)));\nif (bl > 1.5 && c.y >= nh) {\nfloat tone = hash1(nb * 5.3 + 1.0);\ncol = mix(bg, c0, 0.45 + 0.2 * tone);\nif (tone > 0.6 && mod(c.x + c.y, 2.0) < 1.0 && mod(c.y, 3.0) < 1.0) col = mix(col, c0, 0.25);\nif (bl < 3.5) col = mix(col, c1, 0.25);\nif (bl > 24.5) col = col * 0.8;\nif (c.y < nh + 2.0) col = mix(col, c1, c.y < nh + 1.0 ? 0.4 : 0.15);\nfloat wy = c.y - nh - 3.0;\nfloat ix = floor((bl - 5.0) / 5.0);\nfloat iy = floor(wy / 6.0);\nfloat mx = bl - 5.0 - ix * 5.0;\nfloat my = wy - iy * 6.0;\nif (bl >= 5.0 && bl < 23.0 && wy >= 0.0 && mx < 3.0 && my < 3.0) {\nfloat2 id = float2(ix + nb * 7.0, iy);\nfloat per = 7.0 + hash2(id + 4.0) * 9.0;\nfloat on = hash3(float3(id, floor(t / per + hash2(id))));\nif (on < 0.32) {\ncol = hash2(id + 7.0) < 0.5 ? warm * 0.75 : mix(c1, c2, 0.3);\nif (my > 1.5) col = col * 0.75;\nif (my < 1.0 && hash2(id + 5.0) < 0.3) col = mix(bg, c0, 0.7);\n} else {\ncol = mix(bg, c0, 0.8);\nif (my < 1.0) col = col * 0.85;\n}\n}\nif (bl >= 5.0 && bl < 23.0 && wy >= 0.0 && mx < 3.0 && my > 2.5 && my < 3.5) col = mix(col, c1, 0.3);\nif (wy >= 0.0 && my > 4.5 && my < 5.5) col = mix(col, c1, 0.1);\nfloat sy = gy - c.y;\nif (sy > 0.0 && sy <= 7.0 && bl >= 4.0 && bl < 24.0) {\nbool shop = hash1(nb + 2.9) < 0.6;\ncol = shop ? mix(warm * 0.35, warm * 0.7, band(1.0 - sy / 7.0, c, 3.0)) : (mod(c.y, 2.0) < 1.0 ? mix(bg, c0, 0.75) : mix(bg, c0, 0.5));\nif (shop && mod(bl, 6.0) < 1.0) col = mix(bg, c0, 0.6);\nif (sy > 6.0) col = shop ? mix(ac, c0, 0.4) : mix(c0, c1, 0.4);\n}\nif (bl >= 21.0 && bl < 24.0 && wy >= 0.0 && my >= 3.0 && my < 5.0 && hash2(float2(nb, iy) + 11.0) < 0.5) col = my < 4.0 ? mix(c0, c1, 0.5) : mix(bg, c0, 0.3);\nif (hash1(nb + 0.3) < 0.4 && bl >= 5.0 && bl < 23.0 && wy > 0.0) {\nif (my == 5.0) col = mix(c0, c1, 0.45);\nif (abs((bl - 5.0) - mod(wy, 6.0) * 3.0) < 0.6 && my < 5.0) col = mix(c0, c1, 0.35);\n}\n}\nif (bl > 1.5) {\nfloat rt = c.y - nh;\nfloat wt = hash1(nb + 0.7);\nif (wt < 0.45 && bl > 15.0 && bl < 22.0 && rt < 0.0 && rt >= -8.0) col = rt < -3.0 ? (mod(bl, 2.0) < 1.0 ? mix(c0, warm, 0.15) : mix(bg, c0, 0.7)) : (abs(bl - 16.0) < 0.6 || abs(bl - 21.0) < 0.6 ? mix(bg, c0, 0.7) : col);\nif (wt >= 0.45 && wt < 0.8 && abs(bl - 8.0) < 0.6 && rt < 0.0 && rt > -12.0) col = mix(bg, c0, 0.8);\nif (wt >= 0.45 && wt < 0.8 && abs(bl - 8.0) < 0.6 && abs(rt + 12.0) < 0.6 && mod(t + nb * 0.37, 1.6) < 0.6) col = ac;\n}\nfloat lbx = floor(G.x * 0.3);\nfloat lby = floor(gy * 0.52);\nfloat2 ll = c - float2(lbx, lby);\nif (ll.x >= 0.0 && ll.x < 34.0 && ll.y >= 0.0 && ll.y < 9.0) {\ncol = mix(bg, c0, 0.25);\nfloat2 lg = float2(ll.x - 2.0 + floor(t * 10.0), ll.y - 1.0);\nfloat li = floor(lg.x / 6.0);\nfloat2 lgl = float2(lg.x - li * 6.0, lg.y);\nif (ll.x > 1.0 && ll.x < 32.0 && ll.y > 0.0 && ll.y < 8.0 && lgl.x < 5.0 && lgl.y < 6.0 && hash2(float2(li, lgl.x * 7.0 + lgl.y)) < 0.42) col = mix(c2, white, 0.2);\nif (ll.y < 1.0 || ll.y > 7.0) col = mix(c0, c1, 0.4);\n}\nfloat2 o1 = float2(floor(G.x * 0.07), floor(gy * 0.40));\nfloat2 o2 = float2(floor(G.x * 0.86), floor(gy * 0.30));\nfloat pu1 = sin(t * 0.9) > -0.5 ? 1.0 : 0.45;\nfloat pu2 = sin(t * 0.7 + 2.0) > -0.6 ? 1.0 : 0.45;\nfloat2 e1 = max(abs(c - o1 - float2(4.0, 23.0)) - float2(4.0, 23.0), 0.0);\nfloat2 e2 = max(abs(c - o2 - float2(4.0, 17.5)) - float2(4.0, 17.5), 0.0);\nfloat h1 = max(e1.x, e1.y);\nfloat h2 = max(e2.x, e2.y);\nif (h1 > 0.0 && h1 < 5.0 && dith(0.4 * (1.0 - h1 / 5.0) * pu1, c)) col = mix(col, ac, 0.35);\nif (h2 > 0.0 && h2 < 5.0 && dith(0.4 * (1.0 - h2 / 5.0) * pu2, c)) col = mix(col, c2, 0.35);\nhalf3 board = mix(bg, c0, 0.3) * 0.8;\nfloat v1 = vsign(c, o1, 4.0, 5.0);\nif (v1 > 0.5) col = v1 > 2.5 ? mix(board, ac, 0.6 * pu1) : v1 > 1.5 ? mix(board, mix(ac, white, 0.3), pu1) : board;\nfloat v2 = vsign(c, o2, 3.0, 9.0);\nif (v2 > 0.5) col = v2 > 2.5 ? mix(board, c2, 0.6 * pu2) : v2 > 1.5 ? mix(board, mix(c2, white, 0.3), pu2) : board;\nfloat fz = (c.y - (gy - 26.0)) / 26.0;\nif (fz > 0.0 && c.y < gy) {\nfloat fa = fz * (0.45 + 0.25 * sin(c.x * 0.07 + t * 0.4 + floor(c.y / 3.0)));\nif (dith(fa, c)) col = mix(col, c1, 0.3);\n}\nif (c.y >= gy) {\nfloat gd = (c.y - gy) / max(G.y - gy, 1.0);\ncol = ramp(mix(c0, c1, 0.35), mix(bg, c0, 0.6), bg, band(gd, c, 4.0));\nif (c.y < gy + 1.0) col = mix(c0, c1, 0.6);\nfloat2 pc = floor(float2(c.x / 36.0, (c.y - gy) / 12.0));\nfloat2 pctr = float2(pc.x * 36.0 + 18.0 + (hash2(pc) - 0.5) * 14.0, gy + pc.y * 12.0 + 6.0);\nfloat2 pe = (c - pctr) / float2(8.0 + hash2(pc + 3.0) * 9.0, 3.0 + hash2(pc + 5.0) * 1.5);\nbool pud = dot(pe, pe) < 1.0 && hash2(pc + 9.0) < 0.7;\nif (pud) col = mix(col, bg, 0.5);\nfloat rip = floor(sin(c.y * 0.9 + t * 1.6) * (pud ? 1.6 : 0.8) + 0.5);\nhalf4 e = stallGlow(float2(d.x + rip, -d.y), W, glitch, sw, c2, ac, warm);\nfloat fade = (pud ? 0.75 : 0.35) * (1.0 - clamp(d.y / 110.0, 0.0, 1.0));\nif (!pud && mod(c.y, 2.0) > 0.5) fade = fade * 0.5;\nif (e.a > 0.0 && dith(fade * e.a, c)) col = mix(col, e.rgb, pud ? 0.7 : 0.5);\nfloat wa = (1.0 - d.y / 16.0) * 0.5 * clamp((W + 8.0 - abs(d.x)) / 14.0, 0.0, 1.0);\nif (dith(wa, c)) col = mix(col, warm, 0.25);\nif (pud) {\nfloat2 rc = floor(float2(c.x / 9.0, (c.y - gy) / 5.0));\nfloat ru = fract(t * 0.7 + hash2(rc + 1.3));\nfloat2 rr = (c - float2(rc.x * 9.0 + 4.0, gy + rc.y * 5.0 + 2.0)) * float2(1.0, 2.0);\nif (hash2(rc + 2.7) < 0.5 && ru < 0.7 && abs(length(rr) - ru * 6.0) < 0.6) col = mix(col, mix(c1, white, 0.3), 0.6 * (1.0 - ru));\n}\n}\nif (abs(d.x) < 80.0 && d.y > -99.0 && d.y < 0.0) {\nhalf3 wood = mix(c0, warm * 0.35, 0.35);\nhalf3 dark = mix(bg, c0, 0.4);\nfloat2 sa = abs(d - float2(0.0, -83.0));\nfloat sdist = max(sa.x - 34.0, sa.y - 9.0);\nif (sdist > 0.0 && sdist < 6.0 && dith(0.42 * (1.0 - sdist / 6.0) * (1.0 - glitch * 0.5), c)) col = mix(col, c2, 0.4);\nif (sdist <= 0.0) {\ncol = mix(bg, c0, 0.35) * 0.7;\nif (abs(sdist + 2.0) < 0.5) col = ac;\nfloat2 bd = d - float2(-21.0, -84.0);\nfloat br = dot(bd, bd);\nif (bd.y >= 0.0 && ((br <= 44.0 && br >= 26.0) || (bd.y < 0.5 && abs(bd.x) <= 7.0))) col = c2;\nif (segd(d, float2(-28.0, -88.0), float2(-17.0, -85.0)) < 0.55 || segd(d, float2(-25.0, -89.0), float2(-14.0, -86.0)) < 0.55) col = c2;\nfor (int i = 0; i < 3; i++) {\nfloat fi = float(i);\nif (glyph(d - float2(-8.0 + fi * 12.0, -88.0), 8.0, 10.0, 31.0 + fi * 7.0)) col = (i == 1 && glitch > 0.5) ? mix(c2, bg, 0.7) : mix(c2, white, 0.25);\n}\n}\nif (d.y > -74.5 && d.y < -71.5 && abs(abs(d.x) - 22.0) < 1.0) col = dark;\nif (abs(d.x) < W - 1.0 && d.y >= -66.0 && d.y < -26.0) {\ncol = ramp(warm * 0.25, warm * 0.6, warm, band((d.y + 66.0) / 40.0, c, 5.0));\nif (abs(d.y + 44.0) < 0.5) col = wood * 0.7;\nif (d.y >= -47.0 && d.y < -44.0 && mod(d.x + 3.0, 7.0) < 4.0 && abs(d.x) < W - 6.0) col = mix(white, warm, 0.4);\n}\nif (abs(abs(d.x) - (W - 1.0)) < 1.5 && d.y >= -66.0 && d.y < -23.0) col = wood;\nif (abs(d.x) <= W - 2.0 && d.y >= -66.0) {\nfloat pn = floor((d.x + W - 2.0) / 22.0);\nfloat pl = d.x + W - 2.0 - pn * 22.0;\nfloat bot = -50.0 + floor(sin(t * 1.2 + pn * 1.3) * 1.5 * pl / 22.0 + 0.5);\nif (d.y < bot && pl > 0.5) {\nbool purple = mod(pn, 2.0) < 1.0;\nhalf3 nc = purple ? half3(0.541, 0.235, 1.0) : half3(0.243, 0.878, 0.478);\ncol = mix(nc * 0.35, nc, band((d.y + 66.0) / 16.0, c, 4.0));\nfloat2 nd = float2(pl - 11.0, d.y + 58.0);\nfloat nr = dot(nd, nd);\nif (nr <= 16.0 && nr >= 7.0) col = mix(white, purple ? half3(0.243, 0.878, 0.478) : half3(0.541, 0.235, 1.0), 0.25);\n}\n}\nif (d.y >= -72.0 && d.y < -66.0 && abs(d.x) <= W + 4.0 + (d.y + 72.0)) col = d.y < -71.0 ? mix(c1, c2, 0.25) : wood * (d.y > -67.5 ? 0.6 : 1.0);\nif (abs(d.x) <= W + 3.0 && d.y >= -26.0 && d.y < -22.0) col = d.y < -25.0 ? mix(warm, white, 0.2) : wood;\nif (abs(d.x) <= W - 1.0 && d.y >= -22.0 && d.y < -1.0) {\ncol = d.y < -20.0 ? wood * 0.8 : wood * 0.55;\nif (mod(d.x + W, 8.0) < 1.0) col = col * 0.7;\nif (d.y >= -18.0 && d.y < -16.0) col = ac * 0.7;\n}\nfloat2 pd = d - float2(30.0, -30.0);\nif (abs(pd.x) <= (pd.y < -3.0 ? 9.0 : 8.0) && pd.y >= -4.0 && pd.y <= 3.0) {\ncol = mix(c1, white, 0.15);\nif (pd.x < -6.0) col = mix(c1, white, 0.6);\nif (pd.x > 5.0) col = c1 * 0.6;\nif (pd.y < -3.0) col = mix(c1, white, 0.45);\n}\nfloat bx = d.x + 36.0 - 14.0 * clamp(floor((d.x + 43.0) / 14.0), 0.0, 1.0);\nfloat by = d.y + 31.0;\nfloat ax = abs(bx);\nif (by >= 0.0 && by <= 4.0 && ax <= 5.0) {\nif (by == 0.0 && ax <= 4.0) {\ncol = half3(0.93, 0.62, 0.32);\nif (bx == -3.0 || bx == -2.0) col = half3(0.96, 0.66, 0.62);\nif (bx == -4.0) col = half3(0.72, 0.38, 0.32);\nif (bx == 0.0) col = white;\nif (bx == 1.0) col = half3(1.0, 0.72, 0.16);\nif (bx == -1.0 || bx == 2.0) col = half3(0.36, 0.82, 0.36);\n}\nif (by == 1.0) col = ax == 5.0 ? white * 0.75 : white * 0.95;\nif (by == 2.0 && ax <= 5.0) col = (bx == -3.0 || bx == 0.0 || bx == 3.0) ? white : ac * 0.9;\nif (by == 3.0 && ax <= 4.0) col = ax == 4.0 ? white * 0.6 : white * 0.82;\nif (by == 4.0 && ax <= 2.0) col = white * 0.55;\n}\nif (bx == 3.0 && by >= -2.0 && by <= 0.0) col = half3(0.07, 0.16, 0.11);\nif (by >= -2.0 && by <= -1.0 && (bx == 2.0 - 2.0 * by || bx == 3.0 - 2.0 * by)) col = half3(0.78, 0.55, 0.3);\nfloat sp = mod(floor(t * 1.5) - by, 3.0);\nif (by >= -5.0 && by <= -2.0 && ((bx == -2.0 && sp < 0.5) || (bx == 0.0 && sp > 0.5 && sp < 1.5))) col = mix(col, white, 0.3);\nfloat2 wd = float2(abs(d.x) - (W - 12.0), d.y + 6.0);\nfloat wr = length(wd);\nif (wr < 5.6) col = (wr > 4.2 || wr < 1.2 || abs(wd.x) < 0.5 || abs(wd.y) < 0.5) ? mix(c0, c1, 0.4) : col * 0.6;\nfloat sc = -34.0 + 24.0 * clamp(floor((d.x + 46.0) / 24.0), 0.0, 2.0);\nfloat sd = d.x - sc;\nif (abs(sd) <= 4.0 && d.y >= -13.0 && d.y < -11.0) col = d.y < -12.5 ? mix(ac, white, 0.3) : ac * 0.7;\nif ((abs(sd) < 0.5 && d.y >= -11.0) || (abs(sd) <= 2.0 && abs(d.y + 4.0) < 0.5)) col = dark;\nfloat side = d.x < 0.0 ? -1.0 : 1.0;\nif (d.y >= -66.0 && d.y < -57.0 && abs(d.x - side * 67.0 - floor(sw * (d.y + 66.0) / 8.0 + 0.5)) < 0.5) col = dark;\nfloat2 ld = d - float2(side * 67.0 + sw, -50.0);\nfloat2 le = ld / float2(5.5, 7.5);\nfloat lr = dot(le, le);\nif (lr >= 1.0 && lr < 2.6 && dith(0.35 * (2.6 - lr) / 1.6, c)) col = mix(col, ac, 0.35);\nif (lr < 1.0) {\ncol = ramp(ac * 0.45, ac, mix(ac, white, 0.55), band(1.0 - lr, c, 4.0));\nif (mod(ld.y, 3.0) < 1.0 && lr > 0.15) col = col * 0.75;\nif (abs(ld.y) > 6.0) col = dark;\n}\nif (abs(ld.x) < 0.5 && ld.y > 7.5 && ld.y < 10.5) col = ac * 0.6;\n}\nif (d.x > -24.0 && d.x < 58.0 && d.y > -128.0 && d.y < -26.0) {\nfloat sa2 = 0.0;\nfor (int i = 0; i < 5; i++) {\nfloat fi = float(i);\nfloat k = t * 0.2 + fi / 5.0;\nfloat u = fract(k);\nfloat sh = hash1(floor(k) * 5.0 + fi);\nfloat2 sp = float2(30.0 + (sh - 0.5) * 8.0 + sin(u * 5.0 + sh * 6.28 + t * 0.5) * (1.0 + u * 5.0) - u * u * 22.0, -34.0 - u * 80.0);\nfloat r = 2.5 + u * 8.0;\nfloat2 dv = d - sp;\nfloat f = 1.0 - dot(dv, dv) / (r * r);\nif (f > 0.0) sa2 += f * min(u * 6.0, 1.0) * (1.0 - u);\n}\nsa2 = min(sa2, 1.0);\nif (dith(sa2 * 1.1, c)) {\nhalf3 st = mix(mix(white, c1, 0.25), warm, clamp((d.y + 50.0) / 20.0, 0.0, 1.0) * 0.5);\ncol = mix(col, st, sa2 > 0.55 ? 0.85 : 0.5);\n}\n}\nif (abs(d.x) < 68.0 && d.y > -66.0 && d.y < 0.0) {\nfloat dc = floor(d.x / 9.0);\nif (abs(d.x - dc * 9.0 - floor(hash1(dc + 40.0) * 8.0)) < 0.5) {\nfloat du = fract(t / (1.6 + hash1(dc + 41.0) * 1.8) + hash1(dc + 42.0));\nfloat dyp = -66.0 + du * du * 75.0;\nif (abs(d.y - dyp) < 1.0 + du * 2.0 && dyp < 0.0) col = mix(col, mix(c1, white, 0.5), 0.8);\n}\n}\nfloat2 ct = d - float2(-40.0, -73.0);\nif (abs(ct.x) < 6.0 && ct.y > -9.0 && ct.y < 1.0) {\nbool catb = (ct.x * ct.x) / 9.0 + ((ct.y + 2.5) * (ct.y + 2.5)) / 9.0 < 1.0;\nbool cath = (ct.x - 1.0) * (ct.x - 1.0) + (ct.y + 6.5) * (ct.y + 6.5) < 4.0;\nbool ears = ct.y < -8.0 && (abs(ct.x - 0.0) < 0.6 || abs(ct.x - 2.0) < 0.6);\nfloat tw2 = floor(abs(mod(t * 1.4, 4.0) - 2.0) * 2.0 - 1.5);\nbool tail = ct.x < -2.0 && ct.x > -6.0 && abs(ct.y - (-1.0 - (ct.x + 2.0) * 0.3 * tw2)) < 0.6;\nif (catb || cath || ears || tail) col = hx(0x0a0a14);\nif (cath && abs(ct.y + 6.5) < 0.6 && abs(ct.x - 2.0) < 0.6 && mod(t, 5.0) < 4.8) col = c2;\n}\nfloat nrn = rain(c, t, 150.0, 0.12, 9.0, 7.0);\nif (nrn > 0.0) {\nfloat tint = clamp(1.0 - length(d - float2(0.0, -83.0)) / 80.0, 0.0, 1.0);\nhalf3 rcol = mix(mix(c1, white, 0.35), c2, band(tint, c, 4.0));\ncol = mix(col, rcol, 0.25 + 0.5 * nrn);\n}\nreturn half4(col, 1.0);\n}\n","en":"NEON RAMEN","id":"05-ramen","kind":"preset","mascot":"car","name":"NEON RAMEN 霓虹拉麵","pal":[{"ac":"#ff3a2a","bg":"#070a24","c0":"#1a1f4a","c1":"#3a5fb0","c2":"#ff4fa8","fg":"#ff4fa8","ink":"#070a24","lite":"#ff4fa8"},{"ac":"#ff5a8a","bg":"#140726","c0":"#34145a","c1":"#7a3cc8","c2":"#5ff0ff","fg":"#5ff0ff","ink":"#140726","lite":"#5ff0ff"},{"ac":"#ff8a2a","bg":"#03161a","c0":"#0c3a3e","c1":"#1f8f86","c2":"#b6ff5a","fg":"#b6ff5a","ink":"#03161a","lite":"#b6ff5a"},{"ac":"#5ff0ff","bg":"#1e0610","c0":"#4a0f22","c1":"#a0304a","c2":"#ffd84a","fg":"#ffd84a","ink":"#1e0610","lite":"#ffd84a"},{"ac":"#ff2fd0","bg":"#040208","c0":"#16122a","c1":"#3c3a6a","c2":"#00e0ff","fg":"#00e0ff","ink":"#040208","lite":"#00e0ff"}],"prompt":null,"tag":"original","thumb":null,"tile":null,"zh":"霓虹拉麵","zone":2},{"actors":null,"body":"// name: VOID SPACE 虛空\n// mascot: ufo\n// tag: ufopump\n// thumb: 1\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nvoid palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac) {\nif (z < 0.5)      { bg = hx(0x000039); c0 = hx(0x0a1f7a); c1 = hx(0x1b4fc0); c2 = hx(0x2fd6e0); ac = hx(0xffe14a); }\nelse if (z < 1.5) { bg = hx(0x1c0a4e); c0 = hx(0x3a1078); c1 = hx(0x8a2be2); c2 = hx(0xff4fd8); ac = hx(0x5ff0ff); }\nelse if (z < 2.5) { bg = hx(0x02262e); c0 = hx(0x0b5d5a); c1 = hx(0x18c9a0); c2 = hx(0xb6ff5a); ac = hx(0xff8fd8); }\nelse if (z < 3.5) { bg = hx(0x2c0616); c0 = hx(0x7a0f2a); c1 = hx(0xff5a1f); c2 = hx(0xffe14a); ac = hx(0x5ff0ff); }\nelse              { bg = hx(0x06010f); c0 = hx(0x2b0a5e); c1 = hx(0x00c8ff); c2 = hx(0xff2fd0); ac = hx(0xb6ff5a); }\n}\nfloat starLayer(float2 c, float density, float seed) {\nfloat h = hash3(float3(c, seed));\nif (h < density) return 1.0 + floor(hash3(float3(c, seed + 7.0)) * 3.0);\nfor (int i = 0; i < 4; i++) {\nfloat2 o = i == 0 ? float2(1.0, 0.0) : i == 1 ? float2(-1.0, 0.0) : i == 2 ? float2(0.0, 1.0) : float2(0.0, -1.0);\nfloat2 n = c + o;\nif (hash3(float3(n, seed)) < density && hash3(float3(n, seed + 3.0)) < 0.18) return 1.0 + floor(hash3(float3(n, seed + 7.0)) * 3.0);\n}\nreturn 0.0;\n}\nhalf4 main(float2 p) {\nfloat s = PX();\nfloat2 c = floor(p / s);\nfloat2 G = floor(size / s);\nfloat t = time * max(speed, 0.0);\nhalf3 bg; half3 c0; half3 c1; half3 c2; half3 ac;\npalette(zone, bg, c0, c1, c2, ac);\nhalf3 col = bg;\nfloat2 q = floor(c / 4.0);\nfloat rows = G.y / 4.0;\nfloat wy = q.y - t * 0.5;\nfloat v = (sin(q.x * 0.13 + t * 0.7) + sin(wy * 0.09 - t * 0.5) + sin((q.x + wy) * 0.07 + t * 0.3)\n+ sin(length(float2(q.x - G.x / 8.0, q.y - rows * 0.4)) * 0.16 - t * 0.9)) / 4.0;\nfloat k = ((v + 1.0) / 2.0 - 0.5) / 0.5;\nif (k > 0.0) {\nfloat b = band(k, q, 5.0);\ncol = mix(col, ramp(c0, c1, c2, b), 0.7 * (0.25 + 0.6 * b));\n}\nfloat far = starLayer(float2(c.x, c.y - floor(t * 2.4)), 0.006, 1.0);\nif (far > 0.0) col = mix(col, far < 1.5 ? hx(0x4a5ab8) : far < 2.5 ? hx(0x6f7fe0) : hx(0x8e9cf0), 0.6);\nfloat near = starLayer(float2(c.x, c.y - floor(t * 4.2)), 0.0016, 2.0);\nif (near > 0.0) col = near < 1.5 ? hx(0x3fe0c8) : near < 2.5 ? hx(0x8fd8ff) : half3(1.0);\nfloat2 cell = floor(c / 24.0);\nfloat2 sp = cell * 24.0 + floor(float2(hash2(cell), hash2(cell + 5.1)) * 22.0) + 1.0;\nfloat ph = sin(t * (0.8 + hash2(cell + 9.0) * 1.6) + hash2(cell) * 6.28);\nif (hash2(cell + 2.0) < 0.5 && ph > 0.0) {\nfloat2 d = abs(c - sp);\nif ((d.x + d.y < 0.5) || (ph > 0.6 && d.x + d.y < 1.5 && (d.x < 0.5 || d.y < 0.5))) col = mix(col, half3(1.0), ph);\n}\nfloat2 mc = float2(floor(G.x * 0.24), floor(G.y * 0.2 + sin(t * 0.4) * 1.5));\nfloat2 md = c - mc;\nfloat mr = 10.0;\nif (dot(md, md) <= mr * mr + mr * 0.8) {\nhalf3 mcol = hx(0xd8dcf0);\nfloat lit = dot(normalize(md + 0.001), normalize(float2(-1.0, -0.6)));\nif (!dith(lit * 0.5 + 0.75, c)) mcol = hx(0x8a90b8);\nif (lit < -0.55) mcol = hx(0x5a6090);\nif (length(md - float2(3.0, -2.0)) < 2.6 || length(md - float2(-3.0, 4.0)) < 1.8 || length(md - float2(5.0, 5.0)) < 1.2) mcol = mcol * 0.82;\ncol = mcol;\n}\nfloat period = 4.0;\nfloat n = floor(t / period);\nfloat ph2 = (t - n * period);\nif (ph2 < 0.8) {\nfloat u = ph2 / 0.8; u = u * u;\nfloat left = hash1(n) < 0.5 ? 1.0 : -1.0;\nfloat2 dir = normalize(float2(190.0 * left, 84.0));\nfloat2 start = float2(left > 0.0 ? -10.0 : G.x + 10.0, hash1(n + 3.0) * G.y * 0.6);\nfloat2 head = start + dir * 210.0 * u;\nfloat2 rel = c - head;\nfloat along = dot(rel, dir);\nfloat perp = abs(dot(rel, float2(-dir.y, dir.x)));\nif (perp < 0.6 && along < 0.0 && along > -16.0) col = mix(col, c2, (1.0 - u) * (1.0 + along / 16.0 * 0.7));\n}\nreturn half4(col, 1.0);\n}\n","en":"VOID SPACE","id":"10-void","kind":"preset","mascot":"ufo","name":"VOID SPACE 虛空","pal":[{"ac":"#ffe14a","bg":"#000039","c0":"#0a1f7a","c1":"#1b4fc0","c2":"#2fd6e0","fg":"#ffe14a","ink":"#000039","lite":"#ffe14a"},{"ac":"#5ff0ff","bg":"#1c0a4e","c0":"#3a1078","c1":"#8a2be2","c2":"#ff4fd8","fg":"#5ff0ff","ink":"#1c0a4e","lite":"#5ff0ff"},{"ac":"#ff8fd8","bg":"#02262e","c0":"#0b5d5a","c1":"#18c9a0","c2":"#b6ff5a","fg":"#b6ff5a","ink":"#02262e","lite":"#b6ff5a"},{"ac":"#5ff0ff","bg":"#2c0616","c0":"#7a0f2a","c1":"#ff5a1f","c2":"#ffe14a","fg":"#ffe14a","ink":"#2c0616","lite":"#ffe14a"},{"ac":"#b6ff5a","bg":"#06010f","c0":"#2b0a5e","c1":"#00c8ff","c2":"#ff2fd0","fg":"#b6ff5a","ink":"#06010f","lite":"#b6ff5a"}],"prompt":null,"tag":"ufopump","thumb":null,"tile":null,"zh":"虛空","zone":1},{"actors":null,"body":"// name: ACID FOREST 螢光森林\n// mascot: firefly\n// tag: ufopump\n// thumb: 2\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nvoid palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac) {\nif (z < 0.5)      { bg = hx(0x061226); c0 = hx(0x123a6a); c1 = hx(0x1fb0b8); c2 = hx(0x7dffe0); ac = hx(0xffd84a); }\nelse if (z < 1.5) { bg = hx(0x06140c); c0 = hx(0x12402a); c1 = hx(0x2f9a4a); c2 = hx(0xb6ff5a); ac = hx(0xff7ad0); }\nelse if (z < 2.5) { bg = hx(0x180828); c0 = hx(0x4a1470); c1 = hx(0xb030c8); c2 = hx(0xff8af0); ac = hx(0x8dff5a); }\nelse if (z < 3.5) { bg = hx(0x1e1004); c0 = hx(0x6a3a0c); c1 = hx(0xe08a1a); c2 = hx(0xffe86a); ac = hx(0x4af0d0); }\nelse              { bg = hx(0x0c0522); c0 = hx(0x2a1a80); c1 = hx(0x7a4aff); c2 = hx(0x9ff8ff); ac = hx(0xff4f9a); }\n}\nhalf4 main(float2 p) {\nfloat s = PX();\nfloat2 c = floor(p / s);\nfloat2 G = floor(size / s);\nfloat t = time * max(speed, 0.0);\nhalf3 bg; half3 c0; half3 c1; half3 c2; half3 ac;\npalette(zone, bg, c0, c1, c2, ac);\nfloat scroll = floor(t * 3.0);\nfloat2 q = floor(c / 4.0);\nfloat2 ctr = float2(G.x / 8.0 + sin(t * 0.13) * G.x / 14.0, G.y / 9.0 + cos(t * 0.11) * G.y / 16.0);\nfloat rr = length(q - ctr) + sin(q.y * 0.25 + t * 0.6) * 1.8 + sin(q.x * 0.3 - t * 0.4) * 1.2;\nfloat v = sin(rr * 0.55 - t * 0.9) * 0.5 + 0.5;\nfloat k = (v - 0.45) / 0.55;\nhalf3 col = bg;\nif (k > 0.0) { float b = band(k, q, 4.0); col = mix(bg, ramp(c0, c1, c2, b * 0.6), 0.2 + 0.25 * b); }\nfloat fy = c.y - floor(t * 1.5);\nfloat slot = 34.0;\nfloat fid = floor((c.x + 11.0) / slot);\nfloat flx = c.x + 11.0 - fid * slot - 10.0 - floor(hash1(fid) * 8.0);\nfloat fw = 8.0 + floor(hash1(fid + 2.0) * 6.0);\nif (flx >= 0.0 && flx < fw) {\ncol = mix(bg, c0, 0.55);\nif (mod(flx + floor(fy / 9.0), 4.0) == 0.0) col = mix(bg, c0, 0.35);\nif (flx < 1.0) col = mix(c0, c1, 0.3);\nif (flx > fw - 3.0 && !dith((flx - fw + 3.0) / 3.0, c)) col = mix(bg, c0, 0.2);\n}\nfloat2 sc = floor(float2(c.x, c.y + t * 6.0) / float2(12.0, 16.0));\nfloat2 spos = sc * float2(12.0, 16.0) + floor(float2(hash2(sc) * 10.0 + sin(t + hash2(sc) * 6.0) * 2.0, hash2(sc + 1.0) * 14.0));\nif (hash2(sc + 4.0) < 0.35 && all(equal(float2(c.x, c.y + floor(t * 6.0)), spos))) col = mix(c2, ac, step(0.8, hash2(sc + 5.0)));\nfloat edgeW = floor(max(18.0, G.x * 0.17));\nfor (int i = 0; i < 3; i++) {\nfloat fi = float(i);\nfloat y0 = mod(fi * G.y / 3.0 + 20.0 - floor(t * 3.0), G.y + 40.0) - 20.0;\nfloat x = (c.x - edgeW) / (G.x - edgeW * 2.0);\nfloat sag = 18.0 + fi * 6.0;\nfloat vy = y0 + sag * (1.0 - (2.0 * x - 1.0) * (2.0 * x - 1.0)) + sin(t * 0.8 + fi) * 4.0 * sin(x * 3.1416);\nif (x > 0.0 && x < 1.0 && abs(c.y - floor(vy)) < 1.0) {\ncol = mix(c0, c1, 0.4);\nif (mod(c.x + fi * 5.0, 13.0) == 0.0) col = sin(t * 1.4 + c.x) > 0.0 ? ac : c1;\n}\nif (x > 0.0 && x < 1.0 && mod(c.x + fi * 3.0, 9.0) == 0.0 && c.y > vy && c.y < vy + 3.0 + hash1(c.x + fi) * 8.0) col = mix(c0, c1, 0.3);\n}\nfor (int i = 0; i < 5; i++) {\nfloat fi = float(i);\nfor (int j = 0; j < 4; j++) {\nfloat tt = t * 0.5 - float(j) * 0.06 + fi * 1.7;\nfloat2 fp = float2(G.x * (0.5 + 0.3 * sin(tt + fi)), G.y * (0.3 + 0.12 * fi + 0.06 * sin(2.0 * tt)));\nif (all(equal(c, floor(fp)))) col = mix(col, j == 0 ? c2 : c1, 1.0 - float(j) * 0.25);\n}\n}\nfloat ny = c.y - scroll;\nfloat wob = floor(sin(ny * 0.05) * 2.0);\nbool left = c.x < edgeW + wob;\nbool right = c.x > G.x - edgeW - 1.0 - wob;\nif (left || right) {\nfloat lx = left ? edgeW + wob - 1.0 - c.x : c.x - (G.x - edgeW - wob);\ncol = mix(c0, bg, 0.15);\nif (mod(c.x * 3.0 + floor(ny / 14.0) * 2.0, 7.0) < 1.0) col = mix(bg, c0, 0.35);\nif (lx < 1.0) col = mix(c0, c1, 0.45);\nif (lx < 3.0 && lx >= 1.0 && !dith(0.5, c)) col = mix(bg, c0, 0.4);\nfloat kid = floor(ny / 40.0);\nif (length(float2(lx - 6.0 - hash1(kid) * 6.0, mod(ny, 40.0) - 20.0)) < 3.0) col = mix(bg, c0, 0.3);\nif (hash2(floor(float2(c.x, ny) / 2.0)) < 0.008) col = mix(c1, c2, 0.5 + 0.5 * sin(t + c.x));\nfloat eid = floor(ny / 70.0) + (left ? 0.0 : 50.0);\nfloat ey = mod(ny, 70.0) - 35.0;\nfloat ex = lx - 8.0;\nfloat blink = mod(t + hash1(eid) * 5.0, 5.0) < 0.15 ? 1.0 : 0.0;\nif (hash1(eid + 0.5) < 0.5 && abs(ey) < 1.0 - blink && (abs(ex - 2.0) < 1.5 || abs(ex + 2.0) < 1.5)) {\ncol = hx(0xfff4c0);\nfloat look = floor(sin(t * 0.7 + eid) * 1.5);\nif (ex == 2.0 + look || ex == -2.0 + look) col = bg;\n}\n}\nfor (int i = 0; i < 2; i++) {\nfloat side = i == 0 ? 1.0 : -1.0;\nfloat mid = floor((c.y - scroll) / 34.0);\nfloat my = mid * 34.0 + 10.0 + floor(hash1(mid + float(i)) * 14.0) + scroll;\nfloat mx = i == 0 ? edgeW + floor(sin((my - scroll) * 0.05) * 2.0) : G.x - edgeW - 1.0 - floor(sin((my - scroll) * 0.05) * 2.0);\nfloat2 dm = float2(c.x - mx, c.y - my);\nfloat rad = 7.0 + floor(hash1(mid * 3.0 + float(i)) * 4.0);\nif (dm.x * side >= -1.0 && dm.y <= 0.0 && length(float2(dm.x - side * rad * 0.6, dm.y * 1.6)) < rad) {\nfloat breath = 0.5 + 0.5 * sin(t * 0.9 + mid);\ncol = mix(c1, ac, breath * 0.8);\nif (dm.y == 0.0) col = mix(c0, c1, 0.5);\n}\n}\nif (c.y > G.y - 6.0 && dith((c.y - (G.y - 6.0)) / 6.0 * 0.6, c)) col = mix(col, c1, 0.4);\nreturn half4(col, 1.0);\n}\n","en":"ACID FOREST","id":"40-forest","kind":"preset","mascot":"firefly","name":"ACID FOREST 螢光森林","pal":[{"ac":"#ffd84a","bg":"#061226","c0":"#123a6a","c1":"#1fb0b8","c2":"#7dffe0","fg":"#7dffe0","ink":"#061226","lite":"#7dffe0"},{"ac":"#ff7ad0","bg":"#06140c","c0":"#12402a","c1":"#2f9a4a","c2":"#b6ff5a","fg":"#b6ff5a","ink":"#06140c","lite":"#b6ff5a"},{"ac":"#8dff5a","bg":"#180828","c0":"#4a1470","c1":"#b030c8","c2":"#ff8af0","fg":"#8dff5a","ink":"#180828","lite":"#8dff5a"},{"ac":"#4af0d0","bg":"#1e1004","c0":"#6a3a0c","c1":"#e08a1a","c2":"#ffe86a","fg":"#ffe86a","ink":"#1e1004","lite":"#ffe86a"},{"ac":"#ff4f9a","bg":"#0c0522","c0":"#2a1a80","c1":"#7a4aff","c2":"#9ff8ff","fg":"#9ff8ff","ink":"#0c0522","lite":"#9ff8ff"}],"prompt":null,"tag":"ufopump","thumb":null,"tile":null,"zh":"螢光森林","zone":2},{"actors":null,"body":"// name: ZION HUB 代碼雨\n// mascot: sentinel\n// tag: ufopump\n// thumb: 2\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2026 WeeboWIZ. Part of Trip View; see LICENSE.\nvoid palette(float z, out half3 bg, out half3 c0, out half3 c1, out half3 c2, out half3 ac) {\nif (z < 0.5)      { bg = hx(0x0c0302); c0 = hx(0x4a1206); c1 = hx(0xe0521a); c2 = hx(0xffd8a0); ac = hx(0xff2040); }\nelse if (z < 1.5) { bg = hx(0x01070c); c0 = hx(0x06323a); c1 = hx(0x14b8a8); c2 = hx(0xc0fff4); ac = hx(0xffe14a); }\nelse if (z < 2.5) { bg = hx(0x010703); c0 = hx(0x063a12); c1 = hx(0x12b83a); c2 = hx(0xb8ffc8); ac = hx(0xff3838); }\nelse if (z < 3.5) { bg = hx(0x04030c); c0 = hx(0x221a5a); c1 = hx(0x6a5af0); c2 = hx(0xd8d4ff); ac = hx(0x3dff7a); }\nelse              { bg = hx(0x050505); c0 = hx(0x363636); c1 = hx(0xc4c4c4); c2 = hx(0xffffff); ac = hx(0x12e85a); }\n}\nbool glyph(float gi, float2 g) {\ngi = mod(gi, 48.0);\nbool on = false;\nif (hash1(gi + 0.11) > 0.5 && g.y == 0.0) on = true;\nif (hash1(gi + 0.23) > 0.55 && g.y == 3.0 && g.x > 0.0) on = true;\nif (hash1(gi + 0.37) > 0.6 && g.y == 6.0) on = true;\nif (hash1(gi + 0.41) > 0.55 && g.x == 0.0 && g.y < 4.0) on = true;\nif (hash1(gi + 0.53) > 0.45 && g.x == 2.0 && g.y > 0.0) on = true;\nif (hash1(gi + 0.67) > 0.55 && g.x == 4.0) on = true;\nif (hash1(gi + 0.79) > 0.6 && abs(4.0 - g.x - g.y * 0.6) < 0.5) on = true;\nif (hash1(gi + 0.83) > 0.7 && abs(g.x - (g.y - 3.0) * 1.3) < 0.5 && g.y > 2.0) on = true;\nreturn on;\n}\nhalf4 main(float2 p) {\nfloat s = PX();\nfloat2 c = floor(p / s);\nfloat2 G = floor(size / s);\nfloat t = time * max(speed, 0.0);\nhalf3 bg; half3 c0; half3 c1; half3 c2; half3 ac;\npalette(zone, bg, c0, c1, c2, ac);\nhalf3 col = bg;\nfloat2 wc = float2(c.x, c.y + floor(t * 2.0));\nfloat2 wcell = floor(wc / float2(6.0, 9.0));\nfloat2 wg = wc - wcell * float2(6.0, 9.0);\nif (wg.x < 5.0 && wg.y < 7.0 && hash2(wcell) < 0.55 && glyph(floor(hash2(wcell + 3.0) * 48.0), wg)) col = mix(bg, c0, 0.32);\nfloat2 cell = floor(c / float2(6.0, 9.0));\nfloat2 g = c - cell * float2(6.0, 9.0);\nfloat id = cell.x;\nfloat rows = ceil(G.y / 9.0);\nfloat spd = 3.0 + hash1(id * 1.37) * 7.0;\nfloat len = 6.0 + floor(hash1(id * 2.11) * 14.0);\nfloat head = floor(mod(t * spd + hash1(id * 5.3) * 100.0, rows + len + 10.0));\nfloat dist = head - cell.y;\nif (hash1(id * 7.9) < 0.8 && dist >= 0.0 && dist < len && g.x < 5.0 && g.y < 7.0) {\nfloat gi = floor(hash2(float2(id, cell.y + floor(t * (dist < 1.0 ? 8.0 : 1.5) + hash2(cell) * 9.0))) * 48.0);\nif (glyph(gi, g)) {\nfloat f = 1.0 - dist / len;\ncol = dist < 1.0 ? c2 : mix(c0, c1, band(f, c, 4.0));\n}\n}\nfloat pw = floor(max(10.0, G.x * 0.08));\nfloat lx = c.x < pw ? c.x : c.x > G.x - pw - 1.0 ? G.x - 1.0 - c.x : -1.0;\nif (lx >= 0.0) {\nfloat py = c.y + floor(t * 4.0);\nfloat tube = floor(lx / (pw / 3.0));\nfloat tx = lx - tube * (pw / 3.0);\nfloat tw = floor(pw / 3.0);\nif (tx < tw - 1.0) {\ncol = mix(bg, c0, 0.5 + 0.4 * sin(tx / (tw - 1.0) * 3.1416));\nif (tx < 1.0) col = mix(bg, c0, 0.3);\nif (mod(py + tube * 11.0, 48.0) < 3.0) {\ncol = mix(c0, c1, 0.35);\nif (mod(py + tube * 11.0, 48.0) == 1.0 && mod(tx, 3.0) == 1.0) col = mix(c1, c2, 0.5);\n}\nfloat pulse = mod(c.y + t * (30.0 + tube * 12.0) + tube * 37.0 + (c.x < pw ? 0.0 : 50.0), 90.0);\nif (abs(tx - floor(tw / 2.0) + 0.5) < 1.0 && pulse < 4.0) col = mix(c1, c2, 1.0 - pulse / 4.0);\n}\n}\nfloat2 cc = float2(floor(G.x * 0.5), floor(G.y * 0.4 + sin(t * 0.3) * 6.0));\nfloat R = floor(min(G.x, G.y) * 0.13);\nfloat a1 = t * 0.4; float a2 = t * 0.27;\nfloat ca = cos(a1); float sa = sin(a1); float cb = cos(a2); float sb = sin(a2);\nfloat hit = 0.0;\nif (length(c - cc) < R * 2.0) {\nfor (int e = 0; e < 12; e++) {\nfloat fe = float(e);\nfloat axis = floor(fe / 4.0);\nfloat k = mod(fe, 4.0);\nfloat u = mod(k, 2.0) * 2.0 - 1.0;\nfloat w = floor(k / 2.0) * 2.0 - 1.0;\nfloat3 A = axis < 0.5 ? float3(-1.0, u, w) : axis < 1.5 ? float3(u, -1.0, w) : float3(u, w, -1.0);\nfloat3 B = axis < 0.5 ? float3(1.0, u, w) : axis < 1.5 ? float3(u, 1.0, w) : float3(u, w, 1.0);\nA = float3(A.x * ca + A.z * sa, A.y, -A.x * sa + A.z * ca);\nB = float3(B.x * ca + B.z * sa, B.y, -B.x * sa + B.z * ca);\nA = float3(A.x, A.y * cb - A.z * sb, A.y * sb + A.z * cb);\nB = float3(B.x, B.y * cb - B.z * sb, B.y * sb + B.z * cb);\nfloat2 pa = cc + floor(A.xy * R * (1.0 + A.z * 0.15));\nfloat2 pb = cc + floor(B.xy * R * (1.0 + B.z * 0.15));\nif (segd(c, pa, pb) < 0.55) hit = max(hit, 0.6 + 0.2 * (A.z + B.z) * 0.5);\n}\n}\nif (hit > 0.0) col = mix(c1, c2, hit - 0.4);\nfloat sl = G.y - mod(t, 6.0) / 6.0 * (G.y + 20.0);\nif (abs(c.y - floor(sl)) < 1.0) col = mix(col, c1, 0.5);\nif (c.y > sl && c.y < sl + 6.0 && dith(0.3 * (1.0 - (c.y - sl) / 6.0), c)) col = mix(col, c1, 0.3);\nfloat gt = floor(t * 3.0);\nif (hash1(gt) > 0.9) {\nfloat gy = floor(hash1(gt + 1.0) * G.y);\nif (abs(c.y - gy) < 2.0 + floor(hash1(gt + 2.0) * 3.0) && hash2(float2(floor(c.x / 9.0), gt)) < 0.6) col = mix(col, ac, 0.55);\n}\nreturn half4(col, 1.0);\n}\n","en":"ZION HUB","id":"50-zion","kind":"preset","mascot":"sentinel","name":"ZION HUB 代碼雨","pal":[{"ac":"#ff2040","bg":"#0c0302","c0":"#4a1206","c1":"#e0521a","c2":"#ffd8a0","fg":"#ffd8a0","ink":"#0c0302","lite":"#ffd8a0"},{"ac":"#ffe14a","bg":"#01070c","c0":"#06323a","c1":"#14b8a8","c2":"#c0fff4","fg":"#c0fff4","ink":"#01070c","lite":"#c0fff4"},{"ac":"#ff3838","bg":"#010703","c0":"#063a12","c1":"#12b83a","c2":"#b8ffc8","fg":"#b8ffc8","ink":"#010703","lite":"#b8ffc8"},{"ac":"#3dff7a","bg":"#04030c","c0":"#221a5a","c1":"#6a5af0","c2":"#d8d4ff","fg":"#d8d4ff","ink":"#04030c","lite":"#d8d4ff"},{"ac":"#12e85a","bg":"#050505","c0":"#363636","c1":"#c4c4c4","c2":"#ffffff","fg":"#ffffff","ink":"#050505","lite":"#ffffff"}],"prompt":null,"tag":"ufopump","thumb":null,"tile":null,"zh":"代碼雨","zone":2},{"act