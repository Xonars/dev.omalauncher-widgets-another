widget "dns" {
  size: 3x1
  minSize: 1x1

  meta { owl: 6; description: "Switch this machine's DNS resolver between Cloudflare, Google, Quad9 and the default in /etc/resolv.conf, with brand marks, the active provider and its latency."; version: "1.4"; license: "MIT"; category: "system" }

  requires { pacman: ["bind", "gawk"] }

  // Monochrome logo glyphs. net and q9 are tinted to match their pill; Cloudflare
  // and Google keep their brand colors and only fade when the pill is inactive.
  asset cf = base64""
  asset goog = base64""
  asset q9 = base64""
  asset net = base64""

  // The resolver list in use, read live from the file the toggle writes.
  source resolv = file("/etc/resolv.conf")
  // Response time of the resolver the system is actually using, via dig.
  source probe = cmd('f=/etc/resolv.conf; s=$(awk "/^[[:space:]]*nameserver/ {print \$2; exit}" "$f"); [ -n "$s" ] || exit 0; dig +time=2 +tries=1 +stats @"$s" cloudflare.com A 2>/dev/null | awk "/Query time:/ {print \$4}"') every 60s timeout 15s

  // Preset secondary servers are unique, so they tell the presets apart from the
  // default resolv.conf, which already lists 1.1.1.1 and 8.8.8.8.
  let provider = contains(resolv ?? "", "9.9.9.9") ? "quad9" : contains(resolv ?? "", "8.8.4.4") ? "google" : contains(resolv ?? "", "1.0.0.1") ? "cloudflare" : "default"
  let servers = lines(resolv ?? "").filter(l => startsWith(trim(l), "nameserver")).map(l => words(l)[1])
  let wide = tileWidth != null && tileHeight != null && tileWidth > tileHeight
  // A one-row tile only fits the pills and the header; the server list needs more.
  let roomy = (rows ?? 2) >= 2
  // Logo glyphs scale with the tile: in a one-row tile they share its height, in
  // the stacked narrow layout each one keeps a quarter of the tile height.
  let logoSize = clamp((wide ? tileHeight * 0.45 : min(tileWidth * 0.5, tileHeight / 4 - 16)) ?? 24, 14, 48)
  // The active provider, named in the header next to the latency.
  let who = provider == "default" ? "default connection" : "connected to ${upper(sub(provider, 0, 1)) + sub(provider, 1, 50)}"

  // One pill for every provider; the switcher lives here, built with sh() so the
  // preset and its server list can't escape the shell.
  component Pill(logo, preset, tint, logoTint = null) {
    let active = provider == preset
    // Secondary servers this preset switches to; "" restores the backed-up default.
    let addr = preset == "cloudflare" ? "1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001" : preset == "google" ? "8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844" : preset == "quad9" ? "9.9.9.9 149.112.112.112 2620:fe::fe 2620:fe::9" : ""
    Box {
      align: center
      radius: 6
      padding: [6, 4]
      background: active ? (preset == "default" ? muted : alpha(tint, 0.18)) : surface
      border: active ? (preset == "default" ? 0 : 2) : 1
      borderColor: active ? tint : border
      onTap: run('f=/etc/resolv.conf; b=/etc/resolv.conf.omarchy-default; [ -f "$b" ] || cp "$f" "$b"; s=' + sh(addr) + '; if [ -n "$s" ]; then { for i in $s; do echo "nameserver $i"; done; echo "options timeout:1 attempts:1"; } > "$f"; else [ -f "$b" ] && cp "$b" "$f"; fi; true')
      Image { src: logo; size: logoSize; fit: contain; tint: logoTint; opacity: active ? 1 : 0.55 }
    }
  }

  Column {
    gap: 5
    if wide {
      Row {
        fill: width
        Text { text: "ARCH DNS PROVIDER"; style: label; color: muted; weight: 1; maxLines: 1 }
        if roomy {
          Text { text: len(probe ?? "") > 0 ? "${who} · ${probe} ms" : who; style: small; color: muted; width: 96; align: end; maxLines: 1 }
        } else {
          Text { text: len(probe ?? "") > 0 ? "${probe} ms" : ""; style: small; color: muted; width: 52; align: end; maxLines: 1 }
        }
      }
    } else {
      // A narrow stacked tile only has room for the latency above the pills.
      Text { text: len(probe ?? "") > 0 ? "${probe} ms" : "DNS"; style: small; color: muted; align: center; maxLines: 1; fill: width }
    }
    if wide {
      Row {
        fill: width
        weight: 1
        gap: 5
        Pill { logo: net; preset: "default"; tint: muted; logoTint: foreground; weight: 1; fill: height }
        Pill { logo: cf; preset: "cloudflare"; tint: orange; weight: 1; fill: height }
        Pill { logo: goog; preset: "google"; tint: blue; weight: 1; fill: height }
        Pill { logo: q9; preset: "quad9"; tint: #d71b5b; logoTint: #d71b5b; weight: 1; fill: height }
      }
    } else {
      Pill { logo: net; preset: "default"; tint: muted; logoTint: foreground; weight: 1; fill: width }
      Pill { logo: cf; preset: "cloudflare"; tint: orange; weight: 1; fill: width }
      Pill { logo: goog; preset: "google"; tint: blue; weight: 1; fill: width }
      Pill { logo: q9; preset: "quad9"; tint: #d71b5b; logoTint: #d71b5b; weight: 1; fill: width }
    }
    // The server list is cut to one address in a narrow stacked tile, so it's left out there.
    if roomy && wide {
      Text { text: join(servers, "  ·  "); style: muted; color: muted; maxLines: 1; fill: width }
    }
  }
}
