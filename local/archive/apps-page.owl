face "Приложения" {
  page: 4
  padding: 0
  state query = ""
  state searchActive = false
  state view = "folders"
  requires { pacman: [] }
  background: linear(0, 0, 0, 1, [alpha(background, 0.96), alpha(background, 0.82)])
  // The app drawer: swiping up on home opens it, above the prompt bar. It's a panel like any other, so it's yours to
  // change: ask your agent to edit it, or pick another panel in settings › gestures. .stock-drawer.owl next to it is
  // this file as the launcher ships it, kept up to date: compare the two to see what changed in a newer launcher.
  meta { description: "The launcher's app drawer, written in owl: your apps by kind, search as you type in the prompt bar, and each app's long-press menu"; version: "1.0"; license: "MIT"; category: "system"; owl: 13 }
  // The launcher's gear, as its settings buttons draw it; currentColor takes the accent.
  asset gear = base64""
  source d = android.drawer
  source ag = android.agents
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  state folder = ""
  // The result picked with the arrow or Tab keys, -1 for the ask row; null follows the ranking.
  state pick = null

  // As the launcher's drawer fits them: a column for every 76 dp.
  let cols = max(1, floor(((screenWidth ?? 400) - 24) / 76))
  let typed = trim(query)
  let searching = typed != ""
  // The private space's tab shows while it's there, unless it's locked and hidden while locked: then only typing
  // "private" offers to unlock it. Locked, its apps aren't listed at all, here or in search.
  let tabs = flatten([["personal"], d.work != null ? ["work"] : [], d.private != null && !(d.private.locked && d.private.hidden) ? ["private"] : []])
  // A tab that went away (the space locked and hid) leaves the personal one.
  let shown = contains(tabs, tab) ? tab : "personal"
  let mine = d.apps.filter(a => shown == "personal" ? a.profile != "work" && a.profile != "private" : a.profile == shown)
  // Categories use stable app keys; new apps remain visible in «Прочее».
  let categories = {"o:chess-app.owl": "Игры", "o:76-oma-update-app.owl": "Система и оформление", "o:80-owl-guide.owl": "ИИ и разработка", "o:apk-maker-app.owl": "ИИ и разработка", "o:market-app-perminder-klair-solitaire.owl": "Игры", "o:market-app-placq-reader.owl": "Заметки и чтение", "o:market-app-placq-send-files.owl": "Файлы и приложения", "o:market-app-simonschubert-linux-commands.owl": "ИИ и разработка", "o:market-app-simonschubert-notes.owl": "Заметки и чтение", "l:btop": "Система и оформление", "l:canvas": "Фото и творчество", "l:cliamp": "Музыка и видео", "l:cmake-gui": "ИИ и разработка", "l:agent-codex": "ИИ и разработка", "l:micro": "ИИ и разработка", "l:omarchy-files": "Файлы и приложения", "l:agent-opencode": "ИИ и разработка", "l:jconsole-java17-openjdk": "ИИ и разработка", "l:jshell-java17-openjdk": "ИИ и разработка", "l:jconsole-java25-openjdk": "ИИ и разработка", "l:jshell-java25-openjdk": "ИИ и разработка", "l:assistant": "ИИ и разработка", "l:org.qt-project.qtcreator": "ИИ и разработка", "l:qdbusviewer": "ИИ и разработка", "l:linguist": "ИИ и разработка", "l:qv4l2": "ИИ и разработка", "l:qvidcap": "ИИ и разработка", "l:designer": "ИИ и разработка", "l:org.telegram.desktop": "Общение", "l:foot": "ИИ и разработка", "l:universal": "ИИ и разработка", "l:code": "ИИ и разработка", "a:com.foxdebug.acode/.MainActivityIconDefault": "ИИ и разработка", "a:com.beemdevelopment.aegis/.ui.MainActivity": "Система и оформление", "a:com.openai.chatgpt/.MainActivity": "ИИ и разработка", "a:com.android.chrome/com.google.android.apps.chrome.Main": "Интернет и загрузки", "a:com.mishiranu.dashchan/.ui.MainActivity": "Общение", "a:dev.eden.eden_emulator/org.yuzu.yuzu_emu.ui.main.MainActivity": "Игры", "a:org.fdroid.fdroid/org.fdroid.IconActivity": "Файлы и приложения", "a:com.example.gallerydownloader/.MainActivity": "Интернет и загрузки", "a:com.github.android/.main.MainActivity": "ИИ и разработка", "a:tech.abra.glyphstudio/.MainActivity": "Система и оформление", "a:com.voidtechstudios.smartglyph/.OnboardingActivity": "Система и оформление", "a:com.google.android.gm/.ConversationListActivityGmail": "Общение", "a:com.google.android.googlequicksearchbox/.SearchActivity": "Интернет и загрузки", "a:com.android.vending/.AssetBrowserActivity": "Файлы и приложения", "a:com.happproxy/.feature.main.MainActivity": "Интернет и загрузки", "a:org.proninyaroslav.libretorrent/.MainActivity": "Интернет и загрузки", "a:com.mantaray.vpn/.MainActivity": "Интернет и загрузки", "a:com.wuliang.xapkinstaller/.ui.splash.SplashActivity": "Файлы и приложения", "a:com.android.stk/.StkMain": "Система и оформление", "a:com.badmanners.murglar2/com.badmanners.murglar.MainActivity": "Музыка и видео", "a:com.cyanchill.missingcore.music/.MainActivity": "Музыка и видео", "a:com.apkmaker.not_boring_camera/.MainActivity": "Фото и творчество", "a:com.nothing.icon.free/.MainActivity": "Система и оформление", "a:com.nothing.smartcenter/.host.MainActivity": "Система и оформление", "a:dev.omalauncher.astra.offline/dev.omalauncher.MainActivity": "Система и оформление", "a:app.organicmaps/.DownloadResourcesActivity": "Карты и транспорт", "a:com.pinterest/.activity.PinterestActivity": "Фото и творчество", "a:com.rarlab.rar/.MainActivity": "Файлы и приложения", "a:org.readera/com.readera.MainActivity": "Заметки и чтение", "a:ru.rutube.app/.ui.activity.tabs.RootActivity": "Музыка и видео", "a:org.telegram.messenger/.DefaultIcon": "Общение", "a:org.vita3k.emulator/.MainActivity": "Игры", "a:com.vkontakte.android/com.vk.android.launcher.icons.IconAlias.DefaultIcon": "Общение", "a:com.google.android.youtube/.app.honeycomb.Shell$HomeActivity": "Музыка и видео", "a:com.avito.android/.Launcher": "Покупки и финансы", "a:com.google.android.apps.safetyhub/.LauncherActivity": "Система и оформление", "a:com.nothing.gallery/.activity.EntryActivity": "Фото и творчество", "a:com.nothing.soundrecorder/.ui.NewMainActivity": "Музыка и видео", "a:com.google.android.keep/.activities.BrowseActivity": "Заметки и чтение", "a:com.google.android.calendar/com.android.calendar.AllInOneActivity": "Заметки и чтение", "a:com.google.android.calculator/com.android.calculator2.Calculator": "Заметки и чтение", "a:com.nothing.camera/.activity.CameraActivity": "Фото и творчество", "a:com.google.android.apps.maps/com.google.android.maps.MapsActivity": "Карты и транспорт", "a:com.nothing.glyph.composer/.ui.MainActivity": "Система и оформление", "a:com.google.android.contacts/com.android.contacts.activities.PeopleActivity": "Общение", "a:com.android.settings/.Settings": "Система и оформление", "a:com.nothing.weather/.ui.main.MainActivity": "Карты и транспорт", "a:ru.yandex.mail/.ui.LoginActivity": "Общение", "a:ru.sberbankmobile/ru.sberbank.mobile.auth.presentation.splash.SplashActivity": "Покупки и финансы", "a:ru.novacard.siticard/ru.novacard.transport.activity.NewMainActivity": "Карты и транспорт", "a:com.google.android.apps.messaging/.ui.ConversationListActivity": "Общение", "a:com.google.android.dialer/.extensions.GoogleDialtactsActivity": "Общение", "a:com.documentsui.shortcut/com.documentsui.launcher.MainActivity": "Файлы и приложения", "a:com.google.android.deskclock/com.android.deskclock.DeskClock": "Заметки и чтение", "a:com.chess/.splash.SplashActivity": "Игры", "a:com.yandex.lavka/ru.yandex.lavka.activity.MainActivity": "Покупки и финансы"}
  let categoryOrder = ["Общение", "Интернет и загрузки", "Музыка и видео", "Фото и творчество", "Заметки и чтение", "Карты и транспорт", "Покупки и финансы", "Игры", "ИИ и разработка", "Файлы и приложения", "Система и оформление", "Ярлыки", "Прочее"]
  let sections = shown == "work" ? [
      {title: "shortcuts", apps: mine.filter(a => a.kind == "shortcut")},
      {title: d.work.paused ? "work apps paused" : "work apps", apps: mine.filter(a => a.kind == "android"), work: true}
    ] : shown == "private" ? [
      {title: "shortcuts", apps: mine.filter(a => a.kind == "shortcut")},
      {title: d.private.locked ? "private space locked" : "private apps", apps: mine.filter(a => a.kind == "android"), private: true}
    ] : flatten([
      categoryOrder.map(category => {title: category, apps: mine.filter(a => get(categories, a.key, a.kind == "shortcut" ? "Ярлыки" : "Прочее") == category).sortBy(a => lower(a.name))}),
      !linux ? [{title: "Linux", apps: [], linux: true}] : []
    ])
  let folders = sections.filter(s => len(s.apps) > 0)
  let folderApps = mine.filter(a => get(categories, a.key, a.kind == "shortcut" ? "Ярлыки" : "Прочее") == folder).sortBy(a => lower(a.name))
  let folderRows = chunk(folderApps, cols)
  let allRows = chunk(mine.filter(a => view == "all" || a.kind == view).sortBy(a => lower(a.name)), cols)
  on shown { folder = "" }
  // A title, then rows of cols apps. Without Linux, its section is an offer to install it.
  let rows = flatten(sections.filter(s => len(s.apps) > 0 || s.work || s.private || (s.linux && !linux)).map(s => flatten([
      [{key: "h:" + s.title, title: s.linux && !linux ? "linux apps" : s.title, work: s.work, private: s.private, offer: s.linux && !linux}],
      chunk(s.apps, cols).map((cells, r) => {key: s.title + ":" + r, cells: cells})
    ])))
  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(d.apps, typed) : []
  // Typing "private" while the private space is locked offers to unlock it, as stock launchers do when it's hidden.
  let offersPrivate = searching && d.private != null && d.private.locked && len(typed) >= 3 && startsWith("private space", lower(typed))
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; anything else, a prompt of more lines among it, goes to the agent.
  let opens = len(hits) > 0 && strongMatch(hits[0], typed)
  // What Enter acts on: a result by its place in hits, or -1 for the ask row.
  let chosen = pick ?? (opens ? 0 : -1)
  let agent = ag.default
  let labels = {pin: "На главный экран", info: "О приложении", uninstall: "Удалить приложение", remove: "Убрать", edit: "Изменить", share: "Поделиться"}

  // Typing starts the pick over, at the best match.
  on typed { pick = null }

  // An app's icon as the drawer draws it: its own, its silhouette on a badge with monochrome icons, or its initials.
  component AppIcon(a) {
    Box {
      size: 52
      align: center
      radius: 26 * corners
      background: a.hasIcon && !d.monochrome ? transparent : surface
      if a.hasIcon {
        Image { src: a.icon; size: d.monochrome ? 36 : 52; tint: d.monochrome ? accent : null; label: a.label }
      } else {
        Text { text: a.initials; fontSize: 18; color: accent }
      }
    }
  }

  component Cell(a, picked) {
    Column {
      weight: 1
      align: center
      gap: 6
      padding: [4, 10]
      radius: 16 * corners
      border: picked ? 2 : 0
      borderColor: accent
      // Paused work apps show dimmed; opening one turns work apps back on.
      opacity: a.paused ? 0.4 : 1
      onTap: open(a.key)
      onLongPress: {
        haptic()
        menuShortcuts = null
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }
      AppIcon { a: a }
      // Always two lines tall, so a row keeps its height whichever apps fill it.
      Text { text: a.name; fontSize: 12; align: center; maxLines: 2; minLines: 2; fill: width }
      Popup {
        visible: menu == a.key && menuShortcuts != null
        position: above
        onDismiss: menu = ""
        width: 200
        gap: 0
        // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
        for s in menuShortcuts key s.key {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [12, 6]
            onTap: { menu = ""; open(s.key) }
            Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
            Text { text: s.name; weight: 1; maxLines: 1 }
            // The private space's apps stay off home.
            Text { text: "[+]"; visible: a.profile != "private"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
          }
        }
        Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
        for w in a.actions {
          Text { text: get(labels, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
        }
      }
    }
  }

  Column {
    gap: 0
    padding: [12, 12]
    Row {
      fill: width
      align: center
      padding: [4, 8, 4, 16]
      Column {
        weight: 1
        gap: 2
        Text { text: "Приложения"; fontSize: 28; fontWeight: 700 }
        Text { text: "${len(mine)} приложений · ${len(folders)} категорий"; fontSize: 12; color: muted }
      }
      Box {
        size: 44
        radius: 16 * corners
        background: surface
        align: center
        onTap: launcher("settings")
        Image { src: gear; size: 22; tint: accent; label: "Настройки" }
        Box { visible: d.updates > 0; align: topEnd; size: 44; padding: 8; Box { size: 8; radius: 4; background: red } }
      }
    }
    Row {
      fill: width
      align: center
      gap: 0
      background: alpha(surface, 0.9)
      border: 1
      borderColor: alpha(accent, 0.35)
      radius: 16 * corners
      if searchActive {
        Input {
        text: query
        placeholder: "Найти приложение…"
        weight: 1
        padding: [16, 14]
        underline: false
        onChange: query = value
        onSubmit: { if len(hits) > 0 { open(hits[0].key) } }
        }
      } else {
        Text {
          text: "Найти приложение…"
          color: muted
          weight: 1
          padding: [16, 14]
          onTap: searchActive = true
        }
      }
      Text { visible: searchActive; text: "×"; fontSize: 24; color: accent; padding: [16, 10]; onTap: { query = ""; searchActive = false } }
    }
    Row {
      align: center
      fill: width
      padding: [0, 12]
      gap: 6
      for t in len(tabs) > 1 && !searching ? tabs : [] {
        Text { text: t == "personal" ? "Личные" : t == "work" ? "Рабочие" : "Приватные"; fontSize: 12; color: shown == t ? accent : muted; background: shown == t ? surface : transparent; radius: 12 * corners; padding: [10, 10]; onTap: tab = t }
      }
      if !searching && shown == "personal" && folder == "" {
        for option in [{id: "folders", label: "Категории"}, {id: "all", label: "Все"}, {id: "owl", label: "OWL"}, {id: "android", label: "Android"}, {id: "linux", label: "Linux"}] {
          Text { text: option.label; fontSize: 13; color: view == option.id ? accent : muted; background: view == option.id ? surface : transparent; radius: 12 * corners; padding: [8, 10]; onTap: view = option.id }
        }
      }
      if searching { Text { text: "Найдено: ${len(hits)}"; fontSize: 13; color: muted; padding: [4, 8] } }
    }
    Grid {
      visible: !searching && shown == "personal" && folder == "" && view == "folders"
      lazy: true
      weight: 1
      fill: width
      columns: 2
      gap: 10
      padding: [0, 4]
      for f in folders key f.title {
        Column {
          fill: width
          gap: 10
          padding: 14
          radius: 20 * corners
          background: alpha(surface, 0.88)
          border: 1
          borderColor: alpha(accent, 0.12)
          onTap: { haptic(); folder = f.title }
          Text { text: f.title; fontSize: 14; fontWeight: 600; maxLines: 2; minLines: 2; fill: width }
          Column {
            fill: width
            gap: 12
            for pair in chunk(f.apps.take(4), 2) {
              Row {
                fill: width
                justify: spaceEvenly
                gap: 8
                for a in pair {
                  Box {
                    size: 48
                    align: center
                    if a.hasIcon {
                      Image { src: a.icon; size: 48; tint: d.monochrome ? accent : null; label: a.name }
                    } else {
                      Text { text: a.initials; fontSize: 20; color: accent; align: center }
                    }
                  }
                }
                for n in range(0, 2 - len(pair)) { Spacer { size: 48 } }
              }
            }
            for n in range(0, 2 - len(chunk(f.apps.take(4), 2))) { Spacer { height: 48 } }
          }
        }
      }
    }
    Column {
      visible: !searching && shown == "personal" && folder == "" && view != "folders"
      lazy: true
      weight: 1
      fill: width
      for cells, i in allRows key i {
        Row {
          fill: width
          for a in cells { Cell { a: a; picked: false } }
          for n in range(0, cols - len(cells)) { Spacer { weight: 1 } }
        }
      }
    }
    Column {
      visible: !searching && shown == "personal" && folder != ""
      weight: 1
      fill: width
      gap: 12
      Row {
        align: center
        fill: width
        gap: 12
        padding: [8, 12]
        Text { text: "‹ Папки"; color: accent; fontSize: 16; padding: [8, 8]; onTap: folder = "" }
      }
      Column {
        lazy: true
        weight: 1
        fill: width
        padding: [4, 12]
        radius: 28
        frost: 24
        background: alpha(surface, 0.65)
        Text { text: folder; fontSize: 18; fontWeight: 600; fill: width; padding: [12, 12]; maxLines: 2 }
        for cells, i in folderRows key i {
          Row {
            fill: width
            for a in cells { Cell { a: a; picked: false } }
            for n in range(0, cols - len(cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    Column {
      visible: !searching && shown != "personal"
      lazy: true
      weight: 1
      fill: width
      gap: 0
      for row in rows key row.key {
        if row.title != null {
          // A section's title, with the work switch, the private space's lock and buttons, or the offer to install Linux at its end.
          Column {
            fill: width
            gap: 0
            Row {
              fill: width
              gap: 8
              align: center
              padding: [8, 12, 0, 4]
              Text { text: row.title; color: muted; weight: 1 }
              Text { text: d.work.paused ? "[turn on]" : "[pause]"; visible: row.work == true; color: accent; onTap: workApps("toggle") }
              // Unlocked: install apps into it, Android's settings for it (16 on), and the lock.
              Text { text: "[install]"; visible: row.private == true && !d.private.locked; color: accent; onTap: privateSpace("install") }
              Text { text: "[settings]"; visible: row.private == true && !d.private.locked && d.private.settings; color: accent; onTap: privateSpace("settings") }
              Text { text: d.private.locked ? "[unlock]" : "[lock]"; visible: row.private == true; color: accent; onTap: privateSpace("toggle") }
              Text { text: d.linux == "installing" ? "[installing…]" : "[install linux]"; visible: row.offer == true; color: accent; onTap: launcher("linux") }
            }
            // Before Android 16 has a setting for it, the drawer keeps its own: hiding the tab while the space is locked.
            Row {
              visible: row.private == true && !d.private.locked && !d.private.settings
              fill: width
              gap: 8
              align: center
              padding: [8, 12, 0, 4]
              Text { text: "hide while locked"; color: muted; weight: 1 }
              Text { text: d.private.hidden ? "[on]" : "[off]"; color: accent; onTap: privateSpace(d.private.hidden ? "show" : "hide") }
            }
          }
        } else {
          Row {
            fill: width
            gap: 0
            for a in row.cells { Cell { a: a; picked: false } }
            // A short last row keeps its cells the width of the others'.
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    Column {
      visible: searching && len(hits) == 0
      fill: width
      padding: [16, 32]
      gap: 8
      Text { text: "Ничего не найдено"; fontSize: 18; align: center }
      Text { text: "Попробуйте другое название"; fontSize: 13; color: muted; align: center }
    }
    Column {
      visible: searching
      lazy: true
      weight: 1
      fill: width
      gap: 0
      for row in hitRows key row.key {
        Row {
          fill: width
          gap: 0
          for a, i in row.cells { Cell { a: a; picked: row.start + i == chosen } }
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
    Row {
      visible: offersPrivate
      fill: width
      gap: 4
      padding: [12, 10]
      onTap: privateSpace("unlock")
      Text { text: "🔒"; color: muted }
      Text { text: "unlock private space"; color: foreground; weight: 1 }
    }
    Spacer { height: screenInset }
  }
}
