widget "buddha-meditation" {
  size: 4x4
  minSize: 2x2
  padding: 0
  background: "#050810"
  meta {
    description: "A serene Buddha meditating by a moonlit lake, with drifting stars, shooting stars and rippling reflections"
    version: "1.0"
    license: "MIT"
    category: "fun"
    owl: 6
  }

  requires { pacman: [] }

  onTap: screen()

  let buddha = [
    "................................................................",
    "................................................................",
    "................................................................",
    "................................................................",
    "................................................................",
    "...............................JJ...............................",
    "..............................JJJJ..............................",
    "...........................hHHHHHHHHh...........................",
    "..........................HhHHHHHHHHhH..........................",
    ".........................hhHHHHHHHHHHhh.........................",
    "........................HhHHHHHHHHHHHHhH........................",
    ".......................hhHHHHHHHHHHHHHHhh.......................",
    "......................HhHHHHHHHHHHHHHHHHhH......................",
    "......................hhHHHHHHHHHHHHHHHHhh......................",
    "......................HhHHHHHHHHHHHHHHHHhH......................",
    "......................hhHHHHHHHHHHHHHHHHhh......................",
    "......................HhhSSSSSSSSSSSSSShhH......................",
    "......................stSSSSSSGGGGSSSSSSts......................",
    "......................stSkkkssSSSSsskkkSts......................",
    "......................stSSSSSSSSSSSSSSSSts......................",
    "......................stSsekksSSSSskkesSts......................",
    "......................stSSSSSSSssSSSSSSSts......................",
    ".......................tSSSSSSsttsSSSSSSt.......................",
    ".......................tSSSSSSSSSSSSSSSSt.......................",
    ".......................tSSSSSsLLLLsSSSSSt.......................",
    "........................sSSSSSSSSSSSSSSs........................",
    ".........................sSSSSSSSSSSSSs.........................",
    "..........................sSSSSSSSSSSs..........................",
    "...........................tsttssttst...........................",
    "...........................sstSSSStss...........................",
    ".......................sSSSSSSSSsRRRRRRRRs......................",
    "......................WsSSSSSSSSsYRRRRRRRRs.....................",
    "....................WWsSSSSSSSSSsYYrRRRRRRRs....................",
    "...................WWsSSSSSSSSSSsYYrrRRRRRRRs...................",
    "...................WsSSSSSSSSSSSsYYrrRRRRRRRs...................",
    "...................sSSSSSSSSSSSSrrYYrrRRRRRRq...................",
    "...................sSSSSSSSSSSStqrrYYrrRRRRRq...................",
    "...................sSSSSSSSSSSqqqqrrYYrrRRRRq...................",
    "...................sSSSSSSSSqqRRqqrrYYrrRRRRq...................",
    "...................tSSSSSSSqqRRRqqrrYYrrRRRRq...................",
    "...................tSSSSSSqqRRRRqqrrYYrrRRRRq...................",
    "...................tSSSSSqqRRRRRqqrrYYrrRRRRq...................",
    "...................tsSSSSqqRRRRRqqrrYYrrRRRRq...................",
    "...................tsSSqqqRRRRRRqqrrYYrrRRRRq...................",
    "..................qqrrRRRRRRRtWWWWtRRRRRRRrrqq..................",
    "..................qqrrRRRRstWWtsstWWtsRRRRrrqq..................",
    "..................qqrRRRRstWWSSssSSWWtsRRRRrqq..................",
    "..................qqrRRRRsttSSSSSSSSsttRRRRrqq..................",
    "..................qqrRRRRrssssssssssssRRRRrqqq..................",
    "..................qqrRRRRRRRRRRRRRRRRRRRRRRrqq..................",
    "..................rRRRRRRRRRRRRRRRRRRRRRRRRRRr..................",
    ".................rYRRRRRRRRRRRRRRRRRRRRRRRRRRYr.................",
    "................rYYRRRRRRRRRRRRRRRRRRRRRRRRRRYYr................",
    "...............rYYRRRRRRRRRRRRRRRRRRRRRRRRRRRRYYr...............",
    "...............rrYRRRRRRRRRRRRRRRRRRRRRRRRRRRRYrr...............",
    "................qqrrRRRRRRRRRRRRRRRRRRRRRRRRrrqq................",
    "..................qqrRRRRRRRRRRRRRRRRRRRRRRrqq..................",
    "...................qqrrRRRRRRRRRRRRRRRRRRrrqq...................",
    "....................qqrrrRRRRRRqqRRRRRRrrrqq....................",
    ".....................qqqqrrrrrrqqrrrrrrqqqq.....................",
    ".......................qqqqqqqqqqqqqqqqqq.......................",
    "................................................................",
    "................................................................",
    "................................................................",
  ]

  component MeditationScene() {
    Canvas {
    // ---- responsive scaling: px drives the scene, ps the sprite ----
    let px = max(2, floor(min(width * 0.86 / 40, height * 0.62 / 36)))
    let ps = max(1, round(px * 0.625))
    let cx = floor(width / 2)
    let cx2 = cx - (cx % px) + (cx % px * 2 > px ? px : 0)
    let waterH = max(height * 0.22, 7 * px)
    let wl = height - waterH
    let reflF = clamp((waterH - 1.5 * px) / (64 * ps), 0.2, 0.85)
    let base = wl + 2 * px
    let sx2 = cx2 - 32 * ps
    let sy2 = base - 3 * px - 64 * ps
    let hx = cx2
    let hy = sy2 + 20 * ps
    let ngx = floor(width / px) + 1
    let ngy = max(2, floor(sy2 / px))

    // ---- sky: deep cosmic night gradient ----
    rect(0, -1, width, wl + 2, fill: linear(0, 0, 0, wl, ["#050810", "#0c152e", "#162348"]))

    // ---- distant mountains: 3 layered ridges with atmospheric depth ----
    // Layer 1: Distant soaring mountain peaks (soft misty indigo)
    for x in range(0, ngx + 1, 6) {
      let mh = (1.1 + sin(x * 0.12) * 0.60 + sin(x * 0.05 + 1.8) * 0.40) * 7 * px
      rect(x * px, wl - mh, 6 * px, mh + 1, fill: "#0a142c")
    }
    // Layer 2: Mid-range rolling hills with moonlit ridge silhouettes
    for x in range(0, ngx + 1, 6) {
      let mh = (0.7 + sin(x * 0.20 + 2.3) * 0.45 + sin(x * 0.08 + 0.9) * 0.35) * 5 * px
      rect(x * px, wl - mh, 6 * px, mh + 1, fill: "#0e1c3a")
      rect(x * px, wl - mh, 6 * px, max(1, round(px * 0.6)), fill: alpha("#243d70", 0.4))
    }
    // Layer 3: Near shoreline rolling hills along the horizon
    for x in range(0, ngx + 1, 8) {
      let mh = (0.4 + sin(x * 0.31 + 4.1) * 0.30 + sin(x * 0.11 + 3.2) * 0.20) * 3.5 * px
      rect(x * px, wl - mh, 8 * px, mh + 1, fill: "#132446")
    }

    // ---- stars: scattered, very slow drift + soft twinkle ----
    for i in range(18) {
      let h1 = sin(i * 12.9898 + 4.1414) * 43758.5453
      let r1 = h1 - floor(h1)
      let spd = 0.012 + r1 * 0.03
      let sx = (floor(r1 * ngx) + floor(time * spd)) % ngx
      let sy = floor(((sin(i * 78.233 + 1.23) * 12543.1) % 1 + 1) % 1 * ngy)
      let tw = 0.5 + 0.5 * sin(time * 0.7 + i * 1.7)
      rect(sx * px, sy * px, px, px, fill: alpha("#fbf6da", tw))
    }

    // ---- shooting stars: periodic streaks across the sky ----
    let ss1 = (time + 3.0) % 17
    if ss1 < 2.0 {
      let p = ss1 / 2.0
      let hdx = width * (0.94 - 0.55 * p)
      let hdy = height * (0.05 + 0.10 * p)
      for i in range(8) {
        rect(hdx + i * 0.9 * px, hdy - i * 0.5 * px, px * 0.8, px * 0.8, fill: alpha("#fff6cf", 0.8 * (1 - i / 8)))
      }
      circle(hdx, hdy, 1.4 * px, fill: alpha("#ffffff", 0.9))
    }
    let ss2 = (time + 12.0) % 27
    if ss2 < 1.6 {
      let p = ss2 / 1.6
      let hdx = width * (0.35 + 0.5 * p)
      let hdy = height * (0.03 + 0.09 * p)
      for i in range(8) {
        rect(hdx - i * 0.85 * px, hdy - i * 0.45 * px, px * 0.75, px * 0.75, fill: alpha("#fff6cf", 0.75 * (1 - i / 8)))
      }
      circle(hdx, hdy, 1.2 * px, fill: alpha("#ffffff", 0.85))
    }

    // ---- moon: drifts across the sky in a slow loop ----
    let moonT = (time / 600 + 0.45) % 1
    let mx = -10 * px + moonT * (width + 20 * px)
    let my = max(8 * px, hy - 25 * px - sin(moonT * 3.14159265) * 5 * px)
    circle(mx, my, 12 * px, fill: alpha("#f5e6a3", 0.04))
    circle(mx, my, 8 * px, fill: alpha("#f5e6a3", 0.08))
    circle(mx, my, 5 * px, fill: alpha("#f5e6a3", 0.2))
    circle(mx, my, 3.6 * px, fill: "#fdf4cb")

    // ---- golden halo: soft sacred aura behind the Buddha ----
    circle(hx, hy, 26 * ps, fill: alpha("#f2c94c", 0.03))
    circle(hx, hy, 19 * ps, fill: alpha("#f2c94c", 0.06))
    circle(hx, hy, 15.5 * ps, stroke: alpha("#ffd76e", 0.70), width: 1.5 * ps)
    circle(hx, hy, 18.5 * ps, stroke: alpha("#ffd76e", 0.30), width: 1.0 * ps)
    for a in range(8) {
      let ang = a * 0.785398
      let c = cos(ang)
      let s = sin(ang)
      line(hx + c * 19 * ps, hy + s * 19 * ps, hx + c * 23 * ps, hy + s * 23 * ps, stroke: alpha("#ffd76e", 0.5), width: 1.2 * ps)
    }

    // ---- lake: tranquil deep night waters ----
    rect(0, wl, width, height - wl + 1, fill: linear(0, wl, 0, height, ["#09152b", "#102347", "#19376d"]))

    // horizon mist glow along the shoreline
    rect(0, wl, width, max(1, round(px * 0.8)), fill: alpha("#8fbde8", 0.22))
    for x in range(0, ngx, 8) {
      let s = 0.5 + 0.5 * sin(x * 0.6 + time * 1.1)
      rect(x * px, wl + px, 8 * px, px, fill: alpha("#a6d1fc", 0.08 + 0.10 * s))
    }

    // moonlight trail on the water (shimmering lunar path)
    for yy in range(0, 10) {
      let ry = wl + (2 + yy * 2.2) * px
      let w = (3 + yy * 1.2 + (yy % 3)) * px
      let wob = round(sin(time * 0.8 + yy * 0.9) * px * 1.2)
      rect(mx - w + wob, ry, w * 2, px, fill: alpha("#fdf4cb", 0.18 - yy * 0.014))
    }

    // ---- reflection of the Theravada Buddha in the lake ----
    scale(1, -reflF, hx, wl) {
      sprite(buddha, sx2, sy2, ps, palette: {
        J: "#3a4a68",
        H: "#0e1526", h: "#121b30",
        W: "#38567c", S: "#2e486d", s: "#253b5c", t: "#1d2f4d",
        G: "#526c8e", k: "#0d1628", L: "#3a2e4a",
        Y: "#526478", R: "#354764", r: "#2b3b55", q: "#202e45",
      })
    }

    // ---- ripples: layered rhythmic water with crests and glitter ----
    for wave in range(4) {
      let freq = 0.24 + wave * 0.05
      let spd = 0.50 + wave * 0.11
      let row0 = 2.0 + wave * 2.4
      for x in range(0, ngx, 3) {
        let s = sin(x * freq + time * spd + wave * 2.1)
              + sin(x * freq * 1.9 - time * spd * 0.6 + wave) * 0.45
              + sin(x * freq * 3.3 + time * spd * 1.4 + wave * 0.7) * 0.20
        let yy = wl + (row0 + floor((s + 1.6) * 1.2)) * px
        let wa = (0.62 - wave * 0.10) * clamp((s - 0.2) * 1.6, 0, 1)
        if yy < height - px && wa > 0.03 {
          let shade = s > 1.15 ? "#eef7ff" : s > 0.9 ? "#d3e9ff" : s > 0.55 ? "#8fbde8" : "#4a78b0"
          rect(x * px, yy, 3 * px, px, fill: alpha(shade, wa))
          // crest glint riding the top of a strong ripple
          if s > 1.05 {
            let gx = x + floor(abs(sin(x * 2.7 + time * 0.9)) * 3)
            rect(gx * px, yy - px, px, px, fill: alpha("#f6fbff", wa))
          }
        }
      }
    }

    // ---- Theravada Buddha (seated in meditation at water's edge) ----
    sprite(buddha, sx2, sy2, ps, palette: {
      J: "#ffd76e",
      H: "#1a1622", h: "#2e2538",
      W: "#fae8d4", S: "#f5cfab", s: "#dfb084", t: "#ba885a",
      G: "#ffd76e", k: "#1f1208", L: "#cf6c66",
      Y: "#fab839", R: "#ea7e18", r: "#c25f0e", q: "#8c3e06",
    })
    }
  }

  MeditationScene { fill: true }

  screen {
    title: "Медитация"
    MeditationScene { fill: true }
  }
}
