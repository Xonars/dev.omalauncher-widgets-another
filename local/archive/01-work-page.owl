page "Работа" {
  page: -1
  meta { owl: 11; description: "Рабочая страница: фокус на задаче, таймер с паузой и общая заметка"; version: "1.1"; license: "MIT"; category: "productivity" }
  requires { pacman: ["python"] }
  padding: 0
  background: alpha(background, 0.95)
  let card = alpha(surface, 0.85)
  let secondary = mix(muted, foreground, 0.45)
  source data = cmd("python ~/.config/omalauncher/widgets/today-hub/data.py read") every 10s json
  source now = clock every 1s
  state endsAt = 0 persist
  state duration = 1500 persist
  state remaining = 1500 persist
  state session = false persist
  state isBreak = false persist
  state breakReady = false persist
  state focusText = "" persist
  state focusLine = -1 persist
  state draft = ""
  at endsAt {
    notify(isBreak ? "Перерыв завершён" : "Фокус завершён", isBreak ? "Можно вернуться к работе." : "Время отдохнуть — сделайте перерыв на 5 минут.")
    breakReady = !isBreak
    endsAt = 0
    session = false
    remaining = duration
  }
  let items = data.items ?? []
  let secondsLeft = max(0, ceil(endsAt > 0 ? endsAt - now : remaining))
  let running = endsAt > 0
  Column {
    fill: true; scroll: true; padding: [20, 16]; gap: 16
    Text { text: "РАБОТА"; style: label; color: accent; letterSpacing: 2 }
    Text { text: "Одна задача за раз"; fontSize: 30; fontWeight: 300 }
    Column {
      padding: 16; gap: 12; background: card; radius: 14 * corners
      Row {
        align: center
        Text { text: isBreak ? "ПЕРЕРЫВ" : "ФОКУС"; style: label; color: accent; weight: 1 }
        Text { text: session ? (running ? "Идёт отсчёт" : "Пауза") : "Готов к запуску"; style: small; color: secondary }
      }
      Text { text: isBreak ? "Время отдохнуть" : focusText == "" ? "Выберите задачу ниже или начните без неё" : focusText; color: secondary; maxLines: 3 }
      Text { text: "${pad(floor(secondsLeft / 60), 2, '0')}:${pad(secondsLeft % 60, 2, '0')}"; fontSize: 56; fontWeight: 300 }
      Progress { value: session ? clamp((duration - secondsLeft) / duration * 100, 0, 100) : 0 }
      if !session {
        Row {
          gap: 8
          for minutes in [15, 25, 50] {
            Button { text: "${minutes} мин"; color: !isBreak && duration == minutes * 60 ? accent : secondary; onTap: { duration = minutes * 60; remaining = duration; isBreak = false } }
          }
        }
      }
      Row {
        gap: 8
        Button {
          text: running ? "Пауза" : session ? "Продолжить" : "Начать"
          onTap: {
            if running { remaining = max(1, ceil(endsAt - now)); endsAt = 0 }
            else { endsAt = now + remaining; session = true; breakReady = false }
          }
        }
        if session || isBreak {
          Button { text: "Сбросить"; onTap: { endsAt = 0; session = false; isBreak = false; duration = 1500; remaining = duration; breakReady = false } }
        }
      }
      if breakReady && !session {
        Button { text: "Перерыв 5 минут"; onTap: { isBreak = true; duration = 300; remaining = duration; endsAt = now + remaining; session = true; breakReady = false } }
      }
    }
    Column {
      padding: 16; gap: 10; background: card; radius: 14 * corners
      Text { text: "ЗАДАЧИ · ${len(items)}"; style: label; color: accent }
      if data == null { Text { text: "Загрузка…"; color: secondary } }
      else if len(items) == 0 { Text { text: "Все задачи выполнены"; color: secondary } }
      for item in items.take(30) key item.line {
        Row {
          align: center; gap: 8
          Text { text: item.text; weight: 1; maxLines: 4; color: focusLine == item.line && focusText == item.text ? accent : foreground }
          Button { text: focusLine == item.line && focusText == item.text ? "В фокусе" : "Фокус"; onTap: { focusLine = item.line; focusText = item.text } }
          Button { text: "✓"; onTap: { run("python ~/.config/omalauncher/widgets/today-hub/data.py done ${int(item.line)} ${sh(item.text)}"); if focusLine == item.line && focusText == item.text { focusLine = -1; focusText = "" } } }
        }
      }
      Input { placeholder: "Новая задача…"; clear: true; color: foreground; onSubmit: run("python ~/.config/omalauncher/widgets/today-hub/data.py add ${sh(value)}") }
    }
    Column {
      padding: 16; gap: 10; background: card; radius: 14 * corners
      Row {
        align: center
        Text { text: "ЗАМЕТКА ДНЯ"; style: label; color: accent; weight: 1 }
        Button { text: "Изменить"; onTap: { draft = data.note ?? ""; screen() } }
      }
      Text { text: data.note == "" || data.note == null ? "Пока нет заметки" : data.note; maxLines: 12; color: data.note == "" || data.note == null ? secondary : foreground }
    }
    Text { text: "Задачи и заметка общие со страницей Сегодня"; style: small; color: secondary; maxLines: 2 }
    Spacer { height: screenInset }
  }
  screen {
    title: "Заметка дня"
    Column {
      padding: 16; gap: 14; scroll: true
      Input { text: draft; placeholder: "Что нужно запомнить?"; color: foreground; focus: true; onChange: draft = value; onSubmit: { run("python ~/.config/omalauncher/widgets/today-hub/data.py note ${sh(value)}"); close() } }
      Button { text: "Сохранить"; onTap: { run("python ~/.config/omalauncher/widgets/today-hub/data.py note ${sh(draft)}"); close() } }
      Text { text: "Изменения появятся и на странице Сегодня"; style: small; color: secondary; maxLines: 2 }
    }
  }
}
