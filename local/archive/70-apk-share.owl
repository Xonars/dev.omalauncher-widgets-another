widget "APK Share" {
  page: 2
  order: 2
  size: 6x5
  minSize: 4x4
  padding: 16
  meta { owl: 6; description: "Share locally built APK files with Android through an APK-only Python HTTP server."; version: "1.1"; license: "MIT"; category: "dev" }
  requires { pacman: ["python"] }
  state directory = "~/APK" persist
  state bindAddress = "127.0.0.1" persist
  state operation = ""
  source server = cmd("python ~/.config/omalauncher/widgets/apk-share/backend.py status --directory ${sh(directory)}") every 2s json timeout 30s
  source listing = cmd("python ~/.config/omalauncher/widgets/apk-share/backend.py list --directory ${sh(directory)}") every 60s json timeout 30s
  let address = server.url ?? "http://127.0.0.1:8765/"
  let running = server.status == "Running"
  let statusColor = running ? green : server.status == "Error" ? red : muted
  onTap: screen()

  component Rule() {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }
  component Heading(label) {
    Text { text: label; style: label; color: accent }
  }
  component Controls() {
    Row {
      gap: 6
      wrap: true
      Button { text: "Start"; onTap: { operation = run("python ~/.config/omalauncher/widgets/apk-share/backend.py start --directory ${sh(directory)} --bind ${sh(bindAddress)}"); refresh() } }
      Button { text: "Stop"; color: muted; onTap: { operation = run("python ~/.config/omalauncher/widgets/apk-share/backend.py stop"); refresh() } }
      Button { text: "Refresh"; color: muted; onTap: refresh() }
      Button { text: "Copy URL"; color: accent; onTap: copy(address) }
    }
  }
  component FileList(limit = 4, details = true) {
    Column {
      gap: 10
      if len(listing.files ?? []) == 0 {
        Text { text: listing.error != "" && listing.error != null ? listing.error : "No APK files · choose a directory in Settings"; style: small; color: muted }
      }
      for apk in take(listing.files ?? [], limit) {
        Column {
          gap: 3
          Text { text: apk.name; style: body; color: foreground; maxLines: 1 }
          Text { text: "${fmtBytes(apk.size)} · ${fmtTime(apk.mtime, "dd MMM yyyy HH:mm")}"; style: small; color: muted; maxLines: 1 }
          if details {
            Text { text: apk.path; style: small; color: muted; maxLines: 1 }
          }
          if running && listing.directory == server.directory {
            Button { text: "Download"; onTap: url(address + sub(apk.url, 1, len(apk.url))) }
          }
          Rule { }
        }
      }
    }
  }
  Column {
    fill: true
    gap: 8
    Row {
      align: center
      Text { text: "APK SHARE"; style: label; color: accent; width: 160; maxLines: 1 }
      Text { text: server.status ?? "…"; style: small; color: statusColor; width: 100; maxLines: 1; align: end }
    }
    Rule { }
    Text { text: address; style: small; color: accent; onTap: url(address); maxLines: 1 }
    Controls { }
    if server.error != "" && server.error != null {
      Text { text: server.error; style: small; color: red; maxLines: 2 }
    }
    Column { weight: 1; scroll: true; FileList { limit: 4; details: false } }
    Row {
      Text { text: "${listing.count ?? 0} APK · port 8765"; style: small; color: muted; weight: 1 }
      Button { text: "Settings / All"; onTap: screen() }
    }
  }
  screen {
    title: "APK Share"
    Column {
      fill: true
      padding: 12
      scroll: true
      gap: 12
      Row {
        align: center
        Text { text: "SERVER"; style: label; color: accent; width: 90; maxLines: 1 }
        Text { text: "${server.status ?? "…"} · port 8765"; style: small; color: statusColor; width: 200; maxLines: 1 }
      }
      Rule { }
      Text { text: address; color: accent; onTap: url(address) }
      Controls { }
      if server.error != "" && server.error != null {
        Text { text: server.error; style: small; color: red }
      }
      Rule { }
      Heading { label: "SETTINGS" }
      Text { text: "APK directory (absolute path or ~/...)"; style: small; color: muted }
      Input { color: foreground; text: directory; placeholder: "~/projects/my-app"; onChange: directory = value; onSubmit: { directory = trim(value); refresh() } }
      Text { text: "Listen address · default 127.0.0.1"; style: small; color: muted }
      Input { color: foreground; text: bindAddress; placeholder: "127.0.0.1"; onChange: bindAddress = value; onSubmit: bindAddress = trim(value) }
      Text { text: "Press Start to apply changes and enable file links. A different address may expose APKs to your network. For 0.0.0.0 use the Linux host IP in Android's browser."; style: small; color: muted }
      Text { text: "Serving: ${server.directory ?? "—"}"; style: small; color: muted }
      Button { text: "Open in Android browser"; onTap: url(address) }
      Rule { }
      Heading { label: "APK FILES" }
      Text { text: "${listing.count ?? 0} APK · newest first · Start enables downloads"; style: small; color: muted }
      FileList { limit: 150 }
      if (listing.count ?? 0) > 150 {
        Text { text: "Showing latest 150. The browser lists all APKs."; style: small; color: muted }
      }
    }
  }
}
