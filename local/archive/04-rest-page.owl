page "Отдых" {
  page: -4
  meta { owl: 11; description: "Персональная страница: Отдых"; version: "1.0"; license: "MIT"; category: "productivity" }
  padding: 0
  background: alpha(background, 0.95)
  let card = alpha(surface, 0.85)
  source m = android.media
  source vol = android.volume
  source apps = android.apps
  source now = clock every 1m
  let choices = (apps ?? []).filter(a => contains(lower(a.name), "music") || contains(lower(a.name), "музык") || contains(lower(a.name), "youtube") || contains(lower(a.name), "spotify") || contains(lower(a.name), "radio")).take(8)
  Column {
    fill: true; scroll: true; padding: [20, 16]; gap: 16
    Text { text: "ОТДЫХ"; style: label; color: accent; letterSpacing: 2 }
    Text { text: "Можно сделать паузу"; fontSize: 30; fontWeight: 300 }
    Text { text: fmtTime(now, "HH:mm"); fontSize: 64; fontWeight: 200; color: muted }
    Column {
      padding: 16; gap: 14; background: card; radius: 14 * corners
      Text { text: "МУЗЫКА"; style: label; color: accent }
      if m.art != null { Image { src: m.art; height: 180; fill: width } }
      Text { text: m.title ?? "Выберите музыку"; fontSize: 24; maxLines: 3 }
      Text { text: m.artist ?? (m.available ? "Проигрыватель пока не запущен" : "Нужен доступ к уведомлениям"); color: muted; maxLines: 3 }
      Row {
        gap: 8
        Button { text: "←"; weight: 1; onTap: media("previous") }
        Button { text: m.playing ? "Пауза" : "Играть"; weight: 2; onTap: media("toggle") }
        Button { text: "→"; weight: 1; onTap: media("next") }
      }
      Button { text: "Открыть проигрыватель"; onTap: media("open") }
      Text { text: "Громкость · ${vol.level ?? 0}%"; style: small; color: muted }
      Slider { value: vol.level ?? 0; onChange: volume(value) }
    }
    Text { text: "Музыка и видео"; style: title }
    for a in choices key a.key {
      Row {
        gap: 12; align: center; padding: 12; background: card; radius: 14 * corners; onTap: androidApp(a.key)
        Image { src: a.icon; size: 36 }
        Text { text: a.name; weight: 1; maxLines: 1 }
        Text { text: "→"; color: accent }
      }
    }
    Button { text: "Все приложения"; onTap: launcher("drawer") }
    Text { text: "Радио, винил, пруд и анимации — на странице плиток 4"; style: small; color: muted; maxLines: 3 }
    Spacer { height: screenInset }
  }
}
