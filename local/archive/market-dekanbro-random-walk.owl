widget "random walk" {
  page: 4
  order: 7
  meta {
    description: "Long random walks that double back. Tap the ink for a new one. The gear sets iterations, speed and ink."
    version: "1.0"
    license: "MIT"
    category: "fun"
    owl: 7
  }
  size: 6x4
  minSize: 3x3
  padding: 0
  background: background
  requires { pacman: [] }

  // No shell. The canvas keeps no pixels, so each frame rebuilds the walk
  // from its seed. A tap is the only thing that starts a draw.
  source now = clock every 1s
  state beat = 0
  state nudge = 0 persist
  state born = 0
  state steps = 400 persist
  state speed = 26 persist
  state ink = "color" persist
  state sheet = "ink"
  state span = 26
  state closed = 0
  state kick = 0
  state built = 0

  // Right on the slider is faster. 26 is the middle, and the old 26s draw.
  // span is how long this draw lasts, captured when it starts, so moving the
  // slider does not pull the pen backward.
  let drawFor = clamp(52 - int(speed), 4, 48)
  let seed = nudge + 1
  let n = int(clamp(steps, 80, 1000))
  let want = int(n) + int(seed) * 100000
  // Copies saved before the cap could sit above 1000.
  when steps > 1000 { steps = 1000 }
  // Bank the frame time since `beat`, not `now - born`. A tap falls inside
  // the current second, and the unix clock would count that partial second
  // as a whole one. `kick` moves once after a new walk is built.
  on now {
    closed = born > 0 && now != null && closed < span && (time - beat) >= 0 && (time - beat) < 2 ? min(span, closed + min(time - beat, 0.999)) : closed
    beat = born > 0 && now != null && closed < span ? time : beat
    kick = built != want ? kick + 1 : kick
    built = want
  }
  let drawing = born > 0 && closed < span
  // A fraction that has just passed one second still counts. Dropping it
  // snapped the pen back for a frame.
  let ahead = drawing ? time - beat : 0
  let frac = ahead >= 0 && ahead < 2 ? min(ahead, 0.999) : 0
  let reveal = drawing ? clamp((closed + frac) / span, 0, 1) : 1
  let salt = int(seed) % 4096 + 1
  // One unit float per step. Built in bulk: a hash call per step blows the
  // update budget once the walk gets long.
  let wave = s => range(n).map(i => sin((i + 1) * 12.9898 + s * 78.233) * 43758.5453).map(z => z - floor(z))

  // Inclusive prefix sums. The index is clamped because both sides of the
  // condition can run. The 512 pass covers a walk of 1000 steps.
  let prefix = a => ([a]
    .map(p => range(n).map(i => p[i] + (i >= 1 ? p[max(i - 1, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 2 ? p[max(i - 2, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 4 ? p[max(i - 4, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 8 ? p[max(i - 8, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 16 ? p[max(i - 16, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 32 ? p[max(i - 32, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 64 ? p[max(i - 64, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 128 ? p[max(i - 128, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 256 ? p[max(i - 256, 0)] : 0)))
    .map(p => range(n).map(i => p[i] + (i >= 512 ? p[max(i - 512, 0)] : 0))))[0]

  // [strand, initial heading]. Most steps bend a little. About one in eight
  // may turn far enough to double back.
  let specs = [
    [0, 0.2],
    [1, 3.0]
  ]
  // Color runs along each walk, then the second walk starts halfway around.
  // b&w stays on foreground, theme stays on the accent, color is the rainbow.
  let rainbow = [cyan, blue, magenta, red, orange, yellow, green]
  let paper = [foreground, mix(foreground, background, 0.28), mix(foreground, background, 0.62), foreground, mix(foreground, background, 0.45), mix(foreground, background, 0.16), foreground]
  let themed = [accent, mix(accent, foreground, 0.28), mix(accent, foreground, 0.62), foreground, mix(accent, foreground, 0.62), mix(accent, foreground, 0.28), accent]
  let stops = ink == "bw" ? paper : (ink == "theme" ? themed : rainbow)

  let strand = spec => [[
      [salt + 17 + spec[0] * 97].map(wave)[0],
      [salt + 51 + spec[0] * 97].map(wave)[0],
      [salt + 89 + spec[0] * 97].map(wave)[0],
      [salt + 419 + spec[0] * 13].map(wave)[0]
    ]]
    .map(h => range(n).map(i => [
      h[0][i] < 0.12 ? (h[1][i] - 0.5) * 4.4 : (h[2][i] - 0.5) * 0.85,
      0.85 + 0.4 * h[3][i]
    ]))
    .map(raw => [raw, [raw.map(s => s[0])].map(prefix)[0]])
    .map(pair => range(n).map(i => [pair[1][i] + spec[1], pair[0][i][1]]))
    .map(legs => [legs.map(s => cos(s[0]) * s[1]), legs.map(s => sin(s[0]) * s[1])])
    .map(cs => [[cs[0]].map(prefix)[0], [cs[1]].map(prefix)[0]])
    .map(xy => range(n).map(i => [xy[0][i], xy[1][i]]))[0]
  // Each strand is its own value, so a long walk does not have to fit in one
  // update together with its twin.
  let walk0 = [specs[0]].map(strand)[0]
  let walk1 = [specs[1]].map(strand)[0]
  let walks = [walk0, walk1]

  component Ink() {
    Canvas {
      fill: true
      // `kick * 0` repaints once after a new walk lands, without changing
      // the count. The frame is the finished walk, so a new extreme does
      // not rescale the picture. It stays in here so it does not share the
      // walk's update.
      let count = floor(reveal * n) + kick * 0
      let w0 = count >= 1 && walks[0] != null ? walks[0].take(count) : [[0, 0]]
      let w1 = count >= 1 && walks[1] != null ? walks[1].take(count) : [[0, 0]]
      let full0 = walks[0] != null ? walks[0] : [[0, 0]]
      let full1 = walks[1] != null ? walks[1] : [[0, 0]]
      let x0s = full0.map(p => p[0])
      let y0s = full0.map(p => p[1])
      let x1s = full1.map(p => p[0])
      let y1s = full1.map(p => p[1])
      let minX = min(min(min(x0s), min(x1s)), 0)
      let maxX = max(max(max(x0s), max(x1s)), 0)
      let minY = min(min(min(y0s), min(y1s)), 0)
      let maxY = max(max(max(y0s), max(y1s)), 0)
      let rawW = max(maxX - minX, 0.001)
      let rawH = max(maxY - minY, 0.001)
      let bw = max(rawW, 10)
      let bh = max(rawH, 10)
      let x0 = minX - (bw - rawW) / 2
      let y0 = minY - (bh - rawH) / 2
      let pad = clamp(min(width, height) * 0.08, 32, 48)
      let sc = min((width - pad * 2) / bw, (height - pad * 2) / bh)
      let ox = (width - bw * sc) / 2 - x0 * sc
      let oy = (height - bh * sc) / 2 - y0 * sc
      let bands = 16
      let last = len(stops) - 1
      // Slice each walk once. Taking a fresh copy per glow and ink pass
      // overflows the update once the walk is long.
      let segs = [w0, w1].map(pts => range(bands).map(b => floor(b * count / bands) == 0
        ? [[0, 0]] + pts.take(floor((b + 1) * count / bands))
        : pts.take(floor((b + 1) * count / bands)).drop(floor(b * count / bands) - 1)))

      rect(0, 0, width, height, fill: background)

      // Glow, then the ink, so a crossing doesn't wash the line out. Each band
      // is one step of the gradient. Bands share an endpoint, so the stroke
      // doesn't break. The walk stays in its own coordinates.
      let pen = max(sc, 0.001)
      translate(ox, oy) {
        scale(pen, pen, 0, 0) {
          for line, si in segs {
            for seg, b in line {
              if len(seg) > 1 {
                let a0 = floor(b * count / bands)
                let a1 = floor((b + 1) * count / bands)
                let t = ((a0 + a1) / 2 / n + si * 0.5) % 1
                let g = t * last
                let i0 = min(floor(g), last - 1)
                let col = mix(stops[i0], stops[i0 + 1], g - i0)
                path(seg, stroke: alpha(col, 0.2), width: 7 / pen, cap: round)
              }
            }
          }
          for line, si in segs {
            for seg, b in line {
              if len(seg) > 1 {
                let a0 = floor(b * count / bands)
                let a1 = floor((b + 1) * count / bands)
                let t = ((a0 + a1) / 2 / n + si * 0.5) % 1
                let g = t * last
                let i0 = min(floor(g), last - 1)
                let col = mix(stops[i0], stops[i0 + 1], g - i0)
                path(seg, stroke: mix(col, foreground, 0.12), width: (a1 >= count ? 3.3 : 2.5) / pen, cap: round)
              }
            }
          }
        }
      }
      if count >= 1 {
        circle(ox, oy, 2.6, fill: stops[0])
        for pts, si in walks {
          if pts != null {
            let t = ((count - 1) / n + si * 0.5) % 1
            let g = t * last
            let i0 = min(floor(g), last - 1)
            let col = mix(stops[i0], stops[i0 + 1], g - i0)
            let tip = pts[count - 1]
            circle(ox + tip[0] * sc, oy + tip[1] * sc, 7, fill: alpha(col, 0.35))
            circle(ox + tip[0] * sc, oy + tip[1] * sc, 2.8, fill: foreground)
          }
        }
      }
    }
  }

  Box {
    fill: true
    Ink { fill: true }
    Column {
      fill: true
      Row {
        fill: width
        height: 32
        Text {
          text: "walk"
          width: 72
          style: label
          color: alpha(foreground, 0.5)
          padding: [14, 10, 0, 0]
          onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
        }
        Box {
          weight: 1
          fill: true
          onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
        }
        Text {
          text: "⤢"
          width: 36
          height: 32
          align: center
          color: alpha(foreground, 0.62)
          fontSize: 16
          padding: [0, 4, 6, 0]
          onTap: { sheet = "ink"; screen(); haptic() }
        }
      }
      Box {
        weight: 1
        fill: true
        onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
      }
      Row {
        fill: width
        height: 40
        padding: [8, 0, 8, 8]
        align: bottom
        Box {
          weight: 1
          fill: true
          onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
        }
        Text {
          text: "⚙"
          width: 28
          height: 28
          align: center
          color: alpha(foreground, 0.85)
          fontSize: 15
          background: alpha(background, 0.62)
          radius: 14 * corners
          onTap: { sheet = "settings"; screen(); haptic() }
        }
      }
    }
  }

  screen {
    title: sheet == "settings" ? "settings" : "random walk"
    if sheet == "settings" {
      Column {
        fill: true
        scroll: true
        gap: 0
        Box {
          height: max(180, (screenHeight ?? 700) * 0.32)
          fill: width
          onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
          Ink { fill: true }
        }
        Text {
          text: "tap the preview to draw"
          style: muted
          align: center
          padding: [12, 6, 12, 0]
        }
        Column {
          padding: [20, 8, 20, 16]
          gap: 18
          Column {
            gap: 6
            Row {
              fill: width
              align: center
              Text { text: "iterations"; style: label; color: muted; weight: 1 }
              Text { text: "${n}"; font: mono; style: small; width: 56; align: end; maxLines: 1 }
            }
            Slider {
              value: steps
              min: 80
              max: 1000
              step: 20
              fill: width
              onChange: steps = int(clamp(value, 80, 1000))
            }
          }
          Column {
            gap: 6
            Row {
              fill: width
              align: center
              Text { text: "speed"; style: label; color: muted; weight: 1 }
              Text { text: "${drawFor}s"; font: mono; style: small; width: 48; align: end; maxLines: 1 }
            }
            Row {
              align: center
              gap: 8
              Text { text: "slow"; style: small; color: muted; width: 40 }
              Slider {
                value: speed
                min: 4
                max: 48
                step: 2
                live: true
                weight: 1
                onChange: speed = int(clamp(value, 4, 48))
              }
              Text { text: "fast"; style: small; color: muted; width: 40; align: end }
            }
          }
          Column {
            gap: 8
            Text { text: "ink"; style: label; color: muted }
            Row {
              gap: 8
              fill: width
              Text {
                text: "b&w"
                weight: 1
                style: small
                bold: ink == "bw"
                align: center
                maxLines: 1
                padding: [10, 8]
                radius: 3 * corners
                color: ink == "bw" ? background : foreground
                background: ink == "bw" ? accent : alpha(surface, 0.6)
                onTap: { ink = "bw"; haptic() }
              }
              Text {
                text: "color"
                weight: 1
                style: small
                bold: ink == "color"
                align: center
                maxLines: 1
                padding: [10, 8]
                radius: 3 * corners
                color: ink == "color" ? background : foreground
                background: ink == "color" ? accent : alpha(surface, 0.6)
                onTap: { ink = "color"; haptic() }
              }
              Text {
                text: "theme"
                weight: 1
                style: small
                bold: ink == "theme"
                align: center
                maxLines: 1
                padding: [10, 8]
                radius: 3 * corners
                color: ink == "theme" ? background : foreground
                background: ink == "theme" ? accent : alpha(surface, 0.6)
                onTap: { ink = "theme"; haptic() }
              }
            }
          }
          Text {
            text: "done"
            align: center
            color: accent
            padding: [8, 14]
            onTap: { sheet = "ink"; haptic() }
          }
        }
      }
    } else {
      Column {
        fill: true
        Box {
          weight: 1
          fill: width
          onTap: { nudge = nudge + 1; born = now; beat = time; span = drawFor; closed = 0; haptic() }
          Ink { fill: true }
        }
        Row {
          fill: width
          height: 48
          padding: [16, 0, 12, 10]
          align: center
          Text {
            text: "tap the ink for another"
            style: muted
            align: center
            weight: 1
          }
          Text {
            text: "⚙"
            width: 32
            height: 32
            align: center
            color: alpha(foreground, 0.85)
            fontSize: 16
            background: alpha(background, 0.62)
            radius: 16 * corners
            onTap: { sheet = "settings"; haptic() }
          }
        }
      }
    }
  }
}
