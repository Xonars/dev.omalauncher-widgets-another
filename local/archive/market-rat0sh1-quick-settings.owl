widget "quick settings" {
  // Quick settings in Omarchy's style: Wi-Fi, mobile data, flashlight, media, Do Not Disturb and btop in one row
  // on square tiles, set in JetBrains Mono. Wi-Fi, data and Do Not Disturb go over adb to the phone itself.

  meta { owl: 11; description: "Compact Omarchy-style quick settings in one row: Wi-Fi, mobile data, flashlight, media, Do Not Disturb and btop. Wi-Fi, data and DND use wireless adb"; version: "1.2"; license: "MIT"; category: "system" }
  requires { pacman: ["btop", "android-tools", "jq", "gawk", "bash", "coreutils", "grep", "sed"] }

  size: 8x2
  minSize: 6x2

  source v = android.volume
  source modes = android.modes

  // Wi-Fi, mobile data and the SIMs, read over adb from the phone itself (wireless debugging, as 127.0.0.1:5555).
  // The adb server forgets that connection when Linux restarts, so connect first; if the phone rebooted, put adbd
  // back on port 5555 through any other device adb still has (the paired wireless-debugging one).
  source net = cmd("""
    d=127.0.0.1:5555
    if ! timeout 4 adb -s $d shell true >/dev/null 2>&1; then
      adb disconnect $d >/dev/null 2>&1
      timeout 4 adb connect $d >/dev/null 2>&1
      if ! timeout 4 adb -s $d shell true >/dev/null 2>&1; then
        o=$(adb devices | awk -v d=$d 'NR > 1 && $2 == "device" && $1 != d && $1 !~ /^emulator-/ { print $1; exit }')
        [ -n "$o" ] && timeout 6 adb -s "$o" tcpip 5555 >/dev/null 2>&1 && sleep 2 && timeout 4 adb connect $d >/dev/null 2>&1
      fi
    fi
    out=$(timeout 10 adb -s $d shell '
      w=$(cmd wifi status)
      s=$(dumpsys isub)
      sub=$(echo "$s" | sed -n "s/^ *defaultDataSubId=//p" | head -1)
      echo "wifi=$(echo "$w" | grep -q "^Wifi is enabled" && echo true || echo false)"
      echo "ssid=$(echo "$w" | sed -n "s/^Wifi is connected to \"\(.*\)\"$/\1/p" | head -1)"
      echo "sub=$sub"
      echo "data=$(settings get global mobile_data$sub)"
      echo "$s" | grep "SubscriptionInfoInternal: id="
    ' 2>/dev/null | tr -d '\r')
    v() { echo "$out" | sed -n "s/^$1=//p" | head -1; }
    sims=$(echo "$out" | sed -n 's/.*SubscriptionInfoInternal: id=\([0-9]*\) .* simSlotIndex=\([0-9][0-9]*\) .* displayName=\(.*\) carrierName=.*/\1\t\2\t\3/p' | sort -u |
      jq -Rnc '[inputs | split("\t") | {id: (.[0] | tonumber), slot: (.[1] | tonumber), name: .[2]}]')
    jq -nc --arg out "$out" --arg wifi "$(v wifi)" --arg ssid "$(v ssid)" --arg sub "$(v sub | tr -dc 0-9)" \
      --arg data "$(v data)" --argjson sims "$sims" \
      '{ok: ($out != ""), wifi: ($wifi == "true"), ssid: $ssid, sub: (($sub | tonumber?) // 0), data: ($data == "1"), sims: $sims}'
  """) every 1m json

  let jb = "https://raw.githubusercontent.com/google/fonts/main/ofl/jetbrainsmono/JetBrainsMono%5Bwght%5D.ttf"
  let nf = "https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/patched-fonts/NerdFontsSymbolsOnly/SymbolsNerdFontMono-Regular.ttf"

  let primary = accent
  let onPrimary = background
  let containerHigh = alpha(foreground, 0.07)
  let outline = alpha(foreground, 0.12)
  let dim = mix(muted, foreground, 0.45)
  let dataSim = (net.sims ?? []).filter(x => x.id == net.sub)[0]
  let adbHelp = "Wi-Fi, data and DND need adb: turn on Developer options › Wireless debugging and pair once from a terminal with adb pair IP:PORT CODE. The widget connects by itself after that."

  component Ic(g, sz = 22, tint = foreground) {
    Text { text: g; font: nf; fontSize: sz; color: tint; maxLines: 1; align: center }
  }


  // A quick-settings tile: outlined, filled with the accent while on.
  component Tile(g, label, note, on = false) {
    Column {
      gap: 2
      align: center
      justify: center
      fill: true
      padding: [8, 4]
      background: on ? primary : containerHigh
      border: 1
      borderColor: on ? primary : outline
      radius: 0
      animate background: tween(200ms, "ease")
      Ic { g: g; sz: 20; tint: on ? onPrimary : foreground }
      Text { text: label; font: jb; fontSize: 11; fontWeight: 600; color: on ? onPrimary : foreground; maxLines: 1; align: center }
      Text { text: note; font: jb; fontSize: 9; color: on ? alpha(onPrimary, 0.75) : dim; maxLines: 1; align: center }
    }
  }

  Column {
    gap: 6
    fill: true
    Row {
      gap: 4
      fill: true
      Box { weight: 1; fill: height; onTap: { haptic(); if !net.ok { notify("quick settings", adbHelp); refresh() } else { if net.wifi { run("adb -s 127.0.0.1:5555 shell cmd wifi set-wifi-enabled disabled; sleep 2") } else { run("adb -s 127.0.0.1:5555 shell cmd wifi set-wifi-enabled enabled; sleep 2") } } }; Tile { g: net.wifi ? "󰖩" : "󰖪"; label: "wi-fi"; note: !net.ok ? "no adb" : net.wifi ? lower(net.ssid != "" ? net.ssid : "on") : "off"; on: net.wifi } }
      Box { weight: 1; fill: height; onTap: { haptic(); if !net.ok { notify("quick settings", adbHelp); refresh() } else { if net.data { run("adb -s 127.0.0.1:5555 shell svc data disable; sleep 2") } else { run("adb -s 127.0.0.1:5555 shell svc data enable; sleep 2") } } }; Tile { g: net.data ? "󰒢" : "󰞃"; label: "data"; note: !net.ok ? "no adb" : net.data ? lower(dataSim.name ?? "on") : "off"; on: net.data } }
      if modes.torch != null {
        Box { weight: 1; fill: height; onTap: { haptic(); torch("toggle") }; Tile { g: modes.torch ? "󰉄" : "󰉅"; label: "torch"; note: modes.torch ? "on" : "off"; on: modes.torch } }
      }
      Box { weight: 1; fill: height; onTap: volume("toggle"); Tile { g: v.muted ? "󰖁" : "󰕾"; label: "media"; note: v.muted ? "muted" : "${v.level}%"; on: !v.muted } }
      Box { weight: 1; fill: height; onTap: { haptic(); if !net.ok { notify("quick settings", adbHelp); refresh() } else { if modes.dnd { run("adb -s 127.0.0.1:5555 shell cmd notification set_dnd off") } else { run("adb -s 127.0.0.1:5555 shell cmd notification set_dnd priority") } } }; Tile { g: modes.dnd ? "󰍶" : "󰍷"; label: "dnd"; note: !net.ok ? "no adb" : modes.dnd ? "on" : modes.ringer ?? "off"; on: modes.dnd } }
      Box { weight: 1; fill: height; onTap: terminal("btop"); Tile { g: "󰐰"; label: "btop"; note: "monitor" } }
    }
  }
}
