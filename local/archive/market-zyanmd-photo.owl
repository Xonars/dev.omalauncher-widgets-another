widget "photo" {
  page: 1
  order: 1
  size: 3x3
  minSize: 2x2
  padding: 0

  meta {
    owl: 8
    description: "Widget foto dinamis home-screen dengan galeri storage dan input URL web."
    version: "1.1"
    license: "MIT"
    category: "media"
    author: "zyanmd"
  }

  requires {
    pacman: ["python", "python-pillow", "curl"]
  }

  asset defaultPhoto = base64""

  source gallery = cmd("""f=~/.cache/omalauncher-photos/helper.py
mkdir -p ~/.cache/omalauncher-photos
cat > "$f.tmp" <<'OWL_PY'
#!/usr/bin/env python3
import sys, os, re, hashlib, subprocess, json
from pathlib import Path

HOME = Path.home()
CACHE_DIR = HOME / ".cache/omalauncher-photos"
THUMB_DIR = CACHE_DIR / "thumbs"
DL_DIR = CACHE_DIR / "downloads"
STATUS_FILE = CACHE_DIR / "status.txt"
PICTURES_DIR = HOME / "Pictures"

for d in [CACHE_DIR, THUMB_DIR, DL_DIR, PICTURES_DIR]:
    d.mkdir(parents=True, exist_ok=True)

EXTS = {".jpg", ".jpeg", ".png", ".webp"}
USER_AGENT = "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"

try:
    from PIL import Image
    HAS_PIL = True
except ImportError:
    HAS_PIL = False

def set_status(msg: str):
    try:
        STATUS_FILE.write_text(msg, encoding="utf-8")
    except Exception:
        pass

def clean_title(filename):
    stem = Path(filename).stem
    stem = re.sub(r"^[0-9]+[-_ ]*", "", stem)
    stem = re.sub(r"[-_]+", " ", stem)
    return stem.title()

def fmt_size(num_bytes):
    if num_bytes >= 1024 * 1024:
        return f"{num_bytes / (1024 * 1024):.1f} MB"
    return f"{num_bytes / 1024:.0f} KB"

def cmd_gallery():
    search_dirs = [
        PICTURES_DIR,
        HOME / "photos",
        Path("/sdcard/DCIM/Camera"),
        Path("/sdcard/Pictures"),
        Path("/storage/emulated/0/DCIM/Camera"),
        Path("/storage/emulated/0/Pictures"),
    ]
    images = []
    seen = set()
    for root in search_dirs:
        if root.exists():
            try:
                for p in root.rglob("*"):
                    if p.is_file() and p.suffix.lower() in EXTS and not p.name.startswith("."):
                        resolved = p.resolve()
                        if resolved not in seen:
                            seen.add(resolved)
                            images.append(p)
            except Exception:
                pass
    images.sort(key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    images = images[:100]

    items = []
    for i, p in enumerate(images):
        try:
            st = p.stat()
        except OSError:
            continue
        h = hashlib.md5(f"{p}:{st.st_mtime}:{st.st_size}".encode()).hexdigest()[:12]
        matches = list(THUMB_DIR.glob(f"{h}_*.jpg"))
        w, h_dim = 0, 0
        thumb_path = None
        if matches:
            thumb_path = matches[0]
            m_dim = re.search(r"_(\d+)x(\d+)\.jpg$", thumb_path.name)
            if m_dim:
                w, h_dim = int(m_dim.group(1)), int(m_dim.group(2))
        elif HAS_PIL:
            try:
                with Image.open(p) as im:
                    w, h_dim = im.size
                    rgb = im.convert("RGB")
                    rgb.thumbnail((400, 400), Image.Resampling.BILINEAR)
                    thumb_path = THUMB_DIR / f"{h}_{w}x{h_dim}.jpg"
                    rgb.save(thumb_path, "JPEG", quality=82)
            except Exception:
                thumb_path = None

        thumb_str = str(thumb_path) if thumb_path and thumb_path.exists() else str(p)
        folder_name = p.parent.name
        if p.parent == PICTURES_DIR:
            folder_name = "Pictures"

        items.append({
            "id": i,
            "name": clean_title(p.name),
            "file": p.name,
            "path": str(p),
            "thumb": thumb_str,
            "dim": f"{w}×{h_dim}" if w else "",
            "size": fmt_size(st.st_size),
            "folder": folder_name
        })

    out = {"count": len(items), "items": items}
    sys.stdout.write(json.dumps(out, separators=(",", ":")))

def normalize_url(url: str) -> str:
    url = url.strip()
    if not url: return ""
    if url.startswith("www."):
        url = "https://" + url
    elif not url.startswith("http://") and not url.startswith("https://") and not url.startswith("/") and not url.startswith("~"):
        if "." in url and not url.endswith((".jpg", ".jpeg", ".png", ".webp", ".gif")):
            url = "https://" + url
    m = re.search(r"drive\.google\.com/file/d/([a-zA-Z0-9_-]+)", url)
    if m:
        return f"https://drive.google.com/uc?export=download&id={m.group(1)}"
    if "dropbox.com" in url and "dl=0" in url:
        return url.replace("dl=0", "dl=1")
    m = re.match(r"^https?://(?:www\.)?imgur\.com/([a-zA-Z0-9]{5,8})$", url)
    if m:
        return f"https://i.imgur.com/{m.group(1)}.jpg"
    return url

def cmd_fetch(raw_val="", fallback=""):
    raw_val = (raw_val or "").strip()
    fallback = (fallback or "").strip()
    if not raw_val:
        set_status("OK")
        print(fallback)
        return
    expanded = Path(os.path.expanduser(raw_val))
    if expanded.is_file() and expanded.stat().st_size > 0:
        set_status("OK")
        print(str(expanded.resolve()))
        return
    if raw_val.startswith("/storage/") or raw_val.startswith("/sdcard/") or raw_val.startswith("content://") or (not raw_val.startswith("http://") and not raw_val.startswith("https://")):
        fname = Path(raw_val).name
        search_dirs = [
            Path("/storage/emulated/0/Pictures"),
            Path("/storage/emulated/0/DCIM/Camera"),
            Path("/storage/emulated/0/Download"),
            PICTURES_DIR,
        ]
        for sdir in search_dirs:
            if sdir.exists():
                direct = sdir / fname
                if direct.is_file() and direct.stat().st_size > 0:
                    set_status("OK")
                    print(str(direct.resolve()))
                    return
                for f in sdir.glob(f"**/{fname}"):
                    if f.is_file() and f.stat().st_size > 0:
                        set_status("OK")
                        print(str(f.resolve()))
                        return
    norm_url = normalize_url(raw_val)
    if norm_url.startswith("http://") or norm_url.startswith("https://"):
        url_hash = hashlib.md5(norm_url.encode()).hexdigest()[:16]
        dest = DL_DIR / f"photo_{url_hash}.jpg"
        if dest.exists() and dest.stat().st_size > 0:
            set_status("OK (Cache)")
            print(str(dest.resolve()))
            return
        cmd = ["curl", "-sL", "-A", USER_AGENT, "--compressed", "--max-time", "20", "--retry", "2", "-o", str(dest), norm_url]
        res = subprocess.run(cmd, capture_output=True)
        if res.returncode == 0 and dest.exists() and dest.stat().st_size > 0:
            set_status("OK")
            print(str(dest.resolve()))
            return
        else:
            set_status("Gagal mengunduh URL")
            print(fallback)
            return
    set_status("File tidak ditemukan")
    print(fallback)

if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "gallery"
    if action == "gallery": cmd_gallery()
    elif action == "fetch": cmd_fetch(sys.argv[2] if len(sys.argv) > 2 else "", sys.argv[3] if len(sys.argv) > 3 else "")
OWL_PY
mv -f "$f.tmp" "$f"
python3 "$f" gallery
""") every 10m json
  source photoStatus = file("~/.cache/omalauncher-photos/status.txt")

  state activePhoto = "" persist
  state requestPhoto = "" persist
  state inputUrl = "" persist
  state photoFit = "cover" persist
  state galleryPage = 0

  let currentSrc = (activePhoto != "" && activePhoto != null) ? activePhoto : defaultPhoto
  let isFetching = (requestPhoto ?? "") != ""

  when isFetching {
    activePhoto = run("python3 ~/.cache/omalauncher-photos/helper.py fetch ${sh(requestPhoto)} ${sh(activePhoto)}")
    requestPhoto = ""
  }

  onTap: screen()

  // ==== TAMPILAN TILE FOTO DINAMIS ====
  Box {
    fill: true
    radius: 16 * corners
    clip: true
    background: alpha(surface, 0.7)
    border: 1
    borderColor: alpha(border, 0.4)

    if activePhoto != "" && activePhoto != null {
      if photoFit == "contain" {
        Image {
          src: currentSrc
          fill: true
          fit: contain
        }
      } else {
        Image {
          src: currentSrc
          fill: true
          fit: cover
        }
      }

      if isFetching {
        Box {
          align: topEnd
          padding: 8
          Box {
            padding: [6, 4]
            radius: 6 * corners
            background: alpha(background, 0.8)
            border: 1
            borderColor: alpha(accent, 0.5)
            Text { text: "⏳"; fontSize: 12 }
          }
        }
      }
    } else {
      Column {
        fill: true
        align: center
        justify: center
        gap: 6
        Text { text: "🖼"; fontSize: 38; align: center }
        Text { text: "Ketuk untuk pasang foto"; style: small; color: muted; align: center }
      }
    }
  }

  // ==== LAYAR PENGATURAN FOTO (FULL SCREEN) ====
  screen {
    title: "Atur Foto"

    Column {
      scroll: true
      padding: [16, 14]
      gap: 12

      // Kartu Foto Aktif Saat Ini
      Row {
        fill: width
        align: center
        padding: 12
        background: alpha(surface, 0.7)
        border: 1
        borderColor: alpha(border, 0.4)
        radius: 12 * corners
        gap: 12

        Box {
          size: 72
          radius: 10 * corners
          clip: true
          background: alpha(surface, 0.9)
          border: 1.5
          borderColor: accent

          if activePhoto != "" && activePhoto != null {
            if photoFit == "contain" {
              Image { src: currentSrc; fill: true; fit: contain }
            } else {
              Image { src: currentSrc; fill: true; fit: cover }
            }
          } else {
            Column {
              fill: true
              align: center
              justify: center
              Text { text: "🖼"; fontSize: 24; align: center }
            }
          }
        }

        Column {
          weight: 1
          gap: 4
          Row {
            fill: width
            gap: 6
            align: center
            Text { text: "Foto Aktif"; style: label; bold: true; color: accent; weight: 1 }
            if isFetching {
              Text { text: "⏳ Memproses..."; style: small; color: orange; width: 100; align: end }
            }
          }
          Text {
            text: activePhoto != "" ? activePhoto : "Foto Default (zyanmd)"
            style: small
            color: foreground
            maxLines: 1
          }
          Row {
            gap: 8
            Button {
              text: photoFit == "cover" ? "Mode: Cover" : "Mode: Contain"
              onTap: photoFit = (photoFit == "cover" ? "contain" : "cover")
            }
            if activePhoto != "" {
              Button {
                text: "↺ Default"
                onTap: {
                  activePhoto = ""
                  requestPhoto = ""
                  haptic()
                }
              }
            }
          }
        }
      }

      // Notifikasi / Status Error jika ada
      let statusClean = trim(photoStatus ?? "")
      if statusClean != "" && statusClean != "OK" {
        Row {
          fill: width
          padding: [10, 8]
          background: alpha(orange, 0.15)
          border: 1
          borderColor: alpha(orange, 0.45)
          radius: 10 * corners
          gap: 8
          align: center

          Text { text: "⚠️"; fontSize: 18; width: 24 }
          Text {
            text: statusClean
            style: small
            color: orange
            weight: 1
          }
        }
      }

      // ==== GALERI FOTO LOKAL (STORAGE ~/Pictures) ====
      Column {
        fill: width
        gap: 10
        padding: 12
        background: alpha(surface, 0.7)
        border: 1
        borderColor: alpha(border, 0.4)
        radius: 12 * corners

        Row {
          fill: width
          align: center
          Text {
            text: "Galeri Foto"
            style: label
            bold: true
            weight: 1
          }
          Text {
            text: "${gallery.count ?? 0} foto"
            style: small
            color: muted
            width: 60
            align: end
          }
          Button {
            text: "🔄"
            width: 44
            onTap: {
              refresh()
              haptic()
            }
          }
        }

        Text {
          text: "Pilih foto dari penyimpanan lokal (~/Pictures):"
          style: small
          color: muted
        }

        Row {
          fill: width
          Button {
            weight: 1
            text: "📁 Buka Folder ~/Pictures"
            onTap: {
              run("omarchy-files ~/Pictures")
              haptic()
            }
          }
        }

        let pageSize = 4
        let allPhotos = gallery.items ?? []
        let totalPhotos = gallery.count ?? 0
        let totalPages = max(1, ceil(totalPhotos / pageSize))
        let currentPage = clamp(galleryPage, 0, totalPages - 1)
        let pagedPhotos = take(drop(allPhotos, currentPage * pageSize), pageSize)

        for p in pagedPhotos key p.path {
          Row {
            fill: width
            align: center
            padding: 8
            background: activePhoto == p.path ? alpha(accent, 0.18) : alpha(background, 0.45)
            border: 1
            borderColor: activePhoto == p.path ? accent : alpha(border, 0.25)
            radius: 8 * corners
            gap: 10

            Box {
              size: 46
              radius: 6 * corners
              clip: true
              background: alpha(surface, 0.9)
              Image {
                src: p.thumb != "" ? p.thumb : p.path
                fill: true
                fit: cover
              }
            }

            Column {
              weight: 1
              gap: 2
              Text {
                text: p.name
                style: body
                bold: activePhoto == p.path
                color: activePhoto == p.path ? accent : foreground
                maxLines: 1
              }
              Text {
                text: "${p.file} • ${p.size}"
                style: small
                color: muted
                maxLines: 1
              }
            }

            if activePhoto == p.path {
              Text {
                text: "✓ Aktif"
                style: small
                bold: true
                    width: 60
                align: end
              }
            } else {
              Button {
                text: "Pasang"
                width: 75
                onTap: {
                  activePhoto = p.path
                  requestPhoto = ""
                  haptic()
                }
              }
            }
          }
        }

        if totalPages > 1 {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [4, 0]

            Button {
              weight: 1
              text: "◀ Prev"
              onTap: {
                galleryPage = max(0, currentPage - 1)
                haptic()
              }
            }

            Text {
              text: "Hal ${currentPage + 1} / ${totalPages}"
              style: small
              bold: true
              color: muted
              width: 70
              align: center
            }

            Button {
              weight: 1
              text: "Next ▶"
              onTap: {
                galleryPage = min(totalPages - 1, currentPage + 1)
                haptic()
              }
            }
          }
        }
      }

      // ==== INPUT URL / PATH FOTO ====
      Column {
        fill: width
        gap: 10
        padding: 12
        background: alpha(surface, 0.7)
        border: 1
        borderColor: alpha(border, 0.4)
        radius: 12 * corners

        Row {
          fill: width
          align: center
          Text {
            text: "Ganti Foto via URL / Path"
            style: label
            bold: true
            weight: 1
          }
        }

        Text {
          text: "Masukkan URL web (HTTP/HTTPS) atau path file HP:"
          style: small
          color: muted
        }

        Input {
          text: inputUrl
          placeholder: "https://... atau /storage/.../foto.jpg"
          fill: width
          onChange: inputUrl = value
          onSubmit: {
            requestPhoto = value != "" ? value : requestPhoto
            haptic()
          }
        }

        Row {
          fill: width
          gap: 8

          Button {
            weight: 1
            text: "✓ Pasang Foto"
            color: alpha(accent, 0.3)
            onTap: {
              requestPhoto = inputUrl != "" ? inputUrl : requestPhoto
              haptic()
            }
          }

          Button {
            text: "✕ Reset"
            onTap: {
              inputUrl = ""
              haptic()
            }
          }
        }
      }

      // ==== KARTU CREDIT GITHUB (DI PALING BAWAH) ====
      Row {
        fill: width
        align: center
        padding: [14, 12]
        background: alpha(surface, 0.7)
        border: 1
        borderColor: alpha(border, 0.4)
        radius: 12 * corners
        gap: 12
        onTap: {
          url("https://github.com/zyanmd")
          haptic()
        }

        Box {
          size: 38
          radius: 10 * corners
          clip: true
          background: alpha(accent, 0.15)
          border: 1
          borderColor: alpha(accent, 0.35)
          align: center
          Text {
            text: "🐙"
            fontSize: 20
            align: center
          }
        }

        Column {
          weight: 1
          gap: 2
          Text {
            text: "Dibuat oleh zyanmd"
            style: label
            bold: true
            color: foreground
          }
          Text {
            text: "github.com/zyanmd"
            style: small
          }
        }

        Button {
          text: "Kunjungi ↗"
          width: 95
          color: accent
          onTap: {
            url("https://github.com/zyanmd")
            haptic()
          }
        }
      }

      Spacer {
        height: 16
      }
    }
  }
}
