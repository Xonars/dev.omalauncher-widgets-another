widget "github contributions" {
  size: 6x4
  minSize: 6x3
  meta {
    description: "A GitHub contribution grid for the year to date or the last months, with commits, pull requests, issues, streaks and profile stats; tap for more"
    version: "1.1.1"
    license: "MIT"
    category: "dev"
    owl: 6
  }

  requires { pacman: ["curl", "jq", "gawk"] }

  // The user to show, typed on the screen and kept across restarts.
  state user = "SimonSchubert" persist
  // What the name field holds before it is fetched.
  state draft = ""
  let mu = match(user, "([A-Za-z0-9-]+)")
  let u = mu == null ? "" : mu[0]
  // What fetch commits: the name as typed, trimmed. Empty keeps the current user.
  let nextUser = trim(draft)
  // How much the grid and the numbers cover: 0 is the year to date, else the last span months.
  state span = 0 persist

  source now = clock every 10m
  // It reads github.com/users/<u>/contributions for the grid and totals, and
  // github's search API for the same window's commits, pull requests and issues.
  // The script is here, in full, so the widget is self-contained and a reviewer
  // reads exactly what runs; the two values arrive as its own arguments.
  source g = cmd("set -- ${sh(u)} ${int(span)}; " + """
# GitHub contribution grid + key stats for one user, as JSON for this widget.
# args: <github-user> [months]   # 0 (default) is the year to date, else the last N months
# needs: curl, jq, awk/gawk (declared in the widget's requires)

u=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9-')
span=${2:-0}
case "$span" in ''|*[!0-9]*) span=0 ;; esac
y=$(date +%Y)
today=$(date +%F)
# The window the grid and the numbers cover.
if [ "$span" -eq 0 ]; then from="${y}-01-01"; else from=$(date -d "$today -${span} months" +%F); fi

srch() { curl -sf --max-time 15 "https://api.github.com/search/$1?q=$2" | jq -r '.total_count // "null"'; }
# How many days the calendar JSON holds (0 means: no such user, or no github).
ndays() { jq '.days | length'; }

# The calendar: every day cell (date, weekday row, week column, count) with its tooltip,
# then the totals the window and a streak need. Days before the window are dropped and
# the week columns are renumbered so the window starts at column 0.
h=$(curl -sf --max-time 20 "https://github.com/users/$u/contributions") || h=""
cal=$(printf '%s\n' "$h" | awk '
  /data-date="/ && /ContributionCalendar-day/ {
    match($0, /data-date="[0-9-]+"/)
    d = substr($0, RSTART + length("data-date=\""), 10)
    p = index($0, "contribution-day-component-")
    if (p == 0) next
    rest = substr($0, p + length("contribution-day-component-"))
    match(rest, /^[0-9]+-[0-9]+/)
    dt[substr(rest, RSTART, RLENGTH)] = d
    next
  }
  /<tool-tip/ && /contribution-day-component-/ {
    p = index($0, "contribution-day-component-")
    if (p == 0) next
    rest = substr($0, p + length("contribution-day-component-"))
    match(rest, /^[0-9]+-[0-9]+/)
    id = substr(rest, RSTART, RLENGTH)
    txt = substr($0, index($0, ">") + 1)
    gsub(/,/, "", txt)
    if (txt ~ /^[0-9]/) { split(txt, a, " "); ct[id] = a[1] + 0 } else ct[id] = 0
  }
  END { for (id in dt) { split(id, a, "-"); print dt[id], a[1], a[2], ct[id] + 0 } }
' | sort | awk -v from="$from" -v today="$today" '
  $1 < from { next }
  {
    i = ++cnt
    dt[i] = $1; rr[i] = $2 + 0; ww[i] = $3 + 0; nn[i] = $4 + 0
    if (i == 1 || ww[i] < minw) minw = ww[i]
    if (ww[i] > maxw) maxw = ww[i]
    total += $4; if ($4 > 0) active++
  }
  END {
    longest = 0; run = 0
    for (i = 1; i <= cnt; i++) { if (nn[i] > 0) { run++; if (run > longest) longest = run } else run = 0 }
    i = cnt
    if (cnt > 0 && nn[i] == 0 && dt[i] == today) i--
    streak = 0
    for (; i >= 1; i--) { if (nn[i] > 0) streak++; else break }
    best = 0; bestd = ""
    for (i = 1; i <= cnt; i++) if (nn[i] > best) { best = nn[i]; bestd = dt[i] }
    weeks = cnt == 0 ? 0 : maxw - minw + 1
    printf "{\"from\":\"%s\",\"days\":[", from
    for (i = 1; i <= cnt; i++) {
      if (i > 1) printf ","
      printf "{\"d\":\"%s\",\"r\":%d,\"w\":%d,\"n\":%d,\"mo\":%d,\"dy\":%d}", dt[i], rr[i], ww[i] - minw, nn[i], substr(dt[i], 6, 2) + 0, substr(dt[i], 9, 2) + 0
    }
    if (cnt == 0) printf "],\"weeks\":0,\"total\":null,\"streak\":null,\"longest\":null,\"best\":null,\"bestDay\":null,\"active\":null}"
    else printf "],\"weeks\":%d,\"total\":%d,\"streak\":%d,\"longest\":%d,\"best\":%d,\"bestDay\":\"%s\",\"active\":%d}", weeks, total, streak, longest, best, bestd, active + 0
  }')
[ -n "$cal" ] || cal='{"from":"'"$from"'","days":[],"weeks":0}'

# The counts cover the same window as the grid.
commits=$(srch commits "author:$u+author-date:$from..$today"); commits=${commits:-null}
prs=$(srch issues "type:pr+author:$u+created:$from..$today"); prs=${prs:-null}
issues=$(srch issues "type:issue+author:$u+created:$from..$today"); issues=${issues:-null}

prof=$(curl -sf --max-time 15 "https://api.github.com/users/$u") || prof=""
repos=null; followers=null; following=null; pname=""
if [ -n "$prof" ]; then
  repos=$(printf '%s' "$prof" | jq -r '.public_repos // "null"'); repos=${repos:-null}
  followers=$(printf '%s' "$prof" | jq -r '.followers // "null"'); followers=${followers:-null}
  following=$(printf '%s' "$prof" | jq -r '.following // "null"'); following=${following:-null}
  pname=$(printf '%s' "$prof" | jq -r '.name // ""'); pname=${pname:-}
fi

# The display counts get thousands separators; streaks and day counts stay numbers.
# A user github's search does not know makes it drop the author filter, so drop those too.
if [ "$(printf '%s' "$cal" | ndays)" = "0" ]; then commits=null; prs=null; issues=null; fi
out=$(jq -n --arg u "$u" --arg name "$pname" --arg from "$from" --argjson cal "$cal" \
  --argjson commits "$commits" --argjson prs "$prs" --argjson issues "$issues" \
  --argjson repos "$repos" --argjson followers "$followers" --argjson following "$following" '
  def grp:
    tostring as $s
    | if ($s | test("^[0-9]{1,3}$")) then $s
      else ($s | capture("(?<h>[0-9]+)(?<t>[0-9]{3})$")) | ((.h | grp) + "," + .t) end;
  def f: if . == null then null else grp end;
  $cal + {
    user: $u, name: $name, from: $from,
    total: ($cal.total | f),
    commits: ($commits | f), prs: ($prs | f), issues: ($issues | f),
    repos: ($repos | f), followers: ($followers | f), following: ($following | f)
  }') || out=""
[ -n "$out" ] || out=$(jq -n --arg u "$u" --arg from "$from" '{user: $u, from: $from, days: [], weeks: 0}')
printf '%s\n' "$out"
if [ "$(printf '%s' "$out" | ndays)" = "0" ]; then
  echo "github: user '$u' not found (or github is unreachable)" >&2
  exit 1
fi
""") every 30m json status timeout 60s
  // Switching the user or the window (typed on the screen or set by a script) fetches
  // right away. A new user clears what was typed, so fetch never commits stale text.
  on user { draft = ""; refresh() }
  on span { refresh() }

  let d = g.out ?? {}
  let days = d.days ?? []
  let ok = len(days) > 0
  let err = trim(g.err ?? "")
  let problem = g == null || ok ? "" : (err == "" ? "no github data" : err)
  let today = fmtTime(now, "yyyy-MM-dd")
  let year = fmtTime(now, "yyyy")
  let spanLabel = span == 0 ? year : "${span}m"
  let spanWhat = span == 0 ? "the year to date" : "the last ${span} months"
  let streak = d.streak == null ? "" : " · ${d.streak}d"
  // GitHub's contribution scale: empty, then four steps of green.
  let ramp = [surface, mix(surface, green, 0.4), mix(surface, green, 0.65), mix(surface, green, 0.85), green]
  let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
  // With little height (keyboard open, a shrunken tile) drop the legend and keep
  // the header, as much grid as fits and one line of numbers.
  let th = tileHeight ?? 400
  let tw = tileWidth ?? 520
  let roomy = th >= 170
  // A tile taller than wide (the landscape home screen) draws the window as two
  // stacked half-years and the counts as a 2x2 grid, so the height is used.
  let tall = th > tw && roomy
  // The grid is drawn from its squares: 7 rows of (width / weeks) plus the month
  // labels. nw is how many week columns the window needs; 53 is a full year.
  let nw = max(d.weeks ?? 53, 1)
  let gridSlack = 26

  onTap: screen()

  // One quiet line of numbers under the grid: what the window covers.
  component Counts(commits, prs, issues, total) {
    if tall {
      Grid { columns: 2; gap: 4
        Text { text: "${commits ?? "…"} commits"; style: small; color: green; maxLines: 1 }
        Text { text: "${prs ?? "…"} pull reqs"; style: small; color: blue; maxLines: 1; align: end }
        Text { text: "${issues ?? "…"} issues"; style: small; color: magenta; maxLines: 1 }
        Text { text: "${total ?? "…"} contribs"; style: small; color: accent; maxLines: 1; align: end }
      }
    } else {
    Row { gap: 8
      Text { text: "${commits ?? "…"} commits"; style: small; color: green; weight: 1; maxLines: 1 }
      Text { text: "${prs ?? "…"} pull reqs"; style: small; color: blue; weight: 1; maxLines: 1; align: center }
      Text { text: "${issues ?? "…"} issues"; style: small; color: magenta; weight: 1; maxLines: 1; align: center }
      Text { text: "${total ?? "…"} contribs"; style: small; color: accent; weight: 1; maxLines: 1; align: end }
    }
    }
  }

  // A quiet label/value line, for the secondary numbers on the screen.
  component Fact(cap, value, tint = foreground) {
    Row { gap: 8; fill: width
      Text { text: cap; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: value ?? "…"; style: small; color: tint; width: 92; align: end; maxLines: 1 }
    }
  }

  component Legend(total) {
    Row { gap: 4; align: center
      Text { text: "less"; style: label; color: muted; width: 32 }
      for i in [0, 1, 2, 3, 4] {
        Box { width: 9; height: 9; radius: 2; background: ramp[i] }
      }
      Text { text: "more"; style: label; color: muted; width: 34 }
      Text { text: "${total ?? "…"} in ${spanLabel}"; style: label; color: muted; weight: 1; align: end; maxLines: 1 }
    }
  }

  // One square per day of the window, today ringed, months labelled on their first
  // day (and on the window's first day, when it starts mid-month). With bands: 2 the
  // weeks wrap into two stacked halves, each with its own month labels.
  component Cal(days, today, weeks, from, bands = 1) {
    Canvas {
      fill: true
      let nw = max(weeks, 1)
      let hw = ceil(nw / bands)
      let monthsOn = height >= 44 * bands
      let head = monthsOn ? 16 : 2
      let bandGap = 6
      // Squares, as large as the window and the space allow.
      let pitch = min(width / hw, max((height - 20 * bands - bandGap * (bands - 1)) / (7 * bands), 1))
      let cs = max(pitch - 1.6, min(3, pitch * 0.8))
      let x0 = (width - hw * pitch) / 2
      let bandH = head + 7 * pitch + bandGap
      let y0 = bands == 1 ? max((height - 7 * pitch) / 2, head) : max((height - bands * bandH + bandGap) / 2, 0) + head
      for c in days {
        let lvl = c.n == 0 ? 0 : c.n < 4 ? 1 : c.n < 7 ? 2 : c.n < 11 ? 3 : 4
        let band = floor(c.w / hw)
        let x = x0 + (c.w - band * hw) * pitch
        let by = y0 + band * bandH
        let y = by + c.r * pitch
        if (c.dy == 1 || c.d == from || (c.w == band * hw && c.r == 0 && band > 0 && c.dy <= 14)) && monthsOn {
          text(months[c.mo - 1], x + cs / 2, by - 9, size: 8, align: center, color: muted)
        }
        rect(x, y, cs, cs, radius: min(1.5, cs / 2), fill: ramp[lvl])
        if c.d == today {
          rect(x - 1, y - 1, cs + 2, cs + 2, radius: 2.5, stroke: foreground, width: 1)
        }
      }
    }
  }

  Column {
    gap: roomy ? 6 : 4
    Row {
      gap: 6
      align: center
      Text { text: "contribs"; style: label; color: accent; width: 58 }
      Text { text: "@${d.user ?? u}"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: "${spanLabel}${streak}"; style: label; color: muted; width: 84; align: end; maxLines: 1 }
    }
    if ok {
      // The grid is the widget: it takes the room that is left over.
      if tall {
        // Two half-years stacked, taking all the height between header and counts.
        Cal { days: days; today: today; weeks: nw; from: d.from; bands: 2; fill: width; weight: 1 }
      } else if roomy {
        Spacer { weight: 1 }
        // Square cells that fit: the tile width minus its padding, 7 rows and the
        // month labels, at most what is left after header, counts and legend (110).
        Cal {
          days: days
          today: today
          weeks: nw
          from: d.from
          fill: width
          height: clamp((tw - 24) / nw * 7 + gridSlack, 30, th - 110)
        }
        Spacer { weight: 1 }
      } else {
        if th >= 90 {
          // A shrunken tile keeps the header, the grid and one line of numbers (70).
          Cal { days: days; today: today; weeks: nw; from: d.from; fill: width; height: clamp(th - 70, 16, 120) }
        }
      }
      Counts { commits: d.commits; prs: d.prs; issues: d.issues; total: d.total }
      if roomy {
        Legend { total: d.total }
      }
    } else {
      Spacer { weight: 1 }
      Text {
        text: problem == "" ? "loading github…" : problem
        style: small
        color: problem == "" ? muted : red
        maxLines: roomy ? 3 : 2
      }
      if problem != "" {
        Text { text: "tap to pick a github user"; style: small; color: muted }
      }
      Spacer { weight: 1 }
    }
  }

  screen {
    title: "github contributions"
    Column {
      scroll: true
      gap: 12
      Row {
        gap: 8
        align: center
        Column { gap: 0; weight: 1
          Text { text: "@${d.user ?? u}"; style: title; maxLines: 1 }
          Text { text: (d.name ?? "") == "" ? "github profile" : d.name; style: small; color: muted; maxLines: 1 }
        }
        Button { text: "open ↗"; color: accent; onTap: url("https://github.com/${d.user ?? u}") }
      }
      // How much the grid and the numbers cover.
      Row { gap: 6; fill: width
        Button { text: "ytd"; color: span == 0 ? accent : muted; onTap: span = 0; weight: 1 }
        Button { text: "3m"; color: span == 3 ? accent : muted; onTap: span = 3; weight: 1 }
        Button { text: "6m"; color: span == 6 ? accent : muted; onTap: span = 6; weight: 1 }
        Button { text: "12m"; color: span == 12 ? accent : muted; onTap: span = 12; weight: 1 }
      }
      if ok {
        Cal {
          days: days
          today: today
          weeks: nw
          from: d.from
          fill: width
          height: clamp((screenWidth ?? 380) / nw * 7 + gridSlack, 76, 320)
        }
        Legend { total: d.total }
        Text {
          text: "the calendar is what github counts for you, showing ${spanWhat}"
          style: label
          color: muted
        }
        Grid {
          columns: 2
          gap: 10
          Fact { cap: "commits"; value: d.commits; tint: green }
          Fact { cap: "pull requests"; value: d.prs; tint: blue }
          Fact { cap: "issues"; value: d.issues; tint: magenta }
          Fact { cap: "contribs ${spanLabel}"; value: d.total; tint: accent }
          Fact { cap: "best day"; value: d.best == null ? "…" : "${d.best} · ${months[num(sub(d.bestDay, 5, 7)) - 1]} ${num(sub(d.bestDay, 8, 10))}" }
          Fact { cap: "streak"; value: d.streak == null ? "…" : "${d.streak} days" }
          Fact { cap: "longest streak"; value: d.longest == null ? "…" : "${d.longest} days" }
          Fact { cap: "active days"; value: d.active == null ? "…" : "${d.active} of ${len(days)}" }
          Fact { cap: "repositories"; value: d.repos }
          Fact { cap: "followers"; value: d.followers }
          Fact { cap: "following"; value: d.following }
        }
      } else {
        Text {
          text: problem == "" ? "loading github…" : problem
          style: body
          color: problem == "" ? muted : red
          maxLines: 4
        }
        if problem != "" {
          Text { text: "set a github user below"; style: small; color: muted }
        }
      }
      Text { text: "github user"; style: label; color: accent }
      // Enter and fetch do the same: commit the name as typed (empty keeps the
      // current user) and fetch it now. The field tracks what is typed in draft.
      Row { gap: 6; align: center
        Input {
          text: user
          placeholder: "github username"
          onChange: draft = value
          onSubmit: { user = trim(value) == "" ? user : trim(value); refresh() }
          weight: 1
        }
        Button { text: "fetch"; color: accent; onTap: { user = nextUser == "" ? user : nextUser; refresh() } }
        Button { text: "refresh"; color: muted; onTap: refresh() }
      }
    }
  }
}
