python3 ~/.cache/owl-usage/owl-usage.py --quiet --quick""")
  }

  // Keep it fresh while the page is on screen; the tile itself is one of the widgets.
  // --quick never runs a widget's commands: that only happens on "measure".
  every 10m { run("python3 ~/.cache/owl-usage/owl-usage.py --quiet --quick") }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "widget drain"; style: muted; weight: 1; maxLines: 1 }
      if totalPct != null {
        Text {
          text: "${totalPct}%/d"
          fontSize: 11
          color: totalPct > 20 ? red : totalPct > 10 ? orange : green
          width: 48
          align: end
        }
      }
    }

    if total == null {
      Text { text: "tap to analyze"; style: small; color: muted }
    } else {
      Text { text: "${round(total)} mAh/day · ${count} widgets"; style: small; color: muted; maxLines: 1 }
    }

    if count == 0 {
      Text { text: "no data yet"; style: small }
      Button { text: "analyze now"; onTap: run("python3 ~/.cache/owl-usage/owl-usage.py --quiet --quick") }
    } else {
      for w in top key w.file {
        Column {
          gap: 2
          Row {
            align: center
            Text { text: w.name; fontSize: 12; weight: 1; maxLines: 1 }
            Text {
              text: "${round(w.mah)} mAh"
              fontSize: 11
              color: w.mah >= 100 ? red : w.mah >= 40 ? orange : muted
              width: 58
              align: end
            }
          }
          Progress {
            value: w.mah; max: biggest; height: 3; fill: width
            color: w.mah >= 100 ? red : w.mah >= 40 ? orange : green
          }
        }
      }
    }
  }

  screen {
    title: "widget drain"
    Column {
      scroll: true
      gap: 10

      // Summary card
      Column {
        padding: 10
        background: surface
        radius: 8 * corners
        gap: 6
        Row {
          align: center
          Text { text: "total estimated drain"; style: small; color: muted; weight: 1 }
          if generated != null {
            Text {
              text: "updated ${fmtAgo(generated, now)}"
              style: small
              color: muted
              width: 110
              align: end
            }
          }
        }
        Text {
          text: total != null ? "${round(total)} mAh/day (${totalPct}%)" : "…"
          style: title
          color: totalPct > 20 ? red : totalPct > 10 ? orange : green
        }
        Text {
          text: "model: visible ${visiblePct}% · ${hz} Hz · ${watt} W draw · ${round(phone)} mAh battery"
          style: small; color: muted
        }
      }

      Text {
        text: "Android accounts battery per app, so all widgets share the launcher's total. Costs here are estimated from declarations (sources, intervals, animation, nodes), command CPU measured by owl-usage, and launcher warnings in .errors/"
        style: small; color: muted
      }

      Row {
        gap: 6
        Button { text: "measure"; onTap: run("python3 ~/.cache/owl-usage/owl-usage.py --measure") }
        Button { text: "recalculate"; onTap: run("python3 ~/.cache/owl-usage/owl-usage.py --quiet --quick") }
        Button {
          text: filter == "all" ? "all (${count})" : filter == "heavy" ? "≥40 mAh" : "anim/term"
          onTap: filter = (filter == "all" ? "heavy" : filter == "heavy" ? "anim" : "all")
        }
      }

      for w in filtered key w.file {
        Column {
          padding: 8
          background: surface
          radius: 6 * corners
          gap: 4
          Row {
            gap: 6
            align: center
            Text { text: w.name; fontSize: 14; bold: true; weight: 1; maxLines: 1 }
            Text {
              text: "${w.mah >= 10 ? round(w.mah) : round(w.mah, 1)} mAh/day"
              fontSize: 12; color: foreground; width: 92; align: end
            }
            Text {
              text: "${w.pct}%"
              fontSize: 12; width: 48; align: end
              color: w.mah >= 100 ? red : w.mah >= 40 ? orange : green
            }
          }
          Progress {
            value: w.mah; max: biggest; height: 4; fill: width
            color: w.mah >= 100 ? red : w.mah >= 40 ? orange : green
          }
          Row {
            gap: 4
            Text {
              text: "${w.kind == 'app' ? 'app' : 'p' + str(w.page ?? '?')} · ${w.size ?? 'full'} · ${count(w.sources)} src · ${fmtNum(w.wakes, {compact: true})} wakes"
              style: small; color: muted; weight: 1; maxLines: 1
            }
            Text {
              text: "${w.share}% share"
              style: small; color: muted; width: 88; align: end; maxLines: 1
            }
          }
          if w.topText != "" {
            Text { text: w.topText; style: small; color: foreground }
          }
          for n in w.notes {
            Text {
              text: "· ${n}"
              style: small
              color: contains(n, "failed") || contains(n, "slow") || contains(n, "half rate") ? orange : muted
            }
          }
        }
      }

      if count == 0 {
        Text {
          text: "No data yet. owl-usage runs every 10 min while this page is on screen, or tap recalculate."
          style: small; color: muted
        }
      }

      Row {
        gap: 8
        Button { text: "measure now"; onTap: run("python3 ~/.cache/owl-usage/owl-usage.py --measure") }
        Button { text: "close"; onTap: close() }
      }
      Text {
        text: "green < 40 · orange < 100 · red ≥ 100 mAh/day. Red on an animating widget means it redraws at 60 Hz whenever on screen; a live terminal costs ~86 mAh/day just by staying alive."
        style: small; color: muted
      }
    }
  }
}
