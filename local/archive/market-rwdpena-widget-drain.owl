widget "widget drain" {
  size: 3x5
  minSize: 3x3
  requires { pacman: ["python", "bash", "coreutils"] }
  meta {
    owl: 9
    description: "Estimated battery drain per widget via owl-usage: animation, commands, network, and terminals. Tap to inspect the model and benchmark commands"
    version: "1.5"
    license: "MIT"
    category: "system"
  }

  // owl-usage writes this: it reads every widget in this folder, measures what it
  // can (command CPU, launcher draw warnings in .errors/) and estimates the rest.
  source data = file("~/.cache/owl-usage/costs.json") json
  source now = clock every 1m

  let list = data == null ? [] : (data.widgets ?? [])
  let maxItems = rows != null ? clamp((rows - 1) * 2, 3, 10) : 8
  let top = take(list, maxItems)
  let count = count(list)
  let biggest = count > 0 ? list[0].mah : 1
  let total = data == null ? null : data.totalMahPerDay
  let totalPct = data == null ? null : data.totalPctPerDay
  let generated = data == null ? null : data.generated
  let cfg = data == null ? {} : (data.model ?? {})
  let phone = data == null ? 0 : (data.phoneMah ?? 0)
  let visiblePct = round((cfg.visible ?? 0.25) * 100)
  let hz = cfg.frameHz ?? 60
  let watt = cfg.framePowerW ?? 0.6

  state filter = "all"

  let filtered = filter == "heavy"
    ? list.filter(w => w.mah >= 40)
    : filter == "anim"
      ? list.filter(w => w.animates || w.terminal)
      : list

  // Install the bundled owl-usage analyzer into ~/.cache/owl-usage/owl-usage.py
  // on first run (or version bump) and compute initial estimates immediately.
  when (data.scriptVersion ?? "") != "1.5" {
    run("""mkdir -p ~/.cache/owl-usage
cat > ~/.cache/owl-usage/owl-usage.py.tmp <<'OWL_USAGE_PY'
#!/usr/bin/env python3
'''owl-usage - how many battery each omalauncher widget spends.

The launcher has no per-widget battery data: Android accounts energy per app
(UID), and every widget shares the launcher's one. So this estimates it from
what each widget declares, plus everything that can be measured:

  * its sources (kind and interval), streams, triggers and nodes, from the file;
  * the CPU time of its commands, measured by --measure (cached, see below);
  * the frame time and half-rate warnings the launcher itself wrote in
    .errors/<file>.txt (a widget that draws above ~4 ms per frame says so).

Output: ~/.cache/owl-usage/costs.json (read by the "widget drain" widget) and a
table on stdout. Every constant of the model is in MODEL, below, and is printed
in the widget's screen, so the numbers can be argued with.

usage:
  owl-usage                 analyse, write costs.json, print the table
  owl-usage --quiet         analyse and write, print nothing (for a widget trigger)
  owl-usage --json          print the JSON instead of the table
  owl-usage --measure       also run every widget command once and time it
  owl-usage --no-cache      ignore cached command timings
'''

import argparse
import hashlib
import json
import os
import re
import resource
import signal
import subprocess
import sys
import time

TRIPLE = chr(34) * 3

WIDGETS = os.path.expanduser(
    os.environ.get("OWL_WIDGETS", "~/.config/omalauncher/widgets"))
CACHE = os.path.expanduser(os.environ.get("OWL_USAGE_CACHE", "~/.cache/owl-usage"))
COSTS = os.path.join(CACHE, "costs.json")
TIMINGS = os.path.join(CACHE, "timings.json")

# --- the model -----------------------------------------------------------------
# A phone lies around 3.85 V, so 1 mAh is 13.86 J. Everything below is energy
# (mJ per event) or power (mW while it lasts), converted with mah().
MODEL = {
    # Fraction of the day a widget's page is on screen: sources and animation
    # only run while the page (or a neighbour) is live, a terminal runs always.
    "visible": 0.25,
    # A frame the launcher draws costs this while it draws (CPU+GPU), and half
    # of it is a fair guess for the partial redraw a source update causes.
    "framePowerW": 0.6,
    "partialRedraw": 0.5,
    "frameHz": 60,            # while animating; halved when the launcher says so
    "cpuPowerW": 1.2,         # while a command runs
    "spawnMj": 8.0,           # fork/exec/bash startup, per command wakeup
    "httpMj": 900.0,          # waking the radio and fetching, when idle
    "binderMj": 1.5,          # one android.* poll
    "notifyMj": 120.0,        # posting a notification
    "alarmMj": 60.0,          # an `at` trigger firing (it wakes the phone)
    "terminalMw": 12.0,       # a live terminal idle in a tile (off screen too)
    "terminalHz": 2.0,        # its own repaints (btop, a shell prompt)
    "terminalFrameMs": 1.5,
    "imageMj": 900.0,         # downloading an image from the web (once a day)
    "phoneMah": float(os.environ.get("OWL_PHONE_MAH", 5000)),  # the phone's battery
    "batteryV": 3.85,
}

J_PER_MAH = MODEL["batteryV"] * 3.6
MJ_PER_MAH = J_PER_MAH * 1000.0
NODE_TYPES = ["Column", "Row", "Flow", "Box", "Grid", "Text", "Button",
              "Progress", "Ring", "Sparkline", "Image", "Canvas", "Shader",
              "Spacer", "Slider", "Input", "Terminal"]
NODE_RE = re.compile(r"\b(%s)\s*\{" % "|".join(NODE_TYPES))
CANVAS_RE = re.compile(r"\b(rect|circle|arc|line|path|text|image|sprite)\s*\(")
FOR_RE = re.compile(r"\bfor\b")
# the animation variable `time` on its own: not `p.time`, not `fmtTime(`, not
# `timeout`, and (after blank_strings) never inside a string or a command.
ANIM_RE = re.compile(r"(?<![\w.])time(?![\w])")
SOURCE_RE = re.compile(r"source\s+(\w+)\s*=")
EVERY_RE = re.compile(r"\bevery\s+(\d+)\s*(s|m|h)\b")
FRAME_RE = re.compile(r"drawing takes ([\d]+[.,]?[\d*]) ms per frame")
TIMEOUT_RE = re.compile(r": (\w+): timed out after (\d+)s")

PART_LABELS = {"frames": "drawing", "updates": "updates",
               "commands": "commands", "radio": "network",
               "listeners": "listeners", "triggers": "triggers",
               "terminal": "terminal"}


def mah(mj):
    '''mJ -> mAh.'''
    return mj / MJ_PER_MAH


def mah_power(mw):
    '''mW held for a whole day -> mAh/day.'''
    return mw * 24.0 / 1000.0 / MODEL["batteryV"] * 1000.0


def interval_seconds(expr, default=60):
    m = EVERY_RE.search(expr)
    if not m:
        return default
    n = int(m.group(1))
    return n * {"s": 1, "m": 60, "h": 3600}[m.group(2)]


def human_seconds(s):
    if s % 3600 == 0:
        return "%dh" % (s // 3600)
    if s % 60 == 0:
        return "%dm" % (s // 60)
    return "%ds" % s


def strip_comments(text):
    '''Drop // comments, keeping strings and heredocs as they are.'''
    out, i, n, quote = [], 0, len(text), None
    while i < n:
        c = text[i]
        if quote:
            if quote == TRIPLE:
                if text.startswith(TRIPLE, i):
                    out.append(TRIPLE)
                    i += 3
                    quote = None
                    continue
            elif c == "\\" and i + 1 < n:
                out.append(text[i:i + 2])
                i += 2
                continue
            elif c == quote:
                quote = None
            out.append(c)
            i += 1
            continue
        if c in "\"'":
            if c == '"' and text.startswith(TRIPLE, i):
                out.append(TRIPLE)
                i += 3
                quote = TRIPLE
                continue
            quote = c
            out.append(c)
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                i += 1
            continue
        out.append(c)
        i += 1
    return "".join(out)


def blank_strings(text):
    '''The text with what's inside strings replaced by spaces, so a `time` in a
    command or a "category: time" can't count as animation.'''
    out, i, n, quote = [], 0, len(text), None
    while i < n:
        c = text[i]
        if quote:
            if quote == TRIPLE and text.startswith(TRIPLE, i):
                out.append("   ")
                i += 3
                quote = None
                continue
            if c == "\\" and quote != TRIPLE and i + 1 < n:
                out.append("  ")
                i += 2
                continue
            if c == quote:
                quote = None
                out.append(c)
                i += 1
                continue
            out.append("\n" if c == "\n" else " ")
            i += 1
            continue
        if c in "\"'":
            if c == '"' and text.startswith(TRIPLE, i):
                out.append(TRIPLE)
                i += 3
                quote = TRIPLE
                continue
            quote = c
            out.append(c)
            i += 1
            continue
        out.append(c)
        i += 1
    return "".join(out)


def statements(text):
    '''Split into top-level statements: (line, text). Braces count as depth, so a
    node tree is one statement and `source`/`every`/`at` inside it aren't seen.'''
    stmts, depth, quote, start, start_line, line = [], 0, None, 0, 1, 1
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if quote:
            if quote == TRIPLE and text.startswith(TRIPLE, i):
                i += 3
                quote = None
                continue
            if c == "\\" and quote != TRIPLE and i + 1 < n:
                i += 2
                continue
            if c == quote:
                quote = None
            if c == "\n":
                line += 1
            i += 1
            continue
        if c in "\"'":
            if c == '"' and text.startswith(TRIPLE, i):
                quote = TRIPLE
                i += 3
                continue
            quote = c
            i += 1
            continue
        if c in "([{":
            depth += 1
        elif c in ")]}":
            depth = max(0, depth - 1)
        elif c == "\n":
            if depth == 0:
                s = text[start:i].strip()
                if s:
                    stmts.append((start_line, s))
                start = i + 1
                start_line = line + 1
            line += 1
        i += 1
    s = text[start:].strip()
    if s:
        stmts.append((start_line, s))
    return stmts


def first_string(expr):
    '''The first quoted argument of an expression (cmd/http/file/...).'''
    i = 0
    while i < len(expr) and expr[i] not in "\"'":
        i += 1
    if i >= len(expr):
        return None
    if expr.startswith(TRIPLE, i):
        j = expr.find(TRIPLE, i + 3)
        return expr[i + 3:j] if j > 0 else expr[i + 3:]
    q, out, i = expr[i], [], i + 1
    while i < len(expr):
        c = expr[i]
        if c == "\\" and i + 1 < len(expr):
            out.append(expr[i + 1])
            i += 2
            continue
        if c == q:
            break
        out.append(c)
        i += 1
    return "".join(out)


def read_errors(path):
    '''What the launcher reported about this widget while it ran.'''
    out = {"frameMs": None, "halfRate": False, "timeouts": [], "images": 0,
           "failed": []}
    p = os.path.join(WIDGETS, ".errors", os.path.basename(path) + ".txt")
    try:
        with open(p, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return out
    m = FRAME_RE.search(text)
    if m:
        try:
            out["frameMs"] = float(m.group(1).replace(",", "."))
        except ValueError:
            pass
    out["halfRate"] = "animating at half rate" in text
    out["timeouts"] = ["%s: timed out after %s s" % (a, b) for a, b in TIMEOUT_RE.findall(text)]
    out["images"] = text.count("couldn't be loaded")
    if "Unable to resolve host" in text:
        out["failed"].append("network failed (unable to resolve host)")
    return out


def parse_widget(path):
    '''Everything about one .owl file that decides what it costs.'''
    with open(path, encoding="utf-8", errors="replace") as fh:
        raw = fh.read()
    text = strip_comments(raw)
    # Everything lives inside the widget's (or app's) outer braces; scan that
    # body, so `source`, `every`, `state` and `Terminal` sit at depth 0 while
    # the node trees they feed don't.
    m = re.search(r'\b(widget|app)\s+"[^"]*"\s*\{', text)
    body = text[m.end():].rsplit("}", 1)[0] if m else text
    masked = blank_strings(body)
    w = {"file": os.path.basename(path), "path": path,
         "masked": masked,
         "name": re.sub(r"^\d+-", "", re.sub(r"\.owl$", "", os.path.basename(path))),
         "sources": [], "triggers": [], "terminal": [],
         "page": None, "size": None, "kind": "widget"}
    m = re.search(r'size:\s*"?(\d+x\d+)"?', text)
    if m:
        w["size"] = m.group(1)
    m = re.search(r"page:\s*(\d+)", text)
    if m:
        w["page"] = int(m.group(1))
    m = re.search(r'^\s*app\s+"([^"]*)"', text, re.M)
    if m:
        w["kind"] = "app"
        w["name"] = m.group(1)
    else:
        m = re.search(r'^\s*widget\s+"([^"]*)"', text, re.M)
        if m:
            w["name"] = m.group(1)

    for line, stmt in statements(body):
        head = stmt.split("(", 1)[0]
        if stmt.startswith("source "):
            m = SOURCE_RE.match(stmt)
            if not m:
                continue
            name, expr = m.group(1), stmt[m.end():].strip()
            if expr.startswith("clock"):
                kind = "clock"
            elif expr.startswith("android."):
                kind = "android." + re.match(r"android\.(\w+)", expr).group(1)
            elif expr.startswith("cmd(") or expr.startswith("cmd ("):
                kind = "cmd"
            elif expr.startswith("stream("):
                kind = "stream"
            elif expr.startswith("http("):
                kind = "http"
            elif expr.startswith("file("):
                kind = "file"
            else:
                kind = head.strip()
            s = {"name": name, "kind": kind, "line": line,
                 "every": interval_seconds(expr),
                 "expr": expr, "command": None, "url": None,
                 "optional": bool(re.search(r"\boptional\b", expr))}
            if kind in ("cmd", "stream"):
                s["command"] = first_string(expr)
            elif kind == "http":
                s["url"] = first_string(expr)
            w["sources"].append(s)
        elif stmt.startswith("every "):
            w["triggers"].append({"kind": "every", "line": line,
                                  "every": interval_seconds(stmt),
                                  "body": stmt, "name": None})
        elif stmt.startswith("at "):
            w["triggers"].append({"kind": "at", "line": line, "every": None,
                                  "body": stmt, "name": None})
        elif stmt.startswith("when "):
            w["triggers"].append({"kind": "when", "line": line, "every": None,
                                  "body": stmt, "name": None})
        elif stmt.startswith("on "):
            w["triggers"].append({"kind": "on", "line": line, "every": None,
                                  "body": stmt, "name": None})
        elif stmt.startswith("Terminal"):
            w["terminal"].append(stmt)

    w["nodes"] = len(NODE_RE.findall(masked))
    w["canvasCalls"] = len(CANVAS_RE.findall(masked))
    w["loops"] = len(FOR_RE.findall(masked))
    w["shaders"] = len(re.findall(r"\bShader\s*\{", masked))
    w["images"] = len(re.findall(r"\bImage\s*\{", masked))
    w["webImages"] = len(re.findall(r"Image\s*\{[^}]*https?://", text, re.S))
    w["animates"] = bool(ANIM_RE.search(masked))
    w["errors"] = read_errors(path)
    return w


# --- command timing ------------------------------------------------------------

def cmd_key(kind, command):
    return hashlib.sha256(("%s\0%s" % (kind, command)).encode()).hexdigest()[:16]


def load_timings():
    try:
        with open(TIMINGS, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def save_timings(t):
    os.makedirs(CACHE, exist_ok=True)
    with open(TIMINGS, "w", encoding="utf-8") as fh:
        json.dump(t, fh, indent=1, sort_keys=True)


def run_timed(command, limit, wait=0.0):
    '''Run a command; return its CPU milliseconds (whole process tree).'''
    t0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    start = time.monotonic()
    p = None
    try:
        p = subprocess.Popen(["bash", "-c", command], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                             start_new_session=True)
        if wait:
            time.sleep(wait)
        try:
            p.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            pass
    except OSError:
        return None
    finally:
        if p is not None and p.poll() is None:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            try:
                p.wait(timeout=5)
            except Exception:
                pass
    t1 = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu_ms = ((t1.ru_utime - t0.ru_utime) + (t1.ru_stime - t0.ru_stime)) * 1000.0
    return {"cpuMs": round(cpu_ms, 2), "wallMs": round((time.monotonic() - start) * 1000),
            "code": p.returncode, "at": int(time.time()), "stream": bool(wait)}


def measure_all(widgets, timings, force=False):
    '''Time every cmd/stream command once. Cache: 30 days, or 7 for streams.'''
    todo = {}
    for w in widgets:
        for s in w["sources"]:
            if not s["command"]:
                continue
            k = cmd_key(s["kind"], s["command"])
            if not force and k in timings:
                age = time.time() - timings[k].get("at", 0)
                if age < (7 if s["kind"] == "stream" else 30) * 86400:
                    continue
            todo[k] = (s["kind"], s["command"])
    if not todo:
        return timings
    print("measuring %d commands (timeout 15s each)…" % len(todo), file=sys.stderr)
    for i, (k, (kind, command)) in enumerate(sorted(todo.items()), 1):
        one = command.replace("\n", " ")[:70]
        print("  [%d/%d] %s %s" % (i, len(todo), kind, one), file=sys.stderr)
        if kind == "stream":
            r = run_timed(command, 5.0, wait=2.0)
        else:
            r = run_timed(command, 15.0)
        if r:
            timings[k] = r
            save_timings(timings)
    return timings


# --- the cost model ------------------------------------------------------------

def estimate_frame_ms(w):
    '''Frame cost in ms. The launcher itself reports anything above ~4 ms, so a
    warning in .errors/ wins; otherwise it comes from what the widget draws, and
    can't be above the ~4 ms the launcher would have reported.'''
    if w["errors"]["frameMs"]:
        return w["errors"]["frameMs"]
    ms = (0.20 + 0.012 * w["nodes"] + 0.05 * w["canvasCalls"]
          + 0.05 * w["loops"] + 0.5 * w["shaders"] + 0.05 * w["images"])
    return min(ms, 4.0)


def cost(w, timings):
    '''Break a widget's day into parts, in mAh.'''
    parts = {k: 0.0 for k in PART_LABELS}
    notes, wakes, measured = [], 0.0, False
    vis = MODEL["visible"]
    frame_ms = estimate_frame_ms(w)
    hz = MODEL["frameHz"] / 2 if w["errors"]["halfRate"] else MODEL["frameHz"]
    redraw_mj = frame_ms / 1000.0 * MODEL["framePowerW"] * 1000.0 * MODEL["partialRedraw"]

    for s in w["sources"]:
        per_day = 86400.0 / max(s["every"], 1)
        if s["kind"] == "file":
            continue                       # watched, no polling at all
        if s["kind"] == "clock":
            # no wakeup: the launcher just redraws what reads it
            parts["updates"] += mah(per_day * vis * redraw_mj)
            wakes += per_day * vis
            continue
        n = per_day * vis
        wakes += n
        if s["kind"] == "cmd":
            t = timings.get(cmd_key("cmd", s["command"] or ""))
            cpu = t["cpuMs"] if t else cmd_cost_guess(s["command"] or "")
            measured = measured or bool(t)
            parts["commands"] += mah(n * (MODEL["spawnMj"] + cpu * MODEL["cpuPowerW"]))
            parts["updates"] += mah(n * redraw_mj)
        elif s["kind"] == "stream":
            t = timings.get(cmd_key("stream", s["command"] or ""))
            if t:
                measured = True
                mw = t["cpuMs"] / max(t["wallMs"], 1) * MODEL["cpuPowerW"] * 1000.0
            else:
                mw = 8.0                  # a quiet long-running helper
            parts["commands"] += mah_power(mw) * vis
        elif s["kind"] == "http":
            parts["radio"] += mah(n * MODEL["httpMj"])
            parts["updates"] += mah(n * redraw_mj)
        elif s["kind"].startswith("android."):
            parts["listeners"] += mah(n * MODEL["binderMj"])
            parts["updates"] += mah(n * redraw_mj)
        else:
            parts["updates"] += mah(n * redraw_mj)

    # animation: while the page is live, a widget that reads `time` redraws at
    # the display rate (half of it when the launcher said the tile is slow)
    if w["animates"]:
        frames = 86400.0 * vis * hz
        parts["frames"] += mah(frames * frame_ms / 1000.0 * MODEL["framePowerW"] * 1000.0)

    # triggers
    for t in w["triggers"]:
        if t["kind"] == "every":
            n = 86400.0 / max(t["every"], 1) * vis
            wakes += n
            parts["triggers"] += mah(n * redraw_mj)
            if re.search(r"\bpost\s*\(", t["body"]):
                parts["radio"] += mah(n * MODEL["httpMj"])
            if re.search(r"\bnotify\s*\(", t["body"]):
                parts["listeners"] += mah(n * MODEL["notifyMj"])
        elif t["kind"] == "at":
            n = 12.0                       # a handful a day; it does wake the phone
            parts["triggers"] += mah(n * MODEL["alarmMj"])
            wakes += n
        elif t["kind"] in ("when", "on"):
            if "OWL_USAGE_PY" in t["body"]:
                continue
            n = 24.0                       # a state change here and there
            wakes += n
            if re.search(r"\bnotify\s*\(", t["body"]):
                parts["listeners"] += mah(n * MODEL["notifyMj"])
            if re.search(r"\bpost\s*\(", t["body"]):
                parts["radio"] += mah(n * MODEL["httpMj"])

    # a live terminal: it keeps running off screen, and repaints on its own
    if w["terminal"]:
        parts["terminal"] += mah_power(MODEL["terminalMw"])
        parts["terminal"] += mah(86400.0 * MODEL["terminalHz"] * MODEL["terminalFrameMs"]
                                 / 1000.0 * MODEL["framePowerW"] * 1000.0)
        if re.search(r"command\s*:", " ".join(w["terminal"])):
            notes.append("program inside terminal is not counted (only the terminal itself)")

    # images from the web: fetched once a day (and kept)
    if w["webImages"]:
        parts["radio"] += mah(w["webImages"] * MODEL["imageMj"])

    e = w["errors"]
    if e["frameMs"]:
        notes.append("draws %.1f ms/frame (reported by launcher)" % e["frameMs"])
        if e["halfRate"]:
            notes.append("animates at half rate")
    else:
        notes.append("estimated draw: %.1f ms/frame" % frame_ms)
    if w["animates"]:
        anim = "animates whenever page is on screen (%d Hz)" % hz
        if re.search(r"\bif\b", w.get("masked", "")):
            anim += "; `time` inside a false `if` costs nothing"
        notes.append(anim)
    if e["timeouts"]:
        notes.append("slow command: " + ", ".join(e["timeouts"]))
    if e["images"]:
        notes.append("%d images failed to load" % e["images"])
    notes += e["failed"]
    return parts, notes, wakes, measured, frame_ms, hz


def cmd_cost_guess(command):
    '''Rough CPU ms of a command we haven't measured: a shell, plus a bit for
    every pipeline step and program it starts.'''
    progs = len([p for p in re.split(r"[|;&]|&&|\|\|", command) if p.strip()])
    return 4.0 + 2.0 * progs


def analyse():
    widgets = []
    if not os.path.isdir(WIDGETS):
        sys.exit("owl-usage: %s does not exist" % WIDGETS)
    for name in sorted(os.listdir(WIDGETS)):
        if not name.endswith(".owl") or name.startswith("."):
            continue
        try:
            widgets.append(parse_widget(os.path.join(WIDGETS, name)))
        except Exception as exc:                       # never fail on one file
            print("owl-usage: %s: %s" % (name, exc), file=sys.stderr)
    return widgets


def build(widgets, timings):
    rows = []
    # commands shared by several widgets run once in the launcher
    seen = {}
    for w in widgets:
        for s in w["sources"]:
            if s["command"]:
                seen.setdefault(s["command"], []).append(w["file"])
    shared = {c: f for c, f in seen.items() if len(f) > 1}
    for w in widgets:
        parts, notes, wakes, measured, frame_ms, hz = cost(w, timings)
        for c in shared:
            if any(s["command"] == c for s in w["sources"]):
                notes.append("command shared with " + ", ".join(
                    f for f in shared[c] if f != w["file"]))
                break
        total = sum(parts.values())
        top_parts = sorted(parts.items(), key=lambda kv: -kv[1])
        rows.append({
            "file": w["file"], "name": w["name"], "kind": w["kind"],
            "page": w["page"], "size": w["size"], "mah": round(total, 2),
            "parts": {k: round(v, 2) for k, v in parts.items() if v > 0},
            "top": [{"part": k, "label": PART_LABELS[k], "mah": round(v, 1)}
                    for k, v in top_parts[:3] if v > 0],
            "topText": " · ".join("%s %s" % (PART_LABELS[k], round(v, 1))
                                  for k, v in top_parts[:3] if v > 0),
            "frameMs": round(frame_ms, 2), "hz": hz,
            "nodes": w["nodes"], "animates": w["animates"],
            "terminal": bool(w["terminal"]), "measured": measured,
            "wakes": int(wakes),
            "sources": [{"name": s["name"], "kind": s["kind"],
                         "every": human_seconds(s["every"])}
                        for s in w["sources"]],
            "notes": notes,
        })
    rows.sort(key=lambda r: -r["mah"])
    total = sum(r["mah"] for r in rows) or 1.0
    top = max([r["mah"] for r in rows] or [1.0]) or 1.0
    for r in rows:
        r["share"] = round(r["mah"] / total * 100, 1)
        r["score"] = round(r["mah"] / top * 100)
        r["pct"] = round(r["mah"] / MODEL["phoneMah"] * 100, 2)
    return {
        "version": 1,
        "scriptVersion": "1.5",
        "generated": int(time.time()),
        "dir": WIDGETS,
        "model": {k: v for k, v in MODEL.items()},
        "totalMahPerDay": round(total, 1),
        "totalPctPerDay": round(total / MODEL["phoneMah"] * 100, 1),
        "phoneMah": MODEL["phoneMah"],
        "widgets": rows,
    }


# --- output --------------------------------------------------------------------

def fmt_table(doc):
    out = []
    out.append("estimated cost per widget — %.0f mAh/day total (%.1f%% of a %.0f mAh phone)"
               % (doc["totalMahPerDay"], doc["totalPctPerDay"], doc["phoneMah"]))
    out.append("model: page visible %.0f%% of day · %.0f Hz · %.1f V · cached command timings"
               % (doc["model"]["visible"] * 100, doc["model"]["frameHz"],
                  doc["model"]["batteryV"]))
    out.append("")
    out.append("%-26s %8s %6s %7s  %s" % ("widget", "mAh/day", "%bat", "wakes", "breakdown"))
    out.append("-" * 96)
    for r in doc["widgets"]:
        top = sorted(r["parts"].items(), key=lambda kv: -kv[1])[:3]
        which = ", ".join("%s %.1f" % (PART_LABELS.get(k, k), v) for k, v in top)
        out.append("%-26s %8.1f %5.2f%% %7d  %s" % (
            (r["name"][:26]), r["mah"], r["pct"], r["wakes"], which))
        note = "; ".join(r["notes"])
        if note:
            out.append("%-26s %s%s" % ("", "  ↳ ", note))
    out.append("-" * 96)
    out.append("estimate: launcher does not expose per-widget battery. "
               "See the \"widget drain\" widget screen for the model.")
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.split("\n")[0])
    ap.add_argument("--json", action="store_true", help="print JSON output")
    ap.add_argument("--quiet", action="store_true", help="print nothing")
    ap.add_argument("--measure", action="store_true", help="measure commands now")
    ap.add_argument("--quick", action="store_true",
                    help="do not measure: use cached timings and estimate the rest")
    ap.add_argument("--no-cache", action="store_true", help="ignore cached timings")
    args = ap.parse_args()

    widgets = analyse()
    timings = load_timings()
    if args.measure:
        timings = measure_all(widgets, timings, force=args.no_cache)
    elif not args.quick:
        timings = measure_all(widgets, timings)     # top up what's missing/old
    doc = build(widgets, timings)

    # Written in place: a widget's file() source notices a change of contents, and
    # an os.replace() would swap the inode out from under whatever watches it.
    os.makedirs(CACHE, exist_ok=True)
    with open(COSTS, "w", encoding="utf-8") as fh:
        json.dump(doc, fh, ensure_ascii=False, indent=1)

    if args.quiet:
        return
    print(json.dumps(doc, ensure_ascii=False, indent=1) if args.json else fmt_table(doc))


if __name__ == "__main__":
    main()
OWL_USAGE_PY
