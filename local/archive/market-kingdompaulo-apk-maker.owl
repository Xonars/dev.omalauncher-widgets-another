widget "Agentic APK Maker" {
  page: 1
  order: 4
  size: 6x3
  minSize: 3x2
  meta { owl: 10; description: "Status and launcher for the APK Maker OWL app."; version: "3.0.0"; license: "MIT"; category: "dev" }
  // All operations belong to apk-maker-app.owl. These files are the shared backend status.
  source job = file("~/.cache/apk-maker/job.json") json
  source apps = file("~/.cache/apk-maker/apps.json") json
  source setup = file("~/.cache/apk-maker/setup.json") json
  let phase = job.phase ?? "idle"
  let busy = contains(["queued", "agent", "checking", "building", "fixing", "art", "installing", "uploading"], phase)
  let current = (apps ?? []).find(a => a.slug == job.slug)
  let tint = phase == "failed" || phase == "cancelled" ? red : phase == "done" ? green : busy ? accent : muted
  onTap: open("o:apk-maker-app.owl")
  Column {
    gap: 10
    fill: true
    Row {
      align: center
      Text { text: "APK Maker"; bold: true; weight: 1; maxLines: 1 }
      Text { text: "${len(apps ?? [])} apps"; style: small; color: muted }
    }
    if setup.state != "done" {
      Text { text: setup.state == "running" ? "Setting up…" : "Open APK Maker to finish setup"; color: yellow; maxLines: 2 }
    } else {
      Text { text: busy ? "● ${phase}" : phase == "idle" ? "Ready to create" : "● ${phase}"; color: tint; maxLines: 1 }
      if job.slug != null {
        Text { text: current.label ?? job.slug; maxLines: 1 }
        if (rows ?? 3) >= 3 {
          Text { text: job.msg ?? ""; style: small; color: muted; maxLines: 2 }
        }
      }
    }
    Spacer { weight: 1 }
    Button { text: "Open APK Maker ›"; color: accent; fill: width; onTap: open("o:apk-maker-app.owl") }
  }
}
