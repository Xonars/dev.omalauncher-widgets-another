widget "dock" {
  page: 1
  order: 99               // after the other widgets, so it lands at the bottom
  size: 6x2
  minSize: 1x1
  padding: 8
  meta { owl: 5; description: "A dock of app shortcuts, edited on the phone, that opens apps, the browser, the app drawer or a terminal"; version: "1.0"; license: "MIT"; category: "productivity" }
  requires { pacman: ["bash"] }

  // Up to 12 slots, edited on the phone: tap the ✎ in the corner.
  // pkg is an Android package name, or "web" (default browser), "drawer" (app drawer)
  // or "terminal" (a Linux shell).
  let maxSlots = 16
  state slots = [
    { label: "phone",    pkg: "com.samsung.android.dialer",    art: "phone" },
    { label: "messages", pkg: "com.samsung.android.messaging", art: "chat" },
    { label: "camera",   pkg: "com.sec.android.app.camera",    art: "camera" },
    { label: "browser",  pkg: "web",                           art: "globe" },
    { label: "gallery",  pkg: "com.sec.android.gallery3d",     art: "photo" },
    { label: "apps",     pkg: "drawer",                        art: "grid" }
  ] persist
  state sel = 0
  state addedSocial = false persist
  state chatIcons = false persist
  state addedWork = false persist

  // one-time: append slack and google photos to the saved slots
  when !addedWork {
    slots = flatten([slots, [
      { label: "slack",  pkg: "com.Slack",                       art: "slack" },
      { label: "photos", pkg: "com.google.android.apps.photos", art: "gphotos" }
    ].filter(a => !any(slots, s => s.pkg == a.pkg))]).take(maxSlots)
    addedWork = true
  }

  // one-time: give chat apps already in the dock their own icons
  when !chatIcons {
    slots = slots.map(a => { label: a.label, pkg: a.pkg,
      art: a.pkg == "com.whatsapp" ? "whatsapp" : a.pkg == "org.thoughtcrime.securesms" ? "signal" : a.pkg == "org.telegram.messenger" ? "telegram" : a.art })
    chatIcons = true
  }

  // one-time: append reddit and x to the slots already saved on the phone
  when !addedSocial {
    slots = flatten([slots, [
      { label: "reddit", pkg: "com.reddit.frontpage", art: "reddit" },
      { label: "x",      pkg: "com.twitter.android",  art: "x" }
    ].filter(a => !any(slots, s => s.pkg == a.pkg))]).take(maxSlots)
    addedSocial = true
  }
  state tab = "apps"

  // apps offered in the editor; package names are Samsung's and Google's
  let presets = [
    { label: "phone",    pkg: "com.samsung.android.dialer",           art: "phone" },
    { label: "messages", pkg: "com.samsung.android.messaging",        art: "chat" },
    { label: "camera",   pkg: "com.sec.android.app.camera",           art: "camera" },
    { label: "gallery",  pkg: "com.sec.android.gallery3d",            art: "photo" },
    { label: "contacts", pkg: "com.samsung.android.app.contacts",     art: "user" },
    { label: "clock",    pkg: "com.sec.android.app.clockpackage",     art: "clock" },
    { label: "calendar", pkg: "com.samsung.android.calendar",         art: "calendar" },
    { label: "files",    pkg: "com.sec.android.app.myfiles",          art: "folder" },
    { label: "notes",    pkg: "com.samsung.android.app.notes",        art: "note" },
    { label: "calc",     pkg: "com.sec.android.app.popupcalculator",  art: "calc" },
    { label: "internet", pkg: "com.sec.android.app.sbrowser",         art: "globe" },
    { label: "wallet",   pkg: "com.samsung.android.spay",             art: "card" },
    { label: "weather",  pkg: "com.sec.android.daemonapp",            art: "cloud" },
    { label: "settings", pkg: "com.android.settings",                 art: "gear" },
    { label: "store",    pkg: "com.android.vending",                  art: "bag" },
    { label: "chrome",   pkg: "com.android.chrome",                   art: "globe" },
    { label: "gmail",    pkg: "com.google.android.gm",                art: "mail" },
    { label: "maps",     pkg: "com.google.android.apps.maps",         art: "pin" },
    { label: "photos",   pkg: "com.google.android.apps.photos",       art: "gphotos" },
    { label: "youtube",  pkg: "com.google.android.youtube",           art: "video" },
    { label: "yt music", pkg: "com.google.android.apps.youtube.music", art: "music" },
    { label: "spotify",  pkg: "com.spotify.music",                    art: "music" },
    { label: "whatsapp", pkg: "com.whatsapp",                         art: "whatsapp" },
    { label: "telegram", pkg: "org.telegram.messenger",               art: "telegram" },
    { label: "signal",   pkg: "org.thoughtcrime.securesms",           art: "signal" },
    { label: "slack",    pkg: "com.Slack",                            art: "slack" },
    { label: "reddit",   pkg: "com.reddit.frontpage",                 art: "reddit" },
    { label: "x",        pkg: "com.twitter.android",                  art: "x" },
    { label: "browser",  pkg: "web",                                  art: "globe" },
    { label: "apps",     pkg: "drawer",                               art: "grid" },
    { label: "terminal", pkg: "terminal",                             art: "term" }
  ]

  // Line icons on a 24-unit grid, stroked in the theme's accent colour
  let artNames = [
    "phone", "chat", "camera", "globe", "photo", "grid", "mail", "music", "pin", "gear",
    "clock", "calendar", "video", "term", "folder", "note", "user", "calc", "bag", "card",
    "cloud", "bell", "search", "game", "heart", "star", "whatsapp", "signal", "telegram", "slack", "gphotos", "reddit", "x"
  ]
  // ellipses, as points, for shapes arcs can't draw
  let meridian = range(37).map(i => [12 + 4 * sin(rad(i * 10)), 12 - 9.5 * cos(rad(i * 10))])
  let snooHead = range(37).map(i => [12 + 8.5 * sin(rad(i * 10)), 15 - 6 * cos(rad(i * 10))])
  let starPts = range(10).map(i => [12 + (i % 2 == 0 ? 9.5 : 4) * sin(rad(i * 36)), 13 - (i % 2 == 0 ? 9.5 : 4) * cos(rad(i * 36))])

  let pencil = [
    ".......xx", "......x.x", ".....x.x.", "....x.x..",
    "...x.x...", "..x.x....", ".x.x.....", "xxx......", "xx......."
  ]

  // Keep shortcuts usable in small tiles; scroll when all rows won't fit.
  let n = len(slots)
  let perRow = clamp(max(min(n, cols ?? 6), ceil(n / max(1, rows ?? 2))), 1, max(1, min(16, floor(((tileWidth ?? 400) - 16) / 40))))
  let nRows = max(1, ceil(n / perRow))
  let cellW = ((tileWidth ?? 400) - 16) / perRow
  let rowH = max(40, ((tileHeight ?? 130) - 16) / nRows)
  let showLabels = rowH >= 72
  let iconSize = floor(clamp(min(cellW - 8, rowH - (showLabels ? 24 : 6)), 24, 56))

  component Icon(art, px, tint = accent) {
    Canvas {
      size: px * 16
      let g = px * 16 * 0.6
      let w = 1.9
      translate((px * 16 - g) / 2, (px * 16 - g) / 2) {
        scale(g / 24, g / 24, 0, 0) {
          if art == "phone" {
            path([[5, 3], [9, 3], [11, 8], [8.5, 9.8], [14.2, 15.5], [16, 13], [21, 15], [21, 19], [19, 21], [13, 19.3], [7.5, 15], [4.2, 10], [3, 5.5]], closed: true, stroke: tint, width: w, cap: round)
          } else if art == "chat" {
            rect(3, 4, 18, 13, radius: 3.5, stroke: tint, width: w)
            path([[7, 17], [6.5, 21], [11.5, 17]], stroke: tint, width: w, cap: round)
            line(7.5, 9, 16.5, 9, stroke: tint, width: w, cap: round)
            line(7.5, 12.5, 13, 12.5, stroke: tint, width: w, cap: round)
          } else if art == "camera" {
            rect(2, 7, 20, 14, radius: 3, stroke: tint, width: w)
            path([[7.5, 7], [9.3, 4], [14.7, 4], [16.5, 7]], stroke: tint, width: w, cap: round)
            circle(12, 14, 4, stroke: tint, width: w)
          } else if art == "globe" {
            circle(12, 12, 9.5, stroke: tint, width: w)
            path(meridian, stroke: tint, width: w)
            line(2.5, 12, 21.5, 12, stroke: tint, width: w)
          } else if art == "photo" {
            rect(3, 4, 18, 16, radius: 2.5, stroke: tint, width: w)
            circle(15.5, 9, 1.8, fill: tint)
            path([[3.5, 17.5], [9, 12], [14, 17], [16.5, 14.5], [20.5, 18.5]], stroke: tint, width: w, cap: round)
          } else if art == "grid" {
            for i in range(3) {
              for j in range(3) { rect(3.5 + i * 6.5, 3.5 + j * 6.5, 4, 4, radius: 1.2, fill: tint) }
            }
          } else if art == "mail" {
            rect(2.5, 5, 19, 14, radius: 2.5, stroke: tint, width: w)
            path([[3.5, 6.5], [12, 13], [20.5, 6.5]], stroke: tint, width: w, cap: round)
          } else if art == "music" {
            path([[9, 18], [9, 5], [20, 3], [20, 16]], stroke: tint, width: w, cap: round)
            circle(6.5, 18, 2.6, stroke: tint, width: w)
            circle(17.5, 16, 2.6, stroke: tint, width: w)
          } else if art == "pin" {
            arc(12, 10, 7, 225, 270, stroke: tint, width: w)
            path([[7.05, 14.95], [12, 21.5], [16.95, 14.95]], stroke: tint, width: w, cap: round)
            circle(12, 10, 2.5, stroke: tint, width: w)
          } else if art == "gear" {
            for i in range(8) {
              rotate(i * 45, 12, 12) { line(12, 2.8, 12, 5, stroke: tint, width: 3.4, cap: round) }
            }
            circle(12, 12, 7, stroke: tint, width: w)
            circle(12, 12, 2.8, stroke: tint, width: w)
          } else if art == "clock" {
            circle(12, 12, 9.5, stroke: tint, width: w)
            path([[12, 6.5], [12, 12], [15.5, 14.5]], stroke: tint, width: w, cap: round)
          } else if art == "calendar" {
            rect(3, 5, 18, 16, radius: 2.5, stroke: tint, width: w)
            line(3, 10, 21, 10, stroke: tint, width: w)
            line(8, 3, 8, 7, stroke: tint, width: w, cap: round)
            line(16, 3, 16, 7, stroke: tint, width: w, cap: round)
            for i in range(3) { circle(7.5 + i * 4.5, 14.5, 1.1, fill: tint) }
            for i in range(2) { circle(7.5 + i * 4.5, 18, 1.1, fill: tint) }
          } else if art == "video" {
            rect(2, 5, 20, 14, radius: 4, stroke: tint, width: w)
            path([[10, 9], [15.5, 12], [10, 15]], closed: true, fill: tint)
          } else if art == "term" {
            rect(2, 4, 20, 16, radius: 2.5, stroke: tint, width: w)
            path([[6.5, 9], [9.5, 12], [6.5, 15]], stroke: tint, width: w, cap: round)
            line(12, 15, 17, 15, stroke: tint, width: w, cap: round)
          } else if art == "folder" {
            path([[3, 5], [9, 5], [11, 7.5], [21, 7.5], [21, 19], [3, 19]], closed: true, stroke: tint, width: w)
            line(3, 10.5, 21, 10.5, stroke: tint, width: w)
          } else if art == "note" {
            path([[5, 3], [14, 3], [19, 8], [19, 21], [5, 21]], closed: true, stroke: tint, width: w)
            path([[14, 3], [14, 8], [19, 8]], stroke: tint, width: w)
            line(8.5, 13, 15.5, 13, stroke: tint, width: w, cap: round)
            line(8.5, 17, 12.5, 17, stroke: tint, width: w, cap: round)
          } else if art == "user" {
            circle(12, 8, 4, stroke: tint, width: w)
            arc(12, 21, 7.5, 270, 180, stroke: tint, width: w, cap: round)
          } else if art == "calc" {
            rect(4, 2, 16, 20, radius: 2.5, stroke: tint, width: w)
            rect(7.5, 5.5, 9, 3.5, radius: 1, fill: tint)
            for r in range(2) {
              for c in range(3) { circle(8.3 + c * 3.7, 13.5 + r * 4, 1.1, fill: tint) }
            }
          } else if art == "bag" {
            path([[4, 8], [20, 8], [19, 21], [5, 21]], closed: true, stroke: tint, width: w)
            arc(12, 8, 4, 270, 180, stroke: tint, width: w)
          } else if art == "card" {
            rect(2, 5, 20, 14, radius: 2.5, stroke: tint, width: w)
            line(2, 9.5, 22, 9.5, stroke: tint, width: w)
            line(6, 15, 10, 15, stroke: tint, width: w, cap: round)
          } else if art == "cloud" {
            arc(7, 14.5, 4, 180, 180, stroke: tint, width: w)
            arc(12.5, 11, 5.5, 300, 130, stroke: tint, width: w)
            arc(17.5, 14.5, 4, 0, 180, stroke: tint, width: w)
            line(7, 18.5, 17.5, 18.5, stroke: tint, width: w, cap: round)
          } else if art == "bell" {
            arc(12, 10, 6, 270, 180, stroke: tint, width: w)
            path([[6, 10], [6, 15], [4, 17.5], [20, 17.5], [18, 15], [18, 10]], stroke: tint, width: w, cap: round)
            line(12, 2.5, 12, 4, stroke: tint, width: w, cap: round)
            arc(12, 19.5, 2.2, 90, 180, stroke: tint, width: w)
          } else if art == "search" {
            circle(10.5, 10.5, 6.5, stroke: tint, width: w)
            line(15.5, 15.5, 21, 21, stroke: tint, width: w + 0.6, cap: round)
          } else if art == "game" {
            rect(2, 7, 20, 11, radius: 5.5, stroke: tint, width: w)
            line(7.5, 10.5, 7.5, 14.5, stroke: tint, width: w, cap: round)
            line(5.5, 12.5, 9.5, 12.5, stroke: tint, width: w, cap: round)
            circle(15, 11.5, 1.2, fill: tint)
            circle(17.5, 14, 1.2, fill: tint)
          } else if art == "heart" {
            arc(7.5, 9.5, 4.5, 225, 225, stroke: tint, width: w)
            arc(16.5, 9.5, 4.5, 270, 225, stroke: tint, width: w)
            path([[4.32, 12.68], [12, 20.5], [19.68, 12.68]], stroke: tint, width: w, cap: round)
          } else if art == "star" {
            path(starPts, closed: true, stroke: tint, width: w)
          } else if art == "whatsapp" {
            arc(12, 12, 9.5, 235, 325, stroke: tint, width: w)
            path([[4.22, 17.45], [3, 21], [8.75, 20.93]], stroke: tint, width: w, cap: round)
            path([[9.06, 7.82], [10.74, 7.82], [11.58, 9.92], [10.53, 10.68], [12.92, 13.07], [13.68, 12.02], [15.78, 12.86], [15.78, 14.54], [14.94, 15.38], [12.42, 14.67], [10.11, 12.86], [8.72, 10.76], [8.22, 8.87]], closed: true, fill: tint)
          } else if art == "signal" {
            for i in range(10) { arc(12, 12, 9.5, 240 + i * 31, 19, stroke: tint, width: w, cap: round) }
            circle(12, 12, 6, fill: tint)
            path([[7.2, 14.2], [6, 18.5], [10.3, 17.3]], closed: true, fill: tint)
          } else if art == "telegram" {
            path([[2.5, 11.2], [21.5, 3.5], [17.8, 20.5]], closed: true, stroke: tint, width: w)
            path([[21.5, 3.5], [9.5, 14], [10, 19.5], [13, 16.5]], stroke: tint, width: w, cap: round)
          } else if art == "slack" {
            for i in range(4) {
              rotate(i * 90, 12, 12) {
                line(9.6, 4, 9.6, 9.6, stroke: tint, width: 3.4, cap: round)
                circle(4.6, 9.6, 1.7, fill: tint)
              }
            }
          } else if art == "gphotos" {
            for i in range(4) {
              rotate(i * 90, 12, 12) {
                arc(12, 7.25, 4.75, 180, 180, stroke: tint, width: w)
                line(12, 2.5, 12, 12, stroke: tint, width: w, cap: round)
              }
            }
          } else if art == "reddit" {
            path(snooHead, stroke: tint, width: w)
            circle(4.5, 10, 1.8, stroke: tint, width: w)
            circle(19.5, 10, 1.8, stroke: tint, width: w)
            circle(9, 14.5, 1.3, fill: tint)
            circle(15, 14.5, 1.3, fill: tint)
            arc(12, 15.5, 3.2, 125, 110, stroke: tint, width: w - 0.3, cap: round)
            path([[12, 9], [13.5, 3.5], [17.5, 4.5]], stroke: tint, width: w - 0.3, cap: round)
            circle(19, 4.8, 1.5, fill: tint)
          } else if art == "x" {
            path([[3.5, 3], [8.5, 3], [20.5, 21], [15.5, 21]], closed: true, stroke: tint, width: w - 0.2)
            line(19.5, 3, 13.6, 9.6, stroke: tint, width: w, cap: round)
            line(10.4, 14.4, 4.5, 21, stroke: tint, width: w, cap: round)
          } else {
            circle(12, 12, 3, fill: tint)
          }
        }
      }
    }
  }

  component DockFace(label, art, box, labels) {
    Column {
      gap: 4
      align: center
      Box {
        size: box
        background: surface
        border: 1
        borderColor: border
        align: center
        Icon { art: art; px: box / 16 }
      }
      if labels {
        Text { text: label; style: small; color: alpha(foreground, 0.75); align: center; maxLines: 1 }
      }
    }
  }

  component DockApp(label, pkg, art, box, labels) {
    if pkg == "" || pkg == "drawer" {
      Column { align: center; onTap: launcher("drawer")
        DockFace { label: label; art: art; box: box; labels: labels } }
    } else if pkg == "web" {
      // opens whichever browser is the phone's default
      Column { align: center; onTap: url("https://www.google.com")
        DockFace { label: label; art: art; box: box; labels: labels } }
    } else if pkg == "terminal" {
      Column { align: center; onTap: terminal("bash")
        DockFace { label: label; art: art; box: box; labels: labels } }
    } else {
      Column { align: center; onTap: androidApp(pkg)
        DockFace { label: label; art: art; box: box; labels: labels } }
    }
  }

  Box {
    fill: true
    Column {
      fill: true
      scroll: true
      gap: 0
      justify: spaceEvenly
      for r in range(nRows) {
        Row {
          height: rowH
          gap: 0
          justify: center
          align: center
          fill: width
          for a in slots.drop(r * perRow).take(perRow) {
            DockApp { label: a.label; pkg: a.pkg; art: a.art; box: iconSize; labels: showLabels; width: cellW }
          }
        }
      }
    }
    // edit button, tucked into the tile's corner
    Box {
      align: topEnd
      fill: true
      Box {
        size: 22
        offset: [8, -8]
        align: center
        opacity: 0.85
        onTap: { sel = 0; screen() }
        Canvas { size: 14; sprite(pencil, 0, 0, 1.5, fill: alpha(foreground, 0.6)) }
      }
    }
  }

  screen {
    title: "edit dock"
    Column {
      scroll: true
      gap: 10
      padding: 12

      Row {
        align: center
        Text { text: "slots  ${n}/${maxSlots}"; style: label; weight: 1 }
        Button { text: "+ add"; color: n < maxSlots ? accent : muted
          onTap: { slots = n < maxSlots ? flatten([slots, [{ label: "new", pkg: "drawer", art: "star" }]]) : slots; sel = len(slots) - 1 } }
      }
      Grid {
        columns: 6
        gap: 6
        for a, i in slots {
          Column {
            gap: 2
            align: center
            onTap: sel = i
            Box {
              size: 48
              background: surface
              border: i == sel ? 2 : 1
              borderColor: i == sel ? accent : border
              align: center
              Icon { art: a.art; px: 3 }
            }
            Text { text: a.label; style: small; align: center; maxLines: 1; color: i == sel ? accent : alpha(foreground, 0.75) }
          }
        }
      }

      if sel < n {
        let s = slots[sel]
        Row {
          gap: 6
          Button { text: "◀ left"; onTap: { slots = range(n).map(i => i == sel - 1 ? slots[sel] : i == sel ? slots[sel - 1] : slots[i]); sel = sel - 1 }; visible: sel > 0 }
          Button { text: "right ▶"; onTap: { slots = range(n).map(i => i == sel + 1 ? slots[sel] : i == sel ? slots[sel + 1] : slots[i]); sel = sel + 1 }; visible: sel < n - 1 }
          Spacer { weight: 1 }
          Button { text: "remove"; color: red; visible: n > 1
            onTap: { slots = range(n).filter(i => i != sel).map(i => slots[i]); sel = max(0, sel - 1) } }
        }

        Text { text: "label"; style: label }
        Input { text: s.label; placeholder: "label"
          onChange: slots = range(n).map(i => i == sel ? { label: value, pkg: slots[i].pkg, art: slots[i].art } : slots[i]) }
        Text { text: "opens"; style: label }
        Input { text: s.pkg; placeholder: "package name, web, drawer or terminal"
          onChange: slots = range(n).map(i => i == sel ? { label: slots[i].label, pkg: trim(value), art: slots[i].art } : slots[i]) }

        Row {
          gap: 6
          Button { text: "pick app"; color: tab == "apps" ? accent : muted; onTap: tab = "apps" }
          Button { text: "pick icon"; color: tab == "icons" ? accent : muted; onTap: tab = "icons" }
        }

        if tab == "icons" {
          Grid {
            columns: 6
            gap: 6
            for name in artNames {
              Box {
                size: 48
                background: surface
                border: name == s.art ? 2 : 1
                borderColor: name == s.art ? accent : border
                align: center
                onTap: slots = range(n).map(i => i == sel ? { label: slots[i].label, pkg: slots[i].pkg, art: name } : slots[i])
                Icon { art: name; px: 3 }
              }
            }
          }
        } else {
          Grid {
            columns: 3
            gap: 6
            for p in presets {
              Row {
                gap: 6
                align: center
                padding: [6, 4]
                background: surface
                border: 1
                borderColor: p.pkg == s.pkg ? accent : border
                onTap: slots = range(n).map(i => i == sel ? { label: p.label, pkg: p.pkg, art: p.art } : slots[i])
                Icon { art: p.art; px: 1.5 }
                Text { text: p.label; style: small; maxLines: 1; weight: 1 }
              }
            }
          }
        }
      }

      Row {
        gap: 6
        Spacer { weight: 1 }
        Button { text: "done"; color: accent; onTap: close() }
      }
    }
  }
}
