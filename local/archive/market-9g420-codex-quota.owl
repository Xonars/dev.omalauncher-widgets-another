    disclaimer: ["Unofficial community widget; not affiliated with OpenAI, Tibo or Codex Reset. A credit announcement does not confirm a refill in your Codex account.", "非 OpenAI、Tibo 或 Codex Reset 官方组件。额度奖励公告不代表你的 Codex 账户已恢复额度。", "Widget comunitario no oficial; no está afiliado a OpenAI, Tibo ni Codex Reset. Un anuncio de créditos no confirma una recarga en tu cuenta de Codex.", "Inoffizielles Community-Widget; nicht mit OpenAI, Tibo oder Codex Reset verbunden. Eine Guthabenmeldung bestätigt keine Aufladung deines Codex-Kontos.", "Widget communautaire non officiel, sans lien avec OpenAI, Tibo ou Codex Reset. Une annonce de crédits ne confirme pas le rétablissement de votre quota Codex.", "非公式コミュニティウィジェットです。OpenAI、Tibo、Codex Resetとは関係ありません。クレジット告知はCodexアカウントの回復を示しません。", "비공식 커뮤니티 위젯이며 OpenAI, Tibo 또는 Codex Reset과 관련이 없습니다. 크레딧 공지는 Codex 계정의 충전을 확인하지 않습니다.", "Неофициальный виджет сообщества, не связанный с OpenAI, Tibo или Codex Reset. Объявление о кредитах не подтверждает восстановление квоты вашего аккаунта Codex."],
    source_credit: ["Data", "数据", "Datos", "Daten", "Source", "出典", "출처", "Данные"]
  }
  let languageShort = language == "zh" ? "中" : language == "es" ? "ES" : language == "de" ? "DE" : language == "fr" ? "FR" : language == "ja" ? "日" : language == "ko" ? "한" : language == "ru" ? "RU" : "EN"
  let nextLanguage = language == "en" ? "zh" : language == "zh" ? "es" : language == "es" ? "de" : language == "de" ? "fr" : language == "fr" ? "ja" : language == "ja" ? "ko" : language == "ko" ? "ru" : "en"
  let languageOptions = [
    { code: "en", label: "English" },
    { code: "zh", label: "中文" },
    { code: "es", label: "Español" },
    { code: "de", label: "Deutsch" },
    { code: "fr", label: "Français" },
    { code: "ja", label: "日本語" },
    { code: "ko", label: "한국어" },
    { code: "ru", label: "Русский" }
  ]
  let weekdays = [
    ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
    ["一", "二", "三", "四", "五", "六", "日"],
    ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"],
    ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
    ["lun", "mar", "mer", "jeu", "ven", "sam", "dim"],
    ["月", "火", "水", "木", "金", "土", "日"],
    ["월", "화", "수", "목", "금", "토", "일"],
    ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]
  ]
  let monthNames = [
    ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"],
    ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
    ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"],
    ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"],
    ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"],
    ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
    ["1월", "2월", "3월", "4월", "5월", "6월", "7월", "8월", "9월", "10월", "11월", "12월"],
    ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"]
  ]
  let secondary = alpha(foreground, 0.72)
  let quiet = alpha(foreground, 0.52)
  let panel = alpha(foreground, 0.055)
  let unreadReset = tibo.reset_key != null && ackResetKey != "" && tibo.reset_key != ackResetKey
  let tight = ((cols ?? 4) < 4 && (rows ?? 4) < 4) || (cols ?? 4) <= 2 || (rows ?? 4) <= 2
  let publicEvents = tibo.events ?? []
  let calendarMonths = tibo.calendars ?? []
  let monthIndex = floor(max(0, min(36, num(monthOffset, 0) + 24)))
  let calendarMonth = calendarMonths[monthIndex]
  let activeDate = selectedDate == "" ? tibo.today : selectedDate
  let selectedEntries = publicEvents.filter(event => event.date == activeDate)
  let latestReset = tibo.latest
  let monitorItem = latestReset ?? tibo.featured
  let tiny = (cols ?? 4) <= 2 && (rows ?? 4) <= 2
  let narrow = (cols ?? 4) <= 2 && (rows ?? 4) > 2
  let wide = (cols ?? 4) > (rows ?? 4)

  when tibo.reset_key != null && ackResetKey == "" { ackResetKey = tibo.reset_key }
  when tibo.key != null && seenTibo == "" { seenTibo = tibo.key }
  on tibo.key {
    notify(value != null && seenTibo != "" && value != seenTibo ? strings.notification_update[languageIndex] : null, tibo.headline)
    seenTibo = value ?? seenTibo
  }
  on q.refresh_request { quotaRefreshing = false }
  at q.five.resets_at {
    notify(q.five.resets_at != null && remindFive != q.five.resets_at ? strings.notification_five[languageIndex] : null, strings.notification_due[languageIndex])
    remindFive = q.five.resets_at ?? remindFive
  }
  at q.week.resets_at {
    notify(q.week.resets_at != null && remindWeek != q.week.resets_at ? strings.notification_week[languageIndex] : null, strings.notification_due[languageIndex])
    remindWeek = q.week.resets_at ?? remindWeek
  }

  onTap: { ackResetKey = tibo.reset_key ?? ackResetKey; screen() }

  component Lamp(lit, diameter = 10) {
    Canvas {
      size: diameter
      circle(width / 2, height / 2, min(width, height) / 2, fill: lit ? #34d399 : alpha(foreground, 0.22))
    }
  }
  component Rule() { Spacer { height: 1; fill: width; background: alpha(foreground, 0.12) } }
  component Quota(label, data, dense = false, mini = false, horizontal = false) {
    Column {
      gap: mini ? 2 : dense ? 3 : 5
      padding: mini ? 4 : dense ? 8 : 14
      background: panel
      radius: 0
      if mini {
        if horizontal {
          Text {
            text: label + "  " + (data.remaining == null ? "—" : "${round(data.remaining)}%")
            fontSize: 13
            bold: true
            color: data.remaining != null && data.remaining <= 15 ? #fb927d : foreground
            maxLines: 1
          }
          if data.remaining != null {
            Progress { value: data.remaining; color: alpha(foreground, 0.75); track: alpha(foreground, 0.12); height: 2; fill: width }
          }
          let left = data.resets_at == null ? null : max(data.resets_at - now, 0)
          let compactReset = left == null ? strings.no_reset_time[languageIndex] : left <= 0 ? strings.due_unconfirmed[languageIndex] : left >= 86400 ? strings.days_prefix[languageIndex] + str(floor(left / 86400)) + strings.day_unit[languageIndex] + strings.time_join[languageIndex] + str(floor(left % 86400 / 3600)) + strings.hour_unit[languageIndex] + strings.time_left_suffix[languageIndex] : strings.hours_prefix[languageIndex] + str(floor(left / 3600)) + strings.hour_unit[languageIndex] + strings.time_join[languageIndex] + str(floor(left % 3600 / 60)) + strings.minute_unit[languageIndex] + strings.time_left_suffix[languageIndex]
          Text { text: compactReset; font: sans; fontSize: 9; color: secondary; maxLines: 1 }
        } else {
          Text { text: label; font: sans; fontSize: 10; color: secondary; maxLines: 1 }
          Text {
            text: data.remaining == null ? "—" : "${round(data.remaining)}%"
            fontSize: 16
            bold: true
            color: data.remaining != null && data.remaining <= 15 ? #fb927d : foreground
            maxLines: 1
          }
          if data.remaining != null {
            Progress { value: data.remaining; color: alpha(foreground, 0.75); track: alpha(foreground, 0.12); height: 2; fill: width }
          }
        }
      } else {
        Text { text: label; font: sans; fontSize: dense ? 12 : 14; color: secondary; maxLines: 1 }
        Text {
          text: data.remaining == null ? strings.unknown[languageIndex] : "${data.remaining}%"
          fontSize: dense ? 26 : 34
          bold: true
          color: data.remaining != null && data.remaining <= 15 ? #fb927d : foreground
          maxLines: 1
        }
        if data.remaining != null {
          Progress { value: data.remaining; color: alpha(foreground, 0.75); track: alpha(foreground, 0.12); height: 3; fill: width }
        }
        let left = data.resets_at == null ? null : max(data.resets_at - now, 0)
        let secondsLeft = left ?? 0
        let daysLeft = floor(secondsLeft / 86400)
        let hoursLeft = floor(secondsLeft % 86400 / 3600)
        let hoursOnly = floor(secondsLeft / 3600)
        let minutesLeft = floor(secondsLeft % 3600 / 60)
        let dayText = strings.days_prefix[languageIndex] + str(daysLeft) + strings.day_unit[languageIndex] + strings.time_join[languageIndex] + str(hoursLeft) + strings.hour_unit[languageIndex] + (dense ? strings.time_left_suffix[languageIndex] : strings.time_until_suffix[languageIndex])
        let hourText = strings.hours_prefix[languageIndex] + str(hoursOnly) + strings.hour_unit[languageIndex] + strings.time_join[languageIndex] + str(minutesLeft) + strings.minute_unit[languageIndex] + (dense ? strings.time_left_suffix[languageIndex] : strings.time_until_suffix[languageIndex])
        Text {
          text: left == null ? strings.no_reset_time[languageIndex] : left <= 0 ? strings.due_unconfirmed[languageIndex] : left >= 86400 ? dayText : hourText
          font: sans
          fontSize: dense ? 10 : 12
          color: secondary
          maxLines: 1
        }
        if !dense && data.resets_at != null {
          Text { text: strings.expected_reset[languageIndex] + fmtTime(data.resets_at, "MM-dd HH:mm"); font: sans; fontSize: 12; color: quiet; maxLines: 1 }
        }
      }
    }
  }
  component Metric(label, value) {
    Column {
      gap: 6
      padding: 12
      background: panel
      radius: 0
      Text { text: label; font: sans; fontSize: 12; color: secondary; maxLines: 2 }
      Text { text: value ?? "—"; fontSize: 24; bold: true; maxLines: 1 }
    }
  }
  component Post(item) {
    Column {
      gap: 10
      padding: 14
      background: panel
      radius: 0
      Row {
        align: center
        Column {
          gap: 2
          weight: 1
          Text { text: "Tibo"; font: sans; fontSize: 15; bold: true; maxLines: 1 }
          Text { text: item.group == "credits" ? strings.credits[languageIndex] : strings.quota_reset[languageIndex]; font: sans; fontSize: 11; color: secondary; maxLines: 1 }
        }
        Text { text: item.confirmed ? strings.announced[languageIndex] : strings.unconfirmed[languageIndex]; font: sans; fontSize: 12; color: item.confirmed ? #34d399 : #fbbf24; width: 100; align: end; maxLines: 2 }
      }
      Text { text: item.title; font: sans; fontSize: 17; bold: true; maxLines: 5 }
      if item.schedule != "" {
        Text { text: strings.source_schedule[languageIndex] + item.schedule; font: sans; fontSize: 13; color: #fbbf24; maxLines: 3 }
      }
      Row {
        align: center
        Text { text: fmtTime(item.time, "MM-dd HH:mm"); fontSize: 12; color: secondary; weight: 1 }
        if item.url != "" { Button { text: strings.original_post[languageIndex]; onTap: url(item.url) } }
      }
    }
  }

  Column {
    gap: tight ? 2 : (rows ?? 4) < 4 ? 3 : 8
    padding: tight ? 6 : (rows ?? 4) < 4 ? 8 : 10
    Row {
      align: center
      Text { text: "Codex"; font: sans; fontSize: tight ? 10 : 14; bold: true; weight: 1; maxLines: 1 }
      if tight {
        Button { text: languageShort; width: 36; height: 28; padding: 0; onTap: language = nextLanguage }
      } else {
        Button { text: languageShort; onTap: language = nextLanguage }
      }
      Lamp { lit: unreadReset; diameter: 9 }
    }
    if tight {
      if tiny {
        Row {
          gap: 4
          Quota { label: strings.five_hour_short[languageIndex]; data: q.five; mini: true; weight: 1 }
          Quota { label: strings.weekly_short[languageIndex]; data: q.week; mini: true; weight: 1 }
        }
        Text { text: monitorItem != null ? ("Tibo · " + (tibo.stale ? (strings.delayed_prefix[languageIndex] + monitorItem.title) : monitorItem.title)) : (tibo.stale ? strings.monitor_unavailable[languageIndex] : strings.no_updates[languageIndex]); font: sans; fontSize: 9; color: unreadReset ? #34d399 : secondary; maxLines: 1 }
      } else if narrow {
        Column {
          gap: 4
          Quota { label: strings.five_hour_short[languageIndex]; data: q.five; mini: true; horizontal: true }
          Quota { label: strings.weekly_short[languageIndex]; data: q.week; mini: true; horizontal: true }
        }
        Row {
          align: center
          Text { text: "Tibo"; font: sans; fontSize: 11; bold: true; weight: 1; maxLines: 1 }
          Text { text: unreadReset ? strings.new_update[languageIndex] : strings.view[languageIndex]; font: sans; fontSize: 10; color: unreadReset ? #34d399 : secondary; width: 64; align: end; maxLines: 1 }
        }
        Text { text: monitorItem != null ? (tibo.stale ? (strings.delayed_prefix[languageIndex] + monitorItem.title) : monitorItem.title) : (tibo.stale ? strings.monitor_unavailable[languageIndex] : strings.no_updates[languageIndex]); font: sans; fontSize: 10; color: secondary; maxLines: 2 }
        Row {
          align: center
          Text { text: q.updated_at == null ? strings.waiting_quota[languageIndex] : strings.quota_record[languageIndex] + fmtTime(q.updated_at, "HH:mm") + (q.stale ? strings.stale_suffix[languageIndex] : ""); font: sans; fontSize: 9; color: quiet; weight: 1; maxLines: 1 }
          Text { text: "codex-reset.com"; font: sans; width: 80; fontSize: 9; color: quiet; align: end; onTap: url("https://codex-reset.com/") }
        }
      } else if wide {
        Row {
          gap: 6
          Quota { label: strings.five_hour_micro[languageIndex]; data: q.five; mini: true; horizontal: true; weight: 1 }
          Quota { label: strings.weekly_micro[languageIndex]; data: q.week; mini: true; horizontal: true; weight: 1 }
        }
        Row {
          align: center
          Text { text: strings.reset_updates[languageIndex]; font: sans; fontSize: 11; bold: true; weight: 1; maxLines: 1 }
          Text { text: unreadReset ? strings.new_update[languageIndex] : strings.view[languageIndex]; font: sans; fontSize: 10; color: unreadReset ? #34d399 : secondary; width: 64; align: end; maxLines: 1 }
        }
        Text { text: monitorItem != null ? (tibo.stale ? (strings.delayed_prefix[languageIndex] + monitorItem.title) : monitorItem.title) : (tibo.stale ? strings.monitor_unavailable[languageIndex] : strings.no_updates[languageIndex]); font: sans; fontSize: 10; color: secondary; maxLines: 1 }
      } else {
        Row {
          gap: 6
          Quota { label: strings.five_hour_short[languageIndex]; data: q.five; dense: true; weight: 1 }
          Quota { label: strings.weekly_short[languageIndex]; data: q.week; dense: true; weight: 1 }
        }
        Row {
          align: center
          Text { text: strings.reset_updates[languageIndex]; font: sans; fontSize: 11; bold: true; weight: 1; maxLines: 1 }
          Text { text: unreadReset ? strings.new_update[languageIndex] : strings.view[languageIndex]; font: sans; fontSize: 10; color: unreadReset ? #34d399 : secondary; width: 64; align: end; maxLines: 1 }
        }
        Text { text: monitorItem != null ? (tibo.stale ? (strings.delayed_prefix[languageIndex] + monitorItem.title) : monitorItem.title) : (tibo.stale ? strings.monitor_unavailable[languageIndex] : strings.no_updates[languageIndex]); font: sans; fontSize: 10; color: secondary; maxLines: 1 }
        Row {
          align: center
          Text { text: q.updated_at == null ? strings.waiting_quota[languageIndex] : strings.quota_record[languageIndex] + fmtTime(q.updated_at, "HH:mm") + (q.stale ? strings.stale_suffix[languageIndex] : ""); font: sans; fontSize: 9; color: quiet; weight: 1; maxLines: 1 }
          Text { text: "codex-reset.com"; font: sans; width: 80; fontSize: 9; color: quiet; align: end; onTap: url("https://codex-reset.com/") }
        }
      }
    } else {
      Row {
        gap: 8
        Quota { label: ((cols ?? 4) < 4 || (rows ?? 4) < 4) ? strings.five_hour_short[languageIndex] : strings.five_hour[languageIndex]; data: q.five; dense: (cols ?? 4) < 4 || (rows ?? 4) < 4; weight: 1 }
        Quota { label: ((cols ?? 4) < 4 || (rows ?? 4) < 4) ? strings.weekly_short[languageIndex] : strings.weekly[languageIndex]; data: q.week; dense: (cols ?? 4) < 4 || (rows ?? 4) < 4; weight: 1 }
      }
      Row {
        align: center
        Text { text: (cols ?? 4) < 4 ? "Tibo" : strings.reset_updates[languageIndex]; font: sans; fontSize: 12; bold: true; weight: 1; maxLines: 1 }
        Text { text: unreadReset ? strings.new_update[languageIndex] : strings.view[languageIndex]; font: sans; fontSize: 11; color: unreadReset ? #34d399 : secondary; width: 80; align: end; maxLines: 1 }
      }
      Text { text: monitorItem != null ? (tibo.stale ? (strings.delayed_prefix[languageIndex] + monitorItem.title) : monitorItem.title) : (tibo.stale ? strings.monitor_unavailable[languageIndex] : strings.no_updates[languageIndex]); font: sans; fontSize: 11; color: secondary; maxLines: 1 }
      if (cols ?? 4) < 4 || (rows ?? 4) < 4 {
        Row {
          align: center
          Text { text: q.updated_at == null ? strings.waiting_quota[languageIndex] : strings.quota_record[languageIndex] + fmtTime(q.updated_at, "HH:mm") + (q.stale ? strings.stale_suffix[languageIndex] : ""); font: sans; fontSize: 9; color: quiet; weight: 1; maxLines: 1 }
          Text { text: "codex-reset.com"; font: sans; width: 80; fontSize: 9; color: quiet; align: end; onTap: url("https://codex-reset.com/") }
        }
      } else {
        Text { text: q.updated_at == null ? strings.waiting_quota[languageIndex] : strings.quota_record[languageIndex] + fmtTime(q.updated_at, "HH:mm") + (q.stale ? strings.stale_suffix[languageIndex] : ""); font: sans; fontSize: 10; color: quiet; maxLines: 1 }
        Button { text: strings.source_credit[languageIndex] + ": codex-reset.com"; onTap: url("https://codex-reset.com/") }
      }
    }
  }

  screen {
    title: strings.screen_title[languageIndex]
    Column {
      scroll: true
      gap: 16
      Row {
        gap: 8
        Button { text: strings.reset_monitor[languageIndex]; color: tab == "monitor" ? foreground : secondary; onTap: tab = "monitor" }
        Button { text: strings.my_quota[languageIndex]; color: tab == "account" ? foreground : secondary; onTap: tab = "account" }
        Spacer { weight: 1 }
        Button { text: languageShort; onTap: language = nextLanguage }
      }
      Column {
        gap: 6
        Text { text: strings.choose_language[languageIndex]; font: sans; fontSize: 13; color: secondary }
        Grid {
          columns: 2
          gap: 6
          for option in languageOptions key option.code {
            Button { text: option.label; color: language == option.code ? foreground : secondary; onTap: language = option.code }
          }
        }
      }
      if tab == "account" {
        Text { text: strings.my_remaining[languageIndex]; font: sans; fontSize: 22; bold: true }
        Row {
          gap: 12
          Quota { label: strings.five_hour[languageIndex]; data: q.five; weight: 1 }
          Quota { label: strings.weekly[languageIndex]; data: q.week; weight: 1 }
        }
        Text { text: q.updated_at == null ? strings.no_local_record[languageIndex] : strings.recorded_at[languageIndex] + fmtTime(q.updated_at, "MM-dd HH:mm") + (q.stale ? strings.stale_suffix[languageIndex] : ""); font: sans; fontSize: 13; color: secondary }
        Button {
          text: quotaRefreshing ? strings.refreshing_quota[languageIndex] : strings.refresh_quota[languageIndex]
          color: quotaRefreshing ? accent : foreground
          background: quotaRefreshing ? alpha(accent, 0.16) : panel
          border: 1
          borderColor: quotaRefreshing ? accent : alpha(foreground, 0.14)
          animate background: tween(180ms, "out")
          animate color: tween(180ms, "out")
          onTap: { quotaRefreshing = true; refreshRequest = refreshRequest + 1; refresh() }
        }
        Text { text: strings.quota_explanation[languageIndex]; font: sans; fontSize: 13; color: secondary }
        if len(q.events) > 0 {
          Rule { }
          Text { text: strings.recent_changes[languageIndex]; font: sans; fontSize: 16; bold: true }
          for item in q.events key str(item.time) + item.kind {
            Text { text: "${fmtTime(item.time, "MM-dd HH:mm")} · ${item.kind == "five" ? strings.five_hour_short[languageIndex] : strings.weekly_short[languageIndex]} · ${item.remaining}%"; fontSize: 13 }
          }
        }
      } else {
        Row {
          align: center
          Text { text: strings.tibo_monitor[languageIndex]; font: sans; fontSize: 24; bold: true; weight: 1 }
          Button { text: strings.check_updates[languageIndex]; onTap: { refreshRequest = refreshRequest + 1; refresh() } }
        }
        Text { text: strings.reset_credit_split[languageIndex]; font: sans; fontSize: 13; color: secondary }
        Column {
          gap: 8
          padding: 14
          background: panel
          radius: 0
          Text { text: tibo.stale ? strings.monitor_stale_cache[languageIndex] : (tibo.available ? strings.monitor_current[languageIndex] : strings.no_public_events[languageIndex]); font: sans; fontSize: 13; color: tibo.stale ? #fbbf24 : secondary; maxLines: 2 }
          if monitorItem != null {
            Text { text: monitorItem.group == "credits" ? strings.latest_credits[languageIndex] : (monitorItem.confirmed ? strings.reset_announced[languageIndex] : strings.reset_unconfirmed[languageIndex]); font: sans; fontSize: 13; color: monitorItem.confirmed ? #34d399 : #fbbf24; maxLines: 2 }
            Text { text: monitorItem.title; font: sans; fontSize: 20; bold: true; maxLines: 5 }
            Text { text: monitorItem.schedule != "" ? (strings.source_schedule[languageIndex] + monitorItem.schedule) : strings.no_exact_reset[languageIndex]; font: sans; fontSize: 12; color: secondary; maxLines: 3 }
          } else {
            Text { text: strings.waiting_public[languageIndex]; font: sans; fontSize: 16; bold: true; maxLines: 3 }
          }
        }
        if tibo.featured != null { Post { item: tibo.featured } }
        Grid {
          columns: 2
          gap: 10
          Metric { label: strings.resets_90[languageIndex]; value: tibo.stats.resets90 == null ? null : "${tibo.stats.resets90}" }
          Metric { label: strings.credits_90[languageIndex]; value: tibo.stats.credits90 == null ? null : "${tibo.stats.credits90}" }
          Metric { label: strings.median_interval[languageIndex]; value: tibo.stats.medianIntervalDays == null ? null : str(tibo.stats.medianIntervalDays) + strings.day_suffix[languageIndex] }
          Metric { label: strings.last_announced[languageIndex]; value: tibo.stats.lastResetDate == null ? null : sub(tibo.stats.lastResetDate, 5, 10) }
        }
        Rule { }
        Column {
          gap: 5
          Text { text: strings.reset_calendar[languageIndex]; font: sans; fontSize: 20; bold: true }
          Text { text: strings.tap_date[languageIndex]; font: sans; fontSize: 12; color: secondary }
        }
        if calendarMonth != null {
          Row {
            gap: 8
            align: center
            Button { text: "‹"; onTap: { monthOffset = max(monthOffset - 1, -24); selectedDate = "" } }
            Text { text: (language == "zh" || language == "ja" || language == "ko") ? sub(calendarMonth.month, 0, 4) + (language == "zh" ? "年" : language == "ja" ? "年" : "년") + str(int(sub(calendarMonth.month, 5, 7))) + (language == "ko" ? "월" : "月") : monthNames[languageIndex][int(sub(calendarMonth.month, 5, 7)) - 1] + " " + sub(calendarMonth.month, 0, 4); font: sans; fontSize: 16; bold: true; weight: 1; align: center; maxLines: 1 }
            Button { text: "›"; onTap: { monthOffset = min(monthOffset + 1, 12); selectedDate = "" } }
          }
          Text { text: strings.this_month[languageIndex] + str(calendarMonth.reset_count) + strings.reset_count[languageIndex] + " · " + str(calendarMonth.credit_count) + strings.credit_count[languageIndex]; font: sans; fontSize: 12; color: secondary }
          Grid {
            columns: 7
            gap: 4
            for label in weekdays[languageIndex] {
              Text { text: label; font: sans; fontSize: 12; color: secondary; align: center }
            }
          }
          Grid {
            columns: 7
            gap: 4
            for day in calendarMonth.cells key day.date {
              Column {
                gap: 4
                padding: [0, 7]
                background: day.date == activeDate ? alpha(foreground, 0.16) : day.in_month ? panel : transparent
                radius: 0
                onTap: { selectedDate = day.date }
                Text { text: day.day; fontSize: 14; bold: day.today; color: day.in_month ? foreground : quiet; align: center; maxLines: 1 }
                Canvas {
                  height: 5
                  fill: width
                  if day.confirmed_reset { circle(width / 2 - (day.pending_reset || day.credit ? 7 : 0), height / 2, 1.7, fill: #34d399) }
                  if day.pending_reset { circle(width / 2, height / 2, 1.7, fill: #fbbf24) }
                  if day.credit { circle(width / 2 + (day.reset ? 7 : 0), height / 2, 1.7, fill: #60a5fa) }
                }
              }
            }
          }
          Text { text: strings.legend[languageIndex]; font: sans; fontSize: 11; color: secondary }
        } else {
          Text { text: strings.calendar_loading[languageIndex]; font: sans; fontSize: 13; color: secondary }
        }
        Row {
          align: center
          Text { text: language == "zh" ? activeDate + " 的记录" : language == "ja" ? activeDate + " の記録" : language == "ko" ? activeDate + " 기록" : strings.records_for[languageIndex] + activeDate; font: sans; fontSize: 17; bold: true; weight: 1 }
          Button { text: strings.latest_reset[languageIndex]; onTap: { monthOffset = max(-24, min(12, num(tibo.stats.lastResetMonthOffset, 0))); selectedDate = tibo.stats.lastResetDate ?? tibo.today } }
        }
        if len(selectedEntries) == 0 {
          Text { text: strings.no_records[languageIndex]; font: sans; fontSize: 14; color: secondary; padding: [0, 8] }
        } else {
          for item in selectedEntries key item.id { Post { item: item } }
        }
        Rule { }
        Column {
          gap: 8
          Text { text: strings.source_status[languageIndex]; font: sans; fontSize: 16; bold: true }
          Text { text: tibo.stale ? strings.fetch_cached[languageIndex] : (tibo.available ? strings.monitor_current[languageIndex] : strings.no_public_events[languageIndex]); font: sans; fontSize: 13; color: tibo.stale ? #fbbf24 : secondary }
          Text { text: strings.cache_updated[languageIndex] + (tibo.fetched_at == null ? "—" : fmtTime(tibo.fetched_at, "MM-dd HH:mm")) + strings.api_data_time[languageIndex] + (tibo.checked_at == null ? "—" : fmtTime(tibo.checked_at, "MM-dd HH:mm")); font: sans; fontSize: 12; color: secondary }
          if tibo.error != "" { Text { text: strings.last_api_error[languageIndex] + tibo.error; font: sans; fontSize: 12; color: #fbbf24; maxLines: 2 } }
          Text { text: strings.disclaimer[languageIndex]; font: sans; fontSize: 12; color: secondary; maxLines: 3 }
          Button { text: strings.source_credit[languageIndex] + ": codex-reset.com"; onTap: url("https://codex-reset.com/") }
        }
      }
    }
  }
}
