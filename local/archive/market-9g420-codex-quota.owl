// Self-contained Python sources; no helper downloads or account uploads.
widget "Codex Quota and Resets" {
  size: 6x4
  minSize: 2x2
  padding: 10
  meta { owl: 6; version: "2.3.0"; author: "9G420"; license: "MIT"; category: "dev"; description: "Eight-language Codex quota card with reset countdowns, Tibo announcements, statistics and a calendar." }
  requires { pacman: ["python"] }

  state refreshRequest = 0
  state quotaRefreshing = false
  state selectedDate = ""
  state monthOffset = 0
  state tab = "monitor"
  state ackResetKey = "" persist
  state language = "en" persist
  state seenTibo = "" persist
  state remindFive = 0 persist
  state remindWeek = 0 persist


  source q = cmd("python -I - --refresh-request ${int(max(0, min(999999, num(refreshRequest, 0))))} <<'CODEX_QUOTA_PY'\n" + """
import argparse
import datetime as dt
import json
import math
from pathlib import Path
import tempfile
import time

MAX_READ = 2 * 1024 * 1024


def epoch(value):
    try:
        if not isinstance(value, str):
            return None
        parsed = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
        if parsed.tzinfo is None:
            return None
        return int(parsed.timestamp())
    except (ValueError, TypeError, OverflowError):
        return None


def valid_windows(raw):
    if not isinstance(raw, dict):
        return {}
    result = {}
    for name in ('five', 'week'):
        value = raw.get(name)
        if not isinstance(value, dict):
            continue
        remaining, resets_at = value.get('remaining'), value.get('resets_at')
        if (isinstance(remaining, (int, float)) and not isinstance(remaining, bool)
                and math.isfinite(remaining) and 0 <= remaining <= 100
                and isinstance(resets_at, (int, float)) and not isinstance(resets_at, bool)
                and math.isfinite(resets_at) and resets_at > 0):
            result[name] = {'remaining': round(float(remaining), 1), 'resets_at': int(resets_at)}
    return result


def windows(limits):
    if not isinstance(limits, dict):
        return {}
    result = {}
    for slot in ('primary', 'secondary'):
        window = limits.get(slot)
        if not isinstance(window, dict):
            continue
        name = {300: 'five', 10080: 'week'}.get(window.get('window_minutes'))
        used, reset = window.get('used_percent'), window.get('resets_at')
        if (name and isinstance(used, (int, float)) and not isinstance(used, bool)
                and math.isfinite(used) and 0 <= used <= 100
                and isinstance(reset, (int, float)) and not isinstance(reset, bool)
                and math.isfinite(reset) and reset > 0):
            result[name] = {'remaining': round(100 - used, 1), 'resets_at': int(reset)}
    return result


def valid_snapshot(value):
    if not isinstance(value, dict):
        return None
    stamp = value.get('updated_at')
    if isinstance(stamp, bool) or not isinstance(stamp, (int, float)) or stamp <= 0:
        return None
    cleaned = valid_windows(value.get('windows'))
    if not cleaned:
        return None
    return {'updated_at': int(stamp), 'windows': cleaned}


def clean_events(raw):
    if not isinstance(raw, list):
        return []
    result = []
    for event in raw:
        if not isinstance(event, dict) or event.get('kind') not in ('five', 'week'):
            continue
        stamp, remaining, reset = event.get('time'), event.get('remaining'), event.get('resets_at')
        if (isinstance(stamp, bool) or not isinstance(stamp, int) or stamp <= 0
                or isinstance(remaining, bool) or not isinstance(remaining, (int, float))
                or not math.isfinite(remaining) or not 0 <= remaining <= 100
                or isinstance(reset, bool) or not isinstance(reset, int) or reset <= 0):
            continue
        result.append({'kind': event['kind'], 'time': stamp,
                       'remaining': round(float(remaining), 1), 'resets_at': reset})
    return sorted(result, key=lambda item: item['time'], reverse=True)[:20]


def load(path):
    try:
        value = json.loads(path.read_text(encoding='utf-8'))
        if not isinstance(value, dict):
            return {}
        snapshot = valid_snapshot(value.get('snapshot'))
        return {'snapshot': snapshot or {}, 'events': clean_events(value.get('events')),
                'scan_marker': value.get('scan_marker'),
                'source_file': value.get('source_file') if isinstance(value.get('source_file'), dict) else None}
    except (OSError, ValueError, TypeError):
        return {}


def migrate(cache_path):
    candidates = []
    for name in ('account-en.json', 'account-zh.json'):
        old_path = cache_path.parent / name
        try:
            value = json.loads(old_path.read_text(encoding='utf-8'))
            if not isinstance(value, dict):
                continue
            snapshot = valid_snapshot(value.get('snapshot'))
            if snapshot:
                candidates.append((snapshot['updated_at'], snapshot, clean_events(value.get('events'))))
        except (OSError, ValueError, TypeError):
            continue
    if not candidates:
        return {'snapshot': {}, 'events': [], 'scan_marker': None, 'source_file': None}
    _, snapshot, events = max(candidates, key=lambda item: item[0])
    return {'snapshot': snapshot, 'events': events, 'scan_marker': None, 'source_file': None}


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=path.parent,
                                     prefix=path.name + '.', suffix='.tmp', delete=False) as output:
        json.dump(value, output, ensure_ascii=False, separators=(',', ':'))
        temporary = Path(output.name)
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def file_marker(path, stat):
    return {'path': str(path), 'mtime_ns': int(stat.st_mtime_ns), 'size': int(stat.st_size)}


def candidates(root):
    found = []
    try:
        for path in root.rglob('*.jsonl'):
            try:
                stat = path.stat()
                if path.is_file():
                    found.append((path, stat))
            except OSError:
                continue
    except OSError:
        pass
    found.sort(key=lambda item: (item[1].st_mtime_ns, str(item[0])), reverse=True)
    return found


def snapshot_from_file(path, stat):
    try:
        with path.open('rb') as source:
            start = max(0, stat.st_size - MAX_READ)
            source.seek(start)
            if start:
                source.readline()
            lines = source.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        if b'"token_count"' not in line or b'"rate_limits"' not in line:
            continue
        try:
            event = json.loads(line)
            if not isinstance(event, dict):
                continue
            payload = event.get('payload')
            if not isinstance(payload, dict):
                continue
            limits = payload.get('rate_limits')
            if (event.get('type') != 'event_msg' or payload.get('type') != 'token_count'
                    or not isinstance(limits, dict) or limits.get('limit_id') not in (None, 'codex')):
                continue
            stamp = epoch(event.get('timestamp'))
            data = windows(limits)
            if stamp is not None and data:
                return {'updated_at': stamp, 'windows': data}
        except (ValueError, TypeError, AttributeError):
            continue
    return None


def latest(sessions, saved, force=False):
    files = candidates(sessions)
    marker = file_marker(*files[0]) if files else None
    previous = valid_snapshot(saved.get('snapshot'))
    if not force and marker == saved.get('scan_marker') and (previous or marker is None):
        return None, marker, saved.get('source_file'), False
    for path, stat in files:
        snapshot = snapshot_from_file(path, stat)
        if snapshot:
            return snapshot, marker, file_marker(path, stat), True
    return None, marker, saved.get('source_file'), True


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--sessions', type=Path, default=Path.home() / '.codex/sessions')
    parser.add_argument('--cache', type=Path,
                        default=Path.home() / '.cache/codex-quota-community/account.json')
    parser.add_argument('--now', type=int, default=int(time.time()))
    parser.add_argument('--refresh-request', type=int, default=0)
    args = parser.parse_args()
    old = load(args.cache)
    migrated = False
    if not old.get('snapshot'):
        old = migrate(args.cache)
        migrated = bool(old.get('snapshot'))
    previous = valid_snapshot(old.get('snapshot')) or {}
    events = clean_events(old.get('events'))
    force_scan = args.refresh_request != old.get('refresh_request', 0)
    fresh, marker, source_file, scanned = latest(args.sessions, old, force=force_scan)
    snapshot = previous
    if fresh and fresh['updated_at'] > previous.get('updated_at', -1):
        for name, window in fresh['windows'].items():
            prior = previous.get('windows', {}).get(name)
            if (prior and window['resets_at'] > prior['resets_at']
                    and fresh['updated_at'] >= prior['resets_at']):
                events.insert(0, {'kind': name, 'time': fresh['updated_at'],
                                  'remaining': window['remaining'], 'resets_at': window['resets_at']})
        snapshot = fresh
    if scanned or fresh or migrated:
        try:
            save(args.cache, {'snapshot': snapshot, 'events': events[:20],
                              'scan_marker': marker, 'source_file': source_file,
                              'refresh_request': args.refresh_request})
        except OSError:
            pass
    result = {'available': bool(snapshot.get('windows')), 'updated_at': snapshot.get('updated_at'),
              'checked_at': args.now,
              'refresh_request': args.refresh_request,
              'stale': bool(snapshot and args.now - snapshot.get('updated_at', 0) > 900),
              'events': events[:20]}
    for name in ('five', 'week'):
        value = dict(snapshot.get('windows', {}).get(name) or {})
        if not value:
            value = {'remaining': None, 'resets_at': None, 'state': 'unknown'}
        elif args.now >= value['resets_at']:
            value.update(remaining=None, state='awaiting_reset')
        else:
            value['state'] = 'reported'
        result[name] = value
    print(json.dumps(result, ensure_ascii=False, separators=(',', ':')))


if __name__ == '__main__':
    main()
""" + "\nCODEX_QUOTA_PY\n") every 5m timeout 15s json
  let resetScript = """import argparse
import calendar
import datetime as dt
from email.utils import parsedate_to_datetime
import json
import re
import statistics
import tempfile
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

BASE = 'https://codex-reset.com'
USER_AGENT = 'codex-quota-widget/2.0 (+https://github.com/9G420/omarchy-widgets)'
BEIJING = dt.timezone(dt.timedelta(hours=8))
MAX_RESPONSE = 2 * 1024 * 1024
POLL_SECONDS = 300
MIN_REQUEST_GAP = 60
MONTH_NAMES = ('January', 'February', 'March', 'April', 'May', 'June',
               'July', 'August', 'September', 'October', 'November', 'December')


class ApiFailure(Exception):
    def __init__(self, message, retry_after=0):
        super().__init__(message)
        self.retry_after = retry_after


def timestamp(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace('Z', '+00:00'))
        if parsed.tzinfo is None:
            return None
        return int(parsed.timestamp())
    except (ValueError, TypeError, OverflowError):
        return None


def safe_url(value):
    if not isinstance(value, str) or len(value) > 2048:
        return ''
    try:
        parsed = urlsplit(value)
        if (parsed.scheme.lower() != 'https' or not parsed.hostname
                or parsed.username is not None or parsed.password is not None
                or any(ord(ch) < 32 or ch.isspace() for ch in value)):
            return ''
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            return ''
        return value
    except ValueError:
        return ''


def retry_delay(value, now):
    if not value:
        return MIN_REQUEST_GAP
    try:
        return max(MIN_REQUEST_GAP, int(value.strip()))
    except (ValueError, AttributeError):
        try:
            parsed = parsedate_to_datetime(value)
            return max(MIN_REQUEST_GAP, int(parsed.timestamp() - now))
        except (TypeError, ValueError, OverflowError):
            return MIN_REQUEST_GAP


def get_json(path, locale):
    suffix = '?locale=zh' if locale == 'zh' else ''
    request = Request(BASE + path + suffix, headers={
        'User-Agent': USER_AGENT,
        'Accept': 'application/json',
    }, method='GET')
    try:
        with urlopen(request, timeout=12) as response:
            body = response.read(MAX_RESPONSE + 1)
        if len(body) > MAX_RESPONSE:
            raise ApiFailure('API response exceeded 2 MiB')
        value = json.loads(body.decode('utf-8'))
        if not isinstance(value, dict):
            raise ApiFailure('API response was not a JSON object')
        return value
    except HTTPError as error:
        delay = retry_delay(error.headers.get('Retry-After') if error.headers else None, time.time()) if error.code == 429 else 0
        raise ApiFailure('HTTP ' + str(error.code), delay) from error
    except (URLError, TimeoutError, UnicodeDecodeError, json.JSONDecodeError, OSError) as error:
        raise ApiFailure(type(error).__name__) from error


def valid_feed(value):
    return (isinstance(value, dict)
            and isinstance(value.get('tweets'), list)
            and isinstance(value.get('events'), list)
            and 'signal' in value
            and isinstance(value.get('stale'), bool)
            and timestamp(value.get('fetched_at')) is not None)


def valid_timeline(value):
    return isinstance(value, dict) and isinstance(value.get('events'), list)


def load(path):
    try:
        value = json.loads(path.read_text(encoding='utf-8'))
        if (isinstance(value, dict) and value.get('schema') == 2
                and valid_feed(value.get('feed')) and valid_timeline(value.get('timeline'))):
            return value
        if (isinstance(value, dict) and value.get('schema') == 2
                and value.get('feed') == {} and value.get('timeline') == {}):
            return value
    except (OSError, ValueError, TypeError):
        pass
    return {}


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8', dir=path.parent,
                                     prefix=path.name + '.', suffix='.tmp', delete=False) as output:
        json.dump(value, output, ensure_ascii=False, separators=(',', ':'))
        temporary = Path(output.name)
    try:
        temporary.replace(path)
    finally:
        temporary.unlink(missing_ok=True)


def stated_schedule(summary):
    if not isinstance(summary, str):
        return ''
    if re.search(r'\b(?:promis\w*|expect\w*|schedul\w*|announc\w*)\b', summary, re.I):
        match = re.search(
            r'\b(?:by|at|around|before|after|for)\s+'
            r'(?:EOD(?:\s+(?:PST|PDT|PT|UTC))?|end of day(?:\s+(?:PST|PDT|PT|UTC))?|'
            r'tomorrow\s+\d{1,2}(?::\d{2})?\s*(?:am|pm)?(?:\s*(?:PST|PDT|PT|UTC))?|'
            r'\d{1,2}(?::\d{2})?\s*(?:am|pm)?\s*(?:PST|PDT|PT|UTC))\b',
            summary, re.I)
        if match:
            return match.group(0)
    if re.search(r'承诺|预计|计划|宣布|安排|将于', summary):
        match = re.search(
            r'(?:承诺|预计|计划|宣布|安排|将于)[^。；，,]{0,50}?'
            r'((?:今天|明天|当天|当日)?\s*(?:北京时间)?\d{1,2}(?:[:：]\d{2})?\s*'
            r'(?:点|时)?\s*(?:上午|下午|晚上|凌晨)?\s*(?:UTC|PST|PDT|PT)?'
            r'(?:之前|左右|前后|截止)?)',
            summary)
        if match:
            return match.group(1).strip()
    return ''


def normalize_events(raw_events, locale):
    unique = {}
    for raw in raw_events:
        if not isinstance(raw, dict):
            continue
        event_id = raw.get('id')
        if isinstance(event_id, bool) or not isinstance(event_id, (str, int)):
            continue
        event_id = str(event_id).strip()
        group = raw.get('group')
        if not event_id or len(event_id) > 128 or group not in ('reset', 'credits'):
            continue
        announced = timestamp(raw.get('announced_at'))
        summary = raw.get('summary')
        state = raw.get('announcement_state')
        event_type = raw.get('type')
        if announced is None or not isinstance(summary, str) or not summary.strip():
            continue
        if not isinstance(state, str):
            state = 'unknown'
        if not isinstance(event_type, str):
            event_type = group
        local_date = dt.datetime.fromtimestamp(announced, BEIJING).date().isoformat()
        normalized = {
            'id': event_id,
            'time': announced,
            'date': local_date,
            'group': group,
            'type': event_type[:80],
            'state': state[:80],
            'confirmed': group == 'reset' and state == 'announced',
            'title': summary.strip()[:5000],
            'schedule': stated_schedule(summary),
            'url': safe_url(raw.get('url')),
        }
        previous = unique.get(event_id)
        if previous is None or announced > previous['time']:
            unique[event_id] = normalized
    result = list(unique.values())
    result.sort(key=lambda item: item['time'], reverse=True)
    return result


def month_shift(year, month, offset):
    index = year * 12 + month - 1 + offset
    shifted_year, shifted_month = divmod(index, 12)
    return shifted_year, shifted_month + 1


def calendar_data(events, today):
    year, month = today.year, today.month
    by_date = {}
    for event in events:
        by_date.setdefault(event['date'], []).append(event)
    output = []
    for offset in range(-24, 13):
        y, m = month_shift(year, month, offset)
        month_prefix = f'{y:04d}-{m:02d}'
        month_events = [e for e in events if e['date'].startswith(month_prefix)]
        cells = []
        for week in calendar.Calendar(firstweekday=0).monthdatescalendar(y, m):
            for date in week:
                items = by_date.get(date.isoformat(), [])
                cells.append({
                    'date': date.isoformat(),
                    'day': date.day,
                    'in_month': date.month == m,
                    'today': date == today,
                    'reset': any(e['group'] == 'reset' for e in items),
                    'confirmed_reset': any(e['confirmed'] for e in items),
                    'pending_reset': any(e['group'] == 'reset' and not e['confirmed'] for e in items),
                    'credit': any(e['group'] == 'credits' for e in items),
                })
        output.append({
            'month': month_prefix,
            'label_en': MONTH_NAMES[m - 1] + ' ' + str(y),
            'label_zh': f'{y}年{m}月',
            'cells': cells,
            'reset_count': sum(e['confirmed'] for e in month_events),
            'credit_count': sum(e['group'] == 'credits' for e in month_events),
        })
    return output


def make_result(saved, now, locale):
    feed = saved.get('feed') if isinstance(saved.get('feed'), dict) else {}
    timeline = saved.get('timeline') if isinstance(saved.get('timeline'), dict) else {}
    events = normalize_events(timeline.get('events', []), locale)
    today = dt.datetime.fromtimestamp(now, BEIJING).date()
    confirmed = [e for e in events if e['confirmed']]
    reset_dates = sorted({e['date'] for e in confirmed})
    cutoff = (today - dt.timedelta(days=89)).isoformat()
    resets_90 = sum(e['confirmed'] and e['date'] >= cutoff for e in events)
    credits_90 = sum(e['group'] == 'credits' and e['date'] >= cutoff for e in events)
    intervals = []
    for older, newer in zip(reset_dates, reset_dates[1:]):
        intervals.append((dt.date.fromisoformat(newer) - dt.date.fromisoformat(older)).days)
    median = statistics.median(intervals) if intervals else None
    last_reset_date = reset_dates[-1] if reset_dates else None
    latest_reset = next((e for e in events if e['group'] == 'reset'), None)
    featured = events[0] if events else None
    api_fetched = timestamp(feed.get('fetched_at'))
    cache_fetched = int(saved.get('fetched_at', 0) or 0)
    stale = (not saved.get('fetch_ok', False)
             or feed.get('stale') is True
             or not cache_fetched
             or now - cache_fetched > 1800)
    error = saved.get('error', '')
    return {
        'available': bool(events),
        'stale': stale,
        'error': error if isinstance(error, str) else '',
        'language': locale,
        'fetched_at': cache_fetched or None,
        'checked_at': api_fetched,
        'newest_post_at': timestamp(feed.get('newest_post_at')),
        'feed_stale': feed.get('stale') is True,
        'monitor_label': ('Delayed / stale' if stale else 'Monitor current'),
        'summary': latest_reset['title'] if latest_reset else '',
        'headline': featured['title'] if featured else 'No recorded updates',
        'key': (featured['id'] + ':' + str(featured['time']) + ':' + featured['state']) if featured else None,
        'reset_key': next((e['id'] for e in confirmed), None),
        'latest': latest_reset,
        'featured': featured,
        'events': events,
        'today': today.isoformat(),
        'calendars': calendar_data(events, today),
        'stats': {
            'resets90': resets_90,
            'credits90': credits_90,
            'medianIntervalDays': median,
            'lastResetDate': last_reset_date,
            'lastResetMonthOffset': (
                (dt.date.fromisoformat(last_reset_date).year - today.year) * 12
                + dt.date.fromisoformat(last_reset_date).month - today.month
            ) if last_reset_date else None,
        },
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--cache', type=Path,
                        default=Path.home() / '.cache/codex-quota-community/codex-reset-v2.json')
    parser.add_argument('--locale', choices=('en', 'zh'), default='en')
    parser.add_argument('--refresh-request', type=int, default=0)
    args = parser.parse_args()
    now = int(time.time())
    cache_path = args.cache
    saved = load(cache_path)
    saved.setdefault('schema', 2)
    saved.setdefault('fetch_ok', False)
    saved.setdefault('attempted_at', 0)
    saved.setdefault('last_attempt_at', 0)
    saved.setdefault('retry_after_until', 0)
    saved.setdefault('refresh_request', -1)
    saved.setdefault('error', '')
    saved.setdefault('feed', {})
    saved.setdefault('timeline', {})
    due = (not saved.get('fetch_ok')
           or now - int(saved.get('attempted_at', 0) or 0) >= POLL_SECONDS
           or args.refresh_request != saved.get('refresh_request', -1)
           or args.locale != saved.get('locale', ''))
    retry_until = max(int(saved.get('retry_after_until', 0) or 0),
                      int(saved.get('last_attempt_at', 0) or 0) + MIN_REQUEST_GAP)
    if due and now >= retry_until:
        saved['attempted_at'] = now
        saved['last_attempt_at'] = now
        saved['refresh_request'] = args.refresh_request
        try:
            feed = get_json('/api/feed', args.locale)
            timeline = get_json('/api/timeline', args.locale)
            if not valid_feed(feed):
                raise ApiFailure('Invalid feed response')
            if not valid_timeline(timeline):
                raise ApiFailure('Invalid timeline response')
            saved.update(feed=feed, timeline=timeline, fetched_at=now, fetch_ok=True,
                         locale=args.locale, retry_after_until=0, error='')
        except ApiFailure as error:
            saved['fetch_ok'] = False
            saved['error'] = str(error)[:160]
            if error.retry_after:
                saved['retry_after_until'] = now + error.retry_after
        except Exception as error:
            saved['fetch_ok'] = False
            saved['error'] = type(error).__name__
        try:
            save(cache_path, saved)
        except OSError:
            pass
    elif due:
        saved['refresh_request'] = args.refresh_request
    print(json.dumps(make_result(saved, now, args.locale), ensure_ascii=False,
                     separators=(',', ':')))


if __name__ == '__main__':
    main()
"""
  source tibo = cmd("python -I -c ${sh(resetScript)} --locale ${sh(language == "zh" ? "zh" : "en")} --refresh-request ${int(max(0, min(999999, num(refreshRequest, 0))))}") every 5m timeout 30s json
  source now = clock every 1m

  let localeCodes = ["en", "zh", "es", "de", "fr", "ja", "ko", "ru"]
  let languageIndex = max(0, indexOf(localeCodes, language))
