widget "radio" {
  page: 4
  order: 1
  size: 6x2
  minSize: 3x1
  meta { description: "World radio: pick a country, then one of its most popular stations, and it plays in the background with the current track"; version: "1.1"; license: "MIT"; category: "media"; owl: 8 }

  // mpg123 is the player because mpv and ffmpeg pull in bubblewrap, which can't run here.
  // It only plays MP3, so the station lists ask radio-browser for MP3 streams.
  requires { pacman: ["mpg123", "libpulse", "util-linux", "coreutils", "grep", "bash"] }

  let api = "https://de1.api.radio-browser.info/json"

  source sys = android.system every 1h
  source vol = android.volume
  // The player writes its process group to pid and each ICY title line to now.
  source alive = cmd('d=~/.cache/owl-radio; [ -f $d/pid ] && kill -0 $(cat $d/pid) 2>/dev/null && echo on || echo off') every 5s
  source now = file("~/.cache/owl-radio/now")

  state cc = "" persist            // chosen country code; empty means the phone's
  state ccName = "" persist
  state station = null persist     // {id, name, url, tags, kbps, cc}
  state view = "stations"
  state query = ""
  state countryQuery = ""

  let localCc = upper(match(sys.locale ?? "", "[A-Za-z]{2}$") ?? "US")
  let country = cc != "" ? cc : localCc

  source countries = http("${api}/countries?hidebroken=true") every 24h json
  source raw = http("${api}/stations/search?countrycode=${enc(country)}&codec=MP3&order=clickcount&reverse=true&hidebroken=true&limit=80") every 6h json

  // radio-browser uses the long official names for a few countries.
  let shortNames = {GB: "United Kingdom", US: "United States", RU: "Russia", KR: "South Korea", KP: "North Korea", IR: "Iran", SY: "Syria", VE: "Venezuela", BO: "Bolivia", TZ: "Tanzania", MD: "Moldova", LA: "Laos", VN: "Vietnam", TW: "Taiwan", CZ: "Czechia", AE: "United Arab Emirates", NL: "Netherlands", PH: "Philippines", DO: "Dominican Republic", CD: "DR Congo", MK: "North Macedonia", BA: "Bosnia and Herzegovina", FM: "Micronesia", PS: "Palestine", VA: "Vatican City"}
  let countryList = (countries ?? [])
    .filter(c => c.stationcount > 0 && len(c.iso_3166_1) == 2)
    .map(c => {code: c.iso_3166_1, name: get(shortNames, c.iso_3166_1, startsWith(c.name, "The ") ? sub(c.name, 4) : c.name), count: c.stationcount})
    .sortBy(c => lower(c.name))
  let shownCountries = countryList.filter(c => countryQuery == "" || contains(lower(c.name), lower(countryQuery)) || lower(c.code) == lower(countryQuery))
  let countryLabel = cc != "" && ccName != "" ? ccName : (countryList.find(c => c.code == country).name ?? country)

  let stations = (raw ?? [])
    .filter(s => s.url_resolved != "" && startsWith(s.url_resolved, "http"))
    .map(s => {id: s.stationuuid, name: trim(s.name), url: s.url_resolved, tags: join(take(split(s.tags ?? "", ","), 3), " · "), kbps: s.bitrate, cc: country})
  let shownStations = stations.filter(s => query == "" || contains(lower(s.name), lower(query)) || contains(lower(s.tags), lower(query)))

  let playing = alive == "on"
  let icy = last(lines(now ?? "")) ?? ""
  let track = contains(icy, "StreamTitle='") ? trim(split(split(icy, "StreamTitle='")[1], "';")[0]) : ""
  let flag = station != null ? station.cc : country

  // Kills the previous player's process group, then plays $1 and keeps its ICY titles.
  let playScript = 'd=~/.cache/owl-radio; mkdir -p $d; [ -f $d/pid ] && kill -- -$(cat $d/pid) 2>/dev/null; echo $$ > $d/pid; : > $d/now; mpg123 -v -o pulse "$1" 2>&1 | stdbuf -oL tr "\r" "\n" | grep --line-buffered -a "^ICY-META" > $d/now; [ "$(cat $d/pid 2>/dev/null)" = $$ ] && rm -f $d/pid'
  let stopCmd = 'd=~/.cache/owl-radio; [ -f $d/pid ] && kill -- -$(cat $d/pid) 2>/dev/null; rm -f $d/pid; : > $d/now'

  onTap: screen()

  // Play triangle or stop square on a disc.
  component PlayButton(on, big = false) {
    Box {
      size: big ? 44 : 36
      onTap: run(on ? stopCmd : "setsid -f bash -c ${sh(playScript)} owl-radio ${sh(station.url)}")
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        circle(cx, cy, d / 2, fill: station == null ? muted : accent)
        if on {
          rect(cx - d * 0.15, cy - d * 0.15, d * 0.3, d * 0.3, radius: d * 0.04, fill: background)
        } else {
          path([[cx - d * 0.11, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.11, cy + d * 0.2]], closed: true, fill: background)
        }
      }
    }
  }

  component Flag(code, w = 30) {
    Image { src: "https://flagcdn.com/${enc(lower(code))}.svg"; width: w; height: w * 0.7; fit: cover; radius: 3 * corners; clip: true }
  }

  component Equalizer() {
    Canvas {
      width: 16
      height: 14
      for i in range(3) {
        let h = height * (0.35 + 0.65 * abs(sin(time * (3 + i * 1.7) + i)))
        rect(i * 6, height - h, 4, h, radius: 1, fill: accent)
      }
    }
  }

  // One row high: flag, name and track on two lines, play button.
  if (rows ?? 2) < 2 {
    Row {
      align: center
      gap: 10
      fill: true
      Flag { code: flag; w: 28 }
      Column {
        weight: 1
        gap: 0
        Row { gap: 6; align: center
          if playing { Equalizer { } }
          Text { text: station == null ? "radio" : station.name; bold: true; maxLines: 1; weight: 1 }
        }
        Text {
          text: station == null ? "tap to pick a station" : playing ? (track != "" ? track : "playing") : "stopped"
          style: small; color: playing ? foreground : muted; maxLines: 1
        }
      }
      if station != null { PlayButton { on: playing } }
    }
  } else {
  Row {
    align: center
    gap: 12
    fill: true
    Box { size: 52; background: surface; radius: 8 * corners; align: center
      Flag { code: flag; w: 34 }
    }
    Column {
      weight: 1
      gap: 2
      Row { gap: 6; align: center
        if playing { Equalizer { } }
        Text { text: station == null ? "radio" : station.name; style: title; maxLines: 1; weight: 1 }
      }
      Text {
        text: station == null ? "tap to pick a station" : playing ? (track != "" ? track : "playing") : "stopped"
        style: small; color: playing ? foreground : muted; maxLines: 1
      }
      Row { gap: 6; align: center
        Flag { code: flag; w: 16 }
        Text { text: station == null ? countryLabel : (countryList.find(c => c.code == station.cc).name ?? station.cc); style: label; color: muted; maxLines: 1; weight: 1 }
      }
    }
    if station != null { PlayButton { on: playing } }
  }
  }

  screen {
    title: view == "countries" ? "choose a country" : "radio · ${countryLabel}"
    Column {
      gap: 8
      if view == "countries" {
        Row { gap: 8; align: center
          Input { placeholder: "search ${len(countryList)} countries…"; text: countryQuery; focus: true; onChange: countryQuery = value; weight: 1 }
          Button { text: "back"; onTap: view = "stations" }
        }
        Column {
          scroll: true
          weight: 1
          gap: 0
          for c in shownCountries key c.code {
            Row {
              padding: [4, 9]
              gap: 10
              align: center
              background: c.code == country ? alpha(accent, 0.15) : null
              radius: 6 * corners
              onTap: { cc = c.code; ccName = c.name; query = ""; countryQuery = ""; view = "stations" }
              Text { text: c.code; font: mono; style: label; color: accent; width: 26 }
              Text { text: c.name; maxLines: 1; weight: 1 }
              Text { text: "${c.count}"; style: label; color: muted; width: 44; align: end }
            }
          }
        }
      } else {
        Row { gap: 10; align: center
          padding: [8, 8]
          background: surface
          radius: 8 * corners
          onTap: { countryQuery = ""; view = "countries" }
          Flag { code: country; w: 34 }
          Column { gap: 0; weight: 1
            Text { text: countryLabel; style: title; maxLines: 1 }
            Text { text: raw == null ? "loading stations…" : "${len(stations)} popular stations · tap to change country"; style: label; color: muted; maxLines: 1 }
          }
          Text { text: "▾"; style: title; color: accent; width: 20 }
        }
        Input { placeholder: "filter by name or genre…"; text: query; onChange: query = value }
        Column {
          scroll: true
          weight: 1
          gap: 2
          if raw != null && len(shownStations) == 0 {
            Text { text: query != "" ? "no station matches “${query}”" : "no MP3 stations listed for ${countryLabel}"; color: muted; padding: [4, 12] }
          }
          for s in shownStations key s.id {
            let current = station != null && station.id == s.id
            Row {
              padding: [6, 7]
              gap: 10
              align: center
              background: current ? alpha(accent, 0.15) : null
              radius: 6 * corners
              onTap: { station = s; run("setsid -f bash -c ${sh(playScript)} owl-radio ${sh(s.url)}") }
              Column { gap: 0; weight: 1
                Text { text: s.name; maxLines: 1; color: current ? accent : foreground; bold: current }
                Text { text: s.tags != "" ? s.tags : "—"; style: label; color: muted; maxLines: 1 }
              }
              Text { text: s.kbps > 0 ? "${s.kbps}k" : ""; style: label; color: muted; width: 40; align: end }
            }
          }
        }
        // Now-playing bar.
        if station != null {
          Row { gap: 10; align: center
            padding: [10, 8]
            background: surface
            radius: 8 * corners
            Column { gap: 0; weight: 1
              Row { gap: 6; align: center
                if playing { Equalizer { } }
                Text { text: station.name; bold: true; maxLines: 1; weight: 1 }
              }
              Text { text: playing ? (track != "" ? track : "playing") : "stopped"; style: small; color: muted; maxLines: 1 }
              Slider { value: vol.level ?? 0; height: 24; onChange: volume(value) }
            }
            PlayButton { on: playing; big: true }
          }
        }
      }
    }
  }
}
