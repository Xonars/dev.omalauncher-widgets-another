app "APK Maker" {
  title: "APK Maker"
  icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5h16v38H8V13h8zM16 5v8H8M18 23l-5 5 5 5M28 23l5 5-5 5M24 21l-3 14"/></svg>'
  back: forceAdv || view != "apps"
  onBack: { forceAdv = false; view = "apps"; appStep = ""; showMore = false }

  meta { owl: 9; description: "Turn ideas into Android apps with Claude Code, Codex or OpenCode. Build on your phone, review changes, sync with GitHub and prepare Google Play releases."; version: "3.0.0"; license: "MIT"; category: "dev" }

  requires { pacman: ["bash", "coreutils", "grep", "sed", "tar", "gzip", "jq", "git", "github-cli", "curl", "unzip", "util-linux", "jdk17-openjdk", "android-tools", "openssl", "nano", "less", "opencode", "findutils", "gawk", "procps-ng", "bubblewrap", "python", "python-pillow"] }

  // Backend: the apk-maker script, which this widget installs into ~/.local/share/apk-maker the
  // first time it runs (see installer below); `apk-maker setup` then fetches the Android SDK and
  // Gradle. Apps live in ~/apps, state in ~/.cache/apk-maker.
  source ver = file("~/.local/share/apk-maker/VERSION")
  source releaseStamp = file("~/.local/share/apk-maker/.release-sha")
  source activeRelease = file("~/.local/share/apk-maker/release.json") json
  source setup = file("~/.cache/apk-maker/setup.json") json
  source slog = stream("tail -n 40 -F ~/.cache/apk-maker/setup.log 2>/dev/null | jq -Rn --unbuffered 'foreach inputs as $line ([]; (. + [$line]) | .[-40:]; join(\"\\n\"))'") json
  source job = file("~/.cache/apk-maker/job.json") json
  source apps = file("~/.cache/apk-maker/apps.json") json
  source log = stream("tail -n 120 -F ~/.cache/apk-maker/log.txt 2>/dev/null | jq -Rn --unbuffered 'foreach inputs as $line ([]; (. + [$line]) | .[-120:]; join(\"\\n\"))'") json
  source err = file("~/.cache/apk-maker/build-err.txt")
  // The Google Play account: {state: none/waiting/checking/connected/error, email, msg, personal, contact}.
  source play = file("~/.cache/apk-maker/play.json") json
  // The optional configured tester exchange: its group and apps, and the
  // ones this phone tests ({package: since}).
  source community = file("~/.cache/apk-maker/community.json") json
  source testing = file("~/.cache/apk-maker/testing.json") json
  source communityPoll = cmd("[ ! -x ~/.local/bin/apk-maker ] || ~/.local/bin/apk-maker play community 2>/dev/null || true") every 30m timeout 30s
  // GitHub (optional): gh's logins on this phone and the ones APK Maker may use ({state: none/missing/connected,
  // accounts, allowed, account: where new apps go, auto}). The sync follows pull requests merged or closed on GitHub.
  // Are the Play key and upload keys locked with a passphrase? "locked", "plain" (not yet) or "none".
  source keyState = cmd("[ -x ~/.local/bin/apk-maker ] && ~/.local/bin/apk-maker keys-state") every 10m timeout 15s
  source isolation = cmd("~/.local/bin/apk-maker isolation") every 10m timeout 15s
  source gh = file("~/.cache/apk-maker/github.json") json
  source ghStatus = cmd("[ -x ~/.local/bin/apk-maker ] && ~/.local/bin/apk-maker github status >/dev/null") every 30m timeout 30s
  source ghSync = cmd("[ -x ~/.local/bin/apk-maker ] && ~/.local/bin/apk-maker github sync") every 2m timeout 90s
  source phoneApps = android.apps
  source now = clock every 1s
  // "connected <device>" or "offline" ("missing" before the script is installed).
  source adbs = cmd("[ -x ~/.local/bin/apk-maker ] || { echo missing; exit 0; }; ~/.local/bin/apk-maker adb") every 30s timeout 15s
  // What's missing to build (empty = ready), and which agents are installed.
  source doctor = cmd("[ -x ~/.local/bin/apk-maker ] && ~/.local/bin/apk-maker doctor") every 2m timeout 15s
  // "?" while the script isn't there (mid-install): unknown, not "no agents".
  source agentsOut = cmd("[ -x ~/.local/bin/apk-maker ] && ~/.local/bin/apk-maker agents || echo \"?\"") every 2m
  // Are the detached build worker and setup still alive? Tells a real run from one that died.
  source worker = cmd("~/.local/bin/apk-maker health") every 15s

  state agent = "claude" persist
  state draft = ""
  state tab = "job" persist
  state sel = "" persist
  state search = ""
  state change = ""
  state pairPort = "" persist
  state pairCode = ""
  state connPort = "" persist
  state out = ""
  state openUrl = ""
  // Stop and delete take a second tap within 5 seconds.
  state confirmAt = 0
  state delSlug = ""
  state delAt = 0
  state doneKey = "" persist
  state setupKey = "" persist
  state installRun = 0
  state installedAt = 0
  state installOut = ""
  // The second half of the install (the library: skills, AGENTS.md, Java helpers), run when the first is in.
  state libraryAt = 0
  state libraryOut = ""
  // The play tab: its app, the track to upload to, and drafts of what it asks for.
  state playSel = "" persist
  state track = "internal" persist
  state groupDraft = ""
  state testerDraft = ""
  state contactDraft = ""
  state discAt = 0
  // A privacy policy read from disk, to share.
  state policy = ""
  // Discarding a change and making a repo public take a second tap within 5 seconds.
  state discardAt = 0
  state discSlug = ""
  state publicAt = 0
  // "sign out" of a GitHub account takes a second tap within 5 seconds.
  state signL = ""
  state signAt = 0
  // When the banner's message came: it clears itself after a while.
  state outAt = 0
  // Simple mode (2.16): the screen's page (apps, app, new, settings), the step shown on an app's page
  // ("" = its next one), and Advanced opened from Simple for one task (until "← simple" or a restart).
  source settings = file("~/.local/share/apk-maker/settings.json") json
  // The skills library: what each skill gives, whether the agents get it, the apps that used it.
  source skills = file("~/.cache/apk-maker/skills.json") json
  state view = "apps" persist
  state appStep = ""
  state forceAdv = false
  state showDetails = false
  state showMore = false
  state skillOpen = ""

  let phase = job.phase ?? "idle"
  let busy = phase == "queued" || phase == "agent" || phase == "checking" || phase == "building" || phase == "fixing" || phase == "art" || phase == "installing" || phase == "uploading"
  // "app" builds and installs; "play-prepare" and "play-upload" are the Google Play jobs.
  let kind = job.kind == "build" ? "app" : job.kind ?? "app"

  // The backend this widget carries; a different one (older, or newer after going back a version) is (re)installed.
  let backendVersion = 23
  let backendDigest = "5efb27360e828f46d98495d40c58d160ffe677d175cb3895d30621b484a0916e"
  let needInstall = ver != null && (activeRelease.version != backendVersion || activeRelease.digest != backendDigest)
  // `worker` polls every 5s, so a setup that just started (or is about to) counts as alive.
  let setupAlive = worker == null || words(worker)[1] == "alive" || now - (setup.updated ?? 0) < 20 || now - installedAt < 20
  // The installer ends by printing "apk-maker <n> installed"; anything else it printed is why it
  // failed. One that never answers (killed with the launcher) counts as failed after a minute.
  let installErr = last(lines(trim(installOut ?? "")).filter(l => trim(l) != "")) ?? ""
  let installFailed = needInstall && ((installErr != "" && !contains(installOut, " installed")) || (installedAt > 0 && now - installedAt > 60))
  // install (writing the script) → setup (SDK and Gradle) → agent (none installed) → ready
  let stage = ver == null ? "loading" : needInstall ? (installFailed ? "installfail" : "install") : (setup.state == "running" || setup.state == null) && setupAlive ? "setup" : setup.state != "done" ? "failed" : agentsOut != null && trim(agentsOut) == "" ? "agent" : "ready"
  let missing = stage != "ready"
  let stageTitle = stage == "install" ? "installing" : stage == "installfail" ? "install didn't finish" : stage == "setup" ? "setting up · step ${setup.step ?? 1} of ${setup.steps ?? 5}" : stage == "failed" ? "setup didn't finish" : stage == "agent" ? "no coding agent" : "loading…"
  let stageMsg = stage == "install" ? "writing the scripts…" : stage == "installfail" ? (installErr != "" ? installErr : "the installer stopped without answering") : stage == "setup" ? setup.msg ?? "" : stage == "failed" ? (setup.state == "running" ? "setup stopped before finishing" : setup.msg ?? "setup hasn't run yet") : stage == "agent" ? "Install Claude Code, Codex or OpenCode, then log in." : ""
  let stageTint = stage == "failed" || stage == "installfail" ? red : stage == "agent" ? yellow : accent
  let slogLines = reverse(lines(slog ?? "").filter(l => trim(l) != "")).take(30)
  let problems = lines(trim(doctor ?? "")).filter(l => trim(l) != "")
  let connected = startsWith(adbs, "connected")
  let have = words(agentsOut ?? "").filter(w => w != "?")
  // Android reports manual installations even when ADB is offline. Package presence
  // verifies installation, not whether the newest APK has been installed.
  let list = (apps ?? []).map(a => merge(a, {onPhone: any(phoneApps ?? [], p => p.package == a.pkg)}))
  let cur = list.find(a => a.slug == job.slug)
  let picked = list.find(a => a.slug == sel) ?? cur
  let jagent = job.agent ?? agent
  let jname = cur.label ?? job.slug
  let logLines = lines(log ?? "").filter(l => trim(l) != "")
  let recent = reverse(logLines).take(60)
  let lastLine = last(logLines.filter(l => !startsWith(l, "=="))) ?? ""
  // 1 write, 2 build, 3 install (listing · bundle · graphics, or check · bundle · upload, for Play);
  // 4 = all done. A failed or stopped job shows the step it got to
  // (job.at; a job from an older backend has only its message to go on).
  let stopAt = job.at ?? (contains(job.msg ?? "", "build") ? "building" : contains(job.msg ?? "", "logged in") ? "agent" : "")
  let sp = phase == "failed" || phase == "cancelled" ? stopAt : phase
  // A job waiting for the passphrase stopped before signing (prepare) or uploading.
  let step = sp == "locked" ? (kind == "play-prepare" ? 2 : 3) : sp == "queued" || sp == "agent" || sp == "checking" ? 1 :sp == "building" || sp == "fixing" ? 2 : sp == "installing" || sp == "art" || sp == "uploading" || sp == "ready" ? 3 : sp == "done" ? 4 : 0
  let stepNames = kind == "play-prepare" ? ["listing", "bundle", "graphics"] : kind == "play-upload" ? ["check", "bundle", "upload"] : ["write", "build", "install"]
  let elapsed = busy && job.started != null ? now - job.started : null
  // busy but the worker process is gone: the job died without writing a final phase
  let stalled = busy && words(worker ?? "")[0] == "dead" && job.updated != null && now - job.updated > 15
  let locked = phase == "locked"
  let tint = stalled ? orange : locked ? yellow : phase == "done" ? green :phase == "failed" || phase == "cancelled" ? red : phase == "ready" ? yellow : busy ? accent : muted
  let phaseText = stalled ? "stalled" : phase == "queued" ? "starting" : phase == "agent" ? "writing" : phase == "fixing" ? "fixing" : phase == "art" ? "graphics" : phase == "done" ? (kind == "play-prepare" ? "prepared" : kind == "play-upload" ? "uploaded" : "verified") : phase == "ready" ? "ready" : phase == "cancelled" ? "stopped" : locked ? "waiting for you" : phase
  let needAuth = phase == "failed" && contains(job.msg ?? "", "logged in")
  // A command that failed ends its output with a line "✗" (the widget's commands add it on a non-zero exit).
  let outErr = endsWith(trim(out ?? ""), "✗")
  let errTail = last(lines(trim(err ?? "")).filter(l => trim(l) != "")) ?? ""
  let showErr = errTail != "" && (phase == "failed" || phase == "fixing" || stalled)
  let ideas = ["tip calculator", "unit converter", "habit tracker", "expense splitter", "workout timer", "flashcards"]
  let shown = list.filter(x => search == "" || contains(lower(x.label ?? x.slug), lower(search))).take(30)
  // Compact rows adapt to the standalone application width.
  let narrow = (screenWidth ?? 400) < 340
  let canStart = !busy && !missing && (agentsOut == null || len(have) == 0 || indexOf(have, agent) >= 0)
  // Why a new job can't start, for the banner.
  let canGo = canStart && trim(draft) != ""
  let blockMsg = busy ? "a job is already running: wait for it or stop it" : missing ? "setup isn't finished yet" : "${agent} is not installed"

  // Google Play. The play tab works on one app: its own pick, else the apps tab's.
  let pstate = play.state ?? "none"
  let pconn = pstate == "connected"
  let builtApps = list.filter(a => a.apk != null)
  let papp = builtApps.find(a => a.slug == playSel) ?? builtApps.find(a => a.slug == sel) ?? first(builtApps)
  let pp = papp.play ?? {}
  let prepared = pp.prepared != null
  let onPlay = pp.linked == true
  let shots = pp.shots ?? 0
  // Personal accounts made after Nov 13, 2023 must run a 12-tester, 14-day closed test first.
  let personal = play.personal ?? true
  let closedDays = pp.closedSince != null ? floor((now - pp.closedSince) / 86400) : 0
  let testers = pp.testers ?? 0
  let testDone = closedDays >= 14 && testers >= 12
  let prodOk = play.personal == false || pp.production == true
  let groupName = contains(pp.group ?? "", "@") ? split(pp.group, "@")[0] : ""
  let invite = "I'm testing my Android app ${papp.label ?? papp.slug} and need testers for 2 weeks:\n1. Join the test group: https://groups.google.com/g/${groupName}\n2. Opt in: https://play.google.com/apps/testing/${papp.pkg}\n3. Install it from Google Play and keep it for 14 days.\nThanks!"
  let trackLabel = track == "closed" ? "closed testing" : track == "production" ? "production" : "internal testing"
  let canUpload = pconn && prepared && onPlay && !busy && (track != "production" || prodOk)
  // An agent changed the app after its .aab was built: the next upload bundles the new code.
  let stale = prepared && (last((papp.history ?? []).filter(h => h.discarded != true)).t ?? 0) > (pp.built ?? 0)
  let cgroup = community.group ?? ""
  let mine = list.map(a => a.pkg)
  let capps = (community.apps ?? []).filter(x => indexOf(mine, x.pkg) < 0)
  let listed = (community.apps ?? []).find(x => x.pkg == papp.pkg)
  let testingN = len(keys(testing ?? {}))
  // GitHub is logged in; the accounts APK Maker may use (a gh login stays unused until picked), and the
  // one new apps go to. Each app syncs with the account its repo is on, while that one is in use.
  let gconn = gh.state == "connected"
  let gnames = (gh.accounts ?? []).map(x => x.login)
  let gused = gh.allowed ?? []
  let gacct = gh.account
  let gon = gconn && len(gused) > 0

  // Simple or Advanced (today's tabs). New users and the default: Simple.
  let advanced = settings.mode == "advanced" || forceAdv
  // The app on Simple's app page: the one picked, else the current job's.
  let sapp = list.find(a => a.slug == sel) ?? cur
  let sworking = sapp != null && busy && job.slug == sapp.slug
  let sstate = sworking ? "working" : sapp.next.state ?? "ready"
  let snext = sapp.next.step ?? "try"
  let curStep = appStep != "" ? appStep : (sworking && kind != "app" ? "publish" : sworking ? (len(sapp.history ?? []) > 1 ? "improve" : "try") : snext)
  let stepOrder = ["describe", "try", "improve", "publish"]
  // What the job is doing now, in a sentence.
  let doing = phase == "queued" ? "Starting" : kind == "play-prepare" ? (phase == "agent" ? "Writing the store page" : phase == "art" ? "Drawing the store pictures" : "Preparing the store file") : kind == "play-upload" ? (phase == "agent" ? "Writing what's new" : "Sending it to Google Play") : phase == "agent" ? "Writing the code" : phase == "fixing" ? "Fixing a problem" : phase == "building" ? "Building the app" : phase == "installing" ? "Installing it on your phone" : "Working"
  // A terminal-style spinner while something runs.
  let spin = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"][(now ?? 0) % 10]

  // The chosen agent isn't installed (the default, or one removed since): pick one that is.
  when len(have) > 0 && indexOf(have, agent) < 0 { agent = have[0] }

  // Added, or updated to a newer backend: install it. The retry buttons bump installRun too.
  when needInstall { installRun = installRun + 1 }
  // A new backend is in: re-ask it everything, rather than wait out the 2-minute polls.
  on ver { refresh() }
  when (setup.state == "done" || setup.state == "failed") && setupKey != "${setup.updated}" {
    notify("APK Maker", setup.state == "done" ? "set up: describe an app to build it" : "setup failed: ${setup.msg}")
    setupKey = "${setup.updated}"
    // doctor and agents poll every 2 minutes: don't show what setup just fixed as missing.
    refresh()
  }

  // installer:begin (generated by make-installer.sh from the apk-maker sources; edit those)
  on installRun {
    installedAt = now ?? 0
    installOut = ""
    installOut = run("""set -eu
umask 077
D="$HOME/.local/share/apk-maker"
C="$HOME/.cache/apk-maker"
mkdir -p "$D/releases" "$C"
exec 6> "$C/work.lock"
flock -w 15 6 || { echo 'a job is running; retry the update when it finishes'; exit 1; }
exec 9> "$C/setup.lock"
flock -w 15 9 || { echo 'setup is running; retry the update when it finishes'; exit 1; }
S=$(mktemp -d "$D/releases/.stage.XXXX")
trap 'rm -rf "$S"' EXIT
base64 -d > "$S/payload.tgz" <<'APKMAKER_PAYLOAD'

APKMAKER_PAYLOAD
printf '%s  %s\n' '5efb27360e828f46d98495d40c58d160ffe677d175cb3895d30621b484a0916e' "$S/payload.tgz" | sha256sum -c --status
mkdir "$S/release"
tar -xzf "$S/payload.tgz" -C "$S/release"
printf '%s\n' '5efb27360e828f46d98495d40c58d160ffe677d175cb3895d30621b484a0916e' > "$S/release/.release-sha"
for f in gradle.properties local.properties gradle/wrapper/gradle-wrapper.jar; do
  [ ! -f "$D/template/$f" ] || cp "$D/template/$f" "$S/release/template/$f"
done
for f in apk-maker reliability.sh workflow.sh starter.sh isolate sandbox-check; do [ ! -f "$S/release/bin/$f" ] || bash -n "$S/release/bin/$f"; done
chmod +x "$S/release/bin/apk-maker" "$S/release/template/gradlew"
for f in isolate sandbox-check; do [ ! -f "$S/release/bin/$f" ] || chmod +x "$S/release/bin/$f"; done
# First migration retains the legacy layout in a bootstrap release. Subsequent switches are atomic.
if [ ! -L "$D/current" ]; then
  B="$D/releases/bootstrap-$(date +%s)"
  mkdir -p "$B"
  for f in bin template skills AGENTS.md VERSION .library .release-sha; do
    [ ! -e "$D/$f" ] || cp -a "$D/$f" "$B/$f"
  done
  ln -s "$B" "$D/current"
fi
for f in bin template skills AGENTS.md VERSION .library .release-sha; do
  if [ ! -L "$D/$f" ]; then
    [ ! -e "$D/$f" ] || mv "$D/$f" "$S/legacy-$f"
    ln -s "current/$f" "$D/$f"
  fi
done
R="$D/releases/$(cat "$S/release/VERSION")-$(date +%s)"
mv "$S/release" "$R"
ln -sfn "$(readlink "$D/current")" "$D/.previous.new"
mv -Tf "$D/.previous.new" "$D/previous"
ln -sfn "$R" "$D/.current.new"
mv -Tf "$D/.current.new" "$D/current"
printf '{"version":%s,"digest":"%s"}\n' "$(cat "$D/VERSION")" "$(cat "$D/.release-sha")" > "$D/release.json.new"
mv "$D/release.json.new" "$D/release.json"
mkdir -p "$HOME/.local/bin"
ln -sf "$D/bin/apk-maker" "$HOME/.local/bin/apk-maker"
# Setup waits for both locks after this installer exits.
setsid -f "$D/bin/apk-maker" setup >/dev/null 2>&1 < /dev/null 6>&- 9>&-
echo "apk-maker $(cat "$D/VERSION") installed"
""")
  }
  when contains(installOut ?? "", " installed") { libraryAt = installedAt; libraryOut = "apk-maker library installed" }
  // installer:end

  // apk-maker prints a URL when a finished app has to come from the browser: open it.
  // `out` is cleared before each command, so the same URL twice still opens twice.
  // Only the links the backend prints: its own downloads and pages, and the tester list on GitHub.
  on out { outAt = now; openUrl = startsWith(trim(value ?? ""), "http://127.0.0.1:") || startsWith(trim(value ?? ""), "https://github.com/") ? trim(value) : "" }
  when openUrl != "" {
    url(openUrl)
    openUrl = ""
  }
  // The play tab reads the privacy policy from disk to hand it to the share sheet.
  // The banner clears itself: news after 30 seconds, a failure after 2 minutes.
  when trim(out ?? "") != "" && now - outAt > (outErr ? 120 : 30) { out = "" }
  when policy != "" {
    share(policy)
    policy = ""
  }
  // A new phase drops a pending "stop" confirmation.
  on phase { confirmAt = 0 }
  // Tell the user when a build finishes while they are looking at something else.
  when (phase == "done" || phase == "ready" || phase == "failed" || locked) && doneKey != "${job.slug}:${job.started}:${phase}" {
    notify("APK Maker", locked ? "${jname}: ${job.msg ?? "unlock to finish"}" : phase == "failed" ?"${jname} failed: ${job.msg ?? "see the log"}" : kind != "app" ? "${jname}: ${job.msg ?? "done"}" : cur.pending != null && cur.pending.built == true ? "${jname}: change ready to try, then accept or discard it" : phase == "done" ? "${jname} is installed" : "${jname} is built: tap install")
    doneKey = "${job.slug}:${job.started}:${phase}"
  }

  component Dot(c) {
    Canvas { width: 8; height: 8; circle(4, 4, 4, fill: c) }
  }

  component Chip(name) {
    let on = agent == name
    // Until the agent list loads, no agent counts as missing.
    let ok = agentsOut == null || len(have) == 0 || indexOf(have, name) >= 0
    Text {
      text: name
      fontSize: 12
      align: center
      maxLines: 1
      padding: [6, 4]
      radius: 8 * corners
      border: 1
      opacity: ok ? 1 : 0.4
      borderColor: on ? accent : border
      color: on ? background : foreground
      background: on ? accent : alpha(surface, 0.0)
      onTap: { agent = ok ? name : agent; out = ok ? "" : "${name} is not installed\n✗"; haptic() }
    }
  }

  component Agents {
    Row {
      gap: 6
      Chip { name: "claude"; weight: 1 }
      Chip { name: "codex"; weight: 1 }
      Chip { name: "opencode"; weight: 1 }
    }
  }

  // One coloured dot + label per status, so it reads the same everywhere.
  component Pill(s) {
    Row {
      gap: 6
      align: center
      width: 96
      justify: end
      let c = s == "installed" ? green : s == "failed" || s == "cancelled" ? red : s == "ready" ? yellow : s == "built" || s == "review" ? cyan : s == "building" ? accent : s == "stalled" ? orange : muted
      Dot { c: c }
      Text { text: s == "cancelled" ? "stopped" : s; style: small; color: c; maxLines: 1 }
    }
  }

  // write · build · install (or a Play job's steps), each in its own colour once reached (the
  // last green); a step that stalled, failed or was stopped shows the phase's colour instead.
  component Steps(labels = true) {
    Row {
      gap: 4
      for s, i in stepNames {
        Column {
          weight: 1
          gap: 2
          let own = i == 0 ? blue : i == 1 ? magenta : green
          let bad = step == i + 1 && (stalled || phase == "failed" || phase == "cancelled")
          let reached = step >= i + 1 || phase == "done"
          let c = bad ? tint : reached ? own : alpha(muted, 0.25)
          Spacer { height: 3; fill: width; background: c; radius: 2 * corners }
          if labels {
            Text { text: s; fontSize: 10; color: bad ? tint : step == i + 1 ? own : muted; maxLines: 1 }
          }
        }
      }
    }
  }

  // The stored prompt wraps the user's idea in boilerplate; show just the idea.
  component Idea(p) {
    Text {
      text: startsWith(p, "Continue building") ? "retry: finish the app and get the build passing" : replace(replace(first(lines(p)), "Build this Android app in the current directory: ", ""), "Change this Android app (read AGENTS.md first): ", "")
      style: small
      italic: true
      color: muted
      maxLines: 3
    }
  }

  // Everything that can be done with one app, from the apps tab and the job tab.
  component Evidence(a) {
    Column { gap: 4
      Text { text: "Build: ${a.outcomes.build ?? "unverified"} · Install: ${a.onPhone ? "on phone · version unverified" : a.outcomes.install ?? "unverified"}"; style: small; color: muted; maxLines: 2 }
      Text { text: "Startup: ${a.outcomes.runtime ?? "unverified"} · GitHub: ${a.outcomes.github ?? "local"}"; style: small; color: muted; maxLines: 2 }
      Flow { gap: 6
        Button { text: "feature checks"; onTap: terminal("if [ -f ~/apps/${sh(a.slug)}/acceptance.json ]; then jq . ~/apps/${sh(a.slug)}/acceptance.json; else ~/.local/bin/apk-maker checks ${sh(a.slug)}; fi; echo; read -rp 'Press Enter to close. ' _", "feature checks") }
        Button { text: "back up project"; onTap: terminal("~/.local/bin/apk-maker backup ${sh(a.slug)}; echo; read -rp 'Press Enter to close. ' _", "project backup") }
      }
    }
  }

  component Actions(a) {
    Flow {
      gap: 6
      // A browser download can't be seen from here, so after one, "open" is offered too.
      if a.status == "installed" || a.downloaded != null {
        Button { text: "open"; color: green; onTap: androidApp(a.pkg) }
      }
      if !busy && a.artifacts.apk == null {
        Button { text: "rebuild"; color: accent; onTap: { out = run("~/.local/bin/apk-maker build ${sh(a.slug)} 2>&1 || echo ✗"); tab = "job" } }
      }
      if a.status == "ready" || a.status == "built" || a.status == "installed" {
        Button { text: a.status == "installed" ? "reinstall" : "install"; color: a.status == "installed" ? foreground : yellow; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker install ${sh(a.slug)} 2>&1 || echo ✗") } }
        Button { text: "download"; onTap: { out = ""; out = run("~/.local/bin/apk-maker download ${sh(a.slug)} 2>&1 || echo ✗") } }
      }
      if !busy && (a.status == "failed" || a.status == "cancelled" || a.status == "new" || a.status == "building") {
        Button { text: "retry"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker retry ${sh(a.slug)} 2>&1 || echo ✗"); tab = "job" } }
      }
      Button { text: "terminal"; onTap: terminal((a.agent ?? agent) == "codex" ? "cd ~/apps/${sh(a.slug)} && codex; exec bash" : (a.agent ?? agent) == "opencode" ? "cd ~/apps/${sh(a.slug)} && opencode; exec bash" : "cd ~/apps/${sh(a.slug)} && claude; exec bash", a.slug) }
      Button { text: "copy id"; onTap: copy(a.pkg) }
      if a.apk != null {
        Button { text: "google play"; color: cyan; onTap: { playSel = a.slug; tab = "play"; refresh() } }
      }
      if connected && a.status == "installed" {
        Button { text: "uninstall"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker uninstall ${sh(a.slug)} 2>&1 || echo ✗") } }
      }
      // Deleting removes the project for good, so it takes a second tap.
      if !(busy && a.slug == job.slug) {
        if delSlug == a.slug && now - delAt < 5 {
          Button { text: "really delete?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker delete ${sh(a.slug)} 2>&1 || echo ✗"); delSlug = ""; sel = sel == a.slug ? "" : sel } }
        } else {
          Button { text: "delete"; color: red; onTap: { haptic(); delSlug = a.slug; delAt = now } }
        }
      }
    }
  }

  // A change waits on its own branch until it's kept or dropped (on GitHub it's a pull request too).
  component Review(a) {
    let pd = a.pending
    let working = busy && job.slug == a.slug
    Column {
      gap: 6
      padding: 8
      radius: 8 * corners
      background: alpha(cyan, 0.10)
      border: 1
      borderColor: cyan
      Row {
        gap: 6
        align: center
        Dot { c: cyan }
        Text { text: working ? "change in progress" : pd.built ? "change waiting for you" : "change needs a fix"; bold: true; style: small; weight: 1; maxLines: 1 }
        if pd.pr != null {
          Text { text: "PR #${pd.pr}"; style: small; color: cyan; maxLines: 1 }
        }
      }
      Text { text: pd.request; style: small; italic: true; maxLines: 3 }
      if pd.prUrl != null {
        Text { text: "Accepting here keeps the commits signed apk-maker. Merging on GitHub's site signs them with your GitHub email, unless GitHub's Keep my email addresses private is on."; style: small; color: muted }
      }
      Text { text: working ? "the agent is still on it" : pd.built ? "Try it on the phone, then keep it or drop it. Dropping it restores code and APK; app data stays as changed." : "This change hasn't built successfully, so it can't be accepted yet. Continue to finish the saved changes and build the APK, or discard them."; style: small; color: muted }
      if !working {
        Flow {
          gap: 6
          if pd.built {
            Button { text: "accept"; color: green; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker accept ${sh(a.slug)} 2>&1 || echo ✗") } }
          } else {
            if !busy {
              Button { text: "continue & fix"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker retry ${sh(a.slug)} 2>&1 || echo ✗"); refresh() } }
            } else {
              Text { text: "wait for the current job to finish"; style: small; color: muted }
            }
          }
          if pd.prUrl != null {
            Button { text: "see changes"; onTap: url(pd.prUrl) }
          } else {
            Button { text: "see changes"; onTap: terminal("cd ~/apps/${sh(a.slug)} && git -c color.ui=always diff --stat ${sh(pd.base)} && git -c color.ui=always diff ${sh(pd.base)} | less -R; exec bash", "changes") }
          }
          if discSlug == a.slug && now - discardAt < 5 {
            Button { text: "really discard?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker discard ${sh(a.slug)} 2>&1 || echo ✗"); discardAt = 0 } }
          } else {
            Button { text: "discard"; color: red; onTap: { haptic(); discSlug = a.slug; discardAt = now } }
          }
        }
      }
    }
  }

  // The app's GitHub repo: private unless made public, which takes a second tap.
  component GitHubRow(a) {
    let g = a.github
    let owner = g.account ?? split(g.repo ?? "", "/")[0]
    // Not using the app's account (stopped, or signed out of it): the repo stays, APK Maker just doesn't push or check it.
    let off = g != null && indexOf(gused, owner) < 0
    let signedIn = indexOf(gnames, owner) >= 0
    Column {
      gap: 4
      Row {
        gap: 6
        align: center
        Dot { c: g == null ? muted : off ? orange : g.blocked != null ? red : g.visibility == "public" ? yellow : green }
        Text { text: g == null ? "not on GitHub" : off ? "GitHub · ${owner} · not syncing" : "GitHub · ${owner} · ${g.visibility ?? "private"}"; style: small; color: off ? orange : foreground; weight: 1; maxLines: 1 }
      }
      if g != null {
        Text { text: g.repo; style: small; font: mono; color: muted; maxLines: 1 }
      }
      if g == null && !(gon && gacct != null) {
        Text { text: gconn ? "Pick a GitHub account for APK Maker on the setup tab to back this app up there." : "Connect GitHub on the setup tab to back this app up there (optional)."; style: small; color: muted; maxLines: 3 }
      }
      if off {
        Text { text: signedIn ? "APK Maker isn't using ${owner}, so changes to this app stay on this phone and aren't sent to GitHub. Nothing was deleted." : "This phone is signed out of ${owner}, so changes to this app stay on this phone and aren't sent to GitHub. Nothing was deleted: sign in again to sync it."; style: small; color: muted; maxLines: 4 }
      }
      if g.blocked != null && !off {
        Text { text: "Not sent to GitHub, to keep it safe: ${g.blocked}. Remove it (ask the agent, or discard the change), then it goes up with the next change."; style: small; color: red; maxLines: 4 }
      }
      if g != null && !off && g.visibility != "public" && now - publicAt < 5 {
        Text { text: "Public means anyone can see the code, its history and the pull requests (your change requests). APK Maker checks for keys and personal details first."; style: small; color: yellow }
      }
      Flow {
        gap: 6
        if g == null {
          if gon && gacct != null {
            Button { text: "put on GitHub (private, ${gacct})"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github publish ${sh(a.slug)} private 2>&1 || echo ✗") } }
          } else {
            Button { text: "set up GitHub"; onTap: { tab = "setup"; haptic() } }
          }
        } else {
          Button { text: "open on GitHub"; onTap: url(g.url) }
          if off {
            if signedIn {
              Button { text: "sync with ${owner} again"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github resume ${sh(owner)} 2>&1 || echo ✗") } }
            } else {
              Button { text: "sign in to GitHub"; color: accent; onTap: terminal("~/.local/bin/apk-maker github add && echo 'Done: go back to APK Maker.'; exec bash", "GitHub") }
            }
          } else {
            if g.visibility == "public" {
              Button { text: "make private"; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github visibility ${sh(a.slug)} private 2>&1 || echo ✗") } }
            } else {
              if now - publicAt < 5 {
                Button { text: "really make public?"; color: yellow; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github visibility ${sh(a.slug)} public 2>&1 || echo ✗"); publicAt = 0 } }
              } else {
                Button { text: "make public"; onTap: { haptic(); publicAt = now } }
              }
            }
          }
        }
      }
    }
  }

  // A GitHub login on this phone: whether APK Maker uses it, its apps, and use / stop using / sign out.
  component GhAccount(l) {
    let used = indexOf(gused, l) >= 0
    let n = len(list.filter(a => a.github != null && (a.github.account ?? split(a.github.repo ?? "", "/")[0]) == l))
    let asking = signL == l && now - signAt < 5
    Column {
      gap: 6
      padding: 8
      radius: 8 * corners
      border: 1
      borderColor: l == gacct ? green : border
      Row {
        gap: 6
        align: center
        Dot { c: used ? green : muted }
        Text { text: l; bold: true; font: mono; style: small; weight: 1; maxLines: 1 }
        Text { text: l == gacct ? "new apps go here" : used ? "in use" : "not used"; style: small; color: used ? green : muted; maxLines: 1 }
      }
      Text { text: "${n == 0 ? "no apps" : n == 1 ? "1 app" : "${n} apps"} on GitHub with this account${n > 0 && !used ? ", not syncing" : ""}"; style: small; color: muted; maxLines: 2 }
      if asking {
        Text { text: "Sign this phone out of ${l}? Other tools here that use GitHub are signed out of it too. You can sign in again with \"add another account\"."; style: small; color: red }
      }
      Flow {
        gap: 6
        if l != gacct {
          Button { text: "use for new apps"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github use ${sh(l)} 2>&1 || echo ✗") } }
        }
        if used {
          Button { text: "stop using"; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github logout ${sh(l)} 2>&1 || echo ✗") } }
        }
        if asking {
          Button { text: "really sign out?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github signout ${sh(l)} 2>&1 || echo ✗"); signL = "" } }
        } else {
          Button { text: "sign out"; color: red; onTap: { haptic(); signL = l; signAt = now } }
        }
      }
    }
  }

  // One line on every app card: on GitHub or not, with which account, and whether it syncs.
  component GhLine(a) {
    let g = a.github
    let owner = g.account ?? split(g.repo ?? "", "/")[0]
    let off = g != null && indexOf(gused, owner) < 0
    Row {
      gap: 6
      align: center
      Dot { c: g == null ? alpha(muted, 0.5) : off ? orange : g.blocked != null ? red : green }
      Text { text: g == null ? "not on GitHub" : off ? "GitHub · ${owner} · not syncing" : "GitHub · ${owner} · ${g.visibility ?? "private"}"; style: small; color: g == null ? muted : off ? orange : foreground; weight: 1; maxLines: 1 }
    }
  }
  // The app's own launcher icon (drawn after each build), else its initial; rounded like the launcher's corners.
  component AppIcon(a, s = 36) {
    Box {
      width: s
      height: s
      align: center
      if a.icon != null && a.icon != "" {
        Image { src: a.icon; width: s; height: s; fit: cover; radius: s * 0.2 * corners; clip: true }
      } else {
        Text { text: lower(sub(a.label ?? a.slug ?? "?", 0, 1)); width: s; height: s; align: center; bold: true; fontSize: s * 0.42; padding: [0, s * 0.2]; color: accent; border: 1; borderColor: accent }
      }
    }
  }

  component AppRow(a) {
    Row {
      align: center
      gap: 6
      onTap: { sel = a.slug; tab = "apps"; refresh() }
      AppIcon { a: a; s: 22 }
      Text { text: a.label ?? a.slug; style: small; maxLines: 1; weight: 1 }
      let s = a.status == "building" && !(busy && a.slug == job.slug) ? "stalled" : a.pending != null && a.pending.built == true && a.status != "building" ? "review" : a.status
      if narrow {
        Dot { c: s == "installed" ? green : s == "failed" || s == "cancelled" ? red : s == "ready" ? yellow : s == "built" || s == "review" ? cyan : s == "building" ? accent : s == "stalled" ? orange : muted }
      } else {
        Pill { s: s }
      }
    }
  }

  // Where setup is, and the one thing to do about it.
  component SetupCard(full = false) {
    Column {
      gap: 6
      padding: 8
      radius: 8 * corners
      background: alpha(stageTint, 0.10)
      border: 1
      borderColor: alpha(stageTint, 0.6)
      Row {
        align: center
        gap: 6
        Dot { c: stageTint }
        Text { text: stageTitle; bold: true; style: small; weight: 1; maxLines: 1 }
      }
      if stage == "install" || stage == "setup" {
        Progress { value: stage == "install" ? 0 : (setup.step ?? 1) - 1; max: setup.steps ?? 5; height: 3; fill: width; color: accent; track: alpha(muted, 0.2); animate value: spring() }
      }
      if stageMsg != "" {
        Text { text: stageMsg; style: small; color: stage == "failed" || stage == "installfail" ? red : muted; maxLines: full ? 4 : 2 }
      }
      Flow {
        gap: 6
        if stage == "failed" || stage == "installfail" {
          Button { text: "retry"; color: accent; onTap: { haptic(); installRun = installRun + 1 } }
        }
        if stage == "agent" {
          Button { text: "add an agent"; color: yellow; onTap: launcher("agents") }
          Button { text: "check again"; onTap: refresh() }
        }
        if (stage == "setup" || stage == "failed") && !full {
          Button { text: "log"; onTap: { tab = "setup"; refresh() } }
        }
        if (stage == "setup" || stage == "failed") && full {
          Button { text: "live log"; onTap: terminal("tail -n 50 -f ~/.cache/apk-maker/setup.log", "setup log") }
        }
      }
    }
  }

  // A numbered step on the play tab, green once done.
  component PStep(n, title, done) {
    Row {
      gap: 6
      align: center
      padding: [0, 4, 0, 0]
      Dot { c: done ? green : muted }
      Text { text: "${n} · ${title}"; style: label; color: done ? green : foreground; weight: 1; maxLines: 1 }
    }
  }

  component Notice(msg, c, action = "", go = "") {
    Row {
      gap: 8
      align: center
      padding: [8, 6]
      radius: 8 * corners
      background: alpha(c, 0.14)
      border: 1
      borderColor: c
      Text { text: msg; style: small; color: c; weight: 1; maxLines: 3 }
      if action != "" && go == "login" {
        Button { text: action; onTap: terminal(jagent == "codex" ? "codex login" : jagent == "opencode" ? "opencode auth login" : "claude", "login") }
      }
      if action != "" && go == "unlock" {
        Button { text: action; color: yellow; onTap: terminal("~/.local/bin/apk-maker unlock; echo; read -rp 'Press Enter to close. ' _", "unlock") }
      }
      if action != "" && go != "login" && go != "unlock" {
        Button { text: action; onTap: { tab = "setup"; refresh() } }
      }
    }
  }

  // Stopping kills a build that may be minutes in, so it takes a second tap within 5 seconds.
  component Stop {
    Row {
      if now - confirmAt < 5 {
        Button { text: "really stop?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker cancel 2>&1 || echo ✗"); confirmAt = 0 } }
      } else {
        Button { text: "stop"; color: red; onTap: { haptic(); confirmAt = now } }
      }
    }
  }

  component Banner {
    Row {
      gap: 8
      align: center
      padding: [8, 6]
      radius: 8 * corners
      background: alpha(outErr ? red : accent, 0.14)
      border: 1
      borderColor: outErr ? red : accent
      // A download URL has already opened in the browser: say what to do there instead.
      let o = trim(replace(out ?? "", "✗", ""))
      Text { text: !startsWith(o, "http") ? o : contains(o, ":8766/") ? "the browser opened: pick the service account's JSON key there" : endsWith(o, ".aab") ? "downloading the .aab: upload it in Play Console (step 4)" : endsWith(o, "-upload-key.txt") ? "downloading the key backup: keep it somewhere safe and private" : contains(o, "github.com/") ? "the browser opened: submit the issue there to list your app" : "downloading in the browser: open the APK there to install it"; style: small; color: outErr ? red : accent; weight: 1; maxLines: 4 }
      Text { text: "✕"; width: 24; align: center; color: muted; padding: [6, 2]; onTap: out = "" }
    }
  }

  // The one or two things to do next with the current job.
  component Next(showLog = true) {
    Flow {
      gap: 6
      if busy {
        if stalled {
          Button { text: "retry"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker again 2>&1 || echo ✗") } }
        }
        if showLog {
          Button { text: "log"; onTap: { tab = "job"; refresh() } }
        }
        Stop { }
      } else {
        if needAuth {
          Button { text: "log in"; color: yellow; onTap: terminal(jagent == "codex" ? "codex login" : jagent == "opencode" ? "opencode auth login" : "claude", "login") }
        }
        if cur.status == "installed" || cur.downloaded != null {
          Button { text: "open"; color: green; onTap: androidApp(cur.pkg) }
        }
        if cur.pending != null && cur.pending.built == true {
          Button { text: "review"; color: cyan; onTap: { sel = cur.slug; tab = "apps"; refresh() } }
        }
        // Already handed to the browser: "open" is the one button (reinstall is on the apps tab).
        if (cur.status == "ready" || cur.status == "built") && cur.downloaded == null {
          Button { text: "install"; color: yellow; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker install ${sh(cur.slug)} 2>&1 || echo ✗") } }
        }
        // The signing and the upload wait for the passphrase, typed in a terminal.
        if locked {
          Button { text: "unlock"; color: yellow; onTap: terminal("~/.local/bin/apk-maker unlock; echo; read -rp 'Press Enter to close. ' _", "unlock") }
          Stop { }
        }
        if phase == "failed" || phase == "cancelled" {
          Button { text: "retry"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker again 2>&1 || echo ✗") } }
          if showLog {
            Button { text: "log"; onTap: { tab = "job"; refresh() } }
          }
        }
      }
    }
  }

  component NewInput(focusIt = false) {
    Input {
      text: draft
      placeholder: busy ? "wait for ${jname}…" : missing ? "finish setup first" : "what should your app do?"
      focus: focusIt
      onChange: draft = value
      onSubmit: {
        // An empty submit (the keyboard's enter on nothing) does nothing.
        out = ""
        out = run(canGo ? "~/.local/bin/apk-maker new ${sh(agent)} ${sh(trim(draft))} 2>&1 || echo ✗" : trim(draft) == "" ? "true" : "echo ${sh(blockMsg)}; echo ✗")
        sel = canGo ? "" : sel
        tab = canGo ? "job" : tab
        draft = canGo ? "" : draft
      }
    }
  }

  // ---- Simple mode (2.16): My apps, one page per app with its four steps, plain words ----
  //
  // In Omarchy's style, like the launcher's other widgets: flat on the tile's own background, thin rules
  // between sections, lowercase monospace, accent keys beside plain values, outlined buttons, square
  // corners (the user's corner setting still applies).

  // A thin rule between sections.
  component Rule {
    Spacer { height: 1; fill: width; background: alpha(muted, 0.25) }
  }

  // A section's name: lowercase, muted, with a rule under it.
  component Section(name) {
    Column {
      gap: 4
      Text { text: name; style: label; color: muted; maxLines: 1 }
      Rule { }
    }
  }

  // One status word per app, in plain words, from its next step (a job running on it takes over).
  component StatusWord(a, mid = false) {
    let w = busy && job.slug == a.slug
    let s = w ? "working" : locked && job.slug == a.slug ? "waiting" : a.next.state ?? "ready"
    let c = s == "working" ? accent : s == "waiting" ? yellow : s == "failed" || s == "stopped" ? red : s == "ready" ? (a.onPhone ? green : yellow) : s == "review" ? cyan : s == "live" || s == "done" || s == "testers" ? green : muted
    let word = s == "working" ? (kind == "app" ? "making it…" : "publishing…") : s == "waiting" ? "waiting for you" : s == "failed" ? "needs a fix" : s == "stopped" ? "stopped" : s == "ready" ? (a.onPhone ? "on your phone" : "ready to install") : s == "review" ? "change to check" : s == "testers" ? "with your testers" : s == "live" ? "live on google play" : a.status == "installed" ? "on your phone" : a.downloaded != null ? "APK downloaded" : "ready to install"
    if mid {
      Text { text: "● ${word}"; style: small; color: c; maxLines: 1; align: center }
    } else {
      Text { text: "● ${word}"; style: small; color: c; maxLines: 1 }
    }
  }

  // The one action for an app's next step, as an outlined button in its colour.
  component ActionPill(a) {
    let w = busy && job.slug == a.slug
    let s = a.next.state ?? "ready"
    let act = w || s == "review" || (s == "failed" && a.next.step == "improve") ? "view" : s == "failed" || s == "stopped" ? "retry" : s == "ready" ? (a.onPhone ? "open" : "install") : "open"
    Box {
      width: 92
      if act == "open" {
        Button { text: "open"; color: green; fill: width; onTap: { haptic(); androidApp(a.pkg) } }
      } else {
        if act == "view" {
          Button { text: "view"; color: accent; fill: width; onTap: { haptic(); sel = a.slug; view = "app"; appStep = "" } }
        } else {
          if act == "install" {
            Button { text: "install"; color: yellow; fill: width; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker install ${sh(a.slug)} 2>&1 || echo ✗") } }
          } else {
            Button { text: "retry"; color: accent; fill: width; onTap: { haptic(); out = ""; out = run(busy ? "echo ${sh(blockMsg)}; echo ✗" : "~/.local/bin/apk-maker retry ${sh(a.slug)} 2>&1 || echo ✗"); sel = a.slug; view = "app"; appStep = "" } }
          }
        }
      }
    }
  }

  component AppCard(a) {
    Column {
      gap: 8
      Row {
        gap: 12
        align: center
        onTap: { sel = a.slug; view = "app"; appStep = ""; showMore = false; haptic() }
        AppIcon { a: a; s: 44 }
        Column {
          weight: 1
          gap: 2
          Text { text: lower(a.label ?? a.slug); color: foreground; maxLines: 1 }
          StatusWord { a: a }
        }
        ActionPill { a: a }
      }
      Rule { }
    }
  }


  // While something is being made: what, how far, how long. A tap opens its page.
  component MakingCard {
    Column {
      gap: 6
      padding: 10
      border: 1
      borderColor: accent
      onTap: { sel = job.slug; view = "app"; appStep = ""; haptic(); refresh() }
      Row {
        gap: 8
        align: center
        Text { text: spin; color: accent; width: 16 }
        Text { text: lower(jname ?? "your app"); color: foreground; weight: 1; maxLines: 1 }
        Text { text: elapsed != null ? fmtDuration(elapsed) : ""; style: small; color: muted; width: 64; align: end; maxLines: 1 }
      }
      Text { text: lower(doing); style: small; color: accent; maxLines: 1 }
      Steps { labels: false }
      Text { text: "you'll get a notification when it's ready"; style: small; color: muted; maxLines: 1 }
    }
  }

  // describe · try · improve · publish, like Omarchy's workspace bar: the shown one in an accent block,
  // the ones behind the app's next step ticked.
  component StepBar {
    let at = indexOf(stepOrder, snext)
    Row {
      gap: 4
      for s, i in stepOrder {
        let on = s == curStep
        let done = i < at
        Column {
          weight: 1
          gap: 4
          onTap: { appStep = s; haptic() }
          Text { text: done && !on ? "✓ ${s}" : "${i + 1} ${s}"; style: small; align: center; maxLines: 1; padding: [0, 5]; color: on ? background : done ? green : muted; background: on ? accent : alpha(surface, 0.0) }
          Spacer { height: 2; fill: width; background: on ? accent : done ? green : alpha(muted, 0.25) }
        }
      }
    }
  }

  // An app's facts, as key and value like fastfetch.
  component Fact(k, v, c = foreground) {
    Row {
      gap: 8
      Text { text: k; color: accent; width: 84; maxLines: 1 }
      Text { text: v; color: c; weight: 1; maxLines: 2 }
    }
  }

  component TryCard {
    Column {
      gap: 10
      if sworking {
        Section { name: "making it" }
        Row { gap: 8; Text { text: spin; color: accent; width: 16 }  Text { text: lower(doing); color: accent; weight: 1; maxLines: 1 } }
        Steps { }
        Text { text: "${elapsed != null ? fmtDuration(elapsed) + " so far. " : ""}this takes a few minutes. you'll get a notification when it's ready, so you can leave this page."; style: small; color: muted }
        Row { Spacer { weight: 1 }  Stop { } }
      } else {
        if sstate == "failed" || sstate == "stopped" {
          Section { name: "try" }
          Text { text: needAuth ? "the ai helper isn't signed in" : sstate == "stopped" ? "it stopped before finishing" : "something went wrong"; color: red }
          Text { text: needAuth ? "sign in once, then try again." : "trying again lets the ai helper pick up where it stopped and fix what went wrong."; style: small; color: muted }
          Flow {
            gap: 6
            if needAuth {
              Button { text: "sign in"; color: yellow; onTap: terminal(jagent == "codex" ? "codex login" : jagent == "opencode" ? "opencode auth login" : "claude", "sign in") }
            }
            Button { text: "try again"; color: accent; onTap: { haptic(); out = ""; out = run(busy ? "echo ${sh(blockMsg)}; echo ✗" : "~/.local/bin/apk-maker retry ${sh(sapp.slug)} 2>&1 || echo ✗") } }
            Button { text: showDetails ? "hide details" : "details"; onTap: showDetails = !showDetails }
          }
          if showDetails {
            Column {
              gap: 1
              for l in recent.take(20) {
                Text { text: l; font: mono; fontSize: 10; color: contains(l, "error") || startsWith(l, "e: ") ? red : muted; maxLines: 2 }
              }
            }
          }
        } else {
          Section { name: "try" }
          if sstate == "ready" && !sapp.onPhone {
            Text { text: "your app is ready"; color: foreground }
            Text { text: connected ? "it installs on this phone and opens." : "the app file downloads in your browser. open it there: android asks once to allow installing from the browser."; style: small; color: muted }
            Button { text: "install"; color: yellow; fill: width; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker install ${sh(sapp.slug)} 2>&1 || echo ✗") } }
          } else {
            Text { text: sapp.onPhone || sapp.status == "installed" ? "it is on your phone" : "the APK was downloaded"; color: foreground }
            Text { text: sapp.onPhone || sapp.status == "installed" ? "Android confirms the app is installed. To get the latest build, tap update APK; without ADB its installed version cannot be verified." : "finish installing the APK in Android, then open the app. Installation cannot be verified while ADB is offline."; style: small; color: muted }
            Flow {
              gap: 6
              Button { text: "open"; color: green; onTap: androidApp(sapp.pkg) }
              Button { text: "update APK"; onTap: { out = ""; out = run("~/.local/bin/apk-maker install ${sh(sapp.slug)} 2>&1 || echo ✗") } }
              Button { text: "improve it ›"; onTap: appStep = "improve" }
            }
          }
        }
      }
    }
  }

  component ImproveCard {
    let can = canStart && sapp.pending == null && trim(change) != ""
    Column {
      gap: 10
      if sapp.pending != null {
        Review { a: sapp }
      }
      Section { name: "what should change?" }
      Input {
        text: change
        placeholder: sworking ? "wait for the current change…" : sapp.pending != null ? "keep or drop the change above first" : "e.g. add a dark mode"
        onChange: change = value
        onSubmit: {
          out = ""
          out = run(can ? "~/.local/bin/apk-maker change ${sh(sapp.slug)} ${sh(agent)} ${sh(trim(change))} 2>&1 || echo ✗" : trim(change) == "" ? "true" : "echo ${sh(blockMsg)}; echo ✗")
          change = can ? "" : change
        }
      }
      Grid {
        columns: 2
        gap: 6
        for e in ["a dark mode", "bigger text", "a new icon", "a settings page", "nicer colours", "sounds"] {
          Text { text: "+ ${e}"; style: small; maxLines: 1; padding: [8, 6]; border: 1; borderColor: alpha(accent, 0.4); color: accent; onTap: { change = trim(change) == "" ? "Add ${e}" : "${change}, and add ${e}"; haptic() } }
        }
      }
      if trim(change) != "" {
        Button { text: "make this change"; color: can ? accent : muted; fill: width; onTap: { haptic(); out = ""; out = run(can ? "~/.local/bin/apk-maker change ${sh(sapp.slug)} ${sh(agent)} ${sh(trim(change))} 2>&1 || echo ✗" : "echo ${sh(blockMsg)}; echo ✗"); change = can ? "" : change } }
      }
      let hist = reverse((sapp.history ?? []).drop(1)).take(5)
      if len(hist) > 0 {
        Section { name: "changes so far" }
        for h in hist {
          Row {
            gap: 8
            Text { text: h.discarded == true ? "×" : "›"; color: h.discarded == true ? muted : green; width: 12 }
            Text { text: lower(replace(first(lines(h.prompt)), "Change this Android app (read AGENTS.md first): ", "")); style: small; color: h.discarded == true ? muted : foreground; weight: 1; maxLines: 2 }
            Text { text: h.discarded == true ? "undone" : lower(fmtTime(h.t, "MMM d")); style: small; color: muted; width: 56; align: end; maxLines: 1 }
          }
        }
      }
    }
  }

  // 2.16: Publish points to the Advanced play page; the step-by-step checklist replaces it in 2.16.3.
  component PublishCard {
    // Personal accounts made after Nov 13, 2023 go live only after a 14-day closed test with 12 testers.
    let canLive = play.personal == false || sapp.play.production == true
    Column {
      gap: 10
      Section { name: "publish" }
      Text { text: sstate == "live" ? "live on google play" : sstate == "testers" ? "your testers have it" : "put it on google play"; color: sstate == "live" || sstate == "testers" ? green : foreground }
      Text { text: sstate == "live" ? "everyone can install it from google play." : sstate == "testers" ? (canLive ? "version ${sapp.play.vn ?? ""} is with your testers. when they're happy, go live in play console." : "version ${sapp.play.vn ?? ""} is with your testers. before it can go live, google asks for a 14-day test with at least 12 testers.") : "a checklist walks you through it: your google play account, the store page and sending it to testers."; style: small; color: muted }
      Flow {
        gap: 6
        Button { text: sstate == "testers" || sstate == "live" ? "continue ›" : "start ›"; color: accent; onTap: { playSel = sapp.slug; tab = "play"; forceAdv = true; haptic() } }
        if sstate == "testers" && canLive {
          Button { text: "go live in play console"; color: green; onTap: url("https://play.google.com/console") }
        }
      }
    }
  }

  // The rarely needed things for an app, behind "more".
  component MoreCard {
    Column {
      gap: 8
      Text { text: showMore ? "less ▴" : "more ▾"; style: small; color: muted; onTap: showMore = !showMore }
      if showMore {
        Flow {
          gap: 6
          if sapp.apk != null {
            Button { text: "download"; onTap: { out = ""; out = run("~/.local/bin/apk-maker download ${sh(sapp.slug)} 2>&1 || echo ✗") } }
          }
          Button { text: "advanced"; onTap: { sel = sapp.slug; tab = "apps"; forceAdv = true } }
          if !sworking {
            if delSlug == sapp.slug && now - delAt < 5 {
              Button { text: "delete for good?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker delete ${sh(sapp.slug)} 2>&1 || echo ✗"); delSlug = ""; sel = ""; view = "apps" } }
            } else {
              Button { text: "delete"; color: red; onTap: { haptic(); delSlug = sapp.slug; delAt = now } }
            }
          }
        }
      }
    }
  }

  // The home tile in Simple mode: what's being made, then the latest apps with their icons and one
  // action each. As many rows as the tile's height holds; a narrow tile drops the actions.
  component CreateCard {
    Column {
      gap: 8
      Section { name: "new app" }
      Input {
        text: draft
        placeholder: missing ? "getting ready… you can type already" : "what should your app do?"
        onChange: draft = value
        onSubmit: {
          out = ""
          out = run(canGo ? "~/.local/bin/apk-maker new ${sh(agent)} ${sh(trim(draft))} 2>&1 || echo ✗" : trim(draft) == "" ? "true" : "echo ${sh(blockMsg)}; echo ✗")
          view = canGo ? "app" : view
          sel = canGo ? "" : sel
          appStep = ""
          draft = canGo ? "" : draft
        }
      }
      if trim(draft) == "" {
        Grid {
          columns: 2
          gap: 6
          for e in ideas {
            Text { text: "› ${e}"; style: small; maxLines: 1; padding: [8, 6]; border: 1; borderColor: alpha(accent, 0.4); color: accent; onTap: { draft = e; haptic() } }
          }
        }
      } else {
        Button {
          text: canGo ? "make it ›" : busy ? "wait for the app being made" : missing ? "getting ready…" : blockMsg
          color: canGo ? accent : muted
          fill: width
          onTap: { haptic(); out = ""; out = run(canGo ? "~/.local/bin/apk-maker new ${sh(agent)} ${sh(trim(draft))} 2>&1 || echo ✗" : "echo ${sh(blockMsg)}; echo ✗"); view = canGo ? "app" : view; sel = canGo ? "" : sel; appStep = ""; draft = canGo ? "" : draft }
        }
      }
    }
  }

  // The skills library: one entry per skill, opened for its ideas; an idea starts a new app from it.
  component SkillEntry(k) {
    let open = skillOpen == k.name
    let n = len(k.apps ?? [])
    Column {
      gap: 4
      Row {
        gap: 8
        align: center
        onTap: { skillOpen = open ? "" : k.name; haptic() }
        Text { text: k.on ? "●" : "○"; color: k.on ? green : muted; width: 14 }
        Text { text: k.title ?? k.name; color: k.on ? accent : muted; bold: true; weight: 1; maxLines: 1 }
        Text { text: n == 0 ? "" : n == 1 ? "1 app" : "${n} apps"; style: small; color: muted; width: 64; align: end; maxLines: 1 }
        Text { text: open ? "▴" : "▾"; style: small; color: muted; width: 16; align: end }
      }
      Text { text: k.blurb ?? ""; style: small; color: k.on ? foreground : muted; maxLines: open ? 4 : 2; padding: [22, 0, 0, 0] }
      if open {
        Column {
          gap: 6
          padding: [22, 4, 0, 4]
          Row { gap: 8; Text { text: "uses"; style: small; color: accent; width: 52 }  Text { text: join(k.libs ?? [], " · "); style: small; color: cyan; weight: 1; maxLines: 2 } }
          if n > 0 {
            Row { gap: 8; Text { text: "in"; style: small; color: accent; width: 52 }  Text { text: lower(join(k.apps, ", ")); style: small; weight: 1; maxLines: 2 } }
          }
          for idea in (k.ideas ?? []) {
            Text { text: "› make ${idea}"; style: small; maxLines: 2; padding: [8, 6]; border: 1; borderColor: alpha(accent, 0.4); color: accent; onTap: { draft = idea; view = "apps"; skillOpen = ""; haptic() } }
          }
          Row {
            gap: 8
            align: center
            Text { text: k.tool == true ? "a tool the ai helper uses to check every app" : k.on ? "the ai helper gets this skill" : "switched off: the ai helper doesn't get it"; style: small; color: muted; weight: 1; maxLines: 2 }
            Button { text: k.on ? "turn off" : "turn on"; color: k.on ? muted : green; onTap: { haptic(); run("~/.local/bin/apk-maker skill ${sh(k.name)} ${sh(k.on ? "off" : "on")} >/dev/null 2>&1") } }
          }
        }
      }
      Rule { }
    }
  }

  component SkillsView {
    let on = len((skills ?? []).filter(k => k.on))
    Column {
      gap: 10
      weight: 1
      scroll: true
      Text { text: "what the ai helper knows how to build. each skill is a tested guide with working code, checked with every library on this phone before a release."; style: small; color: muted }
      Row {
        gap: 8
        Text { text: "skills"; color: accent; width: 84 }
        Text { text: "${on} on · ${len(skills ?? []) - on} off"; weight: 1; maxLines: 1 }
      }
      Section { name: "library" }
      if skills == null || len(skills) == 0 {
        Text { text: "the library arrives with the next backend install."; style: small; color: muted }
      }
      for k in (skills ?? []) key k.name {
        SkillEntry { k: k }
      }
    }
  }

  component SimpleView {
    Column {
      gap: 12
      fill: true
      padding: [12, 4]

      // Header, as a path: apk-maker › fairshare. Tapping apk-maker goes back to the list.
      Row {
        gap: 0
        align: center
        Text { text: "apk-maker"; bold: true; color: accent; maxLines: 1; width: 86; onTap: { view = "apps"; appStep = ""; showMore = false } }
        Text { text: view == "app" && sapp != null ? " › ${lower(sapp.label ?? sapp.slug)}" : view == "settings" ? " › settings" : view == "skills" ? " › skills" : " › my apps"; color: muted; weight: 1; maxLines: 1 }
        if view != "settings" {
          Text { text: "settings"; style: small; color: muted; width: 72; align: end; maxLines: 1; padding: [0, 6]; onTap: view = "settings" }
        }
      }
      // Omarchy's colour swatches, like fastfetch's.
      Row {
        gap: 4
        for c in [red, green, yellow, blue, magenta, cyan] {
          Spacer { width: 14; height: 6; background: c }
        }
      }

      if trim(out ?? "") != "" {
        Banner { }
      }
      if needAuth && view != "app" {
        Notice { msg: "the ai helper isn't signed in. sign in, then try again."; c: yellow; action: "sign in"; go: "login" }
      }
      if locked {
        Notice { msg: "${lower(jname ?? "")}: ${job.msg ?? "unlock to finish"}."; c: yellow; action: "unlock"; go: "unlock" }
      }
      if missing && view != "settings" {
        SetupCard { }
      }

      if view == "apps" || view == "new" || (view == "app" && sapp == null) {
        Column {
          gap: 12
          weight: 1
          scroll: true
          if busy {
            MakingCard { }
          } else {
            CreateCard { }
          }
          Text { text: "› browse the skills library (${len(skills ?? [])} skills)"; style: small; color: accent; onTap: { view = "skills"; haptic() } }
          if len(list) > 0 {
            Section { name: "your apps · ${len(list)}" }
          }
          for a in list.take(30) key a.slug {
            AppCard { a: a }
          }
          if len(list) == 0 {
            Text { text: "your apps show up here."; style: small; color: muted }
          }
        }
      }

      if view == "app" && sapp != null {
        Column {
          gap: 14
          weight: 1
          scroll: true
          Row {
            gap: 14
            align: center
            AppIcon { a: sapp; s: 72 }
            Column {
              weight: 1
              gap: 3
              Text { text: lower(sapp.label ?? sapp.slug); style: title; color: foreground; maxLines: 1 }
              StatusWord { a: sapp }
              Text { text: sapp.pkg; style: small; color: muted; maxLines: 1 }
            }
          }
          Column {
            gap: 2
            Fact { k: "made"; v: lower(fmtTime(sapp.created, "MMM d, yyyy")) }
            Fact { k: "changes"; v: "${max(len(sapp.history ?? []) - 1, 0)}" }
            if sapp.play.vn != null {
              Fact { k: "version"; v: sapp.play.vn }
            }
            Fact { k: "ai helper"; v: sapp.agent ?? agent }
            let used = unique(flatten((sapp.history ?? []).map(h => h.skills ?? [])))
            if len(used) > 0 {
              Fact { k: "skills"; v: join(used, ", "); c: cyan }
            }
          }
          Evidence { a: sapp }
          StepBar { }
          if curStep == "describe" {
            Column {
              gap: 8
              Section { name: "your idea" }
              Idea { p: first(sapp.history ?? []).prompt ?? "" }
            }
          }
          if curStep == "try" {
            TryCard { }
          }
          if curStep == "improve" {
            ImproveCard { }
          }
          if curStep == "publish" {
            PublishCard { }
          }
          MoreCard { }
        }
      }

      if view == "skills" {
        SkillsView { }
      }

      if view == "settings" {
        Column {
          gap: 12
          weight: 1
          scroll: true
          if missing {
            SetupCard { full: true }
          }
          Section { name: "view" }
          Row {
            gap: 6
            for m in ["simple", "advanced"] {
              let on = (m == "advanced") == (settings.mode == "advanced")
              Text { text: m; weight: 1; align: center; maxLines: 1; padding: [0, 6]; color: on ? background : foreground; background: on ? accent : alpha(surface, 0.0); border: 1; borderColor: on ? accent : border; onTap: { haptic(); run("~/.local/bin/apk-maker set mode ${sh(m)}") } }
            }
          }
          Text { text: "simple shows your apps and the next step for each. advanced shows everything: logs, change review, versions, github and google play details."; style: small; color: muted }
          Text { text: isolation == null ? "Checking agent isolation…" : trim(isolation) == "isolated" ? "Agent filesystem isolation is available." : "This phone cannot isolate agent file access. Compatibility mode uses your user account; require isolation to block agent runs on this device."; style: small; color: trim(isolation ?? "") == "isolated" ? muted : yellow }
          Flow { gap: 6
            Button { text: "require isolation"; onTap: { out = run("~/.local/bin/apk-maker set agentIsolation required 2>&1") } }
            Button { text: "compatibility mode"; onTap: { out = run("~/.local/bin/apk-maker set agentIsolation compatible 2>&1") } }
            Button { text: "job history"; onTap: terminal("~/.local/bin/apk-maker history | less; exec bash", "APK Maker history") }
          }

          Section { name: "ai helper" }
          Agents { }
          Text { text: "writes and fixes your apps. install more from the launcher's agents page."; style: small; color: muted }
          Section { name: "skills" }
          Row { gap: 8; onTap: { view = "skills"; haptic() }; Text { text: "library"; color: accent; weight: 1 }  Text { text: "${len((skills ?? []).filter(k => k.on))} on ›"; style: small; color: green; width: 96; align: end } }
          Section { name: "connections" }
          for c in [["phone install", connected, "setup"], ["google play", pconn, "play"], ["github backup", gacct != null, "setup"]] {
            Row {
              gap: 8
              align: center
              onTap: { tab = c[2]; forceAdv = true }
              Text { text: c[0]; color: accent; weight: 1; maxLines: 1 }
              Text { text: c[1] ? "● on" : "○ set up ›"; style: small; color: c[1] ? green : muted; width: 96; align: end; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  on agent { run("~/.local/bin/apk-maker set agent ${sh(value)} >/dev/null 2>&1") }

    if !advanced {
      SimpleView { }
    } else {
    Column {
      gap: 8
      fill: true
      padding: 4

      Row {
        gap: 6
        align: center
        // Back to Simple: just this time (opened from Simple), or for good (Advanced chosen in settings).
        Text { text: "← simple"; style: small; color: accent; maxLines: 1; onTap: { forceAdv = false; haptic(); run(settings.mode == "advanced" ? "~/.local/bin/apk-maker set mode simple >/dev/null 2>&1" : "true") } }
        for t in ["job", "apps", "new", "setup", "play"] {
          Text {
            text: t
            weight: 1
            align: center
            maxLines: 1
            padding: [0, 6]
            radius: 10 * corners
            color: tab == t ? background : foreground
            background: tab == t ? accent : surface
            onTap: { tab = t; haptic() }
          }
        }
        if !missing {
          Dot { c: connected ? green : muted }
          Text { text: connected ? "adb" : "no adb"; style: small; color: muted; width: 52; align: end; maxLines: 1 }
        }
      }

      if trim(out ?? "") != "" {
        Banner { }
      }

      if missing && tab != "setup" {
        SetupCard { }
      }
      if !missing && len(problems) > 0 && tab != "setup" {
        Notice { msg: "can't build yet: ${join(problems, ", ")}"; c: orange; action: "details" }
      }
      if needAuth {
        Notice { msg: "${jagent} isn't logged in. Log in, then retry."; c: yellow; action: "log in"; go: "login" }
      }
      if locked {
        Notice { msg: "${jname}: ${job.msg ?? "unlock to finish"}. Your passphrase is asked in a terminal, and nothing else runs while the keys are open."; c: yellow; action: "unlock"; go: "unlock" }
      }

      if tab == "job" {
        if job.phase == null {
          Column {
            gap: 8
            weight: 1
            justify: center
            align: center
            Text { text: "no build yet"; style: title; color: muted }
            Text { text: "describe an app and an agent builds it"; style: small; color: muted; align: center }
            Button { text: "new app"; color: accent; onTap: tab = "new" }
          }
        } else {
          Row {
            align: center
            gap: 8
            Dot { c: tint }
            Text { text: "${jname} · ${jagent}"; bold: true; maxLines: 1; weight: 1 }
            Text { text: phaseText; color: tint; width: 110; align: end; maxLines: 1 }
          }
          Steps { }
          if stalled {
            Text { text: "the worker stopped without finishing: retry, or stop to clear it"; style: small; color: orange }
          }
          if job.updated != null {
            Text { text: elapsed != null ? "running ${fmtDuration(elapsed)} · updated ${fmtTime(job.updated, "HH:mm:ss")}" : "${job.msg ?? ""} · ${fmtTime(job.updated, "MMM d HH:mm")}"; style: small; color: muted; maxLines: 2 }
          }
          if job.prompt != null {
            Idea { p: job.prompt }
          }
          if showErr {
            Column {
              gap: 2
              padding: 8
              radius: 8 * corners
              background: alpha(red, 0.12)
              border: 1
              borderColor: red
              Text { text: "build error"; style: label; color: red }
              Text { text: errTail; font: mono; fontSize: 10; color: red; maxLines: 3 }
            }
          }
          if !busy && cur.pending != null {
            Review { a: cur }
          }
          Column {
            gap: 1
            weight: 1
            scroll: true
            padding: 8
            background: surface
            radius: 8 * corners
            Text { text: len(logLines) == 0 ? "no log yet" : "log · newest first"; style: label; color: muted }
            for l in recent {
              Text {
                text: l
                font: mono
                fontSize: 10
                color: startsWith(l, "==") ? accent : startsWith(l, "→") ? cyan : contains(l, "error:") || contains(l, "ERROR") || startsWith(l, "e: ") || contains(l, "FAILURE") || contains(l, "What went wrong") ? red : foreground
              }
            }
          }
          Row {
            gap: 8
            align: center
            if busy {
              Next { showLog: false; weight: 1 }
              Button { text: "live log"; onTap: terminal("tail -f ~/.cache/apk-maker/log.txt", "log") }
            } else {
              if cur != null {
                Actions { a: cur; weight: 1 }
              } else {
                Spacer { weight: 1 }
              }
            }
            Button { text: "copy log"; onTap: copy(log ?? "") }
          }
        }
      }

      if tab == "apps" {
        Column {
          gap: 8
          weight: 1
          scroll: true
          if len(list) == 0 {
            Text { text: "no apps yet: describe one on the new tab"; color: muted }
            Button { text: "new app"; color: accent; onTap: tab = "new" }
          } else {
            if len(list) > 4 {
              Input { text: search; placeholder: "filter apps…"; onChange: search = value }
            }
            if len(shown) == 0 {
              Text { text: "no app matches “${search}”"; style: small; color: muted }
            }
            for a in shown key a.slug {
              Column {
                gap: 6
                padding: 8
                radius: 8 * corners
                background: picked.slug == a.slug ? surface : alpha(surface, 0.0)
                border: 1
                borderColor: picked.slug == a.slug ? accent : border
                onTap: sel = a.slug
                Row {
                  align: center
                  gap: 8
                  Image { src: "app:${a.pkg}"; size: 24; visible: a.status == "installed" }
                  Text { text: a.label ?? a.slug; bold: true; maxLines: 1; weight: 1 }
                  Pill { s: a.status == "building" && !(busy && a.slug == job.slug) ? "stalled" : a.pending != null && a.pending.built == true && a.status != "building" ? "review" : a.status }
                }
                Text { text: "${a.agent ?? "?"} · ${len(a.history ?? [])} runs · ${fmtTime(a.updated, "MMM d HH:mm")}"; style: small; color: muted; maxLines: 1 }
                if picked.slug != a.slug {
                  GhLine { a: a }
                }
                if picked.slug == a.slug {
                  let hist = last(a.history ?? [])
                  if hist.prompt != null {
                    Idea { p: first(a.history ?? []).prompt ?? hist.prompt }
                  }
                  if a.pending != null {
                    Review { a: a }
                  }
                  Evidence { a: a }
                  Actions { a: a }
                  GitHubRow { a: a }
                  Input {
                    text: change
                    placeholder: busy ? "wait for ${jname}…" : a.pending != null ? "accept or discard the change first" : "ask ${agent} to change it…"
                    onChange: change = value
                    onSubmit: {
                      out = ""
                      out = run(canStart && a.pending == null && trim(change) != "" ? "~/.local/bin/apk-maker change ${sh(a.slug)} ${sh(agent)} ${sh(trim(change))} 2>&1 || echo ✗" : trim(change) == "" ? "true" : "echo ${sh(blockMsg)}; echo ✗")
                      tab = canStart && a.pending == null && trim(change) != "" ? "job" : tab
                      change = canStart && a.pending == null && trim(change) != "" ? "" : change
                    }
                  }
                }
              }
            }
          }
        }
      }

      if tab == "new" {
        Column {
          gap: 8
          weight: 1
          scroll: true
          Text { text: "Describe an app in a sentence. The agent writes it, Gradle builds it, and it installs on this phone."; style: small; color: muted }
          if busy {
            Notice { msg: "${jname} is still building. Wait for it, or stop it on the job tab."; c: orange }
          }
          NewInput { focusIt: tab == "new" && !busy && !missing }
          Text { text: "agent"; style: label; color: muted }
          Agents { }
          Text { text: "or start from an idea"; style: label; color: muted }
          Grid {
            columns: 2
            gap: 6
            for e in ideas {
              Text {
                text: e
                style: small
                align: center
                maxLines: 1
                padding: [8, 6]
                radius: 8 * corners
                border: 1
                borderColor: draft == e ? accent : border
                color: draft == e ? accent : foreground
                onTap: { draft = e; haptic() }
              }
            }
          }
          if trim(draft) != "" {
            Button {
              text: canStart ? "build “${draft}” with ${agent}" : busy ? "wait for the current build" : "can't build yet"
              color: canStart ? accent : muted
              onTap: { haptic(); out = ""; out = run(canGo ? "~/.local/bin/apk-maker new ${sh(agent)} ${sh(trim(draft))} 2>&1 || echo ✗" : "echo ${sh(blockMsg)}; echo ✗"); sel = canGo ? "" : sel; tab = canGo ? "job" : tab; draft = canGo ? "" : draft }
            }
          }
        }
      }

      if tab == "setup" {
        Column {
          gap: 8
          weight: 1
          scroll: true
          Text { text: "1 · build tools"; style: label; color: muted }
          if missing {
            SetupCard { full: true }
          } else {
            if len(problems) == 0 {
              Row { gap: 6; align: center; Dot { c: green }  Text { text: "ready to build · agents: ${join(have, ", ")}"; style: small; weight: 1 } }
            } else {
              for p in problems {
                Row { gap: 6; align: center; Dot { c: orange }  Text { text: p; style: small; color: orange; weight: 1 } }
              }
            }
          }
          Text { text: "APK Maker installs its scripts in ~/.local/share/apk-maker, then the Android SDK (unless one is already there), the Gradle wrapper and the libraries a first build needs. Apps go in ~/apps."; style: small; color: muted }
          if stage != "ready" && len(slogLines) > 0 {
            Column {
              gap: 1
              padding: 8
              background: surface
              radius: 8 * corners
              Text { text: "setup log · newest first"; style: label; color: muted }
              for l in slogLines {
                Text { text: l; font: mono; fontSize: 10; maxLines: 2; color: startsWith(l, "==") ? accent : contains(l, "error") || contains(l, "fail") ? red : foreground }
              }
            }
          }
          Flow {
            gap: 6
            Button { text: "check again"; onTap: refresh() }
            Button { text: "reinstall"; onTap: { haptic(); installRun = installRun + 1 } }
          }

          Text { text: "2 · install over adb (optional)"; style: label; color: muted }
          Text { text: connected ? "adb is connected (${words(adbs)[1]}): apps install and open by themselves." : "Without adb, finished apps download in the browser and you install them from there. With adb they install and open by themselves. Set it up once:"; style: small }
          if !connected {
            Text { text: "a. Settings › About phone › Software information: tap Build number 7 times."; style: small; color: muted }
            Text { text: "b. Developer options: turn on Wireless debugging (on Wi‑Fi)."; style: small; color: muted }
            Text { text: "c. Open Settings in pop-up view so this stays visible, tap Pair device with pairing code, and enter the port (after the colon) and the code:"; style: small; color: muted }
            Button { text: "open settings"; onTap: androidApp("com.android.settings") }
            Row {
              gap: 6
              Input { text: pairPort; placeholder: "pair port"; weight: 1; focus: tab == "setup" && !connected && !missing; onChange: pairPort = value }
              Input { text: pairCode; placeholder: "code"; weight: 1; onChange: pairCode = value }
              Button {
                text: "pair"
                color: trim(pairPort) != "" && trim(pairCode) != "" ? accent : muted
                onTap: { out = ""; out = run("[ -n ${sh(trim(pairPort))} ] && [ -n ${sh(trim(pairCode))} ] && ~/.local/bin/apk-maker pair ${sh(trim(pairPort))} ${sh(trim(pairCode))} 2>&1 || echo ✗") }
              }
            }
            Text { text: "d. Then the port under IP address & port on the Wireless debugging screen:"; style: small; color: muted }
            Row {
              gap: 6
              Input { text: connPort; placeholder: "port"; weight: 1; onChange: connPort = value }
              Button { text: "connect"; color: trim(connPort) != "" ? accent : muted; onTap: { out = ""; out = run("[ -n ${sh(trim(connPort))} ] && ~/.local/bin/apk-maker connect ${sh(trim(connPort))} 2>&1 && echo connected || echo ✗") } }
            }
            Text { text: "After a reboot only step d is needed, and APK Maker tries it on its own."; style: small; color: muted }
          }

          Text { text: "3 · GitHub (optional)"; style: label; color: muted }
          Row {
            gap: 6
            align: center
            Dot { c: gacct != null ? green : gconn ? yellow : muted }
            Text { text: gacct != null ? "new apps go to ${gacct}" : gconn ? "signed in on this phone as ${join(gnames, ", ")}: not used until you pick an account" : gh.state == "missing" ? "the GitHub CLI isn't installed: install the github-cli package, then check" : "not connected"; style: small; weight: 1; maxLines: 2 }
          }
          if gh.msg != null && gh.msg != "" {
            Text { text: gh.msg; style: small; color: yellow }
          }
          // One card per GitHub login on this phone: use it, stop using it, or sign the phone out of it.
          if gconn {
            Text { text: gacct == null ? "Tap \"use for new apps\" on an account to let APK Maker save your apps' code there. Until then it doesn't touch any account." : "Apps already on GitHub keep syncing with the account they're on; new apps go to the one marked \"new apps go here\"."; style: small }
            for l in gnames key l {
              GhAccount { l: l }
            }
            Text { text: "\"Stop using\": APK Maker stops sending changes to that account and checking it for merged changes, but the phone stays signed in. \"Sign out\": this phone forgets the GitHub login, so other tools here that use GitHub (such as the coding agents) lose it too. Either way nothing is deleted: your apps stay on this phone and their copies on GitHub stay as they are."; style: small; color: muted }
          }
          if gacct != null {
            Text { text: gh.auto != false ? "\"Save new apps to GitHub\" is on: each new app is saved privately to ${gacct} right after its first build. Tap it to keep new apps only on this phone; you can still put one on GitHub later from its page." : "\"Save new apps to GitHub\" is off: new apps stay only on this phone until you tap \"put on GitHub\" on an app's page. Tap it to save every new app to GitHub on its own."; style: small }
          }
          Flow {
            gap: 6
            if !gconn {
              if gh.state != "missing" {
                Button { text: "connect GitHub"; color: accent; onTap: terminal("~/.local/bin/apk-maker github add && echo 'Connected: go back to APK Maker.'; exec bash", "GitHub") }
              }
            } else {
              Button { text: "add another account"; onTap: terminal("~/.local/bin/apk-maker github add && echo 'Done: go back to APK Maker.'; exec bash", "GitHub") }
              if gacct != null {
                Button { text: gh.auto != false ? "save new apps to GitHub ✓" : "save new apps to GitHub"; color: gh.auto != false ? green : foreground; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker github auto ${sh(gh.auto != false ? "off" : "on")} 2>&1 || echo ✗") } }
              }
            }
            Button { text: "check"; onTap: { out = ""; out = run("~/.local/bin/apk-maker github status >/dev/null 2>&1; true") } }
          }
        }
      }

      // Google Play: connect the account once, then per app prepare → first upload by hand →
      // app content by hand → uploads over the API, and the closed test new personal accounts need.
      if tab == "play" {
        Column {
          gap: 8
          weight: 1
          scroll: true

          Text { text: "1 · Google Play account"; style: label; color: muted }
          Row {
            gap: 6
            align: center
            Dot { c: pconn ? green : pstate == "error" ? red : pstate == "waiting" || pstate == "checking" ? accent : muted }
            Text { text: pconn ? "connected · ${play.email}" : pstate == "error" ? "not connected: ${play.msg ?? ""}" : pstate == "waiting" ? "waiting for the key file in the browser…" : pstate == "checking" ? "checking the key with Google…" : "not connected"; style: small; weight: 1; maxLines: 3; color: pstate == "error" ? red : foreground }
          }
          Row {
            gap: 6
            for o in ["personal", "organization"] {
              let on = (o == "personal") == personal
              Text {
                text: o == "personal" ? "personal account" : "organization account"
                style: small
                align: center
                maxLines: 1
                weight: 1
                padding: [6, 4]
                radius: 8 * corners
                border: 1
                borderColor: on ? accent : border
                color: on ? background : foreground
                background: on ? accent : alpha(surface, 0.0)
                onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker play set personal ${sh(o == "personal" ? "yes" : "no")} 2>&1 || echo ✗") }
              }
            }
          }
          Text { text: personal ? "Personal accounts made after Nov 13, 2023 need a closed test with 12 testers for 14 days before an app can go to production: step 7 helps with it." : "Organization accounts (and older personal ones) can go to production right away."; style: small; color: muted }
          if !pconn {
            Text { text: "a. Make a Google Play developer account: US$25 once, plus an ID check that can take a few days."; style: small }
            Flow { gap: 6; Button { text: "sign up"; onTap: url("https://play.google.com/console/signup") } }
            Text { text: "b. In Google Cloud, make a project (any name), then turn on the Google Play Android Developer API in it."; style: small }
            Flow { gap: 6; Button { text: "open the API page"; onTap: url("https://console.cloud.google.com/apis/library/androidpublisher.googleapis.com") } }
            Text { text: "c. IAM › Service accounts › Create service account: a name is enough, skip the roles. Open it › Keys › Add key › Create new key › JSON. The key downloads to this phone."; style: small }
            Flow { gap: 6; Button { text: "service accounts"; onTap: url("https://console.cloud.google.com/iam-admin/serviceaccounts") } }
            Text { text: "d. Give the key to APK Maker: a page opens in the browser to pick it. It stays on this phone."; style: small }
            Flow {
              gap: 6
              if keyState == "locked" {
                Button { text: "connect key"; color: accent; onTap: terminal("~/.local/bin/apk-maker play connect; echo; read -rp 'Press Enter to close. ' _", "Google Play") }
              } else {
                Button { text: "connect key"; color: accent; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker play connect 2>&1 || echo ✗") } }
              }
            }
          } else {
            // Testing tracks only: a stolen key can't reach the public, and going live stays a tap in Play Console.
            Text { text: "e. Play Console › Users and permissions › Invite new users: paste this email and tick only Release apps to testing tracks, Manage testing tracks and Manage store presence. Leave Release to production off: then this key can only reach your testers, and you go live yourself with one tap in Play Console. It can take a few minutes to apply."; style: small }
            Flow {
              gap: 6
              Button { text: "copy email"; onTap: copy(play.email ?? "") }
              Button { text: "users and permissions"; onTap: url("https://play.google.com/console/users-and-permissions") }
              if keyState == "locked" {
                Button { text: "check"; onTap: terminal("~/.local/bin/apk-maker play status; echo; read -rp 'Press Enter to close. ' _", "Google Play") }
              } else {
                Button { text: "check"; onTap: { out = ""; out = run("~/.local/bin/apk-maker play status >/dev/null 2>&1; true") } }
              }
              if now - discAt < 5 {
                Button { text: "really disconnect?"; color: red; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker play disconnect 2>&1 || echo ✗"); discAt = 0 } }
              } else {
                Button { text: "disconnect"; color: red; onTap: discAt = now }
              }
            }
            Row {
              gap: 6
              Input { text: contactDraft; placeholder: play.contact ?? "contact email for your store listings"; weight: 1; onChange: contactDraft = value }
              Button { text: "save"; color: trim(contactDraft) != "" ? accent : muted; onTap: { out = ""; out = run("[ -n ${sh(trim(contactDraft))} ] && ~/.local/bin/apk-maker play set contact ${sh(trim(contactDraft))} 2>&1 && echo saved || echo ✗"); contactDraft = "" } }
            }
          }

          Text { text: "2 · app"; style: label; color: muted }
          if papp == null {
            Text { text: "Build an app first: Play takes the apps that build here."; style: small; color: muted }
          } else {
            Grid {
              columns: 3
              gap: 6
              for a in builtApps.take(16) key a.slug {
                Text {
                  text: a.label ?? a.slug
                  style: small
                  maxLines: 1
                  padding: [6, 4]
                  radius: 8 * corners
                  border: 1
                  borderColor: a.slug == papp.slug ? accent : border
                  color: a.slug == papp.slug ? background : foreground
                  background: a.slug == papp.slug ? accent : alpha(surface, 0.0)
                  onTap: { playSel = a.slug; haptic() }
                }
              }
            }
            Row {
              gap: 8
              align: center
              Image { src: "app:${papp.pkg}"; size: 32; visible: papp.status == "installed" }
              Column {
                weight: 1
                Text { text: pp.title ?? papp.label ?? papp.slug; bold: true; maxLines: 1 }
                Text { text: "${papp.pkg}${pp.vn != null ? " · version ${pp.vn} (${pp.vc})" : ""}"; style: small; font: mono; color: muted; maxLines: 1 }
              }
            }
            if !onPlay {
              Text { text: "Its package name ${papp.pkg} can't change once it's on Play."; style: small; color: muted }
            }

            if papp.pending != null {
              Notice { msg: "A change is waiting for you: accept or discard it first (apps tab). Play gets the accepted version."; c: cyan }
            }
            PStep { n: 3; title: "prepare it"; done: prepared }
            Text { text: prepared ? "${fmtTime(pp.prepared, "MMM d HH:mm")} · listing${pp.category != null ? " (${pp.category})" : ""} · ${pp.icon == true ? "icon · " : ""}${pp.feature == true ? "feature graphic · " : ""}${shots} screenshots · signed .aab" : "${agent} writes the store listing and a privacy policy. Then APK Maker targets Android 16, makes the app's own upload key, builds a signed .aab, and draws the icon and feature graphic (with adb, it also opens the app and takes screenshots)."; style: small; color: muted }
            if prepared && shots < 2 {
              Text { text: connected ? "Fewer than 2 screenshots: Play needs 2. Prepare again, and leave the phone alone while the app opens." : "Play needs 2 screenshots: connect adb on the setup tab and prepare again, or add them in Play Console."; style: small; color: yellow }
            }
            if stale {
              Text { text: "The app changed since it was prepared: uploading builds the new code first. Prepare a new version to also redo the listing and screenshots."; style: small; color: yellow }
            }
            if prepared && pp.backedUp == null {
              Text { text: "Back up the upload key: every update has to be signed with it."; style: small; color: yellow }
            }
            // Backups before 2.14 held the key and its password as plain text.
            if prepared && pp.backedUp != null && pp.backupV != 2 {
              Text { text: "Your earlier key backup isn't encrypted: make a new one, then delete the old file from Downloads."; style: small; color: yellow }
            }
            Flow {
              gap: 6
              Button { text: prepared ? "prepare a new version" : "prepare"; color: accent; onTap: { haptic(); out = ""; out = run(canStart ? "~/.local/bin/apk-maker play prepare ${sh(papp.slug)} ${sh(agent)} 2>&1 || echo ✗" : "echo ${sh(blockMsg)}; echo ✗"); tab = canStart ? "job" : tab } }
              if prepared {
                Button { text: "edit listing"; onTap: terminal("nano ~/apps/${sh(papp.slug)}/play/listing.json", "listing") }
                Button { text: "rewrite listing"; onTap: { haptic(); out = ""; out = run(canStart ? "~/.local/bin/apk-maker play prepare ${sh(papp.slug)} ${sh(agent)} listing 2>&1 || echo ✗" : "echo ${sh(blockMsg)}; echo ✗"); tab = canStart ? "job" : tab } }
                // The passphrase is typed in a terminal, where it doesn't show and never lands on a command line.
                Button { text: "back up key"; color: pp.backedUp == null ? yellow : foreground; onTap: terminal("~/.local/bin/apk-maker play backup ${sh(papp.slug)}; echo; read -rp 'Press Enter to close. ' _", "key backup") }
              }
            }

            PStep { n: 4; title: "put it on Play (once, by hand)"; done: onPlay }
            if onPlay {
              Text { text: "It's on Google Play: uploads now go through the API."; style: small; color: muted }
            } else {
              Text { text: "Play learns a new app's package name from its first upload, so that one is by hand:"; style: small }
              Text { text: "a. Play Console › Create app: name, default language, App, Free; accept the declarations."; style: small; color: muted }
              Text { text: "b. Test and release › Testing › Internal testing › Create new release. Keep Google's app signing, upload ${papp.slug}.aab from Downloads, then Next › Save."; style: small; color: muted }
              Text { text: "c. Tap check: after that APK Maker uploads by itself."; style: small; color: muted }
              Flow {
                gap: 6
                Button { text: "download .aab"; color: prepared ? foreground : muted; onTap: { out = ""; out = run(prepared ? "~/.local/bin/apk-maker play aab ${sh(papp.slug)} 2>&1 || echo ✗" : "echo prepare it first: step 3; echo ✗") } }
                Button { text: "Play Console"; onTap: url("https://play.google.com/console") }
                if keyState == "locked" {
                  Button { text: "check"; color: pconn && prepared ? accent : muted; onTap: terminal(pconn ? "~/.local/bin/apk-maker play check ${sh(papp.slug)}; echo; read -rp 'Press Enter to close. ' _" : "echo 'Connect Google Play first (step 1).'; read -rp 'Press Enter to close. ' _", "Google Play") }
                } else {
                  Button { text: "check"; color: pconn && prepared ? accent : muted; onTap: { haptic(); out = ""; out = run(pconn ? "~/.local/bin/apk-maker play check ${sh(papp.slug)} 2>&1 || echo ✗" : "echo connect Google Play first: step 1; echo ✗") } }
                }
              }
            }

            PStep { n: 5; title: "app content (once, by hand)"; done: pp.uploaded != null }
            Text { text: "Play Console › Policy and programs › App content: privacy policy, app access, ads, content rating, target audience and data safety${pp.dataCollected == false ? " (the listing says no data leaves the phone)" : ""}. Then Store settings: category${pp.category != null ? " (${pp.category})" : ""} and contact details."; style: small }
            Text { text: "For the privacy policy, share the one the agent wrote into a Google Doc (Share › anyone with the link) or Google Sites, add your email, and paste its link."; style: small; color: muted }
            Flow {
              gap: 6
              Button { text: "share privacy policy"; color: prepared ? foreground : muted; onTap: { out = ""; out = prepared ? "" : "prepare it first: step 3\n✗"; policy = run("cat ~/apps/${sh(papp.slug)}/play/privacy-policy.md 2>/dev/null") } }
              Button { text: "Play Console"; onTap: url("https://play.google.com/console") }
            }

            PStep { n: 6; title: "upload"; done: pp.uploaded != null }
            // What Play shows as "What's new": the agent writes it from the changes, never the requests themselves.
            if prepared {
              Text { text: pp.notes != null && trim(pp.notes) != "" ? "What's new, as Play will show it:\n${trim(pp.notes)}" : "What's new: written for users by the agent when you prepare or upload, from the changes since the last upload"; style: small; color: muted; maxLines: 8 }
              Flow {
                gap: 6
                Button { text: "edit what's new"; onTap: terminal("cd ~/apps/${sh(papp.slug)} && nano ${sh(pp.uploaded != null ? "play/release-notes.txt" : "play/listing.json")}; ~/.local/bin/apk-maker play set ${sh(papp.slug)} notes", "what's new") }
              }
            }
            Row {
              gap: 6
              for t in ["internal", "closed", "production"] {
                let on = track == t
                let locked = t == "production" && !prodOk
                Text {
                  text: t
                  style: small
                  align: center
                  maxLines: 1
                  weight: 1
                  padding: [6, 4]
                  radius: 8 * corners
                  border: 1
                  opacity: locked ? 0.45 : 1
                  borderColor: on ? accent : border
                  color: on ? background : foreground
                  background: on ? accent : alpha(surface, 0.0)
                  onTap: { track = t; haptic() }
                }
              }
            }
            Text { text: track == "internal" ? "Internal testing: up to 100 testers you add by email in Play Console. Available within minutes." : track == "closed" ? "Closed testing: the Google Group in step 7. Google reviews the first release (hours to a few days)." : prodOk ? "Production: everyone on Google Play, after Google's review. With the key set to testing only (step e), go live in Play Console instead: promote your tested release to Production with one tap." : "Production opens once the closed test is done and Google grants access (step 7)."; style: small; color: muted }
            if track == "production" && prodOk {
              Flow { gap: 6; Button { text: "go live in Play Console"; color: green; onTap: url("https://play.google.com/console") } }
            }
            for t in ["internal", "closed", "production"] {
              let r = get(pp.tracks ?? {}, t, null)
              if r != null {
                Text { text: "${t}: ${r.vn} · ${fmtTime(r.at, "MMM d HH:mm")}${r.status == "draft" ? " · draft: roll it out in Play Console" : r.review == true ? " · send for review in Play Console" : ""}"; style: small; color: r.status == "draft" || r.review == true ? yellow : green; maxLines: 2 }
              }
            }
            Text { text: "Review the bundle, listing, screenshots and privacy statements before uploading."; style: small; color: muted }
            Button { text: "review release"; onTap: terminal("~/.local/bin/apk-maker play review ${sh(papp.slug)}; echo; read -rp 'Press Enter to close. ' _", "review release") }
            Text { text: pp.reviewed != null ? "Release review saved; any artifact change requires another review." : "Release review needed"; style: small; color: pp.reviewed != null ? green : yellow }
            Button {
              text: "upload to ${trackLabel}"

              color: canUpload ? accent : muted
              onTap: { haptic(); out = ""; out = run(canUpload ? "~/.local/bin/apk-maker play upload ${sh(papp.slug)} ${sh(track)} 2>&1 || echo ✗" : "echo ${sh(!pconn ? "connect Google Play first: step 1" : !prepared ? "prepare it first: step 3" : !onPlay ? "do the first upload by hand, then check: step 4" : busy ? blockMsg : "production opens after the closed test: step 7")}; echo ✗"); tab = canUpload ? "job" : tab }
            }

            if personal {
              PStep { n: 7; title: "closed test · 12 testers · 14 days"; done: pp.production == true }
              Text { text: "a. Make a Google Group for testers (groups.google.com › Create group; Who can join: Anyone on the web) and save its email here:"; style: small }
              Row {
                gap: 6
                Input { text: groupDraft; placeholder: pp.group ?? "my-app-testers@googlegroups.com"; weight: 1; onChange: groupDraft = value }
                Button { text: "save"; color: trim(groupDraft) != "" ? accent : muted; onTap: { out = ""; out = run("[ -n ${sh(trim(groupDraft))} ] && ~/.local/bin/apk-maker play testers ${sh(papp.slug)} ${sh(trim(groupDraft))} 2>&1 || echo ✗"); groupDraft = "" } }
              }
              Flow { gap: 6; Button { text: "Google Groups"; onTap: url("https://groups.google.com/my-groups") } }
              Text { text: "b. Upload to closed testing (step 6). Once Google approves it, the test runs."; style: small }
              Text { text: "c. Invite at least 12 people (ask for 15 or more: some drop out). They join the group, opt in, and install the app from Play."; style: small }
              Flow {
                gap: 6
                if groupName != "" {
                  Button { text: "invite testers"; color: accent; onTap: share(invite) }
                  Button { text: "copy opt-in link"; onTap: copy("https://play.google.com/apps/testing/${papp.pkg}") }
                } else {
                  Text { text: "save the group's email first (a)"; style: small; color: muted }
                }
              }
              Text { text: "Short of people? Swap with other APK Maker users: the community group becomes a tester of this app, and the app goes on the shared list (below)."; style: small }
              Flow {
                gap: 6
                if listed != null {
                  Text { text: "listed until ${listed.until}"; style: small; color: green }
                } else {
                  Button { text: "ask the community"; color: cyan; onTap: { haptic(); out = ""; out = run("~/.local/bin/apk-maker play ask ${sh(papp.slug)} 2>&1 || echo ✗") } }
                }
              }
              Text { text: "d. Track it. Play Console › Closed testing › Testers shows how many opted in. A tester who leaves loses their days, so ask them to stay 14 days."; style: small }
              Progress { value: min(closedDays, 14); max: 14; height: 4; fill: width; color: testDone ? green : accent; track: alpha(muted, 0.2) }
              Text { text: pp.closedSince == null ? "starts with the first closed-testing upload" : "day ${closedDays} of 14 · ${testers} of 12 testers opted in"; style: small; color: testDone ? green : muted }
              Row {
                gap: 6
                Input { text: testerDraft; placeholder: "testers opted in now"; weight: 1; onChange: testerDraft = value }
                Button { text: "save"; color: trim(testerDraft) != "" ? accent : muted; onTap: { out = ""; out = run("~/.local/bin/apk-maker play set ${sh(papp.slug)} testers ${sh(trim(testerDraft))} 2>&1 || { echo enter a number; echo ✗; }"); testerDraft = "" } }
              }
              Text { text: testDone ? "e. Done: Play Console › Dashboard › Apply for production, then answer the three short forms about your test. Google answers within about a week." : "e. After 14 days with 12 or more testers: apply for production in Play Console's dashboard."; style: small; color: testDone ? green : muted }
              Flow {
                gap: 6
                if testDone {
                  Button { text: "Play Console"; color: accent; onTap: url("https://play.google.com/console") }
                }
                Button { text: pp.production == true ? "production access ✓" : "Google granted production"; color: pp.production == true ? green : foreground; onTap: { out = ""; out = run("~/.local/bin/apk-maker play set ${sh(papp.slug)} production ${sh(pp.production == true ? "no" : "yes")} 2>&1 || echo ✗") } }
              }
            }
          }

          // The tester exchange: test other users' closed tests, so they test yours.
          // Optional extra protection, off by default: the Play key and upload keys behind a passphrase.
          Text { text: "passphrase lock (optional)"; style: label; color: muted }
          Text { text: keyState == "locked" ? "Your Play key and upload keys are locked: signing and uploading ask for your passphrase in a terminal." : "For extra protection you can lock your Play key and upload keys with a passphrase. You'd then type it each time you sign or upload. Most people don't need it when the key is set to testing only (step e)."; style: small; color: muted }
          Flow {
            gap: 6
            if keyState == "locked" {
              Button { text: "change passphrase"; onTap: terminal("~/.local/bin/apk-maker lock passwd; echo; read -rp 'Press Enter to close. ' _", "passphrase") }
              Button { text: "turn the lock off"; onTap: terminal("~/.local/bin/apk-maker lock off; echo; read -rp 'Press Enter to close. ' _", "passphrase") }
            } else {
              if keyState == "plain" {
                Button { text: "lock with a passphrase"; onTap: terminal("~/.local/bin/apk-maker lock; echo; read -rp 'Press Enter to close. ' _", "passphrase") }
              }
            }
          }

          Text { text: "community testers · ${len(capps)} apps"; style: label; color: muted }
          Text { text: "APK Maker users test each other's closed tests. Join the group once with the Google account on this phone. Then, for each app: opt in, install it from Play, keep it 14 days, and really use it (Google asks how testers used an app)."; style: small; color: muted }
          if cgroup == "" {
            Text { text: "The community group is still being set up: check back soon."; style: small; color: yellow }
          }
          Flow {
            gap: 6
            if cgroup != "" {
              Button { text: "join the group"; color: accent; onTap: url(startsWith(community.groupUrl ?? "", "https://groups.google.com/") ? community.groupUrl : "https://groups.google.com") }
            }
            if community.repo != null && community.repo != "" {
              Button { text: "how it works"; onTap: url("https://github.com/${community.repo}#readme") }
            }
            Button { text: "refresh"; onTap: { out = ""; out = run("~/.local/bin/apk-maker play community 2>&1 || echo ✗") } }
          }
          if len(capps) > 0 {
            Text { text: testingN == 0 ? "You aren't testing any yet: about as many as the testers you need is fair." : "You're testing ${testingN}. Keep each one 14 days."; style: small }
          }
          for x in capps.take(30) key x.pkg {
            let since = get(testing ?? {}, x.pkg, null)
            Column {
              gap: 4
              padding: 8
              radius: 8 * corners
              border: 1
              borderColor: since != null ? green : border
              Row {
                gap: 6
                align: center
                Text { text: x.name; bold: true; maxLines: 1; weight: 1 }
                Text { text: since != null ? (now - since >= 14 * 86400 ? "done ✓" : "day ${floor((now - since) / 86400) + 1} of 14") : "until ${x.until}"; style: small; color: since != null ? green : muted; maxLines: 1 }
              }
              Text { text: x.description; style: small; color: muted; maxLines: 3 }
              Flow {
                gap: 6
                Button { text: "opt in"; color: since == null ? accent : foreground; onTap: url("https://play.google.com/apps/testing/${x.pkg}") }
                Button { text: "install"; onTap: url("https://play.google.com/store/apps/details?id=${x.pkg}") }
                Button { text: since != null ? "stop testing" : "I'm testing it"; color: since != null ? muted : green; onTap: { haptic(); out = run("~/.local/bin/apk-maker play testing ${sh(x.pkg)} ${sh(since != null ? "off" : "on")} 2>&1 || echo ✗") } }
              }
            }
          }
        }
      }
    }
    }
}
