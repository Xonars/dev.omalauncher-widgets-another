widget "codex usage" {
  meta { description: "Reads local Codex session events to show remaining 5-hour and weekly limits with reset times"; version: "1.0.1"; license: "MIT"; category: "dev" }
  size: 3x2
  minSize: 3x2

  requires { pacman: ["jq", "findutils", "coreutils", "grep"] }

  asset chatgptLogo = base64""

  // Codex records the current account limits in its session event log.
  source limits = cmd("""
    record=$(find "$HOME/.codex/sessions" -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2- | while IFS= read -r f; do
      line=$(grep '"rate_limits"' "$f" 2>/dev/null | tail -1)
      if [ -n "$line" ]; then printf '%s\n' "$line"; break; fi
    done)
    data=$(printf '%s\n' "$record" | jq -c '.payload.rate_limits // empty' 2>/dev/null)
    if [ -z "$data" ]; then printf '{"ok":false}'; exit 0; fi
    five_used=$(printf '%s' "$data" | jq -r '.primary.used_percent // empty')
    five_reset=$(printf '%s' "$data" | jq -r '.primary.resets_at // empty')
    week_used=$(printf '%s' "$data" | jq -r '.secondary.used_percent // empty')
    week_reset=$(printf '%s' "$data" | jq -r '.secondary.resets_at // empty')
    if [ -z "$five_used" ] || [ -z "$five_reset" ] || [ -z "$week_used" ] || [ -z "$week_reset" ]; then
      printf '{"ok":false}'; exit 0
    fi
    now=$(date +%s)
    window_data() {
      local used=$1 reset=$2 full_format=$3 short_format=$4 tiny_format=${5:-$4}
      if [ "${reset%.*}" -le "$now" ]; then
        printf '0\tfull\tfull\tfull\n'
      else
        printf '%s\t%s\t%s\t%s\n' "$used" \
          "$(date -d "@$reset" "$full_format")" \
          "$(date -d "@$reset" "$short_format")" \
          "$(date -d "@$reset" "$tiny_format")"
      fi
    }
    IFS=$'\t' read -r five_used five_at five_time _ <<< "$(window_data "$five_used" "$five_reset" '+%a, %b %-d · %H:%M' '+%H:%M')"
    IFS=$'\t' read -r week_used week_at week_short week_day <<< "$(window_data "$week_used" "$week_reset" '+%a, %b %-d · %H:%M' '+%b %-d %H:%M' '+%a %H:%M')"
    jq -nc --argjson five_used "$five_used" --argjson week_used "$week_used" \
      --arg five_at "$five_at" --arg five_time "$five_time" --arg week_at "$week_at" --arg week_short "$week_short" --arg week_day "$week_day" \
      '{ok:true, five_used:$five_used, five_at:$five_at, five_time:$five_time, week_used:$week_used, week_at:$week_at, week_short:$week_short, week_day:$week_day}'
  """) every 1m json timeout 15s

  let fiveUsed = limits.ok ? limits.five_used : null
  let weekUsed = limits.ok ? limits.week_used : null
  let compact = cols == null || cols < 3 || rows == null || rows < 3
  let fiveReset = compact ? limits.five_time : limits.five_at
  // A narrow tile (landscape) can't fit the date: the weekday is enough within a week.
  let narrow = tileWidth != null && tileWidth < 170
  let weekReset = !compact ? limits.week_at : narrow && limits.week_day != null ? limits.week_day : limits.week_short

  component LimitDetails(used, reset, compact = false) {
    Column {
      gap: compact ? 1 : 2
      Progress {
        value: used == null ? 0 : 100 - used
        color: accent
        track: alpha(muted, 0.22)
        height: compact ? 4 : 7
        fill: width
        animate value: spring()
      }
      Text {
        text: reset == null ? "waiting for Codex data" : reset == "full" ? "full" : "resets ${reset}"
        style: small
        color: foreground
        maxLines: 1
      }
    }
  }

  component Limit(label, used, reset, mark = false) {
    Column {
      gap: 2
      Row {
        gap: 4
        align: center
        if mark {
          Image { src: chatgptLogo; width: 16; height: 16; tint: accent }
        }
        Text { text: label; fontSize: 18; font: mono; color: foreground; width: 100; bold: true }
        Text { text: used == null ? "—" : "${round(100 - used)}%"; style: body; color: foreground; align: end; weight: 1 }
      }
      LimitDetails { used: used; reset: reset }
    }
  }

  component CompactLimit(label, used, reset, mark = false) {
    Column {
      gap: 1
      Row {
        gap: 4
        align: center
        if mark {
          Image { src: chatgptLogo; width: 14; height: 14; tint: accent }
        }
        Text { text: used == null ? "${label} —" : "${label} ${round(100 - used)}%"; fontSize: 15; font: mono; color: foreground; bold: true; weight: 1; maxLines: 1 }
      }
      LimitDetails { used: used; reset: reset; compact: true }
    }
  }

  Column {
    gap: compact ? 5 : 10
    if compact {
      CompactLimit { label: "5h"; used: fiveUsed; reset: limits.ok ? fiveReset : null; mark: true }
      CompactLimit { label: "1week"; used: weekUsed; reset: limits.ok ? weekReset : null }
    } else {
      Limit { label: "5h"; used: fiveUsed; reset: limits.ok ? fiveReset : null; mark: true }
      Limit { label: "1week"; used: weekUsed; reset: limits.ok ? weekReset : null }
    }
  }
}
