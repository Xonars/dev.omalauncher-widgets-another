// Storage widget by rcrohmana, 2026. MIT License.
// A treemap of the Linux folders by size, and the junk that is safe to delete, with a clean button.
// Android's own storage (photos, apps) isn't visible from Linux, so the folders are this Arch
// system's; the bar is the phone's whole data partition, which Linux shares.
widget "storage" {
  size: 3x3
  minSize: 2x2

  meta {
    owl: 10
    description: "A treemap of your Linux folders and what fills them, phone storage free and used, and caches that are safe to clean, per item or all at once."
    version: "1.3"
    license: "MIT"
    category: "system"
  }
  requires { pacman: ["bash", "coreutils", "findutils", "util-linux", "gawk", "sed", "jq", "pacman-contrib"] }

  // One script, two modes: `scan` prints the disk, the folders two levels deep and the junk items
  // as JSON, `clean <id|safe>` starts a cleaner in the background (detached with setsid, so the
  // 30 s limit on run() can't cut it off) that reports the item it's on and then what it freed
  // in ~/.cache/storage-widget/status.json, which the widget reads with a file() source.
  // Deleting (rm -rf) only ever touches the fixed cache paths listed in paths() below, the
  // pacman package cache (through paccache) and /tmp entries unused for a week or left by
  // sessions that have ended. Results are kept in ~/.cache/storage-widget.
  let script = """
    #   scan            JSON: disk, folders (2 levels, biggest first), junk items
    #   clean <id|safe> starts deleting one junk item (or all) in the background; status.json
    #                   says the item it's on, then {"freed": bytes, "at": seconds}
    #   clean <id> --dry  prints what would be deleted, deletes nothing
    # Only throwaway data counts as junk: download caches that tools fill again on demand,
    # the pacman package cache, the trash, and /tmp leftovers (old files, dead proot sessions).
    # Never: ~/.cache as a whole (widgets keep state there), configs, installed tools or packages.
    H=$HOME
    D=$H/.cache/storage-widget
    mkdir -p "$D"
    LOCK=$D/lock
    IDS="pkg npm bun pip uv go yay mise chromium claudelog thumbs trash tmp"

    name() {
      case $1 in
        pkg) echo "Pacman package cache|Downloaded packages. Pacman fetches them again if it needs them.";;
        npm) echo "npm cache|~/.npm. Downloaded again when needed.";;
        bun) echo "Bun cache|~/.bun/install/cache. Downloaded again when needed.";;
        pip) echo "pip cache|~/.cache/pip. Downloaded again when needed.";;
        uv) echo "uv cache|~/.cache/uv. Downloaded again when needed.";;
        go) echo "Go build cache|~/.cache/go-build. Rebuilt when needed.";;
        yay) echo "Yay build files|~/.cache/yay. Left over from AUR builds.";;
        mise) echo "Mise cache|~/.cache/mise and old downloads. Installed tools stay.";;
        chromium) echo "Chromium cache|~/.cache/chromium-headless. Rebuilt when needed.";;
        claudelog) echo "Claude Code logs|~/.cache/claude-cli-nodejs. Old debug logs.";;
        thumbs) echo "Thumbnails|~/.cache/thumbnails. Image previews, made again when needed.";;
        trash) echo "Trash|~/.local/share/Trash. Files you already deleted.";;
        tmp) echo "Temporary files|Files in /tmp unused for 7+ days, and leftovers of closed sessions.";;
      esac
    }

    # /tmp entries safe to remove; the launcher's, proot's live ones and agents' own are kept.
    tmpold() {
      find /tmp /var/tmp -mindepth 1 -maxdepth 1 -mtime +7 ! -type s ! -name '.bun-*' ! -name '.guest-shell-err-*' ! -name 'tmux-*' ! -name 'claude-*' ! -name 'proot-*' ! -name '.X*' ! -name '.ICE*' ! -name 'hsperfdata_*' ! -name 'omalauncher*' ! -name 'owl-*' ! -name 'pulse*' ! -name 'systemd-*' ! -name 'ssh-*' 2>/dev/null | while IFS= read -r f; do
        # a directory's own time doesn't change with files deeper in, so one still in use can look old
        [ -z "$(find "$f" -mtime -8 -print -quit; find "$f" -type s -print -quit)" ] && echo "$f"
      done
      for f in /tmp/proot-*; do [ -e "$f" ] && ! kill -0 "$(basename "$f" | awk -F- '{ print $2 }')" 2>/dev/null && echo "$f"; done
      for f in /tmp/.guest-shell-err-*; do [ -e "$f" ] && ! kill -0 "$(basename "$f" | awk -F- '{ print $NF }')" 2>/dev/null && echo "$f"; done
    }

    # the paths an item deletes, one per line
    paths() {
      case $1 in
        pkg) find /var/cache/pacman/pkg -mindepth 1 -maxdepth 1 2>/dev/null;;
        npm) echo "$H/.npm/_cacache"; echo "$H/.npm/_logs";;
        bun) echo "$H/.bun/install/cache";;
        pip) echo "$H/.cache/pip";;
        uv) echo "$H/.cache/uv";;
        go) echo "$H/.cache/go-build";;
        yay) echo "$H/.cache/yay";;
        mise) echo "$H/.cache/mise"; find "$H/.local/share/mise/downloads" -mindepth 1 -maxdepth 1 2>/dev/null;;
        chromium) echo "$H/.cache/chromium-headless";;
        claudelog) echo "$H/.cache/claude-cli-nodejs";;
        thumbs) echo "$H/.cache/thumbnails";;
        trash) find "$H/.local/share/Trash" -mindepth 1 -maxdepth 1 2>/dev/null;;
        tmp) tmpold;;
      esac
    }

    size() { paths "$1" | while IFS= read -r f; do [ -e "$f" ] && du -sb -- "$f" 2>/dev/null; done | awk '{ t += $1 } END { print t + 0 }'; }

    # Sizes as people read them ("1.4 GB", "245 KB"), so the widget doesn't have to format them.
    HUM='def hum: . as $n | if $n < 1024 then "\($n) B" else ([["KB",1024],["MB",1048576],["GB",1073741824],["TB",1099511627776]] | map(select($n >= .[1])) | last) as $u | ($n / $u[1]) as $v | (if $v < 10 then ($v * 10 | round) / 10 else ($v | round) end) as $r | "\($r) \($u[0])" end;'
    human() {
      jq -c "$HUM"'
        walk(if type == "object" and has("size") then . + {h: (.size | hum)} else . end)
        | if .disk then
            .disk.h = (.disk | map_values(hum))
            | .linux = ([.dirs[].size] | add // 0) | .linuxH = (.linux | hum)
            | .androidH = ([.disk.used - .linux, 0] | max | hum)
            | .junkTotal = ([.junk[].size] | add // 0) | .junkH = (.junkTotal | hum)
            # the treemap: folders of 3%+ of Linux, each with its subfolders of 4%+ and the rest as
            # "Other"; the folders under 3% together as one more box
            | .linux as $T
            | .map = ([.dirs[] | select(.size >= $T * 0.03) | . as $d
                | [.kids[] | select(.size >= $d.size * 0.04) | {name: (.path | split("/") | last), size, h}] as $p
                | ($d.size - ([$p[].size] | add // 0)) as $rest
                | {path, size, h, parts: ($p + (if $rest >= $d.size * 0.02 then [{name: "Other", size: $rest, h: ($rest | hum)}] else [] end))}]
              + ([.dirs[] | select(.size > 0 and .size < $T * 0.03) | .size] | add // 0 | if . > 0 then [{path: "", size: ., h: hum, parts: []}] else [] end))
          else . end
        | if has("freed") then .freedH = (.freed | hum) else . end'
    }

    esc() { sed 's/\\/\\\\/g; s/"/\\"/g'; }

    scan() {
      read -r total used avail < <(df -B1 --output=size,used,avail / | tail -1)
      dirs=$(find / -mindepth 1 -maxdepth 1 -type d ! -name proc ! -name sys ! -name dev ! -name run ! -name mnt)
      printf '{"ts":%s,"disk":{"total":%s,"used":%s,"avail":%s},"dirs":' "$(date +%s)" "$total" "$used" "$avail"
      # one du pass, two levels deep: top-level folders with their biggest subfolders
      # shellcheck disable=SC2086
      nice -n19 ionice -c3 du -xb -d1 $dirs 2>/dev/null | sort -rn | awk -F'\t' '
        function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
        {
          p = $2; n = split(p, a, "/")
          if (n == 2) { top[++nt] = p; tsize[p] = $1 }
          else if (n == 3) { par = "/" a[2]; if (kc[par] < 12) kids[par] = kids[par] (kc[par]++ ? "," : "") sprintf("{\"path\":\"%s\",\"size\":%s}", esc(p), $1) }
        }
        END {
          printf "["
          for (i = 1; i <= nt; i++) { p = top[i]; printf "%s{\"path\":\"%s\",\"size\":%s,\"kids\":[%s]}", (i > 1 ? "," : ""), esc(p), tsize[p], kids[p] }
          printf "]"
        }'
      printf ',"junk":'; junk; printf '}\n'
    }

    junk() {
      printf '['
      first=1
      for id in $IDS; do
        s=$(size "$id")
        [ "$s" -gt 0 ] || continue
        IFS='|' read -r nm desc <<< "$(name "$id")"
        printf '%s{"id":"%s","name":"%s","desc":"%s","size":%s}' "$([ $first = 1 ] || echo ,)" "$id" "$nm" "$(esc <<< "$desc")" "$s"
        first=0
      done
      printf ']'
    }

    # After a clean, the last scan is brought up to date instead of scanning everything again
    # (a du of the whole system, 10-20 s): the disk and the junk anew, and each folder less what
    # was deleted in it ($D/gone: bytes and path, one per line).
    patch() {
      read -r total used avail < <(df -B1 --output=size,used,avail / | tail -1)
      jq -c --rawfile g "$D/gone" --argjson junk "$(junk)" --argjson disk "{\"total\":$total,\"used\":$used,\"avail\":$avail}" '
        [$g | split("\n")[] | select(. != "") | split("\t") | {n: (.[0] | tonumber), p: .[1]}] as $gone
        | def less($p): [$gone[] | select(.p == $p or (.p | startswith($p + "/"))) | .n] | add // 0;
        .ts = (now | floor) | .disk = $disk | .junk = $junk
        | .dirs = ([.dirs[] | {path, size: ([.size - less(.path), 0] | max),
            kids: ([.kids[] | {path, size: (.size - less(.path))} | select(.size > 0)] | sort_by(-.size))}] | sort_by(-.size))
        | del(.map)' "$CACHE" | human
    }

    # what a clean is doing, for the widget: the item it's on, then what it freed and when
    status() { printf '{"target":"%s","running":"%s","started":%s,"freed":%s,"at":%s}' "$1" "$2" "$3" "$4" "$5" | human > "$D/status.tmp" && mv "$D/status.tmp" "$D/status.json"; }

    clean() {
      case $1 in safe) ids=$IDS;; *) ids=$1;; esac
      freed=0
      : > "$D/gone"
      for id in $ids; do
        if [ "$2" = --dry ]; then paths "$id" | sed "s/^/$id: /"; continue; fi
        status "$1" "$id" "$t0" "$freed" 0
        paths "$id" | while IFS= read -r f; do [ -e "$f" ] && du -sb -- "$f" 2>/dev/null; done > "$D/before"
        if [ "$id" = pkg ]; then
          paccache -rqk0 2>/dev/null
          rm -rf /var/cache/pacman/pkg/download-* 2>/dev/null
        else
          paths "$id" | while IFS= read -r f; do [ -n "$f" ] && [ "$f" != / ] && rm -rf -- "$f"; done
        fi
        # what each path lost: all of it, or less if something in it couldn't be deleted
        while IFS=$'\t' read -r n f; do
          left=$([ -e "$f" ] && du -sb -- "$f" 2>/dev/null | cut -f1); [ -n "$left" ] || left=0
          printf '%s\t%s\n' "$((n - left))" "$f"
        done < "$D/before" >> "$D/gone"
        freed=$(awk -F'\t' '{ t += $1 } END { print t + 0 }' "$D/gone")
      done
    }

    # A scan is cached for 2 minutes, so several callers (the tile, owl-check) share one pass.
    CACHE=$D/scan.json
    fresh() { [ -s "$CACHE" ] && [ $(( $(date +%s) - $(stat -c %Y "$CACHE") )) -lt 120 ]; }
    case $1 in
      scan)
        [ -s "$D/status.json" ] || status "" "" 0 0 0
        if fresh && [ "$(stat -c %Y "$CACHE")" -ge "${2:-0}" ]; then echo cached; exit; fi
        setsid -f bash -c "$BASH_EXECUTION_STRING" storage measure "${2:-0}" >/dev/null 2>&1 </dev/null
        echo started;;
      measure)
        exec 9>"$LOCK"
        flock -n 9 || exit 0
        if fresh && [ "$(stat -c %Y "$CACHE")" -ge "${2:-0}" ]; then exit; fi
        echo 'Измерение папок…' > "$D/scan-state.txt"
        if (set -o pipefail; scan | human > "$CACHE.tmp") && jq -e '.disk.total > 0 and (.dirs | length > 0)' "$CACHE.tmp" >/dev/null; then
          mv "$CACHE.tmp" "$CACHE"
          echo '' > "$D/scan-state.txt"
        else
          echo 'Не удалось измерить папки. Нажмите Обновить.' > "$D/scan-state.txt"
        fi;;
      clean)
        case " $IDS safe " in *" $2 "*) ;; *) echo "unknown item: $2" >&2; exit 2;; esac
        [ "$3" = --dry ] && { clean "$2" --dry; exit; }
        # one clean at a time; a tap while one runs just shows it
        if flock -n "$D/clean.lock" true; then
          status "$2" "$2" "$(date +%s)" 0 0
          setsid -f bash -c "$BASH_EXECUTION_STRING" storage work "$2" >/dev/null 2>&1 </dev/null
        fi
        date +%s%N;;
      work)
        exec 8>"$D/clean.lock"; flock -n 8 || exit 0
        t0=$(date +%s)
        exec 9>"$LOCK"; flock -w 600 9   # waits for a scan that's running
        clean "$2" >/dev/null 2>&1
        # update the scan before saying it's done, so the widget never shows the cleaned junk again
        { [ -s "$CACHE" ] && patch > "$CACHE.tmp"; } || scan | human > "$CACHE.tmp"
        mv "$CACHE.tmp" "$CACHE"
        exec 9>&-
        status "$2" "" "$t0" "$freed" "$(date +%s)";;
      *) echo "usage: storage scan | clean <id|safe> [--dry]" >&2; exit 2;;
    esac
  """

  // A full scan reads every file (about 20 s, at idle priority), so only hourly, and after a clean.
  state scanRequested = 0
  source scan = cmd("bash -c ${sh(script)} storage scan ${sh(scanRequested)}") every 1h timeout 10s status
  source measured = file("~/.cache/storage-widget/scan.json") json
  source scanState = file("~/.cache/storage-widget/scan-state.txt")
  source now = clock every 5s

  state armed = 0        // until when a clean tap is armed (a second tap within 5 s cleans)
  source st = file("~/.cache/storage-widget/status.json") json
  state pending = ""     // tapped: the item to clean, "safe" for all, until the cleaner has started
  state pendingAt = 0    // when it was tapped; a tap whose cleaner never started is dropped after 30 s
  // run()'s output, new for every start; not null at first, since `on` ignores a change from null
  state starting = 0

  let d = measured
  let scanFailed = (scan != null && !scan.ok) || startsWith(scanState ?? "", "Не удалось")
  let dirs = (d.dirs ?? []).filter(x => x.size > 0)   // empty ones (/srv, /opt) are just noise
  // what each top-level folder holds, in plain words
  let names = {"/root": "Home", "/usr": "Programs", "/var": "System data", "/tmp": "Temporary files", "/etc": "Settings", "/home": "Other users", "/srv": "Served files", "/opt": "Add-on apps", "/boot": "Boot files"}
  // sizes come formatted from the script ("1.4 GB"), as .h next to each size
  let junk = (d.junk ?? []).sortBy(j => -j.size)
  let junkTotal = sum(junk.map(j => j.size))
  let linuxTotal = sum(dirs.map(x => x.size))
  let biggest = max(dirs[0].size ?? 1, 1)
  let pct = d ? d.disk.used / d.disk.total * 100 : null
  let isArmed = armed > now
  state open = ""

  // The tile fills its size with what fits whole, so nothing is cut off and little is left empty.
  // Inner size in dp (tile padding is 12). Measured heights: header 15, small text and labels 13,
  // the big free number 33 (20 more than small), bar 8.5, button 27, gaps 6; a junk row is 13
  // plus a 4 gap. The summary, the middle and the clean row take 87.5 and the middle gets the
  // rest. In one column the treemap goes there (with its label, from 67 dp), then the big number
  // if the map keeps 67, then the junk list and the used space if the map keeps 110. Wide tiles
  // (5-6 columns) give the treemap a column of its own on the right, the full height.
  let iw = (tileWidth ?? 182) - 24
  let ih = (tileHeight ?? 186) - 24
  let twoCol = iw >= 280
  let narrow = iw < 130
  let mid = ih - 87.5
  let showMap = !twoCol && mid >= 67
  // "167 GB free of 221 GB" needs 165 dp with the big number, so narrower columns say "167 GB free"
  let colW = twoCol ? (iw - 16) / 2 : iw
  let big = !narrow && (showMap ? mid - 20 >= 67 : mid >= 20)
  let room = mid - (big ? 20 : 0) - (showMap ? 129 + 6 : 0)
  let nJunk = narrow ? 0 : clamp(floor((room - 13) / 17), 0, len(junk))
  // then, if 47 dp are still free, what the used space is: Linux and Android
  let showUsed = !narrow && room - (nJunk > 0 ? 19 + 17 * nJunk : 0) >= 47
  // the treemap draws the big folders; the small ones together are only a sliver, so their total
  // goes next to the map's label instead of into an empty-looking box
  let mapGroups = (d.map ?? []).filter(g => g.path != "")
  let otherH = find(d.map ?? [], g => g.path == "").h
  let lastCleanAt = num(st.at, 0)
  let ago = lastCleanAt > 0 ? (fmtAgo(lastCleanAt, now) == "now" ? "just now" : "${fmtAgo(lastCleanAt, now)} ago") : ""

  // a status still running after an hour is from a cleaner that was killed
  let live = st.running != null && st.running != "" && now != null && now - st.started < 3600
  let waiting = pending != "" && now - pendingAt < 30
  let cleaning = waiting ? pending : live ? st.target : ""   // "safe" while cleaning all
  on starting { pending = "" }
  // when the last clean finished; null while one runs, so it changes when one ends
  let doneAt = live || waiting ? null : st.at
  on doneAt { notify("Storage", "Freed ${st.freedH}."); refresh() }

  onTap: screen()

  component RefreshScan() {
    Button { text: "Обновить"; onTap: { haptic(); scanRequested = now; refresh() } }
  }

  component FolderRow(path, bytes, sizeText, peak, hint = "", tint = accent, wrap = false) {
    Column {
      gap: 2
      Row {
        align: top
        Text { spans: [path, {text: hint == "" ? "" : "  ${hint}", color: muted}]; style: small; maxLines: wrap ? 10 : 1; weight: 1 }
        Text { text: sizeText; style: small; color: muted }
      }
      Progress { value: bytes; max: peak; color: tint }
    }
  }

  // Treemap: each folder a box with an area for its size, cut off the longer side of what's
  // left, biggest first; inside a big enough box, its subfolders the same way. A label is drawn
  // only where it fits whole. `chosen` outlines a folder.
  let tints = [accent, magenta, cyan, yellow, green, orange]
  component MapLabel() {
    Row {
      Text { text: "Linux · ${d.linuxH}"; style: label; weight: 1 }
      if otherH != null { Text { text: "+${otherH} other"; style: small; color: muted } }
    }
  }

  component TreeMap(groups, nested, chosen = "") {
    Canvas {
      let total = max(sum(groups.map(g => g.size)), 1)
      let tops = scan(groups, (a, g) => {
        x: a.w >= a.h ? a.x + a.w * g.size / a.rem : a.x, y: a.w >= a.h ? a.y : a.y + a.h * g.size / a.rem,
        w: a.w >= a.h ? a.w * (1 - g.size / a.rem) : a.w, h: a.w >= a.h ? a.h : a.h * (1 - g.size / a.rem),
        rem: max(a.rem - g.size, 1),
        rx: a.x, ry: a.y, rw: a.w >= a.h ? a.w * g.size / a.rem : a.w, rh: a.w >= a.h ? a.h : a.h * g.size / a.rem
      }, {x: 0, y: 0, w: width, h: height, rem: total})
      for s, i in tops {
        let g = groups[i]
        let c = g.path == "" ? muted : tints[i % 6]
        let bx = s.rx + 1.5
        let by = s.ry + 1.5
        let bw = s.rw - 3
        let bh = s.rh - 3
        let label = g.path == "" ? "Other" : names[g.path] ?? g.path
        let inner = nested && bh >= 64 && bw >= 80 && len(g.parts) > 0
        let fitsBoth = bw >= (len(label) + len(g.h) + 2) * 6.5 + 12
        rect(bx, by, bw, bh, radius: 6 * corners, fill: alpha(c, chosen != "" && chosen == g.path ? 0.34 : 0.16))
        rect(bx, by, bw, bh, radius: 6 * corners, stroke: c, width: chosen != "" && chosen == g.path ? 2.5 : 1)
        if inner {
          text(fitsBoth ? [label, {text: "  ${g.h}", color: muted}] : label, bx + 7, by + 11, size: 12, color: foreground, align: start)
          let psum = max(sum(g.parts.map(p => p.size)), 1)
          let parts = scan(g.parts, (a, p) => {
            x: a.w >= a.h ? a.x + a.w * p.size / a.rem : a.x, y: a.w >= a.h ? a.y : a.y + a.h * p.size / a.rem,
            w: a.w >= a.h ? a.w * (1 - p.size / a.rem) : a.w, h: a.w >= a.h ? a.h : a.h * (1 - p.size / a.rem),
            rem: max(a.rem - p.size, 1),
            rx: a.x, ry: a.y, rw: a.w >= a.h ? a.w * p.size / a.rem : a.w, rh: a.w >= a.h ? a.h : a.h * p.size / a.rem
          }, {x: bx + 4, y: by + 22, w: bw - 8, h: bh - 26, rem: psum})
          for k, j in parts {
            let pt = g.parts[j]
            let kx = k.rx + 1
            let ky = k.ry + 1
            let kw = k.rw - 2
            let kh = k.rh - 2
            rect(kx, ky, kw, kh, radius: 3 * corners, fill: alpha(c, 0.34 - 0.06 * (j % 4)))
            if kh >= 30 && kw >= max(len(pt.name), len(pt.h)) * 6 + 10 {
              text(pt.name, kx + 5, ky + 10, size: 11, color: foreground, align: start)
              text(pt.h, kx + 5, ky + 24, size: 10, color: alpha(foreground, 0.7), align: start)
            } else if kh >= 15 && kw >= len(pt.name) * 6 + 10 {
              text(pt.name, kx + 5, ky + kh / 2, size: 11, color: foreground, align: start)
            } else if kh >= 30 && kw >= max(len(pt.name), len(pt.h)) * 5 + 8 {
              // narrow boxes get a smaller font before they go without a name
              text(pt.name, kx + 4, ky + 10, size: 9, color: foreground, align: start)
              text(pt.h, kx + 4, ky + 22, size: 9, color: alpha(foreground, 0.7), align: start)
            } else if kh >= 13 && kw >= len(pt.name) * 5 + 8 {
              text(pt.name, kx + 4, ky + kh / 2, size: 9, color: foreground, align: start)
            }
          }
        } else if bh >= 34 && bw >= max(len(label) * 6.5, len(g.h) * 6) + 14 {
          text(label, bx + 7, by + bh / 2 - 8, size: 12, color: foreground, align: start)
          text(g.h, bx + 7, by + bh / 2 + 8, size: 11, color: muted, align: start)
        } else if bh >= 16 && fitsBoth {
          text([label, {text: "  ${g.h}", color: muted}], bx + 7, by + bh / 2, size: 12, color: foreground, align: start)
        } else if bh >= 16 && bw >= len(label) * 6.5 + 14 {
          text(label, bx + 7, by + bh / 2, size: 12, color: foreground, align: start)
        }
      }
    }
  }

  // two taps within 5 s clean everything safe; one stray tap does nothing
  component CleanButton(label) {
    Button {
      text: label
      color: isArmed ? red : accent
      onTap: {
        if cleaning == "" {
          if isArmed {
            armed = 0
            pending = "safe"
            pendingAt = now
            starting = run("bash -c ${sh(script)} storage clean safe")
          } else {
            armed = now + 5
          }
        }
      }
    }
  }

  component JunkList(items) {
    Column {
      gap: 4
      Text { text: "Safe to clean"; style: label }
      for j in items key j.id {
        Row {
          Text { text: j.name; style: small; weight: 1 }
          Text { text: j.h; style: small; color: yellow }
        }
      }
    }
  }

  component Summary(short, large) {
    Column {
      gap: 6
      Row {
        Text { text: "Storage"; style: muted; weight: 1 }
        if scanFailed { RefreshScan { } }
        Text { text: narrow ? "${round(pct)}%" : "${round(pct)}% used"; style: muted }
      }
      Text {
        style: small
        spans: [
          large ? {text: d.disk.h.avail, fontSize: 28, fontWeight: 300} : {text: d.disk.h.avail, bold: true},
          {text: short ? " free" : " free of ${d.disk.h.total}", color: muted}
        ]
      }
      Progress { value: pct; color: pct > 90 ? red : pct > 75 ? yellow : accent }
    }
  }

  component UsedBreakdown() {
    Column {
      gap: 4
      Text { text: "Used · ${d.disk.h.used}"; style: label }
      Row { Text { text: "Linux"; style: small; weight: 1 }  Text { text: d.linuxH; style: small; color: muted } }
      Row { Text { text: "Android and apps"; style: small; weight: 1 }  Text { text: d.androidH; style: small; color: muted } }
    }
  }

  component Junk(short) {
    if junkTotal == 0 {
      Text { spans: [{text: "󰄬 ", font: "icon"}, "All clean"]; style: small; color: green }
    } else if cleaning != "" {
      Text { text: "Cleaning up…"; style: small; color: muted }
    } else if short {
      CleanButton { label: isArmed ? "Confirm" : "Clean up"; fill: width }
    } else {
      Row {
        align: center
        Text { spans: [{text: d.junkH, color: yellow}, {text: " to clean", color: muted}]; style: small; weight: 1 }
        CleanButton { label: isArmed ? "Confirm" : "Clean" }
      }
    }
  }

  if d && twoCol {
    Row {
      gap: 16
      // what's left over is shared out between the parts rather than pooling at the bottom
      Column {
        gap: 6
        weight: 1
        fill: height
        justify: spaceBetween
        Summary { short: big && colW < 165; large: big }
        if nJunk > 0 { JunkList { items: junk.take(nJunk) } }
        if showUsed { UsedBreakdown { } }
        Junk { short: false }
      }
      Column {
        gap: 5
        weight: 1
        fill: height
        MapLabel { }
        TreeMap { groups: mapGroups; nested: true; weight: 1 }
      }
    }
  } else if d {
    Column {
      gap: 6
      fill: height
      justify: spaceBetween
      Summary { short: narrow || (big && colW < 165); large: big }
      if showMap {
        Column {
          gap: 5
          weight: 1
          MapLabel { }
          TreeMap { groups: mapGroups; nested: true; weight: 1 }
        }
      } else {
        Spacer { weight: 1 }
      }
      if nJunk > 0 { JunkList { items: junk.take(nJunk) } }
      if showUsed { UsedBreakdown { } }
      Junk { short: narrow }
    }
  } else if scanFailed {
    Column {
      Text { text: "Scan failed"; color: red }
      RefreshScan { }
      Text { text: "Tap for details"; style: small; color: muted }
    }
  } else {
    Text { text: (scanState ?? "") != "" ? scanState : "Измерение папок…"; style: small; color: muted }
  }

  screen {
    title: "Storage"
    Column {
      scroll: true
      gap: 10
      padding: [4, 4]
      if scanFailed { RefreshScan { } }
      if (scanState ?? "") != "" { Text { text: scanState; style: small; color: muted } }
      if d {
        Column {
          gap: 4
          Row {
            Text { text: "Phone storage"; style: label; weight: 1 }
            Text { text: "${round(pct)}% used"; style: label }
          }
          Text { spans: [{text: d.disk.h.avail, bold: true}, {text: " free of ${d.disk.h.total}", color: muted}]; style: title }
          Progress { value: pct; color: pct > 90 ? red : pct > 75 ? yellow : accent }
          Text { spans: [{text: "Linux ", color: foreground}, d.linuxH, {text: "    Android and apps ", color: foreground}, d.androidH]; style: small; color: muted }
          Text { text: "Measured at ${fmtTime(d.ts, "HH:mm")}, again every hour and after cleaning."; style: small; color: muted }
        }

        Row {
          align: center
          Text { text: "Linux folders"; style: label; weight: 1 }
          Text { text: "Tap a folder to see inside"; style: small; color: muted }
        }
        // the same treemap, bigger; a tap opens that folder in the list below it
        let mapW = (screenWidth ?? 360) - 8
        let screenTops = scan(mapGroups, (a, g) => {
          x: a.w >= a.h ? a.x + a.w * g.size / a.rem : a.x, y: a.w >= a.h ? a.y : a.y + a.h * g.size / a.rem,
          w: a.w >= a.h ? a.w * (1 - g.size / a.rem) : a.w, h: a.w >= a.h ? a.h : a.h * (1 - g.size / a.rem),
          rem: max(a.rem - g.size, 1), path: g.path,
          rx: a.x, ry: a.y, rw: a.w >= a.h ? a.w * g.size / a.rem : a.w, rh: a.w >= a.h ? a.h : a.h * g.size / a.rem
        }, {x: 0, y: 0, w: mapW, h: 300, rem: max(sum(mapGroups.map(g => g.size)), 1)})
        Box {
          height: 300
          fill: width
          onTap: {
            let hit = find(screenTops, t => x >= t.rx && x < t.rx + t.rw && y >= t.ry && y < t.ry + t.rh)
            if hit != null && hit.path != "" { open = open == hit.path ? "" : hit.path }
          }
          TreeMap { groups: mapGroups; nested: true; chosen: open; fill: true }
        }
        for f in dirs key f.path {
          Column {
            gap: 6
            padding: [10, 8]
            border: 1
            borderColor: open == f.path ? accent : border
            onTap: open = open == f.path ? "" : f.path
            FolderRow { path: "${open == f.path ? "▾" : "▸"} ${names[f.path] ?? f.path}"; hint: names[f.path] == null ? "" : f.path; bytes: f.size; sizeText: f.h; peak: biggest; wrap: true }
            if open == f.path {
              let kmax = max(f.kids[0].size ?? 1, 1)
              for k in f.kids key k.path {
                FolderRow { path: replace(k.path, "${f.path}/", ""); bytes: k.size; sizeText: k.h; peak: kmax; tint: muted; wrap: true; padding: [12, 0, 0, 0] }
              }
              if len(f.kids) == 0 { Text { text: "Empty"; style: small; color: muted } }
            }
          }
        }

        Row {
          align: center
          Text { text: "Safe to clean"; style: label; weight: 1 }
          if junkTotal > 0 { Text { text: d.junkH; style: label; color: yellow } }
        }
        if len(junk) == 0 {
          Row {
            align: center
            gap: 12
            padding: [12, 10]
            border: 1
            borderColor: alpha(green, 0.5)
            background: alpha(green, 0.08)
            Text { text: "󰄬"; font: icon; fontSize: 22; color: green }
            Column {
              gap: 2
              weight: 1
              Text { text: "All clean"; color: green }
              Text { text: lastCleanAt > 0 ? "The last cleanup freed ${st.freedH}, ${ago}. Checked again every hour." : "No caches or old temporary files worth removing. Checked again every hour."; style: small; color: muted }
            }
          }
        }
        for j in junk key j.id {
          Row {
            align: center
            gap: 10
            Column {
              gap: 0
              weight: 1
              Text { text: j.name }
              Text { text: j.desc; style: small; color: muted }
            }
            Text { text: j.h; style: small; color: yellow }
            Button {
              text: cleaning == j.id || cleaning == "safe" ? "…" : "Clean"
              onTap: {
                if cleaning == "" {
                  pending = j.id
                  pendingAt = now
                  starting = run("bash -c ${sh(script)} storage clean ${sh(j.id)}")
                }
              }
            }
          }
        }
        if len(junk) > 0 {
          Button {
            text: cleaning != "" ? "Cleaning up…" : isArmed ? "Tap again to clean ${d.junkH}" : "Clean all · ${d.junkH}"
            color: isArmed ? red : accent
            fill: width
            onTap: {
              if cleaning == "" {
                if isArmed {
                  armed = 0
                  pending = "safe"
                  pendingAt = now
                  starting = run("bash -c ${sh(script)} storage clean safe")
                } else {
                  armed = now + 5
                }
              }
            }
          }
        }
        Text { text: "Only files that come back on their own are listed: caches, old temp files and the trash. Your own files, settings and installed tools are never touched. Android's photos and apps can't be seen from Linux, so they aren't here."; style: small; color: muted }
      } else if scanFailed {
        Text { text: "Couldn't measure the folders"; color: red }
        Text { text: scan.err ?? "exit ${scan.code}"; style: small; font: mono }
      } else {
        Text { text: "Измерение выполняется в фоне. Можно закрыть этот экран."; color: muted }
      }
    }
  }
}
