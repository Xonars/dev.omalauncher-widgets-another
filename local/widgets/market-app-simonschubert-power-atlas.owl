app "Атлас энергии" {
  // No shell commands or external package dependencies.
  requires { pacman: [] }
  meta { owl: 11; description: "Выработка и потребление электроэнергии по странам, источники энергии, импорт и экспорт в сравнении с площадью и населением"; version: "1.1"; license: "MIT"; category: "world" }
