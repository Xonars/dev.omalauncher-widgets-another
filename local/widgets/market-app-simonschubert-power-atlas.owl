  let renC = "#5E9A3A"
  let ES = [{l: "уголь", c: coalC}, {l: "газ", c: "#CF7A22"}, {l: "нефть", c: "#B8364E"}, {l: "атомная", c: nucC}, {l: "солнце", c: "#AD8612"}, {l: "ветер", c: "#16A0A0"}, {l: "гидро", c: "#3F66D6"}, {l: "биомасса", c: renC}, {l: "тепло Земли и приливы", c: muted}]
  // The same, in three: burning fossil fuels, nuclear, and renewables.
  let GS = [{l: "ископаемое топливо", c: coalC}, {l: "атомная", c: nucC}, {l: "возобновляемая", c: renC}]
  let impC = "#D45D79"
  let expC = "#2E9E6E"
  let bC = alpha(foreground, 0.55)

  let cn = C.find(c => c.id == openId) ?? W
  let cA = C.find(c => c.id == cmpA) ?? C[0]
  let cB = C.find(c => c.id == cmpB) ?? C[1]

  // The countries tab: what the list is sorted by, and what each row says about it.
  let sorts = [
    {k: "E", l: "выработка"}, {k: "U", l: "потребление"}, {k: "pd", l: "на человека"}, {k: "pk", l: "на км²"},
    {k: "cl", l: "чистая энергия"}, {k: "sw", l: "солнце и ветер"}, {k: "im", l: "импорт"}, {k: "ex", l: "экспорт"}
  ]
  let regions = ["all", "Европа", "Азия", "Америка", "Африка", "Ближний Восток", "Океания"]
  let found = C.filter(c => (reg == "all" || c.r == reg) && (len(typed) == 0 || contains(lower(c.n), lower(typed))))
  let keyed = found.map(c => {c: c, v: get(c, sortKey, 0)}).filter(x => (sortKey != "im" && sortKey != "ex") || x.v >= 0.05)
  let rows = keyed.sortBy(x => -x.v)
  let vmax = len(rows) > 0 ? max(rows.map(x => x.v)) : 1

  let picks = len(pickTyped) == 0 ? C.sortBy(c => c.n) : C.filter(c => contains(lower(c.n), lower(pickTyped))).sortBy(c => c.n)

  // World lists.
  let top = C.take(10)
  let exporters = C.filter(c => c.net < 0).sortBy(c => c.net).take(8)
  let importers = C.filter(c => c.net > 0).sortBy(c => -c.net).take(8)
  let big = C.filter(c => c.pop >= 1000000)
  let hungry = big.sortBy(c => -c.pd).take(8)
  let cleanest = big.sortBy(c => -c.cl).take(8)
  let windy = big.sortBy(c => -c.sw).take(8)

  // A bar in parts, each as wide as its share, with 2 dp of the view between them.
  component Stack(vals, cols, h = 14) {
    let tot = sum(vals)
    if tot > 0 {
      Row {
        gap: 2
        height: h
        fill: width
        for v, i in vals {
          if v > tot * 0.003 {
            Box { weight: v; height: h; background: cols[i].c; radius: 2 }
          }
        }
      }
    } else {
      Box { height: h; fill: width; radius: 2; background: alpha(muted, 0.15) }
    }
  }

  // A bar `f` (0 to 1) of the width it has, on a faint track.
  component Bar(f, tint = accent, h = 8) {
    Row {
      gap: 0
      height: h
      fill: width
      background: alpha(muted, 0.14)
      radius: 2
      Box { weight: max(0.0001, clamp(f, 0, 1)); height: h; background: tint; radius: 2 }
      Box { weight: max(0.0001, 1 - clamp(f, 0, 1)); height: h }
    }
  }

  // The parts of a Stack, named, in its order, with their ТВт·ч and share.
  component Legend(vals, srcs) {
    let tot = sum(vals)
    Column {
      gap: 8
      for v, i in vals {
        if v >= 0.05 {
          Row {
            gap: 10
            align: center
            Box { width: 10; height: 10; radius: 5; background: srcs[i].c }
            Text { text: srcs[i].l; weight: 1; maxLines: 2 }
            Text { text: "${fmtNum(v, v >= 100 ? 0 : 1)} ТВт·ч"; style: small; color: muted }
            Text { text: v / tot < 0.01 ? "<1%" : "${round(v / tot * 100)}%"; bold: true; width: 46; align: end }
          }
        }
      }
    }
  }

  component Head(t, sub = "") {
    Column {
      gap: 2
      padding: [0, 14, 0, 2]
      Text { text: t; style: label; color: muted }
      if sub != "" {
        Text { text: sub; style: small; color: muted }
      }
    }
  }

  // One country in a ranked list: its flag and name, the value, and a bar against the first.
  component Ranked(c, i, value, sub, f, mixBar = false, tint = accent) {
    Row {
      gap: 12
      align: center
      padding: [0, 7]
      onTap: { openId = c.id; haptic() }
      Text { text: "${i + 1}"; style: small; color: muted; width: 26; align: end }
      Text { text: c.f; fontSize: 26 }
      Column {
        weight: 1
        gap: 4
        Row {
          gap: 8
          align: center
          Text { text: c.n; bold: true; maxLines: 1; weight: 1 }
          Text { text: value; maxLines: 1 }
        }
        if mixBar {
          Row {
            gap: 0
            height: 8
            fill: width
            Box { weight: max(0.0001, f); Stack { vals: c.el; cols: ES; h: 8 } }
            Box { weight: max(0.0001, 1 - f); height: 8 }
          }
        } else {
          Bar { f: f; h: 6; tint: tint }
        }
        Text { text: sub; style: small; color: muted; maxLines: 1 }
      }
    }
  }

  // A share от мирового объёма's total, as a bar against the largest of the group.
  component Share(label, s, smax, tint = accent) {
    Row {
      gap: 10
      align: center
      Text { text: label; style: small; width: 112; maxLines: 1 }
      Column { weight: 1; Bar { f: s / smax; tint: tint; h: 10 } }
      Text { text: s < 0.001 ? "<0.1%" : "${fixed(s * 100, s < 0.1 ? 1 : 0)}%"; style: small; bold: true; width: 50; align: end }
    }
  }

  component Tile(label, value, unit, sub) {
    Column {
      gap: 2
      padding: [12, 10]
      background: alpha(foreground, 0.05)
      radius: 10 * corners
      Text { text: label; style: small; color: muted; maxLines: 1 }
      Text { spans: [{text: value, fontSize: 24, bold: true}, " ${unit}"]; style: small; maxLines: 1 }
      Text { text: sub; style: small; color: muted; maxLines: 2 }
    }
  }

  // Two countries side by side on one measure.
  component Versus(label, a, b, ta, tb) {
    let m = max(a, b)
    Column {
      gap: 5
      Row {
        gap: 8
        Text { text: label; bold: true; weight: 1 }
        Text { text: a > 0 && b > 0 ? (a >= b ? "${cA.f} ${fixed(a / b, a / b >= 10 ? 0 : 1)}×" : "${cB.f} ${fixed(b / a, b / a >= 10 ? 0 : 1)}×") : ""; style: small; color: muted }
      }
      Row {
        gap: 8
        align: center
        Text { text: cA.f; fontSize: 16 }
        Column { weight: 1; Bar { f: m > 0 ? a / m : 0; tint: accent; h: 10 } }
        Text { text: ta; style: small; width: 112; align: end; maxLines: 1 }
      }
      Row {
        gap: 8
        align: center
        Text { text: cB.f; fontSize: 16 }
        Column { weight: 1; Bar { f: m > 0 ? b / m : 0; tint: bC; h: 10 } }
        Text { text: tb; style: small; width: 112; align: end; maxLines: 1 }
      }
    }
  }

  component Tab(name, label, img) {
    Column {
      weight: 1
      align: center
      gap: 4
      padding: [0, 6]
      onTap: { view = name; openId = ""; picking = ""; haptic() }
      Box {
        align: center
        width: 56
        height: 32
        Image { src: img; size: 24; tint: view == name ? foreground : muted }
      }
      Text { text: label; style: small; align: center; maxLines: 1; bold: view == name; color: view == name ? foreground : muted }
    }
  }

  Column {
    gap: 0
    fill: true

    if picking != "" {
      // ---------------------------------------------------------------- country picker
      Row {
        gap: 10
        align: center
        padding: [16, 4, 16, 8]
        Image { src: searchIcon; size: 20; tint: muted }
        Input { text: pickTyped; placeholder: "Поиск страны"; weight: 1; onChange: pickTyped = value }
      }
      Column {
        lazy: true
        weight: 1
        gap: 0
        padding: [16, 0]
        for c in picks key c.id {
          Row {
            gap: 12
            align: center
            padding: [0, 9]
            onTap: {
              if picking == "a" { cmpA = c.id } else { cmpB = c.id }
              picking = ""
              pickTyped = ""
            }
            Text { text: c.f; fontSize: 24 }
            Text { text: c.n; weight: 1; maxLines: 1; bold: c.id == (picking == "a" ? cmpA : cmpB) }
            Text { text: c.r; style: small; color: muted }
          }
        }
      }

    } else if openId != "" {
      // ---------------------------------------------------------------- a country
      let ss = cn.ss
      let bmax = max(cn.E, cn.U)
      let tmax = max(cn.im, cn.ex)
      let groups = [cn.el[0] + cn.el[1] + cn.el[2], cn.el[3], cn.el[4] + cn.el[5] + cn.el[6] + cn.el[7] + cn.el[8]]
      let shares = [cn.pop / W.pop, cn.km2 / W.km2, cn.E / W.E, cn.U / W.U]
      let smax = max(shares)
      Column {
        weight: 1
        scroll: true
        gap: 12
        padding: [16, 4, 16, 16]

        Row {
          gap: 14
          align: center
          Text { text: cn.f; fontSize: 52 }
          Column {
            weight: 1
            gap: 2
            Text { text: cn.n; style: title; maxLines: 2 }
            Text { text: "${cn.r} · ${fmtNum(cn.pop, {compact: true})} чел. · ${fmtNum(cn.km2, {compact: true})} км²"; style: small; color: muted; maxLines: 2 }
          }
        }

        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Text {
            spans: ss >= 1.95 ? ["выработка / потребление: ", {text: "${fixed(ss, ss >= 10 ? 0 : 1)}×", bold: true, color: expC}, "; остаток продаётся за рубеж"]
              : ss > 1.02 ? ["продаёт ", {text: "${round((1 - 1 / ss) * 100)}%", bold: true, color: expC}, " своей выработки за рубеж"]
              : ss >= 0.98 ? ["вырабатывает ", {text: "всю электроэнергию", bold: true}, " для своего потребления"]
              : ["покупает ", {text: "${round((1 - ss) * 100)}%", bold: true, color: impC}, " своего потребления за рубежом"]
            fontSize: 20
          }
          Column {
            gap: 8
            Row {
              gap: 10
              align: center
              Text { text: "выработка"; style: small; color: muted; width: 100 }
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, cn.E / bmax); Stack { vals: cn.el; cols: ES; h: 16 } }
                Box { weight: max(0.0001, 1 - cn.E / bmax); height: 16 }
              }
              Text { text: "${fmtNum(cn.E, cn.E >= 100 ? 0 : 1)} ТВт·ч"; style: small; bold: true; width: 100; align: end }
            }
            Row {
              gap: 10
              align: center
              Text { text: "потребление"; style: small; color: muted; width: 100 }
              Column { weight: 1; Bar { f: cn.U / bmax; tint: bC; h: 16 } }
              Text { text: "${fmtNum(cn.U, cn.U >= 100 ? 0 : 1)} ТВт·ч"; style: small; bold: true; width: 100; align: end }
            }
          }
          Text { text: "Это ${fixed(cn.E / W.E * 100, cn.E / W.E < 0.1 ? 1 : 0)}% мировой выработки, место ${cn.rE} из ${len(C)} стран."; style: small; color: muted }
        }

        Head { t: "Чистая энергия"; sub: "${round(cn.cl * 100)}% из атомных и возобновляемых источников, #${cn.rC} из ${len(C)}" }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Stack { vals: groups; cols: GS; h: 18 }
          Legend { vals: groups; srcs: GS }
        }

        Head { t: "Источники электроэнергии"; sub: "${fmtNum(cn.E, cn.E >= 100 ? 0 : 1)} ТВт·ч выработано в 2024 году" }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Stack { vals: cn.el; cols: ES; h: 18 }
          Legend { vals: cn.el; srcs: ES }
        }

        Head { t: "Импорт и экспорт"; sub: "передача через границы, ТВт·ч в год" }
        Column {
          gap: 8
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          if tmax < 0.05 {
            Text { text: "В данных нет передачи электроэнергии между этой страной и её соседями"; style: small; color: muted }
          } else {
            Row {
              Text { text: "◀ импорт"; style: small; color: impC; weight: 1 }
              Text { text: "экспорт ▶"; style: small; color: expC; weight: 1; align: end }
            }
            Row {
              gap: 0
              height: 16
              fill: width
              align: center
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, 1 - cn.im / tmax); height: 16 }
                Box { weight: max(0.0001, cn.im / tmax); height: 16; background: impC; radius: 2 }
              }
              Box { width: 2; height: 24; background: alpha(foreground, 0.5) }
              Row {
                weight: 1
                gap: 0
                height: 16
                Box { weight: max(0.0001, cn.ex / tmax); height: 16; background: expC; radius: 2 }
                Box { weight: max(0.0001, 1 - cn.ex / tmax); height: 16 }
              }
            }
            Row {
              gap: 8
              Text { text: "${fmtNum(cn.im, cn.im >= 100 ? 0 : 1)} ТВт·ч"; bold: true; weight: 1 }
              Text { text: "${fmtNum(cn.ex, cn.ex >= 100 ? 0 : 1)} ТВт·ч"; bold: true; weight: 1; align: end }
            }
            Text {
              spans: abs(cn.net) < 0.05 ? ["импорт равен экспорту"]
                : cn.net > 0 ? ["чистый импорт ", {text: "${fmtNum(cn.net, cn.net >= 100 ? 0 : 1)} ТВт·ч", bold: true, color: impC}, ", ${round(cn.net / cn.U * 100)}% от потребления"]
                : ["чистый экспорт ", {text: "${fmtNum(-cn.net, -cn.net >= 100 ? 0 : 1)} ТВт·ч", bold: true, color: expC}, ", ${round(-cn.net / cn.E * 100)}% от выработки"]
              style: small
            }
          }
        }

        Head { t: "С учётом размера страны"; sub: "Доля в мировых показателях" }
        Column {
          gap: 10
          padding: [14, 12]
          background: alpha(foreground, 0.05)
          radius: 10 * corners
          Share { label: "население"; s: shares[0]; smax: smax; tint: bC }
          Share { label: "площадь"; s: shares[1]; smax: smax; tint: bC }
          Share { label: "выработка"; s: shares[2]; smax: smax }
          Share { label: "потребление"; s: shares[3]; smax: smax }
          Text {
            spans: ["Потребление на человека: ", {text: cn.pd >= W.pd ? "${fixed(cn.pd / W.pd, 1)}×" : "${round(cn.pd / W.pd * 100)}%", bold: true}, cn.pd >= W.pd ? " от среднего в мире." : " от среднего в мире."]
            style: small
          }
        }
        Grid {
          columns: 2
          gap: 8
          Tile { label: "на человека"; value: fmtNum(cn.pd, cn.pd >= 100 ? 0 : 1); unit: "кВт·ч/день"; sub: "#${cn.rD} · мир ${fmtNum(W.pd, 1)}" }
          Tile { label: "выработка на км²"; value: fmtNum(cn.pk * 1000); unit: "МВт·ч"; sub: "#${cn.rK} · мир ${fmtNum(W.pk * 1000)}" }
          Tile { label: "чистая энергия"; value: "${round(cn.cl * 100)}"; unit: "%"; sub: "#${cn.rC} · мир ${round(W.cl * 100)}%" }
          Tile { label: "солнце и ветер"; value: "${round(cn.sw * 100)}"; unit: "%"; sub: "#${cn.rS} · мир ${round(W.sw * 100)}%" }
        }
        Row {
          gap: 8
          Button { text: "Сравнить с…"; color: accent; onTap: { cmpA = openId; openId = ""; view = "compare"; picking = "b" } }
        }
        Text { text: "${cn.y ?? 2024} · данные: EIA США, Всемирный банк"; style: small; color: muted; align: center }
      }

    } else {
      if view == "countries" {
        // ---------------------------------------------------------------- countries
        Column {
          gap: 8
          padding: [16, 4, 16, 8]
          Row {
            gap: 10
            align: center
            Image { src: searchIcon; size: 20; tint: muted }
            Input { text: typed; placeholder: "Поиск страны"; weight: 1; onChange: typed = value }
            if len(typed) > 0 {
              Text { text: "✕"; color: muted; width: 28; align: center; onTap: typed = "" }
            }
            Box {
              width: 150
              Text { text: reg == "all" ? "все регионы ▾" : "${reg} ▾"; style: small; maxLines: 1; padding: [12, 6]; color: (reg != "all") ? foreground : muted; background: (reg != "all") ? alpha(foreground, 0.12) : null; border: 1; borderColor: (reg != "all") ? alpha(foreground, 0.7) : alpha(muted, 0.4); radius: 14 * corners; onTap: regOpen = true }
              Popup {
                visible: regOpen
                onDismiss: regOpen = false
                align: end
                Column {
                  gap: 0
                  for r in regions {
                    Text { text: r == "all" ? "все регионы" : r; padding: [16, 10]; bold: r == reg; color: r == reg ? accent : foreground; width: 160; onTap: { reg = r; regOpen = false } }
                  }
                }
              }
            }
          }
          Flow {
            gap: 6
            for s in sorts {
              Text { text: s.l; style: small; maxLines: 1; padding: [12, 6]; color: (sortKey == s.k) ? foreground : muted; background: (sortKey == s.k) ? alpha(foreground, 0.12) : null; border: 1; borderColor: (sortKey == s.k) ? alpha(foreground, 0.7) : alpha(muted, 0.4); radius: 14 * corners; onTap: sortKey = s.k }
            }
          }
        }
        if len(rows) == 0 {
          Text { text: "Страны не найдены"; color: muted; align: center; padding: [16, 24] }
          Spacer { weight: 1 }
        } else {
          Column {
            lazy: true
            weight: 1
            gap: 0
            padding: [16, 0]
            for x, i in rows key x.c.id {
              let c = x.c
              let v = x.v
              Ranked {
                c: c
                i: i
                f: v / vmax
                mixBar: sortKey == "E"
                tint: sortKey == "im" ? impC : sortKey == "ex" ? expC : sortKey == "cl" ? renC : accent
                value: sortKey == "pd" ? "${fmtNum(v, v >= 100 ? 0 : 1)} кВт·ч/день"
                  : sortKey == "pk" ? "${fmtNum(v * 1000)} МВт·ч/км²"
                  : sortKey == "cl" || sortKey == "sw" ? "${round(v * 100)}%"
                  : "${fmtNum(v, v >= 100 ? 0 : 1)} ТВт·ч"
                sub: sortKey == "E" ? "${fixed(c.E / W.E * 100, c.E / W.E < 0.1 ? 1 : 0)}% мировой выработки"
                  : sortKey == "U" ? "${fixed(c.U / W.U * 100, c.U / W.U < 0.1 ? 1 : 0)}% мирового потребления"
                  : sortKey == "pd" ? "на человека, ${fixed(c.pd / W.pd, 1)}× от среднего в мире"
                  : sortKey == "pk" ? "выработка на км², ${fixed(c.pk / W.pk, 1)}× от среднего в мире"
                  : sortKey == "cl" ? "из атомных и возобновляемых источников"
                  : sortKey == "sw" ? "от солнца и ветра"
                  : sortKey == "im" ? (c.net > 0 ? "чистый импорт, ${round(c.net / c.U * 100)}% от потребления" : "но экспорт больше: ${fmtNum(c.ex, c.ex >= 100 ? 0 : 1)} ТВт·ч")
                  : (c.net < 0 ? "чистый экспорт, ${round(-c.net / c.E * 100)}% от выработки" : "но импорт больше: ${fmtNum(c.im, c.im >= 100 ? 0 : 1)} ТВт·ч")
              }
            }
          }
        }

      } else {
        Column {
          weight: 1
          scroll: true
          gap: 12
          padding: [16, 4, 16, 16]

          if view == "world" {
            // ---------------------------------------------------------------- world
            let wg = [W.el[0] + W.el[1] + W.el[2], W.el[3], W.el[4] + W.el[5] + W.el[6] + W.el[7] + W.el[8]]
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Text { text: "В 2024 году в мире выработано"; style: small; color: muted }
              Text { spans: [{text: fmtNum(W.E), fontSize: 40, bold: true}, {text: " ТВт·ч", fontSize: 18, color: muted}] }
              Text { text: "электроэнергии: ${fmtNum(W.pd, 1)} кВт·ч в день на человека при населении ${fmtNum(W.pop, {compact: true})}"; style: small }
              Stack { vals: W.el; cols: ES; h: 18 }
              Legend { vals: W.el; srcs: ES }
            }

            Head { t: "Чистая энергия"; sub: "${round(W.cl * 100)}% из атомных и возобновляемых источников, ${round(W.sw * 100)}% только от солнца и ветра" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Stack { vals: wg; cols: GS; h: 18 }
              Legend { vals: wg; srcs: GS }
            }

            Head { t: "Крупнейшие производители"; sub: "Нажмите на страну, чтобы узнать больше" }
            Column {
              gap: 0
              for c, i in top key c.id {
                Ranked { c: c; i: i; f: c.E / top[0].E; mixBar: true; value: "${fmtNum(c.E)} ТВт·ч"; sub: "${fixed(c.E / W.E * 100, 0)}% от мирового объёма · ${fmtNum(c.pop, {compact: true})} чел." }
              }
            }

            Head { t: "Самая чистая электроэнергия"; sub: "доля атомной и возобновляемой энергии; население от миллиона человек" }
            Column {
              gap: 0
              for c, i in cleanest key c.id {
                Ranked { c: c; i: i; f: c.cl; tint: renC; value: "${round(c.cl * 100)}%"; sub: "${fmtNum(c.E, c.E >= 100 ? 0 : 1)} ТВт·ч в год" }
              }
            }

            Head { t: "Лидеры по солнцу и ветру"; sub: "доля солнца и ветра; население от миллиона человек" }
            Column {
              gap: 0
              for c, i in windy key c.id {
                Ranked { c: c; i: i; f: c.sw / windy[0].sw; tint: "#16A0A0"; value: "${round(c.sw * 100)}%"; sub: "${round(c.el[4] / c.E * 100)}% солнце · ${round(c.el[5] / c.E * 100)}% ветер" }
              }
            }

            Head { t: "Крупнейшие экспортёры"; sub: "продажи электроэнергии за вычетом покупок" }
            Column {
              gap: 0
              for c, i in exporters key c.id {
                Ranked { c: c; i: i; f: c.net / exporters[0].net; tint: expC; value: "${fmtNum(-c.net, -c.net >= 100 ? 0 : 1)} ТВт·ч"; sub: "${round(-c.net / c.E * 100)}% от выработки" }
              }
            }

            Head { t: "Крупнейшие импортёры"; sub: "покупки электроэнергии за вычетом продаж" }
            Column {
              gap: 0
              for c, i in importers key c.id {
                Ranked { c: c; i: i; f: c.net / importers[0].net; tint: impC; value: "${fmtNum(c.net, c.net >= 100 ? 0 : 1)} ТВт·ч"; sub: "${round(c.net / c.U * 100)}% от потребления" }
              }
            }

            Head { t: "Больше всего на человека"; sub: "страны с населением от миллиона человек" }
            Column {
              gap: 0
              for c, i in hungry key c.id {
                Ranked { c: c; i: i; f: c.pd / hungry[0].pd; value: "${fmtNum(c.pd)} кВт·ч/день"; sub: "${fixed(c.pd / W.pd, 1)}× от среднего в мире" }
              }
            }

          } else if view == "compare" {
            // ---------------------------------------------------------------- compare
            Row {
              gap: 8
              align: center
              Column {
                weight: 1
                gap: 2
                padding: [12, 10]
                background: alpha(accent, 0.12)
                border: 1
                borderColor: alpha(accent, 0.6)
                radius: 10 * corners
                onTap: picking = "a"
                Text { text: cA.f; fontSize: 32 }
                Text { text: cA.n; bold: true; maxLines: 1 }
                Text { text: "изменить"; style: small; color: accent }
              }
              Text { text: "⇄"; fontSize: 22; color: muted; width: 32; align: center; onTap: { cmpA = cB.id; cmpB = cA.id } }
              Column {
                weight: 1
                gap: 2
                padding: [12, 10]
                background: alpha(foreground, 0.06)
                border: 1
                borderColor: alpha(foreground, 0.35)
                radius: 10 * corners
                onTap: picking = "b"
                Text { text: cB.f; fontSize: 32 }
                Text { text: cB.n; bold: true; maxLines: 1 }
                Text { text: "изменить"; style: small; color: muted }
              }
            }

            Head { t: "Объёмы электроэнергии" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: "выработка"; a: cA.E; b: cB.E; ta: "${fmtNum(cA.E, cA.E >= 100 ? 0 : 1)} ТВт·ч"; tb: "${fmtNum(cB.E, cB.E >= 100 ? 0 : 1)} ТВт·ч" }
              Versus { label: "потребление"; a: cA.U; b: cB.U; ta: "${fmtNum(cA.U, cA.U >= 100 ? 0 : 1)} ТВт·ч"; tb: "${fmtNum(cB.U, cB.U >= 100 ? 0 : 1)} ТВт·ч" }
              Versus { label: "импорт"; a: cA.im; b: cB.im; ta: "${fmtNum(cA.im, cA.im >= 100 ? 0 : 1)} ТВт·ч"; tb: "${fmtNum(cB.im, cB.im >= 100 ? 0 : 1)} ТВт·ч" }
              Versus { label: "экспорт"; a: cA.ex; b: cB.ex; ta: "${fmtNum(cA.ex, cA.ex >= 100 ? 0 : 1)} ТВт·ч"; tb: "${fmtNum(cB.ex, cB.ex >= 100 ? 0 : 1)} ТВт·ч" }
            }

            Head { t: "С учётом размера страны" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: "население"; a: cA.pop; b: cB.pop; ta: fmtNum(cA.pop, {compact: true}); tb: fmtNum(cB.pop, {compact: true}) }
              Versus { label: "площадь"; a: cA.km2; b: cB.km2; ta: "${fmtNum(cA.km2, {compact: true})} км²"; tb: "${fmtNum(cB.km2, {compact: true})} км²" }
              Versus { label: "на человека"; a: cA.pd; b: cB.pd; ta: "${fmtNum(cA.pd, 1)} кВт·ч/день"; tb: "${fmtNum(cB.pd, 1)} кВт·ч/день" }
              Versus { label: "выработка на км²"; a: cA.pk; b: cB.pk; ta: "${fmtNum(cA.pk * 1000)} МВт·ч"; tb: "${fmtNum(cB.pk * 1000)} МВт·ч" }
            }

            Head { t: "Чистая энергия" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Versus { label: "атомная и возобновляемая"; a: cA.cl; b: cB.cl; ta: "${round(cA.cl * 100)}%"; tb: "${round(cB.cl * 100)}%" }
              Versus { label: "солнце и ветер"; a: cA.sw; b: cB.sw; ta: "${round(cA.sw * 100)}%"; tb: "${round(cB.sw * 100)}%" }
            }

            Head { t: "Источники электроэнергии" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Row { gap: 10; align: center; Text { text: cA.f; fontSize: 18 }; Column { weight: 1; Stack { vals: cA.el; cols: ES } } }
              Row { gap: 10; align: center; Text { text: cB.f; fontSize: 18 }; Column { weight: 1; Stack { vals: cB.el; cols: ES } } }
              Flow {
                gap: 12
                for s in ES {
                  Row { gap: 6; align: center; Box { width: 10; height: 10; radius: 5; background: s.c }; Text { text: s.l; style: small; color: muted } }
                }
              }
            }
            Row {
              gap: 8
              Button { text: "${cA.n}"; color: accent; onTap: openId = cA.id }
              Button { text: "${cB.n}"; color: muted; onTap: openId = cB.id }
            }

          } else {
            // ---------------------------------------------------------------- about
            Head { t: "Как читать показатели" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Column {
                gap: 2
                Text { text: "ТВт·ч"; bold: true; color: accent }
                Text { text: "Тераватт-час — это миллиард киловатт-часов. Дом потребляет около 10 кВт·ч в день, поэтому 1 ТВт·ч хватит примерно 270 тысячам домов на год."; style: small }
              }
              Column {
                gap: 2
                Text { text: "кВт·ч/день"; bold: true; color: accent }
                Text { text: "Всё потребление страны — домами, магазинами, заводами и поездами — в расчёте на одного жителя и день года. Чтобы вскипятить полный чайник, нужно около 0,1 кВт·ч."; style: small }
              }
              Column {
                gap: 2
                Text { text: "Выработка и потребление"; bold: true; color: accent }
                Text { text: "Выработка — электроэнергия, произведённая электростанциями, солнечными панелями и ветрогенераторами страны. Потребление равно выработке плюс импорт минус экспорт."; style: small }
              }
              Column {
                gap: 2
                Text { text: "Чистая энергия"; bold: true; color: accent }
                Text { text: "Электроэнергия из атомных и возобновляемых источников: солнца, ветра, воды, биомассы, тепла Земли и приливов. Ископаемое топливо — уголь, газ и нефть, сжигаемые на электростанциях."; style: small }
              }
              Column {
                gap: 2
                Text { text: "Импорт и экспорт"; bold: true; color: accent }
                Text { text: "Электроэнергия, передаваемая по линиям электропередачи из соседних стран и обратно. Многие страны и покупают, и продают её в разное время."; style: small }
              }
            }
            Head { t: "Источники данных" }
            Column {
              gap: 10
              padding: [14, 12]
              background: alpha(foreground, 0.05)
              radius: 10 * corners
              Text { text: "Выработка по источникам, импорт и экспорт для ${len(C)} стран за 2024 год взяты из международной статистики Управления энергетической информации США (EIA). Население и площадь — из данных Всемирного банка. Все данные встроены в приложение: оно работает без интернета."; style: small }
              Row {
                gap: 8
                Button { text: "Данные EIA"; color: accent; onTap: url("https://www.eia.gov/international/data/world") }
                Button { text: "Всемирный банк"; color: muted; onTap: url("https://data.worldbank.org") }
              }
            }
          }
        }
      }

      Box { height: 1; fill: width; background: alpha(muted, 0.25) }
      Row {
        gap: 0
        Tab { name: "world"; label: "Мир"; img: worldIcon }
        Tab { name: "countries"; label: "Страны"; img: rankIcon }
        Tab { name: "compare"; label: "Сравнить"; img: compareIcon }
        Tab { name: "about"; label: "Справка"; img: aboutIcon }
      }
    }
  }
}
