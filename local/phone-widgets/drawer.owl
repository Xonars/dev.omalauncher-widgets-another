panel "app drawer" {
  // The app drawer: swiping up on home opens it, above the prompt bar. It's a panel like any other, so it's yours to
  // change: ask your agent to edit it, or pick another panel in settings › gestures. .stock-drawer.owl next to it is
  // this file as the launcher ships it, kept up to date: compare the two to see what changed in a newer launcher.
  meta { description: "The launcher's app drawer, written in owl: your apps by kind, search as you type in the prompt bar, and each app's long-press menu"; version: "1.0"; license: "MIT"; category: "system"; owl: 15 }
  source d = android.drawer
  // The app whose long-press menu is open, by key, and the shortcuts it offers: null while they load, and the menu
  // waits for them, so it opens whole rather than growing.
  state menu = ""
  state menuShortcuts = null
  state tab = "personal"
  state section = ""
  state hiddenCategories = {} persist
  state categoryMenu = ""
  state categorySettings = false
  state categoryDrag = 0
  // The result picked with the arrow or Tab keys, -1 for the ask row; null follows the ranking.
  state pick = null

  // Fit readable cells to the current panel width, including after rotation.
  let cols = max(1, floor(((screenWidth ?? 400) - 24) / 96))
  let typed = trim(query)
  let searching = typed != ""
  let linuxApps = [
    "l:foot", "l:omarchy-files", "l:micro", "l:firefox",
    "l:agent-codex", "l:agent-hermes", "l:agent-opencode",
    "l:omawrite", "l:omarchy-voice", "l:space.rirusha.Cassette", "l:flowtunes",
    "l:org.qt-project.qtcreator", "l:loki",
    "l:chromium", "l:org.telegram.desktop", "l:streamtube", "l:codium", "l:btop",
    "l:org.gnome.Loupe", "l:org.gnome.Papers", "l:org.gnome.Calculator", "l:org.gnome.Calendar",
    "l:com.github.johnfactotum.Foliate", "l:mpv", "l:yazi", "l:lazygit", "l:org.kde.klevernotes",
    "l:org.kde.koko", "l:org.kde.audiotube", "l:io.github.alainm23.planify", "l:ncdu", "l:org.gnome.World.Secrets"
  ]
  let apps = d.apps.filter(a =>
    a.key != "a:com.TeamCherry.HollowKnight/com.unity3d.player.IconClassic" &&
    (a.kind != "linux" || contains(linuxApps, a.key))
  )
  let mine = apps.filter(a => (tab == "work") == (a.profile == "work"))
  let categories = [{key: "android", title: "Android"}, {key: "owl", title: "OWL"}, {key: "linux", title: "Linux"}]
  let shownCategories = categories.filter(c => !get(hiddenCategories, c.key, false))
  let tabs = shownCategories.filter(c => tab != "work" || c.key == "android")
  let tabKeys = tabs.map(c => c.key)
  let activeSection = contains(tabKeys, section) ? section : tabKeys[0]
  let categoryIndex = indexOf(tabKeys, activeSection)
  let sections = tab == "work" ? [
    {kind: "android", title: "Ярлыки", apps: mine.filter(a => a.kind == "shortcut")},
    {kind: "android", title: d.work.paused ? "Рабочие · пауза" : "Рабочие приложения", apps: mine.filter(a => a.kind == "android"), work: true}
  ] : [
    {kind: "owl", title: "OWL", apps: mine.filter(a => a.kind == "owl")},
    {kind: "linux", title: "Linux", apps: mine.filter(a => a.kind == "linux"), linux: true},
    {kind: "android", title: "Ярлыки", apps: mine.filter(a => a.kind == "shortcut")},
    {kind: "android", title: "Android", apps: mine.filter(a => a.kind == "android")}
  ]
  // A title, then rows of cols apps. Without Linux, its section is an offer to install it.
  let rows = flatten(sections.filter(s => s.kind == activeSection && (len(s.apps) > 0 || s.work || (s.linux && !linux))).map(s => flatten([
      (s.work || (s.linux && !linux)) ? [{key: "h:" + s.title, title: s.work ? s.title : "Linux", work: s.work, offer: s.linux && !linux}] : [],
      chunk(s.apps, cols).map((cells, r) => {key: s.title + ":" + r, cells: cells})
    ])))
  // Every profile's apps match while typing, best first; the list runs up from the bar, so the best sits right above it.
  let hits = searching ? rank(apps, typed) : []
  let hitRows = chunk(hits, cols).map((cells, r) => {key: "q:" + r, start: r * cols, cells: cells})
  // Enter opens the best match when it names an app well, as the bar does; anything else, a prompt of more lines among it, goes to the agent.
  let opens = len(hits) > 0
  // What Enter acts on: a result by its place in hits, or -1 for the ask row.
  let chosen = pick ?? (opens ? 0 : -1)
  // With a keyboard: Up and Tab move the pick away from the bar, Down and Shift+Tab back; the ask row sits lowest.
  onKey: {
    if searching {
      pick = clamp(chosen + (value == "up" || value == "tab" ? 1 : -1), 0, len(hits) - 1)
    }
  }
  let labels = {pin: "На главный экран", info: "О приложении", uninstall: "Удалить приложение", remove: "Убрать", edit: "Изменить", share: "Поделиться"}

  // Typing starts the pick over, at the best match.
  on typed { pick = null; if typed == "" { section = ""; tab = "personal" } }

  // How much the drawer covers home: near-opaque, as home's widgets showing through make the icons hard to read.
  opacity: 1
  keyboard: false
  enter: searching && opens ? "▸ Открыть" : ""
  // An empty bar's Enter does nothing, as on home.
  onSubmit: {
    if searching && len(hits) > 0 && chosen >= 0 {
      section = ""
      tab = "personal"
      open(hits[chosen].key)
    }
  }

  // An app's icon as the drawer draws it: its own, its silhouette on a badge with monochrome icons, or its initials.
  component AppIcon(a) {
    Box {
      size: 52
      align: center
      radius: 26 * corners
      background: a.hasIcon && !d.monochrome ? transparent : surface
      if a.hasIcon {
        Image { src: a.icon; size: d.monochrome ? 36 : 52; tint: d.monochrome ? accent : null; label: a.label }
      } else {
        Text { text: a.initials; fontSize: 18; color: accent }
      }
    }
  }

  component Cell(a, picked) {
    Column {
      weight: 1
      align: center
      gap: 3
      padding: [2, 3]
      radius: 16 * corners
      border: picked ? 2 : 0
      borderColor: accent
      // Paused work apps show dimmed; opening one turns work apps back on.
      opacity: a.paused ? 0.4 : 1
      onTap: { section = ""; tab = "personal"; open(a.key) }
      onLongPress: {
        haptic()
        menuShortcuts = null
        menu = a.key
        menuShortcuts = shortcuts(a.key)
      }
      AppIcon { a: a }
      // Two lines keep names readable and rows equally tall.
      Text { text: a.name; fontSize: 13; align: center; maxLines: 2; minLines: 2; fill: width }
      if menu == a.key && menuShortcuts != null {
      Popup {
        visible: true
        position: above
        onDismiss: menu = ""
        width: 200
        gap: 0
        // The app's shortcuts first, as stock launchers list them: tap to open, + to put one on home.
        for s in menuShortcuts key s.key {
          Row {
            fill: width
            align: center
            gap: 10
            padding: [12, 6]
            onTap: { menu = ""; open(s.key) }
            Image { src: s.icon; size: 24; tint: d.monochrome ? accent : null; label: s.name }
            Text { text: s.name; weight: 1; maxLines: 1 }
            Text { text: "[+]"; color: accent; onTap: { menu = ""; appAction("pin", s.key) } }
          }
        }
        Spacer { visible: len(menuShortcuts) > 0; height: 1; fill: width; background: border }
        for w in a.actions {
          Text { text: get(labels, w, w); fontSize: 15; fill: width; padding: [12, 12]; onTap: { menu = ""; appAction(w, a.key) } }
        }
      }
      }
    }
  }

  Column {
    fill: true
    gap: 0
    padding: [12, 0]
    Row {
      visible: d.work != null && !searching
      align: center
      padding: [0, 12, 0, 8]
      gap: 0
      // Typing searches every profile, so the tabs step aside.
      for t in d.work != null && !searching ? ["personal", "work"] : [] {
        Text { text: t == "work" ? "Рабочие" : "Личные"; color: tab == t ? accent : muted; background: tab == t ? surface : transparent; radius: 18 * corners; padding: [14, 10]; onTap: tab = t }
      }

    }
    Column {
      visible: !searching
      lazy: true
      weight: 1
      fill: width
      gap: 0
      for row in rows key row.key {
        if row.title != null {
          // A section's title, with the work switch or the offer to install Linux at its end.
          Row {
            fill: width
            gap: 0
            align: center
            padding: [8, 12, 0, 4]
            Text { text: row.title; color: muted; weight: 1 }
            Text { text: d.work.paused ? "Включить" : "Пауза"; visible: row.work == true; color: accent; onTap: workApps("toggle") }
            Text { text: d.linux == "installing" ? "[installing…]" : "[install linux]"; visible: row.offer == true; color: accent; onTap: launcher("linux") }
          }
        } else {
          Row {
            fill: width
            gap: 0
            for a in row.cells key a.key { Cell { a: a; picked: false } }
            // A short last row keeps its cells the width of the others'.
            for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
          }
        }
      }
    }
    Column {
      visible: searching
      lazy: true
      reverse: true
      weight: 1
      fill: width
      gap: 0
      for row in hitRows key row.key {
        Row {
          fill: width
          gap: 0
          for a, i in row.cells key a.key { Cell { a: a; picked: row.start + i == chosen } }
          for s in range(0, cols - len(row.cells)) { Spacer { weight: 1 } }
        }
      }
    }
    Text {
      visible: searching && len(hits) == 0
      text: "Ничего не найдено"
      align: center
      color: muted
      padding: [12, 20]
    }
    Text {
      visible: !searching && len(tabs) == 0
      text: len(shownCategories) == 0 ? "Все категории скрыты" : "Категория Android скрыта"
      fill: width
      align: center
      color: muted
      padding: [12, 20]
    }
    Row {
      fill: width
      align: center
      gap: 4
      padding: [0, 8, 0, 0]
      drag: horizontal
      onDrag: { categoryDrag = categoryDrag + dx }
      onDragEnd: {
        if len(tabs) > 1 && menu == "" && categoryMenu == "" && !categorySettings &&
            (abs(categoryDrag) > 56 || abs(vx) > 700 && sign(vx) == sign(categoryDrag)) {
          section = tabKeys[clamp(categoryIndex + (categoryDrag < 0 ? 1 : -1), 0, len(tabs) - 1)]
          pick = null
        }
        categoryDrag = 0
      }
      for c in len(tabs) > 1 ? tabs : [] key c.key {
        Box {
          weight: 1
          Text {
            text: c.title
            fill: width
            align: center
            fontSize: 14
            color: activeSection == c.key ? accent : muted
            background: activeSection == c.key ? surface : transparent
            radius: 18 * corners
            padding: [4, 12]
            onTap: { section = c.key; pick = null }
            onLongPress: categoryMenu = c.key
          }
          if categoryMenu == c.key {
            Popup {
              visible: true
              position: above
              width: 160
              onDismiss: categoryMenu = ""
              Text {
                text: "Скрыть " + c.title
                fill: width
                padding: [14, 14]
                onTap: {
                  categoryMenu = ""
                  if section == c.key { section = "" }
                  hiddenCategories = set(hiddenCategories, c.key, true)
                }
              }
            }
          }
        }
      }
      if len(tabs) <= 1 { Spacer { weight: 1 } }
      Box {
        Text {
          text: "⚙"
          font: sans
          fontSize: 21
          color: accent
          align: center
          width: 44
          padding: [0, 10]
          onTap: categorySettings = true
        }
        if categorySettings {
          Popup {
            visible: true
            position: above
            onDismiss: categorySettings = false
            width: 200
            gap: 0
            Text { text: "Показывать категории"; fontWeight: 600; padding: [12, 10] }
            for c in categories key c.key {
              let hidden = get(hiddenCategories, c.key, false)
              Row {
                fill: width
                align: center
                gap: 8
                padding: [12, 12]
                onTap: {
                  if !hidden && section == c.key { section = "" }
                  hiddenCategories = set(hiddenCategories, c.key, !hidden)
                }
                Text { text: hidden ? "☐" : "☑"; font: sans; fontSize: 18; color: hidden ? muted : accent }
                Text { text: c.title; fontSize: 15 }
              }
            }
          }
        }
      }
    }
  }
}
