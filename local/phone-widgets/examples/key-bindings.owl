app "Key Bindings" {
 meta { owl: 17; description: "Клавиатура, сочетания и диагностика ввода"; version: "2.0" }
 title: ""
 icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"><rect x="3" y="10" width="42" height="28" rx="4"/><path d="M10 18h2m6 0h2m6 0h2m6 0h3M10 25h2m6 0h2m6 0h2m6 0h3M13 32h22"/></svg>"""
 // OMA Another hardware-key extension; upstream OWL version is unchanged.
 state event = null
 state pressed = []
 state count = 0
 state recent = []
 state capturing = false
 state searchFocus = false
 captureKeys: capturing
 onKeyDown: {
  pressed = value.pressed
  event = value
  count = count + 1
  if value.repeat == 0 { recent = ([value.combo] + recent).take(8) }
  if !capturing && value.ctrl && value.key == "F" && value.repeat == 0 { searchFocus = true }
 }
 onKeyUp: { pressed = value.pressed; count = count + 1; searchFocus = false }
 state query = ""
 let caps = [{"label": "ESC", "x": 0.0, "w": 0.07692307692307693, "row": 0, "key": "ESC"}, {"label": "F1", "x": 0.07692307692307693, "w": 0.07692307692307693, "row": 0, "key": "F1"}, {"label": "F2", "x": 0.15384615384615385, "w": 0.07692307692307693, "row": 0, "key": "F2"}, {"label": "F3", "x": 0.23076923076923078, "w": 0.07692307692307693, "row": 0, "key": "F3"}, {"label": "F4", "x": 0.3076923076923077, "w": 0.07692307692307693, "row": 0, "key": "F4"}, {"label": "F5", "x": 0.38461538461538464, "w": 0.07692307692307693, "row": 0, "key": "F5"}, {"label": "F6", "x": 0.46153846153846156, "w": 0.07692307692307693, "row": 0, "key": "F6"}, {"label": "F7", "x": 0.5384615384615384, "w": 0.07692307692307693, "row": 0, "key": "F7"}, {"label": "F8", "x": 0.6153846153846154, "w": 0.07692307692307693, "row": 0, "key": "F8"}, {"label": "F9", "x": 0.6923076923076923, "w": 0.07692307692307693, "row": 0, "key": "F9"}, {"label": "F10", "x": 0.7692307692307693, "w": 0.07692307692307693, "row": 0, "key": "F10"}, {"label": "F11", "x": 0.8461538461538461, "w": 0.07692307692307693, "row": 0, "key": "F11"}, {"label": "F12", "x": 0.9230769230769231, "w": 0.07692307692307693, "row": 0, "key": "F12"}, {"label": "`", "x": 0.0, "w": 0.06802721088435375, "row": 1, "key": "`"}, {"label": "1", "x": 0.06802721088435375, "w": 0.06802721088435375, "row": 1, "key": "1"}, {"label": "2", "x": 0.1360544217687075, "w": 0.06802721088435375, "row": 1, "key": "2"}, {"label": "3", "x": 0.20408163265306123, "w": 0.06802721088435375, "row": 1, "key": "3"}, {"label": "4", "x": 0.272108843537415, "w": 0.06802721088435375, "row": 1, "key": "4"}, {"label": "5", "x": 0.3401360544217687, "w": 0.06802721088435375, "row": 1, "key": "5"}, {"label": "6", "x": 0.40816326530612246, "w": 0.06802721088435375, "row": 1, "key": "6"}, {"label": "7", "x": 0.4761904761904762, "w": 0.06802721088435375, "row": 1, "key": "7"}, {"label": "8", "x": 0.54421768707483, "w": 0.06802721088435375, "row": 1, "key": "8"}, {"label": "9", "x": 0.6122448979591837, "w": 0.06802721088435375, "row": 1, "key": "9"}, {"label": "0", "x": 0.6802721088435374, "w": 0.06802721088435375, "row": 1, "key": "0"}, {"label": "-", "x": 0.7482993197278912, "w": 0.06802721088435375, "row": 1, "key": "-"}, {"label": "=", "x": 0.8163265306122449, "w": 0.06802721088435375, "row": 1, "key": "="}, {"label": "BKSP", "x": 0.8843537414965987, "w": 0.11564625850340136, "row": 1, "key": "BKSP"}, {"label": "TAB", "x": 0.0, "w": 0.11564625850340136, "row": 2, "key": "TAB"}, {"label": "Q", "x": 0.11564625850340136, "w": 0.06802721088435375, "row": 2, "key": "Q"}, {"label": "W", "x": 0.1836734693877551, "w": 0.06802721088435375, "row": 2, "key": "W"}, {"label": "E", "x": 0.25170068027210885, "w": 0.06802721088435375, "row": 2, "key": "E"}, {"label": "R", "x": 0.3197278911564626, "w": 0.06802721088435375, "row": 2, "key": "R"}, {"label": "T", "x": 0.38775510204081637, "w": 0.06802721088435375, "row": 2, "key": "T"}, {"label": "Y", "x": 0.4557823129251701, "w": 0.06802721088435375, "row": 2, "key": "Y"}, {"label": "U", "x": 0.5238095238095238, "w": 0.06802721088435375, "row": 2, "key": "U"}, {"label": "I", "x": 0.5918367346938775, "w": 0.06802721088435375, "row": 2, "key": "I"}, {"label": "O", "x": 0.6598639455782312, "w": 0.06802721088435375, "row": 2, "key": "O"}, {"label": "P", "x": 0.7278911564625851, "w": 0.06802721088435375, "row": 2, "key": "P"}, {"label": "[", "x": 0.7959183673469388, "w": 0.06802721088435375, "row": 2, "key": "["}, {"label": "]", "x": 0.8639455782312925, "w": 0.06802721088435375, "row": 2, "key": "]"}, {"label": "\\", "x": 0.9319727891156463, "w": 0.06802721088435375, "row": 2, "key": "\\"}, {"label": "CAPS", "x": 0.0, "w": 0.11805555555555555, "row": 3, "key": "CAPS"}, {"label": "A", "x": 0.11805555555555555, "w": 0.06944444444444445, "row": 3, "key": "A"}, {"label": "S", "x": 0.1875, "w": 0.06944444444444445, "row": 3, "key": "S"}, {"label": "D", "x": 0.2569444444444445, "w": 0.06944444444444445, "row": 3, "key": "D"}, {"label": "F", "x": 0.3263888888888889, "w": 0.06944444444444445, "row": 3, "key": "F"}, {"label": "G", "x": 0.3958333333333333, "w": 0.06944444444444445, "row": 3, "key": "G"}, {"label": "H", "x": 0.4652777777777778, "w": 0.06944444444444445, "row": 3, "key": "H"}, {"label": "J", "x": 0.5347222222222222, "w": 0.06944444444444445, "row": 3, "key": "J"}, {"label": "K", "x": 0.6041666666666666, "w": 0.06944444444444445, "row": 3, "key": "K"}, {"label": "L", "x": 0.673611111111111, "w": 0.06944444444444445, "row": 3, "key": "L"}, {"label": ";", "x": 0.7430555555555555, "w": 0.06944444444444445, "row": 3, "key": ";"}, {"label": "'", "x": 0.8124999999999999, "w": 0.06944444444444445, "row": 3, "key": "'"}, {"label": "ENTER", "x": 0.8819444444444444, "w": 0.11805555555555555, "row": 3, "key": "ENTER"}, {"label": "SHIFT", "x": 0.0, "w": 0.12686567164179105, "row": 4, "key": "SHIFT_LEFT"}, {"label": "Z", "x": 0.12686567164179105, "w": 0.07462686567164178, "row": 4, "key": "Z"}, {"label": "X", "x": 0.20149253731343283, "w": 0.07462686567164178, "row": 4, "key": "X"}, {"label": "C", "x": 0.27611940298507465, "w": 0.07462686567164178, "row": 4, "key": "C"}, {"label": "V", "x": 0.35074626865671643, "w": 0.07462686567164178, "row": 4, "key": "V"}, {"label": "B", "x": 0.4253731343283582, "w": 0.07462686567164178, "row": 4, "key": "B"}, {"label": "N", "x": 0.5, "w": 0.07462686567164178, "row": 4, "key": "N"}, {"label": "M", "x": 0.5746268656716418, "w": 0.07462686567164178, "row": 4, "key": "M"}, {"label": ",", "x": 0.6492537313432835, "w": 0.07462686567164178, "row": 4, "key": ","}, {"label": ".", "x": 0.7238805970149254, "w": 0.07462686567164178, "row": 4, "key": "."}, {"label": "/", "x": 0.7985074626865671, "w": 0.07462686567164178, "row": 4, "key": "/"}, {"label": "SHIFT", "x": 0.8731343283582089, "w": 0.12686567164179105, "row": 4, "key": "SHIFT_RIGHT"}, {"label": "CTRL", "x": 0.0, "w": 0.1, "row": 5, "key": "CTRL_LEFT"}, {"label": "SUPER", "x": 0.1, "w": 0.1, "row": 5, "key": "SUPER_LEFT"}, {"label": "ALT", "x": 0.2, "w": 0.1, "row": 5, "key": "ALT_LEFT"}, {"label": "SPACE", "x": 0.3, "w": 0.4, "row": 5, "key": "SPACE"}, {"label": "ALT", "x": 0.7, "w": 0.1, "row": 5, "key": "ALT_RIGHT"}, {"label": "SUPER", "x": 0.8, "w": 0.1, "row": 5, "key": "SUPER_RIGHT"}, {"label": "CTRL", "x": 0.9, "w": 0.1, "row": 5, "key": "CTRL_RIGHT"}, {"label": "INS", "x": 0.0, "w": 0.1, "row": 6, "key": "INS"}, {"label": "HOME", "x": 0.1, "w": 0.1, "row": 6, "key": "HOME"}, {"label": "PGUP", "x": 0.2, "w": 0.1, "row": 6, "key": "PGUP"}, {"label": "DEL", "x": 0.3, "w": 0.1, "row": 6, "key": "DEL"}, {"label": "END", "x": 0.4, "w": 0.1, "row": 6, "key": "END"}, {"label": "PGDN", "x": 0.5, "w": 0.1, "row": 6, "key": "PGDN"}, {"label": "LEFT", "x": 0.6, "w": 0.1, "row": 6, "key": "LEFT"}, {"label": "DOWN", "x": 0.7, "w": 0.1, "row": 6, "key": "DOWN"}, {"label": "UP", "x": 0.8, "w": 0.1, "row": 6, "key": "UP"}, {"label": "RIGHT", "x": 0.9, "w": 0.1, "row": 6, "key": "RIGHT"}]
 let bindings = [{"combo": "CTRL + F", "name": "Перейти к поиску сочетаний в обычном режиме.", "codes": ["CTRL + F"], "scope": "Key Bindings"}, {"combo": "DELETE", "name": "Удалить выбранный виджет. Сначала выберите его; закройте открытые меню.", "codes": ["DEL"], "scope": "Рабочий стол"}, {"combo": "INSERT", "name": "Открыть меню добавления на рабочий стол.", "codes": ["INS"], "scope": "Рабочий стол"}, {"combo": "↑ ↓ ← →", "name": "Перемещать фокус между виджетами и элементами интерфейса.", "codes": ["UP", "DOWN", "LEFT", "RIGHT"], "scope": "Рабочий стол"}, {"combo": "ESC", "name": "Назад: закрыть текущее окно, меню или панель.", "codes": ["ESC"], "scope": "Рабочий стол"}, {"combo": "SUPER + D", "name": "Открыть / закрыть меню приложений", "codes": ["SUPER + D"], "scope": "Домашний экран"}, {"combo": "SUPER + SPACE", "name": "Меню приложений · если Android пропускает", "codes": ["SUPER + SPACE"], "scope": "Домашний экран"}, {"combo": "SUPER + T", "name": "Открыть терминал", "codes": ["SUPER + T"], "scope": "Домашний экран"}, {"combo": "SUPER + ENTER", "name": "Терминал · если Android пропускает", "codes": ["SUPER + ENTER"], "scope": "Домашний экран"}, {"combo": "SUPER + DOWN", "name": "Открыть / закрыть верхнюю панель", "codes": ["SUPER + DOWN"], "scope": "Домашний экран"}, {"combo": "SUPER + A", "name": "Перейти к строке запроса", "codes": ["SUPER + A"], "scope": "Домашний экран"}, {"combo": "SUPER + 1…9", "name": "Перейти на страницу домашнего экрана", "codes": ["SUPER + 1…9"], "scope": "Домашний экран"}]
 let matched = bindings.find(b => contains(b.codes, event.combo ?? ""))
 let filtered = bindings.filter(b => contains(lower(b.combo + " " + join(b.codes, " ") + " " + b.name + " " + b.scope), lower(query)))
 Column {
  fill: true; padding: 16; gap: 12; scroll: true
  Row {
   Column { weight: 1; gap: 2
    Text { text: "Keybindings"; font: mono; fontSize: 25 }
    Text { text: "КЛАВИАТУРА / ДИАГНОСТИКА"; fontSize: 10; color: muted; letterSpacing: 2 }
   }
   Text { text: "${count} событий"; font: mono; color: accent; fontSize: 11 }
  }
  Canvas {
   fill: width; height: 224
   for k in caps {
    let hot = contains(pressed, k.key)
    rect(k.x * width + 2, k.row * 28 + 2, k.w * width - 4, 24, radius: 3, fill: hot ? accent : alpha(foreground, 0.035), stroke: hot ? accent : alpha(foreground, 0.25), width: 1)
    text(k.label, (k.x + k.w / 2) * width, k.row * 28 + 14, size: min(9, width / 50), align: center, color: hot ? background : foreground, font: mono)
   }
   text("ФИЗИЧЕСКИЕ КЛАВИШИ · НАЖАТИЕ / ОТПУСКАНИЕ", width / 2, 216, size: 10, align: center, color: muted, font: mono)
  }
  Column { padding: 12; border: 1; borderColor: alpha(accent, 0.5); radius: 6; gap: 5
   Text { text: event.combo ?? "Ожидание клавиши"; font: mono; fontSize: 19; color: accent }
   if matched != null {
    Text { text: matched.name; fontSize: 12 }
    Text { text: "Контекст: ${matched.scope}"; fontSize: 10; color: muted }
   }
   Text { text: "KEY ${event.keyCode ?? "—"} · SCAN ${event.scanCode ?? "—"} · REPEAT ${event.repeat ?? 0}"; font: mono; fontSize: 10; color: muted }
   Text { text: event.device ?? "Подключите физическую клавиатуру"; fontSize: 10; color: muted }
   Text { text: "Удерживаются: ${len(pressed) == 0 ? "—" : join(pressed, " + ")}"; font: mono; fontSize: 11 }
  }
  Text { text: "01  РЕЖИМ КЛАВИАТУРЫ"; color: muted; font: mono; fontSize: 11 }
  Text { text: "В обычном режиме стрелки и Tab управляют интерфейсом, Esc — назад. В режиме теста клавиши подсвечиваются, пока удерживаются; Esc тоже проверяется."; fontSize: 12 }
  Row { wrap: true; gap: 8
   Button { text: capturing ? "Остановить тест" : "Тест клавиатуры"; onTap: { capturing = !capturing; searchFocus = false } }
   Button { text: "Закрыть"; onTap: close() }
  }
  Text { text: capturing ? "ТЕСТ: ввод перехватывается этим окном" : "НАВИГАЦИЯ · Ctrl+F — поиск"; color: capturing ? accent : muted; fontSize: 11 }
  Text { text: "02  ШОРТКАТЫ · РАБОЧИЙ СТОЛ И ЛАУНЧЕР"; color: muted; font: mono; fontSize: 11 }
  Input { focus: searchFocus; text: query; placeholder: "Поиск сочетания или действия…"; onChange: query = value }
  for b in filtered {
   Column { gap: 4; padding: 8; fill: width; radius: 5
    background: contains(b.codes, event.combo ?? "") ? alpha(accent, 0.12) : alpha(accent, 0)
    Text { text: b.scope; fontSize: 10; color: muted }
    Text { text: b.combo; font: mono; color: accent; fontSize: 12 }
    Text { text: b.name; fontSize: 12 }
   }
  }
  if len(filtered) == 0 { Text { text: "Ничего не найдено"; color: muted } }
  Text { text: "03  ПОСЛЕДНИЕ СОБЫТИЯ"; color: muted; font: mono; fontSize: 11 }
  for h in recent { Text { text: h; font: mono; fontSize: 12 } }
  Text { text: "Нативный ввод OMA Another: Linux не нужен. Delete и Insert здесь только проверяются — их действия относятся к рабочему столу. Системные сочетания, перехваченные Android, приложению не доступны. При смене окна подсветка сбрасывается."; fontSize: 11; color: muted }
  Spacer { height: 16 }
 }
}
