app "OMA · обновление" {
  meta { owl: 10 }
  title: "OMA · репозиторий и APK"
  icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M39 18A16 16 0 0 0 11 12L6 18m0-11v11h11M9 30a16 16 0 0 0 28 6l5-6m0 11V30H31"/></svg>'
  requires { pacman: ["python", "git", "patch", "curl", "libarchive", "make", "perl", "jdk25-openjdk", "bash", "coreutils", "sed", "gawk", "grep", "binutils", "cmake", "ninja", "glibc"] }
  source sys = android.system every 1m
  source now = clock every 1s
  source job = file("/root/.cache/oma-updater/status.json") json
  source health = cmd("python /root/.local/share/oma-updater/updater.py status") every 5s json
  source log = cmd("tail -c 4500 /root/.cache/oma-updater/build.log 2>/dev/null") every 10s
  source commits = cmd("git -C /root/dev.omalauncher-another log --no-decorate --format='%h %s' -n 8 ${sh(health.built_commit ?? 'origin/main')}..origin/main") every 30s

  state tab = "Обзор"
  state selectedRef = "origin/main"
  state commitMode = "Свои"
  state syncOutput = ""
  state syncing = false
  state syncAt = 0
  source repo = cmd("python /root/.config/omalauncher/widgets/oma-update/repository.py --ref ${sh(selectedRef)}") every 30s json timeout 30s
  let repoOk = repo != null && repo.error == ""
  let visibleCommits = commitMode == "Свои" ? repo.own : commitMode == "Симон" ? repo.incoming : repo.recent
  on syncOutput {
    if value != "" {
      syncing = false
      refresh()
    }
  }
  when syncing && now - syncAt > 260 {
    syncing = false
    syncOutput = "Превышено время проверки сети. Повторите попытку."
  }
  state requestedAction = ""
  state requestedAt = 0
  state previousUpdate = 0
  state actionOutput = ""
  state actionError = ""
  state details = false
  state downloadResult = ""
  state openingDownload = false
  state downloadAt = 0
  let status = (job.updated ?? 0) >= (health.updated ?? 0) ? job : health
  let busy = requestedAction != "" || status.phase == "busy"
  let failed = status.phase == "error" || actionError != ""
  let checking = requestedAction == "check" || (requestedAction != "build" && status.phase == "busy" && (status.action == "check" || (status.action == null && contains(status.message ?? "", "Проверка upstream"))))
  let stages = [
    {title: "Проверка исходников", info: "Получаем origin/main вашего форка с GitHub и определяем версию для сборки."},
    {title: "Резервная копия", info: "Сохраняем настройки и виджеты перед сборкой."},
    {title: "Подготовка к сборке", info: "Подготавливаем исходники, инструменты и библиотеки Linux. Может потребоваться скачивание файлов."},
    {title: "Сборка и тесты", info: "Создаём APK, запускаем тесты и проверку кода. Это самый долгий этап; он может занять десятки минут."},
    {title: "Проверка APK", info: "Проверяем библиотеки и подпись, сохраняем APK для скачивания."}
  ]
  let buildStage = requestedAction == "build" ? 1 : clamp(status.stage ?? 1, 1, 6)
  let showBuild = (busy && !checking) || (status.action != null && status.action != "check" && (failed || status.phase == "ready") && status.stage > 0)
  let operationStart = busy && requestedAction != "" ? requestedAt : (status.started_at ?? requestedAt)
  let buildElapsed = max(0, (busy ? now : (status.finished_at ?? now)) - operationStart)
  let stageElapsed = max(0, now - (requestedAction != "" ? requestedAt : (status.stage_started ?? requestedAt)))
  let elapsed = max(0, now - requestedAt)
  let available = repoOk && health.built_commit != null ? !startsWith(health.built_commit, repo.fork) : status.available == true
  let apkReady = health.apk_exists == true
  let remoteCommit = status.remote ?? ""
  let installedCommit = match(sys.launcher ?? "", "-g([0-9a-f]+)")[0]
  let installedLatest = installedCommit != null && installedCommit == remoteCommit

  // Show the request immediately; file updates report the worker stage.
  when requestedAction != "" && status != null && status.updated != previousUpdate && elapsed >= 1 {
    requestedAction = ""
  }
  when requestedAction != "" && elapsed >= 150 {
    requestedAction = ""
    actionError = "Нет ответа от Linux. Откройте журнал и повторите попытку."
  }
  on actionOutput {
    if value != "" && value != "ok" {
      requestedAction = ""
      actionError = value
    }
  }
  when openingDownload && now - downloadAt > 20 {
    openingDownload = false
    notify("OMA · скачивание", "Нет ответа APK Share. Повторите попытку.")
  }
  on downloadResult {
    if value != "" {
      openingDownload = false
      if parseJson(value).status == "Running" && health.apk != null {
        url("http://127.0.0.1:8765/apk/${enc(last(split(health.apk, '/')))}")
      } else {
        notify("OMA · скачивание", parseJson(value).error ?? "Не удалось запустить APK Share. Повторите попытку.")
      }
    }
  }

  Column { scroll: true; padding: [12, 0]; gap: 14
    Row { gap: 6; wrap: true
      for name in ["Обзор", "Коммиты", "Ветки", "Отличия", "APK"] {
        Button { text: tab == name ? "● ${name}" : name; onTap: tab = name }
      }
    }
    if tab != "APK" {
      Column { padding: 12; gap: 8; background: surface; radius: 8
        Text { text: "${selectedRef} ↔ Simon / main"; bold: true; maxLines: 2 }
        if repoOk {
          Text { text: repo.behind == 0 ? (repo.ahead == 0 ? "Истории совпадают" : "Все коммиты Симона включены") : "Есть изменения Симона для интеграции"; color: repo.behind == 0 ? green : yellow; maxLines: 3 }
          Row { gap: 16
            Column { weight: 1; gap: 3
              Text { text: "+${repo.ahead}"; style: title; color: accent }
              Text { text: "своих коммитов"; style: small; color: muted }
            }
            Column { weight: 1; gap: 3
              Text { text: "${repo.behind}"; style: title; color: repo.behind > 0 ? yellow : green }
              Text { text: "не включено от Симона"; style: small; color: muted; maxLines: 2 }
            }
          }
          Text { text: "Выбрано ${repo.hash} · Симон ${repo.upstream}"; style: small; color: muted }
        } else { Text { text: repo.error ?? "Читаем репозиторий…"; color: yellow; maxLines: 5 } }
        Text { text: repo.sync.upstream != null ? "Симон: получено ${fmtTime(repo.sync.upstream, 'dd.MM HH:mm')}" : "Данные локальные · обновите с GitHub"; style: small; color: muted }
        Text { text: repo.sync.origin != null ? "Форк: получено ${fmtTime(repo.sync.origin, 'dd.MM HH:mm')}" : "Форк ещё не проверен по сети"; style: small; color: muted }
        if syncing {
          Text { text: "● Получаем ветки GitHub… ${fmtDuration(now - syncAt)}"; color: accent; style: small; maxLines: 2 }
        } else {
          Button { text: "Обновить оба репозитория"; onTap: {
            syncOutput = ""
            syncing = true
            syncAt = now
            syncOutput = run("python /root/.config/omalauncher/widgets/oma-update/repository.py --fetch")
          } }
        }
        if (repo.sync.error ?? "") != "" { Text { text: repo.sync.error; style: small; color: red; maxLines: 6 } }
        if contains(syncOutput, "Превышено") { Text { text: syncOutput; style: small; color: red; maxLines: 3 } }
      }
    }
    if tab == "Обзор" {
      Column { padding: 12; gap: 6; background: surface; radius: 8
        Text { text: busy ? (checking ? "● Проверка сборки…" : "● Сборка APK · этап ${buildStage}/5") : failed ? "Ошибка последней операции" : apkReady ? "✓ Сохранённый APK доступен" : "APK ещё не собран"; color: failed ? red : busy ? accent : green; bold: true; maxLines: 2 }
        Text { text: "На телефоне: ${sys.launcher ?? '…'}"; style: small; color: muted; maxLines: 2 }
        if apkReady { Text { text: "APK: ${health.built_version ?? '…'}"; style: small; color: muted; maxLines: 2 } }
        if repoOk && health.built_commit != null { Text { text: startsWith(health.built_commit, repo.fork) ? "APK соответствует origin/main" : "origin/main отличается от сохранённого APK"; style: small; color: accent; maxLines: 2 } }
        Button { text: busy ? "Ход операции и журнал" : "Открыть сборку и APK"; onTap: tab = "APK" }
      }
    }
    if tab == "Обзор" && repoOk {
      Column { gap: 8
        Text { text: "Локально → опубликованный форк"; bold: true }
        Text { text: "Ветка ${repo.head} · +${repo.published.ahead} локальных / ${repo.published.behind} недостающих коммитов относительно origin/main"; style: small; maxLines: 3 }
        Text { text: repo.dirty == "" ? "✓ Рабочая папка чистая" : "Есть несохранённые в Git изменения"; color: repo.dirty == "" ? green : yellow; style: small }
        if repo.dirty != "" { Text { text: repo.dirty; style: small; maxLines: 8 } }
        Text { text: "${repo.summary == '' ? 'Файлы совпадают' : repo.summary}"; style: small; maxLines: 3 }
        Text { text: "Счётчики сравнивают историю Git. Среди своих коммитов могут быть merge и изменения, уже перенесённые другим коммитом."; style: small; color: muted; maxLines: 4 }
        Row { gap: 8; wrap: true
          Button { text: "Свои коммиты"; onTap: { commitMode = "Свои"; tab = "Коммиты" } }
          Button { text: "Изменения Симона"; onTap: { commitMode = "Симон"; tab = "Коммиты" } }
          Button { text: "Сборка и журнал"; onTap: tab = "APK" }
        }
      }
    }
    if tab == "Коммиты" && repoOk {
      Row { gap: 6; wrap: true
        for mode in ["Свои", "Симон", "Все"] { Button { text: commitMode == mode ? "● ${mode}" : mode; onTap: commitMode = mode } }
      }
      Text { text: "${commitMode} · до 30 последних коммитов"; bold: true }
      if len(visibleCommits) == 0 { Text { text: "В этой группе коммитов нет"; color: green } }
      for commit in visibleCommits ?? [] {
        Column { gap: 4; padding: 10; background: surface; radius: 8
          Text { text: "${commit.hash} · ${commit.date}"; style: small; color: accent }
          Text { text: commit.subject; style: small; maxLines: 5 }
          Row { gap: 8; wrap: true
            Button { text: "GitHub"; onTap: url(commitMode == "Симон" || startsWith(selectedRef, "upstream/") ? "https://github.com/SimonSchubert/omalauncher/commit/${enc(commit.hash)}" : "https://github.com/Xonars/dev.omalauncher-another/commit/${enc(commit.hash)}") }
            Button { text: "Diff"; onTap: terminal("git -C /root/dev.omalauncher-another --no-pager show --stat --patch ${sh(commit.hash)}", "Коммит ${commit.hash}") }
          }
        }
      }
    }
    if tab == "Ветки" && repoOk {
      Text { text: "Выберите ветку для сравнения"; bold: true }
      Text { text: "Выбор меняет только просмотр. APK собирается из опубликованного origin/main."; style: small; color: muted; maxLines: 3 }
      for branch in repo.branches ?? [] {
        Column { gap: 5; padding: 10; background: surface; radius: 8
          Text { text: "${selectedRef == branch.name ? '● ' : ''}${branch.name}"; bold: true; color: accent; maxLines: 3 }
          Text { text: "+${branch.ahead} своих · ${branch.behind} от Симона не включено"; style: small; maxLines: 2 }
          Text { text: "${branch.hash} · ${branch.date} · ${branch.subject}"; style: small; color: muted; maxLines: 3 }
          Button { text: "Сравнить"; onTap: { selectedRef = branch.name; tab = "Обзор" } }
        }
      }
    }
    if tab == "Отличия" && repoOk {
      Text { text: "Файлы: Симон → ${selectedRef}"; bold: true; maxLines: 2 }
      Text { text: repo.summary == "" ? "Файлы совпадают" : repo.summary; color: accent; style: small; maxLines: 3 }
      Text { text: "Независимых патчей по git cherry: ${repo.patches}. Merge-коммиты здесь не учитываются."; style: small; color: muted; maxLines: 3 }
      Button { text: "Полный diff в терминале"; onTap: terminal("git -C /root/dev.omalauncher-another --no-pager diff upstream/main ${sh(selectedRef)} --", "Симон → ${selectedRef}") }
      Text { text: "До 60 файлов · полный список доступен в diff"; style: small; color: muted }
      for changed in repo.files ?? [] {
        Column { padding: 8; gap: 4; background: surface; radius: 6
          Text { text: changed.path; style: small; maxLines: 4; onTap: copy(changed.path) }
          Text { text: "+${changed.added} / −${changed.removed} строк"; style: small; color: accent }
        }
      }
    }
    if tab == "APK" {
      Column { padding: 12; gap: 6; background: surface; radius: 8
        Text { text: "Источник APK: Xonars · origin/main"; bold: true; maxLines: 2 }
        Text { text: "Выбранная для сравнения ветка не влияет на сборку. Перед сборкой сохраняются настройки и виджеты."; style: small; color: muted; maxLines: 4 }
      }
    Column { gap: 6
      Text { text: busy ? (checking ? "Проверяем…" : "Собираем APK…") : failed ? "Ошибка" : available ? "Есть обновление" : installedLatest ? "Версия актуальна" : apkReady ? "APK готов" : "Проверка обновлений"; style: title; color: failed ? red : accent }
      Text { text: "Установлено: ${sys.launcher ?? '…'}"; style: small; color: muted }
      if status.checked != null { Text { text: "Проверено ${fmtTime(status.checked, 'dd.MM HH:mm')} · main ${remoteCommit}"; style: small; color: muted } }
    }

    if showBuild {
      Column { padding: 12; gap: 10; background: surface; radius: 8
        Text { text: failed ? "Остановлено на этапе ${min(buildStage, 5)} из 5" : buildStage == 6 ? "Все 5 этапов завершены" : "Этап ${buildStage} из 5"; bold: true; color: failed ? red : accent }
        if buildStage < 6 {
          Text { text: stages[buildStage - 1].title; bold: true; maxLines: 2 }
          Text { text: stages[buildStage - 1].info; style: small; maxLines: 5 }
        } else {
          Text { text: "APK проверен и готов к скачиванию. Установку нужно подтвердить в Android."; style: small; maxLines: 4 }
        }
        if busy || failed || details {
        for step, i in stages {
          Text { text: "${i + 1 < buildStage ? '✓' : i + 1 == buildStage ? (failed ? '×' : '●') : '○'} ${i + 1}. ${step.title}"; style: small; color: i + 1 < buildStage ? green : i + 1 == buildStage ? (failed ? red : accent) : muted; bold: i + 1 == buildStage; maxLines: 2 }
        }
        }
        if operationStart > 0 { Text { text: "${busy ? 'Всего прошло' : 'Время операции'}: ${fmtDuration(buildElapsed)}"; style: small; color: muted } }
        if busy {
          Text { text: "На этом этапе: ${fmtDuration(stageElapsed)}"; style: small; color: muted }
          Text { text: "Можно закрыть окно. Сборка продолжится, пока работает Linux."; style: small; maxLines: 3 }
        }
      }
    }

    if busy && checking {
      Column { padding: 12; gap: 8; background: surface; radius: 8
        Text { text: checking ? "● Связываемся с GitHub" : (status.message ?? "Запускаем сборку"); color: accent; bold: true; maxLines: 3 }
        Text { text: checking ? "Получаем main и сравниваем коммиты с последней сборкой. Обычно это занимает несколько секунд." : "Сборка продолжится в фоне, пока работает Linux."; style: small; maxLines: 4 }
        if operationStart > 0 { Text { text: "Прошло: ${fmtDuration(buildElapsed)}"; style: small; color: muted } }
        if checking && now - operationStart >= 15 { Text { text: "GitHub отвечает дольше обычного. Ожидаем ответ, до 2 минут."; style: small; color: yellow } }
        Text { text: checking ? "Проверка выполняется…" : "Сборка выполняется…"; style: small; color: accent }
      }
    }
    if !busy {
      Row { gap: 8; wrap: true
        Button { text: "Проверить сейчас"; onTap: {
          previousUpdate = status.updated
          requestedAt = now
          requestedAction = "check"
          actionError = ""
          actionOutput = ""
          actionOutput = run("python /root/.local/share/oma-updater/updater.py check 2>&1 && printf ok")
        } }
        if available || !apkReady {
          Button { text: "Собрать обновление"; onTap: {
            previousUpdate = status.updated
            requestedAt = now
            requestedAction = "build"
            actionError = ""
            actionOutput = ""
            actionOutput = run("python /root/.local/share/oma-updater/updater.py update 2>&1 && printf ok")
          } }
        }
      }
    }

    if !busy && !failed && status.checked != null && status.phase != "ready" {
      Text { text: available ? "Проверка завершена: в main есть новые коммиты." : "Проверка завершена: новых коммитов относительно последней сборки нет."; color: available ? accent : green; style: small; maxLines: 3 }
    }

    if !busy && available && trim(commits ?? "") != "" {
      Column { gap: 6
        Text { text: "Что нового"; bold: true }
        for commit in lines(commits) { Text { text: commit; style: small; maxLines: 3 } }
        Button { text: "Все коммиты на GitHub"; onTap: url("https://github.com/Xonars/dev.omalauncher-another/commits/main/") }
      }
    }

    if apkReady && !busy {
      Column { gap: 6
        Text { text: "Готовая сборка"; bold: true }
        Text { text: health.built_version ?? "Версия неизвестна"; style: small; color: muted }
        if !openingDownload {
          Button { text: available ? "Скачать предыдущий APK" : "Скачать APK"; onTap: {
            downloadResult = ""
            openingDownload = true
            downloadAt = now
            downloadResult = run("python /root/.config/omalauncher/widgets/apk-share/backend.py start --directory /root/APK --bind 127.0.0.1")
          } }
        } else { Text { text: "Открываем скачивание…"; color: accent } }
        Text { text: "После скачивания откройте APK и подтвердите установку в Android."; style: small; color: muted }
      }
    }

    if failed {
      Text { text: actionError != "" ? actionError : (status.error ?? "Откройте журнал для подробностей."); style: small; color: red; maxLines: 8 }
    }

    Button { text: details ? "Скрыть подробности" : "Подробности и журнал"; onTap: details = !details }
    if details {
      Column { gap: 10
        Text { text: "Сборка из origin/main форка Xonars. Перед сборкой сохраняется копия настроек и виджетов."; style: small; color: muted }
        if !busy { Button { text: "Пересобрать APK"; onTap: {
            previousUpdate = status.updated
            requestedAt = now
            requestedAction = "build"
            actionError = ""
            actionOutput = ""
            actionOutput = run("python /root/.local/share/oma-updater/updater.py build 2>&1 && printf ok")
          } } }
        if status.apk != null { Text { text: status.apk; style: small; maxLines: 4; onTap: copy(status.apk) } }
        Row { gap: 8; wrap: true
          Button { text: "Полный журнал"; onTap: terminal("tail -n 120 -F /root/.cache/oma-updater/build.log", "OMA · сборка") }
          if !busy { Button { text: "Очистить журнал"; onTap: run("python /root/.local/share/oma-updater/updater.py clear-log") } }
        }
        Text { text: trim(log ?? "") == "" ? "Журнал пуст" : log; style: small; maxLines: 100 }
      }
    }
    }
    Spacer { height: 12 }
  }
}

