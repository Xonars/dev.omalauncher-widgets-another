app "Telegram" {
  meta { owl: 18; description: "Чаты, фотографии и сообщения Telegram"; version: "1.5" }
  requires { pacman: ["python"] }
  title: selected == 0 ? "Telegram" : chatName
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect x=".5" y=".5" width="47" height="47" rx="9" fill="#19191d"/><rect x=".5" y=".5" width="47" height="47" rx="9" fill="currentColor" fill-opacity=".30" stroke="currentColor" stroke-opacity=".78"/><defs><g id="symbol"><path d="M4 21 43 5l-8 38-12-12-8 7V26L35 13 19 29"/></g></defs><g transform="translate(5.24 4.85) scale(0.798)" fill="none" stroke="#faf8f3" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.13"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g><g transform="translate(5.24 4.85) scale(0.798)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.13" opacity=".16"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g></svg>"""
  state cacheResult = ""
  state clearingCache = false
  state photoOpen = ""
  state selected = 0
  state chatName = ""
  state query = ""
  state draft = ""
  state drafts = {}
  state messageQuery = ""
  state chatFilter = "all"
  state confirmLogout = false
  state logoutResult = ""
  state result = ""
  state sending = false
  state jobStart = ""
  state handledJob = ""
  state attachment = null
  state attachments = {}
  state replyTo = 0
  state replyText = ""
  state messageMenu = 0
  source transfer = cmd("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py job-status") json every 2s timeout 5s
  on jobStart {
    if parseJson(jobStart).ok == false { sending = false; result = jobStart }
  }
  on transfer first {
    if transfer.status == "running" || transfer.status == "queued" { sending = true }
    if (transfer.status == "done" || transfer.status == "error") && transfer.id != handledJob {
      handledJob = transfer.id
      sending = false
      result = toJson(transfer.result)
      if transfer.result.ok == true {
        if transfer.kind == "pick" && transfer.result.cancelled != true {
          attachments = set(attachments, str(transfer.chat), transfer.result)
          if selected == transfer.chat { attachment = transfer.result }
        }
        if transfer.kind == "send" || transfer.kind == "send-file" {
          if selected == transfer.chat && draft == transfer.args[1] { draft = "" }
          if get(drafts, str(transfer.chat), "") == transfer.args[1] { drafts = set(drafts, str(transfer.chat), "") }
          if selected == transfer.chat && replyTo == num(transfer.args[2]) { replyTo = 0; replyText = "" }
          if transfer.kind == "send-file" {
            if get(attachments, str(transfer.chat), null).path == transfer.args[3] { attachments = set(attachments, str(transfer.chat), null) }
            if selected == transfer.chat && attachment.path == transfer.args[3] { attachment = null }
          }
          refresh()
        }
      }
    }
  }
  state limit = 50
  state accountMenu = false
  state snapshot = null
  source data = cmd("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py view ${sh(selected)} ${sh(limit)} ${sh(!accountMenu)}") json every 15s timeout 55s
  on data first {
    if data.authorized != null { snapshot = data }
  }
  on logoutResult {
    if parseJson(logoutResult).ok == true {
      snapshot = null; selected = 0; draft = ""; drafts = {}; attachment = null; attachments = {}; replyTo = 0; replyText = ""; accountMenu = false; confirmLogout = false; refresh()
    }
  }
  on cacheResult {
    if cacheResult != "" {
      clearingCache = false
      if parseJson(cacheResult).ok == true {
        photoOpen = ""
        if snapshot != null {
          snapshot = merge(snapshot, {
            chats: (snapshot.chats ?? []).map(c => merge(c, {avatar: null})),
            messages: (snapshot.messages ?? []).map(m => merge(m, {image: null}))
          })
        }
      }
    }
  }
  back: photoOpen != "" || selected != 0 || accountMenu
  onBack: {
    if photoOpen != "" { photoOpen = "" }
    else { selected = 0; draft = ""; attachment = null; replyTo = 0; replyText = ""; messageMenu = 0; messageQuery = ""; accountMenu = false; confirmLogout = false; limit = 50 }
  }
  let desktop = (screenWidth ?? 0) >= 840
  component ChatList() {
    Column { fill: true; gap: 10
      Row {
        Button { text: chatFilter == "all" ? "• Все" : "Все"; onTap: chatFilter = "all" }
        Button { text: chatFilter == "unread" ? "• Новые" : "Новые"; onTap: chatFilter = "unread" }
        Button { text: chatFilter == "archive" ? "• Архив" : "Архив"; onTap: chatFilter = "archive" }
      }
      Input { text: query; placeholder: "Поиск чатов"; onChange: query = value }
      Column {
        weight: 1
        lazy: true
        gap: 6
        onPull: refresh()
        for chat in (snapshot.chats ?? []).filter(c => contains(lower(c.name), lower(query)) && (chatFilter == "all" || (chatFilter == "unread" && c.unread > 0) || (chatFilter == "archive" && c.archived == true))) key chat.id {
          Row {
            fill: width
            padding: 12
            background: surface
            radius: 12
            onTap: { selected = chat.id; chatName = chat.name; draft = get(drafts, str(chat.id), ""); attachment = get(attachments, str(chat.id), null); replyTo = 0; replyText = ""; messageMenu = 0; result = ""; messageQuery = ""; limit = 50 }
            Box {
              size: 42
              radius: 21
              background: alpha(accent, 0.22)
              clip: true
              if chat.avatar != null {
                Image { src: chat.avatar; fill: true; fit: cover; label: "Аватар ${chat.name}" }
              } else {
                Text { text: upper(sub(chat.name, 0, 1)); align: center; color: accent; bold: true }
              }
            }
            Column {
              weight: 1
              Text { text: chat.pinned ? "⌖ ${chat.name}" : chat.name; bold: true; maxLines: 1 }
              Text { text: chat.preview; style: muted; maxLines: 2 }
            }
            Column {
              if chat.date > 0 { Text { text: fmtTime(chat.date, "dd.MM HH:mm"); style: small } }
              if chat.unread > 0 { Text { text: "${chat.unread}"; color: accent; bold: true; align: end } }
            }
          }
        }
        if len((snapshot.chats ?? []).filter(c => contains(lower(c.name), lower(query)) && (chatFilter == "all" || (chatFilter == "unread" && c.unread > 0) || (chatFilter == "archive" && c.archived == true)))) == 0 { Text { text: "Подходящих чатов нет"; style: muted } }
      }
    }
  }
  component Conversation() {
    Column { fill: true; gap: 10
      Input { text: messageQuery; placeholder: "Поиск в загруженных сообщениях"; onChange: messageQuery = value }
      if snapshot.chat != selected {
        Text { text: "Загрузка сообщений…"; style: muted; weight: 1 }
      } else {
        Column {
          weight: 1
          lazy: true
          reverse: true
          gap: 8
          onPull: refresh()
          for message in (snapshot.messages ?? []).filter(m => contains(lower(m.text), lower(messageQuery))) key message.id {
            Column {
              padding: 12
              radius: 12
              background: message.mine ? alpha(accent, 0.18) : surface
              Text { text: message.mine ? "Вы" : message.sender; style: small; color: accent; bold: true }
              if message.image != null {
                Image {
                  src: message.image
                  fill: width
                  height: min(300, screenHeight * 0.35)
                  fit: contain
                  label: "Фотография из сообщения"
                  onTap: photoOpen = message.image
                }
              } else if message.image_status != null {
                Text { text: message.image_status; style: muted; onTap: refresh() }
              }
              if message.reply_id != null { Text { text: message.reply_text != null ? "↪ ${message.reply_text}" : "↪ Ответ на сообщение #${message.reply_id}"; style: small; color: accent } }
              if message.file_name != null { Text { text: "${message.file_name} · ${fmtBytes(message.file_size)}"; style: small; maxLines: 2 } }
              if message.text != "" { Text { text: message.text; onLongPress: copy(message.text) } }
              Text { text: (message.edited ? "изменено · " : "") + fmtTime(message.date, "dd MMM · HH:mm"); style: muted; align: end; onTap: messageMenu = messageMenu == message.id ? 0 : message.id }
              Button { text: messageMenu == message.id ? "Скрыть действия" : "Действия"; onTap: messageMenu = messageMenu == message.id ? 0 : message.id }
              if messageMenu == message.id {
                Row {
                  Button { text: "Ответить"; onTap: { replyTo = message.id; replyText = sub(message.text != "" ? message.text : (message.file_name ?? "Вложение"), 0, 100); messageMenu = 0 } }
                  if message.file_name != null {
                    Button { text: "Скачать"; onTap: {
                      if !sending {
                        sending = true; jobStart = ""; result = ""
                        jobStart = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py start-job download ${sh(selected)} ${sh(message.id)}")
                      }
                    } }
                  }
                }
              }
            }
          }
          if len((snapshot.messages ?? []).filter(m => contains(lower(m.text), lower(messageQuery)))) == 0 { Text { text: messageQuery == "" ? "Сообщений пока нет" : "Совпадений нет. Можно загрузить больше сообщений."; style: muted } }
          if limit < 200 { Button { text: "Загрузить больше"; onTap: limit = min(limit + 50, 200) } }
        }
      }
      if parseJson(result).error != null { Text { text: "Ошибка: ${parseJson(result).error}"; color: red; maxLines: 4 } }
      if sending { Text { text: transfer.kind == "pick" ? "Выберите файл в окне Android…" : "Выполняется… ${transfer.progress ?? 0}%"; style: small; color: accent } }
      if (transfer.kind == "send" || transfer.kind == "send-file") && transfer.status == "done" && transfer.chat == selected { Text { text: "✓ Отправлено"; style: small; color: green } }
      if transfer.kind == "download" && transfer.status == "done" && transfer.chat == selected {
        Text { text: "Сохранено: ${transfer.result.path}"; style: small; maxLines: 2 }
        Button { text: "Открыть через…"; onTap: run("omalauncher share ${sh(transfer.result.path)}") }
      }
      if replyTo != 0 {
        Row {
          Text { text: "↪ ${replyText}"; maxLines: 2; weight: 1; color: accent; style: small }
          Button { text: "×"; onTap: { replyTo = 0; replyText = "" } }
        }
      }
      Row {
        Button { text: "＋ Файл"; onTap: {
          if !sending {
            sending = true; jobStart = ""; result = ""
            jobStart = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py start-job pick ${sh(selected)}")
          }
        } }
        if attachment != null {
          Text { text: "${attachment.name} · ${fmtBytes(attachment.size)}"; maxLines: 2; weight: 1; style: small }
          Button { text: "×"; onTap: { attachment = null; attachments = set(attachments, str(selected), null) } }
        }
      }
      if len(draft) > (attachment != null ? 1024 : 4096) { Text { text: "Слишком длинный текст · максимум ${attachment != null ? 1024 : 4096} символов"; color: red; style: small } }
      Row {
        align: bottom
        Input { text: draft; placeholder: attachment != null ? "Подпись к файлу" : "Сообщение"; lines: screenHeight < 540 ? 2 : 4; weight: 1; onChange: { draft = value; drafts = set(drafts, str(selected), value) } }
        Button {
          text: sending ? "…" : "➤"
          onTap: {
            if !sending && (trim(draft) != "" || attachment != null) && len(draft) <= (attachment != null ? 1024 : 4096) {
              jobStart = ""
              result = ""
              sending = true
              if attachment != null {
                jobStart = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py start-job send-file ${sh(selected)} ${sh(draft)} ${sh(replyTo)} ${sh(attachment.path)}")
              } else {
                jobStart = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py start-job send ${sh(selected)} ${sh(draft)} ${sh(replyTo)}")
              }
            }
          }
        }
      }
    }
  }
  Column {
    fill: true
    padding: [12, 8]
    gap: 10
    if photoOpen != "" {
      Button { text: "← К переписке"; onTap: photoOpen = "" }
      Image { src: photoOpen; fill: width; weight: 1; fit: contain; label: "Изображение из переписки" }
    } else {
    Row {
      fill: width
      if selected != 0 { Button { text: "←"; onTap: { selected = 0; draft = ""; attachment = null; replyTo = 0; replyText = ""; messageMenu = 0; messageQuery = ""; accountMenu = false } } }
      Text { text: selected == 0 ? "Сообщения" : "Переписка"; style: title; weight: 1 }
      Button { text: "↻"; onTap: refresh() }
      Button { text: "Настройки"; onTap: { accountMenu = !accountMenu; confirmLogout = false } }
    }
    if accountMenu {
      Column {
        padding: 12
        height: min(440, screenHeight * 0.6)
        scroll: true
        background: surface
        radius: 12
        Text { text: "Настройки"; style: title }
        Text { text: "Обновление каждые 15 секунд. Текст, ответы, файлы до 100 МБ и просмотр изображений. Скачанное: Download/Telegram. Нажмите на фото, чтобы увеличить. Секретные чаты не поддерживаются."; style: small }
        Button {
          text: clearingCache ? "Очистка…" : "Очистить кеш изображений"
          onTap: {
            if !clearingCache {
              cacheResult = ""
              clearingCache = true
              cacheResult = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py clear-cache")
            }
          }
        }
        if parseJson(cacheResult).ok == true {
          Text { text: "Кеш очищен · освобождено ${fmtBytes(parseJson(cacheResult).bytes)}"; style: small; color: green }
        }
        if parseJson(cacheResult).error != null {
          Text { text: "Ошибка очистки: ${parseJson(cacheResult).error}"; style: small; color: red; maxLines: 3 }
        }
        Text { text: "Удаляются фото и аватарки. Авторизация сохраняется. Изображения загрузятся снова при просмотре."; style: small }
        Button { text: "Войти по QR-коду"; onTap: terminal("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py auth-qr", "Telegram · QR") }
        Button { text: "Авторизация"; onTap: terminal("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py auth", "Вход в Telegram") }
        if snapshot.authorized == true {
          Button { text: "Выйти из аккаунта"; color: red; onTap: confirmLogout = true }
          if confirmLogout {
            Text { text: "Завершить сессию OWL? Для следующего входа понадобится QR или код."; style: small }
            Row {
              Button { text: "Отмена"; onTap: confirmLogout = false }
              Button { text: "Да, выйти"; color: red; onTap: { logoutResult = ""; logoutResult = run("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py logout") } }
            }
          }
        }
        if parseJson(logoutResult).error != null { Text { text: parseJson(logoutResult).error; color: red; maxLines: 3 } }
      }
    }
    if data.error != null {
      Text { text: "Не удалось обновить: ${data.error}"; color: red; style: small; maxLines: 4 }
    }
    if (snapshot == null || snapshot.authorized != true) && !accountMenu {
      Column {
        weight: 1
        justify: center
        gap: 18
        Text { text: "Ваш Telegram в Owl"; style: title }
        Text { text: "Войдите в аккаунт, чтобы увидеть чаты и сообщения. Для первого входа нужны API ID и API hash с my.telegram.org. Выберите QR-код или вход по номеру телефона." }
        Button { text: "Получить API ID / hash"; onTap: url("https://my.telegram.org/apps") }
        Button { text: "Войти по QR-коду"; onTap: terminal("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py auth-qr", "Telegram · QR") }
        Button { text: "Войти в Telegram"; onTap: terminal("/root/.local/share/telegram-owl/venv/bin/python /root/.local/share/telegram-owl/client.py auth", "Вход в Telegram") }
        Text { text: "После входа вернитесь сюда и нажмите ↻. Сессия сохраняется локально."; style: muted }
        Text { text: "При вводе API hash, кода и пароля символы в терминале не отображаются — это нормально. Введите значение и нажмите Enter."; style: small }
        Text { text: "Нет кода? Окно входа покажет способ доставки. Проверьте чат «Telegram» в уже открытой сессии. Для повторного запроса введите /resend вместо кода."; style: small }
      }
    } else if snapshot.authorized == true && desktop {
      Row {
        weight: 1; fill: width; gap: 20
        Column { width: min(360, screenWidth * 0.32); fill: height
          ChatList { weight: 1 }
        }
        Column { weight: 1; fill: height
          if selected == 0 {
            Column { fill: true; justify: center
              Text { text: "Выберите чат"; style: title; align: center }
            }
          } else { Conversation { weight: 1 } }
        }
      }
    } else if snapshot.authorized == true && selected == 0 {
      ChatList { weight: 1 }
    } else if snapshot.authorized == true {
      Conversation { weight: 1 }
    }
    }
  }
}
