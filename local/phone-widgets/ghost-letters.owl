app "Письма призрака" {
  meta { owl: 18; description: "Карточное расследование с тайной перепиской"; version: "2.0.0"; category: "games" }
  title: "Письма призрака"
  icon: appIcon
  requires { pacman: ["python"] }

  state mode = "classic"
  state markedHints = false
  state seats = 5
  state humans = 1
  state localGhost = false
  state overlay = ""
  state revealed = ""
  state evidence = ""
  state reviewRound = null
  state choices = {}
  state ballotPage = null
  state ghostNotes = {}
  state selectionToken = ""
  state queued = ""
  state receipt = ""
  state caseView = null
  state problem = ""
  state readKey = random(1000000000)

  // Shell reads can be shared for a second. Each new instance loads its own saved turn.
  source caseReport = cmd("python ~/.config/omalauncher/widgets/ghost-letters/game.py view ${int(readKey)}") every 15m json status
  let game = caseView ?? caseReport.out
  let phase = game.phase ?? ""
  let token = "${game.id}:${game.rev}"
  let layoutWidth = screenWidth ?? 0
  let layoutHeight = screenHeight ?? 0
  let wideDesk = layoutWidth >= 640 && (layoutWidth >= 900 || layoutWidth > layoutHeight)
  let roomyDesk = layoutWidth >= 900 && layoutHeight >= 480
  let showDesk = wideDesk && len(game.board ?? []) > 0
  let shownPage = showDesk && (evidence == "board" || evidence == "letters") ? "" : evidence
  let privateTurn = game.actor != null
  let covered = privateTurn && revealed != token
  let config = {mode: mode, total: seats, humans: humans, human_ghost: localGhost, marked: markedHints}
  let missing = game.groups.any(g => g.required && get(choices, g.key, null) == null)
  let ballot = phase == "ballot"
  let ballotSections = ballot ? game.groups : []
  let activeBallot = ballotSections.find(g => g.key == ballotPage) ?? first(ballotSections)
  let pendingBallot = ballotSections.filter(g => get(choices, g.key, null) == null)
  let ballotReady = get(choices, activeBallot.key, null) != null
  let conflicting = (choices.send != null && choices.send == choices.discard) ||
                    (choices.echo != null && choices.echo == choices.silence) ||
                    (choices.seal != null && choices.seal == choices.discard) ||
                    (choices.send2 != null && (choices.send2 == choices.send || choices.send2 == choices.discard)) ||
                    (choices.seal2 != null && (choices.seal2 == choices.seal || choices.seal2 == choices.discard))
  let setup = phase == "setup"
  let loading = caseView == null && caseReport == null
  let failed = caseView == null && !loading && !caseReport.ok
  let parchment = #f1e2c7
  let gold = #d7ad74
  let dim = #bbad9d
  let ink = #211b22
  let shell = #19171e
  let panel = #28232c
  let rule = #473946
  let plum = #633d54
  let pale = #efd2ac
  let moss = #a9c6a1
  let ash = #d0a5a5
  let violet = #c0a9e5
  let categoryColors = {"0": #e7b485, "1": #9dcad6, "2": #c0a9e5}
  let markColors = {"Эхо": #a9c6a1, "Тишина": #d0a5a5, "Печать": #c0a9e5}
  let markSymbols = {"Эхо": "↗", "Тишина": "↘", "Печать": "✦"}
  let script = "python ~/.config/omalauncher/widgets/ghost-letters/game.py"

  on token first {
    if token != selectionToken {
      revealed = ""
      choices = {}
      ballotPage = null
      ghostNotes = {}
      reviewRound = null
      evidence = ""
      selectionToken = token
    }
    if token != queued { queued = "" }
  }

  on receipt {
    if value != "" {
      let answer = parseJson(value)
      if answer.game != null { caseView = answer.game }
      else { problem = answer.error ?? "Ход не сохранён. Попробуй ещё раз." }
      queued = ""
    }
  }

  // Back covers a private hand before the app can be left.
  back: overlay != "" || (privateTurn && !covered) || shownPage != ""
  onBack: {
    if overlay != "" { overlay = "" }
    else {
      evidence = ""
      revealed = ""
    }
  }

  component RuleLabel(heading) {
    Text { text: heading; font: sans; color: gold; fontSize: 12; fontWeight: 700; letterSpacing: 0.6 }
  }

  component Copy(body, shade = #bbad9d) {
    Text { text: body; font: sans; fontSize: 15; color: shade }
  }

  component Action(label, hot = true, allowed = true) {
    Box {
      fill: width
      height: 47
      radius: 9
      border: 1
      borderColor: hot ? (allowed ? gold : rule) : rule
      background: hot ? (allowed ? gold : panel) : panel
      align: center
      Text {
        text: label
        font: sans
        fontSize: showDesk ? 13 : 15
        fontWeight: 700
        maxLines: 2
        align: center
        color: hot && allowed ? ink : (allowed ? parchment : dim)
      }
    }
  }

  component Stepping(label, amount, minimum, maximum, isSeats) {
    Row {
      align: center
      gap: 10
      Text { text: label; color: parchment; fontSize: 15; weight: 1 }
      Box {
        width: 44; height: 42; radius: 7; align: center
        border: 1; borderColor: rule; background: shell
        onTap: {
          if amount > minimum {
            if isSeats {
              seats = seats - 1
              humans = min(humans, seats - (localGhost ? 0 : 1))
            } else {
              humans = humans - 1
              
            }
          }
        }
        Text { text: "−"; align: center; fontSize: 22; color: amount > minimum ? gold : dim }
      }
      Text { text: "${amount}"; width: 25; align: center; font: mono; color: parchment; fontSize: 16 }
      Box {
        width: 44; height: 42; radius: 7; align: center
        border: 1; borderColor: rule; background: shell
        onTap: {
          if amount < maximum {
            if isSeats { seats = seats + 1 } else { humans = humans + 1 }
          }
        }
        Text { text: "+"; align: center; fontSize: 22; color: amount < maximum ? gold : dim }
      }
    }
  }

  component Suspicion(count) {
    Text {
      text: "${count}"; color: count > 0 ? ash : dim
      font: sans; fontWeight: 700; fontSize: 12; padding: [7, 3]; radius: 5
      background: count > 0 ? alpha(ash, 0.17) : alpha(dim, 0.08)
    }
  }

  component Clue(entry, marked = false, tint = #d7ad74, voting = false) {
    let tone = entry.correct ? moss : (entry.voted ? ash : get(markColors, entry.mark, tint))
    Column {
      fill: width
      gap: 5
      padding: [8, 7]
      radius: 9
      border: 1
      borderColor: marked || entry.correct || entry.voted ? tone : mix(rule, tone, 0.19)
      background: mix(panel, tone, marked ? 0.23 : 0.065)
      Row {
        align: center
        gap: 7
        Box {
          size: 30; radius: 7; align: center
          background: alpha(tone, 0.15)
          Text { text: entry.glyph; font: sans; fontSize: 17; color: tone; align: center }
        }
        Text { text: entry.label; font: sans; weight: 1; color: parchment; fontWeight: 650; fontSize: 14; maxLines: 2 }
        if entry.suspicions != null { Suspicion { count: entry.suspicions } }
        if marked || voting {
          Box {
            size: 22; radius: 11; align: center
            background: marked ? tone : alpha(tone, 0.06)
            border: 1; borderColor: marked ? tone : alpha(tone, 0.4)
            if marked { Text { text: "✓"; color: ink; font: sans; fontSize: 13; bold: true; align: center } }
          }
        }
      }
      if entry.mark != null || entry.detail != null || entry.correct || entry.voted {
        Text {
          text: entry.mark != null ? "${get(markSymbols, entry.mark, "•")}  ${entry.mark}" :
                (entry.detail ?? (entry.correct ? (entry.voted ? "✓ Верно" : "Истинная улика") : "Голосование"))
          color: tone; font: sans; fontSize: 11; fontWeight: 650
        }
      }
      if len(entry.supporters ?? []) > 0 {
        Box { fill: width; height: 1; background: alpha(tone, 0.24) }
        Flow {
          gap: 4
          for name in entry.supporters key name {
            Text {
              text: name; padding: [6, 3]; radius: 5; background: alpha(tone, 0.11)
              color: tone; font: sans; fontSize: 12; fontWeight: 650
            }
          }
        }
      }
    }
  }

  component CategoryLabel(label, tint = #d7ad74) {
    Row {
      align: center; gap: 8
      Box { width: 3; height: 19; radius: 2; background: tint }
      Text { text: label; color: tint; font: sans; fontSize: 16; fontWeight: 700; weight: 1 }
    }
  }

  component Table(rows) {
    Column {
      gap: 9
      for category in rows {
        let tone = get(categoryColors, category.key, gold)
        Column {
          gap: 7
          padding: 9; border: 1; borderColor: alpha(tone, 0.2); radius: 11
          background: alpha(tone, 0.045)
          CategoryLabel { label: category.label; tint: tone }
          Grid {
            columns: 2
            gap: 6
            for clue in category.cards key clue.value { Clue { entry: clue; tint: tone } }
          }
        }
      }
    }
  }

  component ReferenceCard(entry, tint = #d7ad74, focused = false) {
    let tone = entry.correct ? moss : (entry.voted ? ash : get(markColors, entry.mark, tint))
    Row {
      fill: width; align: center; gap: 5
      padding: roomyDesk ? [9, 8] : [6, 4]
      radius: 6; background: mix(panel, tone, focused ? 0.24 : 0.10)
      border: 1; borderColor: alpha(tone, focused ? 0.9 : (entry.correct || entry.voted ? 0.65 : 0.2))
      Text { text: entry.correct ? "✓" : (entry.mark != null ? get(markSymbols, entry.mark, "•") : entry.glyph); font: sans; color: tone; fontSize: 13 }
      Column {
        weight: 1; gap: 1
        Text { text: entry.label; font: sans; color: parchment; fontWeight: 650; fontSize: roomyDesk ? 16 : 13; maxLines: 2 }
        if entry.mark != null { Text { text: entry.mark; font: sans; color: tone; fontSize: roomyDesk ? 13 : 11 } }
      }
    }
  }

  component DeskBoard(rows) {
    Column {
      gap: 7
      CategoryLabel { label: "Стол расследования" }
      for category in rows key category.key {
        let tone = get(categoryColors, category.key, gold)
        let spoken = (game.statement.clues ?? []).find(c => c.key == category.key).value
        let picked = ballot && !covered && activeBallot.key == category.key ? get(choices, category.key, null) : null
        let focus = spoken ?? picked
        let tested = game.statement.tests ?? []
        Column {
          gap: 4
          Text { text: category.label; font: sans; color: tone; fontSize: roomyDesk ? 16 : 13; fontWeight: 700 }
          Grid {
            columns: 2
            gap: 4
            for clue in category.cards key clue.value {
              ReferenceCard { entry: clue; tint: tone; focused: clue.value == focus || tested.any(card => card.value == clue.value) }
            }
          }
        }
      }
    }
  }

  component DeskLetter(letter) {
    Column {
      gap: 4
      RuleLabel { heading: letter.round == 0 ? "Первое письмо" : "Раунд ${letter.round}" }
      if len(letter.cards) == 0 { Copy { body: "Все карты ушли в архив." } }
      for clue in letter.cards key clue.value { ReferenceCard { entry: clue } }
    }
  }

  component DeskPost(letters) {
    Column {
      fill: height
      gap: 8
      CategoryLabel { label: "Письма Призрака" }
      if len(letters) == 0 {
        Copy { body: "Письма ещё не открыты." }
      } else {
        DeskLetter { letter: first(letters) }
        if len(letters) > 1 {
          Box { height: 1; fill: width; background: rule }
          Column {
            weight: 1; scroll: true; gap: 9
            for letter in letters.drop(1) key letter.round { DeskLetter { letter: letter } }
          }
        }
      }
    }
  }

  component Lines(rows) {
    Column {
      gap: 6
      for line in rows {
        Column {
          gap: 2
          Text { text: line.label; font: sans; color: gold; fontSize: 12; fontWeight: 600 }
          Text { text: line.value; font: sans; color: parchment; fontSize: 14 }
        }
      }
    }
  }

  component Opinion(player, opinion, spotlight = false) {
    Column {
      fill: width; gap: 8; padding: 12; radius: 12; border: 1
      borderColor: spotlight ? alpha(gold, 0.45) : rule
      background: spotlight ? linear(0, 0, 1, 1, [#352a34, panel]) : panel
      Row {
        align: center; gap: 8
        Box {
          size: spotlight ? 37 : 28; radius: 7; align: center
          background: alpha(gold, 0.15)
          Text { text: sub(player, 0, 1); color: gold; font: serif; fontSize: spotlight ? 23 : 17; align: center }
        }
        Text { text: player; color: parchment; font: serif; fontSize: spotlight ? 27 : 20; weight: 1 }
      }
      if opinion == null { Copy { body: "Пропускает ход." } }
      if opinion.checking != null {
        RuleLabel { heading: "↻  Проверяет версию · ${opinion.checking}" }
      }
      if opinion.claim != null || len(opinion.tests ?? []) > 0 {
        Column {
          gap: 4; padding: 9; radius: 8; border: 1; borderColor: alpha(gold, 0.22)
          background: alpha(gold, 0.06)
          if opinion.claim != null {
            Text { text: "«Я отправил: ${opinion.claim.label}»"; color: parchment; font: sans; fontSize: 16; fontWeight: 700 }
            Text {
              text: opinion.claim.mark != null ? "Призрак открыл · ${opinion.claim.mark}" : (opinion.claim.opened ? "Призрак открыл эту карту" : "Призрак не открыл эту карту")
              color: opinion.claim.opened ? get(markColors, opinion.claim.mark, gold) : dim
              font: sans; fontSize: 12
            }
            if opinion.claim.disputed {
              Text { text: "Эту карту назвали несколько игроков"; color: ash; font: sans; fontSize: 12; fontWeight: 700 }
            }
          }
          if len(opinion.tests ?? []) > 0 {
            RuleLabel { heading: "Проверял" }
            Flow {
              gap: 5
              for clue in opinion.tests key clue.value {
                Text {
                  text: clue.label; color: parchment; font: sans; fontSize: 14
                  padding: [6, 3]; radius: 5; background: alpha(gold, 0.14)
                }
              }
            }
          }
        }
      }
      if opinion.suspect != null {
        Row {
          align: center; gap: 8; padding: [8, 7]; radius: 7
          background: alpha(ash, 0.13); border: 1; borderColor: alpha(ash, 0.24)
          Text { text: "Подозревает →"; color: ash; font: sans; fontSize: 12 }
          Text { text: opinion.suspect; color: parchment; font: sans; fontSize: spotlight ? 18 : 15; fontWeight: 700; weight: 1 }
          Suspicion { count: opinion.suspicions }
        }
      }
      Grid {
        columns: spotlight && roomyDesk ? 3 : 1; gap: 5
        for clue in (opinion.clues ?? []).filter(c => len(opinion.clues) > 1 || !(opinion.tests ?? []).any(t => t.value == c.value)) key clue.key {
          let tone = get(categoryColors, clue.key, gold)
          Row {
            align: center; gap: 7; padding: [8, 6]; radius: 7; background: alpha(tone, 0.075)
            Box { width: 2; height: 21; radius: 1; background: tone }
            Column {
              weight: 1; gap: 1
              Text { text: clue.category; color: tone; font: sans; fontSize: 11 }
              Text { text: clue.label; color: parchment; font: sans; fontSize: 15; fontWeight: 700 }
            }
          }
        }
      }
    }
  }

  component BallotTabs(sections, active) {
    Column {
      gap: 6
      Row {
        Text {
          text: "Заполнено ${len(sections) - len(pendingBallot)} из ${len(sections)}"
          color: dim; font: sans; fontSize: 12; weight: 1
        }
        Text { text: "Тайный бюллетень"; color: dim; font: sans; fontSize: 12 }
      }
      Grid {
        columns: min(showDesk && !roomyDesk ? 2 : 4, len(sections)); gap: 5
        for section in sections key section.key {
          let tone = get(categoryColors, section.key, ash)
          let current = section.key == active
          let complete = get(choices, section.key, null) != null
          Box {
            fill: width; height: 38; align: center; radius: 7
            border: 1; borderColor: current ? tone : rule
            background: mix(panel, tone, current ? 0.19 : 0.04)
            onTap: ballotPage = section.key
            Text {
              text: complete ? "✓ ${section.label}" : section.label
              color: current || complete ? tone : dim; font: sans; fontSize: 12; fontWeight: 700; align: center
            }
          }
        }
      }
    }
  }

  component Roster(players) {
    Column {
      gap: 6
      CategoryLabel { label: "Подозрения игроков" }
      for player in players key player.name {
        Row {
          align: center; gap: 6; padding: [7, 3]; radius: 6; background: alpha(ash, 0.05)
          Text { text: player.name; font: sans; color: parchment; fontSize: 14; weight: 1 }
          Text { text: player.role != "" ? "${player.seat} · ${player.role}" : player.seat; font: sans; color: dim; fontSize: 12 }
          if player.suspicions != null { Suspicion { count: player.suspicions } }
        }
      }
    }
  }

  component MailAudit(rounds) {
    let active = reviewRound ?? first(rounds).round
    Column {
      gap: 10
      Text { text: "Кто что отправил"; color: parchment; font: serif; fontSize: 29 }
      Flow {
        gap: 5
        for log in rounds key log.round {
          Box {
            width: 78; height: 36; align: center; radius: 7; background: active == log.round ? gold : panel
            onTap: reviewRound = log.round
            Text { text: "Раунд ${log.round}"; font: sans; align: center; color: active == log.round ? ink : parchment }
          }
        }
      }
      for log in rounds.filter(item => item.round == active) key log.round {
        for item in log.entries key item.player {
          Column {
            gap: 4; padding: 9; radius: 8; background: panel; border: 1
            borderColor: item.bluff ? ash : rule
            Row {
              align: center
              Text { text: item.player; color: parchment; font: sans; fontWeight: 700; weight: 1 }
              if item.bluff { RuleLabel { heading: "Блеф" } }
            }
            Copy { body: "В ящик → ${item.sent}"; shade: parchment }
            if item.claim != null { Copy { body: "В обсуждении → ${item.claim}"; shade: item.bluff ? ash : moss } }
          }
        }
      }
    }
  }

  component Post(letters) {
    Column {
      gap: 10
      RuleLabel { heading: "ПИСЬМА" }
      if len(letters) == 0 { Copy { body: "Ящик пока пуст." } }
      for letter in letters key letter.round {
        Column {
          gap: 5
          padding: 10
          radius: 9
          border: 1
          borderColor: rule
          Text { text: letter.round == 0 ? "Первое письмо" : "Раунд ${letter.round}"; color: parchment; font: sans; fontWeight: 700; fontSize: 15 }
          if len(letter.cards) > 0 {
            Grid {
              columns: 2
              gap: 6
              for clue in letter.cards key clue.value { Clue { entry: clue } }
            }
          } else { Copy { body: "Призрак не открыл карт." } }
          if letter.round > 0 {
            Text { text: "В архиве · ${letter.missing}"; color: dim; font: mono; fontSize: 12 }
          }
        }
      }
    }
  }

  component RoundTracker(current, total) {
    Column {
      weight: 1
      gap: 4
      RuleLabel { heading: "РАУНД ${current} ИЗ ${total}" }
      Row {
        fill: width; gap: 4
        for step in range(total) {
          Box { weight: 1; height: 4; radius: 2; background: step + 1 == current ? gold : (step + 1 < current ? #937764 : rule) }
        }
      }
    }
  }

  component Verdict(rows) {
    Column {
      gap: 8
      CategoryLabel { label: "Верные улики · ${rows.count(r => r.correct)} из ${len(rows)}" }
      for category in rows key category.key {
        let tone = get(categoryColors, category.key, gold)
        Column {
          gap: 6; padding: 9; radius: 10; border: 1; borderColor: alpha(tone, 0.25)
          background: alpha(tone, 0.06)
          Row {
            align: center
            Text { text: category.label; font: sans; fontWeight: 700; color: tone; weight: 1 }
            Text {
              text: category.correct ? "✓ Угадано" : (category.voted == null ? "Ничья" : "Промах")
              font: sans; fontSize: 12; color: category.correct ? moss : ash
            }
          }
          Row {
            gap: 6
            Column {
              weight: 1; gap: 3
              RuleLabel { heading: "Истинная улика" }
              Clue { entry: category.truth; tint: moss }
            }
            if !category.correct {
              Column {
                weight: 1; gap: 3
                RuleLabel { heading: "Выбор стола" }
                if category.voted != null { Clue { entry: category.voted; tint: ash } }
                else { Copy { body: "Голоса разделились" } }
              }
            }
          }
        }
      }
    }
  }

  component Links(items, tint) {
    Column {
      gap: 4
      for link in items {
        Row {
          align: center; gap: 6
          Text { text: "↳"; font: sans; fontSize: 19; color: tint }
          Column {
            weight: 1; gap: 1
            Text { text: "${link.category} · ${link.target.label}"; font: sans; fontWeight: 700; fontSize: 14; color: parchment }
            Text { text: "Общая тема · ${link.theme}"; font: sans; fontSize: 12; color: tint }
          }
        }
      }
    }
  }

  component SceneTitle(heading, description) {
    Column {
      gap: 5
      Text { text: heading; font: serif; fontSize: 30; color: parchment; maxLines: 3 }
      if description != "" { Copy { body: description } }
    }
  }

  component Debrief(rounds, human) {
    let activeRound = reviewRound ?? first(rounds).round
    Column {
      gap: 11
      SceneTitle {
        heading: "Разбор Призрака"
        description: human ? "Записи, которые Призрак сделал во время партии." : "Какие ассоциации Призрак использовал, чтобы направить расследование."
      }
      if len(rounds) == 0 { Copy { body: "Призрак пока не отправил ни одного письма." } }
      Flow {
        gap: 6
        for letter in rounds key letter.round {
          let selected = letter.round == activeRound
          Box {
            width: letter.round == 0 ? 77 : 43; height: 38; radius: 7; align: center
            background: selected ? gold : panel
            border: 1; borderColor: selected ? gold : rule
            onTap: reviewRound = letter.round
            Text {
              text: letter.round == 0 ? "Первое" : "${letter.round}"
              font: sans; fontSize: 14; fontWeight: 700; align: center; color: selected ? ink : parchment
            }
          }
        }
      }
      for letter in rounds.filter(r => r.round == activeRound) key letter.round {
        Column {
          gap: 9
          padding: 10; radius: 11; background: alpha(gold, 0.045); border: 1; borderColor: rule
          CategoryLabel { label: letter.round == 0 ? "Первое письмо" : "Раунд ${letter.round}" }
          if letter.summary != "" { Copy { body: letter.summary } }
          for item in letter.entries key item.card.value {
            let tone = get(markColors, item.card.mark, gold)
            Column {
              gap: 5
              padding: 8; radius: 9; background: shell; border: 1; borderColor: alpha(tone, 0.24)
              Clue { entry: item.card }
              if item.comment != "" { Copy { body: item.comment; shade: parchment } }
              else { Copy { body: "К этой карте Призрак не оставил пояснения." } }
              if len(item.links) > 0 { Links { items: item.links; tint: tone } }
              if len(item.other) > 0 {
                Text {
                  text: item.card.mark == "Тишина" ? "Связь с истинными уликами" : "Могло напомнить и о других уликах"
                  font: sans; fontSize: 12; color: dim
                }
                Links { items: item.other; tint: dim }
              }
            }
          }
          if len(letter.archived) > 0 {
            Text { text: "В архиве · ${join(letter.archived.map(c => c.label), ", ")}"; font: sans; color: dim; fontSize: 13 }
          }
        }
      }
    }
  }

  component Envelope() {
    Canvas {
      fill: width
      height: 118
      let cx = width / 2
      circle(cx, 57, 52, stroke: rule, width: 1)
      circle(cx, 57, 40, stroke: rule, width: 1)
      for i in range(3) {
        let x1 = cx - 106 + i * 88
        let y1 = i == 1 ? 9 : 27 + i * 29
        line(x1 - 4, y1, x1 + 4, y1, stroke: gold, width: 1)
        line(x1, y1 - 4, x1, y1 + 4, stroke: gold, width: 1)
      }
      rotate(-9, cx, 63) {
        rect(cx - 56, 32, 112, 68, radius: 8, fill: ink)
        rect(cx - 56, 27, 112, 68, radius: 8, fill: pale)
        path([[cx - 56, 88], [cx, 55], [cx + 56, 88]], stroke: #9b6d5c, width: 1)
        path([[cx - 55, 33], [cx, 73], [cx + 55, 33]], closed: true, fill: #eadaba)
        path([[cx - 55, 33], [cx, 73], [cx + 55, 33]], stroke: #9b6d5c, width: 1)
        circle(cx, 70, 11, fill: #854e62)
        circle(cx, 70, 7, stroke: #c88c8c, width: 1)
        circle(cx, 70, 2, fill: pale)
      }
    }
  }

  Column {
    fill: true
    background: shell
    padding: [16, 10, 16, 14]
    gap: 10
    Row {
      align: center
      Text {
        text: setup || loading || failed ? "✉  ПОЧТОВЫЙ ЯЩИК" : "${game.mode}"
        color: gold; fontWeight: 700; fontSize: 12; letterSpacing: 0.6; weight: 1
      }
      Box {
        width: 46; height: 36; radius: 8; align: center
        border: 1; borderColor: rule; background: panel
        onTap: { overlay = overlay == "help" ? "" : "help" }
        Text { text: "?"; color: gold; align: center; fontWeight: 700; fontSize: 17 }
      }
      if !setup && !loading && !failed {
        Box {
          width: 46; height: 36; radius: 8; align: center
          border: 1; borderColor: rule; background: panel
          onTap: { overlay = overlay == "reset" ? "" : "reset" }
          Text { text: "↺"; color: gold; align: center; fontSize: 19 }
        }
      }
    }

    Row {
      weight: 1
      fill: width
      align: top
      gap: 12
      if showDesk {
        Column {
          width: min(layoutWidth * 0.32, 410)
          fill: height
          scroll: true
          padding: 8
          background: alpha(gold, 0.035)
          radius: 10; border: 1; borderColor: rule
          DeskBoard { rows: game.board }
          Roster { players: game.roster }
        }
      }
      Column {
        weight: 1
        fill: height
        gap: 9
        if overlay == "help" {
          Column {
            weight: 1; scroll: true; gap: 13
            SceneTitle { heading: "Как играть"; description: "" }
            Lines { rows: [
              {label: "1 · Роли и стол", value: "Соревновательная игра на 4–12 участников, кооператив на 2–12. Узнайте роли по очереди. Убийца (в кооперативе Призрак) тайно выбирает по одной улике из каждой категории."},
              {label: "2 · Почта", value: "Каждый, кроме Призрака, отправляет карту с руки (вдвоём — две). В классике Призрак открывает подходящие письма и может добавить карту с руки. Метки Эхо, Тишина и Печать — отдельная опция новой партии."},
              {label: "3 · Ход Призрака и обсуждение", value: "Когда все отправили свои карты, Призрак показывает письма раунда всему столу. После этого участники по очереди высказывают версии. Можно назвать другую карту. В следующем раунде можно перепроверить чужую версию. Число рядом с игроком показывает, сколько участников сейчас его подозревают."},
              {label: "4 · Голосование", value: "Последовательно выберите три улики и, в соревновательной партии, подозреваемого. При ничьей — повторный тур, затем решение не принято."},
              {label: "5 · Развязка", value: "Для раскрытия дела нужны три верные улики или, в соревновательной партии, две улики и арест убийцы. Если задержан сообщник, он выбывает из голосования и проводится ещё один арест. После раскрытия дела убийца может отнять победу, угадав свидетеля или эксперта."},
              {label: "Передача телефона", value: "Личные экраны закрыты до нажатия «Открыть мой ход». Кнопка «Назад» скрывает открытый ход. Партия сохраняется после каждого хода."}
            ] }
          }
          Box { fill: width; onTap: overlay = ""; Action { label: "Вернуться"; hot: false } }
        } else if overlay == "reset" {
          Column {
            weight: 1; gap: 12
            SceneTitle { heading: "Начать заново?"; description: "Текущая партия будет удалена." }
            Box {
              fill: width
              onTap: {
                problem = ""
                receipt = ""
                receipt = run("${script} reset ${sh(token)}")
                overlay = ""
                revealed = ""
              }
              Action { label: "Завершить партию" }
            }
            Box { fill: width; onTap: overlay = ""; Action { label: "Продолжить партию"; hot: false } }
          }
        } else if loading || failed {
          Column {
            weight: 1; justify: center; gap: 8
            SceneTitle {
              heading: loading ? "Открываем ящик…" : "Не удалось открыть игру"
              description: failed ? "Проверь, что Linux запущен, и попробуй снова." : ""
            }
            if failed { Box { fill: width; onTap: refresh(); Action { label: "Повторить" } } }
          }
        } else if setup {
          Column {
            weight: 1
            scroll: true
            gap: 11
            Column {
              background: linear(0, 0, 1, 1, [#302735, #211b25])
              border: 1; borderColor: rule; radius: 14; padding: [14, 9, 14, 14]
              gap: 2
              Envelope {}
              Text { text: "Письма призрака"; font: serif; fontSize: 33; align: center; color: parchment }
              Text { text: "Карточное расследование"; fontSize: 14; align: center; color: dim }
            }
            RuleLabel { heading: "СОСТАВ ДЕЛА" }
            Grid {
              columns: 2
              gap: 7
              for option in game.modes key option.key {
                Column {
                  height: 54
                  justify: center
                  padding: [10, 5]
                  border: 1
                  borderColor: mode == option.key ? gold : rule
                  radius: 8
                  background: mode == option.key ? plum : panel
                  onTap: {
                    mode = option.key
                    if mode != "coop" { seats = max(seats, 4) }
                  }
                  Text { text: option.label; fontSize: 13; color: parchment; maxLines: 2; fontWeight: mode == option.key ? 700 : 500 }
                }
              }
            }
            Row {
              padding: 10; radius: 8; border: 1; borderColor: rule; background: panel
              onTap: markedHints = !markedHints
              Text { text: "Метки Призрака · Эхо / Тишина / Печать"; color: parchment; fontSize: 14; weight: 1 }
              Text { text: markedHints ? "Вкл" : "Выкл"; color: gold; fontSize: 14 }
            }
            Text { text: markedHints ? "Авторский вариант: явные положительные и отрицательные подсказки." : "Классика: все открытые карты равнозначны."; color: dim; fontSize: 12 }
            RuleLabel { heading: "ЗА СТОЛОМ" }
            Column {
              padding: [10, 6]
              gap: 4
              radius: 10
              border: 1
              borderColor: rule
              background: panel
              Stepping { label: "Всего участников"; amount: seats; minimum: mode == "coop" ? 2 : 4; maximum: 12; isSeats: true }
              Stepping { label: "Людей на телефоне"; amount: humans; minimum: 1; maximum: seats - (localGhost ? 0 : 1); isSeats: false }
              if humans >= 1 {
                Row {
                  height: 40
                  align: center
                  onTap: {
                    localGhost = !localGhost
                    if !localGhost { humans = min(humans, seats - 1) }
                  }
                  Text { text: "Призрак"; color: parchment; fontSize: 15; weight: 1 }
                  Text { text: localGhost ? "Человек" : "Бот"; color: gold; fontSize: 14 }
                }
              }
            }
            Text {
              text: "Ботов: ${seats - humans}  ·  Раундов: ${seats <= 4 ? 5 : (seats <= 7 ? 4 : (seats <= 10 ? 3 : 2))}"
              color: dim
              font: mono
              fontSize: 12
            }
          }
          Box {
            fill: width
            onTap: {
              problem = ""
              receipt = ""
              receipt = run("${script} start - ${sh(toJson(config))}")
            }
            Action { label: "Открыть дело" }
          }
        } else if covered {
          Column {
            weight: 1; justify: center; gap: 9; scroll: true
            if !showDesk || layoutHeight >= 440 { Envelope {} }
            Text { text: "Передай телефон"; font: serif; fontSize: showDesk ? 26 : 32; align: center; color: parchment }
            Text { text: game.actor.label; color: gold; fontWeight: 700; fontSize: 19; align: center }
            Text { text: "Личный экран. Открывай, когда телефон у тебя."; color: dim; align: center; fontSize: 14 }
          }
          Box {
            fill: width
            onTap: {
              if queued != token { revealed = token }
            }
            Action { label: queued == token ? "Передаём ход…" : "Открыть мой ход"; allowed: queued != token }
          }
        } else {
          if game.round > 0 && phase != "result" {
            Row {
              align: center
              RoundTracker { current: game.round; total: game.rounds }
              if !showDesk && phase != "opening" {
                Box {
                  width: 88; height: 36; align: center; radius: 7
                  background: evidence == "board" ? plum : panel
                  border: 1; borderColor: rule
                  onTap: { evidence = evidence == "board" ? "" : "board" }
                  Text { text: "Стол"; color: parchment; align: center; fontSize: 13 }
                }
                Box {
                  width: 88; height: 36; align: center; radius: 7
                  background: evidence == "letters" ? plum : panel
                  border: 1; borderColor: rule
                  onTap: { evidence = evidence == "letters" ? "" : "letters" }
                  Text { text: "Письма"; color: parchment; align: center; fontSize: 13 }
                }
              }
            }
          }
          // A new turn starts at the top of its own scroll view.
          for sheet in [game] key "${token}/${shownPage}/${activeBallot.key ?? ""}" {
            Column {
              weight: 1
              scroll: true
              gap: 12
              if shownPage == "debrief" {
                Debrief { rounds: sheet.debrief; human: sheet.ghost_is_human }
              } else if shownPage == "mail-audit" {
                MailAudit { rounds: sheet.mail_audit }
              } else if shownPage == "letters" {
                Post { letters: sheet.letters }
              } else if shownPage == "board" {
                Table { rows: sheet.board }
                Roster { players: sheet.roster }
                if sheet.phase == "ballot" && len(sheet.notes) > 0 {
                  RuleLabel { heading: "ВЕРСИИ" }
                  for opinion in sheet.notes key opinion.player { Opinion { player: opinion.player; opinion: opinion } }
                }
              } else {
                if sheet.phase == "statement" {
                  Opinion { player: sheet.speaker; opinion: sheet.statement; spotlight: true }
                } else {
                  SceneTitle { heading: sheet.phase == "discussion" ? "Версии за столом" : sheet.title; description: ballot || sheet.phase == "discussion" ? "" : sheet.brief }
                }
                if privateTurn {
                  Column {
                    gap: 5; padding: 11; radius: 10; border: 1; borderColor: rule; background: panel
                    RuleLabel { heading: sheet.actor.role == "Призрак" ? sheet.actor.label : "${sheet.actor.label} · ${sheet.actor.role}" }
                    if phase == "role" { Copy { body: sheet.actor.brief; shade: parchment } }
                    Lines { rows: sheet.actor.knowledge }
                    if len(sheet.actor.recheck ?? []) > 0 {
                      Copy { body: "Перепроверка · ${join(sheet.actor.recheck, " · ")}" }
                    }
                  }
                }
                if len(sheet.outcome) > 0 {
                  Box {
                    fill: width; radius: 9
                    onTap: { reviewRound = null; evidence = "debrief" }
                    Action { label: "✉  Разбор Призрака" }
                  }
                  if len(sheet.mail_audit ?? []) > 0 {
                    Box {
                      fill: width; radius: 9
                      onTap: { reviewRound = null; evidence = "mail-audit" }
                      Action { label: "Кто что отправил"; hot: false }
                    }
                  }
                  Verdict { rows: sheet.verdict }
                  Column {
                    gap: 7; padding: 11; radius: 10; border: 1; borderColor: sheet.success ? moss : ash; background: panel
                    Lines { rows: sheet.outcome }
                  }
                }
                if !showDesk && sheet.phase == "intro" && len(sheet.letters) > 0 { Post { letters: sheet.letters.take(1) } }
                if !showDesk && (sheet.phase == "reveal" || sheet.phase == "note" || sheet.phase == "statement" || sheet.phase == "discussion") {
                  Post { letters: sheet.letters.take(1) }
                }
                if sheet.phase == "discussion" {
                  if !showDesk { Roster { players: sheet.roster } }
                  Grid {
                    columns: showDesk && layoutWidth >= 1200 ? 2 : 1
                    gap: 8
                    for opinion in sheet.notes key opinion.player {
                      Opinion { player: opinion.player; opinion: opinion }
                    }
                  }
                  if len(sheet.notes) == 0 { Copy { body: "Никто не предложил версию." } }
                }
                if ballot {
                  BallotTabs { sections: ballotSections; active: activeBallot.key }
                  if activeBallot.options.any(c => len(c.supporters) > 0) {
                    Text { text: "Под вариантами — кто их поддержал в обсуждении."; color: dim; font: sans; fontSize: 12 }
                  }
                  if activeBallot.key == "suspect" {
                    Text { text: "Число рядом с именем — сколько игроков его подозревают."; color: dim; font: sans; fontSize: 12 }
                  }
                  if sheet.brief != "" { Copy { body: sheet.brief } }
                }
                let shownGroups = ballot ? [activeBallot] : sheet.groups
                for section in shownGroups key section.key {
                  let tone = get(categoryColors, section.key, (section.key == "echo" ? moss :
                                (section.key == "silence" || section.key == "person" || section.key == "suspect" ? ash : (section.key == "seal" ? violet : gold))))
                  let selected = get(choices, section.key, null)
                  let checked = section.multiple ? (selected ?? []) : []
                  let canExplain = (phase == "opening" || phase == "sort") &&
                                   (section.key == "echo" || section.key == "silence" || section.key == "seal" || section.key == "seal2")
                  Column {
                    gap: 7
                    if !ballot { CategoryLabel { label: section.label; tint: tone } }
                    if section.multiple {
                      Text {
                        text: len(checked) == 0 ? "Можно отметить несколько" : "Отмечено · ${len(checked)}"
                        color: dim; font: sans; fontSize: 12
                      }
                    }
                    Grid {
                      columns: 2
                      gap: 6
                      for option in section.options key option.value {
                        Box {
                          fill: width
                          radius: 9
                          onTap: {
                            if canExplain { ghostNotes = remove(ghostNotes, section.key) }
                            if section.multiple {
                              let updated = checked.any(x => x == option.value) ? checked.filter(x => x != option.value) : checked + [option.value]
                              choices = len(updated) > 0 ? set(choices, section.key, updated) : remove(choices, section.key)
                            } else if selected == option.value { choices = remove(choices, section.key) }
                            else { choices = set(choices, section.key, option.value) }
                          }
                          Clue { entry: option; tint: tone; marked: section.multiple ? checked.any(x => x == option.value) : selected == option.value; voting: ballot || section.multiple }
                        }
                      }
                    }
                    if canExplain && get(choices, section.key, null) != null {
                      Column {
                        gap: 3; padding: [9, 6]; radius: 8; background: panel; border: 1; borderColor: rule
                        RuleLabel { heading: "Заметка для финала" }
                        Input {
                          text: get(ghostNotes, section.key, "")
                          placeholder: section.key == "silence" ? "От какой версии ты хотел отвести детективов?" : "На какую улику ты намекал и почему?"
                          lines: 3; fontSize: 15
                          onChange: ghostNotes = set(ghostNotes, section.key, sub(value, 0, 300))
                        }
                      }
                    }
                  }
                }
                if sheet.phase == "board" || sheet.phase == "result" {
                  if !showDesk { Table { rows: sheet.board } }
                  Roster { players: sheet.roster }
                }
                if len(sheet.tallies) > 0 {
                  RuleLabel { heading: "ПОДСЧЁТ ГОЛОСОВ" }
                  for tally, i in sheet.tallies {
                    Column {
                      gap: 6; padding: 10; radius: 9; border: 1; borderColor: rule
                      Text { text: "Голосование ${i + 1}"; color: parchment; fontSize: 14; fontWeight: 700 }
                      Lines { rows: tally }
                    }
                  }
                }
                if !showDesk && sheet.phase == "result" { Post { letters: sheet.letters } }
              }
            }
          }
          if conflicting && shownPage == "" {
            Text { text: "Выбери разные карты."; color: ash; fontSize: 13; align: center }
          }
          if shownPage != "" {
            Box { fill: width; onTap: evidence = ""; Action { label: phase == "result" ? "Вернуться к итогам" : "Вернуться к ходу"; hot: false } }
          } else if phase == "result" {
            Box {
              fill: width
              onTap: {
                problem = ""
                receipt = ""
                receipt = run("${script} reset ${sh(token)}")
              }
              Action { label: "Новое дело" }
            }
          } else {
            let ready = (ballot ? (!missing || ballotReady) : !missing) && !conflicting && queued != token
            Box {
              fill: width
              onTap: {
                if ready && ballot && missing {
                  ballotPage = first(pendingBallot).key
                } else if ready {
                  queued = token
                  problem = ""
                  receipt = ""
                  if privateTurn {
                    revealed = ""
                    receipt = run("${script} submit ${sh(token)} ${sh(toJson(set(choices, "comments", ghostNotes)))}")
                  } else { receipt = run("${script} advance ${sh(token)}") }
                }
              }
              Action {
                label: queued == token ? "Сохраняем ход…" :
                       (ballot && missing ? (ballotReady ? "Далее · ${first(pendingBallot).label}" : "Выбери вариант") :
                       (phase == "opening" && choices.seal == null ? "Пропустить первое письмо" :
                       (phase == "note" && !game.groups.any(g => get(choices, g.key, null) != null) ? "Пропустить" : game.action)))
                allowed: ready
              }
            }
          }
        }
        if problem != "" { Text { text: problem; color: ash; fontSize: 13; align: center } }
      }
      if showDesk {
        Column {
          width: min(layoutWidth * 0.27, 335)
          fill: height
          padding: 8
          background: alpha(gold, 0.035)
          radius: 10; border: 1; borderColor: rule
          DeskPost { letters: game.letters }
        }
      }
    }
  }

  asset appIcon = base64""
}
