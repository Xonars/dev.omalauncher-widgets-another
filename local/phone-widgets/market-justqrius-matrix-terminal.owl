widget "matrix terminal" {
  size: 6x4
  minSize: 2x2
  padding: 0
  background: transparent

  meta {
    owl: 2
    description: "A live terminal with green Matrix rain when idle. Tap to resume your shell; tap away to bring back the rain."
    version: "1.2"
    license: "MIT"
    category: "system"
  }
  requires { pacman: ["bash", "foot", "tmux", "cmatrix", "ncurses"] }

  // Isolated terminal session with automatic recovery of the shell and animation.
  Terminal {
    command: 'exec bash ~/.config/omalauncher/widgets/terminal-support/session.sh matrix'
  }
}
