widget "now-playing-plus" {
  size: 6x2
  minSize: 2x1
  padding: 0
  requires { pacman: [] }
  meta { description: "A configurable player tile with album art, playback controls, title scrolling, app placement, and album color blending."; version: "1.6"; license: "MIT"; category: "media"; owl: 13 }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it, available is false.
  source m = android.media
  // Media positions arrive as snapshots. A one second clock lets the display advance between
  // snapshots without running a frame animation, and stops advancing as soon as playback pauses.
  source now = clock every 1s
  state positionAnchor = 0
  state positionAnchorAt = 0
  on m first {
    positionAnchor = max(0, num(value.position, 0))
    positionAnchorAt = num(now, 0)
  }
  on now first {
    positionAnchor = max(0, num(m.position, 0))
    positionAnchorAt = value
  }
  // Fade is the initial setup; persisted choices take precedence on existing installs.
  state appPlacement = "farRight" persist
  state settingsSide = "artBottomLeft" persist
  state albumBlendEnabled = true persist
  state blendStrength = 90 persist
  state widgetBlendStrength = 120 persist
  state titleScrollEnabled = true persist
  state titleRepeatGap = 0 persist
  state trackTextWhite = true persist
  state optionPages = {app: 0, settings: 0, preset: 0}
  state optionDrag = 0

  // Fixed, shareable snapshots. Add another entry to extend the preset strip.
  let presetBase = {appPlacement: "farRight", settingsSide: "artBottomLeft", albumBlendEnabled: true, blendStrength: 90, titleScrollEnabled: true, titleRepeatGap: 0, trackTextWhite: true}
  let presets = [
    merge(presetBase, {label: "Clear", value: "1", widgetBlendStrength: 40}),
    merge(presetBase, {label: "Fade", value: "2", widgetBlendStrength: 120})
  ]
  let repeatGap = clamp(titleRepeatGap, 0, 96)
  let matchedPreset = find(presets, p => p.appPlacement == appPlacement && p.settingsSide == settingsSide && p.albumBlendEnabled == albumBlendEnabled && p.blendStrength == blendStrength && p.widgetBlendStrength == widgetBlendStrength && p.titleScrollEnabled == titleScrollEnabled && p.titleRepeatGap == repeatGap && p.trackTextWhite == trackTextWhite)
  let trackTextColor = foreground
  let settingsFeatures = ["preset", "appIndicator", "trackColor", "settingsPosition", "titleScroll", "albumBlend"]
  let isPlaying = m.playing == true
  let playbackKnown = m.playing == true || m.playing == false
  let appName = lower(m.app ?? "")
  let appIndicator = playbackKnown ? (isPlaying ? "▶ " : "Ⅱ ") : ""
  let appLabel = appName == "" ? "" : appIndicator + appName
  // Reserve the complete app label and icon before giving the artist the remaining row.
  let appLineWidth = len(appLabel) * 9 + 2
  let has = m != null && m.title != null
  let allowed = m == null || m.available != false
  let dur = max(0, num(m.duration, 0))
  let elapsed = isPlaying && positionAnchorAt > 0 && now != null ? max(0, now - positionAnchorAt) : 0
  let pos = dur > 0 ? clamp(positionAnchor + elapsed, 0, dur) : positionAnchor + elapsed
  let narrow = tileWidth != null && tileWidth < 290
  let tight = tileWidth != null && tileWidth < 348
  let art = clamp((tileHeight ?? 130) - 26, 40, 132)
  // A tile taller than wide (landscape home screen, or a tall portrait tile) stacks
  // art, text and controls vertically instead of side by side.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  let tallArt = tall ? clamp(min(tileWidth - 26, tileHeight * 0.45), 40, 240) : 0

  component Clock(s) {
    let seconds = floor(max(0, num(s, 0)))
    let timeText = "${floor(seconds / 60)}:${pad(seconds % 60, 2, "0")}"
    Box {
      width: len(timeText) * 9 + 2
      Text { text: timeText; style: label; color: alpha(color0, 0.48); font: mono; maxLines: 1; offset: [1, 1] }
      Text { text: timeText; style: label; color: trackTextColor; font: mono; maxLines: 1 }
    }
  }

  // Drawn, not glyphs: the launcher's icon font only carries weather symbols. Paths need an
  // explicit fill: to be filled. Play/pause is a solid disc with the glyph in the background color.
  component Control(kind, big = false, compact = false) {
    Box {
      size: compact ? (big ? 34 : 28) : (big ? 38 : 32)
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if isPlaying {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
    }
  }

  component SettingsButton() {
    Box {
      size: 22
      radius: 11
      background: alpha(background, 0.72)
      onTap: screen()
      Canvas {
        let cx = width / 2
        let cy = height / 2
        for i in range(8) {
          rotate(i * 45, cx, cy) {
            rect(cx - 1.2, cy - 7, 2.4, 3.5, radius: 0.7, fill: foreground)
          }
        }
        circle(cx, cy, 4.5, fill: foreground)
        circle(cx, cy, 1.8, fill: background)
      }
    }
  }

  component Art(src, d) {
    Box {
      size: d
      // Rounded as much as the launcher's corner style: square on edge, 8dp on round.
      radius: 8 * corners
      clip: true
      align: center
      if src != null {
        Image { src: src; fit: cover; fill: true; onTap: media("open") }
      } else {
        // Gradients only fill inside a Canvas, not as a background.
        Canvas {
          onTap: media("open")
          rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.55), alpha(magenta, 0.35)]))
          text("♪", width / 2, height / 2, size: d * 0.45, align: center, color: alpha(foreground, 0.85))
        }
      }
      if settingsSide == "artBottomLeft" {
        Box {
          fill: true
          align: bottomStart
          padding: 6
          SettingsButton { }
        }
      }
    }
  }

  component ShadowText(s, tint, maxLines = 1, isSmall = false, isBody = false, bold = false, subtle = false, textAlign = "start") {
    let textStyle = isBody ? "body" : isSmall ? "small" : "label"
    Box {
      fill: width
      onTap: media("open")
      Text { text: s; style: textStyle; align: textAlign; bold: bold; color: alpha(color0, subtle ? 0.48 : 0.95); maxLines: maxLines; offset: subtle ? [1, 1] : [2, 2] }
      Text { text: s; style: textStyle; align: textAlign; bold: bold; color: tint; maxLines: maxLines }
    }
  }

  component PlaybackIcon(playing) {
    Canvas {
      width: 14
      height: 14
      if playing {
        path([[4, 1.5], [12, 7], [4, 12.5]], closed: true, fill: accent)
      } else {
        rect(2.5, 1.5, 3.5, 11, radius: 1, fill: foreground)
        rect(8, 1.5, 3.5, 11, radius: 1, fill: foreground)
      }
    }
  }

  // Keep this row static; continuous animation costs battery while the tile is visible.
  component AppLine(rightAligned = false) {
    if rightAligned {
      // A single text run keeps the icon beside the name when aligned to the edge.
      ShadowText { s: appLabel; tint: isPlaying ? accent : foreground; maxLines: 1; subtle: true; textAlign: "end" }
    } else {
      Row {
        align: center
        gap: 6
        if playbackKnown { PlaybackIcon { playing: isPlaying } }
        ShadowText { s: appName; tint: isPlaying ? accent : foreground; maxLines: 1; subtle: true; weight: 1 }
      }
    }
  }

  // One text run keeps the app beside the artist, with both shadow layers aligned.
  component InlineArtistLine(maxLines = 1) {
    let artist = m.artist ?? ""
    let suffix = appLabel == "" ? "" : "  ${appLabel}"
    Box {
      fill: width
      onTap: media("open")
      Text { text: artist + suffix; style: small; color: alpha(color0, 0.48); maxLines: maxLines; offset: [1, 1] }
      Text {
        style: small
        maxLines: maxLines
        spans: [{text: artist, color: trackTextColor}, {text: suffix, color: isPlaying ? accent : foreground}]
      }
    }
  }

  component SettingsDivider() {
    Box {
      height: 1
      fill: width
      background: alpha(foreground, 0.2)
    }
  }

  component MenuOption(label, value, selected, group) {
    Column {
      align: center
      justify: center
      gap: 6
      padding: [12, 8]
      height: 120
      clip: true
      fill: width
      background: selected ? alpha(accent, 0.14) : surface
      border: 1
      borderColor: selected ? accent : border
      radius: 8 * corners
      onTap: {
        if group == "app" { appPlacement = value }
        else if group == "settings" { settingsSide = value }
        else if group == "preset" {
          let preset = find(presets, p => p.value == value)
          if preset != null {
            appPlacement = preset.appPlacement
            settingsSide = preset.settingsSide
            albumBlendEnabled = preset.albumBlendEnabled
            blendStrength = preset.blendStrength
            widgetBlendStrength = preset.widgetBlendStrength
            titleScrollEnabled = preset.titleScrollEnabled
            titleRepeatGap = preset.titleRepeatGap
            trackTextWhite = preset.trackTextWhite
          }
        }
      }
      Text { text: selected ? "●" : "○"; color: selected ? accent : foreground }
      Text { text: label; style: body; maxLines: 3 }
    }
  }

  component OptionStrip(group, options, selected) {
    let viewport = max(1, (screenWidth ?? 320) - 48)
    let pageCount = ceil(count(options) / 2)
    let maxPage = max(0, pageCount - 1)
    let page = clamp(num(get(optionPages, group), 0), 0, maxPage)
    let cardWidth = min(130, max(1, (viewport - 8) / 2))
    Column {
      gap: 5
      Box {
        width: viewport
        height: 120
        clip: true
        drag: horizontal
        onDrag: optionDrag = optionDrag + dx
        onDragEnd: {
          if abs(optionDrag) > 20 || abs(vx) > 200 {
            let direction = abs(optionDrag) > 20 ? optionDrag : vx
            optionPages = set(optionPages, group, clamp(page + (direction < 0 ? 1 : -1), 0, maxPage))
          }
          optionDrag = 0
        }
        Row {
          fill: width
          height: 120
          gap: 8
          for option, i in options key option.value {
            if floor(i / 2) == page {
              MenuOption {
                width: cardWidth
                label: option.label
                value: option.value
                selected: selected == option.value
                group: group
              }
            }
          }
        }
      }
      if maxPage > 0 {
        Canvas {
          width: viewport
          height: 4
          onTap: optionPages = set(optionPages, group, round(clamp(x / viewport, 0, 1) * maxPage))
          let thumbWidth = width / pageCount
          let thumbX = page / maxPage * (width - thumbWidth)
          rect(0, 0, width, height, radius: 2, fill: alpha(foreground, 0.3))
          rect(thumbX, 0, thumbWidth, height, radius: 2, fill: accent)
        }
        Row {
          fill: width
          justify: end
          Button {
            text: page < maxPage ? "More options →" : "← First options"
            onTap: {
              optionPages = set(optionPages, group, page < maxPage ? page + 1 : 0)
            }
          }
        }
      }
    }
  }

  // Keep short titles still; scroll longer ones inside a clipped row.
  component ScrollingTitle(s) {
    Box {
      let size = 21
      // Canvas has no text measurement; estimate once per title or gap change, not per frame.
      let textWidth = max(len(s) * size * 0.62, size)
      let cycle = textWidth + repeatGap
      height: 30
      fill: width
      clip: true
      onTap: media("open")
      Canvas {
        fill: true
        clip(0, 0, width, height) {
          if titleScrollEnabled && isPlaying && textWidth > width {
            let x = (cycle - (time * 24) % cycle) % cycle
            text(s, x + 1, height / 2 + 1, size: size, align: start, bold: true, color: alpha(color0, 0.48))
            text(s, x - cycle + 1, height / 2 + 1, size: size, align: start, bold: true, color: alpha(color0, 0.48))
            text(s, x, height / 2, size: size, align: start, bold: true, color: foreground)
            text(s, x - cycle, height / 2, size: size, align: start, bold: true, color: foreground)
          } else {
            text(s, 1, height / 2 + 1, size: size, align: start, bold: true, color: alpha(color0, 0.48))
            text(s, 0, height / 2, size: size, align: start, bold: true, color: foreground)
          }
        }
      }
    }
  }

  component EmptyState(stacked) {
    if stacked {
      Column {
        gap: 10
        Art { src: null; d: tallArt }
        ShadowText { s: "nothing playing"; tint: foreground; isBody: true }
        ShadowText { s: "start music in any app"; tint: foreground; maxLines: 2; isSmall: true }
      }
    } else {
      Row {
        align: center
        gap: 12
        Art { src: null; d: art }
        Column {
          weight: 1
          gap: 2
          ShadowText { s: "nothing playing"; tint: foreground; isBody: true }
          ShadowText { s: "start music in any app"; tint: foreground; maxLines: 1; isSmall: true }
        }
      }
    }
  }

  component TrackDetails(stacked) {
    Column {
      gap: 2
      Row {
        align: center
        gap: 8
        if settingsSide == "left" || (settingsSide == "artBottomLeft" && !stacked && narrow) {
          SettingsButton { }
        }
        if appPlacement == "top" {
          AppLine { weight: 1 }
        } else if !stacked {
          ScrollingTitle { s: m.title; weight: 1 }
        } else {
          Spacer { weight: 1 }
        }
        if settingsSide == "right" {
          SettingsButton { }
        }
      }
      if stacked {
        ShadowText { s: m.title; tint: foreground; maxLines: 3; isBody: true; bold: true; subtle: true }
        if appPlacement == "right" {
          InlineArtistLine { maxLines: 2 }
        } else if appPlacement == "farRight" {
          Row {
            align: center
            gap: 8
            ShadowText { s: m.artist ?? ""; tint: trackTextColor; maxLines: 2; isSmall: true; weight: 1; subtle: true }
            AppLine { rightAligned: true; width: appLineWidth }
          }
        } else {
          ShadowText { s: m.artist ?? ""; tint: trackTextColor; maxLines: 2; isSmall: true; subtle: true }
        }
        ShadowText { s: m.album ?? ""; tint: foreground; maxLines: 1; isSmall: true }
      } else {
        if appPlacement == "top" {
          ScrollingTitle { s: m.title }
        }
        if appPlacement == "right" {
          InlineArtistLine { }
        } else if appPlacement == "farRight" {
          Row {
            align: center
            gap: 8
            ShadowText { s: m.artist ?? ""; tint: trackTextColor; maxLines: 1; isSmall: true; weight: 1; subtle: true }
            AppLine { rightAligned: true; width: appLineWidth }
          }
        } else {
          ShadowText { s: m.artist ?? ""; tint: trackTextColor; maxLines: 1; isSmall: true; subtle: true }
        }
      }
    }
  }

  component ProgressBar() {
    if dur > 0 {
      Progress { value: pos; max: dur; color: accent; track: alpha(foreground, 0.2) }
    }
  }

  component TimeLabels(separator = false, spread = false) {
    Row {
      align: center
      gap: 4
      Clock { s: pos }
      if separator {
        Box {
          width: 8
          Text { text: "/"; style: label; color: alpha(color0, 0.48); offset: [1, 1] }
          Text { text: "/"; style: label; color: alpha(trackTextColor, 0.5) }
        }
      }
      if spread { Spacer { weight: 1 } }
      Clock { s: dur }
    }
  }

  component PlayerControls(showTime = false, centered = false, compact = false, tight = false) {
    Row {
      align: center
      gap: tight ? 2 : 4
      if showTime && !tight && dur > 0 {
        TimeLabels { separator: true }
      }
      Spacer { weight: 1 }
      Control { kind: "previous"; compact: compact }
      Control { kind: "toggle"; big: true; compact: compact }
      Control { kind: "next"; compact: compact }
      if centered { Spacer { weight: 1 } }
    }
  }

  component PresetSettings() {
    Column {
      gap: 6
      Text { text: "Apply preset"; style: body; bold: true }
      Text { text: "Choose a built-in settings preset."; style: small; color: foreground }
      OptionStrip {
        group: "preset"
        selected: matchedPreset.value
        options: presets
      }
    }
  }

  component AppIndicatorSettings() {
    Column {
      gap: 6
      Text { text: "App indicator"; style: body; bold: true }
      Text { text: "Choose where the current player name appears."; style: small; color: foreground }
      OptionStrip {
        group: "app"
        selected: appPlacement
        options: [
          {label: "Above artist", value: "top"},
          {label: "Right of artist", value: "right"},
          {label: "At right edge", value: "farRight"},
          {label: "Hidden", value: "hidden"}
        ]
      }
    }
  }

  component TrackColorSettings() {
    Column {
      gap: 6
      Text { text: "Artist and duration color"; style: body; bold: true }
      Text { text: "Choose white or foreground for the artist and time labels."; style: small; color: foreground }
      Button {
        text: trackTextWhite ? "White" : "Muted"
        onTap: trackTextWhite = !trackTextWhite
      }
    }
  }

  component SettingsPositionSettings() {
    Column {
      gap: 6
      Text { text: "Settings button position"; style: body; bold: true }
      Text { text: "Choose where the gear sits relative to the player."; style: small; color: foreground }
      OptionStrip {
        group: "settings"
        selected: settingsSide
        options: [
          {label: "Left of app indicator", value: "left"},
          {label: "Right of app indicator", value: "right"},
          {label: "Bottom left of album art", value: "artBottomLeft"}
        ]
      }
    }
  }

  component TitleScrollSettings() {
    Column {
      gap: 6
      Text { text: "Title scrolling"; style: body; bold: true }
      Text { text: "Lower spacing brings the next repeat in sooner, without overlapping the title."; style: small; color: foreground }
      Button {
        text: titleScrollEnabled ? "Enabled" : "Disabled"
        onTap: titleScrollEnabled = !titleScrollEnabled
      }
      Text { text: "Repeat spacing"; style: small; color: foreground }
      Row {
        gap: 4
        Button { text: "←"; width: 44; onTap: titleRepeatGap = max(repeatGap - 4, 0) }
        Slider { value: repeatGap; min: 0; max: 96; step: 4; live: true; weight: 1; color: accent; track: alpha(foreground, 0.2); onChange: titleRepeatGap = value }
        Button { text: "→"; width: 44; onTap: titleRepeatGap = min(repeatGap + 4, 96) }
        Box { width: 76; padding: 6; border: 1; borderColor: border; radius: 4 * corners; Text { text: "${repeatGap} dp"; style: small; align: center; maxLines: 1 } }
      }
    }
  }

  component AlbumBlendSettings() {
    Column {
      gap: 6
      Text { text: "Album color blend"; style: body; bold: true }
      Text { text: "Fade album art colors into the widget background from left to right."; style: small; color: foreground }
      Button {
        text: albumBlendEnabled ? "Enabled" : "Disabled"
        onTap: albumBlendEnabled = !albumBlendEnabled
      }
      Text { text: "Album art visibility"; style: small; color: foreground }
      Row {
        gap: 4
        Button { text: "←"; width: 44; onTap: blendStrength = max(blendStrength - 5, 0) }
        Slider { value: blendStrength; min: 0; max: 100; step: 5; live: true; weight: 1; color: accent; track: alpha(foreground, 0.2); onChange: blendStrength = value }
        Button { text: "→"; width: 44; onTap: blendStrength = min(blendStrength + 5, 100) }
        Box { width: 64; padding: 6; border: 1; borderColor: border; radius: 4 * corners; Text { text: "${blendStrength}%"; style: small; align: center; maxLines: 1 } }
      }
      Text { text: "Widget background blend"; style: small; color: foreground }
      Row {
        gap: 4
        Button { text: "←"; width: 44; onTap: widgetBlendStrength = max(widgetBlendStrength - 5, 0) }
        Slider { value: widgetBlendStrength; min: 0; max: 200; step: 5; live: true; weight: 1; color: accent; track: alpha(foreground, 0.2); onChange: widgetBlendStrength = value }
        Button { text: "→"; width: 44; onTap: widgetBlendStrength = min(widgetBlendStrength + 5, 200) }
        Box { width: 64; padding: 6; border: 1; borderColor: border; radius: 4 * corners; Text { text: "${widgetBlendStrength}%"; style: small; align: center; maxLines: 1 } }
      }
    }
  }

  Box {
    fill: true
    let widgetBlend = widgetBlendStrength / 100
    if albumBlendEnabled && m.art != null {
      Image { src: m.art; fit: cover; fill: true; opacity: blendStrength / 100 }
      Canvas {
        fill: true
        rect(0, 0, width, height, fill: linear(0, 0, width, 0, [alpha(background, min(1, widgetBlend * 0.4)), alpha(background, min(1, widgetBlend * 0.7)), alpha(background, min(1, widgetBlend))]))
      }
    }
    Box {
      fill: true
      padding: 12
      if !allowed {
        Column {
          justify: center
          gap: 6
          onTap: media("open")
          ShadowText { s: "now playing"; tint: foreground }
          ShadowText { s: "Allow notification access so the launcher can see what's playing. Tap to open the setting."; tint: foreground; maxLines: 3; isSmall: true }
        }
      } else {
        if !has {
          Box {
            fill: true
            EmptyState { stacked: tall }
            if settingsSide != "artBottomLeft" {
              Box { fill: true; align: settingsSide == "right" ? "topEnd" : "topStart"; SettingsButton { } }
            }
          }
        } else {
          if tall {
            Column {
              gap: 8
              Art { src: m.art; d: tallArt }
              TrackDetails { stacked: true }
              Spacer { weight: 1 }
              ProgressBar { }
              if dur > 0 { TimeLabels { spread: true } }
              PlayerControls { centered: true }
            }
          } else {
            Row {
              align: center
              gap: 12
              if !narrow {
                Art { src: m.art; d: art }
              }
              Column {
                weight: 1
                gap: 2
                TrackDetails { stacked: false }
                Spacer { weight: 1 }
                ProgressBar { }
                if tight && dur > 0 {
                  TimeLabels { spread: true }
                }
                PlayerControls { showTime: true; compact: narrow; centered: tight; tight: tight }
              }
            }
          }
        }
      }
    }
  }

  screen {
    title: "Now Playing Settings ✚"
    Column {
      scroll: true
      gap: 18
      padding: 24
      for feature, i in settingsFeatures key feature {
        if i > 0 { SettingsDivider { } }
        if feature == "preset" { PresetSettings { } }
        if feature == "appIndicator" { AppIndicatorSettings { } }
        if feature == "trackColor" { TrackColorSettings { } }
        if feature == "settingsPosition" { SettingsPositionSettings { } }
        if feature == "titleScroll" { TitleScrollSettings { } }
        if feature == "albumBlend" { AlbumBlendSettings { } }
      }
      Button { text: "Done"; onTap: close() }
    }
  }
}
