widget "cava terminal" {
  size: 6x4
  minSize: 2x2
  padding: 0

  meta {
    owl: 2
    description: "Cava audio visualizer when idle. Tap to resume your shell; tap away to return to cava."
    version: "1.2"
    license: "MIT"
    category: "system"
  }
  requires { pacman: ["bash", "foot", "tmux", "cava"] }

  // Isolated terminal session with automatic recovery of the shell and animation.
  Terminal {
    command: 'exec bash ~/.config/omalauncher/widgets/terminal-support/session.sh cava'
  }
}
