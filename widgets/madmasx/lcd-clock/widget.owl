widget "LCD Digital Clock" {
  size: 6x3
  minSize: 1x1
  padding: 0

  meta {
    owl: 5
    description: "A retro seven-segment LCD clock with authentic chamfered segments, system language detection, and clean calculator typography."
    version: "2.0.2"
    author: "Madmasx"
    license: "MIT"
    category: "time"
  }

  source now = clock every 1s
  source sys = android.system every 5m

  // Live weather + terrain altitude for the current zone, from IP geolocation.
  requires { pacman: ["curl", "jq"] }
  source met = cmd('G=$(curl -sf https://ipwho.is/); curl -sf "https://api.open-meteo.com/v1/forecast?latitude=$(printf %s "$G" | jq -r .latitude)&longitude=$(printf %s "$G" | jq -r .longitude)&current=temperature_2m,weather_code&timezone=auto"') every 20m json timeout 25s

  // ---- Detección del idioma del sistema ----
  let rawLocale = sys == null ? "" : (sys.locale ?? "")
  let isEs = startsWith(lower(rawLocale), "es") || rawLocale == "" || startsWith(lower(rawLocale), "spa")
  let isEn = startsWith(lower(rawLocale), "en") && !isEs

  // ---- Opciones configurables (toca el widget para abrir ajustes) ----
  state showSeconds = true persist
  state use24h = false persist
  state dateOrder = "auto" persist   // "auto" | "dmy" | "mdy"
  state useTilt = true persist
  state showGhost = true persist
  state textStyle = "clean" persist

  let isDmy = dateOrder == "auto" ? isEs : (dateOrder == "dmy")

  // ---- Valores de hora ----
  let h24 = num(fmtTime(now, "H"))
  let h12raw = h24 % 12
  let hourNum = h12raw == 0 ? 12 : h12raw     // 1..12
  let minuteNum = num(fmtTime(now, "m"))
  let secondNum = num(fmtTime(now, "s"))
  let amPm = h24 < 12 ? "AM" : "PM"

  let hourStr = use24h ? (h24 < 10 ? str(h24) : fmtTime(now, "H")) : str(hourNum)
  let minuteStr = minuteNum < 10 ? "0" + str(minuteNum) : str(minuteNum)
  let secondStr = secondNum < 10 ? "0" + str(secondNum) : str(secondNum)

  // ---- Fecha en el idioma del sistema ----
  let weekdayRaw = upper(fmtTime(now, "EEE"))
  let weekdayClean = replace(replace(replace(replace(replace(weekdayRaw, "Á", "A"), "É", "E"), "Í", "I"), "Ó", "O"), "Ú", "U")
  let month = fmtTime(now, "MM")
  let dayNum = fmtTime(now, "dd")
  let dateSep = " · "
  let dateStr = isDmy
    ? (weekdayClean + dateSep + dayNum + "/" + month)
    : (weekdayClean + dateSep + month + "/" + dayNum)

  // ---- Clima + altitud con descripciones localizadas ----
  let wnow = met == null ? null : met.current
  let tempC = wnow == null ? null : num(wnow.temperature_2m)
  let wcode = wnow == null ? null : num(wnow.weather_code)
  let elevM = met == null ? null : num(met.elevation)

  let wmapEs = {
    "0":"Despejado", "1":"Casi despejado", "2":"Parc. nublado", "3":"Nublado",
    "45":"Niebla", "48":"Niebla", "51":"Llovizna leve", "53":"Llovizna", "55":"Llovizna densa",
    "56":"Llovizna helada", "57":"Llovizna helada", "61":"Lluvia leve", "63":"Lluvia", "65":"Lluvia fuerte",
    "66":"Lluvia helada", "67":"Lluvia helada", "71":"Nieve leve", "73":"Nieve", "75":"Nieve fuerte",
    "77":"Granos de nieve", "80":"Chubascos", "81":"Chubascos", "82":"Chubascos fuertes",
    "85":"Chubascos nieve", "86":"Chubascos nieve", "95":"Tormenta", "96":"Tormenta eléctrica", "99":"Tormenta fuerte"
  }
  let wmapEn = {
    "0":"Clear", "1":"Mainly clear", "2":"Partly cloudy", "3":"Overcast",
    "45":"Fog", "48":"Fog", "51":"Light drizzle", "53":"Drizzle", "55":"Heavy drizzle",
    "56":"Freezing drizzle", "57":"Freezing drizzle", "61":"Light rain", "63":"Rain", "65":"Heavy rain",
    "66":"Freezing rain", "67":"Freezing rain", "71":"Light snow", "73":"Snow", "75":"Heavy snow",
    "77":"Snow grains", "80":"Showers", "81":"Showers", "82":"Heavy showers",
    "85":"Snow showers", "86":"Snow showers", "95":"Thunderstorm", "96":"Thunderstorm", "99":"Heavy storm"
  }
  let wmap = isEs ? wmapEs : wmapEn
  let cond = wcode == null ? "" : get(wmap, str(round(wcode)), isEs ? "Despejado" : "Clear")
  let wxStr = wnow == null ? null : str(round(tempC)) + "°C " + upper(cond) + " · " + str(round(elevM)) + " M"

  // ---- Tabla de 7 segmentos para dígitos y modo retro ----
  let segPats = {
    "0":"abcdef","1":"bc","2":"abdeg","3":"abcdg","4":"bcfg","5":"acdfg","6":"acdefg","7":"abc","8":"abcdefg","9":"abcdfg",
    "A":"abcefg","B":"cdefg","C":"adef","D":"bcdeg","E":"adefg","F":"aefg","G":"acdef","H":"bcefg","I":"bc","J":"bcd","K":"ef","L":"def","M":"bcef","N":"bcef","O":"abcdef","P":"abefg","Q":"abcfg","R":"abefg","S":"acdfg","T":"defg","U":"bcdef","V":"","W":"bcef","X":"","Y":"bcdfg","Z":"abdeg"
  }
  let segExtra = {
    "K": [[0, 0.5, 1, 0], [0, 0.5, 1, 1]],
    "M": [[0, 0, 0.5, 0.5], [1, 0, 0.5, 0.5]],
    "N": [[0, 0, 1, 1]],
    "R": [[0.5, 0.5, 1, 0.85]],
    "V": [[0, 0, 0.5, 1], [1, 0, 0.5, 1]],
    "W": [[0, 0, 0.5, 0.6], [1, 0, 0.5, 0.6]],
    "X": [[0, 0, 1, 1], [1, 0, 0, 1]]
  }

  // Colores calculados según el tema de Omarchy
  let segOn = foreground
  let segOff = alpha(segOn, 0.07)

  // A tile taller than wide (landscape home screen) puts the seconds on a second line under H:MM.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3

  onTap: screen()

  Canvas {
    // tall: digit height dh = 0.32 * sc fits H:MM (2.85 dh) in 86% of the width
    let tallLines = showSeconds ? 2.3 : 1
    let tallSc = min(0.86 * width / 2.85, height / (tallLines + 1.25)) / 0.32
    let sc = tall ? tallSc : min(width / 1.75, height)
    let ts = tall ? min(sc, width / 1.75 * 1.15) : sc
    let ox = tall ? 0 : (width - 1.75 * sc) / 2
    let oy = tall ? (height - 0.32 * sc * tallLines - 0.36 * ts) / 2 - 0.16 * sc : (height - sc) / 2
    let W = tall ? width : 1.75 * sc

    if sc > 0 {
      let dh = 0.32 * sc
      let dw = dh * 0.58
      let dgap = 0.040 * sc
      let colon = 0.090 * sc
      let dtop = oy + 0.16 * sc
      let tilt = useTilt ? 5 : 0

      let h1 = sub(hourStr, 0, 1)
      let h2 = sub(hourStr, 1, 2)
      let m1 = sub(minuteStr, 0, 1)
      let m2 = sub(minuteStr, 1, 2)
      let s1 = sub(secondStr, 0, 1)
      let s2 = sub(secondStr, 1, 2)
      let twoHour = len(hourStr) == 2

      let groupW = 2 * dw + dgap
      let hourGroupW = twoHour ? groupW : dw
      let total = showSeconds && !tall
        ? (hourGroupW + colon + groupW + colon + groupW)
        : (hourGroupW + colon + groupW)
      let startX = ox + (W - total) / 2

      let hourX = startX
      let minX = startX + hourGroupW + colon
      let secX = tall ? ox + (W - groupW) / 2 : minX + groupW + colon
      let secY = tall ? dtop + 1.3 * dh : dtop

      let hourCells = twoHour
        ? [ { ch: h1, x: hourX, y: dtop, w: dw, h: dh },
            { ch: h2, x: hourX + dw + dgap, y: dtop, w: dw, h: dh } ]
        : [ { ch: h1, x: hourX, y: dtop, w: dw, h: dh } ]
      let minCells = [ { ch: m1, x: minX, y: dtop, w: dw, h: dh },
                       { ch: m2, x: minX + dw + dgap, y: dtop, w: dw, h: dh } ]
      let secCells = showSeconds
        ? [ { ch: s1, x: secX, y: secY, w: dw, h: dh },
            { ch: s2, x: secX + dw + dgap, y: secY, w: dw, h: dh } ]
        : []

      // ================= Puntos del separador (Colon) =================
      let dot = sc * 0.018
      let cxa = hourX + hourGroupW + colon / 2 - dot / 2
      let cya = dtop + dh / 2
      rotate(tilt, cxa + dot / 2, cya) {
        rect(cxa, cya - dh * 0.18 - dot / 2, dot, dot, radius: dot * 0.2, fill: segOn)
        rect(cxa, cya + dh * 0.18 - dot / 2, dot, dot, radius: dot * 0.2, fill: segOn)
      }
      if showSeconds && !tall {
        let cxb = minX + groupW + colon / 2 - dot / 2
        rotate(tilt, cxb + dot / 2, cya) {
          rect(cxb, cya - dh * 0.18 - dot / 2, dot, dot, radius: dot * 0.2, fill: segOn)
          rect(cxb, cya + dh * 0.18 - dot / 2, dot, dot, radius: dot * 0.2, fill: segOn)
        }
      }

      // ================= Indicador AM / PM =================
      if !use24h {
        let amPmX = tall && showSeconds ? secX + groupW + 0.024 * sc : ox + (W + total) / 2 + 0.024 * sc
        text(amPm, amPmX, (tall && showSeconds ? secY : dtop) + dh * 0.28, size: 0.045 * sc, align: start, bold: true, color: alpha(segOn, 0.75))
      }

      // ================= Dígitos LCD biselados estilo calculadora =================
      let pats = ["abcdef", "bc", "abdeg", "abcdg", "bcfg", "acdfg", "acdefg", "abc", "abcdefg", "abcdfg"]

      for cell in hourCells + minCells + secCells {
        let X = cell.x
        let Y = cell.y
        let Cw = cell.w
        let Ch = cell.h
        let tk = Ch * 0.115
        let gap = tk * 0.15
        let pat = pats[num(cell.ch)]

        let sa = contains(pat, "a") ? segOn : (showGhost ? segOff : null)
        let sb = contains(pat, "b") ? segOn : (showGhost ? segOff : null)
        let sc2 = contains(pat, "c") ? segOn : (showGhost ? segOff : null)
        let sd = contains(pat, "d") ? segOn : (showGhost ? segOff : null)
        let se = contains(pat, "e") ? segOn : (showGhost ? segOff : null)
        let sf = contains(pat, "f") ? segOn : (showGhost ? segOff : null)
        let sg = contains(pat, "g") ? segOn : (showGhost ? segOff : null)

        rotate(tilt, X + Cw / 2, Y + Ch / 2) {
          if sa != null {
            path([
              [X + gap + tk * 0.5, Y],
              [X + Cw - gap - tk * 0.5, Y],
              [X + Cw - gap - tk, Y + tk],
              [X + gap + tk, Y + tk]
            ], closed: true, fill: sa)
          }
          if sb != null {
            path([
              [X + Cw - tk, Y + gap + tk],
              [X + Cw, Y + gap + tk * 0.5],
              [X + Cw, Y + Ch / 2 - gap],
              [X + Cw - tk, Y + Ch / 2 - gap - tk * 0.5]
            ], closed: true, fill: sb)
          }
          if sc2 != null {
            path([
              [X + Cw - tk, Y + Ch / 2 + gap + tk * 0.5],
              [X + Cw, Y + Ch / 2 + gap],
              [X + Cw, Y + Ch - gap - tk * 0.5],
              [X + Cw - tk, Y + Ch - gap - tk]
            ], closed: true, fill: sc2)
          }
          if sd != null {
            path([
              [X + gap + tk, Y + Ch - tk],
              [X + Cw - gap - tk, Y + Ch - tk],
              [X + Cw - gap - tk * 0.5, Y + Ch],
              [X + gap + tk * 0.5, Y + Ch]
            ], closed: true, fill: sd)
          }
          if se != null {
            path([
              [X, Y + Ch / 2 + gap],
              [X + tk, Y + Ch / 2 + gap + tk * 0.5],
              [X + tk, Y + Ch - gap - tk],
              [X, Y + Ch - gap - tk * 0.5]
            ], closed: true, fill: se)
          }
          if sf != null {
            path([
              [X, Y + gap + tk * 0.5],
              [X + tk, Y + gap + tk],
              [X + tk, Y + Ch / 2 - gap - tk * 0.5],
              [X, Y + Ch / 2 - gap]
            ], closed: true, fill: sf)
          }
          if sg != null {
            path([
              [X + gap + tk * 0.4, Y + Ch / 2],
              [X + gap + tk, Y + Ch / 2 - tk / 2],
              [X + Cw - gap - tk, Y + Ch / 2 - tk / 2],
              [X + Cw - gap - tk * 0.4, Y + Ch / 2],
              [X + Cw - gap - tk, Y + Ch / 2 + tk / 2],
              [X + gap + tk, Y + Ch / 2 + tk / 2]
            ], closed: true, fill: sg)
          }
        }
      }

      // ================= Líneas de Fecha y Clima =================
      let textTop = tall ? (showSeconds ? secY : dtop) + dh - 0.48 * ts : oy
      let dateY = textTop + 0.605 * ts
      let wxY = textTop + 0.795 * ts

      if textStyle == "clean" {
        // Tipografía monospaciada digital limpia estilo pantalla calculadora
        text(dateStr, ox + W / 2, dateY, size: 0.076 * ts, align: center, bold: true, color: alpha(segOn, 0.88))
        if wxStr != null {
          text(wxStr, ox + W / 2, wxY, size: 0.064 * ts, align: center, color: alpha(segOn, 0.80))
        }
      } else {
        // Modo 7-segmentos clásico optimizado
        let segLines = [
          { t: dateStr, cy: dateY, hmax: 0.115 * ts, maxw: 0.86 * W, col: alpha(segOn, 0.85) },
          { t: wxStr ?? "", cy: wxY, hmax: 0.098 * ts, maxw: 0.92 * W, col: alpha(segOn, 0.80) }
        ]

        let letters = ["a", "b", "c", "d", "e", "f", "g"]
        for ln in segLines {
          let t = upper(ln.t)
          let n = len(t)
          let gapF = 0.18
          let denom = n * 0.62 + max(0, n - 1) * gapF
          let cellH = denom > 0 ? min(ln.hmax, ln.maxw / denom) : ln.hmax
          let cellW = cellH * 0.62
          let gap = cellH * gapF
          let totalW = n * cellW + max(0, n - 1) * gap
          let lineX = ox + (W - totalW) / 2
          let y0 = ln.cy - cellH / 2
          let tk = cellH * 0.075

          for i in range(n) {
            let ch = sub(t, i, i + 1)
            let gx = lineX + i * (cellW + gap)

            if ch == "." {
              rect(gx + cellW * 0.25, y0 + cellH * 0.80, cellW * 0.5, cellH * 0.20, radius: cellH * 0.09, fill: ln.col)
            } else if ch == "/" {
              line(gx + cellW * 0.18, y0 + cellH, gx + cellW * 0.82, y0, stroke: ln.col, width: tk, cap: round)
            } else if ch == "°" {
              circle(gx + cellW * 0.72, y0 + cellH * 0.16, cellH * 0.13, stroke: ln.col, width: tk * 0.8)
            } else if ch == "·" {
              circle(gx + cellW * 0.5, y0 + cellH * 0.5, cellH * 0.10, fill: ln.col)
            } else {
              let on = get(segPats, ch, "") ?? ""
              let segX = [
                [gx + tk * 0.6, y0 + tk / 2, gx + cellW - tk * 0.6, y0 + tk / 2],
                [gx + cellW - tk / 2, y0 + tk * 0.8, gx + cellW - tk / 2, y0 + cellH / 2 - tk * 0.8],
                [gx + cellW - tk / 2, y0 + cellH / 2 + tk * 0.8, gx + cellW - tk / 2, y0 + cellH - tk * 0.8],
                [gx + tk * 0.6, y0 + cellH - tk / 2, gx + cellW - tk * 0.6, y0 + cellH - tk / 2],
                [gx + tk / 2, y0 + cellH / 2 + tk * 0.8, gx + tk / 2, y0 + cellH - tk * 0.8],
                [gx + tk / 2, y0 + tk * 0.8, gx + tk / 2, y0 + cellH / 2 - tk * 0.8],
                [gx + tk * 0.6, y0 + cellH / 2, gx + cellW - tk * 0.6, y0 + cellH / 2]
              ]
              for k in range(7) {
                if contains(on, letters[k]) {
                  let L = segX[k]
                  line(L[0], L[1], L[2], L[3], stroke: ln.col, width: tk, cap: round)
                }
              }
              let extra = get(segExtra, ch, []) ?? []
              for e in extra {
                line(gx + e[0] * cellW, y0 + e[1] * cellH, gx + e[2] * cellW, y0 + e[3] * cellH, stroke: ln.col, width: tk, cap: round)
              }
            }
          }
        }
      }
    }
  }

  // ---- Pantalla de configuración localizada ----
  screen {
    title: isEs ? "Reloj LCD" : "LCD Clock"
    Column {
      scroll: true
      gap: 10
      padding: 16
      Text { text: isEs ? "Ajustes del reloj" : "Clock settings"; style: title }
      Button {
        text: isEs ? "Segundos: ${showSeconds ? "activados" : "desactivados"}" : "Seconds: ${showSeconds ? "on" : "off"}"
        onTap: showSeconds = !showSeconds
      }
      Button {
        text: isEs ? "Formato de hora: ${use24h ? "24 horas" : "12 horas"}" : "Time format: ${use24h ? "24-hour" : "12-hour"}"
        onTap: use24h = !use24h
      }
      Button {
        text: isEs ? "Formato de fecha: ${dateOrder == "auto" ? "Auto (" + (isDmy ? "DD/MM" : "MM/DD") + ")" : (dateOrder == "dmy" ? "Día/Mes (DD/MM)" : "Mes/Día (MM/DD)")}" : "Date format: ${dateOrder == "auto" ? "Auto (" + (isDmy ? "DD/MM" : "MM/DD") + ")" : (dateOrder == "dmy" ? "DD/MM" : "MM/DD")}"
        onTap: dateOrder = dateOrder == "auto" ? "dmy" : (dateOrder == "dmy" ? "mdy" : "auto")
      }
      Button {
        text: isEs ? "Tipografía de texto: ${textStyle == "clean" ? "Display limpio" : "7 segmentos retro"}" : "Text typography: ${textStyle == "clean" ? "Clean display" : "7-segment retro"}"
        onTap: textStyle = textStyle == "clean" ? "segment" : "clean"
      }
      Button {
        text: isEs ? "Inclinación: ${useTilt ? "Casio (inclinado 5°)" : "Recto"}" : "Tilt: ${useTilt ? "Casio (slanted 5°)" : "Upright"}"
        onTap: useTilt = !useTilt
      }
      Button {
        text: isEs ? "Cristal LCD (fantasma): ${showGhost ? "visible" : "oculto"}" : "LCD ghost segments: ${showGhost ? "visible" : "hidden"}"
        onTap: showGhost = !showGhost
      }
      Spacer { size: 6 }
      Text {
        text: isEs ? "Creado por Madmasx" : "Created by Madmasx"
        style: label
        color: foreground
      }
      Row {
        gap: 8
        Button {
          text: "X: @Madmasx"
          weight: 1
          onTap: url("https://x.com/Madmasx")
        }
        Button {
          text: "Git: Madmasx"
          weight: 1
          onTap: url("https://github.com/Madmasx")
        }
      }
      Spacer { size: 6 }
      Text {
        text: isEs ? "Los colores se adaptan automáticamente al tema activo de Omarchy." : "Colors follow the active Omarchy theme; nothing is hard-coded."
        style: small
        color: foreground
      }
      Button {
        text: isEs ? "Cerrar" : "Close"
        color: foreground
        onTap: close()
      }
    }
  }
}
