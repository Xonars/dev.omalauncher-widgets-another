widget "Lofi Radio" {
  requires { pacman: ["python"] }

  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/92a0275693720f985c472f07036c3b14a0d7b4ee87fd7287ac28332ff5f04696.zip', '92a0275693720f985c472f07036c3b14a0d7b4ee87fd7287ac28332ff5f04696', 'xonars-lofi-radio-widget')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

  meta { owl: 19; description: "Показывает выбранную сцену Lofi Radio и открывает плеер по нажатию. · ресурсы при первом запуске"; category: "media" ; version: "1.0.1"; license: "MIT" }
  page: 2
  size: 6x3
  padding: 0
  background: #21192C
  fps: sceneRate

  source savedScene = file("~/.cache/omalauncher-lofi-radio/scene")
  source localClock = clock every 1m
  source scenes = cmd("python -c ${sh(storeBootstrap)} && cat ~/.local/share/omalauncher-store/xonars-lofi-radio-widget/widgets/lofi-radio/scenes.json") timeout 60s json
  let sceneChoice = trim(savedScene ?? "")
  let clockParts = split(fmtTime(localClock, "D M d H m", null, "en"), " ")
  let dayOfYear = num(clockParts[0], 1)
  let month = num(clockParts[1], 1)
  let monthDay = num(clockParts[2], 1)
  let hour = num(clockParts[3], 0)
  let halfHour = hour * 2 + floor(num(clockParts[4], 0) / 30)
  let period = hour < 5 || hour >= 23 ? "night" : hour < 8 ? "dawn" : hour < 16 ? "day" : hour < 19 ? "sunset" : "evening"
  let season = month < 3 || month == 12 ? "winter" : month < 6 ? "spring" : month < 9 ? "summer" : "autumn"
  let occasion =
    (month == 12 && monthDay == 31) || (month == 1 && monthDay == 1) ? "newyear" :
    (month == 12 && monthDay >= 20) || (month == 1 && monthDay <= 7) ? "christmas" :
    (month == 10 && monthDay >= 27) || (month == 11 && monthDay <= 2) ? "halloween" :
    month == 2 && monthDay >= 13 && monthDay <= 15 ? "valentines" : ""
  let eligibleScenes = filter(scenes ?? [], item => any(item.periods ?? [], part => part == period))
  let regularScenes = filter(eligibleScenes, item => item.season == null && item.occasion == null)
  let holidayScenes = filter(eligibleScenes, item => occasion != "" && item.occasion == occasion)
  let seasonalScenes = filter(eligibleScenes, item => item.season == season)
  let accentScenes = len(holidayScenes) > 0 ? holidayScenes : seasonalScenes
  // Keep special scenes occasional and rotate through the rest in order.
  let hasAccent = len(accentScenes) > 0
  let showAccent = hasAccent && halfHour % 3 == 2
  let autoPool = showAccent ? accentScenes : regularScenes
  let autoStep = showAccent ? floor(halfHour / 3) : hasAccent ? halfHour - floor(halfHour / 3) : halfHour
  let automaticScene = autoPool[(dayOfYear + autoStep) % max(1, len(autoPool))]
  let currentScene = find(scenes ?? [], item => item.id == sceneChoice) ?? automaticScene
  let sceneKey = currentScene.asset ?? "rainy-night"
  let scenePath = "~/.config/omalauncher/widgets/lofi-radio/${sceneKey}"
  let sceneFrames = currentScene.frames ?? 232
  let sceneRate = currentScene.fps ?? 8
  let sheetColumns = 8
  let sheetRows = 5
  let framesPerSheet = sheetColumns * sheetRows
  let sheetCount = ceil(sceneFrames / framesPerSheet)

  state sceneStarted = 0
  on sceneKey { sceneStarted = time }
  onTap: open("o:market-app-xonars-xonars-lofi-radio.owl")

  Box {
    fill: true
    Image {
      fill: true
      fit: cover
      label: "Открыть Lofi Radio"
      src: "${scenePath}-cover.webp"
    }
    Canvas {
      let frame = floor(max(time - sceneStarted, 0) * sceneRate) % sceneFrames
      let sheet = floor(frame / framesPerSheet)
      let nextSheet = (sheet + 1) % sheetCount
      let cell = frame % framesPerSheet
      let cellWidth = ceil(max(width, height * 16 / 9))
      let cellHeight = ceil(max(height, width * 9 / 16))
      let left = floor((width - cellWidth) / 2)
      let top = floor((height - cellHeight) / 2)

      clip(0, 0, width, height) {
        if sheetCount > 1 { image("${scenePath}-${nextSheet}.webp", -1, -1, 1, 1) }
        image(
          "${scenePath}-${sheet}.webp",
          left - (cell % sheetColumns) * cellWidth,
          top - floor(cell / sheetColumns) * cellHeight,
          sheetColumns * cellWidth,
          sheetRows * cellHeight
        )
      }
    }
  }
}
