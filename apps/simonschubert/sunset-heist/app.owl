  // The distant chassis keeps the same outline, using simpler tires with fewer faces.
  let VEHICLE_SHELLS = [V0, V1, V2, V3, V4, V5, V6, V7, V8, V9]
  let VEHICLE_MESHES = [
    {sides: 10, rings: [[-0.51, 0.58], [-0.48, 0.86], [-0.29, 1], [0.29, 1], [0.48, 0.86], [0.51, 0.58]], walls: [#263042, #182333, #152030, #182333, #263042]},
    {sides: 6, rings: [[-0.51, 1], [0.51, 1]], walls: [#182333]}
  ].map(t => [[
    range(t.sides).map(i => [cos(rad(i * 360 / t.sides)), sin(rad(i * 360 / t.sides))]),
    [reverse(range(t.sides))]
      + flatten(range(len(t.rings) - 1).map(r => range(t.sides).map(i =>
        [r * t.sides + i, r * t.sides + (i + 1) % t.sides, (r + 1) * t.sides + (i + 1) % t.sides, (r + 1) * t.sides + i])))
      + [range((len(t.rings) - 1) * t.sides, len(t.rings) * t.sides)],
    [#80969f] + flatten(t.walls.map(c => range(t.sides).map(i => c))) + [#80969f]
  ]].map(pattern => VEHICLE_SHELLS.map(body => mesh(
    body.points + flatten(body.wheels.map(w => flatten(t.rings.map(r => pattern[0].map(v =>
      [w[0] + w[3] * r[0], w[1] + w[1] * r[1] * v[0], w[2] + w[4] * r[1] * v[1]]))))),
    body.faces + flatten(body.wheels.map((w, j) => pattern[1].map(f => f.map(i => len(body.points) + j * t.sides * len(t.rings) + i)))),
    body.colors + flatten(body.wheels.map(w => pattern[2])))))[0])
  let VEH = VEHICLE_MESHES[0]
  let VEH_FAR = VEHICLE_MESHES[1]
  // How each drives: top speed and pick-up, turning, how its tires hold (sideways speed left after a second,
  // gripping and sliding), how much damage it takes, and how big it is to hit.
  let TYPES = [
    {name: "compact", len: 3.72, wid: 1.74, top: 30, acc: 28, turn: 1.15, grip: 0.0003, drift: 0.35, armor: 1, r: 1.78},
    {name: "sedan", len: 4.54, wid: 1.86, top: 34, acc: 26, turn: 1, grip: 0.0004, drift: 0.3, armor: 1, r: 2.12},
