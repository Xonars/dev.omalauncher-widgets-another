    {name: "gran turismo", len: 4.64, wid: 1.92, top: 50, acc: 38, turn: 1.18, grip: 0.00008, drift: 0.38, armor: 1.25, r: 2.15},
    {name: "police car", len: 4.69, wid: 1.89, top: 40, acc: 30, turn: 1.05, grip: 0.0004, drift: 0.3, armor: 0.8, r: 2.18}
  ]
  // Two cars touching: each a box {x, z, h, l, w} (heading, length, width). Of the four ways two boxes can be told
  // apart, along and across each, the one they overlap least on is where they meet: o is how deep (0 or less: they
  // don't touch), and (nx, nz) the way from the first to the second. v = [first, second].
  let SAT = v => [[sin(rad(v[0].h)), cos(rad(v[0].h)), sin(rad(v[1].h)), cos(rad(v[1].h)), v[1].x - v[0].x, v[1].z - v[0].z]].map(q => first(sortBy([[q[0], q[1]], [q[1], -q[0]], [q[2], q[3]], [q[3], -q[2]]].map(u => [u[0] * q[4] + u[1] * q[5]].map(d => {o: v[0].l / 2 * abs(u[0] * q[0] + u[1] * q[1]) + v[0].w / 2 * abs(u[0] * q[1] - u[1] * q[0]) + v[1].l / 2 * abs(u[0] * q[2] + u[1] * q[3]) + v[1].w / 2 * abs(u[0] * q[3] - u[1] * q[2]) - abs(d), nx: d < 0 ? -u[0] : u[0], nz: d < 0 ? -u[1] : u[1]})[0]), a => a.o)))[0]
