  let GUN1 = mesh([[-0.11, 0.18, -0.3], [0.11, 0.18, -0.3], [-0.11, 0.38, -0.3], [0.11, 0.38, -0.3], [-0.11, 0.18, 0.6], [0.11, 0.18, 0.6], [-0.11, 0.38, 0.6], [0.11, 0.38, 0.6], [-0.05, 0.24, 0.6], [0.05, 0.24, 0.6], [-0.05, 0.32, 0.6], [0.05, 0.32, 0.6], [-0.05, 0.24, 0.95], [0.05, 0.24, 0.95], [-0.05, 0.32, 0.95], [0.05, 0.32, 0.95], [-0.08, -0.12, -0.15], [0.08, -0.12, -0.15], [-0.08, 0.18, -0.15], [0.08, 0.18, -0.15], [-0.08, -0.12, 0.03], [0.08, -0.12, 0.03], [-0.08, 0.18, 0.03], [0.08, 0.18, 0.03], [-0.06, -0.18, 0.25], [0.06, -0.18, 0.25], [-0.06, 0.18, 0.25], [0.06, 0.18, 0.25], [-0.06, -0.18, 0.39], [0.06, -0.18, 0.39], [-0.06, 0.18, 0.39], [0.06, 0.18, 0.39]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14], [16, 20, 22, 18], [17, 19, 23, 21], [16, 17, 21, 20], [18, 22, 23, 19], [16, 18, 19, 17], [20, 21, 23, 22], [24, 28, 30, 26], [25, 27, 31, 29], [24, 25, 29, 28], [26, 30, 31, 27], [24, 26, 27, 25], [28, 29, 31, 30]], [#3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018, #121018])
  let GUN2 = mesh([[-0.06, 0.26, -0.2], [0.06, 0.26, -0.2], [-0.06, 0.38, -0.2], [0.06, 0.38, -0.2], [-0.06, 0.26, 1.25], [0.06, 0.26, 1.25], [-0.06, 0.38, 1.25], [0.06, 0.38, 1.25], [-0.09, 0.15, 0.55], [0.09, 0.15, 0.55], [-0.09, 0.26, 0.55], [0.09, 0.26, 0.55], [-0.09, 0.15, 0.95], [0.09, 0.15, 0.95], [-0.09, 0.26, 0.95], [0.09, 0.26, 0.95], [-0.1, 0.05, -0.85], [0.1, 0.05, -0.85], [-0.1, 0.35, -0.85], [0.1, 0.35, -0.85], [-0.1, 0.05, -0.2], [0.1, 0.05, -0.2], [-0.1, 0.35, -0.2], [0.1, 0.35, -0.2], [-0.08, -0.12, -0.25], [0.08, -0.12, -0.25], [-0.08, 0.16, -0.25], [0.08, 0.16, -0.25], [-0.08, -0.12, -0.07], [0.08, -0.12, -0.07], [-0.08, 0.16, -0.07], [0.08, 0.16, -0.07]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14], [16, 20, 22, 18], [17, 19, 23, 21], [16, 17, 21, 20], [18, 22, 23, 19], [16, 18, 19, 17], [20, 21, 23, 22], [24, 28, 30, 26], [25, 27, 31, 29], [24, 25, 29, 28], [26, 30, 31, 27], [24, 26, 27, 25], [28, 29, 31, 30]], [#3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #3a3a4c, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #8a5a3a, #121018, #121018, #121018, #121018, #121018, #121018])
  let CROSS = mesh([[-0.6, -0.18, -0.18], [0.6, -0.18, -0.18], [-0.6, 0.18, -0.18], [0.6, 0.18, -0.18], [-0.6, -0.18, 0.18], [0.6, -0.18, 0.18], [-0.6, 0.18, 0.18], [0.6, 0.18, 0.18], [-0.18, -0.6, -0.18], [0.18, -0.6, -0.18], [-0.18, 0.6, -0.18], [0.18, 0.6, -0.18], [-0.18, -0.6, 0.18], [0.18, -0.6, 0.18], [-0.18, 0.6, 0.18], [0.18, 0.6, 0.18]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14]], [null, null, null, null, null, null, null, null, null, null, null, null])
  let CASHB = mesh([[-0.55, -0.2, -0.3], [0.55, -0.2, -0.3], [-0.55, 0.2, -0.3], [0.55, 0.2, -0.3], [-0.55, -0.2, 0.3], [0.55, -0.2, 0.3], [-0.55, 0.2, 0.3], [0.55, 0.2, 0.3], [-0.57, -0.06, -0.12], [0.57, -0.06, -0.12], [-0.57, 0.06, -0.12], [0.57, 0.06, -0.12], [-0.57, -0.06, 0.12], [0.57, -0.06, 0.12], [-0.57, 0.06, 0.12], [0.57, 0.06, 0.12]], [[0, 4, 6, 2], [1, 3, 7, 5], [0, 1, 5, 4], [2, 6, 7, 3], [0, 2, 3, 1], [4, 5, 7, 6], [8, 12, 14, 10], [9, 11, 15, 13], [8, 9, 13, 12], [10, 14, 15, 11], [8, 10, 11, 9], [12, 13, 15, 14]], [null, null, null, null, null, null, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee, #e8f8ee])
  let GUNS = [GUN0, GUN1, GUN2]
  // Lamps on every other block corner.
  let LAMP = #e8e6dc
  // People are built in world meters. Beveled cross-sections keep joints and silhouettes legible.
  let OCTAGON = [[-0.64, -1], [-1, -0.64], [-1, 0.64], [-0.64, 1], [0.64, 1], [1, 0.64], [1, -0.64], [0.64, -1]]
  let OCT_FACES = [[7, 6, 5, 4, 3, 2, 1, 0], [8, 9, 10, 11, 12, 13, 14, 15]]
    + range(8).map(i => [i, (i + 1) % 8, (i + 1) % 8 + 8, i + 8])
  // Each part has two cross-sections: y, half-width, half-depth, then the center in x and z.
  let CHARACTER_MESH = parts => mesh(
    flatten(parts.map(q => flatten([q.lo, q.hi].map(r => OCTAGON.map(v => [q.x + v[0] * r[1], r[0], q.z + v[1] * r[2]]))))),
    flatten(parts.map((q, i) => OCT_FACES.map(f => f.map(v => v + i * 16)))),
    flatten(parts.map(q => OCT_FACES.map(f => q.color))))
  let OUTFITS = [
    {coat: #b36d3d, trim: #e8ad62, pants: #283847, skin: #b47956, hair: #30242a, shoes: #dccbbb},
    {coat: #283953, trim: #42a6ad, pants: #242d42, skin: #b98366, hair: #262836, shoes: #171d26},
    {coat: #b45d60, trim: #df8d76, pants: #414354, skin: #e3b188, hair: #5e3940, shoes: #e8c6ab},
    {coat: #4b7678, trim: #8fb2a0, pants: #354450, skin: #82523f, hair: #2b2632, shoes: #bc8f6f},
    {coat: #d4ac75, trim: #edd0a0, pants: #47536b, skin: #c58a65, hair: #342732, shoes: #e5d2c0},
    {coat: #a18cbb, trim: #dbb1cd, pants: #393751, skin: #d4a083, hair: #4b3431, shoes: #c597a8},
    {coat: #6e8c61, trim: #a8b686, pants: #484650, skin: #966247, hair: #322827, shoes: #cbbda7},
    {coat: #6c84ab, trim: #aac2ce, pants: #34384a, skin: #e2b69f, hair: #634a39, shoes: #d4aa9e}
  ]
  let TORSOS = OUTFITS.map((c, i) => [
    [{lo: [0.79, 0.142, 0.092], hi: [0.98, 0.153, 0.096], x: 0, z: 0, color: c.pants},
      {lo: [0.94, 0.144, 0.103], hi: [1.44, 0.203, 0.117], x: 0, z: 0, color: c.coat},
      {lo: [1.37, 0.203, 0.116], hi: [1.48, 0.118, 0.095], x: 0, z: 0, color: c.trim},
      {lo: [1.43, 0.062, 0.068], hi: [1.57, 0.058, 0.061], x: 0, z: 0, color: c.skin},
      {lo: [1.52, 0.061, 0.072], hi: [1.69, 0.105, 0.096], x: 0, z: 0.015, color: c.skin},
      {lo: [1.69, 0.106, 0.102], hi: [1.79, 0.085, 0.085], x: 0, z: 0.003, color: c.hair},
      {lo: [1.596, 0.095, 0.034], hi: [1.735, 0.096, 0.034], x: 0, z: -0.061, color: c.hair}]
