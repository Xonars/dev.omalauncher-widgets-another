app "Key Bindings" {
  requires { pacman: ["python"] }

  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/9ae5ebe65a9746a09da61f24c37b61c6af20d87da5f14da78f1409874fcf1868.zip', '9ae5ebe65a9746a09da61f24c37b61c6af20d87da5f14da78f1409874fcf1868', 'xonars-key-bindings')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

 meta { owl: 17; description: "Клавиатура, сочетания и диагностика ввода · ресурсы при первом запуске"; version: "1.1.1" ; license: "MIT"; category: "system" }
 title: ""
 icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"><rect x="3" y="10" width="42" height="28" rx="4"/><path d="M10 18h2m6 0h2m6 0h2m6 0h3M10 25h2m6 0h2m6 0h2m6 0h3M13 32h22"/></svg>"""
 source event = file("~/.local/share/omalauncher-store/xonars-key-bindings/widgets/key-bindings/events.json") json
 state query = ""
 let pressed = event.keys ?? []
 let caps = [{"label": "ESC", "x": 0.0, "w": 0.07692307692307693, "row": 0}, {"label": "F1", "x": 0.07692307692307693, "w": 0.07692307692307693, "row": 0}, {"label": "F2", "x": 0.15384615384615385, "w": 0.07692307692307693, "row": 0}, {"label": "F3", "x": 0.23076923076923078, "w": 0.07692307692307693, "row": 0}, {"label": "F4", "x": 0.3076923076923077, "w": 0.07692307692307693, "row": 0}, {"label": "F5", "x": 0.38461538461538464, "w": 0.07692307692307693, "row": 0}, {"label": "F6", "x": 0.46153846153846156, "w": 0.07692307692307693, "row": 0}, {"label": "F7", "x": 0.5384615384615384, "w": 0.07692307692307693, "row": 0}, {"label": "F8", "x": 0.6153846153846154, "w": 0.07692307692307693, "row": 0}, {"label": "F9", "x": 0.6923076923076923, "w": 0.07692307692307693, "row": 0}, {"label": "F10", "x": 0.7692307692307693, "w": 0.07692307692307693, "row": 0}, {"label": "F11", "x": 0.8461538461538461, "w": 0.07692307692307693, "row": 0}, {"label": "F12", "x": 0.9230769230769231, "w": 0.07692307692307693, "row": 0}, {"label": "`", "x": 0.0, "w": 0.06802721088435375, "row": 1}, {"label": "1", "x": 0.06802721088435375, "w": 0.06802721088435375, "row": 1}, {"label": "2", "x": 0.1360544217687075, "w": 0.06802721088435375, "row": 1}, {"label": "3", "x": 0.20408163265306123, "w": 0.06802721088435375, "row": 1}, {"label": "4", "x": 0.272108843537415, "w": 0.06802721088435375, "row": 1}, {"label": "5", "x": 0.3401360544217687, "w": 0.06802721088435375, "row": 1}, {"label": "6", "x": 0.40816326530612246, "w": 0.06802721088435375, "row": 1}, {"label": "7", "x": 0.4761904761904762, "w": 0.06802721088435375, "row": 1}, {"label": "8", "x": 0.54421768707483, "w": 0.06802721088435375, "row": 1}, {"label": "9", "x": 0.6122448979591837, "w": 0.06802721088435375, "row": 1}, {"label": "0", "x": 0.6802721088435374, "w": 0.06802721088435375, "row": 1}, {"label": "-", "x": 0.7482993197278912, "w": 0.06802721088435375, "row": 1}, {"label": "=", "x": 0.8163265306122449, "w": 0.06802721088435375, "row": 1}, {"label": "BKSP", "x": 0.8843537414965987, "w": 0.11564625850340136, "row": 1}, {"label": "TAB", "x": 0.0, "w": 0.11564625850340136, "row": 2}, {"label": "Q", "x": 0.11564625850340136, "w": 0.06802721088435375, "row": 2}, {"label": "W", "x": 0.1836734693877551, "w": 0.06802721088435375, "row": 2}, {"label": "E", "x": 0.25170068027210885, "w": 0.06802721088435375, "row": 2}, {"label": "R", "x": 0.3197278911564626, "w": 0.06802721088435375, "row": 2}, {"label": "T", "x": 0.38775510204081637, "w": 0.06802721088435375, "row": 2}, {"label": "Y", "x": 0.4557823129251701, "w": 0.06802721088435375, "row": 2}, {"label": "U", "x": 0.5238095238095238, "w": 0.06802721088435375, "row": 2}, {"label": "I", "x": 0.5918367346938775, "w": 0.06802721088435375, "row": 2}, {"label": "O", "x": 0.6598639455782312, "w": 0.06802721088435375, "row": 2}, {"label": "P", "x": 0.7278911564625851, "w": 0.06802721088435375, "row": 2}, {"label": "[", "x": 0.7959183673469388, "w": 0.06802721088435375, "row": 2}, {"label": "]", "x": 0.8639455782312925, "w": 0.06802721088435375, "row": 2}, {"label": "\\", "x": 0.9319727891156463, "w": 0.06802721088435375, "row": 2}, {"label": "CAPS", "x": 0.0, "w": 0.11805555555555555, "row": 3}, {"label": "A", "x": 0.11805555555555555, "w": 0.06944444444444445, "row": 3}, {"label": "S", "x": 0.1875, "w": 0.06944444444444445, "row": 3}, {"label": "D", "x": 0.2569444444444445, "w": 0.06944444444444445, "row": 3}, {"label": "F", "x": 0.3263888888888889, "w": 0.06944444444444445, "row": 3}, {"label": "G", "x": 0.3958333333333333, "w": 0.06944444444444445, "row": 3}, {"label": "H", "x": 0.4652777777777778, "w": 0.06944444444444445, "row": 3}, {"label": "J", "x": 0.5347222222222222, "w": 0.06944444444444445, "row": 3}, {"label": "K", "x": 0.6041666666666666, "w": 0.06944444444444445, "row": 3}, {"label": "L", "x": 0.673611111111111, "w": 0.06944444444444445, "row": 3}, {"label": ";", "x": 0.7430555555555555, "w": 0.06944444444444445, "row": 3}, {"label": "'", "x": 0.8124999999999999, "w": 0.06944444444444445, "row": 3}, {"label": "ENTER", "x": 0.8819444444444444, "w": 0.11805555555555555, "row": 3}, {"label": "SHIFT", "x": 0.0, "w": 0.12686567164179105, "row": 4}, {"label": "Z", "x": 0.12686567164179105, "w": 0.07462686567164178, "row": 4}, {"label": "X", "x": 0.20149253731343283, "w": 0.07462686567164178, "row": 4}, {"label": "C", "x": 0.27611940298507465, "w": 0.07462686567164178, "row": 4}, {"label": "V", "x": 0.35074626865671643, "w": 0.07462686567164178, "row": 4}, {"label": "B", "x": 0.4253731343283582, "w": 0.07462686567164178, "row": 4}, {"label": "N", "x": 0.5, "w": 0.07462686567164178, "row": 4}, {"label": "M", "x": 0.5746268656716418, "w": 0.07462686567164178, "row": 4}, {"label": ",", "x": 0.6492537313432835, "w": 0.07462686567164178, "row": 4}, {"label": ".", "x": 0.7238805970149254, "w": 0.07462686567164178, "row": 4}, {"label": "/", "x": 0.7985074626865671, "w": 0.07462686567164178, "row": 4}, {"label": "SHIFT", "x": 0.8731343283582089, "w": 0.12686567164179105, "row": 4}, {"label": "CTRL", "x": 0.0, "w": 0.1, "row": 5}, {"label": "SUPER", "x": 0.1, "w": 0.1, "row": 5}, {"label": "ALT", "x": 0.2, "w": 0.1, "row": 5}, {"label": "SPACE", "x": 0.3, "w": 0.4, "row": 5}, {"label": "ALT", "x": 0.7, "w": 0.1, "row": 5}, {"label": "SUPER", "x": 0.8, "w": 0.1, "row": 5}, {"label": "CTRL", "x": 0.9, "w": 0.1, "row": 5}, {"label": "INS", "x": 0.0, "w": 0.1, "row": 6}, {"label": "HOME", "x": 0.1, "w": 0.1, "row": 6}, {"label": "PGUP", "x": 0.2, "w": 0.1, "row": 6}, {"label": "DEL", "x": 0.3, "w": 0.1, "row": 6}, {"label": "END", "x": 0.4, "w": 0.1, "row": 6}, {"label": "PGDN", "x": 0.5, "w": 0.1, "row": 6}, {"label": "LEFT", "x": 0.6, "w": 0.1, "row": 6}, {"label": "DOWN", "x": 0.7, "w": 0.1, "row": 6}, {"label": "UP", "x": 0.8, "w": 0.1, "row": 6}, {"label": "RIGHT", "x": 0.9, "w": 0.1, "row": 6}]
 let bindings = [{"combo": "DELETE", "name": "Удалить выбранный виджет. Сначала выберите его; закройте открытые меню.", "codes": ["DEL"], "scope": "Рабочий стол"}, {"combo": "INSERT", "name": "Открыть меню добавления на рабочий стол.", "codes": ["INS"], "scope": "Рабочий стол"}, {"combo": "↑ ↓ ← →", "name": "Перемещать фокус между виджетами и элементами интерфейса.", "codes": ["UP", "DOWN", "LEFT", "RIGHT"], "scope": "Рабочий стол"}, {"combo": "ESC", "name": "Назад: закрыть текущее окно, меню или панель.", "codes": ["ESC"], "scope": "Рабочий стол"}, {"combo": "SUPER + D", "name": "Открыть / закрыть меню приложений", "codes": ["SUPER + D"], "scope": "Домашний экран"}, {"combo": "SUPER + SPACE", "name": "Меню приложений · если Android пропускает", "codes": ["SUPER + SPACE"], "scope": "Домашний экран"}, {"combo": "SUPER + T", "name": "Открыть терминал", "codes": ["SUPER + T"], "scope": "Домашний экран"}, {"combo": "SUPER + ENTER", "name": "Терминал · если Android пропускает", "codes": ["SUPER + ENTER"], "scope": "Домашний экран"}, {"combo": "SUPER + DOWN", "name": "Открыть / закрыть верхнюю панель", "codes": ["SUPER + DOWN"], "scope": "Домашний экран"}, {"combo": "SUPER + A", "name": "Перейти к строке запроса", "codes": ["SUPER + A"], "scope": "Домашний экран"}, {"combo": "SUPER + 1…9", "name": "Перейти на страницу домашнего экрана", "codes": ["SUPER + 1…9"], "scope": "Домашний экран"}]
 let matched = bindings.find(b => contains(b.codes, event.combo ?? ""))
 let filtered = bindings.filter(b => contains(lower(b.combo + " " + join(b.codes, " ") + " " + b.name + " " + b.scope), lower(query)))
 Column {
  fill: true; padding: 16; gap: 12; scroll: true
  Row {
   Column { weight: 1; gap: 2
    Text { text: "Keybindings"; font: mono; fontSize: 25 }
    Text { text: "КЛАВИАТУРА / ДИАГНОСТИКА"; fontSize: 10; color: muted; letterSpacing: 2 }
   }
   Text { text: "${event.count ?? 0} событий"; font: mono; color: accent; fontSize: 11 }
  }
  Canvas {
   fill: width; height: 224
   for k in caps {
    let hot = contains(pressed, k.label)
    rect(k.x * width + 2, k.row * 28 + 2, k.w * width - 4, 24, radius: 3, fill: hot ? accent : alpha(foreground, 0.035), stroke: hot ? accent : alpha(foreground, 0.25), width: 1)
    text(k.label, (k.x + k.w / 2) * width, k.row * 28 + 14, size: min(9, width / 50), align: center, color: hot ? background : foreground, font: mono)
   }
   text("ANSI / US   ·   подсветка 450 мс", width / 2, 216, size: 10, align: center, color: muted, font: mono)
  }
  Column { padding: 12; border: 1; borderColor: alpha(accent, 0.5); radius: 6; gap: 5
   Text { text: event.combo ?? "Ожидание клавиши"; font: mono; fontSize: 19; color: accent }
   if matched != null {
    Text { text: matched.name; fontSize: 12 }
    Text { text: "Контекст: ${matched.scope}"; fontSize: 10; color: muted }
   }
   Text { text: "HEX  ${event.raw ?? "—"}"; font: mono; fontSize: 11; color: muted }
  }
  Text { text: "01  ПРИЁМ КЛАВИШ"; color: muted; font: mono; fontSize: 11 }
  Text { text: "Коснитесь терминала ниже, затем нажимайте клавиши физической клавиатуры. После касания поиска снова активируйте терминал."; fontSize: 12 }
  Terminal { command: "python -c ${sh(storeBootstrap)} && python3 /root/.local/share/omalauncher-store/xonars-key-bindings/widgets/key-bindings/receiver.py"; height: 82; fill: width; fontSize: 10 }
  Text { text: "02  ШОРТКАТЫ · РАБОЧИЙ СТОЛ И ЛАУНЧЕР"; color: muted; font: mono; fontSize: 11 }
  Input { text: query; placeholder: "Поиск сочетания или действия…"; onChange: query = value }
  for b in filtered {
   Column { gap: 4; padding: 8; fill: width; radius: 5
    background: contains(b.codes, event.combo ?? "") ? alpha(accent, 0.12) : alpha(accent, 0)
    Text { text: b.scope; fontSize: 10; color: muted }
    Text { text: b.combo; font: mono; color: accent; fontSize: 12 }
    Text { text: b.name; fontSize: 12 }
   }
  }
  if len(filtered) == 0 { Text { text: "Ничего не найдено"; color: muted } }
  Text { text: "03  ПОСЛЕДНИЕ СОБЫТИЯ"; color: muted; font: mono; fontSize: 11 }
  for h in (event.history ?? []) { Text { text: h; font: mono; fontSize: 12 } }
  Text { text: "Приём через терминал: отпускания и отдельные модификаторы не доступны. Android может перехватывать Super. Полученное сочетание подтверждает ввод, но не выполнение действия. Проверка внешнего дисплея — следующий этап."; fontSize: 11; color: muted }
  Spacer { height: 16 }
 }
}
