  while ((m = re.exec(s))) {
    if (m[4]) { if (m[4] === 'M' && (+m[1] & 3) === 0 && !(+m[1] & 32) && !(+m[1] & 64)) click(+m[2], +m[3]); }
    else key(m[0]);
