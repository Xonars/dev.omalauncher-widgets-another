    case 'new': if (!confirmed('new')) return; cancelThink(); newGame(); resetBoard(); maybeEngine(); return;
    case 'side': if (G.mode || !confirmed('side')) return; cancelThink(); G.playerWhite = !G.playerWhite; G.flip = false; newGame(); resetBoard(); maybeEngine(); return;
    case 'undo': {
      if (!G.hist.length) return;
      if (G.result && G.result.time) { toast('The game is over', 2000); return; }
      cancelThink(); G.result = null; U.offer = -1; undoOne(); if (G.hist.length && side === engineSide()) undoOne();
      const l = G.hist[G.hist.length - 1]; U.last = l ? { from: mvFrom(l.m), to: mvTo(l.m) } : null;
      U.sel = -1; U.targets = []; U.hint = null; U.promo = null; save(); U.res = gameResult(); maybeEngine(); return;
    }
    case 'hint': {
      if (G.mode) { toast('No hints in 2-player games', 2500); return render(); }
      if (U.res.over || side !== humanSide()) return;
      U.thinking = true; const tok = ++U.token; toast('Looking for a move…', 5000); render();
      thinkAsync(5, 1200, r => { if (tok !== U.token) return; U.thinking = false; U.msgUntil = 0; const m = r.move ? moveFromUci(r.move) : 0; if (m) U.hint = { from: mvFrom(m), to: mvTo(m) }; render(); });
