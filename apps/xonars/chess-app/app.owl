  const move = (dr, dc) => { U.kb = true; const d = displayOf(U.cursor); const r = Math.min(7, Math.max(0, d.r + dr)), c = Math.min(7, Math.max(0, d.c + dc)); U.cursor = sqAtDisplay(r, c); render(); };
  if (U.promo) { const t = { q: 5, r: 4, b: 3, n: 2 }[k.toLowerCase()]; if (t) { doPromo(t); return; } if (k === '\x1b') { U.promo = null; render(); } return; }
  if (U.view !== 'game') { if (k === '\x1b' || k === 'm') act('close'); return; }
  switch (k) {
    case '\x1b[A': case 'k': return move(-1, 0);
    case '\x1b[B': case 'j': return move(1, 0);
    case '\x1b[C': case 'l': return move(0, 1);
    case '\x1b[D': return move(0, -1);
    case '\r': case ' ': return trySelect(U.cursor);
    case '\x1b': U.sel = -1; U.targets = []; U.typed = ''; return render();
    case 'p': return act('pause');
    case 'n': return act('new'); case 'u': return act('undo'); case '?': return act('hint'); case 'x': return act('flip'); case 'm': return act('menu');
    case '+': case '=': return act('lvp'); case '-': return act('lvm'); case 's': return act('side'); case 'i': return act('glyphs');
  }
  if (k >= '1' && k <= '6' && !U.typed && !G.mode) { G.level = +k; save(); toast('Level ' + G.level + ': ' + LEVELS[G.level - 1].name, 2000); return render(); }
