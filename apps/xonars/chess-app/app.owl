// ---- input
function click(rx, ry) {
  let cx, cy, px, py;
  if (M.img && M.pix) { px = rx - 1; py = ry - 1; cx = Math.floor(px / M.cw); cy = Math.floor(py / M.ch); }
  else if (M.img) { cx = rx - 1; cy = ry - 1; px = (cx + 0.5) * M.cw; py = (cy + 0.5) * M.ch; }
  else { cx = rx - 1; cy = ry - 1; }
  if (M.img && U.view === 'game' && IMG && cy < IMG.rows) { const sq = squareAtPx(px, py); if (sq >= 0) { U.cursor = sq; trySelect(sq); } return; }
  for (const h of U.hits) if (cx >= h.x && cx < h.x + h.w && cy >= h.y && cy < h.y + h.h) {
    if (h.act !== undefined) act(h.act); else { U.cursor = h.sq; trySelect(h.sq); }
    return;
  }
}
function key(k) {
