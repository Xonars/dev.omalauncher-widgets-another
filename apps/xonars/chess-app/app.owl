    else if (U.targets.includes(s)) fr.disc(x + sq / 2, y + sq / 2, sq * 0.13, fr.col(mixc(C.fg, bg, 0.3)));
    if (U.targets.includes(s) && pc) fr.disc(x + sq / 2, y + sq / 2, sq * 0.46, fr.col(mixc(C.fg, bg, 0.3)), Math.max(2, k * 2));
