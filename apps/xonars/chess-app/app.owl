}
function cleanup() { process.stdout.write('\x1b[?1016l\x1b[?1000l\x1b[?1006l\x1b[?7h\x1b[?25h\x1b[?1049l'); try { process.stdin.setRawMode(false); } catch (e) { /* ignore */ } }
function start() {
  U.started = true;
  M.img = !!(M.sixel && M.cw > 0 && M.ch > 0 && !process.env.CHESS_NOIMG); M.pix = !!(M.img && M.pixOk);
  if (M.pix) process.stdout.write('\x1b[?1016h');
  U.needClear = true; render(); maybeEngine();
}
function main() {
  if (!process.stdin.isTTY) { console.error('chess needs a terminal'); process.exit(1); }
  setupColors(); load(); if (process.env.CHESS_FEN) { setFen(process.env.CHESS_FEN); G.hist = []; G.keys = [keyNow()]; }
  U.res = gameResult();
  const l = G.hist[G.hist.length - 1]; if (l) U.last = { from: mvFrom(l.m), to: mvTo(l.m) };
  process.stdin.setRawMode(true); process.stdin.resume(); process.stdin.on('data', onData);
  process.stdout.write('\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1006h');
  process.stdout.on('resize', () => { U.needClear = true; render(); }); process.on('exit', cleanup); process.on('SIGTERM', () => process.exit(0)); process.on('SIGHUP', () => process.exit(0));
  // ask the terminal for its cell size in pixels, sixel support and pixel mouse reports; fall back to text-only pieces
  setInterval(clockTick, 500);
  if (process.env.CHESS_CELL) { const [w, h] = process.env.CHESS_CELL.split('x'); M.cw = +w; M.ch = +h; M.sixel = true; start(); return; }
  process.stdout.write('\x1b[?1016$p\x1b[16t\x1b[14t\x1b[15t\x1b[18t\x1b[c'); // DA1 last: when it is answered the rest is too
  setTimeout(() => { if (!U.started) start(); }, 4000); // no answer at all: text-only fallback (switches to the picture if the answer comes late)
}
if (!isMainThread) workerLoop();
else if ((require.main === module || process.env.CHESS_RUN) && !process.env.CHESS_NOMAIN) main();
CHESS_JS_EOF
exec node ~/.cache/owl-chess/chess.js
"""
  }
}
