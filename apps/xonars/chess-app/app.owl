}

/* ================= game: history, SAN, results, persistence ================= */
const fs = require('fs'), os = require('os'), path = require('path');
const SAVE_FILE = path.join(os.homedir(), '.local', 'state', 'owl-chess', 'game.json');
const CLOCKS = [{ name: 'Off', base: 0, inc: 0 }, { name: '3 min', base: 180, inc: 0 }, { name: '5 min', base: 300, inc: 0 }, { name: '10 min', base: 600, inc: 0 }, { name: '10+5', base: 600, inc: 5 }, { name: '15+10', base: 900, inc: 10 }];
const G = { hist: [], keys: [], level: 3, playerWhite: true, flip: false, result: null, clock: 0, nextClock: 0, left: [0, 0], mode: 0, nextMode: 0, autoFlip: false, paused: false, startFen: START_FEN };
