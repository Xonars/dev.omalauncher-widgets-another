}
function save() {
  try {
    fs.mkdirSync(path.dirname(SAVE_FILE), { recursive: true });
    fs.writeFileSync(SAVE_FILE, JSON.stringify({ v: 2, level: G.level, playerWhite: G.playerWhite, flip: G.flip, clock: G.clock, next: G.nextClock, mode: G.mode, nextMode: G.nextMode, autoFlip: G.autoFlip, paused: G.paused, left: G.left, result: G.result, moves: G.hist.map(h => uciOf(h.m)) }));
  } catch (e) { /* best effort */ }
}
function load() {
  newGame();
  try {
    const d = JSON.parse(fs.readFileSync(SAVE_FILE, 'utf8'));
    if (d.level >= 1 && d.level <= LEVELS.length) G.level = d.level;
    G.playerWhite = d.playerWhite !== false; G.flip = !!d.flip; if (d.clock >= 0 && d.clock < CLOCKS.length) G.clock = d.clock;
    G.nextClock = d.next >= 0 && d.next < CLOCKS.length ? d.next : G.clock; resetClock();
    for (const u of d.moves || []) {
      const from = u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, to = u.charCodeAt(2) - 97 + (+u[3] - 1) * 8, pr = u[4] ? '  nbrq'.indexOf(u[4]) : undefined;
      const c = findMove(from, to, pr); if (!c.length) throw new Error('bad move'); playMove(c[0]);
    }
    if (!G.hist.length) { G.clock = G.nextClock; resetClock(); }
    if (Array.isArray(d.left) && d.left.length === 2 && CLOCKS[G.clock].base) G.left = d.left.map(x => Math.max(0, +x || 0));
    G.result = d.result && d.result.over ? d.result : null;
    G.mode = d.mode === 1 ? 1 : 0; G.nextMode = d.nextMode === 1 || d.nextMode === 0 ? d.nextMode : G.mode; if (!G.hist.length) G.mode = G.nextMode;
    G.autoFlip = !!d.autoFlip; G.paused = !!d.paused && !G.result;
  } catch (e) { newGame(); }
}
function bookMove() {
  const opts = { '': ['e2e4', 'd2d4', 'g1f3', 'c2c4'], e2e4: ['e7e5', 'c7c5', 'e7e6', 'c7c6'], d2d4: ['d7d5', 'g8f6', 'e7e6'], g1f3: ['d7d5', 'g8f6', 'c7c5'], c2c4: ['e7e5', 'g8f6', 'c7c5'] };
  if (G.hist.length > 1 || G.level < 3) return 0;
  const list = opts[G.hist.length ? uciOf(G.hist[0].m) : '']; if (!list) return 0;
  const u = list[Math.floor(Math.random() * list.length)];
  const c = findMove(u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, u.charCodeAt(2) - 97 + (+u[3] - 1) * 8);
  return c.length ? c[0] : 0;
}

