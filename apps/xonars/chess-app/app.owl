function think(level, msOverride) {
  const L = LEVELS[level - 1], moves = legalMoves();
  lastScore = 0; if (!moves.length) return 0; if (moves.length === 1) return moves[0];
  const ms = msOverride || L.ms; deadline = Date.now() + ms; aborted = false; nodes = 0;
  if (L.noise) {
    // weak levels: score every root move at a shallow depth and blur the scores
    let best = moves[0], bs = -Infinity; deadline = Date.now() + 4000;
    for (const m of moves) {
      make(m); let v = -search(L.depth - 1, -INF, INF, 1, true); unmake(m);
      v += (Math.random() * 2 - 1) * L.noise; if (v > bs) { bs = v; best = m; }
    }
    lastScore = Math.round(bs);
    return best;
  }
  killers.fill(0); history.fill(0);
  let best = moves[0];
  for (let d = 1; d <= L.depth; d++) {
    let bm = 0, bv = -INF, alpha = -INF; const done = aborted;
    // root move ordering: previous best first
    moves.sort((a, b) => (b === best) - (a === best));
    for (const m of moves) {
      make(m);
