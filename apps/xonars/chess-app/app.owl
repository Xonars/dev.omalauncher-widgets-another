  if (fl & 4) { const rf = t === 6 ? 7 : t === 2 ? 0 : t === 62 ? 63 : 56, rt = t === 6 ? 5 : t === 2 ? 3 : t === 62 ? 61 : 59; over.set(rt, 0); movers.push({ pc: bd[rt], a: where(rf), b: where(rt) }); }
  const base = composeBoard(L, over);
  for (const mv of movers) { const white = !(mv.pc & 8); mv.cf = base.col(white ? PCOL.wf : PCOL.bf); mv.ce = base.col(white ? PCOL.we : PCOL.be); mv.sp = sprite(mv.pc & 7, S); }
  const dist = Math.hypot((where(t).x - where(f).x) / sq, (where(t).y - where(f).y) / sq), dur = Math.min(420, 120 + 40 * dist);
  U.anim = {}; U.busy = true; const t0 = Date.now(); let prev = null;
  const ease = x => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
  const frame = (p) => {
    const boxes = movers.map(mv => ({ x: Math.round(mv.a.x + (mv.b.x - mv.a.x) * p), y: Math.round(mv.a.y + (mv.b.y - mv.a.y) * p) }));
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
    for (const b of boxes.concat(prev || [])) { x0 = Math.min(x0, b.x); y0 = Math.min(y0, b.y); x1 = Math.max(x1, b.x + S); y1 = Math.max(y1, b.y + S); }
    x0 = Math.max(0, Math.floor(x0 / M.cw) * M.cw); y0 = Math.max(0, Math.floor(y0 / M.ch) * M.ch);
    x1 = Math.min(L.wpx, Math.ceil(x1 / M.cw) * M.cw); y1 = Math.min(L.wpx, Math.ceil(y1 / M.ch) * M.ch);
    const w = x1 - x0, h = y1 - y0, reg = Object.create(Frame.prototype); reg.w = w; reg.h = h; reg.pal = base.pal; reg.map = base.map; reg.px = new Uint8Array(w * h);
    for (let y = 0; y < h; y++) reg.px.set(base.px.subarray((y0 + y) * base.w + x0, (y0 + y) * base.w + x0 + w), y * w);
    movers.forEach((mv, i) => reg.blit(mv.sp, boxes[i].x - x0, boxes[i].y - y0, mv.cf, mv.ce, mv.ce));
    process.stdout.write('\x1b[?2026h' + cellPos(L, x0, y0).replace(/;(\d+)H$/, (q, c) => ';' + (+c) + 'H') + sixelEncode(reg, 0, 0, w, h, L.sub) + '\x1b[?2026l');
