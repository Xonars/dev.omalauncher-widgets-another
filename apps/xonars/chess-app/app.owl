}
function gameResult() {
  if (G.result) return G.result;
  const moves = legalMoves();
  if (!moves.length) return inCheck() ? { over: true, win: side ? 0 : 1, text: (side ? 'White' : 'Black') + ' wins by checkmate', short: (side ? 'White' : 'Black') + ' wins · mate' } : { over: true, win: -1, text: 'Draw by stalemate', short: 'Draw · stalemate' };
  if (half >= 100) return { over: true, win: -1, text: 'Draw by the 50-move rule', short: 'Draw · 50 moves' };
  const k = keyNow(); let n = 0; for (const x of G.keys) if (x === k) n++;
  if (n >= 3) return { over: true, win: -1, text: 'Draw by repetition', short: 'Draw · repetition' };
  if (insufficient()) return { over: true, win: -1, text: 'Draw: not enough material', short: 'Draw · material' };
