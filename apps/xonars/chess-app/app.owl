  if (a === 'menu') { U.view = 'menu'; return render(); }
  if (a === 'moves') { U.view = 'moves'; return render(); }
  if (a === 'close') { U.view = U.view === 'moves' ? 'menu' : 'game'; return render(); }
  const okBusy = ['lvm', 'lvp', 'flip', 'glyphs'], okThinking = okBusy.concat(['new', 'side', 'undo', 'resign', 'clock', 'pause', 'mode', 'autoflip']);
  if (U.busy && !okBusy.includes(a)) return;
  if (U.thinking && !okThinking.includes(a)) return;
  if (G.paused && ['undo', 'hint', 'resign', 'draw'].includes(a)) return; // paused: the board and the clocks are locked
