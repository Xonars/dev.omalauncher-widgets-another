    const cap = (fl & 3) !== 0;
    if (pc === 1) s = (cap ? 'abcdefgh'[f & 7] + 'x' : '') + sqName(t) + (mvPromo(m) ? '=' + 'NBRQ'[mvPromo(m) - 2] : '');
