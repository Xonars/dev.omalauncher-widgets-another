      if (others.length) {
        const sameFile = others.some(o => (mvFrom(o) & 7) === (f & 7)), sameRank = others.some(o => (mvFrom(o) >> 3) === (f >> 3));
        if (!sameFile) dis = 'abcdefgh'[f & 7]; else if (!sameRank) dis = String((f >> 3) + 1); else dis = sqName(f);
      }
      s = PIECE_LETTER[pc] + dis + (cap ? 'x' : '') + sqName(t);
    }
  }
  make(m);
  const chk = inCheck(); let any = false;
  if (chk) { const n = gen(1, false); for (let i = 0; i < n; i++) { const q = MOVES[1][i]; make(q); const ok = !attacked(kingSq[side ^ 1], side); unmake(q); if (ok) { any = true; break; } } }
  unmake(m);
