      if (bm && v > alpha && !aborted) v = -search(d - 1, -INF, -alpha, 1, true);
      unmake(m);
      if (aborted) break;
      if (v > bv) { bv = v; bm = m; if (v > alpha) alpha = v; }
    }
    if (aborted) break;
