  const pc = bd[sq];
  if (U.sel >= 0 && U.targets.includes(sq)) {
    const c = findMove(U.sel, sq);
    if (c.length > 1) { U.promo = { from: U.sel, to: sq }; render(); return; }
    if (c.length === 1) { humanMove(c[0]); return; }
  }
  if (pc && (pc >> 3) === side) { U.sel = sq; U.targets = legalMoves().filter(m => mvFrom(m) === sq).map(mvTo); }
  else { U.sel = -1; U.targets = []; }
  render();
}
function doPromo(t) { if (!U.promo) return; const c = findMove(U.promo.from, U.promo.to, t); if (c.length) humanMove(c[0]); }
function confirmed(kind) {
  if (U.res.over) return true; // a game in progress (even an empty one) needs a second tap
  if (U.arm === kind && Date.now() < U.armUntil) return true;
  U.arm = kind; U.armUntil = Date.now() + 4000; if (U.view === 'game') toast('Tap ' + (kind === 'new' ? 'New' : 'Side') + ' again to confirm', 4000); else setTimeout(render, 4050);
  render(); return false;
}
function renderBar() {
  if (!M.img) return render();
