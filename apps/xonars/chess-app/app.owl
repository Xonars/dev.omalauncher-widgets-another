const uciOf = m => sqName(mvFrom(m)) + sqName(mvTo(m)) + (mvPromo(m) ? '  nbrq'[mvPromo(m)] : '');
const keyNow = () => h1 + ':' + h2;

function toSAN(m, legal) {
