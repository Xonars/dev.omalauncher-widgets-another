}
function onData(buf) {
  let s = buf.toString('utf8');
  s = s.replace(/\x1b\[6;(\d+);(\d+)t/g, (q, h, w) => { M.ch = +h; M.cw = +w; return ''; })
    .replace(/\x1b\[([458]);(\d+);(\d+)t/g, (q, k, a, b) => { M['r' + (k === '4' ? 14 : k === '5' ? 15 : 18)] = [+a, +b]; return ''; })
    .replace(/\x1b\[\?([\d;]*)c/g, (q, p) => { M.sixel = p.split(';').includes('4'); M.da = true; return ''; })
    .replace(/\x1b\[\?1016;(\d)\$y/g, (q, v) => { M.pixOk = +v === 1 || +v === 2; return ''; });
  if (M.da && (!U.started || (!M.img && M.sixel && M.cw > 0 && M.ch > 0))) start(); // the DA1 answer comes last, so the others are in
