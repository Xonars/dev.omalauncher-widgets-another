// Levels: depth cap, time cap (ms), root noise (centipawns)
const LEVELS = [
  { name: 'beginner', depth: 1, ms: 300, noise: 220 },
  { name: 'easy', depth: 2, ms: 500, noise: 110 },
  { name: 'casual', depth: 3, ms: 800, noise: 45 },
  { name: 'club', depth: 7, ms: 800, noise: 0 },
  { name: 'strong', depth: 11, ms: 2500, noise: 0 },
  { name: 'master', depth: 18, ms: 6000, noise: 0 }
