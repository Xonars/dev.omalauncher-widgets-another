  const chunk = (t, d) => { const b = Buffer.alloc(12 + d.length); b.writeUInt32BE(d.length, 0); b.write(t, 4); d.copy(b, 8); b.writeUInt32BE(zlib.crc32(b.subarray(4, 8 + d.length)) >>> 0, 8 + d.length); return b; };
  const ih = Buffer.alloc(13); ih.writeUInt32BE(w, 0); ih.writeUInt32BE(h, 4); ih[8] = 8; ih[9] = 2;
  return Buffer.concat([Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]), chunk('IHDR', ih), chunk('IDAT', zlib.deflateSync(raw)), chunk('IEND', Buffer.alloc(0))]);
}

/* ================= terminal UI: big board, bottom bar, menu, animation ================= */
const GL = [' ', '♟', '♞', '♝', '♜', '♛', '♚'];
const AS = [' ', 'p', 'n', 'b', 'r', 'q', 'k'];
let ascii = false;
const { Worker, isMainThread, parentPort } = require('worker_threads');

// ---- colors (follow the Omarchy theme when its foot.ini is readable)
const hex = s => { const v = parseInt(s, 16); return [v >> 16 & 255, v >> 8 & 255, v & 255]; };
const mixc = (a, b, t) => [0, 1, 2].map(i => Math.round(a[i] * (1 - t) + b[i] * t));
const rgb = c => c.join(';');
function themeColors() {
  const d = { background: '1a1b26', foreground: 'c0caf5', regular1: 'f7768e', regular2: '73daca', regular3: 'e0af68', regular4: '7aa2f7', regular6: '7dcfff' };
  try {
    const f = path.join(os.homedir(), '.local', 'state', 'omarchy', 'current', 'theme', 'foot.ini');
    for (const line of fs.readFileSync(f, 'utf8').split('\n')) { const m = line.match(/^\s*(\w+)\s*=\s*#?([0-9a-fA-F]{6})\s*$/); if (m) d[m[1]] = m[2]; }
  } catch (e) { /* defaults */ }
  return d;
}
let C = {};
function setupColors() {
  const t = themeColors(), bg = hex(t.background), fg = hex(t.foreground), acc = hex(t.regular2 || t.regular6);
  C = {
    bg, fg, acc, muted: mixc(fg, bg, 0.5), light: mixc(bg, acc, 0.62), dark: mixc(bg, acc, 0.26),
    yellow: hex(t.regular3), red: hex(t.regular1), blue: hex(t.regular4),
    white: hex('f6f2e2'), black: hex('070b09'), btn: mixc(bg, fg, 0.16), btnHot: hex(t.regular3)
  };
}

// ---- cell buffer
let W = 80, H = 24, CHs, FGs, BGs, BOs;
function initBuf() {
  W = process.stdout.columns || 80; H = process.stdout.rows || 24;
  const n = W * H; CHs = new Array(n).fill(' '); FGs = new Array(n).fill(rgb(C.fg)); BGs = new Array(n).fill(rgb(C.bg)); BOs = new Array(n).fill(false);
}
function put(x, y, str, fg, bg, bold) {
  if (y < 0 || y >= H) return;
  for (const ch of str) {
    if (x >= 0 && x < W) { const i = y * W + x; CHs[i] = ch; if (fg) FGs[i] = rgb(fg); if (bg) BGs[i] = rgb(bg); if (bold !== undefined) BOs[i] = !!bold; }
    x++;
  }
}
function fillRect(x, y, w, h, bg) { for (let j = 0; j < h; j++) put(x, y + j, ' '.repeat(Math.max(0, w)), C.fg, bg, false); }
function flush(skipRows, clear) {
  let out = '\x1b[?2026h' + (clear ? '\x1b[48;2;' + rgb(C.bg) + 'm\x1b[2J' : '');
  for (let y = skipRows || 0; y < H; y++) {
    out += '\x1b[' + (y + 1) + ';1H'; let cf = '', cb = '', co = null;
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      if (FGs[i] !== cf || BGs[i] !== cb || BOs[i] !== co) { cf = FGs[i]; cb = BGs[i]; co = BOs[i]; out += '\x1b[0' + (co ? ';1' : '') + ';38;2;' + cf + ';48;2;' + cb + 'm'; }
      out += CHs[i];
    }
  }
  process.stdout.write(out + '\x1b[0m' + (flush.after || '') + '\x1b[?2026l'); flush.after = '';
}

// ---- state
const M = { img: false, cw: 0, ch: 0, pix: false };
let IMG = null;
const U = { vs: 0, offer: -1, sel: -1, targets: [], cursor: 12, kb: false, last: null, hint: null, thinking: false, promo: null, msg: '', msgUntil: 0, arm: '', armUntil: 0, typed: '', res: { over: false }, hits: [], view: 'game', anim: null, busy: false, needClear: true, token: 0, clkLast: Date.now() };
// mode 0: you against the computer; mode 1: two people on one phone (the side to move is the human, there is no engine)
const viewBlack = () => (G.mode ? (G.autoFlip && U.vs === 1) !== G.flip : G.playerWhite === G.flip);
const humanSide = () => (G.mode ? side : (G.playerWhite ? 0 : 1));
const engineSide = () => (G.mode ? -1 : (G.playerWhite ? 1 : 0));
function toast(t, ms) { U.msg = t; U.msgUntil = Date.now() + (ms || 3000); setTimeout(render, (ms || 3000) + 30); }

// Layout: the biggest squares that fit, with a two-row bar (status + buttons) under the board.
function layout() {
  let best = null;
  for (let sw = 2; sw <= 20; sw++) for (let sh = 1; sh <= 10; sh++) {
    const lab = 0, bw = 8 * sw, fileRow = 0, bh = 8 * sh; // the coordinates sit in the corners of the squares, not around the board
    if (bw > W || bh + 2 > H) continue;
    const d = sw - 2 * sh, vis = sw * sh * 100 - (d > 0 ? d * d * 25 : d * d * 150);
    if (!best || vis > best.vis) best = { sw, sh, bw, bh, lab, fileRow, vis };
  }
  if (!best) best = { sw: 2, sh: 1, bw: 16, bh: 8, lab: 0, fileRow: 0, vis: 0 };
  best.bx = Math.max(0, (W - best.bw) >> 1); best.by = 0;
  best.barY = Math.min(H - 2, best.bh); best.extra = H - (best.bh + 2);
  return best;
}
function sqAtDisplay(r, c) { const vb = viewBlack(); const file = vb ? 7 - c : c, rank = vb ? r : 7 - r; return rank * 8 + file; }
function displayOf(sq) { const vb = viewBlack(); const file = sq & 7, rank = sq >> 3; return { r: vb ? rank : 7 - rank, c: vb ? 7 - file : file }; }
const glyph = (pc) => (ascii ? ((pc & 8) ? AS[pc & 7] : AS[pc & 7].toUpperCase()) : GL[pc & 7]);

function statusLine() {
  if (Date.now() < U.msgUntil) return { t: U.msg, c: C.yellow };
  if (U.res.over) {
    const t = U.res.short || U.res.text;
    return { t, c: U.res.win === -1 ? C.yellow : (G.mode || U.res.win === humanSide() ? C.acc : C.red) };
  }
  if (G.paused) return { t: 'Paused', c: C.yellow };
  if (U.thinking) return { t: 'Thinking…', c: C.blue };
  if (U.promo) return { t: 'Promote to…', c: C.yellow };
  if (G.mode) { const w = side ? 'Black' : 'White'; return { t: inCheck() ? w + ' in check!' : w + ' to move', c: inCheck() ? C.red : C.acc }; }
  if (side === humanSide()) return { t: inCheck() ? 'Check! Your move' : 'Your move', c: inCheck() ? C.red : C.acc };
  return { t: 'Opponent…', c: C.muted };
}

// ---- drawing
function squareBg(sq) {
  const isLight = ((sq & 7) + (sq >> 3)) % 2 === 1; let bgc = isLight ? C.light : C.dark;
  if (U.last && (sq === U.last.from || sq === U.last.to)) bgc = mixc(bgc, C.yellow, 0.4);
  if (U.hint && (sq === U.hint.from || sq === U.hint.to)) bgc = mixc(bgc, C.blue, 0.65);
  return bgc;
}
function drawBoard(L) {
  const { sw, sh, bx, by, lab } = L, x0 = bx + lab, gi = sw >> 1;
  const kInCheck = inCheck() ? kingSq[side] : -1;
  for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) {
    const sq = sqAtDisplay(r, c); let pc = bd[sq];
    if (U.anim && U.anim.over.has(sq)) pc = U.anim.over.get(sq);
    let bgc = squareBg(sq);
    const isTarget = U.targets.includes(sq);
    if (isTarget && pc) bgc = mixc(bgc, C.red, 0.55);
    if (sq === kInCheck) bgc = mixc(bgc, C.red, 0.8);
    if (sq === U.sel) bgc = mixc(bgc, C.yellow, 0.75);
    const px = x0 + c * sw, py = by + r * sh;
    fillRect(px, py, sw, sh, bgc);
    const gx = px + gi, gy = py + (sh >> 1);
    if (pc) put(gx, gy, glyph(pc), (pc & 8) ? C.black : C.white, bgc, true);
    else if (isTarget) put(gx, gy, '•', mixc(C.fg, bgc, 0.2), bgc, true);
    if (U.kb && sq === U.cursor) put(px, py, '▏', C.fg, bgc, true);
    // coordinates in the corners of the edge squares: the rank top left, the file bottom right
    if (sw >= 2 && c === 0) put(px, py, String((sq >> 3) + 1), C.muted, bgc, false);
    if (sw >= 2 && r === 7 && px + sw - 1 !== gx) put(px + sw - 1, py + sh - 1, 'abcdefgh'[sq & 7], C.muted, bgc, false);
    U.hits.push({ x: px, y: py, w: sw, h: sh, sq });
  }
  if (lab) for (let r = 0; r < 8; r++) put(bx, by + r * sh + (sh >> 1), String((sqAtDisplay(r, 0) >> 3) + 1), C.muted, C.bg, false);
  if (L.fileRow) for (let c = 0; c < 8; c++) put(x0 + c * sw + gi, by + 8 * sh, 'abcdefgh'[sqAtDisplay(0, c) & 7], C.muted, C.bg, false);
  if (U.anim) for (const mv of U.anim.movers) put(Math.round(mv.x), Math.round(mv.y), glyph(mv.pc), (mv.pc & 8) ? C.black : C.white, undefined, true);
}
function button(x, y, w, label, act, hot, dim) {
  const t = label.length >= w ? label.slice(0, w) : ' '.repeat((w - label.length) >> 1) + label + ' '.repeat(w - label.length - ((w - label.length) >> 1));
  put(x, y, t, hot ? C.bg : (dim ? C.muted : C.fg), hot ? C.btnHot : C.btn, true);
  if (act !== null) U.hits.push({ x, y, w, h: 1, act });
}
function row(y, defs, gap) {
  const n = defs.length; let w = Math.floor((W - gap * (n - 1)) / n); if (M.img) w = Math.max(6, Math.floor(w * 0.6)); let x = Math.max(0, (W - (w * n + gap * (n - 1))) >> 1);
  for (const d of defs) { button(x, y, w, d[0], d[1], d[2], d[3]); x += w + gap; }
}
const fmtClock = ms => { const t = Math.max(0, Math.ceil(ms / 1000)); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); };
function drawClocks(x, y) {
  if (!CLOCKS[G.clock].base) return 0;
  const parts = G.mode ? [[0, 'W '], [1, 'B ']] : [[humanSide(), 'You '], [engineSide(), 'Opp ']]; let w = 0; for (const p of parts) w += p[1].length + fmtClock(G.left[p[0]]).length + 1; w -= 1;
  let cx = x < 0 ? W - w - 1 : x;
  for (const [sd, lab] of parts) {
    const t = fmtClock(G.left[sd]), run = !U.res.over && !G.paused && G.hist.length && side === sd, low = G.left[sd] < 30000;
    put(cx, y, lab, C.muted, C.bg, false); cx += lab.length; put(cx, y, t, low ? C.red : (run ? C.fg : C.muted), C.bg, !!run); cx += t.length + 1;
  }
  return w;
}
function drawBar(L) {
  const st = statusLine();
  put(0, L.barY, ' ' + st.t.slice(0, W - 1), st.c, C.bg, true);
  let clockDone = false;
  if (CLOCKS[G.clock].base && st.t.length + 2 + drawClocks(-1, -1) <= W) { drawClocks(-1, L.barY); clockDone = true; } // drawClocks(-1, -1) only measures
  const y = L.barY + 1;
  if (U.promo) { row(y, [[glyph(5 | (side << 3)) + ' Q', { promo: 5 }, true], [glyph(4 | (side << 3)) + ' R', { promo: 4 }, true], [glyph(3 | (side << 3)) + ' B', { promo: 3 }, true], [glyph(2 | (side << 3)) + ' N', { promo: 2 }, true]], 1); return; }
  const mine = side === humanSide() && !U.res.over && !U.thinking && !G.mode && !G.paused, pz = [G.paused ? 'Resume' : 'Pause', 'pause', G.paused, U.res.over && !G.paused];
  if (W >= 30) row(y, [['New', 'new', U.arm === 'new'], ['Undo', 'undo', false, !G.hist.length || G.paused], ['Hint', 'hint', false, !mine], pz, ['Menu', 'menu']], 1);
  else row(y, [['Undo', 'undo', false, !G.hist.length || G.paused], ['Hint', 'hint', false, !mine], pz, ['Menu', 'menu']], 1);
  // spare rows: last moves and captured material
  if (L.extra >= 1) {
    const caps = [[], []]; for (const h of G.hist) caps[h.by].push(h.cap & 7);
    const val = [0, 1, 3, 3, 5, 9, 0]; const mat = [0, 0]; for (const s of [0, 1]) for (const t of caps[s]) mat[s] += val[t];
    const diff = G.mode ? mat[0] - mat[1] : mat[humanSide()] - mat[engineSide()];
    const last = G.hist.slice(-4).map((h, i, a) => { const n = G.hist.length - a.length + i; return (n % 2 === 0 ? (n / 2 + 1) + '.' : '') + h.san; }).join(' ');
    put(1, y + 1, (last + (diff ? '  ' + (G.mode ? (diff > 0 ? 'W+' + diff : 'B+' + -diff) : (diff > 0 ? '+' : '') + diff) : '')).slice(0, W - 1), C.muted, C.bg, false);
    if (CLOCKS[G.clock].base && !clockDone) drawClocks(-1, y + 1);
  }
}
function drawMenu() {
  fillRect(0, 0, W, H, C.bg); const lv = LEVELS[G.level - 1];
  const offered = U.offer === G.hist.length;
  // buttons in the order they are paired: two columns on a normal screen, one on a narrow one
  const defs = [[U.arm === 'new' ? 'Tap again!' : 'New game', 'new', U.arm === 'new'], [G.paused ? 'Resume game' : 'Pause game', 'pause', G.paused], ['Mode: ' + (G.nextMode ? '2 players' : 'Computer'), 'mode']];
  if (G.mode) defs.push(['Flip board', 'flip'], ['Auto-flip: ' + (G.autoFlip ? 'On' : 'Off'), 'autoflip']); else defs.push([G.playerWhite ? 'Play Black' : 'Play White', 'side', U.arm === 'side'], ['Flip board', 'flip']);
  defs.push(['Clock: ' + CLOCKS[G.nextClock].name, 'clock'], [offered ? 'Accept draw' : 'Offer draw', 'draw', offered], [U.arm === 'resign' ? 'Tap again!' : 'Resign', 'resign', U.arm === 'resign'], ['Moves', 'moves'], ['Close', 'close']);
  const two = W >= 34, gx = 2, colW = two ? Math.floor((W - 4 - gx) / 2) : (M.img ? Math.min(W, Math.max(18, Math.floor(W * 0.6))) : Math.min(W, 22));
  const totalW = two ? colW * 2 + gx : colW, x0 = (W - totalW) >> 1, per = two ? 2 : 1;
  const seq = [{ k: 'title' }, { k: 'label' }]; if (!G.mode) seq.push({ k: 'pm' });
  for (let i = 0; i < defs.length; i += per) seq.push({ k: 'btns', d: defs.slice(i, i + per) });
  const height = step => seq.length * step - (step - 1) + 0, gapAfterTitle = 1;
  const step = height(2) + 2 + (gapAfterTitle - 2) <= H ? 2 : 1; // keep the last two rows free for the notes below
  const blockH = (seq.length - 1) * step + 1 - (step - gapAfterTitle);
  let y = Math.max(0, (H - 2 - blockH) >> 1);
  seq.forEach((r, i) => {
    if (r.k === 'title') put(x0 + ((totalW - 4) >> 1), y, 'MENU', C.acc, C.bg, true);
    else if (r.k === 'label') { const t = G.mode ? 'Two players' : 'Level ' + G.level + '/' + LEVELS.length + ' ' + lv.name; put(x0 + ((totalW - t.length) >> 1), y, t, C.fg, C.bg, true); }
    else if (r.k === 'pm') { const h = Math.floor((totalW - 1) / 2); button(x0, y, h, '−', 'lvm', false); button(x0 + totalW - h, y, h, '+', 'lvp', false); }
    else r.d.forEach((d, j) => { const w = r.d.length < per ? totalW : colW; button(x0 + j * (colW + gx), y, w, d[0], d[1], !!d[2]); });
    y += i === 0 ? gapAfterTitle : step;
  });
  const dev = 'Developer: Vitalii Khomenko', pend = 'Applies from the next game';
  put(Math.max(0, (W - dev.length) >> 1), H - 1, dev.slice(0, W), C.muted, C.bg, false);
  if ((G.nextMode !== G.mode || G.nextClock !== G.clock) && y < H - 2) put(Math.max(0, (W - pend.length) >> 1), H - 2, pend.slice(0, W), C.yellow, C.bg, false);
}
function drawMoves() {
  fillRect(0, 0, W, H, C.bg); put((W - 5) >> 1, 0, 'MOVES', C.acc, C.bg, true);
  const lines = []; for (let i = 0; i < G.hist.length; i += 2) lines.push(((i >> 1) + 1) + '. ' + G.hist[i].san + (G.hist[i + 1] ? '  ' + G.hist[i + 1].san : ''));
  const per = H - 4, cols = W >= 40 ? 2 : 1, shown = lines.slice(-per * cols), cw = Math.min(20, Math.floor(W / cols)), x0 = (W - cw * cols) >> 1;
  if (!shown.length) put((W - 12) >> 1, 2, 'No moves yet', C.muted, C.bg, false);
  shown.forEach((t, i) => put(x0 + (i < per ? 0 : cw), 2 + (i % per), t.slice(0, cw - 1), C.fg, C.bg, false));
  button((W - 8) >> 1, H - 1, 8, 'Back', 'close', false);
}
function render() {
  if (!U.started) return; // the first picture waits for the terminal's answers (see start)
  if (!U.anim) U.vs = side;
  if (M.img) { if (!U.anim) renderImg(); return; }
  initBuf(); U.hits = [];
  if (U.view === 'menu') drawMenu(); else if (U.view === 'moves') drawMoves();
  else { const L = layout(); drawBoard(L); if (G.paused) dimBoard(L); drawBar(L); }
  flush();
}

// ---- animation: the piece slides cell by cell, the destination keeps the captured piece until it lands
function charPos(sq, L) { const d = displayOf(sq); return { x: L.bx + L.lab + d.c * L.sw + (L.sw >> 1), y: L.by + d.r * L.sh + (L.sh >> 1) }; }
function animate(m, done) { if (M.img) return animateImg(m, done); return animateCells(m, done); }
function animateCells(m, done) {
  const L = layout(), f = mvFrom(m), t = mvTo(m), pc = bd[t], over = new Map(), movers = [];
  const cap = G.hist.length ? G.hist[G.hist.length - 1].cap : 0, fl = m >> 15;
  const orig = mvPromo(m) ? (PW | (pc & 8)) : pc;
  over.set(t, fl & 2 ? 0 : cap); if (fl & 2) over.set(side === 1 ? t - 8 : t + 8, cap);
  const a = charPos(f, L), b = charPos(t, L); movers.push({ pc: orig, a, b, x: a.x, y: a.y });
  if (fl & 4) {
    const rf = t === 6 ? 7 : t === 2 ? 0 : t === 62 ? 63 : 56, rt = t === 6 ? 5 : t === 2 ? 3 : t === 62 ? 61 : 59;
    over.set(rt, 0); const ra = charPos(rf, L), rb = charPos(rt, L); movers.push({ pc: bd[rt], a: ra, b: rb, x: ra.x, y: ra.y });
  }
  const steps = Math.max(Math.abs(b.x - a.x), Math.abs(b.y - a.y), 2), frames = Math.max(6, Math.min(20, steps * 2 + 3));
  U.anim = { over, movers }; U.busy = true; let i = 0;
  const ease = x => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
  const tick = () => {
    i++; const p = ease(Math.min(1, i / frames));
    for (const mv of U.anim.movers) { mv.x = mv.a.x + (mv.b.x - mv.a.x) * p; mv.y = mv.a.y + (mv.b.y - mv.a.y) * p; }
    if (i >= frames) { U.anim = null; U.busy = false; render(); done && done(); return; }
    render(); setTimeout(tick, 70);
  };
  render(); setTimeout(tick, 260); // a short beat on the start square first
}


/* ---- image mode: board as a sixel picture, text stays in the terminal font ---- */
const PCOL = { wf: [246, 242, 226], we: [8, 12, 10], bf: [28, 36, 32], be: [226, 220, 196] };
function imgLayout() {
  const availW = W * M.cw, availH = (H - 2) * M.ch;
  const sq = Math.max(24, Math.floor(Math.min(availW, availH) / 8));
  const off = Math.max(0, Math.floor((availW - 8 * sq) / 2)), bxc = Math.floor(off / M.cw), sub = off - bxc * M.cw; // centred to the pixel: whole cells plus a shift inside the cell
  const rows = Math.min(H - 2, Math.ceil(8 * sq / M.ch));
  return { sq, bxc, sub, rows, wpx: 8 * sq, barY: rows, extra: H - rows - 2 };
}
function sqTint(sq, fr, ov) {
  let base = ((sq & 7) + (sq >> 3)) % 2 === 1 ? C.light : C.dark; const pc = ov && ov.has(sq) ? ov.get(sq) : bd[sq];
  if (U.last && (sq === U.last.from || sq === U.last.to)) base = mixc(base, C.yellow, 0.4);
  if (U.hint && (sq === U.hint.from || sq === U.hint.to)) base = mixc(base, C.blue, 0.65);
  if (U.targets.includes(sq) && pc) base = mixc(base, C.red, 0.55);
  if (inCheck() && sq === kingSq[side]) base = mixc(base, C.red, 0.8);
  if (sq === U.sel) base = mixc(base, C.yellow, 0.75);
  return base;
}
function composeBoard(L, ov) {
  const sq = L.sq, fr = new Frame(8 * sq, 8 * sq), S = Math.floor(sq * 0.88), off = Math.floor((sq - S) / 2), dy = Math.round(S * 0.04), k = Math.max(1, Math.round(sq / 45));
  const wf = fr.col(PCOL.wf), we = fr.col(PCOL.we), bf = fr.col(PCOL.bf), be = fr.col(PCOL.be);
  for (let r = 0; r < 8; r++) for (let c = 0; c < 8; c++) {
    const s = sqAtDisplay(r, c), x = c * sq, y = r * sq, pc = ov && ov.has(s) ? ov.get(s) : bd[s], bg = sqTint(s, fr, ov), bi = fr.col(bg);
    fr.rect(x, y, sq, sq, bi);
    if (c === 0) fr.text(String((s >> 3) + 1), x + k * 2, y + k * 2, k, fr.col(mixc(C.fg, bg, 0.55)));
    if (r === 7) fr.text('abcdefgh'[s & 7], x + sq - k * 5, y + sq - k * 7, k, fr.col(mixc(C.fg, bg, 0.55)));
