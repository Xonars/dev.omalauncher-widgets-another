      if (!(U.arm === 'resign' && Date.now() < U.armUntil)) { U.arm = 'resign'; U.armUntil = Date.now() + 4000; setTimeout(render, 4050); return render(); }
      cancelThink(); G.result = G.mode ? { over: true, win: side ^ 1, text: (side ? 'Black' : 'White') + ' resigned', short: (side ? 'Black' : 'White') + ' resigned' } : { over: true, win: engineSide(), text: 'You resigned', short: 'You resigned' }; U.res = G.result; U.arm = ''; U.view = 'game'; save(); break;
    }
    case 'draw': {
      if (G.mode) { // two people: one offers, the other accepts with its own tap (the offer lapses with the next move)
        if (U.res.over || G.hist.length < 2) { toast(U.res.over ? 'Not now' : 'Too early for a draw', 2000); U.view = 'game'; return render(); }
        U.view = 'game';
        if (U.offer !== G.hist.length) { U.offer = G.hist.length; toast('Draw offered: accept it in the Menu', 6000); return render(); }
        G.result = { over: true, win: -1, text: 'Draw agreed', short: 'Draw agreed' }; U.res = G.result; U.offer = -1; save(); toast('Draw agreed', 3000); return render();
      }
      if (U.res.over || side !== humanSide() || U.thinking) { toast('Not now', 1800); U.view = 'game'; return render(); }
      if (G.hist.length < 8) { toast('Too early for a draw', 2500); U.view = 'game'; return render(); }
      U.view = 'game'; U.thinking = true; const tok = ++U.token; toast('Opponent is thinking…', 4000); render();
      thinkAsync(5, 700, r => {
        if (tok !== U.token) return; U.thinking = false;
        if (-r.score <= 75) { G.result = { over: true, win: -1, text: 'Draw agreed', short: 'Draw agreed' }; U.res = G.result; save(); toast('Draw agreed', 3000); }
        else toast('Draw declined', 3000);
