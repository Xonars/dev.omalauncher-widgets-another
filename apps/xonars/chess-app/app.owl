// ---- actions
let worker = null; const pendingJobs = new Map(); let jobSeq = 0;
function onWorkerMsg(r) { const cb = pendingJobs.get(r.id); if (cb) { pendingJobs.delete(r.id); cb(r); } }
function thinkAsync(level, ms, cb) {
  const id = ++jobSeq; pendingJobs.set(id, cb);
  try {
    if (!worker) { worker = new Worker(__filename); worker.on('message', onWorkerMsg); worker.on('error', () => { worker = null; }); }
    worker.postMessage({ id, fen: G.startFen, moves: G.hist.map(h => uciOf(h.m)), level, ms });
  } catch (e) { pendingJobs.delete(id); const m = think(level, ms); setImmediate(() => cb({ move: m ? uciOf(m) : '', score: lastScore })); }
}
function cancelThink() { U.token++; U.thinking = false; pendingJobs.clear(); if (worker) { worker.terminate(); worker = null; } }
const moveFromUci = u => { const c = findMove(u.charCodeAt(0) - 97 + (+u[1] - 1) * 8, u.charCodeAt(2) - 97 + (+u[3] - 1) * 8, u[4] ? '  nbrq'.indexOf(u[4]) : undefined); return c.length ? c[0] : 0; };
function workerLoop() {
  parentPort.on('message', q => {
    setFen(q.fen || START_FEN);
    for (const u of q.moves) { const m = moveFromUci(u); if (!m) break; make(m); }
    const m = think(q.level, q.ms);
