  if (aborted) return 0;
  const chk = inCheck();
  if (chk) depth++;
  if (ply > 0 && (half >= 100 || repeated())) return 0;
  if (depth <= 0) return qsearch(alpha, beta, ply);
  if (ply > 100) return evaluate();
  const idx = h1 & TT_MASK, pv = beta - alpha > 1; let ttMove = 0;
  if (ttK1[idx] === h1 && ttK2[idx] === h2) {
    ttMove = ttM[idx];
    if (ttD[idx] >= depth && !pv) {
      let s = ttS[idx]; if (s > MATE - 200) s -= ply; else if (s < -MATE + 200) s += ply;
      const f = ttF[idx];
      if (f === 0 || (f === 1 && s >= beta) || (f === 2 && s <= alpha)) return s;
