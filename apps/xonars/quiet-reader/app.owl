app "Тихая читалка" {
  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/b2d5ea1e009376ab93a974e3cf6553cce3a5b35e53a0054fc2b879287699310a.zip', 'b2d5ea1e009376ab93a974e3cf6553cce3a5b35e53a0054fc2b879287699310a', 'xonars-quiet-reader')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

  meta { owl: 13; description: "EPUB, MOBI и TXT: только книга, плавная прокрутка и три темы · ресурсы при первом запуске"; version: "1.3.2"; license: "MIT AND GPL-3.0-only"; category: "productivity" }
  title: ""
  statusBar: false
  edge: true
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5h25a5 5 0 0 1 5 5v33H14a5 5 0 0 1-5-5V5zM9 34h30M17 13h14M17 21h10"/></svg>"""
  requires { pacman: ["python", "bash", "python", "python-beautifulsoup4", "python-pillow", "ttf-dejavu"] }
  state book = "" persist
  state theme = "paper" persist
  state menu = true
  state folder = "~/Books"
  let paper = theme == "night" ? #171b20 : theme == "sepia" ? #efe3cb : #f7f4ec
  let ink = theme == "night" ? #e0dfd8 : #282c30
  let soft = theme == "night" ? #9bbdb4 : #45675d
  let script = "~/.local/share/omalauncher-store/xonars-quiet-reader/widgets/quiet-reader/main.py"
  source listing = cmd(menu ? "python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-quiet-reader/widgets/quiet-reader/main.py list ${sh(folder)}" : "") json
  source content = cmd(book == "" ? "" : "python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-quiet-reader/widgets/quiet-reader/main.py read ${sh(book)}") every 24h json timeout 60s
  back: !menu && book != ""
  onBack: menu = true
  Box {
    fill: true
    background: paper
    clip: true
    // Keep the native list in one stable composition slot.
    Column {
          fill: true
          lazy: true
          gap: 0
          padding: 0
          for block in content.blocks ?? [] key "${book}:${block.id}" {
            Text {
              text: block.text
              font: "/usr/share/fonts/TTF/DejaVuSerif.ttf"
              fontSize: 20
              color: ink
              onLongPress: menu = true
            }
          }
    }
    if menu || book == "" || len(content.blocks ?? []) == 0 || content.error {
      // Opaque menu overlay keeps the reading list alive underneath.
      Column {
        fill: true
        background: paper
        padding: [24, 16 + (screenTop ?? 0), 24, 16 + (screenInset ?? 0)]
        gap: 16
        Text { text: "Тихая читалка"; font: serif; fontSize: 28; color: ink }
        Row {
          gap: 8
          for t in [{id: "paper", name: "День"}, {id: "sepia", name: "Сепия"}, {id: "night", name: "Ночь"}] {
            Text { text: t.name; color: theme == t.id ? paper : ink; background: theme == t.id ? soft : alpha(soft, 0.1); padding: [16, 12]; radius: 8; onTap: theme = t.id }
          }
        }
        if book != "" {
          Text { text: content.title ?? "Загрузка…"; font: serif; fontSize: 20; color: ink; maxLines: 2 }
          if len(content.blocks ?? []) > 0 && !content.error { Button { text: "Читать"; color: soft; onTap: menu = false } }
        }
        if content.error { Text { text: content.error; color: #b34b45; fontSize: 13 } }
        Text { text: "ВЫБРАТЬ КНИГУ · EPUB / MOBI / TXT"; color: soft; fontSize: 11; letterSpacing: 1 }
        Text { text: listing.path ?? folder; color: soft; fontSize: 12; maxLines: 2 }
        if listing.error { Text { text: listing.error; color: #b34b45; fontSize: 13 } }
        Row {
          Button { text: "Домой"; color: soft; onTap: folder = "~" }
          Button { text: "Вверх"; color: soft; onTap: folder = listing.parent ?? "~" }
        }
        Column {
          lazy: true
          weight: 1
          gap: 0
          if listing.entries != null && len(listing.entries) == 0 {
            Text { text: "Здесь пока нет книг. Нажмите «Вверх» или «Домой», чтобы выбрать другую папку."; color: soft; fontSize: 15; padding: [0, 16] }
          }
          for entry in listing.entries ?? [] key entry.path {
            Text {
              text: "${entry.directory ? "▸  " : ""}${entry.name}"
              color: entry.directory ? soft : ink
              fontSize: 16
              padding: [0, 14]
              onTap: {
                if entry.directory { folder = entry.path } else { book = entry.path; menu = false }
              }
            }
          }
        }
        Text { text: "Долгое нажатие на текст или «Назад» открывает меню."; fontSize: 12; color: soft }
      }
    }
  }
}
