app "Pinterest wallswap" {
  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/e2c670757208b64e36c09bbbbd231984dc7b9b0eed11e2f56942b78171c8d272.zip', 'e2c670757208b64e36c09bbbbd231984dc7b9b0eed11e2f56942b78171c8d272', 'xonars-pinterest-wallswap')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

  title: fullscreen ? "" : settings ? "Настройки" : savePin != null ? "Сохранить пин" : feedView ? "" : downloadsView ? "Загрузки" : fullscreen ? "" : selectedBoard != null ? selectedBoard.name : "Pinterest · Доски"
  statusBar: !fullscreen
  back: fullscreen || settings || downloadsView || feedView || savePin != null || selectedBoard != null
  onBack: { if settings { settings = false } else if savePin != null { if !pinSaveBusy { savePin = null } } else if feedPin != null { feedPin = null } else if feedView { feedView = false } else if downloadsView { downloadsView = false } else if fullscreen { fullscreen = false } else { selectedBoard = null } }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect x=".5" y=".5" width="47" height="47" rx="9" fill="#19191d"/><rect x=".5" y=".5" width="47" height="47" rx="9" fill="currentColor" fill-opacity=".30" stroke="currentColor" stroke-opacity=".78"/><defs><g id="symbol"><rect x="5" y="5" width="38" height="38" rx="4"/><circle cx="16" cy="16" r="3"/><path d="M5 35l12-12 9 9 8-12 9 12"/></g></defs><g transform="translate(4.38 4.38) scale(0.817)" fill="none" stroke="#faf8f3" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.06"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g><g transform="translate(4.38 4.38) scale(0.817)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="3.06" opacity=".16"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g></svg>"""
  meta { owl: 13; description: "Просмотр изображений из публичных досок Pinterest · ресурсы при первом запуске"; version: "1.3.1"; license: "MIT"; category: "media" }
  // Install gallery-dl==1.32.18 in the app's venv with pinterest-wallswap/install-deps.sh.
  requires { pacman: ["python", "curl", "bash", "coreutils", "python-requests", "chromium", "nodejs", "python-pip"] }
  // screenWidth follows the current app window, including desktop resizing.
  let viewWidth = max(240, screenWidth ?? 400)
  let desktop = viewWidth >= 840
  let pagePadding = desktop ? 20 : 6
  let laneGap = desktop ? 12 : 8
  let feedColumns = viewWidth < 360 ? 1 : desktop ? max(3, floor((viewWidth - pagePadding * 2 + laneGap) / (260 + laneGap))) : viewWidth >= 600 ? 3 : 2
  let feedCardWidth = (viewWidth - pagePadding * 2 - laneGap * (feedColumns - 1)) / feedColumns
  let boardColumns = viewWidth < 360 ? 1 : max(2, floor((viewWidth - 24 + 12) / 232))
  state feedView = false
  state feedPin = null
  state savePin = null
  state feedBusy = false
  state feedOut = ""
  state pinSaveBusy = false
  state pinSaveOut = ""
  state accountOut = ""
  state pinBoardSearch = ""
  state pinBoardPage = 0
  state feedMessage = ""
  source browserLogin = file("~/.local/state/pinterest-wallswap/browser-login.json") json
  source accountInfo = file("~/.local/state/pinterest-wallswap/account.json") json
  source feedState = file("~/.local/state/pinterest-wallswap/feed.json") json
  source ownBoardsState = file("~/.local/state/pinterest-wallswap/my-boards.json") json
  source pinSaves = file("~/.local/state/pinterest-wallswap/saved-pins.json") json
  let ownBoards = (ownBoardsState.boards ?? []).filter(b => contains(lower(b.name), lower(pinBoardSearch)))
  let staleTint = #ed8b23
  on feedOut { feedBusy = false }
  on pinSaveOut {
    pinSaveBusy = false
    let result = parseJson(value)
    if result.ok == true {
      savePin = null
      feedMessage = "Сохранено на доску «${result.board}»"
      boardsRefresh = boardsRefresh + 1
    }
  }
  on accountInfo first {
    if value.connected == true && (old == null || old.connected != true || old.username != value.username) {
      accountOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py boards")
      if feedView {
        feedBusy = true
        feedOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py refresh")
      }
    }
  }
  state profiles = "xonars" persist
  state profileDraft = "xonars"
  state settings = false
  state saveDirectory = "~/Pictures" persist
  state saveDraft = "~/Pictures"
  state pendingDirectory = ""
  state pendingProfiles = ""
  state settingsResult = ""
  state settingsBusy = false
  state downloadsView = false
  state downloadsPage = 0
  state downloadOut = ""
  on settingsResult {
    settingsBusy = false
    let checked = parseJson(value)
    if checked.ok == true {
      saveDirectory = pendingDirectory
      profiles = pendingProfiles
      selectedBoard = null
      boardSearch = ""
      boardPage = 0
      settings = false
    }
  }
  state selectedBoard = null
  let boards = selectedBoard == null ? [] : [selectedBoard.id]
  state boardPage = 0
  state boardSearch = ""
  state boardsRefresh = 0
  state fullscreen = false
  state out = ""
  let effectiveProfiles = accountInfo.connected == true ? "${profiles},${accountInfo.username}" : profiles
  let profileCfg = toJson({profiles: effectiveProfiles})
  let cfg = toJson({boards: boards, profiles: effectiveProfiles})
  source catalog = cmd("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/pinterest.py boards ${sh(profileCfg)}; : ${int(boardsRefresh)}") every 6h json timeout 120s
  on catalog { boardPage = 0 }
  let accountBoards = accountInfo.connected == true ? ownBoardsState.boards ?? [] : []
  let accountBoardIds = accountBoards.map(b => b.id)
  let availableBoards = flatten([accountBoards, (catalog.boards ?? []).filter(b => accountBoardIds.indexOf(b.id) < 0)])
  let visibleBoards = availableBoards.filter(b => contains(lower("${b.profile} ${b.name}"), lower(boardSearch)))
  state galleryPage = 0
  state galleryIndex = 0
  state swipeX = 0
  source boardGallery = cmd(selectedBoard == null ? "echo '{}'" : "python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/gallery.py ${sh(cfg)}; : ${int(galleryPage)}") json timeout 120s
  let galleryItems = boardGallery.boardId == selectedBoard.id ? boardGallery.items ?? [] : []
  let galleryPin = galleryItems[galleryIndex]
  on selectedBoard { galleryPage = 0; galleryIndex = 0; swipeX = 0 }
  source downloadMaintenance = cmd("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/downloads.py status") every 3s json
  source downloadState = file("~/.local/state/pinterest-wallswap/downloads.json") json
  let downloadJobs = downloadState.jobs ?? {}
  let downloadList = values(downloadJobs).sortBy(j => -j.created)
  let activeDownloads = downloadList.filter(j => j.status == "queued" || j.status == "downloading")
  let selectedDownload = selectedBoard == null ? null : downloadJobs[selectedBoard.id]
  let validProfiles = match(trim(profileDraft), "^[A-Za-z0-9_]{1,64}( *, *[A-Za-z0-9_]{1,64})*$") != null
  // Arrows drawn as lines, so they sit in the middle of their circles whatever the font: a right
  // arrow turned by `turn` degrees.
  component Glyph(turn = 0, base = false, tint = accent, s = 18) {
    Canvas {
      width: s
      height: s
      translate(0, base ? -s * 0.1 : 0) {
        rotate(turn, s / 2, s / 2) {
          line(s * 0.16, s / 2, s * 0.82, s / 2, stroke: tint, width: s * 0.11, cap: round)
          path([[s * 0.54, s * 0.22], [s * 0.82, s / 2], [s * 0.54, s * 0.78]], stroke: tint, width: s * 0.11, cap: round)
        }
      }
      if base {
        line(s * 0.2, s * 0.9, s * 0.8, s * 0.9, stroke: tint, width: s * 0.11, cap: round)
      }
    }
  }

  component Action(label, turn = 0, base = false, active = true) {
    Column {
      gap: 4
      align: center
      opacity: active ? 1 : 0.35
      Box { width: 44; height: 44; radius: 22; align: center; background: alpha(accent, 0.16)
        Glyph { turn: turn; base: base; s: 20 }
      }
      Text { text: label; style: small; color: muted; align: center; maxLines: 1 }
    }
  }

  if settings {
    Column {
      scroll: true
      padding: [12, 8]
      gap: 14
      Text { text: "Аккаунт Pinterest"; style: title }
      Text { text: accountInfo.connected == true ? "Выполнен вход: ${accountInfo.username}" : "Войдите для персональной ленты и сохранения пинов"; color: muted; maxLines: 3 }
      Row {
        wrap: true
        gap: 10
        Button { text: "Войти по email"; onTap: app("pinterest-login") }
        Button { text: "Задать пароль Pinterest"; onTap: app("pinterest-login --reset-password") }
        if accountInfo.connected == true {
          Button { text: "Выйти"; onTap: accountOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py logout") }
        }
      }
      if browserLogin.message != null && browserLogin.phase != "connected" {
        Text { text: browserLogin.message; color: browserLogin.phase == "error" ? red : muted; maxLines: 4 }
      }
      Text { text: "Google отклоняет вход из этого окна. Используйте email и пароль Pinterest. Если пароля Pinterest нет, нажмите «Задать пароль Pinterest». Пароль Google здесь не нужен."; style: small; color: muted; maxLines: 4 }
      if accountInfo.error != null && accountInfo.error != "" {
        Text { text: accountInfo.error; style: small; color: red; maxLines: 3 }
      }
      Text { text: "Отслеживаемые профили"; style: title }
      Text { text: "Имена Pinterest через запятую, без ссылок. Например: xonars, another_profile"; color: muted; maxLines: 3 }
      Input { text: profileDraft; placeholder: "xonars"; onChange: profileDraft = value }
      if !validProfiles {
        Text { text: "Введите имена латиницей через запятую: буквы, цифры и подчёркивания."; color: red; style: small }
      }
      Text { text: "Директория сохранения"; style: title }
      Input { text: saveDraft; placeholder: "~/Pictures"; onChange: saveDraft = value }
      Text { text: "Внутри будут папки Pinterest / профиль / доска. Уже сохранённые доски останутся доступны по прежнему пути."; style: small; color: muted }
      if parseJson(settingsResult).error != null {
        Text { text: parseJson(settingsResult).error; color: red; maxLines: 3 }
      }
      Row {
        gap: 10
        Button { text: settingsBusy ? "Проверяю…" : "Сохранить"; onTap: { if validProfiles && !settingsBusy { pendingDirectory = trim(saveDraft); pendingProfiles = trim(profileDraft); settingsBusy = true; settingsResult = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/downloads.py validate ${sh(toJson({directory: pendingDirectory}))}") } } }
        Button { text: "Отмена"; onTap: settings = false }
      }
      Text { text: "Сейчас: ${profiles}"; style: small; color: muted; maxLines: 3 }
      Text { text: "Фоновая загрузка"; style: title }
      Text { text: "Доска открывается сеткой изображений. Нажмите на пин для просмотра на весь экран и листайте свайпами влево и вправо. Скачанные доски доступны из локальной копии."; color: muted }
    }
  } else if savePin != null {
    Column {
      padding: [12, 8]
      scroll: true
      gap: 12
      Text { text: "На какую доску сохранить?"; style: title }
      Text { text: "Аккаунт: ${accountInfo.username ?? "…"}"; color: muted; style: small }
      if parseJson(pinSaveOut).ok == false {
        Text { text: parseJson(pinSaveOut).error; color: red; maxLines: 4 }
      }
      if ownBoardsState.error != null && ownBoardsState.error != "" {
        Text { text: ownBoardsState.error; color: red; maxLines: 4 }
      }
      Row {
        gap: 10
        Button { text: "Обновить список"; onTap: accountOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py boards") }
        Button { text: "Отмена"; onTap: { if !pinSaveBusy { savePin = null } } }
      }
      Input { text: pinBoardSearch; placeholder: "Найти доску"; onChange: { pinBoardSearch = value; pinBoardPage = 0 } }
      if pinSaveBusy {
        Text { text: "Сохраняю пин…"; color: accent }
      }
      if len(ownBoards) > 25 {
        Row {
          gap: 10
          Button { text: "←"; onTap: pinBoardPage = max(0, pinBoardPage - 1) }
          Text { text: "${pinBoardPage + 1} / ${ceil(len(ownBoards) / 25)}"; weight: 1; align: center }
          Button { text: "→"; onTap: pinBoardPage = min(ceil(len(ownBoards) / 25) - 1, pinBoardPage + 1) }
        }
      }
      for b in ownBoards.drop(pinBoardPage * 25).take(25) key b.id {
        let alreadySaved = pinSaves[savePin.id][b.id] != null
        Row {
          padding: 12
          gap: 10
          align: center
          radius: 12
          background: alpha(alreadySaved ? green : surface, 0.15)
          opacity: pinSaveBusy ? 0.5 : 1
          onTap: { if !pinSaveBusy && !alreadySaved { haptic(); pinSaveBusy = true; pinSaveOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py save ${sh(toJson({pinId: savePin.id, boardId: b.id}))}") } }
          Text { text: b.name; weight: 1; maxLines: 2 }
          Text { text: alreadySaved ? "✓ Уже сохранён" : "Сохранить ›"; style: small; color: alreadySaved ? green : accent }
        }
      }
      if len(ownBoards) == 0 {
        Text { text: "Доски не найдены. Обновите список или проверьте вход в Pinterest."; color: muted; maxLines: 3 }
      }
    }
  } else if feedView {
    Column {
      fill: true
      gap: 0
      Row {
        padding: [12, 8]
        gap: 8
        align: center
        Text { text: "‹"; width: 40; font: sans; fontSize: 30; onTap: { if feedPin != null { feedPin = null } else { feedView = false } } }
        Text { text: "Pinterest"; font: sans; fontSize: 26; fontWeight: 700; weight: 1 }
        if desktop {
          Button { text: "Лента"; onTap: feedPin = null }
          Button { text: "Доски"; onTap: { feedView = false; feedPin = null } }
          Button { text: "Настройки"; onTap: { profileDraft = profiles; saveDraft = saveDirectory; settingsResult = ""; settings = true } }
        }
        Box {
          width: 44; height: 44; radius: 22; background: alpha(surface, 0.6); align: center
          onTap: { if !feedBusy && accountInfo.connected == true { feedPin = null; feedBusy = true; feedOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py refresh") } }
          Text { text: feedBusy ? "…" : "↻"; font: sans; fontSize: 26; align: center }
        }
      }
      Column {
      weight: 1
      scroll: true
      padding: [pagePadding, 4]
      gap: 12
      if accountInfo.connected != true {
        Text { text: "Войдите в Pinterest"; style: title }
        Text { text: "Используйте email и пароль Pinterest. Google отклоняет вход из этого окна. Если пароля Pinterest нет, его можно задать через свою почту."; color: muted }
        Row {
          wrap: true
          gap: 10
            Button { text: "Войти по email"; onTap: app("pinterest-login") }
        Button { text: "Задать пароль Pinterest"; onTap: app("pinterest-login --reset-password") }
        }
        if browserLogin.message != null && browserLogin.phase != "connected" {
          Text { text: browserLogin.message; color: browserLogin.phase == "error" ? red : muted; maxLines: 4 }
        }
        if accountInfo.error != null && accountInfo.error != "" {
          Text { text: accountInfo.error; color: red; maxLines: 4 }
        }
      } else {
        Row {
          padding: [8, 2]
          align: center
          Text { text: feedPin != null ? "Просмотр пина" : "Для вас"; font: sans; fontSize: 18; fontWeight: 700; weight: 1 }
          Text { text: accountInfo.username; font: sans; fontSize: 11; color: muted; maxLines: 1 }
        }
        if feedMessage != "" {
          Text { text: feedMessage; color: green; maxLines: 3 }
        }
        if feedState.error != null && feedState.error != "" {
          Text { text: feedState.error; color: red; maxLines: 4 }
          Button { text: "Войти по email"; onTap: app("pinterest-login") }
        Button { text: "Задать пароль Pinterest"; onTap: app("pinterest-login --reset-password") }
        }
        if feedPin != null {
          Image { src: feedPin.image; fit: contain; fill: width; height: min(520, (screenHeight ?? 800) * 0.65); label: feedPin.title }
          Text { text: feedPin.title; maxLines: 3 }
          Button { text: "Сохранить на доску"; onTap: { savePin = feedPin; pinBoardSearch = ""; pinBoardPage = 0; pinSaveOut = ""; accountOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py boards") } }
          Button { text: "Открыть пин"; onTap: url(feedPin.page) }
        } else {
          Row {
            gap: laneGap
            fill: width
            align: top
            for lane in range(feedColumns) {
              Column {
                weight: 1
                gap: 14
                for p, i in (feedState.items ?? []).take(20) key p.id {
                  if i % feedColumns == lane {
                    let pinWidth = feedCardWidth
                    let pinHeight = p.width > 0 && p.height > 0 ? pinWidth * p.height / p.width : pinWidth * (i % 3 == 0 ? 1.6 : i % 3 == 1 ? 1.25 : 1)
                    Column {
                      gap: 2
                      Box {
                        height: min(pinWidth * 2.4, max(pinWidth * 0.7, pinHeight))
                        fill: width
                        clip: true
                        radius: 18
                        background: alpha(surface, 0.7)
                        onTap: feedPin = p
                        Image { src: p.image; fit: cover; fill: true; label: p.title }
                      }
                      Row {
                        gap: 4
                        padding: [6, 0]
                        align: center
                        Text { text: p.title; font: sans; fontSize: 11; fontWeight: 600; maxLines: 2; weight: 1; onTap: feedPin = p }
                        Box {
                          width: 36; height: 40; align: center; radius: 18
                          onTap: { savePin = p; pinBoardSearch = ""; pinBoardPage = 0; pinSaveOut = ""; accountOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py boards") }
                          Text { text: "•••"; font: sans; fontSize: 15; align: center }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
          if feedState.bookmark != null && feedState.bookmark != "-end-" {
            Button { text: feedBusy ? "Загрузка…" : "Следующие изображения"; onTap: { if !feedBusy { feedBusy = true; feedOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py next") } } }
          }
          if len(feedState.items ?? []) == 0 {
            Text { text: feedBusy ? "Загружаю вашу ленту…" : "Нажмите «Обновить ленту»"; color: muted }
          }
        }
      }
      }
      if !desktop {
      Row {
        padding: [12, 8]
        gap: 8
        Box { weight: 1; height: 44; radius: 22; background: alpha(accent, 0.18); align: center
          Text { text: "Лента"; font: sans; fontSize: 13; fontWeight: 700; align: center }
          onTap: feedPin = null
        }
        Box { weight: 1; height: 44; radius: 22; align: center
          Text { text: "Доски"; font: sans; fontSize: 13; align: center }
          onTap: { feedView = false; feedPin = null }
        }
        Box { weight: 1; height: 44; radius: 22; align: center
          Text { text: "Настройки"; font: sans; fontSize: 13; align: center }
          onTap: { profileDraft = profiles; saveDraft = saveDirectory; settingsResult = ""; settings = true }
        }
      }
      }
    }
  } else if downloadsView {
    Column {
      scroll: true
      padding: [12, 8]
      gap: 14
      Text { text: "Активных: ${len(activeDownloads)} · Всего: ${len(downloadList)}"; style: small; color: muted }
      Text { text: "Папка для новых загрузок: ${saveDirectory}"; style: small; color: muted; maxLines: 2 }
      if downloadState.error != null && downloadState.error != "" {
        Text { text: downloadState.error; color: red; maxLines: 4 }
      }
      if downloadMaintenance.available == false {
        Text { text: "gallery-dl не установлен"; color: red }
      }
      if len(downloadList) == 0 {
        Text { text: "Загрузок пока нет. Откройте доску и нажмите «Загрузить всё»."; color: muted; maxLines: 3 }
      }
      if len(downloadList) > 20 {
        Row {
          gap: 10
          Button { text: "←"; onTap: downloadsPage = max(0, downloadsPage - 1) }
          Text { text: "${downloadsPage + 1} / ${ceil(len(downloadList) / 20)}"; weight: 1; align: center }
          Button { text: "→"; onTap: downloadsPage = min(ceil(len(downloadList) / 20) - 1, downloadsPage + 1) }
        }
      }
      for j in downloadList.drop(downloadsPage * 20).take(20) key j.board.id {
        let running = j.status == "queued" || j.status == "downloading"
        let outdated = j.dirty == true && j.saved > 0
        let done = j.status == "completed" && !outdated
        Column {
          padding: 12
          gap: 8
          radius: 12
          background: alpha(outdated ? staleTint : done ? green : running ? accent : surface, 0.12)
          border: 1
          borderColor: outdated ? staleTint : done ? green : running ? accent : alpha(muted, 0.3)
          Text { text: j.board.name; fontWeight: 600; maxLines: 2 }
          Text { text: outdated && !running ? "Нужно обновить · сохранено ${j.saved}" : done ? "✓ Скачано · ${j.saved} изображений" : j.status == "queued" ? "В очереди · сохранено ${j.saved}" : j.status == "error" ? "Ошибка · сохранено ${j.saved}" : "Загружается · ${j.saved} / ≈ ${j.expected}"; color: outdated ? staleTint : done ? green : j.status == "error" ? red : accent; maxLines: 2 }
          if running {
            Progress { value: j.status == "queued" ? 0 : min(99, j.saved / max(1, j.expected) * 100); height: 5 }
          }
          Text { text: j.directory; style: small; color: muted; maxLines: 3 }
          if j.error != "" {
            Text { text: j.error; style: small; color: red; maxLines: 5 }
          }
          Row {
            gap: 10
            if j.saved > 0 {
              Button { text: "Открыть"; onTap: { selectedBoard = j.board; downloadsView = false; fullscreen = false } }
            }
            if !running {
              Button { text: done || outdated ? "Обновить" : "Повторить"; onTap: downloadOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/downloads.py start ${sh(toJson({board: j.board, saveDirectory: saveDirectory}))}") }
            }
          }
        }
      }
    }
  } else if fullscreen && galleryPin != null {
    Box {
      fill: true
      background: #000000
      Box {
        fill: true
        drag: horizontal
        onDrag: swipeX = swipeX + dx
        onDragEnd: {
          if swipeX < -50 || vx < -500 { galleryIndex = min(len(galleryItems) - 1, galleryIndex + 1) }
          else if swipeX > 50 || vx > 500 { galleryIndex = max(0, galleryIndex - 1) }
          swipeX = 0
        }
        Image { src: galleryPin.image; fit: contain; fill: true; label: galleryPin.title; offset: [swipeX, 0] }
      }
      Column {
        fill: true
        padding: [12, 0, 12, 16]
        Spacer { weight: 1 }
        Column {
          padding: 10; gap: 6; radius: 14; background: #000000bb
          Text { text: galleryPin.title; color: #ffffff; fontSize: 12; maxLines: 2; align: center }
          Text { text: "${galleryIndex + 1} / ${len(galleryItems)} · Листайте свайпом"; color: #ffffff; fontSize: 11; align: center }
          Button { text: "Открыть пин"; onTap: url(galleryPin.page) }
        }
      }
      Box {
        width: 48; height: 48; offset: [12, screenTop + 12]; radius: 24
        background: #00000099; align: center
        onTap: fullscreen = false
        Text { text: "×"; fontSize: 28; color: #ffffff; align: center }
      }
    }
  } else if selectedBoard != null {
    Column {
      padding: [pagePadding, 0]
      scroll: true
      gap: 14
      Row {
        gap: 10; wrap: true
        Button { text: "‹ Доски"; onTap: selectedBoard = null }
        Button { text: "Загрузить всё"; onTap: { downloadOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/downloads.py start ${sh(toJson({board: selectedBoard, saveDirectory: saveDirectory}))}"); downloadsView = true } }
        Button { text: "Загрузки"; onTap: downloadsView = true }
      }
      if boardGallery.boardId != selectedBoard.id {
        Text { text: "Загружаю изображения доски…"; color: muted }
      } else if boardGallery.error != null {
        Text { text: boardGallery.error; color: red; maxLines: 4 }
        Button { text: "Повторить"; onTap: refresh() }
      } else if len(galleryItems) == 0 {
        Text { text: "На доске нет изображений"; color: muted }
      }
      Row {
        gap: laneGap; fill: width; align: top
        for lane in range(feedColumns) {
          Column {
            weight: 1; gap: 14
            for p, i in galleryItems.drop(galleryPage * 20).take(20) {
              if i % feedColumns == lane {
                let pinHeight = p.width > 0 && p.height > 0 ? feedCardWidth * p.height / p.width : feedCardWidth * (i % 3 == 0 ? 1.6 : i % 3 == 1 ? 1.25 : 1)
                Column {
                  gap: 4
                  onTap: { galleryIndex = galleryPage * 20 + i; swipeX = 0; fullscreen = true }
                  Box {
                    height: min(feedCardWidth * 2.4, max(feedCardWidth * 0.7, pinHeight))
                    fill: width; clip: true; radius: 18; background: alpha(surface, 0.7)
                    Image { src: p.image; fit: cover; fill: true; label: p.title }
                  }
                  Text { text: p.title; font: sans; fontSize: 11; fontWeight: 600; maxLines: 2; padding: [6, 0] }
                }
              }
            }
          }
        }
      }
      Row {
        gap: 10
        if galleryPage > 0 { Button { text: "Предыдущие"; onTap: galleryPage = galleryPage - 1 } }
        if (galleryPage + 1) * 20 < len(galleryItems) || boardGallery.more == true {
          Button { text: "Следующие изображения"; onTap: galleryPage = galleryPage + 1 }
        }
      }
    }
  } else {
    Column {
      padding: [12, 0]
      scroll: true
      gap: 14
      Row {
        gap: 10
        wrap: !desktop
        Text { text: profiles; weight: 1; style: small; color: muted; maxLines: 1 }
        Button { text: "Загрузки (${len(activeDownloads)})"; onTap: downloadsView = true }
        Button { text: "Настройки"; onTap: { profileDraft = profiles; saveDraft = saveDirectory; settingsResult = ""; settings = true } }
      }
      Column {
        gap: 8
        Text { text: "ДОСКИ"; fontSize: 10; letterSpacing: 2; color: muted }
        Text { text: "${len(availableBoards)} публичных досок"; style: small; color: muted }
        Row {
          wrap: true
          gap: 10
          Button { text: "Обновить доски"; onTap: { out = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/pinterest.py boards ${sh(profileCfg)} --refresh >/dev/null; date +%s%N"); boardsRefresh = boardsRefresh + 1 } }
          Button { text: "Загрузить все доски"; onTap: { if len(availableBoards) > 0 { downloadOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/downloads.py start-all ${sh(toJson({boards: availableBoards, saveDirectory: saveDirectory}))}"); downloadsView = true } } }
          Button { text: "Лента"; onTap: { feedView = true; feedPin = null; feedMessage = ""; if accountInfo.connected == true && !feedBusy { feedBusy = true; feedOut = run("python -c ${sh(storeBootstrap)} && python ~/.local/share/omalauncher-store/xonars-pinterest-wallswap/widgets/pinterest-wallswap/account.py refresh") } } }
        }
        if catalog.error != null && catalog.error != "" {
          Text { text: catalog.error; style: small; color: red; maxLines: 3 }
        }
        if catalog.complete == false {
          Text { text: "Список может быть неполным. Попробуйте обновить."; style: small; color: muted }
        }
        Input { text: boardSearch; placeholder: "Найти доску"; onChange: { boardSearch = value; boardPage = 0 } }
        if len(visibleBoards) > 40 {
          Row {
            gap: 8
            Button { text: "←"; onTap: boardPage = max(0, boardPage - 1) }
            Text { text: "${boardPage + 1} / ${ceil(len(visibleBoards) / 40)}"; weight: 1; align: center; style: small }
            Button { text: "→"; onTap: boardPage = min(ceil(len(visibleBoards) / 40) - 1, boardPage + 1) }
          }
        }
        Grid {
          columns: boardColumns
          gap: desktop ? 12 : 8
          fill: width
          for b in visibleBoards.drop(boardPage * 40).take(40) key b.id {
            let savedBoard = downloadJobs[b.id]
            let outdatedBoard = savedBoard.dirty == true && savedBoard.saved > 0
            let completedBoard = savedBoard.status == "completed" && !outdatedBoard
            let savingBoard = savedBoard.status == "downloading" || savedBoard.status == "queued"
            Column {
              fill: width
              padding: 10
              gap: 5
              radius: 12
              background: outdatedBoard ? alpha(staleTint, 0.18) : completedBoard ? alpha(green, 0.12) : savingBoard ? alpha(accent, 0.12) : alpha(surface, 0.8)
              border: 1
              borderColor: outdatedBoard ? staleTint : completedBoard ? green : savingBoard ? accent : alpha(muted, 0.2)
              onTap: { haptic(); selectedBoard = b; fullscreen = false }
              Text { text: outdatedBoard ? "Нужно докачать · ${savedBoard.saved}" : completedBoard ? "✓ Скачано · ${savedBoard.saved}" : savingBoard ? "↓ Загрузка · ${savedBoard.saved}" : savedBoard.saved > 0 ? "Частично · ${savedBoard.saved}" : savedBoard.status == "error" ? "Ошибка загрузки" : "Не скачано"; fontSize: desktop ? 12 : 9; color: outdatedBoard ? staleTint : completedBoard ? green : savedBoard.status == "error" ? red : savingBoard ? accent : muted; maxLines: 1 }
              Text { text: b.name; fontSize: desktop ? 16 : 12; fontWeight: 600; maxLines: 2; minLines: 2 }
              Row {
                gap: 6
                Text { text: "${b.profile} · ${b.count}"; weight: 1; fontSize: desktop ? 12 : 10; color: muted; maxLines: 1 }
                Text { text: "›"; color: accent; fontSize: 18 }
              }
            }
          }
        }

      }
      if catalog == null {
        Text { text: "Загружаю доски…"; color: muted }
      } else if len(visibleBoards) == 0 {
        Text { text: boardSearch != "" ? "Доски не найдены" : "Нет доступных досок"; color: muted }
      }
    }
  }
}
