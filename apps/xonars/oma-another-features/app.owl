app "Oma Another Features" {
  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/3a099fddae72426684ae19d06ec0fb9a96093d1211d088430df041331cb01f35.zip', '3a099fddae72426684ae19d06ec0fb9a96093d1211d088430df041331cb01f35', 'xonars-oma-another-features')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

  meta { owl: 11; version: "2.1.1"; description: "Витрина возможностей OMA Another: обзор, новые функции, инструкции · ресурсы при первом запуске"; category: "productivity" ; license: "MIT" }
  requires { pacman: ["python"] }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect x=".5" y=".5" width="47" height="47" rx="9" fill="#19191d"/><rect x=".5" y=".5" width="47" height="47" rx="9" fill="currentColor" fill-opacity=".30" stroke="currentColor" stroke-opacity=".78"/><defs><g id="symbol"><rect x="6" y="6" width="36" height="13" rx="3"/><rect x="6" y="26" width="14" height="16" rx="3"/><rect x="27" y="26" width="15" height="16" rx="3"/></g></defs><g transform="translate(3.39 3.39) scale(0.859)" fill="none" stroke="#faf8f3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.91"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g><g transform="translate(3.39 3.39) scale(0.859)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.91" opacity=".16"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g></svg>"""


  title: selected != "" ? (fullShot ? "Скриншот" : (current.title ?? "Возможность")) : "OMA Another Features"
  back: selected != "" || section != "Обзор"
  onBack: { if fullShot { fullShot = false } else { if selected != "" { selected = ""; expanded = false; shotIndex = 0 } else { section = "Обзор"; query = ""; category = "Все" } } }
  source catalog = cmd("python -c ${sh(storeBootstrap)} && cat ~/.local/share/omalauncher-store/xonars-oma-another-features/widgets/oma-another-features/catalog.json") timeout 60s json
  state selected = ""
  state query = ""
  state category = "Все"
  state saved = [] persist
  state section = "Обзор"
  state expanded = false
  state shotIndex = 0
  state fullShot = false
  state filtersOpen = false
  let items = catalog.features ?? []
  let categories = ["Все", "Рабочая среда", "Оформление", "Управление", "Внешний экран", "Мультимедиа", "Приложения и OWL", "Данные и настройки"]
  let tabs = ["Обзор", "Каталог", "Новое", "Избранное"]
  let wide = (screenWidth ?? 360) >= 580
  let large = (screenWidth ?? 360) >= 1050
  let current = items.find(f => f.id == selected)
  let shots = current.screenshots ?? []
  let shot = shots[shotIndex]
  let found = items.filter(f => (section != "Новое" || f.recent == true) && (section != "Избранное" || contains(saved, f.id)) && (category == "Все" || f.category == category) && contains(lower(f.title + " " + f.shortTitle + " " + f.summary + " " + f.details + " " + f.howTo + " " + f.limitations + " " + f.category), lower(trim(query))))
  let featured = ["tiled-workspaces","android-tiles","workspace-appearance","control-center","palette","waybar"].map(id => items.find(f => f.id == id)).filter(f => f != null)
  component Heading(label) {
    Text { text: label; font: sans; fontSize: 12; bold: true; color: accent; letterSpacing: 0.6 }
  }
  component FeatureIcon(name, side = 26) {
    Canvas { size: side
      scale(width/24, height/24) {
        if name == "oma-input" {
          rect(2,5,20,14,radius:2,stroke:accent,width:1.5)
          for r in range(2) { for c in range(4) { rect(5+c*4,8+r*3,2,1.5,fill:accent) } }
          line(8,16,16,16,stroke:accent,width:1.5,cap:round)
        } else if name == "phone-controller" {
          rect(5,2,14,20,radius:3,stroke:accent,width:1.5)
          rect(8,5,8,9,radius:1,stroke:accent,width:1.5)
          line(8,17,16,17,stroke:accent,width:1.5,cap:round)
          circle(12,20,0.7,fill:accent)
        } else if name == "desktop-profiles" {
          rect(2,3,20,14,radius:2,stroke:accent,width:1.5)
          line(12,17,12,21,stroke:accent,width:1.5)
          line(7,21,17,21,stroke:accent,width:1.5,cap:round)
          rect(5,6,7,8,radius:1,stroke:accent,width:1.5)
        } else if name == "tiled-workspaces" {
          rect(2,3,20,18,radius:2,stroke:accent,width:1.5)
          line(12,3,12,21,stroke:accent,width:1.5)
          line(12,12,22,12,stroke:accent,width:1.5)
        } else if name == "android-tiles" {
          rect(2,3,20,18,radius:2,stroke:accent,width:1.5)
          line(12,3,12,21,stroke:accent,width:1.5)
          path([[4,8],[7,11],[4,14]],stroke:accent,width:1.5,cap:round)
          line(8,15,10,15,stroke:accent,width:1.5)
          rect(15,6,4,12,radius:1,stroke:accent,width:1.5)
        } else if name == "shortcuts" {
          rect(3,4,18,16,radius:3,stroke:accent,width:1.5)
          path([[7,8],[11,8],[11,12],[7,12],[7,8]],stroke:accent,width:1.5)
          line(13,9,17,9,stroke:accent,width:1.5)
          line(15,7,15,11,stroke:accent,width:1.5)
          line(7,16,17,16,stroke:accent,width:1.5,cap:round)
        } else if name == "backup" {
          path([[4,7],[4,3],[20,3],[20,7]],stroke:accent,width:1.5)
          rect(3,7,18,14,radius:2,stroke:accent,width:1.5)
          path([[8,14],[12,10],[16,14]],stroke:accent,width:1.5,cap:round)
          line(12,10,12,18,stroke:accent,width:1.5)
        } else if name == "apk-install" {
          rect(4,2,16,20,radius:2,stroke:accent,width:1.5)
          line(12,6,12,15,stroke:accent,width:1.5)
          path([[8,12],[12,16],[16,12]],stroke:accent,width:1.5,cap:round)
          line(8,19,16,19,stroke:accent,width:1.5)
        } else if name == "two-stores" {
          rect(3,8,18,13,radius:2,stroke:accent,width:1.5)
          path([[7,9],[7,4],[17,4],[17,9]],stroke:accent,width:1.5)
          line(12,11,12,18,stroke:accent,width:1.5)
          line(8.5,14.5,15.5,14.5,stroke:accent,width:1.5)
        } else if name == "linux-media" {
          rect(2,4,20,16,radius:2,stroke:accent,width:1.5)
          path([[9,8],[16,12],[9,16]],closed:true,fill:accent)
          line(5,18,19,18,stroke:accent,width:1.5)
        } else if name == "visualizer" {
          for i in range(5) { let h = [6,13,20,10,15][i]; line(4+i*4,12-h/2,4+i*4,12+h/2,stroke:accent,width:2,cap:round) }
        } else if name == "audio-capture" {
          path([[3,9],[7,9],[11,5],[11,19],[7,15],[3,15]],closed:true,stroke:accent,width:1.5)
          arc(11,12,6,-55,110,stroke:accent,width:1.5,cap:round)
          arc(11,12,10,-45,90,stroke:accent,width:1.5,cap:round)
        } else if name == "owl-keys" {
          rect(3,3,18,18,radius:3,stroke:accent,width:1.5)
          path([[7,9],[12,14],[17,9]],stroke:accent,width:1.5,cap:round)
          line(8,17,16,17,stroke:accent,width:1.5)
        } else if name == "owl-background" {
          circle(12,12,9,stroke:accent,width:1.5)
          line(12,6,12,12,stroke:accent,width:1.5)
          line(12,12,16,14,stroke:accent,width:1.5,cap:round)
          circle(19,5,2,fill:accent)
        } else if name == "palette" {
          rect(2,3,20,18,radius:2,stroke:accent,width:1.5)
          circle(7,8,2,stroke:accent,width:1.5)
          line(8.5,9.5,10,11,stroke:accent,width:1.5)
          for i in range(3) { line(6,13+i*3,18,13+i*3,stroke:accent,width:1.5,cap:round) }
        } else if name == "drawer-toggle" {
          for r in range(3) { for c in range(3) { rect(3+c*7,3+r*7,4,4,radius:1,stroke:accent,width:1.3) } }
          line(3,21,21,3,stroke:accent,width:2,cap:round)
        } else if name == "waybar" {
          rect(2,5,20,7,radius:2,stroke:accent,width:1.5)
          for i in range(3) { circle(5+i*3,8.5,0.8,fill:accent) }
          rect(15,7,4,3,radius:0.5,stroke:accent,width:1)
          line(2,16,22,16,stroke:accent,width:1.5,cap:round)
        } else if name == "minimal-home" {
          rect(5,2,14,20,radius:2,stroke:accent,width:1.5)
          circle(12,12,3,stroke:accent,width:1.5)
          line(10,19,14,19,stroke:accent,width:1.5,cap:round)
        } else if name == "workspace-toml" {
          path([[5,2],[15,2],[19,6],[19,22],[5,22]],closed:true,stroke:accent,width:1.5)
          path([[15,2],[15,6],[19,6]],stroke:accent,width:1.5)
          for i in range(3) { line(8,10+i*4,16,10+i*4,stroke:accent,width:1.5) }
        } else if name == "workspace-appearance" {
          rect(2,5,8,15,radius:1.5,stroke:accent,width:1.5)
          rect(14,3,8,15,radius:1.5,stroke:accent,width:1.5)
          circle(6,10,2,fill:accent)
          path([[15,15],[18,9],[21,15]],closed:true,fill:accent)
        } else if name == "control-center" {
          for i in range(3) { line(3,5+i*7,21,5+i*7,stroke:accent,width:1.5,cap:round); circle([8,16,10][i],5+i*7,2.6,fill:accent) }
        }
      }
    }
  }
  component Star(marked) {
    Canvas { size: 22
      scale(width/24,height/24) {
        path([[12,2],[15,9],[22,9],[16.5,14],[19,21],[12,17],[5,21],[7.5,14],[2,9],[9,9]],closed:true,stroke:accent,width:1.5)
        if marked { path([[12,2],[15,9],[22,9],[16.5,14],[19,21],[12,17],[5,21],[7.5,14],[2,9],[9,9]],closed:true,fill:accent) }
      }
    }
  }
  component SearchBox() {
    Row { align: center; gap: 6; fill: width
      Box { weight: 1; radius: 8; background: surface; padding: [10, 2]
        Input { text: query; placeholder: "Поиск возможностей…"; underline: false; fontSize: 14; onChange: { query = value; section = "Каталог"; category = "Все"; filtersOpen = false } }
      }
      if query != "" {
        Box { size: 40; align: center; radius: 8; background: surface; onTap: query = ""
          Text { text: "×"; fontSize: 23; color: accent; align: center }
        }
      }
    }
  }
  component Navigation() {
    Column { fill: width; gap: 5
      if wide {
        for tab in tabs {
          Row { fill: width; align: center; radius: 8; padding: [10, 9]; background: section == tab ? alpha(accent, 0.20) : surface; onTap: { section = tab; category = "Все"; query = ""; filtersOpen = false }
            Text { text: tab; font: sans; fontSize: 13; bold: section == tab; weight: 1 }
            if tab == "Избранное" { Star { marked: section == tab } }
          }
        }
      } else {
        Row { fill: width; gap: 4; align: center
          for tab in tabs {
            if tab != "Избранное" {
              Box { weight: 1; height: 38; align: center; radius: 8; background: section == tab ? alpha(accent, 0.20) : surface; onTap: { section = tab; category = "Все"; query = ""; filtersOpen = false }
                Text { text: tab; font: sans; fontSize: 13; bold: section == tab; align: center }
              }
            } else {
              Box { size: 38; align: center; radius: 8; background: section == tab ? alpha(accent, 0.20) : surface; onTap: { section = tab; category = "Все"; query = ""; filtersOpen = false }
                Star { marked: section == tab }
              }
            }
          }
        }
      }
    }
  }
  component Categories() {
    Column { fill: width; gap: 4
      for c in categories {
        Row { fill: width; align: center; radius: 7; padding: [9, 8]; background: section == "Каталог" && category == c ? alpha(accent, 0.20) : surface; onTap: { category = c; section = "Каталог"; query = ""; filtersOpen = false }
          Text { text: c; font: sans; fontSize: 12; weight: 1; bold: section == "Каталог" && category == c }
          Text { text: str(c == "Все" ? len(items) : len(items.filter(f => f.category == c))); font: sans; fontSize: 11; color: muted }
        }
      }
    }
  }
  component ChangeMark(f) {
    if f.change == "new" || f.change == "updated" {
      Text { text: f.change == "new" ? "Новое" : "Обновлено"; font: sans; fontSize: 10; color: accent; bold: true }
    }
  }
  component FeatureCard(f) {
    Column { fill: width; height: 145; radius: 10; padding: 9; gap: 5; background: surface; onTap: { selected = f.id; expanded = false; shotIndex = 0; fullShot = false }
      Box { fill: width; height: 74; align: center; clip: true; radius: 7; background: alpha(accent, 0.10)
        if len(f.screenshots ?? []) > 0 {
          Image { src: f.screenshots[0].src; fill: true; fit: contain }
        } else {
          FeatureIcon { name: f.id; side: 42 }
        }
      }
      Box { fill: width; height: 36; align: topStart
        Text { text: f.shortTitle ?? f.title; font: sans; fontSize: 14; bold: true; maxLines: 2; fill: width }
      }
      Text { text: f.category; font: sans; fontSize: 10; color: muted; maxLines: 1 }
    }
  }
  component CatalogRow(f) {
    Row { fill: width; align: center; padding: 9; gap: 9; radius: 9; background: surface; onTap: { selected = f.id; expanded = false; shotIndex = 0; fullShot = false }
      Box { size: 42; align: center; radius: 8; background: alpha(accent, 0.11)
        FeatureIcon { name: f.id; side: 25 }
      }
      Column { weight: 1; gap: 3
        Text { text: f.title; font: sans; fontSize: 15; bold: true; maxLines: 2 }
        Text { text: f.summary; font: sans; fontSize: 12; color: muted; maxLines: 3 }
        ChangeMark { f: f }
      }
      if contains(saved, f.id) { Star { marked: true } } else { Text { text: "›"; fontSize: 19; color: accent } }
    }
  }
  component Overview() {
    Column { fill: true; scroll: true; gap: 10
      Row { fill: width; align: center; padding: 12; radius: 12; gap: 12; background: linear(0, 0, 1, 1, [alpha(accent, 0.18), surface])
        Column { weight: 1; gap: 4
          Heading { label: "ANDROID · LINUX · OWL" }
          Text { text: "Больше, чем лаунчер"; font: sans; fontSize: 22; bold: true }
          Text { text: "Возможности OMA Another"; font: sans; fontSize: 12; color: muted }
        }
        Column { align: center; gap: 2
          Text { text: str(len(items)); font: sans; fontSize: 32; bold: true; color: accent }
          Text { text: "В каталог ›"; font: sans; fontSize: 11; color: accent; onTap: { section = "Каталог"; category = "Все" } }
        }
      }
      Heading { label: "ГЛАВНЫЕ ВОЗМОЖНОСТИ" }
      Grid { columns: large ? 4 : (wide ? 3 : 2); gap: 7
        for f in featured key f.id { FeatureCard { f: f } }
      }
      if !wide {
        Heading { label: "КАТЕГОРИИ" }
        Categories {}
      }
      Text { text: "Каталог · ${catalog.reviewed ?? "…"}"; font: sans; fontSize: 10; color: muted }
    }
  }
  component CatalogList() {
    Column { fill: true; gap: 6
      if !wide && section == "Каталог" {
        Row { fill: width; align: center; gap: 8; radius: 8; padding: [10, 8]; background: surface; onTap: filtersOpen = !filtersOpen
          Text { text: "Категория: ${category}"; font: sans; fontSize: 13; weight: 1 }
          Text { text: filtersOpen ? "−" : "+"; fontSize: 18; color: accent }
        }
        if filtersOpen {
          Grid { columns: 2; gap: 4
            for c in categories {
              Box { fill: width; padding: [8, 7]; radius: 7; background: category == c ? alpha(accent, 0.20) : surface; onTap: { category = c; filtersOpen = false }
                Text { text: c; font: sans; fontSize: 12; color: category == c ? accent : muted }
              }
            }
          }
        }
      }
      Row { fill: width; align: center
        Text { text: section == "Новое" ? "Последние изменения" : (section == "Избранное" ? "Избранное" : category); font: sans; fontSize: 14; bold: true; weight: 1 }
        Text { text: str(len(found)); font: sans; fontSize: 12; color: muted }
      }
      if len(found) > 0 {
        Grid { weight: 1; fill: width; lazy: true; columns: large ? 2 : 1; gap: 6
          for f in found key f.id { CatalogRow { f: f } }
        }
      } else {
        Column { weight: 1; padding: 10; gap: 8
          Text { text: section == "Избранное" ? "Пока ничего не сохранено" : "Ничего не найдено"; font: sans; fontSize: 17; bold: true }
          Text { text: "Откройте каталог или измените запрос."; font: sans; fontSize: 13; color: muted }
          Button { text: "Весь каталог"; onTap: { section = "Каталог"; category = "Все"; query = "" } }
        }
      }
    }
  }
  component MainContent() {
    Column { fill: true; gap: 7
      SearchBox {}
      if !wide { Navigation {} }
      if catalog == null {
        Text { text: "Загружаем каталог…"; font: sans; fontSize: 17; bold: true }
        Text { text: "При первом запуске нужна сеть для установки ресурсов."; font: sans; fontSize: 13; color: muted }
      } else {
        if section == "Обзор" { Overview { weight: 1 } } else { CatalogList { weight: 1 } }
      }
    }
  }
  component Gallery() {
    Column { fill: width; gap: 7
      Box { fill: width; height: wide ? max(110, min(360, (screenHeight ?? 300)-75)) : 250; align: center; radius: 10; clip: true; background: alpha(accent, 0.10); onTap: fullShot = true
        Image { src: shot.src; fill: true; fit: contain; label: shot.caption }
      }
      Row { fill: width; align: center; gap: 6
        if len(shots) > 1 {
          Box { size: 36; align: center; radius: 8; background: surface; onTap: shotIndex = (shotIndex + len(shots) - 1) % len(shots)
            Text { text: "‹"; fontSize: 22; color: accent }
          }
        }
        Text { text: "${shotIndex+1} / ${len(shots)} · Открыть"; font: sans; fontSize: 12; color: accent; weight: 1; align: center; onTap: fullShot = true }
        if len(shots) > 1 {
          Box { size: 36; align: center; radius: 8; background: surface; onTap: shotIndex = (shotIndex + 1) % len(shots)
            Text { text: "›"; fontSize: 22; color: accent }
          }
        }
      }
      Text { text: shot.caption ?? ""; font: sans; fontSize: 12; color: muted }
    }
  }
  component DetailText() {
    Column { fill: true; scroll: true; gap: 9
      Row { fill: width; align: center; gap: 8
        Box { size: 38; align: center; radius: 8; background: alpha(accent, 0.12)
          FeatureIcon { name: current.id; side: 25 }
        }
        Column { weight: 1; gap: 3
          Heading { label: current.category }
          ChangeMark { f: current }
        }
        Box { size: 40; align: center; radius: 8; background: surface; onTap: saved = contains(saved, selected) ? saved.filter(s => s != selected) : saved + [selected]
          Star { marked: contains(saved, selected) }
        }
      }
      if !wide || len(shots) > 0 { Text { text: current.summary; font: sans; fontSize: 18; bold: true } }
      if !wide && len(shots) > 0 { Gallery {} }
      Column { fill: width; radius: 10; padding: 12; background: surface; gap: 9
        Heading { label: "ЧТО ЭТО ДАЁТ" }
        for benefit in current.benefits ?? [current.details] {
          Row { fill: width; align: top; gap: 8
            Text { text: "•"; color: accent; fontSize: 18 }
            Text { text: benefit; font: sans; fontSize: 14; weight: 1 }
          }
        }
      }
      Column { fill: width; radius: 10; padding: 12; background: surface; gap: 9
        Heading { label: "КАК ПОЛЬЗОВАТЬСЯ" }
        for step,i in current.steps ?? [current.howTo] {
          Row { fill: width; align: top; gap: 8
            Box { size: 24; align: center; radius: 7; background: alpha(accent, 0.12)
              Text { text: str(i+1); font: sans; fontSize: 12; color: accent; bold: true }
            }
            Text { text: step; font: sans; fontSize: 14; weight: 1 }
          }
        }
      }
      Column { fill: width; radius: 10; padding: 11; background: surface; gap: 8
        Row { fill: width; align: center; onTap: expanded = !expanded
          Text { text: "Особенности и ограничения"; font: sans; fontSize: 13; bold: true; weight: 1 }
          Text { text: expanded ? "−" : "+"; fontSize: 18; color: accent }
        }
        if expanded { Text { text: current.limitations; font: sans; fontSize: 13; color: muted } }
      }
      Spacer { height: 6 }
    }
  }
  Column { fill: true; padding: [12, 6]; gap: 6
    if selected == "" {
      if wide {
        Row { fill: true; gap: 10; align: top
          Column { width: large ? 220 : 164; fill: height; scroll: true; gap: 7
            Navigation {}
            Heading { label: "КАТЕГОРИИ" }
            Categories {}
          }
          MainContent { weight: 1 }
        }
      } else { MainContent { weight: 1 } }
    } else {
      if current != null {
        if fullShot && len(shots) > 0 {
          Column { fill: true; gap: 7
            Image { src: shot.src; weight: 1; fill: width; fit: contain; label: shot.caption }
            Row { fill: width; align: center; gap: 8
              if len(shots) > 1 { Button { text: "‹"; onTap: shotIndex = (shotIndex + len(shots) - 1) % len(shots) } }
              Text { text: "${shotIndex+1} / ${len(shots)}"; font: sans; fontSize: 12; weight: 1; align: center }
              if len(shots) > 1 { Button { text: "›"; onTap: shotIndex = (shotIndex + 1) % len(shots) } }
              Button { text: "Закрыть"; onTap: fullShot = false }
            }
            Text { text: shot.caption ?? ""; font: sans; fontSize: 12; color: muted }
          }
        } else {
          if wide {
            Row { fill: true; gap: 12; align: top
              Column { weight: 1; fill: height; scroll: true; gap: 8
                if len(shots) > 0 { Gallery {} } else {
                  Box { fill: width; height: 112; align: center; radius: 12; background: alpha(accent, 0.10)
                    FeatureIcon { name: current.id; side: 64 }
                  }
                  Heading { label: current.category }
                  Text { text: current.summary; font: sans; fontSize: 18; bold: true }
                }
              }
              DetailText { weight: 1 }
            }
          } else { DetailText { weight: 1 } }
        }
      } else { Button { text: "Вернуться"; onTap: selected = "" } }
    }
  }
}
