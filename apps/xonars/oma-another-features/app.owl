app "Oma Another Features" {
  // Fixed SHA-256 resource package; installed only inside this entry's private directory.
  let storeBootstrap = """
# Template embedded in store OWL. Packages are fixed and SHA-256 verified.
import fcntl
import hashlib
import io
import os
from pathlib import Path, PurePosixPath
import tempfile
import urllib.request
import zipfile


def install(url, digest, entry):
    if not entry or any(c not in "abcdefghijklmnopqrstuvwxyz0123456789-" for c in entry):
        raise ValueError("Invalid store entry")
    root = Path.home() / '.local/share/omalauncher-store' / entry
    if any(p.is_symlink() for p in [root, *root.parents]):
        raise ValueError('Symlink in resource destination')
    root.mkdir(parents=True, exist_ok=True)
    with (root / '.install.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = root / '.installed'
        if marker.exists() and marker.read_text() == digest:
            return
        with urllib.request.urlopen(url, timeout=60) as response:
            payload = response.read(32 * 1024 * 1024 + 1)
        if len(payload) > 32 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != digest:
            raise ValueError('Store resource SHA-256 mismatch')
        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
            members = archive.infolist()
            if sum(x.file_size for x in members) > 128 * 1024 * 1024:
                raise ValueError('Store resource package too large')
            for info in members:
                path = PurePosixPath(info.filename)
                if path.is_absolute() or '..' in path.parts or not path.parts or path.parts[0] not in ('widgets', 'support'):
                    raise ValueError('Invalid store resource path')
                target = root.joinpath(*path.parts)
                # No symlinks in the destination chain or package extraction.
                if any(p.is_symlink() for p in [target, *target.parents]):
                    raise ValueError('Symlink in resource destination')
                target.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as output:
                    output.write(archive.read(info))
                    temporary = Path(output.name)
                os.replace(temporary, target)
        marker.write_text(digest)

install('https://xonars.github.io/dev.omalauncher-widgets-another/resources/ca86c002834d7f3ec232b7c14d022ed5eb2f4900492dd34ad06dc7dd72fc56c3.zip', 'ca86c002834d7f3ec232b7c14d022ed5eb2f4900492dd34ad06dc7dd72fc56c3', 'xonars-oma-another-features')
"""
  let storeInstall = "python -c ${sh(storeBootstrap)}"

  meta { owl: 11; version: "2.0.1"; description: "Витрина возможностей OMA Another: обзор, новые функции, инструкции · ресурсы при первом запуске"; category: "productivity" ; license: "MIT" }
  requires { pacman: ["python"] }
  icon: """<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48"><rect x=".5" y=".5" width="47" height="47" rx="9" fill="#19191d"/><rect x=".5" y=".5" width="47" height="47" rx="9" fill="currentColor" fill-opacity=".30" stroke="currentColor" stroke-opacity=".78"/><defs><g id="symbol"><rect x="6" y="6" width="36" height="13" rx="3"/><rect x="6" y="26" width="14" height="16" rx="3"/><rect x="27" y="26" width="15" height="16" rx="3"/></g></defs><g transform="translate(3.39 3.39) scale(0.859)" fill="none" stroke="#faf8f3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.91"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g><g transform="translate(3.39 3.39) scale(0.859)" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.91" opacity=".16"><use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="#symbol"/></g></svg>"""

  title: selected != "" ? (current.title ?? "Возможность") : "OMA Another Features"
  back: selected != "" || section != "Обзор"
  onBack: { if selected != "" { selected = ""; expanded = false; shotIndex = -1 } else { section = "Обзор"; query = ""; category = "Все" } }
  source catalog = cmd("python -c ${sh(storeBootstrap)} && cat ~/.local/share/omalauncher-store/xonars-oma-another-features/widgets/oma-another-features/catalog.json") timeout 60s json
  state selected = ""
  state query = ""
  state category = "Все"
  state onlySaved = false
  state saved = [] persist
  state section = "Обзор"
  state expanded = false
  state shotIndex = -1
  let items = catalog.features ?? []
  let categories = ["Все", "Рабочая среда", "Оформление", "Управление", "Внешний экран", "Мультимедиа", "Приложения и OWL", "Данные и настройки"]
  let current = items.find(f => f.id == selected)
  let found = items.filter(f => (section != "Новое" || f.recent == true) && (section != "Избранное" || contains(saved, f.id)) && (category == "Все" || f.category == category) && (!onlySaved || contains(saved, f.id)) && contains(lower(f.title + " " + f.summary + " " + f.details + " " + f.howTo + " " + f.limitations + " " + f.category), lower(trim(query))))
  let featured = items.filter(f => f.featured == true)
  component Heading(label) {
    Text { text: label; font: sans; fontSize: 12; bold: true; color: accent; letterSpacing: 0.7 }
  }
  Column { fill: true; padding: [14, 8]; gap: 10
    if selected == "" {
      Row { align: center; gap: 8
        Box { weight: 1; background: surface; radius: 9; padding: [10, 2]
          Input { text: query; placeholder: "Найти возможность…"; underline: false; fontSize: 14; onChange: { query = value; section = "Все"; category = "Все"; onlySaved = false } }
        }
        Box { size: 42; radius: 9; background: section == "Избранное" ? alpha(accent, 0.20) : surface; onTap: { section = section == "Избранное" ? "Обзор" : "Избранное"; category = "Все"; query = ""; onlySaved = false }
          Text { text: section == "Избранное" ? "★" : "☆"; color: accent; fontSize: 23 }
        }
      }
      Grid { columns: 3; gap: 5
        for tab in ["Обзор", "Все", "Новое"] {
          Box { radius: 8; padding: [10, 9]; background: section == tab ? alpha(accent, 0.20) : surface; onTap: { section = tab; category = "Все"; query = ""; onlySaved = false }
            Text { text: tab; font: sans; fontSize: 13; bold: section == tab; color: section == tab ? accent : muted }
          }
        }
      }
      if catalog == null {
        Column { weight: 1; padding: 16; gap: 8
          Text { text: "Загружаем каталог…"; font: sans; fontSize: 18; bold: true }
          Text { text: "При первом запуске магазина нужна сеть для установки ресурсов."; font: sans; fontSize: 14; color: muted }
        }
      } else {
        if section == "Обзор" {
          Column { weight: 1; scroll: true; gap: 13
            Column { fill: width; radius: 14; padding: 15; gap: 8; background: linear(0, 0, 1, 1, [alpha(accent, 0.20), surface])
              Heading { label: "ANDROID · LINUX · OWL" }
              Text { text: "Больше, чем лаунчер"; font: sans; fontSize: 26; bold: true }
              Row { align: center; gap: 10
                Text { text: str(len(items)); font: sans; fontSize: 33; bold: true; color: accent }
                Text { text: "возможностей OMA Another"; font: sans; fontSize: 14; color: muted; weight: 1 }
                Text { text: "Новое →"; font: sans; fontSize: 13; color: accent; onTap: { section = "Новое"; category = "Все" } }
              }
            }
            Heading { label: "ГЛАВНЫЕ ВОЗМОЖНОСТИ" }
            Grid { columns: 2; gap: 8
              for f in featured key f.id {
                Column { fill: width; radius: 12; padding: 10; gap: 7; background: surface; border: 1; borderColor: alpha(accent, 0.14); onTap: { selected = f.id; expanded = false; shotIndex = -1 }
                  if len(f.screenshots ?? []) > 0 {
                    Image { src: f.screenshots[0].src; fill: width; height: 92; fit: contain }
                  } else {
                    Box { fill: width; height: 76; radius: 8; background: alpha(accent, 0.12)
                      Text { text: f.symbol ?? "▦"; fontSize: 39; color: accent }
                    }
                  }
                  Text { text: f.title; font: sans; fontSize: 15; bold: true; maxLines: 3 }
                  Text { text: f.category; font: sans; fontSize: 11; color: muted; maxLines: 2 }
                }
              }
            }
            Heading { label: "КАТЕГОРИИ" }
            for c in categories {
              if c != "Все" {
                Row { fill: width; align: center; gap: 8; padding: [12, 10]; radius: 9; background: surface; onTap: { category = c; section = "Все"; query = ""; onlySaved = false }
                  Text { text: c; font: sans; fontSize: 14; weight: 1 }
                  Text { text: str(len(items.filter(f => f.category == c))); font: sans; color: muted; fontSize: 12 }
                  Text { text: "›"; color: accent; fontSize: 20 }
                }
              }
            }
            Text { text: "Каталог · ${catalog.reviewed ?? "…"}"; font: sans; fontSize: 11; color: muted }
          }
        } else {
          if section == "Все" {
            Grid { columns: 2; gap: 4
              for c in categories {
                Box { radius: 7; padding: [8, 6]; background: category == c ? alpha(accent, 0.20) : surface; onTap: category = c
                  Text { text: c; font: sans; fontSize: 12; color: category == c ? accent : muted }
                }
              }
            }
          }
          Row { align: center
            Text { text: section == "Новое" ? "Последние изменения" : (section == "Избранное" ? "Избранное" : category); font: sans; fontSize: 14; bold: true; weight: 1 }
            Text { text: str(len(found)); font: sans; fontSize: 12; color: muted }
          }
          Column { weight: 1; lazy: true; gap: 6
            for f in found key f.id {
              Row { fill: width; align: center; padding: 10; gap: 10; radius: 10; background: surface; onTap: { selected = f.id; expanded = false; shotIndex = -1 }
                Box { size: 43; radius: 8; background: alpha(accent, 0.12)
                  Text { text: f.symbol ?? "▦"; fontSize: 23; color: accent }
                }
                Column { weight: 1; gap: 4
                  Text { text: f.title; font: sans; fontSize: 16; bold: true }
                  Text { text: f.summary; font: sans; fontSize: 12; color: muted; maxLines: 3 }
                  if f.recent == true { Text { text: "Обновлено"; font: sans; fontSize: 10; color: accent } }
                }
                Text { text: contains(saved, f.id) ? "★" : "›"; fontSize: 20; color: accent }
              }
            }
            if len(found) == 0 {
              Column { padding: 16; gap: 8
                Text { text: section == "Избранное" ? "Пока ничего не сохранено" : "Ничего не найдено"; font: sans; fontSize: 18; bold: true }
                Text { text: "Откройте каталог или измените запрос."; font: sans; fontSize: 13; color: muted }
                Button { text: "Все возможности"; onTap: { section = "Все"; category = "Все"; query = ""; onlySaved = false } }
              }
            }
          }
        }
      }
    } else {
      if current != null {
        Column { weight: 1; scroll: true; gap: 14
          if len(current.screenshots ?? []) > 0 {
            for shot in current.screenshots {
              Column { fill: width; radius: 12; padding: 8; gap: 6; background: surface
                Image { src: shot.src; fill: width; height: 300; fit: contain; label: shot.caption }
                Text { text: shot.caption; font: sans; fontSize: 12; color: muted }
              }
            }
          } else {
            Row { fill: width; align: center; padding: 12; gap: 12; radius: 12; background: alpha(accent, 0.12)
              Text { text: current.symbol ?? "▦"; fontSize: 34; color: accent }
              Column { weight: 1; gap: 3
                Heading { label: current.category }
                if current.recent == true { Text { text: "Последние изменения"; font: sans; fontSize: 12; color: muted } }
              }
            }
          }
          Row { align: start; gap: 8
            Text { text: current.title; font: sans; fontSize: 26; bold: true; weight: 1 }
            Box { size: 42; radius: 9; background: alpha(accent, 0.12); onTap: saved = contains(saved, selected) ? saved.filter(s => s != selected) : saved + [selected]
              Text { text: contains(saved, selected) ? "★" : "☆"; fontSize: 24; color: accent }
            }
          }
          Text { text: current.summary; font: sans; fontSize: 16; color: muted }
          Column { fill: width; radius: 12; padding: 12; background: surface; gap: 7
            Heading { label: "ЧТО ЭТО ДАЁТ" }
            Text { text: current.details; font: sans; fontSize: 15 }
          }
          Column { fill: width; radius: 12; padding: 12; background: surface; gap: 7
            Heading { label: "КАК ПОЛЬЗОВАТЬСЯ" }
            Text { text: current.howTo; font: sans; fontSize: 15 }
          }
          Column { fill: width; radius: 10; padding: 12; background: alpha(accent, 0.08); gap: 8
            Row { fill: width; align: center; onTap: expanded = !expanded
              Text { text: "Особенности и ограничения"; font: sans; fontSize: 14; bold: true; weight: 1 }
              Text { text: expanded ? "−" : "+"; fontSize: 19; color: accent }
            }
            if expanded { Text { text: current.limitations; font: sans; fontSize: 14; color: muted } }
          }
          Text { text: "Редакционный каталог · ${catalog.reviewed ?? "…"}"; font: sans; fontSize: 11; color: muted }
          Spacer { height: 8 }
        }
      } else {
        Text { text: "Карточка не найдена"; font: sans; fontSize: 16 }
        Button { text: "Вернуться"; onTap: selected = "" }
      }
    }
  }
}
